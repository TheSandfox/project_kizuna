//! 전사
scope UnitHR00 initializer init
	private function init takes nothing returns nothing
		set UnitData.ID = 'HR00'
		call UnitData.setIconPath("ReplaceableTextures\\CommandButtons\\BTNFootman.blp")
		call UnitData.setInitialAbility(0,'10a0')
		call UnitData.setInitialAbility(1,'2030')
		call UnitData.setExtraAbility(0,'20e0')
	endfunction
endscope
