IncludeFile "ui\framedef\templates\strings.fdf",

Frame "SIMPLEFRAME" "CAbilityContainer" {
  Layer "BACKGROUND" {
    Texture "CAbilityContainerBackdrop" {
      File "textures\black32.blp",
      SetAllPoints,
    }
  }
}

// 기준점
Frame "SIMPLEFRAME" "CAbilityIconPivot" {
  UseActiveContext,
}

// 배경 단축키
Frame "SIMPLEFRAME" "CAbilityIconBackgroundHotkeyWrapper" {
  UseActiveContext,
  SetAllPoints,
  Layer "BACKGROUND" {
    String "CAbilityIconBackgroundHotkey" INHERITS "TTextLarge" {
      Anchor CENTER, 0.0, 0.0,
      FontJustificationH JUSTIFYCENTER,
      FontJustificationV JUSTIFYMIDDLE,
    }
  }
}

// 스킬 아이콘, 텍스쳐 마나가 부족할 때 해당 텍스쳐의 색상을 조정
Frame "SIMPLEFRAME" "CAbilityIconIconWrapper" {
  UseActiveContext,
  SetAllPoints,
  Layer "BACKGROUND" {
    Texture "CAbilityIconIcon" {
      File "textures\black32.blp",
      SetAllPoints,
    }
  }
}

// 스킬 상태 테두리(액티브패시브)
Frame "SIMPLEFRAME" "CAbilityIconStateTextureWrapper" {
  UseActiveContext,
  SetAllPoints,
  Layer "BACKGROUND" {
    Texture "CAbilityIconStateTexture" {
      File "replaceabletextures\commandbuttons\bm_btn.blp",
      SetAllPoints,
    }
  }
}

Frame "SIMPLEBUTTON" "CAbilityIconButton" {
  UseActiveContext,
  SetAllPoints,
  // Layer "ARTWORK" {
  //   // 쿨타임 가리개
  //   Texture "CAbilityIconCooldownTexture" {
  //     File "textures\black32.blp",
