Frame "SIMPLEFRAME" "TMultiboardBorder" {
	Layer "BACKGROUND" {
		// 배경
		Texture "TMultiboardBorderackdrop" {
			File "ui/widgets/escmenu/human/editbox-background.blp",
			SetAllPoints,
		}
	}
	Layer "ARTWORK" {
		// 1. 좌상단 (TopLeft) - 기준
		Texture "TMultiboardBorderTL" {
			File "ui/border/multiboard-border.blp",
			Width 0.00888,
			Height 0.00888,
			Anchor TOPLEFT, 0.0, 0.0,
			TexCoord 0.5, 0.625, 0.0, 1.0,
		}
		// 우상
		Texture "TMultiboardBorderTR" {
			File "ui/border/multiboard-border.blp",
			Width 0.00888,
			Height 0.00888,
			Anchor TOPRIGHT, 0.0, 0.0,
			TexCoord 0.625, 0.75, 0.0, 1.0,
		}
		// 좌하
		Texture "TMultiboardBorderBL" {
			File "ui/border/multiboard-border.blp",
			Width 0.00888,
			Height 0.00888,
			Anchor BOTTOMLEFT, 0.0, 0.0,
			TexCoord 0.75, 0.875, 0.0, 1.0,
		}
		// 우하
		Texture "TMultiboardBorderBR" {
			File "ui/border/multiboard-border.blp",
			Width 0.00888,
			Height 0.00888,
			Anchor BOTTOMRIGHT, 0.0, 0.0,
			TexCoord 0.875, 1.0, 0.0, 1.0,
		}
		// 상
		Texture "TMultiboardBorderT" {
			File "ui/border/multiboard-border.blp",
			SetPoint TOPLEFT, "TMultiboardBorderTL", TOPRIGHT, 0.0, 0.0,
			SetPoint BOTTOMRIGHT, "TMultiboardBorderTR", BOTTOMLEFT, 0.0, 0.0, 
			TexCoord 0.3, 0.35, 0.0, 1.0,
		}
		// 하
		Texture "TMultiboardBorderB" {
			File "ui/border/multiboard-border.blp",
			SetPoint TOPLEFT, "TMultiboardBorderBL", TOPRIGHT, 0.0, 0.0,
			SetPoint BOTTOMRIGHT, "TMultiboardBorderBR", BOTTOMLEFT, 0.0, 0.0, 
			TexCoord 0.4, 0.45, 0.0, 1.0,
		}
		// 좌
		Texture "TMultiboardBorderL" {
			File "ui/border/multiboard-border.blp",
			SetPoint TOPLEFT, "TMultiboardBorderTL", BOTTOMLEFT, 0.0, 0.0,
			SetPoint BOTTOMRIGHT, "TMultiboardBorderBL", TOPRIGHT, 0.0, 0.0, 
			TexCoord 0.0, 0.125, 0.0, 1.0,
		}
		// 우
		Texture "TMultiboardBorderR" {
			File "ui/border/multiboard-border.blp",
			SetPoint TOPLEFT, "TMultiboardBorderTR", BOTTOMLEFT, 0.0, 0.0,
			SetPoint BOTTOMRIGHT, "TMultiboardBorderBR", TOPRIGHT, 0.0, 0.0, 
			TexCoord 0.125, 0.25, 0.0, 1.0,
		}
	}
}

