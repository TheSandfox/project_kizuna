// 초상화와 옆에 붙는 유닛 정보를 보여주는 UI에요
// 유닛레벨 + 유닛이름, 경험치바 등을 포함해요
Frame "SIMPLEFRAME" "CUnitInfo" {
  UseActiveContext,
  Texture "CUnitInfoBackdrop" { // 배경
    File "Textures\arrow.blp",
    SetPoint TOPLEFT, "CUnitInfo", TOPLEFT, 0.0, 0.0,
    SetPoint BOTTOMRIGHT, "CUnitInfo", BOTTOMRIGHT, 0.0, 0.0,
  }
