//library InteractiveUnit:






  function s__InteractiveUnit_adjustTrigger takes boolean flag returns nothing
			if flag then
				set s__InteractiveUnit_COUNTER=s__InteractiveUnit_COUNTER + 1
				if s__InteractiveUnit_COUNTER == 1 then
					call EnableTrigger(s__InteractiveUnit_MAIN_TRIGGER)
				endif
			else
				set s__InteractiveUnit_COUNTER=s__InteractiveUnit_COUNTER - 1
				if s__InteractiveUnit_COUNTER == 0 then
					call DisableTrigger(s__InteractiveUnit_MAIN_TRIGGER)
				endif
			endif
  endfunction

  function s__InteractiveUnit_onInteract takes integer this,integer caster returns nothing
			
  endfunction

  function s__InteractiveUnit_interact takes nothing returns nothing
   local integer this= 0
   local integer caster= 0
			if GetSpellAbilityId() != CONFIG_ABILITY_ID_INTERACT then
				return
			endif
			set caster=s__Unit_prototype_get(GetTriggerUnit())
			if caster <= 0 then
				return
			endif
			set this=s__Unit_prototype_get(GetSpellTargetUnit())
			if not s__InteractiveUnit__data_exists[(this)] then
				return
			endif
			call sc__InteractiveUnit_onInteract(this,caster)
  endfunction

  function s__InteractiveUnit_create takes player p,integer uid,real x,real y,real yaw returns integer
   local integer this= s__InteractiveUnit__allocate(p , uid , x , y , yaw)
			call UnitAddAbility(s__Unit_prototype_origin_unit[this], CONFIG_ABILITY_ID_CLASS_INTERACTIVE)
			call s__InteractiveUnit_adjustTrigger(true)
			set s__InteractiveUnit__data_exists[(this)]=true
			return this
  endfunction

  function s__InteractiveUnit_onDestroy takes integer this returns nothing
			call s__InteractiveUnit_adjustTrigger(false)
			set s__InteractiveUnit__data_exists[(this)]=false
  endfunction

  function s__InteractiveUnit_onInit takes nothing returns nothing
			set s__InteractiveUnit_MAIN_TRIGGER=CreateTrigger()
			call TriggerRegisterAnyUnitEventBJ(s__InteractiveUnit_MAIN_TRIGGER, EVENT_PLAYER_UNIT_SPELL_EFFECT)
			call TriggerAddCondition(s__InteractiveUnit_MAIN_TRIGGER, Condition(function s__InteractiveUnit_interact))
			call DisableTrigger(s__InteractiveUnit_MAIN_TRIGGER)
  endfunction




  function s__Servant_create takes integer caster,integer uid,real x,real y,real yaw,integer level returns integer
   local integer this= s__Servant__allocate((GetOwningPlayer(s__Unit_prototype_origin_unit[(caster)])) , uid , x , y , yaw) // INLINED!!
			set s__Servant_caster[this]=caster
			call s__UnitClass_plusClass((this),CONFIG_UNIT_CLASS_SERVANT)
			set s__Unit_prototype_is_revive[this]=true
			call s__Unit_prototype__set_level(this,level)
			call UnitRemoveAbility(s__Unit_prototype_origin_unit[(this)], CONFIG_ABILITY_ID_INTERACT) // INLINED!!
			return this
  endfunction

  function s__Servant_onDestroy takes integer this returns nothing
			call s__UnitClass_minusClass((this),CONFIG_UNIT_CLASS_SERVANT)
  endfunction



