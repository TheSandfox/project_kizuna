				call s__Missile_setCollision(this,Ability1080__RADIUS2)
				call s__Effect_setDuration(this,( Ability1080__RANGE - Ability1080__STARTAT ) / Ability1080__VELO)
				return this
   endfunction


	

   function s__Ability1080_actor_onComplete takes integer this returns nothing
    local integer i= 0
    local integer ms= 0
    local real a= 0.
    local integer mg= s__MissileGroup_create()
				loop
					exitwhen i >= Ability1080__COUNT
					set a=s__Ability1080_actor_angle[this] - ( Ability1080__WIDTH / 2 ) + ( Ability1080__WIDTH * i ) / ( Ability1080__COUNT - 1 )
					set ms=s__Ability1080__arrow_create((s__Actor_actor[(this)]) , (((sc__Object__get_x((s__Actor_actor[(this)])) )*1.0) + (( Ability1080__STARTAT )*1.0) * Cos((( a)*1.0) * bj_DEGTORAD)) , (((sc__Object__get_y((s__Actor_actor[(this)])) )*1.0) + (( Ability1080__STARTAT )*1.0) * Sin((( a)*1.0) * bj_DEGTORAD)) , s__Object_pivot_z[(s__Actor_actor[(this)])] , a , s__UnitActor_level[this]) // INLINED!!
					call s__MissileGroup_add(mg,ms)
					set i=i + 1
				endloop
				call s__UnitActor_create((s__Actor_actor[(this)]) , 0 , 0. , 0. , 0 , Ability1080__BACKSWING , true) // INLINED!!
   endfunction
	
