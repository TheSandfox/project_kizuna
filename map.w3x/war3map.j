 function s__Boss_BossB000__sanrengeki_killFilter takes integer this returns boolean
		set s__Boss_BossB000__sanrengeki_count[this]=s__Boss_BossB000__sanrengeki_count[this] - 1
		if s__Boss_BossB000__sanrengeki_count[this] <= 0 then
			return true
		elseif s__Boss_BossB000__sanrengeki_count[this] > 1 then
			set s__Actor_duration[this]=s__Boss_BossB000__sanrengeki_DURATION_FAST
			call s__Boss_BossB000__sanrengeki_play(this,true)
			set s__Boss_BossB000__sanrengeki_anim_play[this]=false
			set s__Boss_BossB000__sanrengeki_anim_reset[this]=false
