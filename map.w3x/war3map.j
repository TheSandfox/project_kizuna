  function s__String_refineShop takes string s,boolean flag returns string
			
   local integer i= 0
   local integer l= StringLength(s)
			loop
				exitwhen i >= l
				if SubString(s, i, i + 1) == "#" then
					if flag then
						
						return SubString(s, 0, i)
					else
						
						return SubString(s, i + 1, l)
					endif
				endif
				set i=i + 1
			endloop
			return s
  endfunction

  function s__String_create takes string val returns integer
   local integer this= s__String__allocate()
			set s__String_value[this]=val
			return this
  endfunction



