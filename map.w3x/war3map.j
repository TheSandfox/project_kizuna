  function s__Buff3010_main_addValue takes integer this,integer level returns nothing
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],CONFIG_STAT_MOVEMENT_SPEED , Buff3010_DATA_INTEGER1)
			call s__Unit_prototype_plusStatValue(s__Buff_target[this],CONFIG_STAT_EVASION , ( s__Unit_prototype_getCarculatedStatValue(s__Buff_caster[this],Buff3010_DAMAGE_STAT1) * Buff3010_DAMAGE_AMPLIFIER1 ) * ( 1 + Buff3010_DAMAGE_PER_LEVEL * ( level ) ))
			set s__Buff3010_main_val1[this]=s__Buff3010_main_val1[this] + Buff3010_DATA_INTEGER1
			set s__Buff3010_main_val2[this]=s__Buff3010_main_val2[this] + ( s__Unit_prototype_getCarculatedStatValue(s__Buff_caster[this],Buff3010_DAMAGE_STAT1) * Buff3010_DAMAGE_AMPLIFIER1 ) * ( 1 + Buff3010_DAMAGE_PER_LEVEL * ( level ) )
  endfunction

  function s__Buff3010_main_update takes integer this returns boolean
			return true
  endfunction

  function s__Buff3010_main_init takes integer this returns boolean
			call s__Buff_addEffect(this,s__Effect_createAttatched(s__Buff3010_main_EFFECT_PATH1 , s__Unit_prototype_origin_unit[s__Buff_target[this]] , "origin"))
			return true
  endfunction

  function s__Buff3010_main_onDestroy takes integer this returns nothing
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],CONFIG_STAT_MOVEMENT_SPEED , - s__Buff3010_main_val1[this])
			call s__Unit_prototype_plusStatValue(s__Buff_target[this],CONFIG_STAT_EVASION , - s__Buff3010_main_val2[this])
  endfunction


