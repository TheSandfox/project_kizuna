//library InteractivePrototype:







  function s__Interactive_prototype__get_id takes integer this returns integer
			if s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_UNIT then
				return GetUnitTypeId(s__Interactive_prototype_origin_unit[this])
			elseif s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_DEST then
				return GetDestructableTypeId(s__Interactive_prototype_origin_dest[this])
			endif
			return - 1
  endfunction

  function s__Interactive_prototype__get_name takes integer this returns string
			if s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_UNIT then
				return GetUnitName(s__Interactive_prototype_origin_unit[this])
			elseif s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_DEST then
				return GetDestructableName(s__Interactive_prototype_origin_dest[this])
			endif
			return ""
  endfunction

  function s__Interactive_prototype__get_x takes integer this returns real
			if s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_UNIT then
				return GetUnitX(s__Interactive_prototype_origin_unit[this])
			elseif s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_DEST then
				return GetDestructableX(s__Interactive_prototype_origin_dest[this])
			endif
			return 0.
  endfunction

  function s__Interactive_prototype__get_y takes integer this returns real
			if s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_UNIT then
				return GetUnitY(s__Interactive_prototype_origin_unit[this])
			elseif s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_DEST then
				return GetDestructableY(s__Interactive_prototype_origin_dest[this])
			endif
			return 0.
  endfunction

  function s__Interactive_prototype_setAnim takes integer this,string s returns nothing
			if s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_UNIT then
				call SetUnitAnimation(s__Interactive_prototype_origin_unit[this], s)
			elseif s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_DEST then
				call SetDestructableAnimation(s__Interactive_prototype_origin_dest[this], s)
			endif
  endfunction

  function s__Interactive_prototype_setAnimSpeed takes integer this,real r returns nothing
			if s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_UNIT then
				call SetUnitTimeScale(s__Interactive_prototype_origin_unit[this], r)
			elseif s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_DEST then
				call SetDestructableAnimationSpeed(s__Interactive_prototype_origin_dest[this], r)
			endif
  endfunction

  function s__Interactive_prototype_register takes integer this returns nothing
			if s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_UNIT then
				call SaveInteger(s__Interactive_prototype_HASH, GetHandleId(s__Interactive_prototype_origin_unit[this]), 0, this)
				//call SaveInteger(.HASH,GetHandleId(.origin_unit),0,this)
			elseif s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_DEST then
				call SaveInteger(s__Interactive_prototype_HASH, GetHandleId(s__Interactive_prototype_origin_dest[this]), 0, this)
			endif
  endfunction

  function s__Interactive_prototype_unregister takes integer this returns nothing
			if s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_UNIT then
				call RemoveSavedInteger(s__Interactive_prototype_HASH, GetHandleId(s__Interactive_prototype_origin_unit[this]), 0)
			elseif s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_DEST then
				call RemoveSavedInteger(s__Interactive_prototype_HASH, GetHandleId(s__Interactive_prototype_origin_dest[this]), 0)
			endif
  endfunction

  function s__Interactive_prototype_onInteract takes integer this,integer caster returns nothing
			//call BJDebugMsg(.name)
  endfunction

  function s__Interactive_prototype_create takes integer did,real x,real y,real yaw,integer atype returns integer
   local integer this= s__Interactive_prototype__allocate()
			set s__Object_type[this]=CONFIG_OBJECT_TYPE_INTERACTIVE
			set s__Interactive_prototype_agent_type[this]=atype
			if atype == s__Interactive_prototype_TYPE_UNIT then
				set s__Interactive_prototype_origin_unit[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), did, x, y, yaw)
				call UnitAddAbility(s__Interactive_prototype_origin_unit[this], 'Avul')
			elseif atype == s__Interactive_prototype_TYPE_DEST then
				set s__Interactive_prototype_origin_dest[this]=CreateDestructable(did, x, y, yaw, 1., 0)
			endif
			call s__Interactive_prototype_register(this)
			return this
  endfunction

  function s__Interactive_prototype_onDestroy takes integer this returns nothing
			call s__Interactive_prototype_unregister(this)
			if s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_UNIT then
				call RemoveUnit(s__Interactive_prototype_origin_unit[this])
			elseif s__Interactive_prototype_agent_type[this] == s__Interactive_prototype_TYPE_DEST then
				call RemoveDestructable(s__Interactive_prototype_origin_dest[this])
			endif
  endfunction

  function s__Interactive_prototype_getByUnit takes unit ds returns integer
			if HaveSavedInteger(s__Interactive_prototype_HASH, GetHandleId(ds), 0) and ds != null then
				return LoadInteger(s__Interactive_prototype_HASH, GetHandleId(ds), 0)
			else
				return 0
			endif
  endfunction

  function s__Interactive_prototype_getByDestructable takes destructable ds returns integer
			if HaveSavedInteger(s__Interactive_prototype_HASH, GetHandleId(ds), 0) and ds != null then
				return LoadInteger(s__Interactive_prototype_HASH, GetHandleId(ds), 0)
			else
				return 0
			endif
  endfunction

  function s__Interactive_prototype_interaction takes nothing returns nothing
   local integer this= 0
			if GetSpellAbilityId() == CONFIG_ABILITY_ID_INTERACT then
				if GetSpellTargetDestructable() != null then
					
					set this=s__Interactive_prototype_getByDestructable(GetSpellTargetDestructable())
					if this > 0 then
						call sc__Interactive_prototype_onInteract(this,sc__Unit_prototype_get(GetTriggerUnit()))
					endif
				elseif GetSpellTargetUnit() != null and not IsUnitEnemy(GetSpellTargetUnit(), GetOwningPlayer(GetTriggerUnit())) then
					
					set this=s__Interactive_prototype_getByUnit(GetSpellTargetUnit())
					if this > 0 then
						call sc__Interactive_prototype_onInteract(this,sc__Unit_prototype_get(GetTriggerUnit()))
					endif
				endif
			endif
  endfunction

  function s__Interactive_prototype_genericInteraction takes nothing returns nothing
			if ( GetIssuedOrderId() != OrderId(CONFIG_ORDER_STRING_INTERACT) ) and ( GetIssuedOrderId() != OrderId(CONFIG_ORDER_STRING_FOLLOW) ) then
				if GetOrderTargetDestructable() != null then
					
					call DisableTrigger(GetTriggeringTrigger())
					call IssueTargetOrder(GetTriggerUnit(), CONFIG_ORDER_STRING_INTERACT, GetOrderTargetDestructable())
					call EnableTrigger(GetTriggeringTrigger())
				elseif GetOrderTargetUnit() != null and GetUnitAbilityLevel(GetOrderTargetUnit(), CONFIG_ABILITY_ID_CLASS_INTERACTIVE) > 0 and not IsUnitEnemy(GetOrderTargetUnit(), GetOwningPlayer(GetTriggerUnit())) then
					
					
					call DisableTrigger(GetTriggeringTrigger())
					call IssueTargetOrder(GetTriggerUnit(), CONFIG_ORDER_STRING_INTERACT, GetOrderTargetUnit())
					call EnableTrigger(GetTriggeringTrigger())
				endif
			endif
  endfunction

  function s__Interactive_prototype_onInit takes nothing returns nothing
			call TriggerRegisterAnyUnitEventBJ(InteractivePrototype__INTERACTION_TRIGGER, EVENT_PLAYER_UNIT_SPELL_EFFECT)
			call TriggerAddCondition(InteractivePrototype__INTERACTION_TRIGGER, Condition(function s__Interactive_prototype_interaction))
			call TriggerRegisterAnyUnitEventBJ(InteractivePrototype__GENERIC_INTERACTION_TRIGGER, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
			call TriggerAddCondition(InteractivePrototype__GENERIC_INTERACTION_TRIGGER, Condition(function s__Interactive_prototype_genericInteraction))
  endfunction



  function s__Moolgun_prototype_create takes integer did,real x,real y,real yaw returns integer
   local integer this= s__Moolgun_prototype__allocate(did , x , y , yaw , s__Interactive_prototype_TYPE_DEST)
			return this
  endfunction



  function s__NPC_prototype_create takes integer did,real x,real y,real yaw returns integer
   local integer this= s__NPC_prototype__allocate(did , x , y , yaw , s__Interactive_prototype_TYPE_UNIT)
			call UnitAddAbility(s__Interactive_prototype_origin_unit[this], CONFIG_ABILITY_ID_CLASS_INTERACTIVE)
			call UnitAddAbility(s__Interactive_prototype_origin_unit[this], CONFIG_ABILITY_ID_CLASS_NONUNIT)
			return this
  endfunction



