				call TimerStart((s__BuffIndicator_main_timer[this] ), (( 0.1 )*1.0), ( true ), ( function s__BuffIndicator_timerCallback)) // INLINED!!
			else
				call PauseTimer((s__BuffIndicator_main_timer[this])) // INLINED!!
			endif
  endfunction

  function s__BuffIndicator_setTarget takes integer this,integer u returns nothing
			set s__BuffIndicator_target[this]=u
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(BuffIndicator___MY_BUFF_CONTAINER, u > 0)
			endif
			if u > 0 then
				call s__BuffIndicator_refreshIconsTarget(this)
				call s__BuffIndicator_runTimer(this,true)
			else
				call s__BuffIndicator_runTimer(this,false)
			endif
  endfunction

