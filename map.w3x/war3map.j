 function s__User_oskey2Index takes oskeytype os returns integer
  local integer i= 0
  local integer result= - 1
		loop
			if i >= ENUM_ABILITY_SLOT_MAX then
				exitwhen true
			endif
			if UDG_ABILITY_SLOT_HOTKEY[i] == os then
				set result=i
				exitwhen true
			endif
			set i=i + 1
		endloop
		return result
 endfunction

