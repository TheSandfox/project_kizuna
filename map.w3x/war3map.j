			set s__Unit_prototype_maxexp[this]=(s__Unit_prototype_level_true[(this)]) * 100 // INLINED!!
  endfunction

  function s__Unit_prototype_setLevel takes integer this,integer v returns nothing
   local integer diff= 0
			if v <= s__Unit_prototype_level_true[this] then
				return
			endif
			set diff=v - s__Unit_prototype_level_true[this]
			set s__Unit_prototype_level_true[this]=v
			if IsUnitType(s__Unit_prototype_origin_unit[this], UNIT_TYPE_HERO) then
				call SetHeroLevel(s__Unit_prototype_origin_unit[this], v, false)
			endif
			call sc__Unit_prototype_refreshMaxExp(this)
			call sc__Unit_prototype_refreshLevelStatValue(this)
			set EVT_LEVEL_UNIT=this
			set EVT_LEVEL_LEVEL_DIFF=diff
			set EVT_LEVEL_LEVEL=v
			call s__Event_activate(ENUM_EVENT_LEVEL)
			set EVT_LEVEL_UNIT=0
			set EVT_LEVEL_LEVEL_DIFF=0
			set EVT_LEVEL_LEVEL=0
  endfunction

  function s__Unit_prototype_addExp takes integer this,real v returns nothing
			loop
				set s__Unit_prototype_exp[this]=s__Unit_prototype_exp[this] + v
				if s__Unit_prototype_exp[this] >= s__Unit_prototype_maxexp[this] then
					set s__Unit_prototype_exp[this]=s__Unit_prototype_exp[this] - s__Unit_prototype_maxexp[this]
					call s__Unit_prototype_setLevel(this,(s__Unit_prototype_level_true[(this)]) + 1) // INLINED!!
				endif
				exitwhen s__Unit_prototype_exp[this] < s__Unit_prototype_maxexp[this]
			endloop
  endfunction

		
  function s__Unit_prototype_refreshAttackSpeed takes integer this,real v returns nothing
   local integer i= R2I(v / 0.05)
			if i <= 0 then
				set i=1
			endif
			if i > 100 then
				set i=100
			endif
			if s__Unit_prototype_recover_attack_delay[this] then
				call SetUnitAbilityLevel(s__Unit_prototype_origin_unit[this], CONFIG_ABILITY_ID_ATTACK_SPEED, 100)
			else
				call SetUnitAbilityLevel(s__Unit_prototype_origin_unit[this], CONFIG_ABILITY_ID_ATTACK_SPEED, i)
			endif
  endfunction

		
  function s__Unit_prototype_refreshAttackSpeedRequest takes integer this,real v returns nothing
			if s__UnitPrototype__AbilityData_getWeaponAbility(s__Unit_prototype_ability_data[this]) > 0 then
				set EVT_WEAPON_ATTACK_SPEED_REFRESH_ABILITY=s__UnitPrototype__AbilityData_getWeaponAbility(s__Unit_prototype_ability_data[this])
				set EVT_WEAPON_ATTACK_SPEED_REFRESH_VALUE=v
				call s__Event_activate(ENUM_EVENT_WEAPON_ATTACK_SPEED_REFRESH)
				call s__Unit_prototype_refreshAttackSpeed(this,EVT_WEAPON_ATTACK_SPEED_REFRESH_RESULT)
			else
				call s__Unit_prototype_refreshAttackSpeed(this,v)
			endif
  endfunction

		// method getStatValue takes integer stattype, integer statindex returns real
		// 	return LoadReal(.HASH,this,INDEX_STAT+(stattype*ENUM_STAT_INDEX_SIZE)+statindex)
		// endmethod

  function s__Unit_prototype_getCalculatedStatValue takes integer this,integer stattype returns real
   local real nv
			if this == 0 then
				return 1.0
			endif
			set nv=( ( ( (LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_BASE)))) + (LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_LEVEL)))) * ( (s__Unit_prototype_level_true[(this)]) - 1 ) ) * (LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_MULTIPLY)))) ) / (LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_DIVIDE)))) ) - (LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_MINUS)))) + (LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_PLUS)))) // INLINED!!
			if UDG_STAT_CLAMP[stattype] then
				if nv <= 0. then
					//if stattype != ENUM_STAT_MAXHP then
						return 0.
					//endif
				else
					return nv
				endif
			else
				return nv
			endif
  endfunction

  function s__Unit_prototype_getPureStatValue takes integer this,integer stattype returns real
			return (LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_BASE)))) + (LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_LEVEL)))) * ( (s__Unit_prototype_level_true[(this)]) - 1 ) // INLINED!!
  endfunction

  function s__Unit_prototype_getLuckyPercent takes integer this,real statValue,real min,real const returns real
			return 1. - ( 1. - min ) * ( const / ( const + statValue ) )
  endfunction

  function s__Unit_prototype_luckyTest takes integer this,real statValue,real min,real const returns boolean
			return (I2R(GetRandomInt(0, 100000)) / 100000.) <= s__Unit_prototype_getLuckyPercent(this,statValue , min , const) // INLINED!!
  endfunction

  function s__Unit_prototype_recoverAttackDelay takes integer this,boolean flag returns nothing
			set s__Unit_prototype_recover_attack_delay[this]=flag
			call s__Unit_prototype_refreshAttackSpeedRequest(this,s__Unit_prototype_getCalculatedStatValue(this,ENUM_STAT_ATTACK_SPEED))
  endfunction

  function s__Unit_prototype_refreshStatValue takes integer this,integer stattype returns nothing
			
			if stattype == ENUM_STAT_ATTACK_RANGE then
				call sc__Unit_prototype__set_attack_range(this,s__Unit_prototype_getCalculatedStatValue(this,stattype))
			elseif stattype == ENUM_STAT_MAXHP then
				call sc__Unit_prototype__set_maxhp(this,s__Unit_prototype_getCalculatedStatValue(this,ENUM_STAT_MAXHP))
			elseif stattype == ENUM_STAT_MAXMP then
				call sc__Unit_prototype__set_maxmp(this,s__Unit_prototype_getCalculatedStatValue(this,ENUM_STAT_MAXMP))
			elseif stattype == ENUM_STAT_MOVEMENT_SPEED then
				if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],ENUM_STATUS_ENSNARE) > 0 then
					call sc__Unit_prototype__set_movement_speed(this,1.)
				else
					call sc__Unit_prototype__set_movement_speed(this,s__Unit_prototype_getCalculatedStatValue(this,ENUM_STAT_MOVEMENT_SPEED))
				endif
			elseif stattype == ENUM_STAT_ATTACK_SPEED then
				call s__Unit_prototype_refreshAttackSpeedRequest(this,s__Unit_prototype_getCalculatedStatValue(this,ENUM_STAT_ATTACK_SPEED))
			endif
  endfunction

  function s__Unit_prototype_refreshLevelStatValue takes integer this returns nothing
			call s__Unit_prototype_refreshStatValue(this,ENUM_STAT_MAXHP)
			call s__Unit_prototype_refreshStatValue(this,ENUM_STAT_MAXMP)
  endfunction

		// method setStatValue takes integer stattype, integer statindex, real newval returns nothing
		// 	/*능력치값 변경*/
		// 	call SaveReal(.HASH,this,INDEX_STAT+(stattype*ENUM_STAT_INDEX_SIZE)+statindex,newval)
		// endmethod

  function s__Unit_prototype_plusStatValue takes integer this,integer stattype,real val returns nothing
			call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_PLUS ) ), (( (( (LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_PLUS)))) + val)*1.0))*1.0)) // INLINED!!
			call s__Unit_prototype_refreshStatValue(this,stattype)
  endfunction

  function s__Unit_prototype_plusBaseStatValue takes integer this,integer stattype,real val returns nothing
			call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_BASE ) ), (( (( (LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_BASE)))) + val)*1.0))*1.0)) // INLINED!!
			call s__Unit_prototype_refreshStatValue(this,stattype)
  endfunction

  function s__Unit_prototype_minusStatValue takes integer this,integer stattype,real val returns nothing
			call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_MINUS ) ), (( (( (LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_MINUS)))) + val)*1.0))*1.0)) // INLINED!!
			call s__Unit_prototype_refreshStatValue(this,stattype)
  endfunction

  function s__Unit_prototype_multiplyStatValue takes integer this,integer stattype,real val returns nothing
			call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_MULTIPLY ) ), (( (( (LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_MULTIPLY)))) + val)*1.0))*1.0)) // INLINED!!
			call s__Unit_prototype_refreshStatValue(this,stattype)
  endfunction

  function s__Unit_prototype_divideStatValue takes integer this,integer stattype,real val returns nothing
			call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_DIVIDE ) ), (( (( (LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_DIVIDE)))) + val)*1.0))*1.0)) // INLINED!!
			call s__Unit_prototype_refreshStatValue(this,stattype)
  endfunction

  function s__Unit_prototype_initStatValue takes integer this returns nothing
   local integer i= 0
   local integer j= 0
			loop
				exitwhen i >= ENUM_STAT_SIZE
				call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((i ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_DIVIDE ) ), (( (( 1.)*1.0))*1.0)) // INLINED!!
				call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((i ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_MULTIPLY ) ), (( (( 1.)*1.0))*1.0)) // INLINED!!
				call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((i ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_BASE ) ), (( (( UDG_STAT_DEFAULT_VALUE[i])*1.0))*1.0)) // INLINED!!
				call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((i ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_LEVEL ) ), (( (( UDG_STAT_DEFAULT_VALUE_LEVEL[i])*1.0))*1.0)) // INLINED!!
				call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((i ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_PLUS ) ), (( (( 0.)*1.0))*1.0)) // INLINED!!
				call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((i ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_MINUS ) ), (( (( 0.)*1.0))*1.0)) // INLINED!!
				set i=i + 1
			endloop
			call s__Unit_prototype_refreshStatValue(this,ENUM_STAT_MAXHP)
			call s__Unit_prototype_refreshStatValue(this,ENUM_STAT_MAXMP)
			call s__Unit_prototype_refreshStatValue(this,ENUM_STAT_MOVEMENT_SPEED)
			call s__Unit_prototype_refreshStatValue(this,ENUM_STAT_ATTACK_SPEED)
			call s__Unit_prototype_refreshStatValue(this,ENUM_STAT_ATTACK_RANGE)
  endfunction

