  function s__AbilityMix_addRecommendRecipe takes integer this returns nothing
   local integer i= 0
			loop
				if not HaveSavedInteger(AbilityMix___HASH2, s__AbilityMix_main[this], i) then
					call SaveInteger(AbilityMix___HASH2, s__AbilityMix_main[this], i, this)
					exitwhen true
				endif
				set i=i + 1
			endloop
			loop
				if not HaveSavedInteger(AbilityMix___HASH2, s__AbilityMix_sub[this], i) then
					call SaveInteger(AbilityMix___HASH2, s__AbilityMix_sub[this], i, this)
					exitwhen true
				endif
				set i=i + 1
			endloop
  endfunction

  function s__AbilityMix_getRecommendRecipe takes integer aid,integer index returns integer
			if HaveSavedInteger(AbilityMix___HASH2, aid, index) then
				return LoadInteger(AbilityMix___HASH2, aid, index)
			else
				return - 1
			endif
  endfunction

  function s__AbilityMix_registerRecipe takes integer this returns nothing
			call SaveInteger(AbilityMix___HASH, s__AbilityMix_main[this], s__AbilityMix_sub[this], this)
			call SaveInteger(AbilityMix___HASH, s__AbilityMix_sub[this], s__AbilityMix_main[this], this)
  endfunction

  function s__AbilityMix_getTier takes integer base,integer material returns integer
			return (LoadInteger(Ability__HASH1, (base), s__Ability_INDEX_TIER)) + (LoadInteger(Ability__HASH1, (material), s__Ability_INDEX_TIER)) // INLINED!!
  endfunction

  function s__AbilityMix_getRecipe takes integer base,integer material returns integer
			if HaveSavedInteger(AbilityMix___HASH, base, material) then
				
				return LoadInteger(AbilityMix___HASH, base, material)
			else
				
				return 0
			endif
  endfunction

  function s__AbilityMix_getResult takes integer base,integer material returns integer
			if base <= 0 or material <= 0 then
				
				return s__AbilityMix_EMPTY
			
			elseif base == material then
				
				if (LoadInteger(Ability__HASH1, (base), s__Ability_INDEX_TIER)) <= 0 then // INLINED!!
					return s__AbilityMix_DISABLED
				
				else
					return s__AbilityMix_LEVEL
				endif
			elseif ((LoadInteger(Ability__HASH1, ((base )), s__Ability_INDEX_TIER)) + (LoadInteger(Ability__HASH1, (( material)), s__Ability_INDEX_TIER))) <= CONFIG_TIER_MAX then // INLINED!!
				
				if s__AbilityMix_getRecipe(base , material) > 0 then
					return s__AbilityMix_result[s__AbilityMix_getRecipe(base , material)]
				
				else
					
					if (LoadInteger(Ability__HASH1, (base), s__Ability_INDEX_TIER)) <= 0 or (LoadInteger(Ability__HASH1, (material), s__Ability_INDEX_TIER)) <= 0 then // INLINED!!
						return s__AbilityMix_DISABLED
					
					else
						return s__AbilityMix_RANDOM
					endif
				endif
			else
				
				return s__AbilityMix_DISABLED
			endif
  endfunction

		
  function s__AbilityMix_carculateMixLevel takes integer am1,integer am2 returns integer
   local integer i= 0
   local integer sum= 0
			if am1 <= 0 or am2 <= 0 then
				return 0
			endif
			loop
				exitwhen i >= CONFIG_UPGRADE_MAX
				set sum=sum + ( s__AbilityMixElement_getUpgradePoint(am1,i) + s__AbilityMixElement_getUpgradePoint(am2,i) ) / ( s__AbilityMixElement_getTier(am1) + s__AbilityMixElement_getTier(am2) )
				set i=i + 1
			endloop
			return sum
  endfunction

		
		
  function s__AbilityMix_carculateUpgradePoint takes integer am1,integer am2 returns nothing
   local integer i= 0
			if am1 <= 0 or am2 <= 0 then
				loop
					exitwhen i >= CONFIG_UPGRADE_MAX
					set s__AbilityMix_UPGRADE[i]=0
					set s__AbilityMix_REFUND[i]=0
					set i=i + 1
				endloop
			else
				loop
					exitwhen i >= CONFIG_UPGRADE_MAX
					set s__AbilityMix_UPGRADE[i]=( ( s__AbilityMixElement_getUpgradePoint(am1,i) + s__AbilityMixElement_getUpgradePoint(am2,i) ) / ( s__AbilityMixElement_getTier(am1) + s__AbilityMixElement_getTier(am2) ) ) * ( s__AbilityMixElement_getTier(am1) + s__AbilityMixElement_getTier(am2) )
					set s__AbilityMix_REFUND[i]=( s__AbilityMixElement_getUpgradePoint(am1,i) + s__AbilityMixElement_getUpgradePoint(am2,i) ) - s__AbilityMix_UPGRADE[i]
					// call BJDebugMsg(I2S(am1.getUpgradePoint(i))+"+"+I2S(am2.getUpgradePoint(i))+"=|cff00ff00"+I2S(UPGRADE[i])+"|r, |cffff0000"+I2S(REFUND[i])+"|r")
					set i=i + 1
				endloop
			endif
  endfunction

		
  function s__AbilityMix_mix takes integer target,integer am1,integer am2 returns boolean
   local integer i= 0
   local integer ab= 0
   local integer recipe= 0
   local integer na= 0
   local integer nlv= 0
   local boolean nsignature= false
   local boolean result= false
			set recipe=s__AbilityMix_getRecipe(s__AbilityMixElement_getId(am1) , s__AbilityMixElement_getId(am2))
			
			if s__AbilityMix_result[recipe] <= 0 then
				set CUSTOM_RESPOND_ERROR_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[(target)])) // INLINED!!
				set CUSTOM_RESPOND_ERROR_MESSAGE="유효하지 않은 레시피입니다."
				call sc__Event_activate(CONFIG_EVENT_ERROR)
				return false
			endif
			
			if s__AbilityMixElement_getLevel(am1) < s__AbilityMix_LEVEL_REQUIRE or s__AbilityMixElement_getLevel(am2) < s__AbilityMix_LEVEL_REQUIRE then
				set CUSTOM_RESPOND_ERROR_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[(target)])) // INLINED!!
				set CUSTOM_RESPOND_ERROR_MESSAGE="스킬,스킬 파편의 레벨이 부족합니다."
				call sc__Event_activate(CONFIG_EVENT_ERROR)
				return false
			endif
			
			if s__AbilityMixElement_element_type[am2] == s__AbilityMixElement_TYPE_ABILITY then
				set CUSTOM_RESPOND_ERROR_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[(target)])) // INLINED!!
				set CUSTOM_RESPOND_ERROR_MESSAGE="보유중인 스킬은 부 재료로 등록할 수 없습니다."
				call sc__Event_activate(CONFIG_EVENT_ERROR)
				return false
			endif
			
			if s__AbilityMixElement_element_type[am1] == s__AbilityMixElement_TYPE_ABILITY and sc__Unit_prototype_getAbilityById(target,s__AbilityMix_result[recipe]) > 0 then
				set CUSTOM_RESPOND_ERROR_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[(target)])) // INLINED!!
				set CUSTOM_RESPOND_ERROR_MESSAGE="해당 유형의 스킬을 이미 보유하고 있습니다."
				call sc__Event_activate(CONFIG_EVENT_ERROR)
				return false
			endif
			
			set nlv=s__AbilityMix_carculateMixLevel(am1 , am2)
			call s__AbilityMix_carculateUpgradePoint(am1 , am2)
			set nsignature=s__AbilityMixElement_isSignature(am1)
			call s__AbilityMixElement_kill(am1)
			call s__AbilityMixElement_kill(am2)
			if s__AbilityMixElement_element_type[am1] == s__AbilityMixElement_TYPE_ABILITY then
				
				set na=sc__Unit_prototype_addAbility(target,s__AbilityMix_result[recipe])
				
				call sc__Ability_prototype_addLevel((na),nlv - 1)
				
				set s__Ability_signature[(na)]=nsignature
				
				set i=0
				loop
					exitwhen i >= CONFIG_UPGRADE_MAX
					call SaveInteger(Ability__HASH2, ((na)), s__Ability_INDEX_UPGRADE_POINT + (i ), ( s__AbilityMix_UPGRADE[i])) // INLINED!!
					call sc__Unit_addUpgradePoint(target,i , s__AbilityMix_REFUND[i])
					set i=i + 1
				endloop
				
				call sc__User_addGold((GetOwningPlayer(s__Unit_prototype_origin_unit[(target)])) , sc__Unit_getUpgradePoint(target,CONFIG_UPGRADE_GOLD)) // INLINED!!
				call sc__Unit_setUpgradePoint(target,CONFIG_UPGRADE_GOLD , 0)
			else
				
				set na=s__AbilityShard_create(s__AbilityMix_result[recipe])
				call sc__Item_prototype_pick((na),target)
				
				call s__AbilityShard_addLevel((na),nlv - 1)
				
				set i=0
				loop
					exitwhen i >= CONFIG_UPGRADE_MAX
					call s__AbilityShard_setUpgradePoint((na),i , s__AbilityMix_UPGRADE[i])
					call sc__Unit_addUpgradePoint(target,i , s__AbilityMix_REFUND[i])
					set i=i + 1
				endloop
				
				call sc__User_addGold((GetOwningPlayer(s__Unit_prototype_origin_unit[(target)])) , sc__Unit_getUpgradePoint(target,CONFIG_UPGRADE_GOLD)) // INLINED!!
				call sc__Unit_setUpgradePoint(target,CONFIG_UPGRADE_GOLD , 0)
			endif
			
			call sc__Effect_setDuration(sc__AttatchedEffect_create(AbilityMix___EFFECT_PATH3 , target),2.0)
			return true
  endfunction

		
  function s__AbilityMix_mixRandom takes integer target,integer am1,integer am2 returns boolean
   local integer i= 0
   local integer table= 0
   local integer ab= 0
   local integer na= 0
   local integer nlv= 0
   local boolean nsignature= false
   local integer rabil= 0
   local boolean result= false
			
			if s__AbilityMixElement_isSignature(am1) then
