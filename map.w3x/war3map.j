  function s__BuffIndicator_refreshIconsTarget takes integer this returns nothing
   local integer j= 0
   local integer b= s__Buff_getUnitRootBuff(s__BuffIndicator_target[this])
			
			loop
				exitwhen j >= BuffIndicator___BUFF_ICONS_MAX or b <= 0
				if s__Buff_icon_display[b] then
					call s__BuffIndicator_setIconTarget(this,j , b)
					set j=j + 1
				endif
				set b=s__Buff_node_next[b]
			endloop
			
			loop
				exitwhen j >= BuffIndicator___BUFF_ICONS_MAX
				call s__BuffIndicator_setIconTarget(this,j , 0)
				set j=j + 1
			endloop
  endfunction

  function s__BuffIndicator_timerCallback takes nothing returns nothing
   local integer this= sc__Timer_getData(GetExpiredTimer())
			call s__BuffIndicator_refreshIconsTarget(this)
  endfunction

  function s__BuffIndicator_runTimer takes integer this,boolean flag returns nothing
