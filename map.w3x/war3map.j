			call BlzFrameSetVisible(s__s__AbilityIcon_EXTRA_TEXT[s__AbilityIcon_index[this]], s__Ability_prototype_count_max[s__AbilityIcon_target[this]] > 1)
			call BlzFrameSetText(s__s__AbilityIcon_EXTRA_TEXT[s__AbilityIcon_index[this]], I2S(s__Ability_prototype_count[s__AbilityIcon_target[this]]))
			
			call BlzFrameSetVisible(s__s__AbilityIcon_GAUGE_BACKDROP[s__AbilityIcon_index[this]], s__Ability_prototype_gauge[s__AbilityIcon_target[this]] > 0.)
			call BlzFrameSetPoint(s__s__AbilityIcon_GAUGE_FILL[s__AbilityIcon_index[this]], FRAMEPOINT_BOTTOMRIGHT, s__s__AbilityIcon_GAUGE_BACKDROP[s__AbilityIcon_index[this]], FRAMEPOINT_BOTTOMLEFT, (((UI___ABILITY_ICON_SIZE)*1.0) / 1800.) * s__Ability_prototype_gauge[s__AbilityIcon_target[this]], 0) // INLINED!!
        endif
    endfunction

 function s__AbilityIcon_showTooltip takes integer this,boolean flag returns nothing
		if GetLocalPlayer() == s__AbilityIcon_owner[this] then
