   function s__Ability10y0_actor_onComplete takes integer this returns nothing
				call s__Effect_kill(s__Effect_setColor(s__Effect_setRoll(s__Effect_setScale(s__Effect_create(Ability10y0__EFFECT_PATH1 , sc__Object__get_x(s__UnitActor_target[this]) , sc__Object__get_y(s__UnitActor_target[this]) , sc__Object__get_z(s__UnitActor_target[this]) + s__Object_pivot_z[s__UnitActor_target[this]] , 270.),1.8),GetRandomReal(- 55, 55)),0 , 116 , 19))
				call s__Effect_kill(s__Effect_setScale(s__Effect_create(Ability10y0__EFFECT_PATH2 , sc__Object__get_x(s__UnitActor_target[this]) , sc__Object__get_y(s__UnitActor_target[this]) , sc__Object__get_z(s__UnitActor_target[this]) + s__Object_pivot_z[s__UnitActor_target[this]] , 270.),1.8))
				set s__MeleeAttack_damage[this]=( ( s__Unit_prototype_getCarculatedStatValue((s__Actor_actor[((this))]),Ability10y0__DAMAGE_STAT2) * Ability10y0__DAMAGE_AMPLIFIER2 ) + ( s__Unit_prototype_getCarculatedStatValue((s__Actor_actor[((this))]),Ability10y0__DAMAGE_STAT1) * Ability10y0__DAMAGE_AMPLIFIER1 ) ) * ( 1 + Ability10y0__DAMAGE_PER_LEVEL * s__UnitActor_level[this] ) // INLINED!!
				call s__MeleeAttack_damageTarget(this,s__UnitActor_target[this])
				call s__Buff_add((s__Actor_actor[(this)]) , s__UnitActor_target[this] , Ability10y0__ID , s__UnitActor_level[this] , Ability10y0__DURATION) // INLINED!!
				call s__Backswing_create((s__Actor_actor[(this)])) // INLINED!!
   endfunction
	
   function s__Ability10y0_actor_create takes integer caster,integer target,integer level returns integer
    local integer this= s__Ability10y0_actor__allocate(caster , target)
