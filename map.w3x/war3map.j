  function s__ArrayList_swap takes integer this,integer index1,integer index2 returns boolean
   local integer tmpval= 0
			if index1 < 0 or index1 >= s__ArrayList_size[this] then
				return false
			elseif index2 < 0 or index2 >= s__ArrayList_size[this] then
				return false
			elseif index1 == index2 then
				return false
			endif
			set tmpval=s__ArrayList_get(this,index1)
			call s__ArrayList_setData(this,index1 , s__ArrayList_get(this,index2))
			call s__ArrayList_setData(this,index2 , tmpval)
			return true
  endfunction

  function s__ArrayList_shuffle takes integer this returns nothing
   local integer i= 0
