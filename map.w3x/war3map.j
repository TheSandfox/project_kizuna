  function s__Shuffle_prototype_addValue takes integer i returns nothing
			set s__s__Shuffle_prototype_VALUE[s__Shuffle_prototype_SIZE]= i
			set s__Shuffle_prototype_SIZE=s__Shuffle_prototype_SIZE + 1
  endfunction

  function s__Shuffle_prototype_reset takes nothing returns nothing
			set s__Shuffle_prototype_SIZE=0
  endfunction

  function s__Shuffle_prototype_pick takes nothing returns integer
   local integer i= GetRandomInt(0, s__Shuffle_prototype_SIZE - 1)
   local integer rv= s__s__Shuffle_prototype_VALUE[i]
			loop
				exitwhen i + 1 >= s__Shuffle_prototype_SIZE
				set s__s__Shuffle_prototype_VALUE[i]= s__s__Shuffle_prototype_VALUE[i + 1]
				set i=i + 1
			endloop
			set s__Shuffle_prototype_SIZE=s__Shuffle_prototype_SIZE - 1
			return rv
  endfunction



//library ShufflePrototype ends
//library TimerUtils:
//*********************************************************************
//* TimerUtils (Purple flavor for 1.23b or later)
//* ----------
//*
//*  To implement it , create a custom text trigger called TimerUtils
//* and paste the contents of this script there.
//*
//*  To copy from a map to another, copy the trigger holding this
//* library to your map.
//*
//* (requires vJass)   More scripts: http://www.wc3c.net/
//*
//* For your timer needs:
//*  * Attaching
//*  * Recycling (with double-free protection)
//*
//* set t=NewTimer()      : Get a timer (alternative to CreateTimer)
//* ReleaseTimer(t)       : Relese a timer (alt to DestroyTimer)
//* SetTimerData(t,2)     : Attach value 2 to timer
//* GetTimerData(t)       : Get the timer's value.
//*                         You can assume a timer's value is 0
//*                         after NewTimer.
//*
//* Purple Flavor: Slower than the red flavor by a multiplication and a
//*             division, and as such faster than the blue flavor. Has
//*             a theoretical limit of timers, which is HASH_SIZE, but
//*             you should keep your timer count below 3/4 of that to
//*             insure good performance of the NewTimer function.
//*
//* Credits:  * Hash algorithm by Cohadar (used in an early version
//*             of his ABCT timer system)
//*
//*           * TimerUtils "interface" by Vexorian.
//*
//*           * This library by Iron_Doors.
//*
//********************************************************************

//================================================================

    //==================================================================================================
    
    function SetTimerData takes timer t,integer value returns nothing
        call sg__TimerUtils___DATA_set(GetHandleId(t) * HASH_UP / HASH_DOWN + HASH_BIAS,value)
    endfunction

    function GetTimerData takes timer t returns integer
        return sg__TimerUtils___DATA_get(GetHandleId(t) * HASH_UP / HASH_DOWN + HASH_BIAS)
    endfunction

    //==========================================================================================

    //==========================================================================================
    function NewTimer takes nothing returns timer
      local timer t











        if ( TimerUtils___tN == 0 ) then
            loop
                set t=CreateTimer()
                set TimerUtils___tH[0]=GetHandleId(t) * HASH_UP / HASH_DOWN + HASH_BIAS
                exitwhen sg__TimerUtils___TIMER_get(TimerUtils___tH[0]) == null
            endloop
            call sg__TimerUtils___TIMER_set(TimerUtils___tH[0],t)
        else
            set TimerUtils___tN=TimerUtils___tN - 1
        endif
        call sg__TimerUtils___DATA_set(TimerUtils___tH[TimerUtils___tN],0)
		set t=null
     	return sg__TimerUtils___TIMER_get(TimerUtils___tH[TimerUtils___tN])
    endfunction

    //==========================================================================================
    function ReleaseTimer takes timer t returns nothing











        if ( t == null ) then
            return
        endif
        call PauseTimer(t)
        set TimerUtils___tH[TimerUtils___tN]=GetHandleId(t) * HASH_UP / HASH_DOWN + HASH_BIAS
        if ( sg__TimerUtils___DATA_get(TimerUtils___tH[TimerUtils___tN]) == TimerUtils___HELD ) then
            return
        endif
        call sg__TimerUtils___DATA_set(TimerUtils___tH[TimerUtils___tN],TimerUtils___HELD)
        set TimerUtils___tN=TimerUtils___tN + 1
    endfunction
	//===========================================================================================
 function NewGroup takes nothing returns group
  local group g











		   if ( TimerUtils___gN == 0 ) then
			   loop
				   set g=CreateGroup()
				   set TimerUtils___gH[0]=GetHandleId(g) * HASH_UP / HASH_DOWN + HASH_BIAS
				   exitwhen sg__TimerUtils___GROUP_get(TimerUtils___gH[0]) == null
			   endloop
			   call sg__TimerUtils___GROUP_set(TimerUtils___gH[0],g)
		   else
			   set TimerUtils___gN=TimerUtils___gN - 1
		   endif
	   	set g=null
		return sg__TimerUtils___GROUP_get(TimerUtils___gH[TimerUtils___gN])
	   endfunction
   
	//==========================================================================================
 function ReleaseGroup takes group g returns nothing











		if ( g == null ) then
			return
		endif
		call GroupClear(g)
		set TimerUtils___gH[TimerUtils___gN]=GetHandleId(g) * HASH_UP / HASH_DOWN + HASH_BIAS
		set TimerUtils___gN=TimerUtils___gN + 1
	endfunction
	//==========================================================================================
    function TimerUtils___init takes nothing returns nothing
	call ReleaseTimer(NewTimer())
	call ReleaseGroup(NewGroup())
    endfunction


//library TimerUtils ends
//library Tip:



  function s__Tip_act takes nothing returns nothing
			call DisplayTimedTextToPlayer(GetLocalPlayer(), 0., 0., 10., "\n|cffffcc00정보 : |r" + s__Tip_TIPS[GetRandomInt(0, s__Tip_TIP_MAX - 1)])
			call PlaySoundBJ(gg_snd_Hint)
  endfunction

  function s__Tip_addTip takes string tip returns nothing
			set s__Tip_TIPS[s__Tip_TIP_MAX]=tip
			set s__Tip_TIP_MAX=s__Tip_TIP_MAX + 1
  endfunction

  function s__Tip_init takes nothing returns nothing
			call TriggerRegisterTimerEvent(s__Tip_TRIGGER, s__Tip_TIP_INTERVAL, true)
			call TriggerAddCondition(s__Tip_TRIGGER, Condition(function s__Tip_act))
			call s__Tip_addTip("|cffffcc00Ctrl + 스킬 단축키 입력으로 빠른 시전 설정을 할 수 있습니다.|r\n|cff999999사용 안함|r |cffffcc00-> 사거리 표시 ->|r |cff00ffff즉시 사용|r |cffffcc00순으로 변경됩니다.|r")
			call s__Tip_addTip("|cffffcc00Shift + 스킬 단축키 입력으로 특수 상호작용이 가능한 스킬이 일부 존재합니다.|r")
			call s__Tip_addTip(CUSTOM_STRING_CAST_TYPE_NAME[CONFIG_CAST_TYPE_WEAPON] + "|cffffcc00는 동시에 한 종류만 사용할 수 있습니다.|r")
			call s__Tip_addTip("|cffffcc00스킬마다 최소 재사용 대기시간이 존재하며 해당 시간보다 재사용 시간을 적게 줄일 수 없습니다.|r")
			call s__Tip_addTip("|cffffcc00캐릭터가 최초로 보유한 스킬은 캐릭터의 레벨이 올라갈 때 마다 같이 레벨이 상승합니다.|r")
			call s__Tip_addTip("|cffffcc00장착중인 |r" + CUSTOM_STRING_CAST_TYPE_NAME[CONFIG_CAST_TYPE_WEAPON] + "|cffffcc00는 Ctrl + 스킬 단축키 입력으로 장착 해제할 수 있습니다.|r")
			call s__Tip_addTip("S|cffffcc00버튼 입력 시 자동공격이 비활성화된 상태로 정지합니다. |rH|cffffcc00버튼 입력 시 자동공격이 활성화된 상태로 정지합니다.|r")
			call s__Tip_addTip("빠른시전 설정 여부와 관계없이 단축키 입력 시 항상 즉발되는 스킬들이 일부 존재합니다.")
			call s__Tip_addTip("최대레벨을 초과하는 스킬 레벨합성 시 초과분에 해당하는 강화재화가 환급됩니다.")
  endfunction



//library Tip ends
//library Tombstone:





  function s__Tombstone_timerAction takes nothing returns nothing
   local integer this= sc__Timer_getData(GetExpiredTimer())
   local real val= 0.
			
			if GetLocalPlayer() == (GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Tombstone_owner[this])])) then // INLINED!!
				call BlzFrameSetVisible(s__Tombstone_text[this], (s__User_FOCUS_UNIT[GetPlayerId(((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Tombstone_owner[this])]))))]) == s__Tombstone_owner[this]) // INLINED!!
			endif
			if s__Tombstone_GAME_OVER then
				call sc__Unit_prototype__set_hp(s__Tombstone_owner[this],1.)
				call BlzFrameSetText(s__Tombstone_text[this], "|cffff0000∞|r")
				call BlzFrameSetScale(s__Tombstone_text[this], 2.0)
				set s__Tombstone_text[this]=null
				return
			else
				call sc__Unit_prototype_healUnit(s__Tombstone_owner[this],s__Tombstone_owner[this] , (s__Unit_prototype_maxhp_true[(s__Tombstone_owner[this])]) * s__Tombstone_HEAL_PER_SEC * s__Tombstone_TICK) // INLINED!!
				
				set val=( (s__Unit_prototype_maxhp_true[(s__Tombstone_owner[this])]) - (s__Unit_prototype_hp_true[(s__Tombstone_owner[this])]) ) / ( ( (s__Unit_prototype_maxhp_true[(s__Tombstone_owner[this])]) * s__Tombstone_HEAL_PER_SEC + sc__Unit_prototype__get_hpregen(s__Tombstone_owner[this]) ) * sc__Unit_prototype_getCarculatedStatValue(s__Tombstone_owner[this],CONFIG_STAT_HEAL_AMP) ) // INLINED!!
				call BlzFrameSetText(s__Tombstone_text[this], "|cffff0000" + I2S(R2I(val) + 1) + "|r")
			endif
  endfunction

  function s__Tombstone_create takes integer u returns integer
   local integer this= 0
			if not s__Unit_prototype_is_revive[u] then
				return 0
			endif
			set this=u
			set s__Tombstone_exists[this]=true
			set s__Tombstone_owner[this]=u
			set s__Tombstone_ef[this]=sc__Effect_create(s__Tombstone_EFFECT_PATH1 , sc__Object__get_x(s__Tombstone_owner[this]) , sc__Object__get_y(s__Tombstone_owner[this]) , 0. , 270.)
			set s__Tombstone_main_timer[this]=sc__Timer_new(this)
			call TimerStart((s__Tombstone_main_timer[this] ), (( s__Tombstone_TICK )*1.0), ( true ), ( function s__Tombstone_timerAction)) // INLINED!!
			set s__Tombstone_text[this]=BlzCreateFrame("MyTextLarge", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_BASIC], 0, 0)
			call BlzFrameSetPoint(s__Tombstone_text[this], FRAMEPOINT_CENTER, FRAME_PORTRAIT_BACKDROP, FRAMEPOINT_CENTER, 0., 0.)
			call BlzFrameSetVisible(s__Tombstone_text[this], GetLocalPlayer() == (GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Tombstone_owner[this])]))) // INLINED!!
			return this
  endfunction

  function s__Tombstone_destroy takes integer this returns nothing
   local integer eff= sc__Effect_setDuration(sc__Effect_setAnim(sc__Effect_create(s__Tombstone_EFFECT_PATH2 , sc__Object__get_x(s__Tombstone_owner[this]) , sc__Object__get_y(s__Tombstone_owner[this]) , 0. , 270.),ANIM_TYPE_DEATH),3.33)
			set s__Effect_want_remove[eff]=true
			call sc__Timer_release(s__Tombstone_main_timer[this])
			set s__Tombstone_main_timer[this]=null
			set s__Effect_want_remove[s__Tombstone_ef[this]]=true
			call sc__Object_prototype_deallocate(s__Tombstone_ef[this])
			set s__Tombstone_ef[this]=0
			set s__Tombstone_exists[this]=false
//textmacro instance: destroyFrame(".text")
	call BlzDestroyFrame(s__Tombstone_text[this])
	set s__Tombstone_text[this]=null
//end of: destroyFrame(".text")
			
  endfunction

  function s__Tombstone_death takes nothing returns nothing
			if CUSTOM_RESPOND_DEATH_UNIT <= 0 then
				return
			endif
			if not s__Tombstone_exists[(CUSTOM_RESPOND_DEATH_UNIT)] then
				call s__Tombstone_create(CUSTOM_RESPOND_DEATH_UNIT)
			endif
  endfunction

  function s__Tombstone_revive takes nothing returns nothing
			if CUSTOM_RESPOND_REVIVE_UNIT <= 0 then
				return
			endif
			if s__Tombstone_exists[(CUSTOM_RESPOND_REVIVE_UNIT)] then
				call s__Tombstone_destroy((CUSTOM_RESPOND_REVIVE_UNIT))
			endif
  endfunction

  function s__Tombstone_decay takes nothing returns nothing
			if CUSTOM_RESPOND_DECAY_UNIT <= 0 then
				return
			endif
			if s__Tombstone_exists[(CUSTOM_RESPOND_DECAY_UNIT)] then
				call s__Tombstone_destroy((CUSTOM_RESPOND_DECAY_UNIT))
			endif
  endfunction

  function s__Tombstone_onInit takes nothing returns nothing
			set s__Tombstone_DEATH_TRIGGER=CreateTrigger()
			call TriggerRegisterVariableEvent((s__Tombstone_DEATH_TRIGGER ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_DEATH)*1.0)) // INLINED!!
			call TriggerAddCondition(s__Tombstone_DEATH_TRIGGER, Condition(function s__Tombstone_death))
			set s__Tombstone_REVIVE_TRIGGER=CreateTrigger()
			call TriggerRegisterVariableEvent((s__Tombstone_REVIVE_TRIGGER ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_REVIVE)*1.0)) // INLINED!!
			call TriggerAddCondition(s__Tombstone_REVIVE_TRIGGER, Condition(function s__Tombstone_revive))
			set s__Tombstone_DECAY_TRIGGER=CreateTrigger()
			call TriggerRegisterVariableEvent((s__Tombstone_DECAY_TRIGGER ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_DECAY)*1.0)) // INLINED!!
			call TriggerAddCondition(s__Tombstone_DECAY_TRIGGER, Condition(function s__Tombstone_decay))
  endfunction



