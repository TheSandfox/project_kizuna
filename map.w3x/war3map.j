				set this=s__ArrayList_get(s__s__ExtraAbilityIcon_ICONS[(sg__TimerUtils___DATA_get(GetHandleId(((GetExpiredTimer()))) * HASH_UP / HASH_DOWN + HASH_BIAS))],i) // INLINED!!
