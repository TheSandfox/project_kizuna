			call IssuePointOrder(s__Unit_prototype_origin_unit[(this)], ("attack" ), (( GetRectCenterX(gg_rct_TreeOfLife) )*1.0), (( GetRectCenterY(gg_rct_TreeOfLife))*1.0)) // INLINED!!
