  function s__Buff20d1_main_damageCallback takes nothing returns nothing
   local integer this= 0
			if CUSTOM_RESPOND_DAMAGE_ONHIT_TYPE != s__Damage_ONHIT_TYPE_ONHIT then
				return
			endif
			if CUSTOM_RESPOND_DAMAGE_ATTACK_TYPE != s__Damage_ATTACK_TYPE_BASIC then
				return
			endif
			set this=(LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if CUSTOM_RESPOND_DAMAGE_ATTACKER != s__Buff_target[this] then
				return
			endif
			set CUSTOM_RESPOND_DAMAGE_PLUS=CUSTOM_RESPOND_DAMAGE_PLUS + s__Buff20d1_main_v[this]
			call sc__Buff_deallocate(this)
  endfunction

  function s__Buff20d1_main_update takes integer this returns boolean
   local real new= s__Unit_prototype_getCarculatedStatValue(s__Buff_caster[this],Buff20d1_DAMAGE_STAT1) * Buff20d1_DAMAGE_AMPLIFIER1 * ( 1 + Buff20d1_DAMAGE_PER_LEVEL * ( s__Buff_level[this] ) )
			if new > s__Buff20d1_main_v[this] then
				set s__Buff20d1_main_v[this]=new
			endif
			return true
  endfunction

