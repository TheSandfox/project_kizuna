				set ps=sc__ProgressiveLine_create(sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , 0. , s__Boss_BossB000__rollingstone_roll_RAD , s__Boss_BossB000__rollingstone_roll_RANGE , ta , s__Boss_BossB000__rollingstone_DELAY1) // INLINED!!
				call sc__Effect_setColor(sc__ProgressiveEffect_getEffect(ps,0),192 , 0 , 0)
				call sc__Effect_setColor(sc__ProgressiveEffect_getEffect(ps,1),255 , 0 , 0)
			
			else
				set tx=sc__Object__get_x(target)
				set ty=sc__Object__get_y(target)
				
				if s__Math_inBox(tx , ty , GetRectMinX(s__Boss_zone[caster]) , GetRectMaxY(s__Boss_zone[caster]) , s__Boss_ZONE_SIZE , s__Boss_ZONE_SIZE) then
