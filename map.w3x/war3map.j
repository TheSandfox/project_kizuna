//textmacro instance: abilityTooltip1000()
function s__Ability1000_main_relativeTooltip takes integer this,integer caster returns string
	return "지정한 방향으로 약진하여 충돌하는 대상과 대상 주변의 적들에게 |cffff9900" + R2SW(1.5 * s__Unit_prototype_getCarculatedStatValue(caster,CONFIG_STAT_DEFENSE) * ( 1 + 0.06 * s__Ability_prototype_level[this] ), 2, 2) + "|r" + s__CustomString_shiftStatTooltip(CONFIG_STAT_DEFENSE) + "의 피해를 입히고 밀쳐냅니다. 가장 가까운 적에게는 |cffffffff133%|r의 피해를 입힙니다."
endfunction
//end of: abilityTooltip1000()
	
   function s__Ability1000_main_execute takes integer this returns nothing
				call s__Ability1000_actor_create(s__Ability_prototype_owner[this] , s__Ability_prototype_command_x[this] , s__Ability_prototype_command_y[this] , s__Ability_prototype_getCarculatedCastDelayByAttackSpeed(this) , s__Ability_prototype_level[this])
   endfunction
	
   function s__Ability1000_main_init takes integer this returns nothing
//textmacro instance: abilitySetup()





	set s__Ability_prototype_id[this]=Ability1000__ID
	set s__Ability_prototype_name[this]=Ability1000__NAME
	set s__Ability_prototype_icon[this]=Ability1000__ICON_PATH
	set s__Ability_level_max[this]=(LoadInteger(Ability__HASH1, (Ability1000__ID), s__Ability_INDEX_MAX_LEVEL)) // INLINED!!
	set s__Ability_prototype_drag_to_use[this]=Ability1000__CAST_TYPE == CONFIG_CAST_TYPE_DRAG_TO_USE
	set s__Ability_prototype_cooldown_max[this]=Ability1000__COOLDOWN_MAX
	set s__Ability_prototype_cooldown_min[this]=Ability1000__COOLDOWN_MIN
	set s__Ability_prototype_manacost[this]=Ability1000__MANACOST
	// set .cast_range = RANGE
	call SaveInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_GOLD ), ( 0)) // INLINED!!
	call SaveInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_SKILL_POINT ), ( 0)) // INLINED!!
	call SaveInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_LUCK ), ( 0)) // INLINED!!
	call SaveInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_EXP ), ( 0)) // INLINED!!
	call s__Ability_plusBaseStatValue(this,5)
//end of: abilitySetup()
				set s__Ability_prototype_is_active[this]=true
				set s__Ability_prototype_is_charge[this]=true
				set s__Ability_prototype_preserve_order[this]=false
				set s__Ability_prototype_cast_delay[this]=0.25
				set s__Ability_prototype_indicator[this]=s__Ability1000__ind_create(this , (GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])]))) // INLINED!!
				
   endfunction
	
   function s__Ability1000_main_onInit takes nothing returns nothing
				call SaveStr(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_TOOLTIP, ( "단거리 돌진,\n충돌 시 범위피해")) // INLINED!!
   endfunction

   function s__Ability1000_main_executeAI takes integer this returns boolean
				if s__Math_distancePoints(sc__Object__get_x(s__Ability_prototype_owner[this]) , sc__Object__get_y(s__Ability_prototype_owner[this]) , GetUnitX(s__Ability_prototype_command_target[this]) , GetUnitY(s__Ability_prototype_command_target[this])) <= 200. then
					return s__Ability_prototype_useRequest(this,GetUnitX(s__Ability_prototype_command_target[this]) , GetUnitY(s__Ability_prototype_command_target[this]) , s__Ability_prototype_command_target[this] , false)
				else
					return false
				endif
   endfunction
	
	
//textmacro instance: abilityDataEnd()
 function Ability1000__act takes nothing returns nothing
  local integer a= 0
		if ABILITY_CREATE_ID == Ability1000__ID then
			set a=s__Ability1000_main__allocate()
			set ABILITY_LAST_CREATED=a
		endif
	endfunction

 function Ability1000__init takes nothing returns nothing
		call TriggerAddCondition(ABILITY_CREATE_TRIGGER, Condition(function Ability1000__act))
		call SaveStr(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_ICON_PATH, ( Ability1000__ICON_PATH)) // INLINED!!
		call SaveStr(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_NAME, ( Ability1000__NAME)) // INLINED!!
		call SaveInteger(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_TIER, ( Ability1000__TIER)) // INLINED!!
		call SaveInteger(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_COST, ( Ability1000__COST)) // INLINED!!
		call s__Ability_setTypeBonusStatIndex(Ability1000__ID , 0 , Ability1000__STAT_BONUS1)
		call s__Ability_setTypeBonusStatIndex(Ability1000__ID , 1 , Ability1000__STAT_BONUS2)
		call SaveBoolean(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_IS_WEAPON, ( Ability1000__IS_WEAPON)) // INLINED!!
		call SaveInteger(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_MAX_LEVEL, ( 10 + Ability1000__TIER * 5)) // INLINED!!
		if Ability1000__TAG1 != - 1 then
			call s__DamageTag_add(Ability1000__ID , Ability1000__TAG1)
		endif
		if Ability1000__TAG2 != - 1 then
			call s__DamageTag_add(Ability1000__ID , Ability1000__TAG2)
		endif
		if Ability1000__TAG3 != - 1 then
			call s__DamageTag_add(Ability1000__ID , Ability1000__TAG3)
		endif
		if Ability1000__TAG4 != - 1 then
			call s__DamageTag_add(Ability1000__ID , Ability1000__TAG4)
		endif
		call SaveInteger(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_CAST_TYPE, ( Ability1000__CAST_TYPE)) // INLINED!!

			call SaveInteger(Damage__HASH, (Ability1000__ID ), ( s__DamageFlag_INDEX_DAMAGE_TYPE ), ( Ability1000__DAMAGE_TYPE)) // INLINED!!
			call SaveInteger(Damage__HASH, (Ability1000__ID ), ( s__DamageFlag_INDEX_ATTACK_TYPE ), ( Ability1000__ATTACK_TYPE)) // INLINED!!
			call SaveInteger(Damage__HASH, (Ability1000__ID ), ( s__DamageFlag_INDEX_INTERVAL_TYPE ), ( Ability1000__INTERVAL_TYPE)) // INLINED!!
			call SaveInteger(Damage__HASH, (Ability1000__ID ), ( s__DamageFlag_INDEX_VECTOR_TYPE ), ( Ability1000__VECTOR_TYPE)) // INLINED!!
			call SaveInteger(Damage__HASH, (Ability1000__ID ), ( s__DamageFlag_INDEX_TARGET_TYPE ), ( Ability1000__TARGET_TYPE)) // INLINED!!
			call SaveInteger(Damage__HASH, (Ability1000__ID ), ( s__DamageFlag_INDEX_AOE_TYPE ), ( Ability1000__AOE_TYPE)) // INLINED!!
			call SaveInteger(Damage__HASH, (Ability1000__ID ), ( s__DamageFlag_INDEX_ONHIT_TYPE ), ( Ability1000__ONHIT_TYPE)) // INLINED!!
			call SaveInteger(Damage__HASH, (Ability1000__ID ), ( s__DamageFlag_INDEX_RANGE_TYPE ), ( Ability1000__RANGE_TYPE)) // INLINED!!

	endfunction
//end of: abilityDataEnd()
