  function s__Unit_prototype__set_attack_range takes integer this,real np returns nothing
   local real a= BlzGetUnitWeaponRealField(s__Unit_prototype_origin_unit[this], UNIT_WEAPON_RF_ATTACK_RANGE, 1)
   local real r= BlzGetUnitWeaponRealField(s__Unit_prototype_origin_unit[this], UNIT_WEAPON_RF_ATTACK_RANGE, 0)
			call BlzSetUnitWeaponRealFieldBJ(s__Unit_prototype_origin_unit[this], UNIT_WEAPON_RF_ATTACK_RANGE, 1, np - r + a)
			if np + 500. <= 600. then
				call SetUnitAcquireRange(s__Unit_prototype_origin_unit[this], np + 500.)
			else
				call SetUnitAcquireRange(s__Unit_prototype_origin_unit[this], 600.)
			endif
  endfunction

