			call sc__Effect_setColor(sc__ProgressiveEffect_getEffect(ps,1),255 , 0 , 0)
			set s__Boss_BossB000__rollingstone_atype[this]=1
		
		else
			set tx=(((sc__Object__get_x(caster) )*1.0) + (( s__Boss_BossB000__rollingstone_roll_RANGE )*1.0) * Cos((( ta)*1.0) * bj_DEGTORAD)) // INLINED!!
			set ty=(((sc__Object__get_y(caster) )*1.0) + (( s__Boss_BossB000__rollingstone_roll_RANGE )*1.0) * Sin((( ta)*1.0) * bj_DEGTORAD)) // INLINED!!
			
			if s__Math_inBox(tx , ty , GetRectMinX(s__Boss_zone[caster]) , GetRectMaxY(s__Boss_zone[caster]) , s__Boss_ZONE_SIZE , s__Boss_ZONE_SIZE) then
				call sc__Actor__set_x(this,tx)
				call sc__Actor__set_y(this,ty)
