 endfunction

 function s__Boss_BossB000__rockexplosion_beforeExplosion takes integer this returns nothing
		call sc__Effect_setDuration(sc__Effect_create("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl" , s__Explosion_x[this] , s__Explosion_y[this] , 0. , 0.),1.0)
