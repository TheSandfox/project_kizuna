				call BlzFrameSetPoint((s__ExtraAbilityIcon_cooldown_backdrop2[this] ), ( FRAMEPOINT_TOPLEFT ), ( s__ExtraAbilityIcon_icon_backdrop[this] ), ( FRAMEPOINT_BOTTOMRIGHT ), (( - ExtraAbilityIcon___SIZE )*1.0) / 1800., (( ExtraAbilityIcon___SIZE * ( s__Ability_prototype_getUICooldown(s__ExtraAbilityIcon_target[this]) / s__Ability_prototype_getCalculatedMaxCooldown(s__ExtraAbilityIcon_target[this]) ))*1.0) / 1800.) // INLINED!!
			endif
			
