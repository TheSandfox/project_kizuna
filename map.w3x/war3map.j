  function s__Boss_countUnits takes integer this returns integer
			// local integer sum = 0
   local integer i= 0
   local unit u= null
   local integer uu= 0
			call GroupClear((s__Boss_enemies[this])) // INLINED!!
			call GroupEnumUnitsInRect(s__Boss_enemies[this], s__Boss_zone[this], null)
			call s__BossUI_clearVisibleFlag(s__Boss_ui[this])
			loop
				set u=BlzGroupUnitAt(s__Boss_enemies[this], i)
				exitwhen u == null
				set uu=s__Unit_prototype_get(u)
				if uu > 0 and ( not s__Unit_prototype_isUnitType(uu,UNIT_TYPE_DEAD) ) and (IsUnitEnemy(s__Unit_prototype_origin_unit[(uu)], ((GetOwningPlayer(s__Unit_prototype_origin_unit[(this)]))))) then // INLINED!!
					call s__BossUI_addVisibleFlag(s__Boss_ui[this],(GetOwningPlayer(s__Unit_prototype_origin_unit[(uu)]))) // INLINED!!
					// set sum = sum + 1
					set i=i + 1
				else
					call GroupRemoveUnit(s__Boss_enemies[this], u)
				endif
			endloop
			call s__BossUI_adjustVisibility(s__Boss_ui[this])
			set u=null
			return i
  endfunction

