  function s__Airbourne_create takes integer caster,real velo,real angle,real zvel,real duration returns integer
//textmacro instance: knockbackAllocate("caster","velo/duration","angle")
   local integer this= s__Airbourne__allocate(caster , velo / duration , angle)
			if this <= 0 then
				return 0
			endif
//end of: knockbackAllocate("caster","velo/duration","angle")
			if s__Movement_velo[this] < 0. then
				set s__Movement_velo[this]=0.
			endif
			set s__Movement_z_velo[this]=zvel + ( s__Movement_velo[this] * 0.3 )
			set s__Movement_gravity[this]=( s__Movement_z_velo[this] * 2 ) / duration
			set s__Actor_duration[this]=duration + TIMER_TICK
			return this
  endfunction




