  function s__Missile_onDestroy takes integer this returns nothing
			if s__Missile_group_link[this] > 0 then
				
				call s__MissileGroup_remove(s__Missile_group_link[this],this)
			else
				
				if s__Missile_group_wave[this] != null then
					
					call ReleaseGroup((s__Missile_group_wave[this])) // INLINED!!
				endif
				
				if s__Missile_group_already[this] != null then
					
					call ReleaseGroup((s__Missile_group_already[this])) // INLINED!!
				endif
			endif
			call ReleaseGroup((s__Missile_group_collision[this])) // INLINED!!
			set s__Missile_group_wave[this]=null
			set s__Missile_group_collision[this]=null
			set s__Missile_group_already[this]=null
			set s__Missile_group_link[this]=0
			
			set MISSILE_BUFF_DESTROY_BUFF=s__Missile_missile_buff[this]
			call TriggerEvaluate(MISSILE_BUFF_DESTROY)
			set MISSILE_BUFF_DESTROY_BUFF=0
			set s__Missile_missile_buff[this]=0
			call ReleaseTimer((s__Missile_main_timer[this])) // INLINED!!
			set s__Missile_main_timer[this]=null
  endfunction



//library Missile ends
//library MonsterCamp:





    
    function s__MonsterCamp_refreshRandomPosition takes integer this,real minAngle,real maxAngle returns nothing
      local real centerX= GetRectCenterX(s__MonsterCamp_camp_rect[this])
      local real centerY= GetRectCenterY(s__MonsterCamp_camp_rect[this])
      local real rMin= I2R(MonsterCamp__P_MONSTER_CAMP_RADIUS_MIN)
      local real rMax= I2R(MonsterCamp__P_MONSTER_CAMP_RADIUS_MAX)
      local real u= GetRandomReal(0., 1.)
      local real radius= SquareRoot(rMin * rMin + u * ( rMax * rMax - rMin * rMin ))
      local real angle= GetRandomReal(minAngle, maxAngle)
      set s__MonsterCamp_S_RANDOM_X=centerX + radius * Cos(angle)
      set s__MonsterCamp_S_RANDOM_Y=centerY + radius * Sin(angle)
    endfunction

    function s__MonsterCamp_getRandomX takes integer this returns real
      return s__MonsterCamp_S_RANDOM_X
    endfunction

    function s__MonsterCamp_getRandomY takes integer this returns real
      return s__MonsterCamp_S_RANDOM_Y
    endfunction

    
    function s__MonsterCamp_displayCounts takes integer this returns nothing
      // call BJDebugMsg("필드 위 개체수: "+I2S(.monster_list.size)+" / 예비 개체수: "+I2S(.monster_stack))
    endfunction

    
    function s__MonsterCamp_spawn takes integer this returns nothing
      local real rx= 0.
      local real ry= 0.
      local real sectorStep= ( 2. * bj_PI ) / I2R(MonsterCamp__P_SPAWN_SECTOR_DIVITION)
      local real minAngle= I2R(s__MonsterCamp_sector_current[this]) * sectorStep
      local real maxAngle= I2R(s__MonsterCamp_sector_current[this] + 1) * sectorStep
      local integer newMon= 0
      if (LoadInteger(Hash___D, (((s__MonsterCamp_monster_id_list[this]))), (s__Array_P_SIZE))) <= 0 then // INLINED!!
        call BJDebugMsg("몬스터 스폰 테이블 정보가 없습니다")
        return
      endif
      
      call s__MonsterCamp_refreshRandomPosition(this,minAngle , maxAngle)
      set rx=s__MonsterCamp_getRandomX(this)
      set ry=s__MonsterCamp_getRandomY(this)
      set s__MonsterCamp_sector_current[this]=s__MonsterCamp_sector_current[this] + 1
      if s__MonsterCamp_sector_current[this] >= MonsterCamp__P_SPAWN_SECTOR_DIVITION then
        set s__MonsterCamp_sector_current[this]=0
      endif
      
      call s__Array_shuffle(s__MonsterCamp_monster_id_list[this])
      
      set newMon=s__Monster_create(this , s__Array_getValue(s__MonsterCamp_monster_id_list[this],0) , rx , ry , s__Math_anglePoints(rx , ry , GetRectCenterX(s__MonsterCamp_camp_rect[this]) , GetRectCenterY(s__MonsterCamp_camp_rect[this])) + GetRandomReal(- 30.0, 30))
      set s__Monster_camp_rect[newMon]=s__MonsterCamp_camp_rect[this]
      
      call s__Array_add(s__MonsterCamp_monster_list[this],newMon)
      
      call s__Effect_kill(s__Effect_create(MonsterCamp__P_MONSTER_SPAWN_FX[s__MonsterCamp_biome_id[this]] , rx , ry , 0 , 270.0))
      // call BJDebugMsg("====스폰 작동")
      call s__MonsterCamp_displayCounts(this)
    endfunction
    
    function s__MonsterCamp_addStack takes integer this returns nothing
      set s__MonsterCamp_monster_stack[this]=s__MonsterCamp_monster_stack[this] + 1
      // call BJDebugMsg("====스택 추가")
      call s__MonsterCamp_displayCounts(this)
    endfunction

    
    function s__MonsterCamp_stopSpawnTimer takes integer this returns nothing
      // call BJDebugMsg("====꽉차서 타이머 정지")
      set s__MonsterCamp_spawn_timer_running[this]=false
      call PauseTimer((s__MonsterCamp_spawn_timer[this])) // INLINED!!
    endfunction

    function s__MonsterCamp_spawnTimerCallback takes nothing returns nothing
      local integer this= (sg__TimerUtils___DATA_get(GetHandleId(((GetExpiredTimer()))) * HASH_UP / HASH_DOWN + HASH_BIAS)) // INLINED!!
      if (LoadInteger(Hash___D, (((s__MonsterCamp_monster_list[this]))), (s__Array_P_SIZE))) < s__MonsterCamp_monster_count_max[this] then // INLINED!!
        call s__MonsterCamp_spawn(this)
      elseif s__MonsterCamp_monster_stack[this] < s__MonsterCamp_monster_stack_max[this] then
        call s__MonsterCamp_addStack(this)
      endif
      if (LoadInteger(Hash___D, (((s__MonsterCamp_monster_list[this]))), (s__Array_P_SIZE))) >= s__MonsterCamp_monster_count_max[this] and s__MonsterCamp_monster_stack[this] >= s__MonsterCamp_monster_stack_max[this] then // INLINED!!
        call s__MonsterCamp_stopSpawnTimer(this)
      endif
    endfunction

    
    function s__MonsterCamp_runSpawnTimer takes integer this returns nothing
      set s__MonsterCamp_spawn_timer_running[this]=true
      call TimerStart((s__MonsterCamp_spawn_timer[this] ), (( MonsterCamp__P_MONSTER_SPAWN_TIME )*1.0), ( true ), ( function s__MonsterCamp_spawnTimerCallback)) // INLINED!!
    endfunction

    function s__MonsterCamp_fastCreationCallback takes nothing returns nothing
      local timer timerHandle= GetExpiredTimer()
      local integer this= (sg__TimerUtils___DATA_get(GetHandleId(((timerHandle))) * HASH_UP / HASH_DOWN + HASH_BIAS)) // INLINED!!
      // call BJDebugMsg("빠른리젠 작동")
      call s__MonsterCamp_spawn(this)
      call ReleaseTimer((timerHandle)) // INLINED!!
      set timerHandle=null
    endfunction

    
    function s__MonsterCamp_runFastCreation takes integer this returns nothing
      
      local timer fTimer= s__Timer_new(this)
      set s__MonsterCamp_monster_stack[this]=s__MonsterCamp_monster_stack[this] - 1
      call TimerStart((fTimer ), (( MonsterCamp__P_MONSTER_SPAWN_TIME_FAST )*1.0), ( false ), ( function s__MonsterCamp_fastCreationCallback)) // INLINED!!
      set fTimer=null
    endfunction

    
    function s__MonsterCamp_monsterDeath takes integer this,integer target returns nothing
      // call BJDebugMsg("몬스터가주것슴다 -ㅁ-: "+target.name)
      call s__Array_removeFor(s__MonsterCamp_monster_list[this],target)
      if not s__MonsterCamp_spawn_timer_running[this] then
        call s__MonsterCamp_runSpawnTimer(this)
      endif
      if s__MonsterCamp_monster_stack[this] > 0 then
        call s__MonsterCamp_runFastCreation(this)
      endif
    endfunction

    function s__MonsterCamp_create takes integer biomeId,rect targetRect returns integer
      local integer this= s__MonsterCamp__allocate()
      local integer i= 0
      
      set s__MonsterCamp_biome_id[this]=biomeId
      
      set s__MonsterCamp_spawn_timer[this]=s__Timer_new(this)
      
      set s__MonsterCamp_monster_id_list[this]=s__Array_create()
      loop
        
        exitwhen not HaveSavedInteger(MonsterCamp__P_MONSTER_SPAWN_TABLE, biomeId, i)
        call s__Array_add(s__MonsterCamp_monster_id_list[this],LoadInteger(MonsterCamp__P_MONSTER_SPAWN_TABLE, biomeId, i))
        set i=i + 1
      endloop
      
      set s__MonsterCamp_monster_list[this]=s__Array_create()
      
      set s__MonsterCamp_camp_rect[this]=targetRect
      
      call s__MonsterCamp_runSpawnTimer(this)
      return this
    endfunction

    function s__MonsterCamp_onDestroy takes integer this returns nothing
      
      call ReleaseTimer((s__MonsterCamp_spawn_timer[this])) // INLINED!!
      
      call s__Hash_deallocate(((s__MonsterCamp_monster_id_list[this]))) // INLINED!!
      call s__Hash_deallocate(((s__MonsterCamp_monster_list[this]))) // INLINED!!
      
      set s__MonsterCamp_camp_rect[this]=null
    endfunction

//Generated destructor of MonsterCamp
function s__MonsterCamp_deallocate takes integer this returns nothing
    if this==null then
        return
    elseif (si__MonsterCamp_V[this]!=-1) then
        return
    endif
    call s__MonsterCamp_onDestroy(this)
    set si__MonsterCamp_V[this]=si__MonsterCamp_F
    set si__MonsterCamp_F=this
endfunction

    function s__MonsterCamp_deathCallback takes nothing returns nothing
      local integer targetUnit= EVT_DEATH_UNIT
      local integer this= 0
      if s__UnitClass_getClass((targetUnit),ENUM_UNIT_CLASS_MONSTER) <= 0 then
        return
      endif
      set this=(s__Monster_camp_id[targetUnit])
      call s__MonsterCamp_monsterDeath(this,targetUnit)
    endfunction

    function s__MonsterCamp_init takes nothing returns nothing
      local trigger t= CreateTrigger()
      call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_DEATH)*1.0)) // INLINED!!
      call TriggerAddCondition(t, Condition(function s__MonsterCamp_deathCallback))
      set t=null
    endfunction


  
