   function s__Ability20k0_main_setState takes integer this,boolean flag returns nothing
				set s__Ability20k0_main_state[this]=flag
				if flag then
					
					set s__Ability_prototype_manacost[this]=20
					set s__Ability_prototype_icon[this]=s__Ability_getTypeIconPath(s__Ability_prototype_id[this])
				else
					
					set s__Ability_prototype_manacost[this]=0
					set s__Ability_prototype_icon[this]="ReplaceableTextures\\CommandButtons\\BTNCancel.blp"
				endif
				set CUSTOM_RESPOND_UI_REFRESH_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])])) // INLINED!!
				set CUSTOM_RESPOND_UI_REFRESH_SLOT=- 1
				set CUSTOM_RESPOND_UI_REFRESH_ABILITY=this
				call s__Event_activate(CONFIG_EVENT_ABILITY_UI_REFRESH)
				set CUSTOM_RESPOND_UI_REFRESH_ABILITY=0
   endfunction

   function s__Ability20k0_main_execute takes integer this returns nothing
				if s__Ability20k0_main_state[this] then
					
					call s__Buff_add(s__Ability_prototype_owner[this] , s__Ability_prototype_owner[this] , Ability20k0__ID , s__Ability_prototype_level[this] , 0.)
				else
					
					if s__Ability20k0_main_bf[this] > 0 then
						call sc__Buff_deallocate(s__Ability20k0_main_bf[this])
					else
						call s__Ability20k0_main_setState(this,true)
					endif
				endif
   endfunction

