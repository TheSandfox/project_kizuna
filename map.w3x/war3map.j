			   set si__Trigger_prototype_F=si__Trigger_prototype_V[this]
		   else
			   set si__Trigger_prototype_I=si__Trigger_prototype_I + 1
			   set this=si__Trigger_prototype_I
		   endif
		   set si__Trigger_prototype_type[this]=0
		   set si__Trigger_prototype_V[this]=- 1
		return this
	endfunction
//end of: demonicAllocate("Trigger_prototype")

	
