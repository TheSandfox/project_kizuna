//library TreeOfLife:
	



  function s__TreeOfLife__get_X takes nothing returns real
			return GetRectCenterX(gg_rct_TreeOfLife)
  endfunction

  function s__TreeOfLife__get_Y takes nothing returns real
			return GetRectCenterY(gg_rct_TreeOfLife)
  endfunction

  function s__TreeOfLife_refreshFrame takes nothing returns nothing
   local real v= (s__Unit_prototype_hp_true[(s__TreeOfLife_UNIT)]) / (s__Unit_prototype_maxhp_true[(s__TreeOfLife_UNIT)]) // INLINED!!
			call BlzFrameSetVisible(s__TreeOfLife_DEATH_OVERLAY, (s__Unit_prototype_hp_true[(s__TreeOfLife_UNIT)]) <= 0.) // INLINED!!
			call BlzFrameSetVisible(s__TreeOfLife_GAUGE_FILL, v > 0.025)
			call BlzFrameSetSize((s__TreeOfLife_GAUGE_FILL ), (( ( s__TreeOfLife_WIDTH - s__TreeOfLife_ICON_SIZE - s__TreeOfLife_INSET * 2 ) * v )*1.0) / 1800., (( s__TreeOfLife_HEIGHT)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetText(s__TreeOfLife_HP_TEXT, I2S(R2I((s__Unit_prototype_hp_true[(s__TreeOfLife_UNIT)]))) + " / " + I2S(R2I((s__Unit_prototype_maxhp_true[(s__TreeOfLife_UNIT)])))) // INLINED!!
  endfunction

  function s__TreeOfLife__set_HP takes real nv returns nothing
			call sc__Unit_prototype__set_hp(s__TreeOfLife_UNIT,nv)
			call s__TreeOfLife_refreshFrame()
  endfunction

  function s__TreeOfLife__get_HP takes nothing returns real
			return (s__Unit_prototype_hp_true[(s__TreeOfLife_UNIT)]) // INLINED!!
  endfunction

  function s__TreeOfLife__get_MAXHP takes nothing returns real
			return (s__Unit_prototype_maxhp_true[(s__TreeOfLife_UNIT)]) // INLINED!!
  endfunction

  function s__TreeOfLife_addLevel takes nothing returns nothing
			call sc__Unit_prototype__set_level(s__TreeOfLife_UNIT,(s__Unit_prototype_level_true[(s__TreeOfLife_UNIT)]) + 1) // INLINED!!
  endfunction

  function s__TreeOfLife_timerAction takes nothing returns nothing
   local integer i= GetRandomInt(0, 2)
   local unit u= null
   local integer ud= 0
   local real r= 0.
   local integer ef= 0
   local string s
			set i=0
			loop
				set u=BlzGroupUnitAt(Undead_GROUP, i)
				//exitwhen i >= BlzGroupGetSize(Undead_GROUP)
				exitwhen u == null
				set ud=sc__Unit_prototype_get(u)
				if (IsUnitInRangeXY(s__Unit_prototype_origin_unit[(ud)], (((GetRectCenterX(gg_rct_TreeOfLife)) )*1.0), (( (GetRectCenterY(gg_rct_TreeOfLife)) )*1.0), (( s__TreeOfLife_RANGE)*1.0))) and not sc__Unit_prototype_isUnitType(ud,UNIT_TYPE_DEAD) then // INLINED!!
					set r=s__Damage_damageTarget(ud , (s__Unit_prototype_maxhp_true[(ud)]) * 0.1) // INLINED!!
					call s__TreeOfLife__set_HP((s__Unit_prototype_hp_true[(s__TreeOfLife_UNIT)]) - r) // INLINED!!
					call sc__Effect_kill(sc__Effect_setScale(sc__Effect_create(s__TreeOfLife_EFFECT_PATH2 , sc__Object__get_x(ud) , sc__Object__get_y(ud) , 0. , 270.),0.75))
				endif
				set i=i + 1
				set u=null
			endloop
			call s__TreeOfLife_refreshFrame()
			if sc__Unit_prototype_isUnitType(s__TreeOfLife_UNIT,UNIT_TYPE_DEAD) then
				call TriggerEvaluate(st__TreeOfLife_end) // INLINED!!
			endif
			set u=null
  endfunction

  function s__TreeOfLife_cond takes nothing returns nothing
			if GetTriggerPlayer() == GetLocalPlayer() then
				call BlzFrameSetEnable(s__TreeOfLife_BUTTON, false)
				call BlzFrameSetEnable(s__TreeOfLife_BUTTON, true)
				if BlzGetTriggerFrameEvent() == FRAMEEVENT_MOUSE_ENTER then
					set s__TreeOfLife_IN=true
				elseif BlzGetTriggerFrameEvent() == FRAMEEVENT_MOUSE_LEAVE then
					set s__TreeOfLife_IN=false
				elseif BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_LEFT then
					if s__TreeOfLife_IN then
						call PanCameraToTimed((GetRectCenterX(gg_rct_TreeOfLife)), (GetRectCenterY(gg_rct_TreeOfLife)), 0.) // INLINED!!
					endif
				endif
			endif
  endfunction

  function s__TreeOfLife_init takes nothing returns nothing
   local integer i= 0
			set s__TreeOfLife_MAIN_TRIGGER=sc__Trigger_new(0)
			set s__TreeOfLife_MAIN_COND=TriggerAddCondition(s__TreeOfLife_MAIN_TRIGGER, Condition(function s__TreeOfLife_cond))
			set s__TreeOfLife_UNIT=sc__Unit_create(CONFIG_PLAYER_GUARDIANS , 'G001' , (GetRectCenterX(gg_rct_TreeOfLife)) , (GetRectCenterY(gg_rct_TreeOfLife)) , 270.) // INLINED!!
			//나무 능력치
			call sc__UnitPrototype__StatData_setStatValue(s__Unit_prototype_stat_data[s__TreeOfLife_UNIT],CONFIG_STAT_MAXHP , CONFIG_STAT_INDEX_BASE , 10000.0)
			call sc__UnitPrototype__StatData_setStatValue(s__Unit_prototype_stat_data[s__TreeOfLife_UNIT],CONFIG_STAT_MAXHP , CONFIG_STAT_INDEX_LEVEL , 1000.0)
			call sc__Unit_prototype_refreshStatValue(s__TreeOfLife_UNIT,CONFIG_STAT_MAXHP)
			call sc__UnitPrototype__StatData_setStatValue(s__Unit_prototype_stat_data[s__TreeOfLife_UNIT],CONFIG_STAT_HPREGEN , CONFIG_STAT_INDEX_BASE , 40.0)
			call sc__UnitPrototype__StatData_setStatValue(s__Unit_prototype_stat_data[s__TreeOfLife_UNIT],CONFIG_STAT_HPREGEN , CONFIG_STAT_INDEX_LEVEL , 4.0)
			//
			call sc__Unit_prototype_setAnim(s__TreeOfLife_UNIT,"stand alternate upgrade first second")
			call sc__Unit_prototype_plusStatus(s__TreeOfLife_UNIT,CONFIG_STATUS_CAST)
			call sc__Unit_prototype_plusStatus(s__TreeOfLife_UNIT,CONFIG_STATUS_INVINCIBLE)
			call sc__Effect_setScale(s__Unit_prototype_facing_circle[s__TreeOfLife_UNIT],128. / 100.)
			call sc__Object__set_x(s__TreeOfLife_UNIT,(GetRectCenterX(gg_rct_TreeOfLife))) // INLINED!!
			call sc__Object__set_y(s__TreeOfLife_UNIT,(GetRectCenterY(gg_rct_TreeOfLife))) // INLINED!!
			set s__TreeOfLife_MAIN_TIMER=sc__Timer_new(0)
			call TimerStart((s__TreeOfLife_MAIN_TIMER ), (( s__TreeOfLife_TICK )*1.0), ( true ), ( function s__TreeOfLife_timerAction)) // INLINED!!
			
			set s__TreeOfLife_BACKDROP=BlzCreateFrameByType("BACKDROP", "", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_BASIC], "", 0)
			call BlzFrameSetPoint((s__TreeOfLife_BACKDROP ), ( FRAMEPOINT_BOTTOMLEFT ), ( FRAME_PORTRAIT_BACKDROP ), ( FRAMEPOINT_TOPLEFT ), (( 0 )*1.0) / 1800., (( 0)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((s__TreeOfLife_BACKDROP ), (( s__TreeOfLife_WIDTH )*1.0) / 1800., (( s__TreeOfLife_ICON_SIZE + s__TreeOfLife_INSET * 2)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetTexture(s__TreeOfLife_BACKDROP, "Textures\\black32.blp", 0, true)
			call BlzFrameSetAlpha(s__TreeOfLife_BACKDROP, 64)
			set s__TreeOfLife_ICON=BlzCreateFrameByType("BACKDROP", "", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_BASIC], "", 0)
			call BlzFrameSetPoint((s__TreeOfLife_ICON ), ( FRAMEPOINT_TOPLEFT ), ( s__TreeOfLife_BACKDROP ), ( FRAMEPOINT_TOPLEFT ), (( s__TreeOfLife_INSET )*1.0) / 1800., (( - s__TreeOfLife_INSET)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((s__TreeOfLife_ICON ), (( s__TreeOfLife_ICON_SIZE )*1.0) / 1800., (( s__TreeOfLife_ICON_SIZE)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetTexture(s__TreeOfLife_ICON, "ReplaceableTextures\\CommandButtons\\BTNTreeOfLife.blp", 0, true)
			set s__TreeOfLife_DEATH_OVERLAY=BlzCreateFrameByType("BACKDROP", "", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_BASIC], "", 0)
			call BlzFrameSetAllPoints(s__TreeOfLife_DEATH_OVERLAY, s__TreeOfLife_ICON)
			call BlzFrameSetTexture(s__TreeOfLife_DEATH_OVERLAY, "ReplaceableTextures\\teamcolor\\teamcolor00.blp", 0, true)
			call BlzFrameSetAlpha(s__TreeOfLife_DEATH_OVERLAY, 128)
			call BlzFrameSetVisible(s__TreeOfLife_DEATH_OVERLAY, false)
			set s__TreeOfLife_BUTTON=BlzCreateFrameByType("BUTTON", "", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_BASIC], "", 0)
			call BlzFrameSetAllPoints(s__TreeOfLife_BUTTON, s__TreeOfLife_ICON)
			call BlzTriggerRegisterFrameEvent(s__TreeOfLife_MAIN_TRIGGER, s__TreeOfLife_BUTTON, FRAMEEVENT_MOUSE_LEAVE)
			call BlzTriggerRegisterFrameEvent(s__TreeOfLife_MAIN_TRIGGER, s__TreeOfLife_BUTTON, FRAMEEVENT_MOUSE_ENTER)
			loop
				exitwhen i >= CONFIG_PLAYER_MAX
				call TriggerRegisterPlayerEvent(s__TreeOfLife_MAIN_TRIGGER, Player(i), EVENT_PLAYER_MOUSE_DOWN)
				set i=i + 1
			endloop
			set s__TreeOfLife_GAUGE_BACKDROP=BlzCreateFrameByType("BACKDROP", "", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_BASIC], "", 0)
			call BlzFrameSetPoint(s__TreeOfLife_GAUGE_BACKDROP, FRAMEPOINT_BOTTOMLEFT, s__TreeOfLife_ICON, FRAMEPOINT_BOTTOMRIGHT, 0., 0.)
			call BlzFrameSetSize((s__TreeOfLife_GAUGE_BACKDROP ), (( s__TreeOfLife_WIDTH - s__TreeOfLife_ICON_SIZE - s__TreeOfLife_INSET * 2 )*1.0) / 1800., (( s__TreeOfLife_HEIGHT)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetTexture(s__TreeOfLife_GAUGE_BACKDROP, "ReplaceableTextures\\teamcolor\\teamcolor00.blp", 0, true)
			call BlzFrameSetAlpha(s__TreeOfLife_GAUGE_BACKDROP, 128)
			set s__TreeOfLife_GAUGE_FILL=BlzCreateFrameByType("BACKDROP", "", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_BASIC], "", 0)
			call BlzFrameSetPoint(s__TreeOfLife_GAUGE_FILL, FRAMEPOINT_BOTTOMLEFT, s__TreeOfLife_GAUGE_BACKDROP, FRAMEPOINT_BOTTOMLEFT, 0., 0.)
			call BlzFrameSetTexture(s__TreeOfLife_GAUGE_FILL, "ReplaceableTextures\\teamcolor\\teamcolor06.blp", 0, true)
			call BlzFrameSetVisible(s__TreeOfLife_GAUGE_FILL, false)
			set s__TreeOfLife_HP_TEXT=BlzCreateFrame("MyText", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_BASIC], 0, 0)
			call BlzFrameSetPoint(s__TreeOfLife_HP_TEXT, FRAMEPOINT_CENTER, s__TreeOfLife_GAUGE_BACKDROP, FRAMEPOINT_CENTER, 0., 0.)
			call s__TreeOfLife_refreshFrame()
			set s__TreeOfLife_NAME=BlzCreateFrame("MyText", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_BASIC], 0, 0)
			call BlzFrameSetPoint((s__TreeOfLife_NAME ), ( FRAMEPOINT_CENTER ), ( s__TreeOfLife_BACKDROP ), ( FRAMEPOINT_CENTER ), (( s__TreeOfLife_ICON_SIZE / 2 )*1.0) / 1800., (( 8)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetTextAlignment(s__TreeOfLife_NAME, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_MIDDLE)
			call BlzFrameSetText(s__TreeOfLife_NAME, "생명의 나무")
  endfunction

  function s__TreeOfLife_end takes nothing returns nothing
			call PauseTimer((s__TreeOfLife_MAIN_TIMER)) // INLINED!!
			call TriggerEvaluate(st__Game_defeat) // INLINED!!
  endfunction



