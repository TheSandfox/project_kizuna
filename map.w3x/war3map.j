			call BlzFrameSetPoint((FRAME_STAT_INDICATOR_BUTTON ), ( FRAMEPOINT_BOTTOMLEFT ), ( FRAME_INVENTORY_BUTTON ), ( FRAMEPOINT_BOTTOMRIGHT ), (( 0 )*1.0) / 1800., (( 0)*1.0) / 1800.) // INLINED!!
