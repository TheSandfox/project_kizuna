				endif
			else
				//커브없음
				if s__UnitMovement_target_distance_flag_3d[this] then
					
					set d=s__Math_distancePoints3D(sc__Actor__get_x(this) , sc__Actor__get_y(this) , sc__Movement__get_z(this) , sc__Object__get_x(sc__Movement__get_target(this)) + s__Object_pivot_x[sc__Movement__get_target(this)] , sc__Object__get_y(sc__Movement__get_target(this)) + s__Object_pivot_y[sc__Movement__get_target(this)] , sc__Object__get_z(sc__Movement__get_target(this)) + s__Object_pivot_z[sc__Movement__get_target(this)])
				else
					
					set d=s__Math_distancePoints(sc__Actor__get_x(this) , sc__Actor__get_y(this) , sc__Object__get_x(sc__Movement__get_target(this)) , sc__Object__get_y(sc__Movement__get_target(this)))
				endif
				if d <= s__Movement_velo[this] * TIMER_TICK or d <= s__UnitMovement_radius_target[this] then
					if s__UnitMovement_targetFilter(this,sc__Movement__get_target(this)) then
						call sc__UnitMovement_executeTarget(this,sc__Movement__get_target(this))
						call GroupAddUnit(s__UnitMovement_group_already[this], s__Unit_prototype_origin_unit[(sc__Movement__get_target(this))])
					endif
					return true
				endif
			endif
			return false
  endfunction

