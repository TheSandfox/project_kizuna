//library ShieldBuff:

	



		
  function s__ShieldBuff_activateShieldEvent takes integer this,real v returns real
   local real new_value= 0.
			
			set CUSTOM_RESPOND_SHIELD_CASTER=s__Buff_caster[(this)]
			set CUSTOM_RESPOND_SHIELD_TARGET=s__Buff_target[(this)]
			set CUSTOM_RESPOND_SHIELD_AMOUNT=v
			set CUSTOM_RESPOND_SHIELD_SIGN=s__Math_sign(v)
			set CUSTOM_RESPOND_SHIELD_PLUS=0.
			set CUSTOM_RESPOND_SHIELD_MULTIPLY=1.0
			set CUSTOM_RESPOND_SHIELD_DIVIDE=1.0
			set CUSTOM_RESPOND_SHIELD_MINUS=0.
			call s__Event_activate(CONFIG_EVENT_SHIELD_MODIFY_STAT)
			call s__Event_activate(CONFIG_EVENT_SHIELD_MODIFY)
			
			set CUSTOM_RESPOND_SHIELD_AMOUNT=( ( ( CUSTOM_RESPOND_SHIELD_AMOUNT + CUSTOM_RESPOND_SHIELD_PLUS ) * CUSTOM_RESPOND_SHIELD_MULTIPLY ) / CUSTOM_RESPOND_SHIELD_DIVIDE ) - CUSTOM_RESPOND_SHIELD_MINUS
			
			call s__Event_activate(CONFIG_EVENT_SHIELD_LAST)
			set new_value=CUSTOM_RESPOND_SHIELD_AMOUNT
			return new_value
  endfunction

		
  function s__ShieldBuff_restore takes integer this,real v returns nothing
   local real val= s__ShieldBuff_activateShieldEvent(this,v)
			if s__ShieldBuff_value[this] + val > s__ShieldBuff_max[this] then
				
				call sc__Shield_addAmount((s__Buff_target[(this)]),s__ShieldBuff_max[this] - s__ShieldBuff_value[this])
				set s__ShieldBuff_value[this]=s__ShieldBuff_max[this]
			elseif s__ShieldBuff_value[this] + val < 0. then
				
				call sc__Shield_addAmount((s__Buff_target[(this)]),- s__ShieldBuff_value[this])
				set s__ShieldBuff_value[this]=0.
			else
				
				call sc__Shield_addAmount((s__Buff_target[(this)]),val)
				set s__ShieldBuff_value[this]=s__ShieldBuff_value[this] + val
			endif
  endfunction

		
  function s__ShieldBuff_add takes integer this,real v returns nothing
   local real val= s__ShieldBuff_activateShieldEvent(this,v)
			set s__ShieldBuff_value[this]=s__ShieldBuff_value[this] + val
			set s__ShieldBuff_max[this]=s__ShieldBuff_max[this] + val
			call sc__Shield_addAmount((s__Buff_target[(this)]),val)
			call sc__Shield_addMax((s__Buff_target[(this)]),val)
  endfunction

		
  function s__ShieldBuff_refill takes integer this,real v returns nothing
			if v <= 0. then
				return
			endif
			if v > s__ShieldBuff_max[this] then
				
				
				call sc__Shield_addMax((s__Buff_target[(this)]),v - s__ShieldBuff_max[this])
				set s__ShieldBuff_max[this]=v
				
				call s__ShieldBuff_restore(this,v)
			else
				
				call s__ShieldBuff_restore(this,v)
			endif
  endfunction

		
  function s__ShieldBuff_register takes integer this,real v returns nothing
			if not s__ShieldBuff_exists[this] then
				call sc__Shield_add((s__Buff_target[(this)]),this)
				set s__ShieldBuff_exists[this]=true
				set s__ShieldBuff_value[this]=0.
				set s__ShieldBuff_max[this]=0.
				
				call s__ShieldBuff_add(this,v)



			endif
  endfunction

		
  function s__ShieldBuff_unregister takes integer this returns nothing
			if s__ShieldBuff_exists[this] then
				set s__ShieldBuff_exists[this]=false
				call sc__Shield_addAmount((s__Buff_target[(this)]),- s__ShieldBuff_value[this])
				call sc__Shield_addMax((s__Buff_target[(this)]),- s__ShieldBuff_max[this])
				set s__ShieldBuff_value[this]=0.
				set s__ShieldBuff_max[this]=0.
				call sc__Shield_removeFor((s__Buff_target[(this)]),this)



			endif
  endfunction

		
  function s__ShieldBuff_break takes integer this returns boolean
			if s__Buff_permanent[(this)] then
				
				call sc__Shield_addAmount((s__Buff_target[(this)]),- s__ShieldBuff_value[this])
				set s__ShieldBuff_value[this]=0.
				return false
			else
				call DisableTrigger(s__ShieldBuff_DESTROY_BUFF_TRIGGER)
				call s__ShieldBuff_unregister(this)
				call sc__Buff_deallocate((this))
				call EnableTrigger(s__ShieldBuff_DESTROY_BUFF_TRIGGER)
				return true
			endif
  endfunction

  function s__ShieldBuff_destroyRespond takes nothing returns nothing
   local integer this= CUSTOM_RESPOND_BUFF_DESTROY_BUFF
			if not s__ShieldBuff_exists[this] then
				return
			endif
			call s__ShieldBuff_unregister(this)
  endfunction

  function s__ShieldBuff_onInit takes nothing returns nothing
			set s__ShieldBuff_DESTROY_BUFF_TRIGGER=CreateTrigger()
			call TriggerRegisterVariableEvent((s__ShieldBuff_DESTROY_BUFF_TRIGGER ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_BUFF_DESTROY)*1.0)) // INLINED!!
			call TriggerAddCondition(s__ShieldBuff_DESTROY_BUFF_TRIGGER, Condition(function s__ShieldBuff_destroyRespond))
  endfunction



//library ShieldBuff ends
//library ShieldDamage:


  function s__ShieldDamage_breakAll takes integer this returns nothing
   local integer bf= 0
   local integer i= 0
   local boolean result= false
			loop
				set bf=sc__Shield_getBuff((this),i)
				exitwhen bf <= 0
				set result=s__ShieldBuff_break((bf))
				if result then
					
					
				else
					
					set i=i + 1
				endif
			endloop
			set s__Shield_shield_amount[(this)]=0.
			
  endfunction

  function s__ShieldDamage_break takes integer this,real damage returns nothing
   local integer i= 0
   local integer bf= 0
   local real temp_amount= s__Shield_shield_amount[(this)]
			loop
				set bf=sc__Shield_getBuff((this),i)
				exitwhen bf <= 0
				call s__ShieldBuff_restore((bf),- CUSTOM_RESPOND_DAMAGE_AMOUNT * ( s__ShieldBuff_value[(bf)] / temp_amount ))
				set i=i + 1
			endloop
  endfunction

  function s__ShieldDamage_adjust takes integer this returns nothing
			
			
			if sc__Shield__get_count((this)) <= 0 then
				return
			endif
			if s__Shield_shield_amount[(this)] <= 0. then
				
				set CUSTOM_RESPOND_DAMAGE_ABSORBED=0.
				call s__ShieldDamage_breakAll(this)
			elseif CUSTOM_RESPOND_DAMAGE_AMOUNT < s__Shield_shield_amount[(this)] then
				
				call s__ShieldDamage_break(this,CUSTOM_RESPOND_DAMAGE_AMOUNT)
				
				set CUSTOM_RESPOND_DAMAGE_ABSORBED=CUSTOM_RESPOND_DAMAGE_AMOUNT
				set CUSTOM_RESPOND_DAMAGE_AMOUNT=0.
			else
				
				
				set CUSTOM_RESPOND_DAMAGE_ABSORBED=s__Shield_shield_amount[(this)]
				set CUSTOM_RESPOND_DAMAGE_AMOUNT=CUSTOM_RESPOND_DAMAGE_AMOUNT - s__Shield_shield_amount[(this)]
				call s__ShieldDamage_breakAll(this)
			endif
  endfunction



