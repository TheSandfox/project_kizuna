  function s__Inventory__get_owner takes integer this returns player
			return Player(this)
  endfunction

  function s__Inventory_disableDrop takes integer this returns nothing
			set s__Inventory_prototype_DISABLE_DROP[this]=s__Inventory_prototype_DISABLE_DROP[this] + 1
  endfunction

  function s__Inventory_enableDrop takes integer this returns nothing
			set s__Inventory_prototype_DISABLE_DROP[this]=s__Inventory_prototype_DISABLE_DROP[this] - 1
  endfunction

		

  function s__Inventory_getItem takes integer this,integer category,integer index returns integer
			return s__Array_getValue(s__Inventory___ItemList_list[(s__Array_getValue(s__Inventory___Inventories_list[s__Inventory_inventories[this]],category))],index)
			
  endfunction

  function s__Inventory_spaceExists takes integer this,integer category returns boolean
			return (LoadInteger(Hash___D, (((s__Inventory___ItemList_list[(s__Array_getValue(s__Inventory___Inventories_list[s__Inventory_inventories[this]],category))]))), (s__Array_P_SIZE))) < Inventory_SLOT // INLINED!!
			
  endfunction

  function s__Inventory_getItemIndexById takes integer this,integer iid returns integer
   local integer cat= 0
   local integer i= 0
   local integer it= 0
			loop
				exitwhen i >= Inventory_SLOT
				set it=s__Inventory_getItem(this,cat , i)
				if it > 0 then
					if s__Item_prototype_id[it] == iid then
						return i
					endif
				endif
				set i=i + 1
			endloop
			return - 1
  endfunction

  function s__Inventory_closeDialog takes integer this returns nothing
			set s__Inventory_dialog_category[this]=- 1
			set s__Inventory_dialog_index[this]=- 1
			call BlzFrameSetVisible(s__Inventory_dialog_backdrop[this], false)
			call BlzFrameSetVisible(s__Inventory_mouseover_above[this], false)
			if s__Inventory_dialog_visible[this] then
				
				call s__Array_eraseFor(s__CloseUI_list[(this)],s__CloseUI_ORDER_INVENTORY_DIALOG)
			endif
			set s__Inventory_dialog_visible[this]=false
  endfunction

  function s__Inventory_useRequest takes integer this,integer category,integer index,integer buttontype returns nothing
			set INVENTORY_ITEM_USE_PLAYER=(Player((this))) // INLINED!!
			set s__AbilityShard_USER=(Player((this))) // INLINED!!
			if buttontype == 0 then
				call sc__Item_onLeftClick(s__Inventory_getItem(this,category , index))
			else
				call sc__Item_onRightClick(s__Inventory_getItem(this,category , index))
			endif
  endfunction

  function s__Inventory_dialogConfirm takes integer this returns nothing
			if s__Inventory_dialog_category[this] < 0 or s__Inventory_dialog_index[this] < 0 then
				return
			endif
			call s__Inventory_useRequest(this,s__Inventory_dialog_category[this] , s__Inventory_dialog_index[this] , 0)
  endfunction

  function s__Inventory_showDialog takes integer this,integer category,integer index returns nothing
			set s__Inventory_dialog_category[this]=category
			set s__Inventory_dialog_index[this]=index
			call s__InventoryIcon_hideTooltip(sc__Inventory_getIcon(this,index))
			call BlzFrameSetText(s__Inventory_dialog_text[this], sc__Item_getDialogText(s__Inventory_getItem(this,s__Inventory_dialog_category[this] , s__Inventory_dialog_index[this])))
			call BlzFrameSetVisible(s__Inventory_dialog_backdrop[this], GetLocalPlayer() == Player(this))
			call BlzFrameSetVisible(s__Inventory_mouseover_above[this], GetLocalPlayer() == Player(this))
			if not s__Inventory_dialog_visible[this] then
				
				call s__Array_add(s__CloseUI_list[(this)],s__CloseUI_ORDER_INVENTORY_DIALOG)
			endif
			set s__Inventory_dialog_visible[this]=true
  endfunction

		
  function s__Inventory_refreshIcons takes integer this,integer category,integer from returns nothing
   local integer i= from
   local integer it= - 1
			if s__Inventory_category[this] != category then
				return
			endif
			loop
				set it=s__Inventory_getItem(this,category , i)
				exitwhen i >= Inventory_SLOT
				call s__InventoryIcon_setTarget(sc__Inventory_getIcon(this,i),it)
				set i=i + 1
			endloop
  endfunction

  function s__Inventory_pull takes integer this,integer category,integer index returns nothing
			call s__Array_remove(s__Inventory___ItemList_list[(s__Array_getValue(s__Inventory___Inventories_list[s__Inventory_inventories[this]],category))],index)
			call s__Inventory_refreshIcons(this,category , index)
  endfunction

  function s__Inventory_refresh takes integer this returns nothing
			call s__Inventory_refreshIcons(this,s__Inventory_category[this] , 0)
  endfunction

  function s__Inventory_drop takes integer this,integer index returns nothing
   local integer it= s__Inventory_getItem(this,s__Inventory_category[this] , index)
			if it > 0 then
				call s__Item_prototype_drop(it,sc__Object__get_x((s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))])) , sc__Object__get_y((s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))]))) // INLINED!!
				//call setItem(.category,index,0)
				call s__Inventory_pull(this,s__Inventory_category[this] , index)
			else
			endif
  endfunction

  function s__Inventory_addItem takes integer this,integer it returns boolean
   local integer i= 0
   local integer iidx= 0
   local integer category= 0
			
			// if Item.getTypeStackable(it.id) and INVENTORY_ITEM_MERGE then
			// 	set iidx = getItemIndexById(it.id)
			// 	if iidx > -1 then
			// 		call it.merge(getItem(category,iidx))
			// 		if category == .category then
			// 			call getIcon(iidx).setTarget(getItem(category,iidx))
			// 		endif
			// 		call refreshIcons(category,0)
			// 		return true
			// 	endif
			// endif
			if ((LoadInteger(Hash___D, (((s__Inventory___ItemList_list[(s__Array_getValue(s__Inventory___Inventories_list[s__Inventory_inventories[(this)]],(category)))]))), (s__Array_P_SIZE))) < Inventory_SLOT) then // INLINED!!
				call s__Inventory___ItemList_add((s__Array_getValue(s__Inventory___Inventories_list[s__Inventory_inventories[this]],category)),it)
				call s__Inventory_refreshIcons(this,category , 0)
				return true
			else
				call s__Item_prototype_drop(it,sc__Object__get_x((s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))])) , sc__Object__get_y((s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))]))) // INLINED!!
				call s__Inventory_refreshIcons(this,category , 0)
				return false
			endif
			return false
  endfunction

  function s__Inventory_divide takes integer this,integer it,integer count returns boolean
   local integer nit= 0
   local integer cat= 0
   local integer tidx= - 1
			if it <= 0 then
				return true
			endif
			if s__Item_prototype_count[it] <= 1 then
				return true
			endif
			set cat=0 // Item.getTypeItemType(it.id)
			set tidx=s__Inventory_getItemIndexById(this,s__Item_prototype_id[it])
			if tidx > - 1 then
				set nit=s__Item_divide(it,count)
				if nit > 0 then
					set Inventory___INVENTORY_ITEM_MERGE=false
					call s__Inventory_addItem(this,nit)
					set Inventory___INVENTORY_ITEM_MERGE=true
					call s__Inventory_refreshIcons(this,cat , 0)
					return true
				else
					return false
				endif
			endif
			return true
  endfunction

  function s__Inventory_changeCategory takes integer this,integer category returns nothing
   local integer i= 0
			if s__Inventory_dialog_visible[this] then
				return
			endif
			if category != s__Inventory_category[this] then
				loop
					exitwhen i >= 1
					if GetLocalPlayer() == Player(this) then
						call BlzFrameSetVisible(FRAME_INVENTORY_CATEGORY_HIGHTLIGHT[i], i == category)
					endif
					set i=i + 1
				endloop
				set i=0
				loop
					exitwhen i >= Inventory_SLOT
					call s__InventoryIcon_setTarget(sc__Inventory_getIcon(this,i),s__Inventory_getItem(this,category , i))
					set i=i + 1
				endloop
			endif
			set s__Inventory_category[this]=category
  endfunction

  function s__Inventory_getIcon takes integer this,integer index returns integer
			return (this * Inventory_SLOT + index)
  endfunction

		
			
		

  function s__Inventory_consumeRespond takes nothing returns nothing
   local integer this= 0
   local integer cat= 0
   local integer index= 0
			if CUSTOM_RESPOND_ITEM_DESTROY_ADDRESS1 != s__ItemAddress_INVENTORY then
				return
			endif
			set this=CUSTOM_RESPOND_ITEM_DESTROY_ADDRESS2
			set cat=0 //Item.getTypeItemType(Item(CUSTOM_RESPOND_ITEM_DESTROY_ITEM).id)
			set index=(s__Array_seekFrom((s__Inventory___ItemList_list[(s__Array_getValue(s__Inventory___Inventories_list[s__Inventory_inventories[this]],cat))]),(CUSTOM_RESPOND_ITEM_DESTROY_ITEM) , 0)) // INLINED!!
			if index > - 1 then
				call s__Inventory_pull(this,cat , index)
			endif
  endfunction

  function s__Inventory_visibleForPlayer takes integer this,boolean flag returns nothing
			if s__Inventory_visible_flag[this] != flag then
				if flag then
					
					call s__Array_add(s__CloseUI_list[(this)],s__CloseUI_ORDER_INVENTORY)
				else
					
					call s__Array_eraseFor(s__CloseUI_list[(this)],s__CloseUI_ORDER_INVENTORY)
				endif
			endif
			set s__Inventory_visible_flag[this]=flag
			if GetLocalPlayer() == (Player((this))) then // INLINED!!
				call BlzFrameSetVisible(FRAME_INVENTORY, flag)
			endif
			if s__Inventory_visible_flag[this] then
				//TODO REFRESH
			else
				call s__Inventory_closeDialog(this)
			endif
  endfunction

  function s__Inventory_switch takes integer this returns nothing
			call s__Inventory_visibleForPlayer(this,not s__Inventory_visible_flag[this])
  endfunction

  function s__Inventory_close takes integer this returns boolean
			if s__Inventory_visible_flag[this] then
				if s__Inventory_dialog_visible[this] then
					call s__Inventory_closeDialog(this)
					return true
				else
					call s__Inventory_visibleForPlayer(this,false)
					return true
				endif
			endif
			return false
  endfunction

  function s__Inventory_press takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if (udg_EVENT_VALUE) == CONFIG_EVENT_KEYPRESS then // INLINED!!
				if CUSTOM_RESPOND_KEYPRESS_PLAYER != (Player((this))) then // INLINED!!
					return
				endif
				if CUSTOM_RESPOND_KEYPRESS_KEY == OSKEY_B and CUSTOM_RESPOND_KEYPRESS_PRESS then
					call s__Inventory_switch(this)
					return
				endif
				return
			endif
			if BlzGetTriggerFrame() != null then
				call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
				call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
				if BlzGetTriggerFrameEvent() == FRAMEEVENT_CONTROL_CLICK then
					if BlzGetTriggerFrame() == s__Inventory_dialog_btn_confirm[this] then
						call s__Inventory_dialogConfirm(this)
					elseif BlzGetTriggerFrame() == s__Inventory_dialog_btn_cancle[this] then
						call s__Inventory_closeDialog(this)
					endif
				endif
				return
			endif
  endfunction

  function s__Inventory_create takes player p returns integer
   local integer this= GetPlayerId(p)
   local integer i= 0
			
			set s__Inventory_visible_flag[this]=false
			set s__Inventory_dialog_visible[this]=false
			set s__Inventory_keypress[this]=s__Trigger_new(this)
			call TriggerRegisterVariableEvent((s__Inventory_keypress[this] ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_KEYPRESS)*1.0)) // INLINED!!
			set s__Inventory_keypress_cond[this]=TriggerAddCondition(s__Inventory_keypress[this], Condition(function s__Inventory_press))
			
			loop
				exitwhen i >= Inventory_SLOT
				call s__InventoryIcon_create(p , i)
				set i=i + 1
			endloop
			
			set s__Inventory_mouseover_above[this]=BlzCreateFrameByType("FRAME", "", FRAME_INVENTORY, "", 0)
			call BlzFrameSetAllPoints(s__Inventory_mouseover_above[this], FRAME_INVENTORY)
			call BlzFrameSetVisible(s__Inventory_mouseover_above[this], false)
			
			set s__Inventory_dialog_backdrop[this]=BlzCreateFrame("MBEdge", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_POPUP], 0, 0)
			call BlzFrameSetPoint(s__Inventory_dialog_backdrop[this], FRAMEPOINT_CENTER, FRAME_ORIGIN, FRAMEPOINT_CENTER, 0., 0.)
			call BlzFrameSetSize((s__Inventory_dialog_backdrop[this] ), (( s__Inventory_DIALOG_WIDTH )*1.0) / 1800., (( s__Inventory_DIALOG_HEIGHT)*1.0) / 1800.) // INLINED!!
			call s__Inventory_closeDialog(this)
			set s__Inventory_dialog_text[this]=BlzCreateFrame("MyText", s__Inventory_dialog_backdrop[this], 0, 0)
			call BlzFrameSetPoint((s__Inventory_dialog_text[this] ), ( FRAMEPOINT_TOPLEFT ), ( s__Inventory_dialog_backdrop[this] ), ( FRAMEPOINT_TOPLEFT ), (( 32 )*1.0) / 1800., (( - 32)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetPoint((s__Inventory_dialog_text[this] ), ( FRAMEPOINT_BOTTOMRIGHT ), ( s__Inventory_dialog_backdrop[this] ), ( FRAMEPOINT_BOTTOMRIGHT ), (( - 32 )*1.0) / 1800., (( 32)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetTextAlignment(s__Inventory_dialog_text[this], TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
			set s__Inventory_dialog_btn_confirm[this]=BlzCreateFrame("InventoryDialogConfirmButton", s__Inventory_dialog_backdrop[this], 0, 0)
			call BlzFrameSetPoint((s__Inventory_dialog_btn_confirm[this] ), ( FRAMEPOINT_BOTTOMRIGHT ), ( s__Inventory_dialog_backdrop[this] ), ( FRAMEPOINT_BOTTOM ), (( - 16 )*1.0) / 1800., (( 16)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((s__Inventory_dialog_btn_confirm[this] ), (( 192 )*1.0) / 1800., (( 48)*1.0) / 1800.) // INLINED!!
			call BlzTriggerRegisterFrameEvent(s__Inventory_keypress[this], s__Inventory_dialog_btn_confirm[this], FRAMEEVENT_CONTROL_CLICK)
			call BlzTriggerRegisterFrameEvent(s__Inventory_keypress[this], s__Inventory_dialog_btn_confirm[this], FRAMEEVENT_MOUSE_ENTER)
			call BlzTriggerRegisterFrameEvent(s__Inventory_keypress[this], s__Inventory_dialog_btn_confirm[this], FRAMEEVENT_MOUSE_LEAVE)
			set s__Inventory_dialog_btn_cancle[this]=BlzCreateFrame("InventoryDialogCancleButton", s__Inventory_dialog_backdrop[this], 0, 0)
			call BlzFrameSetPoint((s__Inventory_dialog_btn_cancle[this] ), ( FRAMEPOINT_BOTTOMLEFT ), ( s__Inventory_dialog_backdrop[this] ), ( FRAMEPOINT_BOTTOM ), (( 16 )*1.0) / 1800., (( 16)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((s__Inventory_dialog_btn_cancle[this] ), (( 192 )*1.0) / 1800., (( 48)*1.0) / 1800.) // INLINED!!
			call BlzTriggerRegisterFrameEvent(s__Inventory_keypress[this], s__Inventory_dialog_btn_cancle[this], FRAMEEVENT_CONTROL_CLICK)
			call BlzTriggerRegisterFrameEvent(s__Inventory_keypress[this], s__Inventory_dialog_btn_cancle[this], FRAMEEVENT_MOUSE_ENTER)
			call BlzTriggerRegisterFrameEvent(s__Inventory_keypress[this], s__Inventory_dialog_btn_cancle[this], FRAMEEVENT_MOUSE_LEAVE)
			
			set s__Inventory_inventories[this]=s__Inventory___Inventories_create()
			set i=0
			loop
				exitwhen i >= Inventory___CATEGORY
				call s__Array_add(s__Inventory___Inventories_list[s__Inventory_inventories[this]],s__Inventory___ItemList_create(this))
				set i=i + 1
			endloop
			
			
			
			
			call s__Inventory_changeCategory(this,s__Inventory_CATEGORY_MATERIAL)
			return this
  endfunction

  function s__Inventory_destroy takes integer this returns nothing
   local integer i= 0
			loop
				exitwhen i >= Inventory_SLOT
				call s__InventoryIcon_destroy(((this) * Inventory_SLOT + (i))) // INLINED!!
				set i=i + 1
			endloop
//textmacro instance: destroyFrame(".container")
	call BlzDestroyFrame(s__Inventory_container[this])
	set s__Inventory_container[this]=null
//end of: destroyFrame(".container")
//textmacro instance: destroyFrame(".dialog_backdrop")
	call BlzDestroyFrame(s__Inventory_dialog_backdrop[this])
	set s__Inventory_dialog_backdrop[this]=null
//end of: destroyFrame(".dialog_backdrop")
//textmacro instance: destroyFrame(".dialog_text")
	call BlzDestroyFrame(s__Inventory_dialog_text[this])
	set s__Inventory_dialog_text[this]=null
//end of: destroyFrame(".dialog_text")
//textmacro instance: destroyFrame(".dialog_btn_confirm")
	call BlzDestroyFrame(s__Inventory_dialog_btn_confirm[this])
	set s__Inventory_dialog_btn_confirm[this]=null
//end of: destroyFrame(".dialog_btn_confirm")
//textmacro instance: destroyFrame(".dialog_btn_cancle")
	call BlzDestroyFrame(s__Inventory_dialog_btn_cancle[this])
	set s__Inventory_dialog_btn_cancle[this]=null
//end of: destroyFrame(".dialog_btn_cancle")
//textmacro instance: destroyFrame(".mouseover_above")
	call BlzDestroyFrame(s__Inventory_mouseover_above[this])
	set s__Inventory_mouseover_above[this]=null
//end of: destroyFrame(".mouseover_above")
//textmacro instance: destroyTriggerAndCondition(".keypress",".keypress_cond")
		call TriggerRemoveCondition(s__Inventory_keypress[this], s__Inventory_keypress_cond[this])
		call s__Trigger_remove(s__Inventory_keypress[this])
