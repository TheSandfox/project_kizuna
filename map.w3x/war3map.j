  function s__ChainLightning_affectFilter takes integer this,integer target returns boolean
			if ( not s__ChainLightning_affect_enemy[this] and (IsUnitEnemy(s__Unit_prototype_origin_unit[(target)], ((GetOwningPlayer(s__Unit_prototype_origin_unit[(sc__UnitActor__get_owner(this))]))))) ) then // INLINED!!
				call BJDebugMsg((GetHeroProperName(s__Unit_prototype_origin_unit[(target)]))) // INLINED!!
				return false
			elseif ( not s__ChainLightning_affect_ally[this] and (IsUnitAlly(s__Unit_prototype_origin_unit[(target)], ((GetOwningPlayer(s__Unit_prototype_origin_unit[(sc__UnitActor__get_owner(this))]))))) ) then // INLINED!!
				return false
			elseif ( not s__ChainLightning_affect_invincible[this] and sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[target],CONFIG_STATUS_INVINCIBLE) > 0 ) then
				return false
			elseif ( not s__ChainLightning_affect_evasion[this] and sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[target],CONFIG_STATUS_EVASION) > 0 ) then
				return false
			elseif ( not s__ChainLightning_affect_self[this] and target == sc__UnitActor__get_owner(this) ) then
				return false
			elseif ( not s__ChainLightning_affect_dead[this] and sc__Unit_prototype_isUnitType(target,UNIT_TYPE_DEAD) ) then
				return false
			else
				return true
			endif
  endfunction

