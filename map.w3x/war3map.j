			call s__Unit_prototype_minusStatValue(s__Buff_target[this],ENUM_STAT_MOVEMENT_SPEED , Buff10v0_DATA_REAL1)
			set s__Buff10v0_main_v[this]=s__Buff10v0_main_v[this] + r
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],ENUM_STAT_ATTACK , r)
  endfunction

  function s__Buff10v0_main_update takes integer this returns boolean
			call s__Buff10v0_main_addValue(this)
			return true
  endfunction

