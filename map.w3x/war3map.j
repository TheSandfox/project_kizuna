			set s__Buff20d1_main_v[this]=s__Unit_prototype_getCarculatedStatValue(s__Buff_caster[this],Buff20d1_DAMAGE_STAT1) * Buff20d1_DAMAGE_AMPLIFIER1 * ( 1 + Buff20d1_DAMAGE_PER_LEVEL * ( s__Buff_level[this] ) )
			return true
  endfunction

