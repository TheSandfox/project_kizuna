  function s__Buff10g0_main_relativeTooltip takes integer this returns string
			return "회피치와 이동속도가 감소했으며 이동기를 사용할 수 없습니다."
  endfunction

  function s__Buff10g0_main_update takes integer this returns boolean
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],ENUM_STAT_EVASION , - s__Buff10g0_main_v2[this])
			set s__Buff10g0_main_v2[this]=s__Unit_prototype_getCalculatedStatValue(s__Buff_caster[this],Buff10g0_DAMAGE_STAT1) * Buff10g0_DAMAGE_AMPLIFIER1 * ( 1 + Buff10g0_DAMAGE_PER_LEVEL * s__Buff_level[this] )
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],ENUM_STAT_EVASION , s__Buff10g0_main_v2[this])
			return true
  endfunction

  function s__Buff10g0_main_init takes integer this returns boolean
			call s__Buff_addEffect(this,s__Effect_createAttatched(Buff10g0__EFFECT_PATH1 , s__Unit_prototype_origin_unit[s__Buff_target[this]] , "origin"))
			set s__Buff10g0_main_v1[this]=s__Math_reduceDivisor(Buff10g0_DATA_REAL1)
			set s__Buff10g0_main_v2[this]=s__Unit_prototype_getCalculatedStatValue(s__Buff_caster[this],Buff10g0_DAMAGE_STAT1) * Buff10g0_DAMAGE_AMPLIFIER1 * ( 1 + Buff10g0_DAMAGE_PER_LEVEL * s__Buff_level[this] )
			call s__Unit_prototype_divideStatValue(s__Buff_target[this],ENUM_STAT_MOVEMENT_SPEED , s__Buff10g0_main_v1[this])
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],ENUM_STAT_EVASION , s__Buff10g0_main_v2[this])
			call s__Unit_prototype_plusStatus(s__Buff_target[this],ENUM_STATUS_ROOT)
			return true
  endfunction

  function s__Buff10g0_main_onDestroy takes integer this returns nothing
			call s__Unit_prototype_divideStatValue(s__Buff_target[this],ENUM_STAT_MOVEMENT_SPEED , - s__Buff10g0_main_v1[this])
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],ENUM_STAT_EVASION , - s__Buff10g0_main_v2[this])
			call s__Unit_prototype_minusStatus(s__Buff_target[this],ENUM_STATUS_ROOT)
  endfunction


//textmacro instance: buffEnd()

