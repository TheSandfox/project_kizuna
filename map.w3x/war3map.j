  endfunction

  function s__AbilityShard_getUpgradePoint takes integer this,integer index returns integer
			if HaveSavedInteger(s__AbilityShard_AbilityMix___HASH, this, index) then
				return LoadInteger(s__AbilityShard_AbilityMix___HASH, this, index)
			else
				return 0
			endif
  endfunction

  function s__AbilityShard_setUpgradePoint takes integer this,integer index,integer val returns integer
