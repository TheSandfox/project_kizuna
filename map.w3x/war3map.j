  function s__PowerupItemWidget_refresh takes integer this returns nothing
   local string s= ""
   local integer p_item_type= (s__PowerupItem_type[(s__PowerupItemWidget_target[this])]) // INLINED!!
   local integer p_item_value= (s__PowerupItem_value[(s__PowerupItemWidget_target[this])]) // INLINED!!
			if GetLocalPlayer() == s__PowerupItemWidget_owner[this] then
				if p_item_type > - 1 then
					
					call BlzFrameSetVisible(s__PowerupItemWidget_P_TYPE_LABEL[s__PowerupItemWidget_index[this]], true)
					call BlzFrameSetText(s__PowerupItemWidget_P_TYPE_LABEL_TEXT[s__PowerupItemWidget_index[this]], UDG_POWERUP_ITEM_TYPE_COLOR[p_item_type] + UDG_POWERUP_ITEM_TYPE_NAME[p_item_type] + "|r")
					
					call BlzFrameSetVisible(s__PowerupItemWidget_P_ICON[s__PowerupItemWidget_index[this]], true)
					
					if p_item_type == ENUM_POWERUP_ITEM_TYPE_ABILITY then
						
						call BlzFrameSetTexture(s__PowerupItemWidget_P_ICON[s__PowerupItemWidget_index[this]], s__Ability_getTypeIconPath(p_item_value), 0, true)
						
						call BlzFrameSetText(s__PowerupItemWidget_P_TITLE[s__PowerupItemWidget_index[this]], (LoadStr(Ability__HASH1, (p_item_value), s__Ability_INDEX_NAME))) // INLINED!!
						
						call BlzFrameSetText(s__PowerupItemWidget_P_DESC[s__PowerupItemWidget_index[this]], s__Ability_getTypeTooltip(p_item_value))
						
					elseif p_item_type == ENUM_POWERUP_ITEM_TYPE_STAT then
						
						call BlzFrameSetTexture(s__PowerupItemWidget_P_ICON[s__PowerupItemWidget_index[this]], UDG_STAT_ICON[p_item_value], 0, true)
						
						call BlzFrameSetText(s__PowerupItemWidget_P_TITLE[s__PowerupItemWidget_index[this]], UDG_STAT_COLOR[p_item_value] + UDG_STAT_NAME[p_item_value] + "|r |cffffff00+" + I2S(R2I(CONFIG_POWERUP_STAT_AMOUNT * UDG_STAT_NORMAL_VALUE[p_item_value])) + "|r")
						
						call BlzFrameSetText(s__PowerupItemWidget_P_DESC[s__PowerupItemWidget_index[this]], UDG_STAT_DESC[p_item_value])
					endif
					
					call BlzFrameSetVisible(s__PowerupItemWidget_P_TITLE[s__PowerupItemWidget_index[this]], true)
					
					call BlzFrameSetVisible(s__PowerupItemWidget_P_DESC[s__PowerupItemWidget_index[this]], true)
					
					call BlzFrameSetVisible(s__PowerupItemWidget_P_BTN[s__PowerupItemWidget_index[this]], true)
				else
					
					call BlzFrameSetVisible(s__PowerupItemWidget_P_TYPE_LABEL[s__PowerupItemWidget_index[this]], false)
					
					call BlzFrameSetVisible(s__PowerupItemWidget_P_ICON[s__PowerupItemWidget_index[this]], false)
					
					call BlzFrameSetVisible(s__PowerupItemWidget_P_BTN[s__PowerupItemWidget_index[this]], false)
					
					call BlzFrameSetVisible(s__PowerupItemWidget_P_TITLE[s__PowerupItemWidget_index[this]], false)
					
					call BlzFrameSetVisible(s__PowerupItemWidget_P_DESC[s__PowerupItemWidget_index[this]], false)
				endif
			endif
  endfunction

  function s__PowerupItemWidget_press takes nothing returns nothing
   local integer this= 0
   local integer j= 0
   local integer i= 0
   local integer p_manager= 0
			
			loop
				exitwhen j >= PowerupUI___P_WIDGET_COUNT
				exitwhen BlzGetTriggerFrame() == s__PowerupItemWidget_P_BTN[j]
				set j=j + 1
			endloop
			set this=GetPlayerId(GetTriggerPlayer()) * PowerupUI___P_WIDGET_COUNT + j
			
			if BlzGetTriggerFrameEvent() == FRAMEEVENT_CONTROL_CLICK then
				
				set p_manager=(GetPlayerId(s__PowerupItemWidget_owner[this]))
				call s__PowerupManager_applyPowerupItem(p_manager,(s__User_FOCUS_UNIT[GetPlayerId((s__PowerupItemWidget_owner[this]))]) , j) // INLINED!!
			endif
  endfunction

  function s__PowerupItemWidget_initFrames takes integer index returns nothing
   local framehandle f= null
   local integer approxwidth= ( PowerupUI___P_WIDGET_CONTAINER_WIDTH - ( PowerupUI___P_WIDGET_GAP * ( PowerupUI___P_WIDGET_COUNT - 1 ) ) ) / PowerupUI___P_WIDGET_COUNT
   local integer nx= ( approxwidth + PowerupUI___P_WIDGET_GAP ) * index
   local integer ny= 0
			
			set s__PowerupItemWidget_P_WIDGET[index]=BlzCreateFrame("CPowerupUIWidget", PowerupUI___P_WIDGET_CONTAINER, 0, index)
			call BlzFrameSetPoint((s__PowerupItemWidget_P_WIDGET[index] ), ( FRAMEPOINT_TOPLEFT ), ( PowerupUI___P_WIDGET_CONTAINER ), ( FRAMEPOINT_TOPLEFT ), (( nx )*1.0) / 1800., (( ny)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetPoint((s__PowerupItemWidget_P_WIDGET[index] ), ( FRAMEPOINT_BOTTOMRIGHT ), ( PowerupUI___P_WIDGET_CONTAINER ), ( FRAMEPOINT_TOPLEFT ), (( nx + approxwidth )*1.0) / 1800., (( ny - PowerupUI___P_WIDGET_CONTAINER_HEIGHT)*1.0) / 1800.) // INLINED!!
			
			set s__PowerupItemWidget_P_TYPE_LABEL[index]=BlzGetFrameByName("CPowerupUIWidgetTypeLabel", index)
			set s__PowerupItemWidget_P_TYPE_LABEL_TEXT[index]=BlzGetFrameByName("CPowerupUIWidgetTypeLabelText", index)
			set f=BlzGetFrameByName("CPowerupUIWidgetTypeLabelBackground", index)
			call BlzFrameSetPoint(f, FRAMEPOINT_TOPLEFT, s__PowerupItemWidget_P_TYPE_LABEL_TEXT[index], FRAMEPOINT_TOPLEFT, - 0.002, 0.002)
			call BlzFrameSetPoint(f, FRAMEPOINT_BOTTOMRIGHT, s__PowerupItemWidget_P_TYPE_LABEL_TEXT[index], FRAMEPOINT_BOTTOMRIGHT, 0.002, - 0.002)
			call BlzFrameSetVisible(s__PowerupItemWidget_P_TYPE_LABEL[index], false)
			
			set s__PowerupItemWidget_P_ICON[index]=BlzGetFrameByName("CPowerupUIWidgetIcon", index)
			call BlzFrameSetPoint((s__PowerupItemWidget_P_ICON[index] ), ( FRAMEPOINT_TOP ), ( s__PowerupItemWidget_P_WIDGET[index] ), ( FRAMEPOINT_TOP ), (( 0 )*1.0) / 1800., (( - ( approxwidth - PowerupUI___P_WIDGET_ICON_SIZE ) / 2)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((s__PowerupItemWidget_P_ICON[index] ), (( PowerupUI___P_WIDGET_ICON_SIZE )*1.0) / 1800., (( PowerupUI___P_WIDGET_ICON_SIZE)*1.0) / 1800.) // INLINED!!
			
			set s__PowerupItemWidget_P_TITLE[index]=BlzGetFrameByName("CPowerupUIWidgetTitle", index)
			call BlzFrameSetVisible(s__PowerupItemWidget_P_TITLE[index], false)
			
			set s__PowerupItemWidget_P_DESC[index]=BlzGetFrameByName("CPowerupUIWidgetDesc", index)
			call BlzFrameSetVisible(s__PowerupItemWidget_P_DESC[index], false)
			call BlzFrameSetPoint((s__PowerupItemWidget_P_DESC[index] ), ( FRAMEPOINT_TOPLEFT ), ( s__PowerupItemWidget_P_TITLE[index] ), ( FRAMEPOINT_BOTTOM ), (( - approxwidth / 2 )*1.0) / 1800., (( - 16)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetPoint((s__PowerupItemWidget_P_DESC[index] ), ( FRAMEPOINT_BOTTOMRIGHT ), ( s__PowerupItemWidget_P_WIDGET[index] ), ( FRAMEPOINT_BOTTOMRIGHT ), (( 0 )*1.0) / 1800., (( 0)*1.0) / 1800.) // INLINED!!
			
			set s__PowerupItemWidget_P_BTN[index]=BlzCreateSimpleFrame("CPowerupUIWidgetButton", FRAME_POWERUP_UI, index)
			call BlzFrameSetAllPoints(s__PowerupItemWidget_P_BTN[index], s__PowerupItemWidget_P_WIDGET[index])
			set f=BlzGetFrameByName("CPowerupUIWidgetButtonBackground", index)
			call BlzFrameSetVertexColor(f, BlzConvertColor(128, 255, 255, 255))
			
			call BlzFrameSetVisible(PowerupUI___P_WIDGET_CONTAINER, false)
			
			call BlzTriggerRegisterFrameEvent(PowerupUI___P_WIDGET_CALLBACK, s__PowerupItemWidget_P_BTN[index], FRAMEEVENT_CONTROL_CLICK)
			
			set f=null
  endfunction

  function s__PowerupItemWidget_create takes player owner,integer index returns integer
   local integer this= GetPlayerId(owner) * PowerupUI___P_WIDGET_COUNT + index
   local integer p_manager= (GetPlayerId(owner))
			set s__PowerupItemWidget_owner[this]=owner
			set s__PowerupItemWidget_index[this]=index
			
			if not s__PowerupItemWidget_P_FRAME_CREATED[s__PowerupItemWidget_index[this]] then
				call s__PowerupItemWidget_initFrames(s__PowerupItemWidget_index[this])
				set s__PowerupItemWidget_P_FRAME_CREATED[s__PowerupItemWidget_index[this]]=true
			endif
			
			set s__PowerupItemWidget_target[this]=(CONFIG_POWERUP_ITEM_MAX * GetPlayerId(s__PowerupManager_owner[(p_manager)]) + (index)) // INLINED!!
			return this
  endfunction

  function s__PowerupItemWidget_destroy takes integer this returns nothing
			
  endfunction

  function s__PowerupItemWidget_onInit takes nothing returns nothing
			set PowerupUI___P_WIDGET_CALLBACK=CreateTrigger()
			call TriggerAddCondition(PowerupUI___P_WIDGET_CALLBACK, Condition(function s__PowerupItemWidget_press))
  endfunction

  function s__PowerupItemWidget_get takes player p,integer index returns integer
			return GetPlayerId(p) * PowerupUI___P_WIDGET_COUNT + index
  endfunction






  function s__PowerupUI__get_owner takes integer this returns player
			return Player(this)
  endfunction

  function s__PowerupUI_refresh takes integer this returns nothing
   local integer i= 0
   local integer wd= 0
   local integer p_manager= (GetPlayerId((Player((this))))) // INLINED!!
   local integer pup= 0
			
			
			if ((LoadInteger(Hash___D, (((s__PowerupManager_powerup_list[(p_manager)]))), (s__Array_P_SIZE))) <= 0) then // INLINED!!
				
				if GetLocalPlayer() == (Player((this))) then // INLINED!!
					
					call BlzFrameSetVisible(PowerupUI___P_WIDGET_CONTAINER, false)
					
					call BlzFrameSetVisible(s__PowerupUI_P_FRAME_INFO, false)
					
					call BlzFrameSetVisible(s__PowerupUI_P_FRAME_PLACEHOLDER, true)
					
					call BlzFrameSetEnable(s__PowerupUI_P_FRAME_BTN_REROLL, false)
					call BlzFrameSetEnable(s__PowerupUI_P_FRAME_BTN_SELL, false)
				endif
			else
				
				set pup=(s__Array_getValue(s__PowerupManager_powerup_list[p_manager],0))
				if GetLocalPlayer() == (Player((this))) then // INLINED!!
					
					call BlzFrameSetVisible(PowerupUI___P_WIDGET_CONTAINER, true)
					
					call BlzFrameSetVisible(s__PowerupUI_P_FRAME_INFO, true)
					if s__Powerup_type[pup] == ENUM_POWERUP_TYPE_LEVEL then
						call BlzFrameSetText(s__PowerupUI_P_FRAME_INFO_TEXT, UDG_POWERUP_TYPE_COLOR[s__Powerup_type[pup]] + "레벨 " + I2S(s__Powerup_value[pup]) + " 달성 보상|r")
					else
						call BlzFrameSetText(s__PowerupUI_P_FRAME_INFO_TEXT, UDG_POWERUP_TYPE_COLOR[s__Powerup_type[pup]] + UDG_POWERUP_TYPE_NAME[s__Powerup_type[pup]] + " 보상|r")
					endif
					
					call BlzFrameSetTexture(s__PowerupUI_P_FRAME_ICON_LEFT, UDG_POWERUP_TYPE_ICON[s__Powerup_type[pup]], 0, true)
					call BlzFrameSetTexture(s__PowerupUI_P_FRAME_ICON_RIGHT, UDG_POWERUP_TYPE_ICON[s__Powerup_type[pup]], 0, true)
					
					call BlzFrameSetVisible(s__PowerupUI_P_FRAME_PLACEHOLDER, false)
					
					call BlzFrameSetEnable(s__PowerupUI_P_FRAME_BTN_REROLL, true)
					call BlzFrameSetEnable(s__PowerupUI_P_FRAME_BTN_SELL, true)
				endif
			endif
			
			loop
				exitwhen i >= PowerupUI___P_WIDGET_COUNT
				set wd=(GetPlayerId(((Player((this))) )) * PowerupUI___P_WIDGET_COUNT + ( i)) // INLINED!!
				call s__PowerupItemWidget_refresh(wd)
				set i=i + 1
			endloop
  endfunction

  function s__PowerupUI_fadeRefresh takes integer this,integer alpha returns nothing
			
			if GetLocalPlayer() == (Player((this))) then // INLINED!!
				
				call BlzFrameSetAlpha(s__PowerupUI_P_FRAME_INFO, alpha)
				call BlzFrameSetAlpha(PowerupUI___P_WIDGET_CONTAINER, alpha)
			endif
  endfunction

  function s__PowerupUI_fadeAction takes nothing returns nothing
   local integer this= (sg__TimerUtils___DATA_get(GetHandleId(((GetExpiredTimer()))) * HASH_UP / HASH_DOWN + HASH_BIAS)) // INLINED!!
			set s__PowerupUI_fade_value[this]=s__PowerupUI_fade_value[this] + s__PowerupUI_P_FADE_VALUE_PER_TICK
			if s__PowerupUI_fade_value[this] >= 255 then
				set s__PowerupUI_fade_value[this]=255
				call PauseTimer((s__PowerupUI_fade_timer[this])) // INLINED!!
			endif
			call s__PowerupUI_fadeRefresh(this,s__PowerupUI_fade_value[this])
  endfunction

  function s__PowerupUI_fadeIn takes integer this returns nothing
			set s__PowerupUI_fade_value[this]=0
			call s__PowerupUI_fadeRefresh(this,0)
			call TimerStart((s__PowerupUI_fade_timer[this] ), (( s__PowerupUI_P_FADE_TICK )*1.0), ( true ), ( function s__PowerupUI_fadeAction)) // INLINED!!
  endfunction

  function s__PowerupUI_noticeAction takes nothing returns nothing
   local integer this= (sg__TimerUtils___DATA_get(GetHandleId(((GetExpiredTimer()))) * HASH_UP / HASH_DOWN + HASH_BIAS)) // INLINED!!
			if GetLocalPlayer() == (Player((this))) then // INLINED!!
				call BlzFrameSetText(s__PowerupUI_P_FRAME_NOTICE_TEXT, s__PowerupUI_P_NOTICE_COLORS[s__PowerupUI_notice_color_index[this]] + "◆|r")
			endif
			set s__PowerupUI_notice_color_index[this]=s__PowerupUI_notice_color_index[this] + 1
			if s__PowerupUI_notice_color_index[this] >= s__PowerupUI_P_NOTICE_COLORS_COUNT then
				set s__PowerupUI_notice_color_index[this]=0
			endif
  endfunction

  function s__PowerupUI_runNotice takes integer this,boolean flag returns nothing
			if GetLocalPlayer() == (Player((this))) then // INLINED!!
				
				call BlzFrameSetVisible(s__PowerupUI_P_FRAME_NOTICE, flag)
			endif
			if flag then
				
				call TimerStart((s__PowerupUI_notice_timer[this] ), (( 0.05 )*1.0), ( true ), ( function s__PowerupUI_noticeAction)) // INLINED!!
			else
				
				call PauseTimer((s__PowerupUI_notice_timer[this])) // INLINED!!
			endif
  endfunction

  function s__PowerupUI_visibleForPlayer takes integer this,boolean flag returns nothing
			if s__PowerupUI_visible_flag[this] != flag then
				if flag then
					if (s__Array_getLastValue(s__User_INPUT_LAYER[GetPlayerId(((Player((this)))))])) > CONFIG_INPUT_LAYER_POWERUP_UI then // INLINED!!
						return
					endif
					
					call s__Array_add(s__CloseUI_list[(this)],s__CloseUI_ORDER_POWERUP_UI)
					call s__PowerupUI_refresh(this)
					call s__Ability_prototype_cancleUnitAbilityAll((s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))])) // INLINED!!
					call s__User_addInputLayer((Player((this))) , CONFIG_INPUT_LAYER_POWERUP_UI) // INLINED!!
				else
					
					call s__Array_eraseFor(s__CloseUI_list[(this)],s__CloseUI_ORDER_POWERUP_UI)
					call s__User_removeInputLayer((Player((this))) , CONFIG_INPUT_LAYER_POWERUP_UI) // INLINED!!
				endif
			endif
			set s__PowerupUI_visible_flag[this]=flag
			if GetLocalPlayer() == (Player((this))) then // INLINED!!
				call PlaySoundBJ(gg_snd_BigButtonClick)
				call BlzFrameSetVisible(FRAME_POWERUP_UI, flag)
				call BlzFrameSetVisible(PowerupUI___P_WIDGET_CONTAINER, flag)
			endif
  endfunction

  function s__PowerupUI_close takes integer this returns boolean
			if s__PowerupUI_visible_flag[this] then
				call s__PowerupUI_visibleForPlayer(this,false)
				return true
			else
				return false
			endif
  endfunction

  function s__PowerupUI_switch takes integer this returns nothing
			call s__PowerupUI_visibleForPlayer(this,not s__PowerupUI_visible_flag[this])
  endfunction

  function s__PowerupUI_uiCallback takes nothing returns nothing
   local integer this= 0
   local player p= GetTriggerPlayer()
   local integer i= 0
			
			if (udg_EVENT_VALUE) == ENUM_EVENT_KEYPRESS then // INLINED!!
				set this=GetPlayerId(EVT_KEYPRESS_PLAYER)
				if EVT_KEYPRESS_KEY == OSKEY_T and EVT_KEYPRESS_PRESS then
					call s__PowerupUI_switch(this)
					return
				endif
				return
			endif
			
			set this=GetPlayerId(p)
			if BlzGetTriggerFrame() != null then
				
				if BlzGetTriggerFrameEvent() == FRAMEEVENT_CONTROL_CLICK then
					if BlzGetTriggerFrame() == s__PowerupUI_P_FRAME_BTN_CLOSE or BlzGetTriggerFrame() == s__PowerupUI_P_FRAME_BTN_CLOSE_SECONDARY then
						
						call s__PowerupUI_close(this)
						return
					elseif BlzGetTriggerFrame() == s__PowerupUI_P_FRAME_BTN_REROLL then
						
						return
					endif
				endif
			endif
  endfunction

  function s__PowerupUI_refreshCallback takes nothing returns nothing
   local integer this= GetPlayerId(EVT_UI_REFRESH_PLAYER)
			if this >= CONFIG_PLAYER_MAX then
				return
			endif
			if not s__PowerupUI_visible_flag[this] then
				return
			else
				call s__PowerupUI_refresh(this)
			endif
  endfunction

  function s__PowerupUI_powerupCallback takes nothing returns nothing
   local integer this= GetPlayerId(EVT_POWERUP_PLAYER)
   local integer p_manager= (this)
			if s__PowerupUI_visible_flag[this] then
				if (LoadInteger(Hash___D, (((s__PowerupManager_powerup_list[p_manager]))), (s__Array_P_SIZE))) > 0 then // INLINED!!
					
					call s__PowerupUI_fadeIn(this)
				else
					
					call s__PowerupUI_visibleForPlayer(this,false)
				endif
			endif
			if (LoadInteger(Hash___D, (((s__PowerupManager_powerup_list[p_manager]))), (s__Array_P_SIZE))) <= 0 then // INLINED!!
				
				call s__PowerupUI_runNotice(this,false)
			endif
  endfunction

  function s__PowerupUI_powerupAddCallback takes nothing returns nothing
   local integer this= GetPlayerId(EVT_POWERUP_PLAYER)
   local integer p_manager= (this)
			if (LoadInteger(Hash___D, (((s__PowerupManager_powerup_list[p_manager]))), (s__Array_P_SIZE))) == 1 then // INLINED!!
				
				if s__PowerupUI_visible_flag[this] then
					
					call s__PowerupUI_fadeIn(this)
					call s__PowerupUI_refresh(this)
				endif
				
				call s__PowerupUI_runNotice(this,true)
			endif
  endfunction

		
  function s__PowerupUI_inputLayerChangeCallback takes nothing returns nothing
   local integer this= GetPlayerId(EVT_INPUT_LAYER_CHANGE_PLAYER)
			if this >= CONFIG_PLAYER_MAX then
				return
			endif
			if EVT_INPUT_LAYER_CHANGE_LAYER > CONFIG_INPUT_LAYER_POWERUP_UI and s__PowerupUI_visible_flag[this] then
				call DisableTrigger(GetTriggeringTrigger())
				call s__PowerupUI_visibleForPlayer(this,false)
				call EnableTrigger(GetTriggeringTrigger())
			endif
  endfunction

  function s__PowerupUI_menuButtonCallback takes nothing returns nothing
   local integer this= GetPlayerId(GetTriggerPlayer())
			if this >= CONFIG_PLAYER_MAX then
				return
			endif
			call s__PowerupUI_switch(this)
  endfunction

  function s__PowerupUI_initFrames takes nothing returns nothing
   local trigger t= null
   local framehandle f= null
			
			set PowerupUI___P_UI_CALLBACK=CreateTrigger()
			
			set PowerupUI___P_WIDGET_CONTAINER=BlzCreateFrame("CPowerupUIWidgetContainer", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_WINDOW], 0, 0)
			call BlzFrameSetPoint((PowerupUI___P_WIDGET_CONTAINER ), ( FRAMEPOINT_TOPLEFT ), ( FRAME_POWERUP_UI ), ( FRAMEPOINT_TOP ), (( - PowerupUI___P_WIDGET_CONTAINER_WIDTH / 2 )*1.0) / 1800., (( PowerupUI___P_WIDGET_CONTAINER_OFFSET_Y)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetPoint((PowerupUI___P_WIDGET_CONTAINER ), ( FRAMEPOINT_BOTTOMRIGHT ), ( FRAME_POWERUP_UI ), ( FRAMEPOINT_TOP ), (( PowerupUI___P_WIDGET_CONTAINER_WIDTH / 2 )*1.0) / 1800., (( PowerupUI___P_WIDGET_CONTAINER_OFFSET_Y - PowerupUI___P_WIDGET_CONTAINER_HEIGHT)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetVisible(PowerupUI___P_WIDGET_CONTAINER, false)
			
			set s__PowerupUI_P_FRAME_INFO=BlzGetFrameByName("CPowerupUIInfo", 0)
			set s__PowerupUI_P_FRAME_INFO_TEXT=BlzGetFrameByName("CPowerupUIInfoText", 0)
			
			set s__PowerupUI_P_FRAME_ICON_LEFT=BlzGetFrameByName("CPowerupUIInfoIconLeft", 0)
			set s__PowerupUI_P_FRAME_ICON_RIGHT=BlzGetFrameByName("CPowerupUIInfoIconRight", 0)
			set f=BlzGetFrameByName("CPowerupUIInfoBackground", 0)
			call BlzFrameSetVertexColor(f, BlzConvertColor(128, 255, 255, 255))
			
			set s__PowerupUI_P_FRAME_PLACEHOLDER=BlzGetFrameByName("CPowerupUIPlaceholder", 0)
			set f=BlzGetFrameByName("CPowerupUIPlaceholderBackground", 0)
			call BlzFrameSetVertexColor(f, BlzConvertColor(128, 255, 255, 255))
			
			set s__PowerupUI_P_FRAME_BTN_REROLL=BlzGetFrameByName("CPowerupUIRerollButton", 0)
			
			set s__PowerupUI_P_FRAME_BTN_SELL=BlzGetFrameByName("CPowerupUISellButton", 0)
			
			set s__PowerupUI_P_FRAME_BTN_CLOSE=BlzGetFrameByName("CPowerupUICloseButton", 0)
			set s__PowerupUI_P_FRAME_BTN_CLOSE_SECONDARY=BlzGetFrameByName("CPowerupUICloseButton2", 0)
			
			set s__PowerupUI_P_FRAME_NOTICE=BlzGetFrameByName("CPowerupUIButtonNotice", 0)
			set s__PowerupUI_P_FRAME_NOTICE_TEXT=BlzGetFrameByName("CPowerupUIButtonNoticeText", 0)
			call BlzFrameSetVisible(s__PowerupUI_P_FRAME_NOTICE, false)
			
			call BlzTriggerRegisterFrameEvent(PowerupUI___P_UI_CALLBACK, s__PowerupUI_P_FRAME_BTN_CLOSE, FRAMEEVENT_CONTROL_CLICK)
			call BlzTriggerRegisterFrameEvent(PowerupUI___P_UI_CALLBACK, s__PowerupUI_P_FRAME_BTN_CLOSE_SECONDARY, FRAMEEVENT_CONTROL_CLICK)
			call TriggerAddCondition(PowerupUI___P_UI_CALLBACK, Condition(function s__PowerupUI_uiCallback))
			call TriggerRegisterVariableEvent((PowerupUI___P_UI_CALLBACK ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_KEYPRESS)*1.0)) // INLINED!!
			
			set t=CreateTrigger()
			call BlzTriggerRegisterFrameEvent(t, BlzGetFrameByName("CPowerupUIButton", 0), FRAMEEVENT_CONTROL_CLICK)
			call TriggerAddCondition(t, Condition(function s__PowerupUI_menuButtonCallback))
			
			set t=null
			set f=null
  endfunction

  function s__PowerupUI_create takes player p returns integer
   local integer this= GetPlayerId(p)
   local integer i= 0
			set s__PowerupUI_visible_flag[this]=false
			set s__PowerupUI_notice_color_index[this]=0
			
			set s__PowerupUI_fade_timer[this]=s__Timer_new(this)
			set s__PowerupUI_notice_timer[this]=s__Timer_new(this)
			
			if not s__PowerupUI_P_FRAME_CREATED then
				call s__PowerupUI_initFrames()
				set s__PowerupUI_P_FRAME_CREATED=true
			endif
			
			loop
				exitwhen i >= PowerupUI___P_WIDGET_COUNT
				call s__PowerupItemWidget_create(Player(this) , i)
				set i=i + 1
			endloop
			
			call s__PowerupUI_refresh(this)
			return this
  endfunction

  function s__PowerupUI_destroy takes integer this returns nothing

  endfunction

  function s__PowerupUI_onInit takes nothing returns nothing
   local trigger t
			
			set s__PowerupUI_P_NOTICE_COLORS[0]="|cffff0000"
			set s__PowerupUI_P_NOTICE_COLORS[1]="|cffff2424"
			set s__PowerupUI_P_NOTICE_COLORS[2]="|cffff4949"
			set s__PowerupUI_P_NOTICE_COLORS[3]="|cffff6d6d"
			set s__PowerupUI_P_NOTICE_COLORS[4]="|cffff9292"
			set s__PowerupUI_P_NOTICE_COLORS[5]="|cffffb6b6"
			set s__PowerupUI_P_NOTICE_COLORS[6]="|cffffdbdb"
			set s__PowerupUI_P_NOTICE_COLORS[7]="|cffffffff"
			set s__PowerupUI_P_NOTICE_COLORS[8]="|cffffffff"
			set s__PowerupUI_P_NOTICE_COLORS[9]="|cffffdbdb"
			set s__PowerupUI_P_NOTICE_COLORS[10]="|cffffb6b6"
			set s__PowerupUI_P_NOTICE_COLORS[11]="|cffff9292"
			set s__PowerupUI_P_NOTICE_COLORS[12]="|cffff6d6d"
			set s__PowerupUI_P_NOTICE_COLORS[13]="|cffff4949"
			set s__PowerupUI_P_NOTICE_COLORS[14]="|cffff2424"
			set s__PowerupUI_P_NOTICE_COLORS[15]="|cffff0000"
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_ABILITY_UI_REFRESH)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__PowerupUI_refreshCallback))
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_POWERUP)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__PowerupUI_powerupCallback))
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_POWERUP_ADD)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__PowerupUI_powerupAddCallback))
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_INPUT_LAYER_CHANGE)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__PowerupUI_inputLayerChangeCallback))
			
			set t=null
  endfunction



//library PowerupUI ends
//library SlotChanger:


		




  function s__SlotChanger_mapIndex takes integer this,integer index returns integer
			return this * CONFIG_ABILITY_SIZE + index
  endfunction

  function s__SlotChanger_getMap takes integer this,integer index returns integer
			return s__SlotChanger_MAP[((this) * CONFIG_ABILITY_SIZE + (index))] // INLINED!!
  endfunction

  function s__SlotChanger_setMap takes integer this,integer index,integer val returns nothing
			set s__SlotChanger_MAP[((this) * CONFIG_ABILITY_SIZE + (index))]=val // INLINED!!
  endfunction

  function s__SlotChanger__get_owner takes integer this returns player
			return Player(this)
  endfunction

  function s__SlotChanger_refresh takes integer this returns nothing
   local integer i= 0
   local framehandle f= null
   local framehandle bf= null
   local integer a= 0
			
			set i=0
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				
				set a=(s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[(s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))])],(s__SlotChanger_MAP[(((this)) * CONFIG_ABILITY_SIZE + ((i)))]))) // INLINED!!
				
				set f=BlzGetFrameByName("CSlotChangerButtonIcon", i)
				if (s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))]) <= 0 or a <= 0 then // INLINED!!
					if GetLocalPlayer() == Player(this) then
						call BlzFrameSetTexture(f, "Icons\\BTNBlackIcon.blp", 0, true)
					endif
				else
					if GetLocalPlayer() == Player(this) then
						call BlzFrameSetTexture(f, s__Ability_getTypeIconPath(s__Ability_prototype_id[a]), 0, true)
					endif
				endif
				
				set f=s__SlotChanger_BUTTON[i]
				
				if s__SlotChanger_state[this] == 0 or s__SlotChanger_state[this] == 2 then
					
					if (s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))]) <= 0 or a <= 0 then // INLINED!!
						if GetLocalPlayer() == Player(this) then
							call BlzFrameSetEnable(f, false)
							call BlzFrameSetText(BlzGetFrameByName("CSlotChangerButtonHotkeyText", i), "|cff999999" + UDG_ABILITY_SLOT_NAME[i] + "|r")
						endif
					
					else
						if GetLocalPlayer() == Player(this) then
							call BlzFrameSetEnable(f, true)
							if s__SlotChanger_state[this] == 0 then
								call BlzFrameSetText(BlzGetFrameByName("CSlotChangerButtonHotkeyText", i), "|cffffcc00" + UDG_ABILITY_SLOT_NAME[i] + "|r")
							elseif s__SlotChanger_state[this] == 2 then
								call BlzFrameSetText(BlzGetFrameByName("CSlotChangerButtonHotkeyText", i), "|cff00ccff" + UDG_ABILITY_SLOT_NAME[i] + "|r")
							endif
						endif
					endif
				
				else
					if (s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))]) <= 0 then // INLINED!!
						if GetLocalPlayer() == Player(this) then
							call BlzFrameSetEnable(f, false)
						endif
					
					else
						set bf=BlzGetFrameByName("CSlotChangerButtonHotkeyText", i)
						if GetLocalPlayer() == Player(this) then
							call BlzFrameSetEnable(f, true)
							if i == s__SlotChanger_first_index[this] then
								call BlzFrameSetText(bf, "|cffffff00" + UDG_ABILITY_SLOT_NAME[i] + "|r")
							else
								call BlzFrameSetText(bf, "|cff00cc00" + UDG_ABILITY_SLOT_NAME[i] + "|r")
							endif
						endif
					endif
				endif
				set i=i + 1
			endloop
			
			if s__SlotChanger_state[this] == 0 or s__SlotChanger_state[this] == 1 then
				set f=s__SlotChanger_CONFIRM_BUTTON_TEXT
				if GetLocalPlayer() == Player(this) then
					call BlzFrameSetText(f, "|cff999999적용|r")
					call BlzFrameSetEnable(s__SlotChanger_CONFIRM_BUTTON, false)
				endif
			elseif s__SlotChanger_state[this] == 2 then
				set f=s__SlotChanger_CONFIRM_BUTTON_TEXT
				if GetLocalPlayer() == Player(this) then
					call BlzFrameSetText(f, "|cff00ccff적용 (" + UDG_MENU_NAME[ENUM_MENU_SLOT_CHANGER] + ")|r")
					call BlzFrameSetEnable(s__SlotChanger_CONFIRM_BUTTON, true)
				endif
			endif
			set f=null
			set bf=null
  endfunction

  function s__SlotChanger_stateEdited takes integer this,integer target_index returns nothing
   local integer i= (s__SlotChanger_MAP[(((this)) * CONFIG_ABILITY_SIZE + ((s__SlotChanger_first_index[this])))]) // INLINED!!
			set s__SlotChanger_MAP[(((this)) * CONFIG_ABILITY_SIZE + ((s__SlotChanger_first_index[this] )))]=( (s__SlotChanger_MAP[(((this)) * CONFIG_ABILITY_SIZE + ((target_index)))])) // INLINED!!
			set s__SlotChanger_MAP[(((this)) * CONFIG_ABILITY_SIZE + ((target_index )))]=( i) // INLINED!!
			set s__SlotChanger_state[this]=2
			call s__SlotChanger_refresh(this)
  endfunction

  function s__SlotChanger_stateSelectFirst takes integer this,integer first_index returns nothing
			set s__SlotChanger_first_index[this]=first_index
			set s__SlotChanger_state[this]=1
			call s__SlotChanger_refresh(this)
  endfunction

  function s__SlotChanger_stateDefault takes integer this returns nothing
   local integer i= 0
			set s__SlotChanger_state[this]=0
			set s__SlotChanger_first_index[this]=- 1
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				set s__SlotChanger_MAP[(((this)) * CONFIG_ABILITY_SIZE + ((i )))]=( i) // INLINED!!
				set i=i + 1
			endloop
			call s__SlotChanger_refresh(this)
  endfunction

  function s__SlotChanger_visibleForPlayer takes integer this,boolean flag returns nothing
			if s__SlotChanger_visible_flag[this] != flag then
				if flag then
					if (s__Array_getLastValue(s__User_INPUT_LAYER[GetPlayerId(((Player((this)))))])) <= CONFIG_INPUT_LAYER_SLOT_CHANGER then // INLINED!!
						
						call s__SlotChanger_stateDefault(this)
						if (s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))]) > 0 then // INLINED!!
							call s__Ability_prototype_cancleUnitAbilityAll((s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))])) // INLINED!!
						endif
						call EnableTrigger(s__SlotChanger_keypress_trigger[this])
						
						call s__Array_add(s__CloseUI_list[(this)],s__CloseUI_ORDER_SLOT_CHANGER)
						call s__User_addInputLayer((Player((this))) , CONFIG_INPUT_LAYER_SLOT_CHANGER) // INLINED!!
					else
						return
					endif
				else
					
					call DisableTrigger(s__SlotChanger_keypress_trigger[this])
					
					call s__Array_eraseFor(s__CloseUI_list[(this)],s__CloseUI_ORDER_SLOT_CHANGER)
					call s__User_removeInputLayer((Player((this))) , CONFIG_INPUT_LAYER_SLOT_CHANGER) // INLINED!!
				endif
				// call User.enableAbilityHotkey(.owner,not flag)
			endif
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(FRAME_SLOT_CHANGER, flag)
				call PlaySoundBJ(gg_snd_BigButtonClick)
			endif
			set s__SlotChanger_visible_flag[this]=flag
  endfunction

  function s__SlotChanger_close takes integer this returns boolean
			if s__SlotChanger_visible_flag[this] then
				call s__SlotChanger_visibleForPlayer(this,false)
				return true
			else
				return false
			endif
  endfunction

  function s__SlotChanger_confirm takes integer this returns nothing
   local integer i= 0
   local integer u= (s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))]) // INLINED!!
			if s__SlotChanger_state[this] != 2 then
				return
			endif
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				set s__SlotChanger_ABILITY_TEMP[((this) * CONFIG_ABILITY_SIZE + (i))]=s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[u],(s__SlotChanger_MAP[(((this)) * CONFIG_ABILITY_SIZE + ((i)))])) // INLINED!!
				set i=i + 1
			endloop
			set i=0
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				call SaveInteger(Hash___D, (((s__Unit_prototype_ability_data[u]))), ((i ) ), ( ( s__SlotChanger_ABILITY_TEMP[((this) * CONFIG_ABILITY_SIZE + (i))]))) // INLINED!!
				set i=i + 1
			endloop
			set EVT_UI_REFRESH_PLAYER=(Player((this))) // INLINED!!
			call s__Event_activate(ENUM_EVENT_ABILITY_UI_REFRESH)
			set EVT_UI_REFRESH_PLAYER=null
			// call UI(GetPlayerId(.owner)).refreshAbilityIconsTarget()
			// call stateDefault()
  endfunction

  function s__SlotChanger_switch takes integer this returns nothing
			call s__SlotChanger_visibleForPlayer(this,not s__SlotChanger_visible_flag[this])
  endfunction

  function s__SlotChanger_widgetPress takes integer this,integer i returns nothing
			if i < 0 then
				return
			endif
			if s__SlotChanger_state[this] == 0 or s__SlotChanger_state[this] == 2 then
				if s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[(s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))])],(s__SlotChanger_MAP[(((this)) * CONFIG_ABILITY_SIZE + ((i)))])) <= 0 then // INLINED!!
					return
				endif
				call s__SlotChanger_stateSelectFirst(this,i)
				return
			elseif s__SlotChanger_state[this] == 1 then
				
				
				call s__SlotChanger_stateEdited(this,i)
				return
			endif
  endfunction

  function s__SlotChanger_act takes nothing returns nothing
   local integer this= 0
   local player p= GetTriggerPlayer()
   local integer i= 0
			if (udg_EVENT_VALUE) == ENUM_EVENT_KEYPRESS then // INLINED!!
				set this=GetPlayerId(EVT_KEYPRESS_PLAYER)
				if EVT_KEYPRESS_KEY == UDG_MENU_HOTKEY[ENUM_MENU_SLOT_CHANGER] and EVT_KEYPRESS_PRESS then
					if s__SlotChanger_state[this] == 2 and s__SlotChanger_visible_flag[this] then
						call s__SlotChanger_confirm(this)
					endif
					call s__SlotChanger_switch(this)
					return
				endif
				return
			endif
			set this=GetPlayerId(p)
			if BlzGetTriggerFrame() != null then
				if BlzGetTriggerFrameEvent() != FRAMEEVENT_CONTROL_CLICK then
					return
				endif
				
				if GetLocalPlayer() == p then
          call PlaySoundBJ(gg_snd_BigButtonClick)
        endif
				if BlzGetTriggerFrame() == s__SlotChanger_CLOSE_BUTTON then
					call s__SlotChanger_close(this)
					return
				endif
				if BlzGetTriggerFrame() == s__SlotChanger_CONFIRM_BUTTON then
					call s__SlotChanger_confirm(this)
					call s__SlotChanger_close(this)
					return
				endif
				loop
					exitwhen i >= 10
					if BlzGetTriggerFrame() == s__SlotChanger_BUTTON[i] then
						call s__SlotChanger_widgetPress(this,i)
						return
					endif
					set i=i + 1
				endloop
				return
			endif
  endfunction

		
  function s__SlotChanger_keypressCallback takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if this != GetPlayerId(EVT_KEYPRESS_PLAYER) then
				return
			endif
			if s__User_oskey2Index(EVT_KEYPRESS_KEY) <= CONFIG_ABILITY_SIZE and EVT_KEYPRESS_PRESS then
				call s__SlotChanger_widgetPress(this,s__User_oskey2Index(EVT_KEYPRESS_KEY))
				return
			endif
			return
  endfunction

		
  function s__SlotChanger_inputLayerChangeCallback takes nothing returns nothing
   local integer this= GetPlayerId(EVT_INPUT_LAYER_CHANGE_PLAYER)
			if this >= CONFIG_PLAYER_MAX then
				return
			endif
			if EVT_INPUT_LAYER_CHANGE_LAYER > CONFIG_INPUT_LAYER_SLOT_CHANGER and s__SlotChanger_visible_flag[this] then
				call DisableTrigger(GetTriggeringTrigger())
				call s__SlotChanger_visibleForPlayer(this,false)
				call EnableTrigger(GetTriggeringTrigger())
			endif
  endfunction

  function s__SlotChanger_menuButtonCallback takes nothing returns nothing
   local integer this= GetPlayerId(GetTriggerPlayer())
			if this >= CONFIG_PLAYER_MAX then
				return
			endif
			call s__SlotChanger_switch(this)
  endfunction

  function s__SlotChanger_initFrames takes nothing returns nothing
   local integer i= 0
   local integer buttonsTotalWidth= s__SlotChanger_P_BUTTON_SIZE * 10 + s__SlotChanger_P_BUTTON_GAP * 9
   local integer buttonX= 0
   local integer buttonY= 0
   local framehandle f= null
   local trigger t= CreateTrigger()
			
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				
				set f=BlzCreateSimpleFrame("CSlotChangerButton", FRAME_SLOT_CHANGER, i)
				set buttonX=( - buttonsTotalWidth / 2 ) + ( s__SlotChanger_P_BUTTON_SIZE * i ) + ( s__SlotChanger_P_BUTTON_GAP * i )
				set buttonY=s__SlotChanger_P_BUTTON_OFFSET_Y
				call BlzFrameSetPoint((f ), ( FRAMEPOINT_TOPLEFT ), ( FRAME_SLOT_CHANGER ), ( FRAMEPOINT_BOTTOM ), (( buttonX )*1.0) / 1800., (( buttonY + s__SlotChanger_P_BUTTON_SIZE)*1.0) / 1800.) // INLINED!!
				call BlzFrameSetPoint((f ), ( FRAMEPOINT_BOTTOMRIGHT ), ( FRAME_SLOT_CHANGER ), ( FRAMEPOINT_BOTTOM ), (( buttonX + s__SlotChanger_P_BUTTON_SIZE )*1.0) / 1800., (( buttonY)*1.0) / 1800.) // INLINED!!
				call BlzTriggerRegisterFrameEvent(t, f, FRAMEEVENT_CONTROL_CLICK)
				set s__SlotChanger_BUTTON[i]=f
				
				set f=BlzGetFrameByName("CSlotChangerButtonHotkeyText", i)
				call BlzFrameSetText(f, "|cffffcc00" + UDG_ABILITY_SLOT_NAME[i] + "|r")
				set i=i + 1
			endloop
			
			set s__SlotChanger_CONFIRM_BUTTON=BlzGetFrameByName("CSlotChangerConfirmButton", 0)
			call BlzTriggerRegisterFrameEvent(t, s__SlotChanger_CONFIRM_BUTTON, FRAMEEVENT_CONTROL_CLICK)
			set s__SlotChanger_CONFIRM_BUTTON_TEXT=BlzGetFrameByName("CSlotChangerConfirmButtonText", 0)
			call BlzFrameSetText(s__SlotChanger_CONFIRM_BUTTON_TEXT, "|cff999999적용|r")
			call BlzFrameSetEnable(s__SlotChanger_CONFIRM_BUTTON, false)
			
			set s__SlotChanger_CLOSE_BUTTON=BlzGetFrameByName("CSlotChangerCloseButton", 0)
			call BlzTriggerRegisterFrameEvent(t, s__SlotChanger_CLOSE_BUTTON, FRAMEEVENT_CONTROL_CLICK)
			call TriggerAddCondition(t, Condition(function s__SlotChanger_act))
			
			
			set t=CreateTrigger()
			call BlzTriggerRegisterFrameEvent(t, BlzGetFrameByName("CSlotChangerMenuButton", 0), FRAMEEVENT_CONTROL_CLICK)
			call TriggerAddCondition(t, Condition(function s__SlotChanger_menuButtonCallback))
			
			set f=null
			set t=null
  endfunction

  function s__SlotChanger_create takes player p returns integer
   local integer this= GetPlayerId(p)
   local framehandle f= null
   local integer i= 0
			set s__SlotChanger_state[this]=0
			set s__SlotChanger_first_index[this]=- 1
			set s__SlotChanger_visible_flag[this]=false
			loop
				exitwhen i >= 10
				set s__SlotChanger_MAP[(((this)) * CONFIG_ABILITY_SIZE + ((i )))]=( i) // INLINED!!
				set i=i + 1
			endloop
			
			if not s__SlotChanger_ACTIVATED then
				call s__SlotChanger_initFrames()
				set s__SlotChanger_ACTIVATED=true
			endif
			
			set s__SlotChanger_keypress_trigger[this]=s__Trigger_new(this)
			call TriggerRegisterVariableEvent((s__SlotChanger_keypress_trigger[this] ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_KEYPRESS)*1.0)) // INLINED!!
			call TriggerAddCondition(s__SlotChanger_keypress_trigger[this], Condition(function s__SlotChanger_keypressCallback))
			call DisableTrigger(s__SlotChanger_keypress_trigger[this])
			
			set f=null
			return this
  endfunction

  function s__SlotChanger_destroy takes integer this returns nothing
			call DestroyTrigger(s__SlotChanger_keypress_trigger[this])
  endfunction

  function s__SlotChanger_onInit takes nothing returns nothing
   local trigger t= CreateTrigger()
			
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_KEYPRESS)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__SlotChanger_act))
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_INPUT_LAYER_CHANGE)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__SlotChanger_inputLayerChangeCallback))
			
			set t=null
  endfunction



