				set BUFF_CREATE_INDIVISUAL=Buff10y0_INDIVISUAL
				set BUFF_CREATE_POSITIVE=Buff10y0_POSITIVE
				set BUFF_CREATE_ICON_PATH=Buff10y0_ICON_PATH
				set BUFF_CREATE_DISPLAY=Buff10y0_DISPLAY
			endfunction

   function Buff10y0__init takes nothing returns nothing
				
    local trigger t= CreateTrigger()
				call TriggerAddCondition(t, Condition(function Buff10y0__cond))
				call SaveTriggerHandle(BUFF_CREATE_HASH, Buff10y0_ID, BUFF_HASH_INDEX_TRIGGER, t)
				
				set t=CreateTrigger()
				call TriggerAddCondition(t, Condition(function Buff10y0__setFlag))
				call SaveTriggerHandle(BUFF_CREATE_HASH, Buff10y0_ID, BUFF_HASH_INDEX_TRIGGER + 1, t)
				
				call SaveStr(BUFF_CREATE_HASH, Buff10y0_ID, BUFF_HASH_INDEX_ICON_PATH, Buff10y0_ICON_PATH)
				














				










				set t=null
			endfunction

