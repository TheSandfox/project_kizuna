   function BuffPadt___init takes nothing returns nothing
				
    local trigger t= CreateTrigger()
				call TriggerAddCondition(t, Condition(function BuffPadt___cond))
				call SaveTriggerHandle(BUFF_CREATE_HASH, BuffPadt_ID, BUFF_HASH_INDEX_TRIGGER, t)
				
				set t=CreateTrigger()
				call TriggerAddCondition(t, Condition(function BuffPadt___setFlag))
				call SaveTriggerHandle(BUFF_CREATE_HASH, BuffPadt_ID, BUFF_HASH_INDEX_TRIGGER + 1, t)
				
