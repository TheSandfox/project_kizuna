  function s__UI_owner takes integer this returns player
			return Player(this)
  endfunction

  function s__UI_displayError takes integer this returns nothing
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetText(s__UI_ABILITY_ERROR, CUSTOM_RESPOND_ERROR_MESSAGE)
				call PlaySoundBJ(gg_snd_Error)
			endif
			if CUSTOM_RESPOND_ERROR_TIME <= 0. then
				set s__UI_ability_error_lifespan[this]=2.0
			else
				set s__UI_ability_error_lifespan[this]=CUSTOM_RESPOND_ERROR_TIME
			endif
  endfunction

  function s__UI_errorCondition takes nothing returns nothing
   local integer this= GetPlayerId(CUSTOM_RESPOND_ERROR_PLAYER)
			call s__UI_displayError(this)
  endfunction

  function s__UI_refreshName takes integer this returns nothing
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(s__UI_NAME, s__UI_target[this] > 0)
				call BlzFrameSetText(s__UI_NAME, s__Unit_prototype_origin_name[s__UI_target[this]])
			endif
  endfunction

