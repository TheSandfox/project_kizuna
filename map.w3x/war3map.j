   local integer rand= 0
			
			if s__BossB000_phase[this] < 2 and not s__BossB000_divide[this] and ( (s__Unit_prototype_hp_true[(this)]) / (s__Unit_prototype_maxhp_true[(this)]) ) <= 0.33 * ( 2 - s__BossB000_phase[this] ) then // INLINED!!
