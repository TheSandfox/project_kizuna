			call BlzFrameSetVisible(s__ItemTooltip_container[this], flag)
  endfunction

  function s__ItemTooltip_create takes integer index returns integer
   local integer this= index
			set s__ItemTooltip_container[this]=BlzCreateFrameByType("FRAME", "", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_TOOLTIP], "", 0)
			set s__ItemTooltip_backdrop_outline[this]=BlzCreateFrameByType("BACKDROP", "", s__ItemTooltip_container[this], "", 0)
			call BlzFrameSetTexture(s__ItemTooltip_backdrop_outline[this], "replaceabletextures\\teamcolor\\teamcolor16.blp", 0, true)
			set s__ItemTooltip_backdrop_box[this]=BlzCreateFrameByType("BACKDROP", "", s__ItemTooltip_container[this], "", 0)
			call BlzFrameSetTexture(s__ItemTooltip_backdrop_box[this], "replaceabletextures\\teamcolor\\teamcolor24.blp", 0, true)
			set s__ItemTooltip_text[this]=BlzCreateFrame("MyItemTooltip", s__ItemTooltip_container[this], 0, 0)
			call BlzFrameSetTextAlignment(s__ItemTooltip_text[this], TEXT_JUSTIFY_BOTTOM, TEXT_JUSTIFY_LEFT)
			call BlzFrameSetPoint(s__ItemTooltip_text[this], FRAMEPOINT_BOTTOM, FRAME_ORIGIN, FRAMEPOINT_BOTTOM, 0., 0.)
			//
			call BlzFrameSetPoint(s__ItemTooltip_backdrop_outline[this], FRAMEPOINT_BOTTOMLEFT, s__ItemTooltip_text[this], FRAMEPOINT_BOTTOMLEFT, - .005, - .005)
			call BlzFrameSetPoint(s__ItemTooltip_backdrop_outline[this], FRAMEPOINT_TOPRIGHT, s__ItemTooltip_text[this], FRAMEPOINT_TOPRIGHT, .005, .005)
			call BlzFrameSetPoint(s__ItemTooltip_backdrop_box[this], FRAMEPOINT_BOTTOMLEFT, s__ItemTooltip_text[this], FRAMEPOINT_BOTTOMLEFT, - .004, - .004)
			call BlzFrameSetPoint(s__ItemTooltip_backdrop_box[this], FRAMEPOINT_TOPRIGHT, s__ItemTooltip_text[this], FRAMEPOINT_TOPRIGHT, .004, .004)
			call BlzFrameSetVisible(s__ItemTooltip_container[this], false)
			return this
  endfunction

