				if Ability20i0__MY_RESPOND_ABILITY > 0 then
					set Ability20i0__MY_RESPOND_EVENT_ID=1
					set Ability20i0__MY_RESPOND_TOWER=this
					call DisableTrigger(s__Trigger_main_trigger[s__Ability20i0__mytower_main_trigger[this]])
					call TriggerEvaluate(Ability20i0__MY_RESPOND)
				endif
