//Generated destructor of ExtraAbilityIcon
function s__ExtraAbilityIcon_deallocate takes integer this returns nothing
    if this==null then
        return
    elseif (si__ExtraAbilityIcon_V[this]!=-1) then
        return
    endif
    call s__ExtraAbilityIcon_onDestroy(this)
    set si__ExtraAbilityIcon_V[this]=si__ExtraAbilityIcon_F
    set si__ExtraAbilityIcon_F=this
endfunction

  function s__ExtraAbilityIcon_onInit takes nothing returns nothing
   local integer i= 0
			loop
				exitwhen i >= CONFIG_PLAYER_MAX
				
				set s__s__ExtraAbilityIcon_ICONS[i]= s__ArrayList_create()
				
				set s__s__ExtraAbilityIcon_TIMERS[i]= s__Timer_new(i)
				
				set s__s__ExtraAbilityIcon_COUNTER[i]= 0
				set i=i + 1
			endloop
  endfunction



