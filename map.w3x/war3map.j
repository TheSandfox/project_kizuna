  endfunction

  function s__Item_prototype_onUnequip takes integer this returns nothing

  endfunction

  function s__Item_prototype_equip takes integer this,integer owner returns integer
   local integer i= 0
			if owner == s__Item_prototype_owner[this] then
				
				return ERROR_CODE_ALREADY_EQUIPPED
			endif
			set i=sc__Unit_prototype_getItemSpace(owner)
			if i < 0 or i >= CONFIG_UNIT_INVENTORY_SIZE then
				
				return ERROR_CODE_NO_SPACE
			endif
			set s__Item_prototype_owner[this]=owner
			call sc__UnitPrototype__ItemData_setItem(s__Unit_prototype_item_data[s__Item_prototype_owner[this]],i , this)
			call sc__Item_prototype_onEquip(this)
			return 1
  endfunction

  function s__Item_prototype_unequip takes integer this returns nothing
			if s__Item_prototype_owner[this] > 0 then
				call sc__Item_prototype_onUnequip(this)
				call sc__UnitPrototype__ItemData_setItem(s__Unit_prototype_item_data[s__Item_prototype_owner[this]],(s__ItemAddress_z[((this))]) , 0) // INLINED!!
			endif
			set s__Item_prototype_owner[this]=0
  endfunction

