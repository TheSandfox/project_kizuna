  function s__Inventory_prototype_onInit takes nothing returns nothing
   local integer i= 0
			loop
				exitwhen i >= CONFIG_PLAYER_MAX
				set s__Inventory_prototype_DISABLE_DROP[i]=0
				set i=i + 1
			endloop
  endfunction






  function s__InventoryIcon_showTooltip takes integer this returns nothing
			if s__InventoryIcon_target[this] > 0 then
				set s__InventoryIcon_tooltip[this]=s__Item_tooltip[s__InventoryIcon_target[this]]
				if GetLocalPlayer() == s__InventoryIcon_owner[this] and s__InventoryIcon_tooltip[this] > 0 then
					call s__ItemTooltip_setPoint(s__InventoryIcon_tooltip[this],Inventory___INVENTORY_ICON_BTN[s__InventoryIcon_index[this]] , FRAMEPOINT_BOTTOMLEFT , 0. , 0.)
					call s__Item_showTooltip(s__InventoryIcon_target[this])
				endif
			endif
  endfunction

  function s__InventoryIcon_hideTooltip takes integer this returns nothing
			if s__InventoryIcon_tooltip[this] > 0 then
				if GetLocalPlayer() == s__InventoryIcon_owner[this] then
					call BlzFrameSetVisible(s__ItemTooltip_container[(s__InventoryIcon_tooltip[this])], (false)) // INLINED!!
				endif
			endif
  endfunction

  function s__InventoryIcon_setTarget takes integer this,integer target returns nothing
   local string s= ""
			if GetLocalPlayer() == s__InventoryIcon_owner[this] then
				call BlzFrameSetVisible(Inventory___INVENTORY_ICON_TIER_BORDER[s__InventoryIcon_index[this]], false)
				call BlzFrameSetVisible(Inventory___INVENTORY_ICON_EXTRA_BACKDROP[s__InventoryIcon_index[this]], false)
				call BlzFrameSetVisible(Inventory___INVENTORY_ICON_EXTRA_TEXT[s__InventoryIcon_index[this]], false)
			endif
			if target <= 0 then
				if GetLocalPlayer() == s__InventoryIcon_owner[this] then
					call BlzFrameSetTexture(Inventory___INVENTORY_ICON_ICON[s__InventoryIcon_index[this]], "icons\\btnblackicon.blp", 0, true)
					call BlzFrameSetAlpha(Inventory___INVENTORY_ICON_ICON[s__InventoryIcon_index[this]], 64)
				endif
				
				set s__InventoryIcon_in[this]=false
				if GetLocalPlayer() == s__InventoryIcon_owner[this] then
					call BlzFrameSetVisible(Inventory___INVENTORY_ICON_BTN[s__InventoryIcon_index[this]], false)
				endif
				call DisableTrigger(s__InventoryIcon_main_trigger[this])
				call s__InventoryIcon_hideTooltip(this)
			else
				
				if GetLocalPlayer() == s__InventoryIcon_owner[this] then
					call BlzFrameSetTexture(Inventory___INVENTORY_ICON_ICON[s__InventoryIcon_index[this]], sc__Item_getIconPath(target), 0, true)
					call BlzFrameSetAlpha(Inventory___INVENTORY_ICON_ICON[s__InventoryIcon_index[this]], 255)
					call BlzFrameSetVisible(Inventory___INVENTORY_ICON_TIER_BORDER[s__InventoryIcon_index[this]], true)
					call BlzFrameSetTexture(Inventory___INVENTORY_ICON_TIER_BORDER[s__InventoryIcon_index[this]], "Textures\\ability_border_tier" + I2S(sc__Item_prototype_getTier(target)) + ".blp", 0, true)
				endif
				set s__InventoryIcon_tooltip[this]=s__Item_tooltip[target]
				
				set s=("lv" + I2S(s__AbilityShard_level[((target))])) // INLINED!!
				if s != "" and GetLocalPlayer() == s__InventoryIcon_owner[this] then
					call BlzFrameSetVisible(Inventory___INVENTORY_ICON_EXTRA_BACKDROP[s__InventoryIcon_index[this]], true)
					call BlzFrameSetVisible(Inventory___INVENTORY_ICON_EXTRA_TEXT[s__InventoryIcon_index[this]], true)
					call BlzFrameSetText(Inventory___INVENTORY_ICON_EXTRA_TEXT[s__InventoryIcon_index[this]], s)
				endif
				
				if GetLocalPlayer() == s__InventoryIcon_owner[this] then
					call BlzFrameSetVisible(Inventory___INVENTORY_ICON_BTN[s__InventoryIcon_index[this]], true)
				endif
				call EnableTrigger(s__InventoryIcon_main_trigger[this])
			endif
			set s__InventoryIcon_target[this]=target
  endfunction

  function s__InventoryIcon_cond takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if GetTriggerPlayer() != s__InventoryIcon_owner[this] then
				return
			endif
			if BlzGetTriggerFrameEvent() == FRAMEEVENT_MOUSE_ENTER then
				call s__InventoryIcon_showTooltip(this)
				set s__InventoryIcon_in[this]=true
				return
			elseif BlzGetTriggerFrameEvent() == FRAMEEVENT_MOUSE_LEAVE then
				call BlzFrameResetFocus(BlzGetTriggerFrame() , s__InventoryIcon_owner[this])
				call s__InventoryIcon_hideTooltip(this)
				set s__InventoryIcon_in[this]=false
				return
			elseif BlzGetTriggerFrameEvent() == FRAMEEVENT_CONTROL_CLICK then
				call BlzFrameResetFocus(BlzGetTriggerFrame() , s__InventoryIcon_owner[this])
				set INVENTORY_CLICK_INDEX=s__InventoryIcon_index[this]
				set INVENTORY_CLICK_PLAYER=s__InventoryIcon_owner[this]
				set INVENTORY_CLICK_BUTTON=0
				call TriggerEvaluate(INVENTORY_CLICK_TRIGGER)
				return
			elseif s__InventoryIcon_in[this] and BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_RIGHT then
				if s__InventoryIcon_target[this] > 0 then
					
					if (LoadBoolean(s__User_HASH, GetPlayerId((s__InventoryIcon_owner[this] )), GetHandleId(( OSKEY_LSHIFT)))) then // INLINED!!
						if s__Item_prototype_count[s__InventoryIcon_target[this]] > 1 then
							call s__Numberpad_open((GetPlayerId(s__InventoryIcon_owner[this])),"INV_DIV#" + I2S(s__InventoryIcon_target[this]))
							call s__Numberpad_setPoint((GetPlayerId(s__InventoryIcon_owner[this])),FRAMEPOINT_RIGHT , Inventory___INVENTORY_ICON_ICON[s__InventoryIcon_index[this]] , FRAMEPOINT_RIGHT , 0. , 0.)
							call s__Numberpad_setInitialValue((GetPlayerId(s__InventoryIcon_owner[this])),"1")
						endif
						return
					
					elseif (LoadBoolean(s__User_HASH, GetPlayerId((s__InventoryIcon_owner[this] )), GetHandleId(( OSKEY_LCONTROL)))) then // INLINED!!
						if s__Inventory_prototype_DISABLE_DROP[GetPlayerId(s__InventoryIcon_owner[this])] <= 0 then
							
							call s__Numberpad_customSummit(s__InventoryIcon_owner[this] , "INV_DROP" , I2S(s__InventoryIcon_index[this]))
						endif
						return
					
					else
						set INVENTORY_CLICK_INDEX=s__InventoryIcon_index[this]
						set INVENTORY_CLICK_PLAYER=s__InventoryIcon_owner[this]
						set INVENTORY_CLICK_BUTTON=1
						call TriggerEvaluate(INVENTORY_CLICK_TRIGGER)
						return
					endif
					return
				endif
			endif
  endfunction

  function s__InventoryIcon_create takes player owner,integer index returns integer
   local integer this= GetPlayerId(owner) * Inventory_SLOT + index
			set s__InventoryIcon_index[this]=index
			set s__InventoryIcon_owner[this]=owner
			set s__InventoryIcon_target[this]=- 1
			set s__InventoryIcon_in[this]=false
			set s__InventoryIcon_main_trigger[this]=s__Trigger_new(this)
			set s__InventoryIcon_main_cond[this]=TriggerAddCondition(s__InventoryIcon_main_trigger[this], Condition(function s__InventoryIcon_cond))
			call BlzTriggerRegisterFrameEvent(s__InventoryIcon_main_trigger[this], Inventory___INVENTORY_ICON_BTN[s__InventoryIcon_index[this]], FRAMEEVENT_MOUSE_ENTER)
			call BlzTriggerRegisterFrameEvent(s__InventoryIcon_main_trigger[this], Inventory___INVENTORY_ICON_BTN[s__InventoryIcon_index[this]], FRAMEEVENT_MOUSE_LEAVE)
			call BlzTriggerRegisterFrameEvent(s__InventoryIcon_main_trigger[this], Inventory___INVENTORY_ICON_BTN[s__InventoryIcon_index[this]], FRAMEEVENT_CONTROL_CLICK)
			call TriggerRegisterPlayerEvent(s__InventoryIcon_main_trigger[this], s__InventoryIcon_owner[this], EVENT_PLAYER_MOUSE_DOWN)
			//
			call s__InventoryIcon_setTarget(this,0)
			return this
  endfunction

  function s__InventoryIcon_destroy takes integer this returns nothing
//textmacro instance: destroyTriggerAndCondition(".main_trigger",".main_cond")
		call TriggerRemoveCondition(s__InventoryIcon_main_trigger[this], s__InventoryIcon_main_cond[this])
		call s__Trigger_remove(s__InventoryIcon_main_trigger[this])
		set s__InventoryIcon_main_trigger[this]=null
		set s__InventoryIcon_main_cond[this]=null
//end of: destroyTriggerAndCondition(".main_trigger",".main_cond")
			set s__InventoryIcon_owner[this]=null
  endfunction





