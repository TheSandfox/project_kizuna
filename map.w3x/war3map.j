//library Damage:

	
		

  function s__DamageFlag_get takes integer id,integer index returns integer
			return LoadInteger(Damage__HASH, id, index)
  endfunction

  function s__DamageFlag_def takes integer id,integer index,integer val returns nothing
			call SaveInteger(Damage__HASH, id, index, val)
  endfunction




  function s__DamageTag_add takes integer id,integer tag returns nothing
   local integer i= 0
			loop
				if not HaveSavedInteger(Damage__HASH, id, s__DamageTag_INDEX_DAMAGE_TAGS + i) then
					call SaveInteger(Damage__HASH, id, s__DamageTag_INDEX_DAMAGE_TAGS + i, tag)
					exitwhen true
				endif
				set i=i + 1
			endloop
  endfunction

  function s__DamageTag_get takes integer id,integer index returns integer
			if HaveSavedInteger(Damage__HASH, id, s__DamageTag_INDEX_DAMAGE_TAGS + index) then
				return LoadInteger(Damage__HASH, id, s__DamageTag_INDEX_DAMAGE_TAGS + index)
			else
				return - 1
			endif
  endfunction

  function s__DamageTag_includes takes integer id,integer tag returns boolean
   local integer i= 0
			loop
				if HaveSavedInteger(Damage__HASH, id, s__DamageTag_INDEX_DAMAGE_TAGS + i) then
					if LoadInteger(Damage__HASH, id, s__DamageTag_INDEX_DAMAGE_TAGS + i) == tag then
						return true
					endif
				else
					return false
				endif
				set i=i + 1
			endloop
			return false
  endfunction



		
	
	





  function s__Damage_setFlag takes integer damage,integer attack,integer target,integer aoe,integer interval,integer vector,integer onhit,integer ranged returns nothing
			set CUSTOM_RESPOND_DAMAGE_DAMAGE_TYPE=damage
			set CUSTOM_RESPOND_DAMAGE_ATTACK_TYPE=attack
			set CUSTOM_RESPOND_DAMAGE_INTERVAL_TYPE=interval
			set CUSTOM_RESPOND_DAMAGE_VECTOR_TYPE=vector
			set CUSTOM_RESPOND_DAMAGE_TARGET_TYPE=target
			set CUSTOM_RESPOND_DAMAGE_AOE_TYPE=aoe
			set CUSTOM_RESPOND_DAMAGE_ONHIT_TYPE=onhit
			set CUSTOM_RESPOND_DAMAGE_RANGE_TYPE=ranged
  endfunction
		
  function s__Damage_clearFlag takes nothing returns nothing
			set CUSTOM_RESPOND_DAMAGE_ATTACK_TYPE=s__Damage_ATTACK_TYPE_BASIC
			set CUSTOM_RESPOND_DAMAGE_DAMAGE_TYPE=s__Damage_DAMAGE_TYPE_PHYSICAL
			set CUSTOM_RESPOND_DAMAGE_INTERVAL_TYPE=s__Damage_INTERVAL_TYPE_SINGLE
			set CUSTOM_RESPOND_DAMAGE_VECTOR_TYPE=s__Damage_VECTOR_TYPE_OUTTER
			set CUSTOM_RESPOND_DAMAGE_TARGET_TYPE=s__Damage_TARGET_TYPE_TARGET
			set CUSTOM_RESPOND_DAMAGE_AOE_TYPE=s__Damage_AOE_TYPE_NONAOE
			set CUSTOM_RESPOND_DAMAGE_ONHIT_TYPE=s__Damage_ONHIT_TYPE_NONHIT
			set CUSTOM_RESPOND_DAMAGE_RANGE_TYPE=s__Damage_RANGE_TYPE_RANGED
			set CUSTOM_RESPOND_DAMAGE_USE_POSITION=false
			
			set CUSTOM_RESPOND_DAMAGE_ATTACKER=0
			set CUSTOM_RESPOND_DAMAGE_TARGET=0
			set CUSTOM_RESPOND_DAMAGE_LAST=0.
			set CUSTOM_RESPOND_DAMAGE_AMOUNT=0.
			set CUSTOM_RESPOND_DAMAGE_PLUS=0.
			set CUSTOM_RESPOND_DAMAGE_MULTIPLY=1.
			set CUSTOM_RESPOND_DAMAGE_DIVIDE=1.
			set CUSTOM_RESPOND_DAMAGE_MINUS=0.
			set CUSTOM_RESPOND_DAMAGE_ID=0
  endfunction

  function s__Damage_unitDamageTarget takes integer attacker,integer target,real damage,weapontype wt returns real
   local real armor= 0.
			set CUSTOM_RESPOND_DAMAGE_ABSORBED=0.
			set CUSTOM_RESPOND_DAMAGE_HP_REDUCED=0.
			set CUSTOM_RESPOND_DAMAGE_AMOUNT=damage
			set CUSTOM_RESPOND_DAMAGE_ATTACKER=attacker
			set CUSTOM_RESPOND_DAMAGE_TARGET=target
			set CUSTOM_RESPOND_DAMAGE_LOWBOUND=( 75 + sc__Unit_prototype__get_accuracy(attacker) ) / ( 100 + sc__Unit_prototype__get_evasion(target) )
			
			if sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[target],CONFIG_STATUS_DEAD) > 0 or attacker <= 0 or target <= 0 then
				return 0.
			endif
			
			if sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[target],CONFIG_STATUS_EVASION) > 0 then
				if CUSTOM_RESPOND_DAMAGE_VECTOR_TYPE != s__Damage_VECTOR_TYPE_INNER then
					return 0.
				endif
			endif
			
			if CUSTOM_RESPOND_DAMAGE_USE_POSITION then
				
			else
				
				set CUSTOM_RESPOND_DAMAGE_X=sc__Object__get_x(attacker)
				set CUSTOM_RESPOND_DAMAGE_Y=sc__Object__get_y(attacker)
			endif
			
			if CUSTOM_RESPOND_DAMAGE_LOWBOUND > 1. then
				set CUSTOM_RESPOND_DAMAGE_LOWBOUND=GetRandomReal(1.0, CUSTOM_RESPOND_DAMAGE_LOWBOUND)
			else
				set CUSTOM_RESPOND_DAMAGE_LOWBOUND=GetRandomReal(CUSTOM_RESPOND_DAMAGE_LOWBOUND, 1.0)
			endif
			if CUSTOM_RESPOND_DAMAGE_ID == 0 then
				call BJDebugMsg("대미지 ID가 정의되지 않았습니다.")
			endif
			
			if CUSTOM_RESPOND_DAMAGE_ATTACK_TYPE == s__Damage_ATTACK_TYPE_BASIC then
				if sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[attacker],CONFIG_STATUS_BLIND) > 0 then
					call s__Damage_clearFlag()
					return 0.
				endif
			endif
			
			call sc__Event_activate(CONFIG_EVENT_DAMAGE_MODIFY_STAT)
			
			set CUSTOM_RESPOND_DAMAGE_PLUS=0.
			set CUSTOM_RESPOND_DAMAGE_MULTIPLY=1.
			set CUSTOM_RESPOND_DAMAGE_DIVIDE=1.
			set CUSTOM_RESPOND_DAMAGE_MINUS=0.
			
			call sc__Event_activate(CONFIG_EVENT_DAMAGE_MODIFY)
			
			set CUSTOM_RESPOND_DAMAGE_AMOUNT=( ( ( CUSTOM_RESPOND_DAMAGE_AMOUNT + CUSTOM_RESPOND_DAMAGE_PLUS ) * CUSTOM_RESPOND_DAMAGE_MULTIPLY ) / CUSTOM_RESPOND_DAMAGE_DIVIDE ) - CUSTOM_RESPOND_DAMAGE_MINUS
			if CUSTOM_RESPOND_DAMAGE_AMOUNT < 0. then
				set CUSTOM_RESPOND_DAMAGE_AMOUNT=0.
			endif
			
			set CUSTOM_RESPOND_DAMAGE_AMOUNT=CUSTOM_RESPOND_DAMAGE_AMOUNT * s__Unit_prototype_damage_give[attacker] * s__Unit_prototype_damage_take[target]
			if CUSTOM_RESPOND_DAMAGE_DAMAGE_TYPE == s__Damage_DAMAGE_TYPE_TRUE then
				
			else
				if CUSTOM_RESPOND_DAMAGE_DAMAGE_TYPE == s__Damage_DAMAGE_TYPE_PHYSICAL then
					set armor=sc__Unit_prototype_getCarculatedStatValue(target,CONFIG_STAT_DEFENSE) - sc__Unit_prototype_getCarculatedStatValue(attacker,CONFIG_STAT_ARMOR_PENET)
				elseif CUSTOM_RESPOND_DAMAGE_DAMAGE_TYPE == s__Damage_DAMAGE_TYPE_MAGICAL then
					set armor=sc__Unit_prototype_getCarculatedStatValue(target,CONFIG_STAT_RESISTANCE) - sc__Unit_prototype_getCarculatedStatValue(attacker,CONFIG_STAT_MAGIC_PENET)
				endif
				
				if armor >= 0. then
					set CUSTOM_RESPOND_DAMAGE_AMOUNT=CUSTOM_RESPOND_DAMAGE_AMOUNT * 100. / ( 100. + armor )
				else
					set CUSTOM_RESPOND_DAMAGE_AMOUNT=CUSTOM_RESPOND_DAMAGE_AMOUNT * 1. - ( armor * 0.01 )
				endif
				
				set CUSTOM_RESPOND_DAMAGE_AMOUNT=CUSTOM_RESPOND_DAMAGE_AMOUNT * CUSTOM_RESPOND_DAMAGE_LOWBOUND
			endif
			
			call sc__Event_activate(CONFIG_EVENT_DAMAGE_LAST)
			
			
			call UnitDamageTarget(s__Unit_prototype_origin_unit[attacker], s__Unit_prototype_origin_unit[target], 0., false, true, ATTACK_TYPE_HERO, DAMAGE_TYPE_MAGIC, wt)
			
			call sc__Event_activate(CONFIG_EVENT_DAMAGE_BEFORE_HPREDUCE)
			
			call sc__ShieldDamage_adjust((target))
			
			if CUSTOM_RESPOND_DAMAGE_AMOUNT >= (s__Unit_prototype_hp_true[(target)]) then // INLINED!!
				set CUSTOM_RESPOND_DAMAGE_HP_REDUCED=(s__Unit_prototype_hp_true[(target)]) // INLINED!!
			else
				set CUSTOM_RESPOND_DAMAGE_HP_REDUCED=CUSTOM_RESPOND_DAMAGE_AMOUNT
			endif
			set CUSTOM_RESPOND_DEATH_KILLER=attacker
			call sc__Unit_prototype__set_hp(target,(s__Unit_prototype_hp_true[(target)]) - CUSTOM_RESPOND_DAMAGE_AMOUNT) // INLINED!!
			set CUSTOM_RESPOND_DAMAGE_LAST=CUSTOM_RESPOND_DAMAGE_HP_REDUCED
			if CUSTOM_RESPOND_DAMAGE_DAMAGE_TYPE == s__Damage_DAMAGE_TYPE_PHYSICAL then
				call sc__InstantText_setColor(255 , 153 , 0)
			elseif CUSTOM_RESPOND_DAMAGE_DAMAGE_TYPE == s__Damage_DAMAGE_TYPE_MAGICAL then
				call sc__InstantText_setColor(0 , 153 , 255)
			endif
			
			set s__InstantText_SIZE=10.
			set s__InstantText_VELO=0.04 + GetRandomReal(- 0.005, 0.005)
			set s__InstantText_LIFESPAN=1.5
			if CUSTOM_RESPOND_DAMAGE_AMOUNT > 0. then
				call sc__InstantText_createForBothPlayer(sc__Object__get_x(target) , sc__Object__get_y(target) , sc__Object__get_z(target) + 75 , I2S(R2I(CUSTOM_RESPOND_DAMAGE_AMOUNT)) , (GetOwningPlayer(s__Unit_prototype_origin_unit[(attacker)])) , (GetOwningPlayer(s__Unit_prototype_origin_unit[(target)]))) // INLINED!!
			endif
			set s__InstantText_SIZE=8.
			set s__InstantText_VELO=0.08 + GetRandomReal(- 0.01, 0.01)
			set s__InstantText_LIFESPAN=0.75
			if CUSTOM_RESPOND_DAMAGE_ABSORBED > 0. then
				call sc__InstantText_setColor(219 , 184 , 236)
				call sc__InstantText_createForBothPlayer(sc__Object__get_x(target) , sc__Object__get_y(target) , sc__Object__get_z(target) + 75 , "-" + I2S(R2I(CUSTOM_RESPOND_DAMAGE_ABSORBED)) , (GetOwningPlayer(s__Unit_prototype_origin_unit[(attacker)])) , (GetOwningPlayer(s__Unit_prototype_origin_unit[(target)]))) // INLINED!!
			endif
			
			call sc__Event_activate(CONFIG_EVENT_DAMAGE_AFTER_HPREDUCE)
			
			call sc__InstantText_clearFlag()
			call s__Damage_clearFlag()
			return CUSTOM_RESPOND_DAMAGE_HP_REDUCED
  endfunction

  function s__Damage_damageTarget takes integer target,real amount returns real
   local real reduced= 0.
			call s__Damage_clearFlag()
			set CUSTOM_RESPOND_DAMAGE_AMOUNT=amount
			
			if CUSTOM_RESPOND_DAMAGE_AMOUNT >= (s__Unit_prototype_hp_true[(target)]) - 0.405 then // INLINED!!
				set reduced=(s__Unit_prototype_hp_true[(target)]) // INLINED!!
			else
				set reduced=CUSTOM_RESPOND_DAMAGE_AMOUNT
			endif
			call sc__Unit_prototype__set_hp(target,(s__Unit_prototype_hp_true[(target)]) - CUSTOM_RESPOND_DAMAGE_AMOUNT) // INLINED!!
			call s__Damage_clearFlag()
			return reduced
  endfunction




