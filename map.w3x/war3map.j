    function s__PowerupItem_setEmpty takes integer this returns nothing
      set s__PowerupItem_type[this]=- 1
      set s__PowerupItem_value[this]=- 1
    endfunction

    function s__PowerupItem_setType takes integer this,integer newType returns nothing
      set s__PowerupItem_type[this]=newType
    endfunction

    function s__PowerupItem_setValue takes integer this,integer newValue returns nothing
      set s__PowerupItem_value[this]=newValue
    endfunction

    function s__PowerupItem_getType takes integer this returns integer
      return s__PowerupItem_type[this]
    endfunction

    function s__PowerupItem_getValue takes integer this returns integer
      return s__PowerupItem_value[this]
    endfunction

    function s__PowerupItem_isEmpty takes integer this returns boolean
      return s__PowerupItem_type[this] < 0
    endfunction

    
    function s__PowerupItem_apply takes integer this,integer target returns boolean
      local integer ability_create_result= 0
      if (s__PowerupItem_type[(this)] < 0) or target <= 0 then // INLINED!!
        return false
      endif
      
      if s__PowerupItem_type[this] == ENUM_POWERUP_ITEM_TYPE_ABILITY then
        
        set ability_create_result=s__Ability_prototype_addUnitAbility(target , s__PowerupItem_value[this])
        if ability_create_result < 0 then
          
          return false
        endif
      elseif s__PowerupItem_type[this] == ENUM_POWERUP_ITEM_TYPE_STAT then
        
        call s__Unit_prototype_plusBaseStatValue(target,s__PowerupItem_value[this] , CONFIG_POWERUP_STAT_AMOUNT * UDG_STAT_NORMAL_VALUE[s__PowerupItem_value[this]])
      else
      endif
      return true
    endfunction


//textmacro instance: demonicAllocateSimple("Powerup")
 function Powerup_demonicAllocate takes nothing returns integer
  local integer this=si__Powerup_F
			if ( this != 0 ) then
				set si__Powerup_F=si__Powerup_V[this]
			else
				set si__Powerup_I=si__Powerup_I + 1
				set this=si__Powerup_I
			endif
			set si__Powerup_V[this]=- 1
		return this
	endfunction
//end of: demonicAllocateSimple("Powerup")

  
    

    function s__Powerup_create takes integer ptype,integer newVal returns integer
      local integer this= Powerup_demonicAllocate()
      set s__Powerup_type[this]=ptype
      set s__Powerup_value[this]=newVal
      return this
    endfunction

    function s__Powerup_onInit takes nothing returns nothing
      set s__Powerup_P_CALLBACK=CreateTrigger()
    endfunction


  


    function s__PowerupManager_getPowerupItem takes integer this,integer index returns integer
      return (CONFIG_POWERUP_ITEM_MAX * GetPlayerId(s__PowerupManager_owner[this]) + index)
    endfunction

    function s__PowerupManager_extract takes integer this returns nothing
      local integer pu= (s__Array_getValue(s__PowerupManager_powerup_list[this],0))
      local integer i= 0
      if pu > 0 then
        call s__Array_shuffle(s__PowerupManager_random_stat_list[this])
        
        loop
          exitwhen i >= CONFIG_POWERUP_ITEM_MAX
          // call getPowerupItem(i).setType(ENUM_POWERUP_ITEM_TYPE_ABILITY)
          // call getPowerupItem(i).setValue('1000')
          if i == 1 or i == 3 then
            set s__PowerupItem_type[((CONFIG_POWERUP_ITEM_MAX * GetPlayerId(s__PowerupManager_owner[(this)]) + (i)))]=(ENUM_POWERUP_ITEM_TYPE_ABILITY) // INLINED!!
            set s__PowerupItem_value[((CONFIG_POWERUP_ITEM_MAX * GetPlayerId(s__PowerupManager_owner[(this)]) + (i)))]=('1000') // INLINED!!
          else
            set s__PowerupItem_type[((CONFIG_POWERUP_ITEM_MAX * GetPlayerId(s__PowerupManager_owner[(this)]) + (i)))]=(ENUM_POWERUP_ITEM_TYPE_STAT) // INLINED!!
            set s__PowerupItem_value[((CONFIG_POWERUP_ITEM_MAX * GetPlayerId(s__PowerupManager_owner[(this)]) + (i)))]=(s__Array_getValue(s__PowerupManager_random_stat_list[this],i)) // INLINED!!
          endif
          set i=i + 1
        endloop
      endif
    endfunction

    
    function s__PowerupManager_addPowerup takes integer this,integer pw returns nothing
      local integer focusUnit= (s__User_FOCUS_UNIT[GetPlayerId((s__PowerupManager_owner[this]))]) // INLINED!!
      call s__Array_add(s__PowerupManager_powerup_list[this],pw)
      
      if (LoadInteger(Hash___D, (((s__PowerupManager_powerup_list[this]))), (s__Array_P_SIZE))) == 1 then // INLINED!!
        
        call s__PowerupManager_extract(this)
        
        set s__InstantText_SIZE=20.
        set s__InstantText_R=255
        set s__InstantText_G=192
        set s__InstantText_B=192
        call s__InstantText_createForPlayer(sc__Object__get_x(focusUnit) , sc__Object__get_y(focusUnit) , 75 , "파워업 획득!" , s__PowerupManager_owner[this])
      endif
      
      if s__Powerup_type[pw] == ENUM_POWERUP_TYPE_LEVEL then
        call s__Effect_setDuration(s__Effect_createAttatched(PowerupManager__P_FX_PATH_LEVELUP , s__Unit_prototype_origin_unit[focusUnit] , "origin"),2.0)
      endif
      set EVT_POWERUP_ADD_PLAYER=s__PowerupManager_owner[this]
      set EVT_POWERUP_ADD_UNIT=focusUnit
      call s__Event_activate(ENUM_EVENT_POWERUP_ADD)
    endfunction

    
    function s__PowerupManager_removePowerup takes integer this returns nothing
      local integer pu= (s__Array_getValue(s__PowerupManager_powerup_list[this],0))
      if (LoadInteger(Hash___D, (((s__PowerupManager_powerup_list[this]))), (s__Array_P_SIZE))) > 0 and pu > 0 then // INLINED!!
        call s__Powerup_deallocate(pu)
        call s__Array_remove(s__PowerupManager_powerup_list[this],0)
        set pu=(s__Array_getValue(s__PowerupManager_powerup_list[this],0))
        if pu > 0 then
          call s__PowerupManager_extract(this)
        endif
      endif
    endfunction

    function s__PowerupManager_applyPowerupItem takes integer this,integer target,integer slot returns nothing
      local boolean result= false
      local integer pitem= (CONFIG_POWERUP_ITEM_MAX * GetPlayerId(s__PowerupManager_owner[(this)]) + (slot)) // INLINED!!
      local integer i= 0
      
      if (s__PowerupItem_type[(pitem)] < 0) then // INLINED!!
        return
      endif
      
      set result=s__PowerupItem_apply(pitem,target)
      if not result then
        
        return
      endif
      
      loop
        exitwhen i >= CONFIG_POWERUP_ITEM_MAX
        call s__PowerupItem_setEmpty((CONFIG_POWERUP_ITEM_MAX * GetPlayerId(s__PowerupManager_owner[(this)]) + (i))) // INLINED!!
        set i=i + 1
      endloop
      
      call s__PowerupManager_removePowerup(this)
      
      if result then
        set EVT_POWERUP_PLAYER=s__PowerupManager_owner[this]
        set EVT_POWERUP_UNIT=target
        call s__Event_activate(ENUM_EVENT_POWERUP)
        if GetLocalPlayer() == s__PowerupManager_owner[this] then
          call PlaySoundBJ(gg_snd_BigButtonClick)
        endif
      endif
      
      set EVT_UI_REFRESH_ABILITY=- 1
      set EVT_UI_REFRESH_PLAYER=s__PowerupManager_owner[this]
      set EVT_UI_REFRESH_SLOT=- 1
      call s__Event_activate(ENUM_EVENT_ABILITY_UI_REFRESH)
    endfunction

    function s__PowerupManager_isEmpty takes integer this returns boolean
      return (LoadInteger(Hash___D, (((s__PowerupManager_powerup_list[this]))), (s__Array_P_SIZE))) <= 0 // INLINED!!
    endfunction

    function s__PowerupManager_create takes player owner returns integer
      local integer i= 0
      local integer this= GetPlayerId(owner)
      set s__PowerupManager_owner[this]=owner
      
      set s__PowerupManager_powerup_list[this]=s__Array_create()
      
      set s__PowerupManager_random_stat_list[this]=s__Array_create()
      loop
        exitwhen i >= PowerupManager__P_RANDOM_STAT_SIZE
        call s__Array_add(s__PowerupManager_random_stat_list[this],PowerupManager__P_RANDOM_STAT[i])
        set i=i + 1
      endloop
      
      set i=0
      loop
        exitwhen i >= CONFIG_POWERUP_ITEM_MAX
        call s__PowerupItem_setEmpty((CONFIG_POWERUP_ITEM_MAX * GetPlayerId(s__PowerupManager_owner[(this)]) + (i))) // INLINED!!
        set i=i + 1
      endloop
      return this
    endfunction

    
    function s__PowerupManager_levelCallback takes nothing returns nothing
      local integer u= (EVT_LEVEL_UNIT)
      local integer diff= EVT_LEVEL_LEVEL_DIFF
      local integer this= 0
      local integer i= 0
      if GetPlayerId((GetOwningPlayer(s__Unit_prototype_origin_unit[(u)]))) < CONFIG_PLAYER_MAX and diff > 0 then // INLINED!!
        set this=GetPlayerId((GetOwningPlayer(s__Unit_prototype_origin_unit[(u)]))) // INLINED!!
        
        loop
          exitwhen i >= diff
          call s__PowerupManager_addPowerup(this,s__Powerup_create(ENUM_POWERUP_TYPE_LEVEL , (s__Unit_prototype_level_true[(u)]) - diff + i + 1)) // INLINED!!
          set i=i + 1
        endloop
      endif
    endfunction

    function s__PowerupManager_onInit takes nothing returns nothing
      local trigger t= CreateTrigger()
      
      call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_LEVEL)*1.0)) // INLINED!!
      call TriggerAddCondition(t, Condition(function s__PowerupManager_levelCallback))
      set t=null
    endfunction


  
