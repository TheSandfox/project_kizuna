			return this
  endfunction

  function s__AbilityShard_addUpgradePoint takes integer this,integer index,integer val returns integer
			call s__AbilityShard_setUpgradePoint(this,index , s__AbilityShard_getUpgradePoint(this,index) + val)
			return this
  endfunction

  function s__AbilityShard_addLevel takes integer this,integer val returns integer
			
			set s__AbilityShard_level[this]=s__AbilityShard_level[this] + val
			call sc__Item_prototype_refreshDropName(this)
			return this
  endfunction

		
  function s__AbilityShard_onRightClick takes integer this returns boolean
   local boolean result= false
   local integer na= 0
   local integer i= 0
   local integer oa= 0
			if s__AbilityManager_visible_flag[(GetPlayerId(s__AbilityShard_USER))] then
				call sc__AbilityManager_abilityMixRegisterRequest((GetPlayerId(s__AbilityShard_USER)),this , s__AbilityMixElement_TYPE_ABILITY_SHARD)
				return true
			else
				return false
			endif
  endfunction

		
  function s__AbilityShard_onLeftClick takes integer this returns boolean
   local boolean result= false
   local integer na= 0
   local integer i= 0
   local integer oa= 0
			
			if s__AbilityShard_USER == null then
				return false
			endif
			
			if s__AbilityManager_visible_flag[(GetPlayerId(s__AbilityShard_USER))] then
				set s__AbilityShard_USER=null
				return false
			endif
			
			
			
			set oa=sc__Unit_prototype_getAbilityById((s__User_FOCUS_UNIT[GetPlayerId((s__AbilityShard_USER))]),s__AbilityShard_ability_id[this]) // INLINED!!
			if oa == 0 then
				
				set na=sc__Unit_prototype_addAbility((s__User_FOCUS_UNIT[GetPlayerId((s__AbilityShard_USER))]),s__AbilityShard_ability_id[this]) // INLINED!!
				if na > 0 then
					
					call sc__Ability_prototype_addLevel(na,s__AbilityShard_level[this] - 1)
					
					loop
						exitwhen i >= CONFIG_UPGRADE_MAX
						call SaveInteger(Ability__HASH2, (na), s__Ability_INDEX_UPGRADE_POINT + (i ), ( s__AbilityShard_getUpgradePoint(this,i))) // INLINED!!
						set i=i + 1
					endloop
					call sc__Item_prototype_prototype_deallocate(this)
					
					call sc__Effect_setDuration(sc__AttatchedEffect_create(AbilityMix___EFFECT_PATH4 , (s__User_FOCUS_UNIT[GetPlayerId((s__AbilityShard_USER))])),2.0) // INLINED!!
					
					set CUSTOM_RESPOND_UI_REFRESH_PLAYER=s__AbilityShard_USER
					call sc__Event_activate(CONFIG_EVENT_ABILITY_UI_REFRESH)
					set CUSTOM_RESPOND_UI_REFRESH_PLAYER=null
					set result=true
				else
					set result=false
				endif
			elseif oa == - 1 then
				
				set CUSTOM_RESPOND_ERROR_PLAYER=s__AbilityShard_USER
				set CUSTOM_RESPOND_ERROR_MESSAGE="더이상 스킬을 습득할 수 없습니다."
				call sc__Event_activate(CONFIG_EVENT_ERROR)
				set result=false
			else
				
				set CUSTOM_RESPOND_ERROR_PLAYER=s__AbilityShard_USER
				set CUSTOM_RESPOND_ERROR_MESSAGE="이미 해당 유형의 스킬을 보유하고 있습니다.\n스킬 파편을 이용한 레벨업은 '스킬 관리(V) > 합성' 탭을 이용해주세요."
				set CUSTOM_RESPOND_ERROR_TIME=3.0
				call sc__Event_activate(CONFIG_EVENT_ERROR)
				set CUSTOM_RESPOND_ERROR_TIME=0.
				set result=false
			endif
			set s__AbilityShard_USER=null
			return result
  endfunction

  function s__AbilityShard_getRandomUpgradeType takes nothing returns integer
   local integer i= GetRandomInt(0, 2)
			if i == 0 then
				return CONFIG_UPGRADE_SKILL_POINT
			elseif i == 1 then
				return CONFIG_UPGRADE_LUCK
			elseif i == 2 then
				return CONFIG_UPGRADE_EXP
			endif
			return CONFIG_UPGRADE_GOLD
  endfunction

		
  function s__AbilityShard_getExtraText takes integer this returns string
			return "lv" + I2S(s__AbilityShard_level[this])
  endfunction

		
  function s__AbilityShard_getTier takes integer this returns integer
			return (LoadInteger(Ability__HASH1, (s__AbilityShard_ability_id[this]), s__Ability_INDEX_TIER)) // INLINED!!
  endfunction

		
  function s__AbilityShard_getModelPath takes integer this returns string
			return "Models\\Items\\item_cube_tier" + I2S((LoadInteger(Ability__HASH1, (s__AbilityShard_ability_id[(this)]), s__Ability_INDEX_TIER))) + ".mdl" // INLINED!!
  endfunction

		
  function s__AbilityShard_getDropName takes integer this returns string
			return (LoadStr(Ability__HASH1, (s__AbilityShard_ability_id[this]), s__Ability_INDEX_NAME)) + "(Lv. " + I2S(s__AbilityShard_level[this]) + ")" // INLINED!!
  endfunction

		
  function s__AbilityShard_relativeTooltip takes integer this returns string
			return "[스킬파편] Lv. " + I2S(s__AbilityShard_level[this]) + " " + (LoadStr(Ability__HASH1, (s__AbilityShard_ability_id[this]), s__Ability_INDEX_NAME)) + "\n" + CUSTOM_STRING_UPGRADE_COLOR[CONFIG_UPGRADE_GOLD] + I2S(s__AbilityShard_getUpgradePoint(this,CONFIG_UPGRADE_GOLD)) + "|r/" + CUSTOM_STRING_UPGRADE_COLOR[CONFIG_UPGRADE_SKILL_POINT] + I2S(s__AbilityShard_getUpgradePoint(this,CONFIG_UPGRADE_SKILL_POINT)) + "|r/" + CUSTOM_STRING_UPGRADE_COLOR[CONFIG_UPGRADE_LUCK] + I2S(s__AbilityShard_getUpgradePoint(this,CONFIG_UPGRADE_LUCK)) + "|r/" + CUSTOM_STRING_UPGRADE_COLOR[CONFIG_UPGRADE_EXP] + I2S(s__AbilityShard_getUpgradePoint(this,CONFIG_UPGRADE_EXP)) + "|r\n\n|cff999999클릭하여 습득" // INLINED!!
  endfunction
		
  function s__AbilityShard_create takes integer aid returns integer
   local integer this= s__AbilityShard__allocate()
			set s__AbilityShard_ability_id[this]=aid
			call s__AbilityShard_addUpgradePoint(this,CONFIG_UPGRADE_LUCK , (LoadInteger(Ability__HASH1, (s__AbilityShard_ability_id[(this)]), s__Ability_INDEX_TIER)) * 1) // INLINED!!
			
			call sc__Item_setTooltip(this,s__ItemTooltip_NORMAL)
			return this
  endfunction

  function s__AbilityShard_createFromAbility takes integer targetabil returns integer
   local integer this= 0
   local integer i= 0
			if targetabil <= 0 then
				return 0
			endif
			set this=s__AbilityShard_create(s__Ability_prototype_id[targetabil])
			
			call s__AbilityShard_addLevel(this,s__Ability_prototype_level[targetabil] - 1)
			
			loop
				exitwhen i >= CONFIG_UPGRADE_MAX
				call s__AbilityShard_setUpgradePoint(this,i , (LoadInteger(Ability__HASH2, (targetabil), s__Ability_INDEX_UPGRADE_POINT + (i)))) // INLINED!!
				set i=i + 1
			endloop
			
			call sc__Item_prototype_pick(this,s__Ability_prototype_owner[targetabil])
			return this
  endfunction

  function s__AbilityShard_onDestroy takes integer this returns nothing
   local integer i= 0
			loop
				exitwhen i >= CONFIG_UPGRADE_MAX
				call s__AbilityShard_setUpgradePoint(this,i , 0)
				set i=i + 1
			endloop
  endfunction





