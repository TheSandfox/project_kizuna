   function s__glave_nextTargetAction takes integer this,boolean exists returns boolean
    local real ra= GetRandomReal(0, 360)
    local real dx= 0.
    local real dy= 0.
				set s__Missile_onhit_type[this]=s__Damage_ONHIT_TYPE_NONHIT
				if exists then
					set s__Missile_damage[this]=s__Missile_damage[this] * Ability20l0__DAMAGE_PRIMARY
					return false
				else
					set s__Missile_damage[this]=s__Missile_damage[this] * Ability20l0__DAMAGE_SECONDARY
					call s__Missile__set_target((this),(s__Glave_target_previous[this])) // INLINED!!
					// DO BEZIER
					call s__Missile__set_curve(this,s__CurveBezier3__allocate(sc__Object__get_x(this) , sc__Object__get_y(this) , sc__Object__get_z(this) , sc__Object__get_x((s__Missile_target_true[(this)])) , sc__Object__get_y((s__Missile_target_true[(this)])) , sc__Object__get_z((s__Missile_target_true[(this)])) + s__Object_pivot_z[(s__Missile_target_true[(this)])])) // INLINED!!
					set s__Curve_overtime[s__Object__get_curve(this)]=0.5
					set dx=(((sc__Object__get_x((s__Missile_target_true[(this)])) )*1.0) + (( 450. )*1.0) * Cos((( ra - 45.)*1.0) * bj_DEGTORAD)) // INLINED!!
					set dy=(((sc__Object__get_y((s__Missile_target_true[(this)])) )*1.0) + (( 450. )*1.0) * Sin((( ra - 45.)*1.0) * bj_DEGTORAD)) // INLINED!!
					call s__Curve_setX((s__Object__get_curve(this)),s__Curve_POINT_MIDDLE + 0 , dx)
					call s__Curve_setY((s__Object__get_curve(this)),s__Curve_POINT_MIDDLE + 0 , dy)
					call s__Curve_setZ((s__Object__get_curve(this)),s__Curve_POINT_MIDDLE + 0 , sc__Object__get_z((s__Missile_target_true[(this)])) + 100.) // INLINED!!
					set dx=(((sc__Object__get_x((s__Missile_target_true[(this)])) )*1.0) + (( 450. )*1.0) * Cos((( ra + 45.)*1.0) * bj_DEGTORAD)) // INLINED!!
					set dy=(((sc__Object__get_y((s__Missile_target_true[(this)])) )*1.0) + (( 450. )*1.0) * Sin((( ra + 45.)*1.0) * bj_DEGTORAD)) // INLINED!!
					call s__Curve_setX((s__Object__get_curve(this)),s__Curve_POINT_MIDDLE + 1 , dx)
					call s__Curve_setY((s__Object__get_curve(this)),s__Curve_POINT_MIDDLE + 1 , dy)
					call s__Curve_setZ((s__Object__get_curve(this)),s__Curve_POINT_MIDDLE + 1 , sc__Object__get_z((s__Missile_target_true[(this)])) + 100.) // INLINED!!
					set s__Glave_count[this]=0
					return false
				endif
   endfunction

   function s__glave_create takes integer caster,integer target,integer level returns integer
    local integer this= s__glave__allocate(caster , Ability20l0__EFFECT_PATH1 , target , Ability20l0__STARTAT , Ability20l0__RANGE , Ability20l0__TARGET_MAX)
				call s__Missile__set_velo(this,Ability20l0__VELO)
				call s__Missile_setDamageFlagById(this,Ability20l0__ID)
				set s__Missile_damage[this]=s__Unit_prototype_getCarculatedStatValue(s__Missile_owner[this],Ability20l0__DAMAGE_STAT1) * Ability20l0__DAMAGE_AMPLIFIER1 * ( 1 + Ability20l0__DAMAGE_PER_LEVEL * ( level ) )
				set s__Missile_weapon_type[this]=WEAPON_TYPE_METAL_MEDIUM_SLICE
				return this
   endfunction

	

