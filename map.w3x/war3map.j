				call BlzSetUnitName(s__Item_prototype__get_origin_item(this), sc__Item_prototype_getDropName(this))
			endif
  endfunction

  function s__Item_prototype_showWidget takes integer this,boolean flag returns nothing
			if s__Item_prototype__get_origin_item(this) == null then
				return
			endif
			call ShowUnit(s__Item_prototype__get_origin_item(this), flag)
  endfunction

  function s__Item_prototype_merge takes integer this,integer target returns boolean
			if s__Item_prototype_id[target] != s__Item_prototype_id[this] then
				return false
			endif
			set s__Item_prototype_count[target]=s__Item_prototype_count[target] + s__Item_prototype_count[this]
			call sc__Item_prototype_prototype_deallocate(this)
			return true
  endfunction

  function s__Item_prototype_drop takes integer this,real x,real y returns nothing
			call s__Item_prototype_unequip(this)
			set s__ItemAddress_x[((this))]=(s__ItemAddress_DROP) // INLINED!!
			set s__ItemAddress_y[((this))]=(- 1) // INLINED!!
			set s__ItemAddress_z[((this))]=(- 1) // INLINED!!
			
			call s__Item_prototype__set_origin_item(this,CreateUnit(CONFIG_PLAYER_ITEM, 'idum', x, y, 270.))
			call s__Item_prototype_refreshDropName(this)
			call SetUnitVertexColor(s__Item_prototype__get_origin_item(this), 0, 0, 0, 0)
			call SetUnitFlyHeight(s__Item_prototype__get_origin_item(this), 0., 0.)
			call SetUnitX(s__Item_prototype__get_origin_item(this), x)
			call SetUnitY(s__Item_prototype__get_origin_item(this), y)
			
			
			call UnitAddAbility(s__Item_prototype__get_origin_item(this), CONFIG_ABILITY_ID_CLASS_INTERACTIVE)
			
			if s__Item_prototype_origin_effect[this] != null then
				call DestroyEffect(s__Item_prototype_origin_effect[this])
			endif
			set s__Item_prototype_origin_effect[this]=AddSpecialEffect(sc__Item_prototype_getModelPath(this), x, y)
			call BlzSetSpecialEffectYaw(s__Item_prototype_origin_effect[this], Deg2Rad(270.))
  endfunction

  function s__Item_prototype_pick takes integer this,integer u returns nothing
			set CUSTOM_RESPOND_ITEM_PICK_UNIT=u
			set CUSTOM_RESPOND_ITEM_PICK_ITEM=this
			set CUSTOM_RESPOND_ITEM_PICK_RESULT=false
			call s__Event_activate(CONFIG_EVENT_ITEM_PICK)
			
			if CUSTOM_RESPOND_ITEM_PICK_RESULT then
				call s__Item_prototype__set_origin_item(this,null)
				if s__Item_prototype_origin_effect[this] != null then
					call DestroyEffect(s__Item_prototype_origin_effect[this])
				endif
				set s__Item_prototype_origin_effect[this]=null
			else

			endif
  endfunction

  function s__Item_prototype_create takes nothing returns integer
   local integer this= s__Item_prototype__allocate()
			set s__ItemAddress_x[((this))]=(- 1) // INLINED!!
			set s__ItemAddress_y[((this))]=(- 1) // INLINED!!
			set s__ItemAddress_z[((this))]=(- 1) // INLINED!!
			return this
  endfunction

  function s__Item_prototype_onDestroy takes integer this returns nothing
			set CUSTOM_RESPOND_ITEM_DESTROY_ADDRESS1=(s__ItemAddress_x[((this))]) // INLINED!!
			set CUSTOM_RESPOND_ITEM_DESTROY_ADDRESS2=(s__ItemAddress_y[((this))]) // INLINED!!
			set CUSTOM_RESPOND_ITEM_DESTROY_INDEX=(s__ItemAddress_z[((this))]) // INLINED!!
			set CUSTOM_RESPOND_ITEM_DESTROY_ITEM=this
			call s__Event_activate(CONFIG_EVENT_ITEM_DESTROY)
			call s__Item_prototype_unequip(this)
			set s__ItemAddress_z[((this))]=(- 1) // INLINED!!
			set s__ItemAddress_x[((this))]=(- 1) // INLINED!!
			set s__ItemAddress_y[((this))]=(- 1) // INLINED!!
			if s__Item_prototype_origin_effect[this] != null then
				call DestroyEffect(s__Item_prototype_origin_effect[this])
			endif
			call s__Item_prototype__set_origin_item(this,null)
			set s__Item_prototype_origin_effect[this]=null
			set s__Item_prototype_exist[this]=false
  endfunction

  function s__Item_prototype_itemGet takes nothing returns nothing
   local integer this= 0
			if GetSpellAbilityId() == CONFIG_ABILITY_ID_INTERACT then
				set this=s__Item_prototype_get(GetSpellTargetUnit())
				if this > 0 and sc__Unit_prototype_get(GetTriggerUnit()) > 0 then
					call s__Item_prototype_pick(this,sc__Unit_prototype_get(GetTriggerUnit()))
				endif
				return
			endif
  endfunction

  function s__Item_prototype_onInit takes nothing returns nothing
			call TriggerRegisterAnyUnitEventBJ(ITEM_GET_TRIGGER, EVENT_PLAYER_UNIT_SPELL_EFFECT)
			call TriggerAddCondition(ITEM_GET_TRIGGER, Condition(function s__Item_prototype_itemGet))
  endfunction



