 function s__BossPatternIndicator_timerCallback takes nothing returns nothing
  local integer this= sc__Timer_getData(GetExpiredTimer())
		if s__BossPatternIndicator_state[this] == 0 then
			call sc__Effect_setAlpha(s__BossPatternIndicator_outter[this],R2I(92 + 255 * ( 1.0 - s__BossPatternIndicator_duration[this] / s__BossPatternIndicator_duration_max[this] ) * 2.0))
			call sc__Effect_setAlpha(s__BossPatternIndicator_inner[this],R2I(64 + 255 * ( 1.0 - s__BossPatternIndicator_duration[this] / s__BossPatternIndicator_duration_max[this] ) * 2.0))
			if s__BossPatternIndicator_auto_progress[this] then
				set s__BossPatternIndicator_duration[this]=s__BossPatternIndicator_duration[this] - TIMER_TICK
				call s__BossPatternIndicator_setProgress(this,1.0 - ( s__BossPatternIndicator_duration[this] / s__BossPatternIndicator_duration_max[this] ))
			endif
			if s__BossPatternIndicator_auto_destroy[this] then
