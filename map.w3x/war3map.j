//library Buff:











  function s__Buff_suspendFree takes integer this returns nothing
			set s__Buff_suspend_caster_dead[this]=false
			set s__Buff_suspend_target_dead[this]=false
			set s__Buff_suspend_caster_alive[this]=false
			set s__Buff_suspend_target_alive[this]=false
  endfunction

  function s__Buff_setPermanent takes integer this returns nothing
			set s__Buff_permanent[this]=true
			call s__Buff_suspendFree(this)
  endfunction

  function s__Buff_getTypeIconPath takes integer bid returns string
			return LoadStr(BUFF_CREATE_HASH, bid, BUFF_HASH_INDEX_ICON_PATH)
  endfunction

  function s__Buff_suspendFilter takes integer this returns boolean
			if s__Buff_suspend_target_dead[this] and sc__Unit_prototype_isUnitType(s__Buff_target[this],UNIT_TYPE_DEAD) then
				return true
			elseif s__Buff_suspend_caster_dead[this] and sc__Unit_prototype_isUnitType(s__Buff_caster[this],UNIT_TYPE_DEAD) then
				return true
			elseif s__Buff_suspend_target_alive[this] and not sc__Unit_prototype_isUnitType(s__Buff_target[this],UNIT_TYPE_DEAD) then
				return true
			elseif s__Buff_suspend_caster_alive[this] and not sc__Unit_prototype_isUnitType(s__Buff_caster[this],UNIT_TYPE_DEAD) then
				return true
			endif
			return false
  endfunction

  function s__Buff_suspendFilterAdditional takes integer this returns boolean
			return false
  endfunction

  function s__Buff__get_owner takes integer this returns integer
			return s__Buff_caster[this]
  endfunction

  function s__Buff_genericConfiguration takes integer this returns nothing
			set s__Buff_icon[this]=BUFF_CREATE_ICON_PATH
			set s__Buff_positive[this]=BUFF_CREATE_POSITIVE
			set s__Buff_icon_display[this]=BUFF_CREATE_DISPLAY
  endfunction

  function s__Buff_new takes nothing returns integer
   local integer this= 0
   local boolean result= true
			if BUFF_CREATE_INDIVISUAL == 2 then
				call TriggerEvaluate(LoadTriggerHandle(BUFF_CREATE_HASH, BUFF_CREATE_ID, BUFF_HASH_INDEX_TRIGGER))
				set this=BUFF_LAST_CREATED
				call s__Buff_genericConfiguration(this)
				set result=sc__Buff_init(this)
			elseif BUFF_CREATE_INDIVISUAL == 1 then
				set this=sc__Buff_getMatchingCasterAndTarget(BUFF_CREATE_CASTER , BUFF_CREATE_TARGET , BUFF_CREATE_ID)
				if this <= 0 then
					call TriggerEvaluate(LoadTriggerHandle(BUFF_CREATE_HASH, BUFF_CREATE_ID, BUFF_HASH_INDEX_TRIGGER))
					set this=BUFF_LAST_CREATED
					call s__Buff_genericConfiguration(this)
					set result=sc__Buff_init(this)
				else
					if BUFF_CREATE_DURATION > s__Buff_duration[this] then
						set s__Buff_duration[this]=BUFF_CREATE_DURATION
						if s__Buff_duration_max[this] < BUFF_CREATE_DURATION then
							set s__Buff_duration_max[this]=BUFF_CREATE_DURATION
						endif
					endif
					if BUFF_CREATE_LEVEL > s__Buff_level[this] then
						set s__Buff_level[this]=BUFF_CREATE_LEVEL
					endif
					set s__Buff_caster[this]=BUFF_CREATE_CASTER
					set result=sc__Buff_update(this)
				endif
			elseif BUFF_CREATE_INDIVISUAL == 0 then
				set this=sc__Buff_getUnitBuffById(BUFF_CREATE_TARGET , BUFF_CREATE_ID)
				if this <= 0 then
					call TriggerEvaluate(LoadTriggerHandle(BUFF_CREATE_HASH, BUFF_CREATE_ID, BUFF_HASH_INDEX_TRIGGER))
					set this=BUFF_LAST_CREATED
					call s__Buff_genericConfiguration(this)
					set result=sc__Buff_init(this)
				else
					if BUFF_CREATE_DURATION > s__Buff_duration[this] then
						set s__Buff_duration[this]=BUFF_CREATE_DURATION
						if s__Buff_duration_max[this] < BUFF_CREATE_DURATION then
							set s__Buff_duration_max[this]=BUFF_CREATE_DURATION
						endif
					endif
					if BUFF_CREATE_LEVEL > s__Buff_level[this] then
						set s__Buff_level[this]=BUFF_CREATE_LEVEL
					endif
					set s__Buff_caster[this]=BUFF_CREATE_CASTER
					set result=sc__Buff_update(this)
				endif
			endif
			if result then
				return this
			else
				return 0
			endif
  endfunction

  function s__Buff_add takes integer caster,integer target,integer id,integer level,real duration returns integer
			set BUFF_LAST_CREATED=0
			set BUFF_CREATE_CASTER=caster
			set BUFF_CREATE_TARGET=target
			set BUFF_CREATE_DURATION=duration
			set BUFF_CREATE_LEVEL=level
			
			call TriggerEvaluate(LoadTriggerHandle(BUFF_CREATE_HASH, id, BUFF_HASH_INDEX_TRIGGER + 1))
			
			call s__Buff_new()
			
			set BUFF_CREATE_CASTER=- 1
			set BUFF_CREATE_TARGET=- 1
			set BUFF_CREATE_DURATION=0.
			set BUFF_CREATE_LEVEL=- 1
			return BUFF_LAST_CREATED
  endfunction

  function s__Buff_addWithValue takes integer caster,integer target,integer id,integer level,real duration,integer value returns integer
			set CUSTOM_RESPOND_BUFF_VALUE=value
			return s__Buff_add(caster , target , id , level , duration)
  endfunction
		
  function s__Buff_getUnitRootBuff takes integer target returns integer
			if HaveSavedInteger(s__Buff_HASH, target, 0) then
				return LoadInteger(s__Buff_HASH, target, 0)
			else
				return 0
			endif
  endfunction

  function s__Buff_getMatchingCasterAndTarget takes integer caster,integer target,integer id returns integer
   local integer b= s__Buff_getUnitRootBuff(target)
			if b > 0 then
				loop
					if s__Buff_id[b] == id and s__Buff_caster[b] == caster then
						return b
					else
						if s__Buff_node_next[b] > 0 then
							set b=s__Buff_node_next[b]
						else
