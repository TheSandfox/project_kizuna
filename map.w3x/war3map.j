			return s__Effect_a_true[this]
  endfunction
	
  function s__Effect_setScale takes integer this,real ns returns integer
			set s__Effect_scale_true[this]=ns
			if ns < 0 then
				call BlzSetSpecialEffectScale(s__Effect_origin_effect[this], 0)
			else
				call BlzSetSpecialEffectScale(s__Effect_origin_effect[this], ns)
			endif
			return this
  endfunction

		
  function s__Effect_setMatrixScale takes integer this,real nx,real ny,real nz returns integer
			call BlzSetSpecialEffectMatrixScale(s__Effect_origin_effect[this], nx, ny, nz)
			return this
  endfunction

  function s__Effect_resetMatrixScale takes integer this returns integer
			call BlzResetSpecialEffectMatrix(s__Effect_origin_effect[this])
			return this
  endfunction
	
  function s__Effect_colorRefresh takes integer this returns nothing
   local real array color
   local integer i= 0
			set color[0]=s__Effect_r_true[this]
			set color[1]=s__Effect_g_true[this]
			set color[2]=s__Effect_b_true[this]
			loop
				if color[i] > 255 then
					set color[i]=255
				elseif color[i] < 0 then
					set color[i]=0
				endif
				set i=i + 1
				exitwhen i == 3
			endloop
			call BlzSetSpecialEffectColor(s__Effect_origin_effect[this], R2I(color[0]), R2I(color[1]), R2I(color[2]))
  endfunction
	
  function s__Effect_setR takes integer this,real nv returns integer
			set s__Effect_r_true[this]=nv
			call s__Effect_colorRefresh(this)
			return this
  endfunction
	
  function s__Effect_setG takes integer this,real nv returns integer
			set s__Effect_g_true[this]=nv
			call s__Effect_colorRefresh(this)
			return this
  endfunction
	
  function s__Effect_setB takes integer this,real nv returns integer
			set s__Effect_b_true[this]=nv
			call s__Effect_colorRefresh(this)
			return this
  endfunction
	
  function s__Effect_setAlpha takes integer this,real nv returns integer
			set s__Effect_a_true[this]=nv
			call BlzSetSpecialEffectAlpha(s__Effect_origin_effect[this], R2I(nv))
			return this
  endfunction
	
  function s__Effect_setColor takes integer this,real r,real g,real b returns integer
			set s__Effect_r_true[this]=r
			set s__Effect_g_true[this]=g
			set s__Effect_b_true[this]=b
			call s__Effect_colorRefresh(this)
