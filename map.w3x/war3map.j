//Implemented from module ChainGlave:

  function s__Glave_explosionFilterAdditional takes integer this,integer target returns boolean
			// if IsUnitInGroup(target.origin_unit,.group_already) then
			// 	call BJDebugMsg(target.name+" : |cffff0000불합격|r")
			// else
			// 	call BJDebugMsg(target.name+" : |cff00ff00합격|r")
			// endif
			return not IsUnitInGroup(s__Unit_prototype_origin_unit[target], s__Missile_group_already[this])
  endfunction

  function s__Glave_executeExplosion takes integer this,integer target returns nothing
			call DoNothing()
  endfunction

  function s__Glave_executeTarget takes integer this,integer target returns nothing
			call sc__Glave_executeChain(this,target)
			
			set s__Glave_count[this]=s__Glave_count[this] - 1
			
			
			
			call GroupAddUnit(s__Missile_group_already[this], s__Unit_prototype_origin_unit[(s__Missile_target_true[(this)])]) // INLINED!!
			
			call GroupClear(s__Missile_group_wave[this])
			call sc__Missile_explosionAction(this)
  endfunction

  function s__Glave_findNextTarget takes integer this returns boolean
			
			set s__Glave_target_previous[this]=(s__Missile_target_true[(this)]) // INLINED!!
			call sc__Missile__set_target(this,sc__Unit_prototype_get(sc__Group_getNearest(s__Missile_group_wave[this] , sc__Object__get_x(this) , sc__Object__get_y(this) , null)))
			return (s__Missile_target_true[(this)]) != 0 // INLINED!!
  endfunction



  function s__Glave_executeChain takes integer this,integer target returns nothing
			call sc__Missile_damageTarget(this,target)
  endfunction

		//트루 반환하면 투사체 소멸
  function s__Glave_nextTargetAction takes integer this,boolean exists returns boolean
			return true
  endfunction

  function s__Glave_killFilter takes integer this returns boolean
			if s__Glave_count[this] <= 0 then
				return true
			else
				if s__Glave_findNextTarget(this) then
					return sc__Glave_nextTargetAction(this,true)
				else
					return sc__Glave_nextTargetAction(this,false)
				endif
			endif
  endfunction

  function s__Glave_create takes integer caster,string path,integer target,real startat,real range,integer count returns integer
   local real r= sc__Math_anglePoints(sc__Object__get_x(caster) , sc__Object__get_y(caster) , sc__Object__get_x(target) , sc__Object__get_y(target))
   local real dx= (((sc__Object__get_x(caster) )*1.0) + (( startat )*1.0) * Cos((( r)*1.0) * bj_DEGTORAD)) // INLINED!!
   local real dy= (((sc__Object__get_y(caster) )*1.0) + (( startat )*1.0) * Sin((( r)*1.0) * bj_DEGTORAD)) // INLINED!!
   local integer this= s__Glave__allocate(caster , path , dx , dy , sc__Object__get_z(caster) + s__Object_pivot_z[caster] , r)
			call sc__Missile_setTarget(this,target)
			call sc__Missile__set_radius_explosion(this,range)
			set s__Glave_count[this]=count
			return this
  endfunction



