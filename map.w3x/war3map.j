//library User ends
//library Ability:

	

		//HASH1:By Ability ID ('어빌id',인덱스)
		//HASH2:By Instance ID (인스턴스id, 인덱스)


  function s__Ability_getUpgradePoint takes integer this,integer index returns integer
			return LoadInteger(Ability__HASH2, this, s__Ability_INDEX_UPGRADE_POINT + index)
  endfunction

  function s__Ability_setUpgradePoint takes integer this,integer index,integer val returns nothing
			call SaveInteger(Ability__HASH2, this, s__Ability_INDEX_UPGRADE_POINT + index, val)
  endfunction

  function s__Ability_addUpgradePoint takes integer this,integer index,integer val returns nothing
			call SaveInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (index ), ( (LoadInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (index))) + val)) // INLINED!!
  endfunction

  function s__Ability_getTypeIsWeapon takes integer id returns boolean
			return LoadBoolean(Ability__HASH1, id, s__Ability_INDEX_IS_WEAPON)
  endfunction

  function s__Ability_setTypeIsWeapon takes integer id,boolean b returns nothing
			call SaveBoolean(Ability__HASH1, id, s__Ability_INDEX_IS_WEAPON, b)
  endfunction

  function s__Ability_getTypeTier takes integer id returns integer
			return LoadInteger(Ability__HASH1, id, s__Ability_INDEX_TIER)
  endfunction

  function s__Ability_setTypeTier takes integer id,integer val returns nothing
			call SaveInteger(Ability__HASH1, id, s__Ability_INDEX_TIER, val)
  endfunction

  function s__Ability_getTypeMaxLevel takes integer id returns integer
			return LoadInteger(Ability__HASH1, id, s__Ability_INDEX_MAX_LEVEL)
  endfunction

  function s__Ability_setTypeMaxLevel takes integer id,integer val returns nothing
			call SaveInteger(Ability__HASH1, id, s__Ability_INDEX_MAX_LEVEL, val)
  endfunction

  function s__Ability_getTypeCastType takes integer id returns integer
			return LoadInteger(Ability__HASH1, id, s__Ability_INDEX_CAST_TYPE)
  endfunction

  function s__Ability_setTypeCastType takes integer id,integer val returns nothing
			call SaveInteger(Ability__HASH1, id, s__Ability_INDEX_CAST_TYPE, val)
  endfunction

  function s__Ability_getTypeTooltip takes integer id returns string
			if HaveSavedString(Ability__HASH1, id, s__Ability_INDEX_TOOLTIP) then
				return LoadStr(Ability__HASH1, id, s__Ability_INDEX_TOOLTIP)
			else
				return "ToolTip Missing"
			endif
  endfunction

  function s__Ability_setTypeTooltip takes integer id,string val returns nothing
			call SaveStr(Ability__HASH1, id, s__Ability_INDEX_TOOLTIP, val)
  endfunction

  function s__Ability_getTypeCost takes integer id returns integer
			return LoadInteger(Ability__HASH1, id, s__Ability_INDEX_COST)
  endfunction

  function s__Ability_setTypeCost takes integer id,integer val returns nothing
			call SaveInteger(Ability__HASH1, id, s__Ability_INDEX_COST, val)
  endfunction

  function s__Ability_getTypeName takes integer id returns string
			return LoadStr(Ability__HASH1, id, s__Ability_INDEX_NAME)
  endfunction

  function s__Ability_setTypeName takes integer id,string val returns nothing
			call SaveStr(Ability__HASH1, id, s__Ability_INDEX_NAME, val)
  endfunction

  function s__Ability_getTypeIconPath takes integer id returns string
			if HaveSavedString(Ability__HASH1, id, s__Ability_INDEX_ICON_PATH) then
				return LoadStr(Ability__HASH1, id, s__Ability_INDEX_ICON_PATH)
			else
				return "Icons\\BTNBlackIcon.blp"
			endif
  endfunction

  function s__Ability_setTypeIconPath takes integer id,string val returns nothing
			call SaveStr(Ability__HASH1, id, s__Ability_INDEX_ICON_PATH, val)
  endfunction

  function s__Ability_getTypeBonusStatIndex takes integer id,integer slot returns integer
			return LoadInteger(Ability__HASH1, id, s__Ability_INDEX_BONUS_STAT + slot)
  endfunction

  function s__Ability_setTypeBonusStatIndex takes integer id,integer slot,integer index returns nothing
			if slot == 0 or slot == 1 then
				call SaveInteger(Ability__HASH1, id, s__Ability_INDEX_BONUS_STAT + slot, index)
			endif
  endfunction

  function s__Ability_getTierBorder takes integer v returns string
			return "Textures\\ability_border_tier" + I2S(v) + ".blp"
  endfunction

  function s__Ability_iconClick takes integer this returns nothing
   local integer s= (s__Ability_prototype_smart_true[(this)]) // INLINED!!
			if (LoadBoolean(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_IS_WEAPON)) then // INLINED!!
				call s__Unit_prototype_setWeaponAbility(s__Ability_prototype_owner[this],this)
				call sc__UI_refreshAbilityIconsTarget((GetPlayerId((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])]))))) // INLINED!!
			elseif s__User_ENABLE_ABILITY_HOTKEY[GetPlayerId((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])])))] > 0 then // INLINED!!
				call s__Ability_prototype__set_smart(this,0)
				call s__Ability_prototype_press(this)
				call s__Ability_prototype__set_smart(this,s)
			endif
  endfunction

  function s__Ability_iconRightClick takes integer this returns nothing
			if s__User_ENABLE_ABILITY_RIGHT_CLICK[GetPlayerId((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])])))] > 0 then // INLINED!!
				
				if (LoadBoolean(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_IS_WEAPON)) then // INLINED!!
					
					if s__Unit_prototype_weapon_ability[s__Ability_prototype_owner[this]] == this then
						call s__Unit_prototype_setWeaponAbility(s__Ability_prototype_owner[this],0)
					endif
				else
					
					call s__Ability_prototype_changeSmart(this,(s__Ability_prototype_smart_true[(this)]) + 1) // INLINED!!
				endif
				call sc__UI_refreshAbilityIconsTarget((GetPlayerId((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])]))))) // INLINED!!
			else
				
				call s__AbilityManager_abilityMixRegisterRequest((GetPlayerId((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])])))),this , s__AbilityMixElement_TYPE_ABILITY) // INLINED!!
			endif
  endfunction

  function s__Ability_servantTest takes integer this returns boolean
			return s__UnitClass_getClass((s__Ability_prototype_owner[this]),CONFIG_UNIT_CLASS_SUMMON) <= 0 and s__UnitClass_getClass((s__Ability_prototype_owner[this]),CONFIG_UNIT_CLASS_SERVANT) <= 0
  endfunction

  function s__Ability_plusBaseStatValue takes integer this,integer v returns nothing
   local integer ind1= 0
   local integer ind2= 0
			if (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_TIER)) <= 0 then // INLINED!!
				return
			endif
			set ind1=(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this] ), s__Ability_INDEX_BONUS_STAT + ( 0))) // INLINED!!
			set ind2=(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this] ), s__Ability_INDEX_BONUS_STAT + ( 1))) // INLINED!!
			call s__Unit_prototype_plusBaseStatValue(s__Ability_prototype_owner[this],ind1 , v * s__STAT_NORMAL_VALUE[ind1] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_TIER)) * 0.5) // INLINED!!
			call s__Unit_prototype_plusBaseStatValue(s__Ability_prototype_owner[this],ind2 , v * s__STAT_NORMAL_VALUE[ind2] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_TIER)) * 0.5) // INLINED!!
			set s__Ability_stat_bonus1[this]=s__Ability_stat_bonus1[this] + v * s__STAT_NORMAL_VALUE[ind1] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_TIER)) * 0.5 // INLINED!!
			set s__Ability_stat_bonus2[this]=s__Ability_stat_bonus2[this] + v * s__STAT_NORMAL_VALUE[ind2] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_TIER)) * 0.5 // INLINED!!
  endfunction

  function s__Ability_addLevel takes integer this,integer v returns nothing
			if s__Ability_prototype_level[this] + v > s__Ability_level_max[this] then
				set v=s__Ability_level_max[this] - s__Ability_prototype_level[this]
			endif
			set s__Ability_prototype_level[this]=s__Ability_prototype_level[this] + v
			call s__Ability_plusBaseStatValue(this,v)
			call sc__Ability_prototype_update(this,v)
  endfunction

  function s__Ability_deactivate takes integer this returns nothing

  endfunction

  function s__Ability_onDeath takes integer this returns nothing
			if (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_TIER)) > 0 then // INLINED!!
				call s__Unit_prototype_plusBaseStatValue(s__Ability_prototype_owner[this],(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this] ), s__Ability_INDEX_BONUS_STAT + ( 0))) , - s__Ability_stat_bonus1[this]) // INLINED!!
				call s__Unit_prototype_plusBaseStatValue(s__Ability_prototype_owner[this],(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this] ), s__Ability_INDEX_BONUS_STAT + ( 1))) , - s__Ability_stat_bonus2[this]) // INLINED!!
			endif
			call sc__Ability_deactivate(this)
			call sc__UI_refreshAbilityIconsTarget((GetPlayerId((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])]))))) // INLINED!!
  endfunction

  function s__Ability_sell takes integer this returns nothing
			call sc__Unit_setUpgradePoint((s__Ability_prototype_owner[this]),CONFIG_UPGRADE_SKILL_POINT , sc__Unit_getUpgradePoint((s__Ability_prototype_owner[this]),CONFIG_UPGRADE_SKILL_POINT) + (LoadInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_SKILL_POINT)))) // INLINED!!
			call sc__Unit_setUpgradePoint((s__Ability_prototype_owner[this]),CONFIG_UPGRADE_LUCK , sc__Unit_getUpgradePoint((s__Ability_prototype_owner[this]),CONFIG_UPGRADE_LUCK) + (LoadInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_LUCK)))) // INLINED!!
			call sc__Unit_setUpgradePoint((s__Ability_prototype_owner[this]),CONFIG_UPGRADE_EXP , sc__Unit_getUpgradePoint((s__Ability_prototype_owner[this]),CONFIG_UPGRADE_EXP) + (LoadInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_EXP)))) // INLINED!!
			call s__User_addGold((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])])) , (LoadInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_GOLD)))) // INLINED!!
			call s__Ability_prototype_kill(this)
  endfunction

  function s__Ability_executeAI takes integer this returns boolean
			return false
  endfunction



//library Ability ends
//library CharacterSelect:




  function s__ChinghoWidget_click takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
			call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
			if BlzGetTriggerFrameEvent() == FRAMEEVENT_CONTROL_CLICK then
				set CharacterSelect_CHINGHO_ID[GetPlayerId(GetTriggerPlayer())]=s__ChinghoWidget_id[this]
				set CharacterSelect___PANEL_REFRESH_PLAYER=GetTriggerPlayer()
				call TriggerEvaluate(CharacterSelect___PANEL_REFRESH_REQUEST)
				set CharacterSelect___PANEL_REFRESH_PLAYER=null
			endif
  endfunction

  function s__ChinghoWidget_create takes integer index,integer cid,framehandle parent returns integer
   local integer this= s__ChinghoWidget__allocate()
   local framehandle f= null
			set s__ChinghoWidget_id[this]=cid
			set s__ChinghoWidget_btn[this]=BlzCreateFrame("ChinghoSelectButton", parent, 0, this)
			
			call BlzFrameSetPoint((s__ChinghoWidget_btn[this] ), ( FRAMEPOINT_TOPLEFT ), ( CharacterSelect___CHINGHO ), ( FRAMEPOINT_TOPLEFT ), (( 16 )*1.0) / 1800., (( - 16 - 64 * ModuloInteger(index, CharacterSelect___CHINGHO_PER_PAGE))*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((s__ChinghoWidget_btn[this] ), (( CharacterSelect___CHINGHO_WIDTH - 32 )*1.0) / 1800., (( 64)*1.0) / 1800.) // INLINED!!
			
			set f=BlzGetFrameByName("ChinghoSelectButtonIcon1", this)
			call BlzFrameSetPoint((f ), ( FRAMEPOINT_TOPLEFT ), ( s__ChinghoWidget_btn[this] ), ( FRAMEPOINT_TOPLEFT ), (( 8 )*1.0) / 1800., (( - 8)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((f ), (( 64 - 16 )*1.0) / 1800., (( 64 - 16)*1.0) / 1800.) // INLINED!!
			if cid < 0 then
				call BlzFrameSetTexture(f, "ReplaceableTextures\\CommandButtons\\BTNSelectHeroOn.blp", 0, true)
			else
				call BlzFrameSetTexture(f, s__Ability_getTypeIconPath(cid), 0, true)
			endif
			set f=BlzGetFrameByName("ChinghoSelectButtonIcon2", this)
			call BlzFrameSetPoint((f ), ( FRAMEPOINT_TOPRIGHT ), ( s__ChinghoWidget_btn[this] ), ( FRAMEPOINT_TOPRIGHT ), (( - 8 )*1.0) / 1800., (( - 8)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((f ), (( 64 - 16 )*1.0) / 1800., (( 64 - 16)*1.0) / 1800.) // INLINED!!
			if cid < 0 then
				call BlzFrameSetTexture(f, "ReplaceableTextures\\CommandButtons\\BTNSelectHeroOn.blp", 0, true)
			else
				call BlzFrameSetTexture(f, s__Ability_getTypeIconPath(cid), 0, true)
			endif
			
			set f=BlzGetFrameByName("ChinghoSelectButtonText", this)
			call BlzFrameSetPoint(f, FRAMEPOINT_CENTER, s__ChinghoWidget_btn[this], FRAMEPOINT_CENTER, 0., 0.)
			if cid < 0 then
				call BlzFrameSetText(f, "???")
			else
				call BlzFrameSetText(f, (LoadStr(Ability__HASH1, (cid), s__Ability_INDEX_NAME))) // INLINED!!
			endif
			
			set s__ChinghoWidget_main_trigger[this]=s__Trigger_new(this)
			call BlzTriggerRegisterFrameEvent(s__ChinghoWidget_main_trigger[this], s__ChinghoWidget_btn[this], FRAMEEVENT_CONTROL_CLICK)
			call BlzTriggerRegisterFrameEvent(s__ChinghoWidget_main_trigger[this], s__ChinghoWidget_btn[this], FRAMEEVENT_MOUSE_LEAVE)
			set s__ChinghoWidget_main_cond[this]=TriggerAddCondition(s__ChinghoWidget_main_trigger[this], Condition(function s__ChinghoWidget_click))
			
			set f=null
			return this
  endfunction

  function s__ChinghoWidget_onDestroy takes integer this returns nothing
//textmacro instance: destroyTriggerAndCondition(".main_trigger",".main_cond")
		call TriggerRemoveCondition(s__ChinghoWidget_main_trigger[this], s__ChinghoWidget_main_cond[this])
		call s__Trigger_remove(s__ChinghoWidget_main_trigger[this])
		set s__ChinghoWidget_main_trigger[this]=null
		set s__ChinghoWidget_main_cond[this]=null
//end of: destroyTriggerAndCondition(".main_trigger",".main_cond")
//textmacro instance: destroyFrame(".btn")
	call BlzDestroyFrame(s__ChinghoWidget_btn[this])
