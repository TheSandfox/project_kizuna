				if s__Actor_duration[this] <= s__Boss_BossB000__sanrengeki_DURATION_FAST - s__Boss_BossB000__sanrengeki_EXP_DELAY_FAST then
					set s__Boss_BossB000__sanrengeki_anim_reset[this]=true
					call s__Unit_prototype_setAnimSpeed((s__Actor_actor[(this)]),1.0) // INLINED!!
				endif
			endif
		elseif s__Boss_BossB000__sanrengeki_count[this] == 1 then
			if not s__Boss_BossB000__sanrengeki_anim_play[this] then
				if s__Actor_duration[this] <= s__Boss_BossB000__sanrengeki_DURATION_SLOW - s__Boss_BossB000__sanrengeki_EXP_DELAY_SLOW + 0.15 then
					set s__Boss_BossB000__sanrengeki_anim_play[this]=true
