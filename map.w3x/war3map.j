					call s__Object_move3DFromOrigin(s__UnitActor_target[this],sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , sc__Object__get_z((s__Actor_actor[(this)])) , s__Grabbing_grab_distance[this] , s__Grabbing_grab_yaw[this] + sc__Object__get_yaw((s__Actor_actor[(this)])) , s__Grabbing_grab_pitch[this]) // INLINED!!
				else
					call s__Object_move3DFromOrigin(s__UnitActor_target[this],sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , sc__Object__get_z((s__Actor_actor[(this)])) , s__Grabbing_grab_distance[this] , s__Grabbing_grab_yaw[this] , s__Grabbing_grab_pitch[this]) // INLINED!!
				endif
			endif
  endfunction

  function s__Grabbing_periodicAction takes integer this returns nothing
			call s__Grabbing_refreshPosition(this)
  endfunction

  function s__Grabbing_xCallback takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if CUSTOM_RESPOND_KEYPRESS_CASTER != (s__Actor_actor[(this)]) then // INLINED!!
				return
			endif
			if CUSTOM_RESPOND_KEYPRESS_KEY != CONFIG_HOTKEY_UNGRAB then
				return
			endif
			call sc__Actor_prototype_deallocate(this)
  endfunction

  function s__Grabbing_failue takes integer caster,integer target returns nothing
			set s__InstantText_SIZE=8.
			set s__InstantText_VELO=0.08 + GetRandomReal(- 0.01, 0.01)
			set s__InstantText_LIFESPAN=1.25
			call sc__InstantText_setColor(0 , 255 , 255)
			call sc__InstantText_createForPlayer(sc__Object__get_x(target) , sc__Object__get_y(target) , sc__Object__get_z(target) + 75 , "(잡을 수 없는 대상입니다)" , (GetOwningPlayer(s__Unit_prototype_origin_unit[(caster)]))) // INLINED!!
			call sc__InstantText_clearFlag()
			
			set CUSTOM_RESPOND_GRABBING_CASTER=caster
			set CUSTOM_RESPOND_GRABBING_TARGET=target
			set CUSTOM_RESPOND_GRABBING_INSTANCE=- 1
			set CUSTOM_RESPOND_GRABBING_FLAG=false
			call s__Event_activate(CONFIG_EVENT_GRABBING)
  endfunction

  function s__Grabbing_setPosition takes integer this,real dist,real yaw,real pitch returns integer
			if this <= 0 then
				return 0
			endif
			set s__Grabbing_refresh_position[this]=true
			set s__Grabbing_grab_distance[this]=dist
			set s__Grabbing_grab_yaw[this]=yaw
			set s__Grabbing_grab_pitch[this]=pitch
			call s__Grabbing_refreshPosition(this)
			return this
  endfunction

  function s__Grabbing_create takes integer caster,integer target,integer level,integer id,boolean unique returns integer
   local integer this= 0
   local integer rins= 0
   local integer unitpointer= 0
			if not s__Unit_prototype_canGrab(target) then
				
				call s__Grabbing_failue(caster , target)
				return 0
			endif
			
			if (s__Grabbing___grabflag_instance_target[((target))]) > 0 then // INLINED!!
				
				call s__Grabbing_failue(caster , target)
				return 0
			endif
			
			if (s__Grabbing___grabflag_unique[((caster))]) then // INLINED!!
				call s__Grabbing_failue(caster , target)
				return 0
			endif
			
			set unitpointer=caster
			loop
				
				set rins=(s__Grabbing___grabflag_instance_target[((unitpointer))]) // INLINED!!
				exitwhen rins <= 0
				if (s__Actor_actor[(rins)]) == target then // INLINED!!
					
					call s__Grabbing_failue(caster , target)
					return 0
				endif
				set unitpointer=(s__Actor_actor[(rins)]) // INLINED!!
			endloop
			set this=s__Grabbing__allocate(caster , target , 0. , 0. , level , 0. , false)
			set s__Actor_id[this]=id
			set s__Grabbing_unique[this]=unique
			
			call s__Grabbing_register(this)
			
			call s__Unit_prototype_plusStatus(s__UnitActor_target[this],CONFIG_STATUS_GHOST)
			call s__Unit_prototype_plusStatus(s__UnitActor_target[this],CONFIG_STATUS_GRABBED)
			
			set s__Unit_prototype_use_gravity[s__UnitActor_target[this]]=s__Unit_prototype_use_gravity[s__UnitActor_target[this]] - 1
			
			if s__Grabbing_unique[this] then
				set s__Grabbing_xkey[this]=s__Trigger_create(this)
				call TriggerRegisterVariableEvent((s__Trigger_main_trigger[s__Grabbing_xkey[this]] ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_KEYPRESS)*1.0)) // INLINED!!
				call s__Trigger_addCondition(s__Grabbing_xkey[this],function s__Grabbing_xCallback)
			endif
			
			set CUSTOM_RESPOND_GRABBING_CASTER=(s__Actor_actor[(this)]) // INLINED!!
			set CUSTOM_RESPOND_GRABBING_TARGET=s__UnitActor_target[this]
			set CUSTOM_RESPOND_GRABBING_INSTANCE=this
			set CUSTOM_RESPOND_GRABBING_FLAG=true
			set CUSTOM_RESPOND_GRABBING_REFRESH_UI=false //.unique
			call s__Event_activate(CONFIG_EVENT_GRABBING)
			return this
  endfunction

  function s__Grabbing_onDestroy takes integer this returns nothing
			
			set CUSTOM_RESPOND_GRABBING_CASTER=(s__Actor_actor[(this)]) // INLINED!!
			set CUSTOM_RESPOND_GRABBING_TARGET=s__UnitActor_target[this]
			set CUSTOM_RESPOND_GRABBING_INSTANCE=this
			set CUSTOM_RESPOND_GRABBING_FLAG=false
			set CUSTOM_RESPOND_GRABBING_REFRESH_UI=false //.unique
			call s__Event_activate(CONFIG_EVENT_GRABBING)
			
			call s__Grabbing_unregister(this)
			
			call s__Unit_prototype_minusStatus(s__UnitActor_target[this],CONFIG_STATUS_GHOST)
			call s__Unit_prototype_minusStatus(s__UnitActor_target[this],CONFIG_STATUS_GRABBED)
			
			call s__LocationEx_collisionProjection(sc__Object__get_x(s__UnitActor_target[this]) , sc__Object__get_y(s__UnitActor_target[this]))
			call sc__Object_move(s__UnitActor_target[this],(GetLocationX(LocationEx___LOC)) , (GetLocationY(LocationEx___LOC)) , sc__Object__get_z(s__UnitActor_target[this])) // INLINED!!
			
			set s__Unit_prototype_use_gravity[s__UnitActor_target[this]]=s__Unit_prototype_use_gravity[s__UnitActor_target[this]] + 1
			
			if s__Grabbing_unique[this] then
				call sc__Trigger_prototype_deallocate(s__Grabbing_xkey[this])
			endif
  endfunction




