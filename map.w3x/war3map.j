			set s__Buff10g0_main_v2[this]=s__Unit_prototype_getCarculatedStatValue(s__Buff_caster[this],Buff10g0_DAMAGE_STAT1) * Buff10g0_DAMAGE_AMPLIFIER1 * ( 1 + Buff10g0_DAMAGE_PER_LEVEL * s__Buff_level[this] )
			call s__Unit_prototype_divideStatValue(s__Buff_target[this],CONFIG_STAT_MOVEMENT_SPEED , s__Buff10g0_main_v1[this])
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],CONFIG_STAT_EVASION , s__Buff10g0_main_v2[this])
			call s__Unit_prototype_plusStatus(s__Buff_target[this],CONFIG_STATUS_ROOT)
			return true
  endfunction

  function s__Buff10g0_main_onDestroy takes integer this returns nothing
			call s__Unit_prototype_divideStatValue(s__Buff_target[this],CONFIG_STAT_MOVEMENT_SPEED , - s__Buff10g0_main_v1[this])
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],CONFIG_STAT_EVASION , - s__Buff10g0_main_v2[this])
			call s__Unit_prototype_minusStatus(s__Buff_target[this],CONFIG_STATUS_ROOT)
  endfunction


