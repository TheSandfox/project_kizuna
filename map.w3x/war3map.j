			call s__DamageTag_add(Ability20c0__ID , Ability20c0__TAG4)
		endif
		call SaveInteger(Ability__HASH1, (Ability20c0__ID ), s__Ability_INDEX_CAST_TYPE, ( Ability20c0__CAST_TYPE)) // INLINED!!

			call SaveInteger(Damage__HASH, (Ability20c0__ID ), ( s__DamageFlag_INDEX_DAMAGE_TYPE ), ( Ability20c0__DAMAGE_TYPE)) // INLINED!!
