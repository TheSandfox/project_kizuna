		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( OSKEY_B )), ( false)) // INLINED!!
		call TriggerAddCondition(s__User_KEYPRESS[i], Condition(function s__User_keyPress))
		
		set s__User_ENABLE_ABILITY_HOTKEY[i]=1
		
		set s__User_ENABLE_ABILITY_RIGHT_CLICK[i]=1
		set s__User_ENABLE_CHAT[i]=1
 endfunction

