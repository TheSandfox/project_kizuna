  function s__Item_refreshItemNameIndicator takes player p returns nothing
			if GetLocalPlayer() == p then
				if BlzGetMouseFocusUnit() == null then
					call SetTextTagVisibility(Item___ITEM_NAME_INDICATOR, false)
					return
				endif
				if GetUnitTypeId(BlzGetMouseFocusUnit()) != 'idum' then
					call SetTextTagVisibility(Item___ITEM_NAME_INDICATOR, false)
					return
				endif
				call SetTextTagText(Item___ITEM_NAME_INDICATOR, GetUnitName(BlzGetMouseFocusUnit()), 0.02)
				call SetTextTagVisibility(Item___ITEM_NAME_INDICATOR, true)
				call SetTextTagPos(Item___ITEM_NAME_INDICATOR, GetUnitX(BlzGetMouseFocusUnit()), GetUnitY(BlzGetMouseFocusUnit()), 65.)
			endif
  endfunction

  function s__Item_refreshItemNameCallback takes nothing returns nothing
   local integer i= 0
			if GetTriggerEventId() == EVENT_PLAYER_MOUSE_MOVE then
				call s__Item_refreshItemNameIndicator(GetTriggerPlayer())
			elseif GetTriggerEventId() == EVENT_GAME_TIMER_EXPIRED then
				loop
					exitwhen i >= bj_MAX_PLAYERS
					call s__Item_refreshItemNameIndicator(Player(i))
					set i=i + 1
				endloop
			endif
  endfunction

  function s__Item_onInit takes nothing returns nothing
   local integer i= 0
			
			set Item___ITEM_NAME_INDICATOR=CreateTextTag()
			call SetTextTagPermanent(Item___ITEM_NAME_INDICATOR, true)
			call SetTextTagVisibility(Item___ITEM_NAME_INDICATOR, false)
			set Item___ITEM_NAME_INDICATOR_TRIGGER=CreateTrigger()
			loop
				exitwhen i >= bj_MAX_PLAYERS
				call TriggerRegisterPlayerEvent(Item___ITEM_NAME_INDICATOR_TRIGGER, Player(i), EVENT_PLAYER_MOUSE_MOVE)
				set i=i + 1
			endloop
			call TriggerRegisterTimerEvent(Item___ITEM_NAME_INDICATOR_TRIGGER, 0.05, true)
			call TriggerAddCondition(Item___ITEM_NAME_INDICATOR_TRIGGER, Condition(function s__Item_refreshItemNameCallback))
  endfunction




  function s__ItemDynamicDrop_timerAction takes nothing returns nothing
   local integer this= sc__Timer_getData(GetExpiredTimer())
			set s__Curve_value[s__ItemDynamicDrop_cv[this]]=s__Curve_value[s__ItemDynamicDrop_cv[this]] + TIMER_TICK / s__Curve_overtime[s__ItemDynamicDrop_cv[this]]
			if s__Curve_value[s__ItemDynamicDrop_cv[this]] >= 1. then
				call sc__ItemDynamicDrop_deallocate(this)
				return
			else
				if s__ItemDynamicDrop_target[this] > 0 then
					call s__Curve_setX(s__ItemDynamicDrop_cv[this],1 , sc__Object__get_x(s__ItemDynamicDrop_target[this]))
					call s__Curve_setY(s__ItemDynamicDrop_cv[this],1 , sc__Object__get_y(s__ItemDynamicDrop_target[this]))
					call s__Curve_setZ(s__ItemDynamicDrop_cv[this],1 , sc__Object__get_z(s__ItemDynamicDrop_target[this]))
				endif
				call s__Item_prototype__set_x(s__ItemDynamicDrop_it[this],sc__Object__get_x(s__ItemDynamicDrop_cv[this]))
				call s__Item_prototype__set_y(s__ItemDynamicDrop_it[this],sc__Object__get_y(s__ItemDynamicDrop_cv[this]))
				call s__Item_prototype__set_z(s__ItemDynamicDrop_it[this],sc__Object__get_z(s__ItemDynamicDrop_cv[this]))
			endif
  endfunction

  function s__ItemDynamicDrop_create takes integer it,real x1,real y1,real x2,real y2,real overtime returns integer
   local integer this= s__ItemDynamicDrop__allocate()
			set s__ItemDynamicDrop_it[this]=it
			call s__Item_prototype_drop(s__ItemDynamicDrop_it[this],x1 , y1)
			call s__Item_prototype_showWidget(s__ItemDynamicDrop_it[this],false)
			
			call s__LocationEx_collisionProjection(x2 , y2)
			set x2=(GetLocationX(LocationEx___LOC)) // INLINED!!
			set y2=(GetLocationY(LocationEx___LOC)) // INLINED!!
			set s__ItemDynamicDrop_cv[this]=s__CurveBezier2__allocate(x1 , y1 , 0. , x2 , y2 , 0.)
