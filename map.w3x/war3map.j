//Implemented from module ExplosionModule:


		

  function s__ChainLightning_carculateDamage takes integer this,real v returns nothing
			set EVT_CARCULATE_DAMAGE_AMOUNT=v
			call sc__Event_activate(ENUM_EVENT_CARCULATE_DAMAGE)
			set s__ChainLightning_damage[this]=( ( ( EVT_CARCULATE_DAMAGE_AMOUNT + EVT_CARCULATE_DAMAGE_PLUS ) * EVT_CARCULATE_DAMAGE_MULTIPLY ) / EVT_CARCULATE_DAMAGE_DIVIDE ) - EVT_CARCULATE_DAMAGE_MINUS
			set EVT_CARCULATE_DAMAGE_AMOUNT=0.
  endfunction

  function s__ChainLightning_setDamagePosition takes integer this,real x,real y returns nothing
			set s__ChainLightning_damage_x[this]=x
			set s__ChainLightning_damage_y[this]=y
  endfunction

  function s__ChainLightning_applyDamageFlag takes integer this returns nothing
			call sc__Damage_setFlag(s__ChainLightning_damage_type[this] , s__ChainLightning_attack_type[this] , s__ChainLightning_target_type[this] , s__ChainLightning_aoe_type[this] , s__ChainLightning_interval_type[this] , s__ChainLightning_vector_type[this] , s__ChainLightning_onhit_type[this] , s__ChainLightning_range_type[this])
			set EVT_DAMAGE_ID=s__ChainLightning_damage_id[this]
			set EVT_DAMAGE_USE_POSITION=s__ChainLightning_use_damage_position[this]
			if s__ChainLightning_use_damage_position[this] then
				set EVT_DAMAGE_X=s__ChainLightning_damage_x[this]
				set EVT_DAMAGE_Y=s__ChainLightning_damage_y[this]
			endif
  endfunction

  function s__ChainLightning_damageTarget takes integer this,integer target returns real
			call s__ChainLightning_applyDamageFlag(this)
			return sc__Unit_prototype_damageTarget(sc__UnitActor__get_owner(this),target , s__ChainLightning_damage[this] , s__ChainLightning_weapon_type[this])
  endfunction

  function s__ChainLightning_customDamageTarget takes integer this,integer target,real v returns real
			call s__ChainLightning_applyDamageFlag(this)
			return sc__Unit_prototype_damageTarget(sc__UnitActor__get_owner(this),target , v , s__ChainLightning_weapon_type[this])
  endfunction

  function s__ChainLightning_setDamageFlagById takes integer this,integer id returns nothing
			set s__ChainLightning_damage_id[this]=id
			set s__ChainLightning_damage_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_DAMAGE_TYPE))) // INLINED!!
			set s__ChainLightning_attack_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_ATTACK_TYPE))) // INLINED!!
			set s__ChainLightning_interval_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_INTERVAL_TYPE))) // INLINED!!
			set s__ChainLightning_vector_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_VECTOR_TYPE))) // INLINED!!
			set s__ChainLightning_target_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_TARGET_TYPE))) // INLINED!!
			set s__ChainLightning_aoe_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_AOE_TYPE))) // INLINED!!
			set s__ChainLightning_onhit_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_ONHIT_TYPE))) // INLINED!!
			set s__ChainLightning_range_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_RANGE_TYPE))) // INLINED!!
  endfunction

  function s__ChainLightning_DamageFlag_initialize takes integer this returns nothing
			set s__ChainLightning_damage_id[this]=0
			set s__ChainLightning_damage_type[this]=s__Damage_DAMAGE_TYPE_PHYSICAL
			set s__ChainLightning_attack_type[this]=s__Damage_ATTACK_TYPE_BASIC
			set s__ChainLightning_interval_type[this]=s__Damage_INTERVAL_TYPE_SINGLE
			set s__ChainLightning_vector_type[this]=s__Damage_VECTOR_TYPE_OUTTER
			set s__ChainLightning_target_type[this]=s__Damage_TARGET_TYPE_NONTARGET
			set s__ChainLightning_aoe_type[this]=s__Damage_AOE_TYPE_NONAOE
			set s__ChainLightning_onhit_type[this]=s__Damage_ONHIT_TYPE_NONHIT
			set s__ChainLightning_range_type[this]=s__Damage_RANGE_TYPE_MELEE
			set s__ChainLightning_use_damage_position[this]=false
			set s__ChainLightning_damage_x[this]=0.
			set s__ChainLightning_damage_y[this]=0.
			set s__ChainLightning_weapon_type[this]=WEAPON_TYPE_WHOKNOWS
  endfunction



  function s__ChainLightning_affectFilter takes integer this,integer target returns boolean
			if ( not s__ChainLightning_affect_enemy[this] and (IsUnitEnemy(s__Unit_prototype_origin_unit[(target)], ((GetOwningPlayer(s__Unit_prototype_origin_unit[(sc__UnitActor__get_owner(this))]))))) ) then // INLINED!!
				call BJDebugMsg((GetHeroProperName(s__Unit_prototype_origin_unit[(target)]))) // INLINED!!
				return false
			elseif ( not s__ChainLightning_affect_ally[this] and (IsUnitAlly(s__Unit_prototype_origin_unit[(target)], ((GetOwningPlayer(s__Unit_prototype_origin_unit[(sc__UnitActor__get_owner(this))]))))) ) then // INLINED!!
				return false
			elseif ( not s__ChainLightning_affect_invincible[this] and sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[target],ENUM_STATUS_INVINCIBLE) > 0 ) then
				return false
			elseif ( not s__ChainLightning_affect_evasion[this] and sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[target],ENUM_STATUS_EVASION) > 0 ) then
				return false
			elseif ( not s__ChainLightning_affect_self[this] and target == sc__UnitActor__get_owner(this) ) then
				return false
			elseif ( not s__ChainLightning_affect_dead[this] and sc__Unit_prototype_isUnitType(target,UNIT_TYPE_DEAD) ) then
				return false
			else
				return true
			endif
  endfunction

  function s__ChainLightning_AffectFlag_initialize takes integer this returns nothing
			set s__ChainLightning_affect_enemy[this]=true
			set s__ChainLightning_affect_ally[this]=false
			set s__ChainLightning_affect_invincible[this]=false
			set s__ChainLightning_affect_evasion[this]=false
			set s__ChainLightning_affect_self[this]=false
			set s__ChainLightning_affect_dead[this]=false
  endfunction


		

  function s__ChainLightning_rangeFilter takes integer this,integer target returns boolean
			return (IsUnitInRangeXY(s__Unit_prototype_origin_unit[(target)], ((sc__Actor__get_x(this) )*1.0), (( sc__Actor__get_y(this) )*1.0), (( s__ChainLightning_radius_explosion[this])*1.0))) // INLINED!!
  endfunction


		

  function s__ChainLightning_explosionFillUnits takes integer this,group g returns nothing
			call sc__Group_fillUnitsInRange(g , sc__Actor__get_x(this) , sc__Actor__get_y(this) , s__ChainLightning_radius_explosion[this])
  endfunction

  function s__ChainLightning_explosionFilter takes integer this,integer target returns boolean
			if not s__ChainLightning_affectFilter(this,target) then
				return false
			elseif not sc__ChainLightning_rangeFilter(this,target) then
				return false
			elseif not sc__ChainLightning_explosionFilterAdditional(this,target) then
				return false
			else
				return true
			endif
  endfunction

  function s__ChainLightning_explosionAction takes integer this returns nothing
   local integer i= 0
   local unit u= null
   local group g= sc__Group_new()
			call sc__ChainLightning_explosionFillUnits(this,g)
			loop
				set u=BlzGroupUnitAt(g, i)
				exitwhen u == null
				if not IsUnitType(u, UNIT_TYPE_DEAD) then
					if sc__Unit_prototype_get(u) > 0 then
						if s__ChainLightning_explosionFilter(this,sc__Unit_prototype_get(u)) then
							call sc__ChainLightning_executeExplosion(this,sc__Unit_prototype_get(u))
							call GroupAddUnit(s__ChainLightning_group_wave[this], u)
						endif
					endif
				endif
				set i=i + 1
			endloop
			call sc__Group_release(g)
			set g=null
			set u=null
  endfunction

//Implemented from module ChainGlave:

  function s__ChainLightning_explosionFilterAdditional takes integer this,integer target returns boolean
			// if IsUnitInGroup(target.origin_unit,.group_already) then
			// 	call BJDebugMsg(target.name+" : |cffff0000불합격|r")
			// else
			// 	call BJDebugMsg(target.name+" : |cff00ff00합격|r")
			// endif
			return not IsUnitInGroup(s__Unit_prototype_origin_unit[target], s__ChainLightning_group_already[this])
  endfunction

  function s__ChainLightning_executeExplosion takes integer this,integer target returns nothing
			call DoNothing()
  endfunction

  function s__ChainLightning_executeTarget takes integer this,integer target returns nothing
			call sc__ChainLightning_executeChain(this,target)
			
			set s__ChainLightning_count[this]=s__ChainLightning_count[this] - 1
			
			
			
			call GroupAddUnit(s__ChainLightning_group_already[this], s__Unit_prototype_origin_unit[s__UnitActor_target[this]])
			
			call GroupClear(s__ChainLightning_group_wave[this])
			call s__ChainLightning_explosionAction(this)
  endfunction

  function s__ChainLightning_findNextTarget takes integer this returns boolean
			
			set s__ChainLightning_target_previous[this]=s__UnitActor_target[this]
			set s__UnitActor_target[this]=sc__Unit_prototype_get(sc__Group_getNearest(s__ChainLightning_group_wave[this] , sc__Actor__get_x(this) , sc__Actor__get_y(this) , null))
			return s__UnitActor_target[this] != 0
  endfunction


		// stub method explosionFilterAdditional takes Unit_prototype target returns boolean
		// 	return not IsUnitInGroup(target.origin_unit,.group_already)
		// endmethod

		// method executeExplosion takes Unit_prototype target returns nothing
		// 	call DoNothing()
		// endmethod

		// stub method executeTarget takes Unit_prototype target returns nothing
		// 	/*데미지주기*/
		// 	
		// endmethod

  function s__ChainLightning_executeChain takes integer this,integer target returns nothing
			call s__ChainLightning_damageTarget(this,target)
  endfunction

  function s__ChainLightning_killFilter takes integer this returns boolean
			if s__ChainLightning_count[this] <= 0 then
				return true
			else
				if s__ChainLightning_findNextTarget(this) then
					set s__Actor_timeout[this]=0.
					set s__Actor_duration[this]=s__ChainLightning_interval[this]
					call sc__Actor__set_x(this,sc__Object__get_x(s__UnitActor_target[this]))
					call sc__Actor__set_y(this,sc__Object__get_y(s__UnitActor_target[this]))
					return false
				else
					return true
				endif
			endif
  endfunction

  function s__ChainLightning_onComplete takes integer this returns nothing
			
   local integer l= sc__Lightning_createOO(s__ChainLightning_lightning_id[this] , s__ChainLightning_target_previous[this] , s__UnitActor_target[this])
			set s__Lightning_oz1[l]=s__Object_pivot_z[s__ChainLightning_target_previous[this]]
			set s__Lightning_oz2[l]=s__Object_pivot_z[s__UnitActor_target[this]]
			set s__Lightning_duration[l]=0.45
			set s__Lightning_alpha[l]=1.5
			set s__Lightning_fade[l]=1.
			call sc__Lightning_refreshPosition(l)
			//OBJECT.j ChainGlave모듈 참고
			call s__ChainLightning_executeTarget(this,s__UnitActor_target[this])
  endfunction

  function s__ChainLightning_create takes integer caster,integer target,integer level,integer count,real interval,string lightning_id returns integer
   local integer this= s__ChainLightning__allocate(caster , target , sc__Object__get_x(target) , sc__Object__get_y(target) , level , 0.01 , false)
			set s__ChainLightning_lightning_id[this]=lightning_id
			set s__ChainLightning_target_previous[this]=(s__Actor_actor[(this)]) // INLINED!!
			set s__ChainLightning_group_wave[this]=sc__Group_new()
			set s__ChainLightning_group_already[this]=sc__Group_new()
			set s__ChainLightning_count[this]=count
			set s__ChainLightning_interval[this]=interval
			call sc__UnitActor_suspendFree(this)
			return this
  endfunction

  function s__ChainLightning_onDestroy takes integer this returns nothing
			call sc__Group_release(s__ChainLightning_group_wave[this])
			call sc__Group_release(s__ChainLightning_group_already[this])
			set s__ChainLightning_group_wave[this]=null
			set s__ChainLightning_group_already[this]=null
  endfunction



//library ChainLightning ends
//library CustomString:


  function s__CustomString_className takes integer ctype returns string
			return UDG_STAT_COLOR[ENUM_STAT_CONSTANT] + UDG_UNIT_CLASS_NAME[ctype] + "|r"
  endfunction

  function s__CustomString_statName takes integer index returns string
			return UDG_STAT_COLOR[index] + UDG_STAT_NAME[index] + "|r"
  endfunction

  function s__CustomString_statString takes integer index,string s returns string
			return UDG_STAT_COLOR[index] + s + "|r"
  endfunction

  function s__CustomString_statStringReal takes integer index,real v,integer jom returns string
			return UDG_STAT_COLOR[index] + R2SW(v, jom, jom) + "|r"
  endfunction

  function s__CustomString_statStringPercent takes integer index,real v returns string
			return UDG_STAT_COLOR[index] + I2S(MathRound(v * 100.)) + "%|r"
  endfunction

  function s__CustomString_statStringInteger takes integer index,integer v returns string
			return UDG_STAT_COLOR[index] + I2S(v) + "|r"
  endfunction

  function s__CustomString_statTooltip takes integer index,string s returns string
			return UDG_STAT_COLOR[index] + s + "|r"
  endfunction

  function s__CustomString_statTooltipReal takes integer index,real v,integer jom returns string
			return UDG_STAT_COLOR[index] + R2SW(v, jom, jom) + "|r"
  endfunction

  function s__CustomString_statTooltipSecond takes integer index,real v returns string
			return UDG_STAT_COLOR[index] + R2SW(v, 1, 1) + "초|r"
  endfunction

  function s__CustomString_statTooltipPercent takes integer index,real v returns string
			return UDG_STAT_COLOR[index] + R2SW(v * 100., 1, 1) + "%|r"
  endfunction

  function s__CustomString_statTooltipInteger takes integer index,integer v returns string
			return UDG_STAT_COLOR[index] + I2S(v) + "|r"
  endfunction

  function s__CustomString_statusName takes integer index returns string
			return "|cff00ffff" + UDG_STATUS_NAME[index] + "|r"
  endfunction

  function s__CustomString_coloredString takes string cs,string s returns string
			return cs + s + "|r"
  endfunction

  function s__CustomString_shiftTooltip takes string s returns string
			if (LoadBoolean(s__User_HASH, GetPlayerId((GetLocalPlayer() )), GetHandleId(( OSKEY_LSHIFT)))) then // INLINED!!
				return s
			else
				return ""
			endif
  endfunction

  function s__CustomString_shiftStatTooltip takes integer index returns string
			return s__CustomString_shiftTooltip(UDG_STAT_COLOR[index] + "(▲" + UDG_STAT_NAME[index] + ")|r")
