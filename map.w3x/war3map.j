			call BlzFrameSetSize((s__SkillShop_BTN_DONATE ), (( 256 )*1.0) / 1800., (( 56)*1.0) / 1800.) // INLINED!!
			call BlzFrameClearAllPoints(BlzGetFrameByName("SkillShopDonateButtonText", 0))
			call BlzFrameSetPoint(BlzGetFrameByName("SkillShopDonateButtonText", 0), FRAMEPOINT_CENTER, s__SkillShop_BTN_DONATE, FRAMEPOINT_CENTER, (((12)*1.0) / 1800.), 0.) // INLINED!!
			call BlzFrameSetTextAlignment(BlzGetFrameByName("SkillShopDonateButtonText", 0), TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_CENTER)
			call BlzFrameSetText(BlzGetFrameByName("SkillShopDonateButtonText", 0), "|cffffcc002|r |cffffffff: 기부하기 (품질 상승)|r")
			call BlzFrameSetTexture(BlzGetFrameByName("SkillShopDonateButtonIcon", 0), "ui\\widgets\\tooltips\\human\\tooltipgoldicon.blp", 0, true)
			call BlzFrameSetPoint(BlzGetFrameByName("SkillShopDonateButtonIcon", 0), FRAMEPOINT_RIGHT, BlzGetFrameByName("SkillShopDonateButtonText", 0), FRAMEPOINT_LEFT, - 0.005, 0.)
			call BlzFrameSetSize(BlzGetFrameByName("SkillShopDonateButtonIcon", 0), (((24)*1.0) / 1800.), (((24)*1.0) / 1800.)) // INLINED!!
			
			set s__SkillShop_EXP_OUTLINE=BlzCreateFrameByType("BACKDROP", "", s__SkillShop_BTN_DONATE, "", 0)
			call BlzFrameSetTexture(s__SkillShop_EXP_OUTLINE, "replaceabletextures\\teamcolor\\teamcolor16.blp", 0, true)
			set s__SkillShop_EXP_BACKDROP=BlzCreateFrameByType("BACKDROP", "", s__SkillShop_BTN_DONATE, "", 0)
			call BlzFrameSetPoint((s__SkillShop_EXP_BACKDROP ), ( FRAMEPOINT_BOTTOMLEFT ), ( s__SkillShop_BTN_DONATE ), ( FRAMEPOINT_TOPLEFT ), (( 2 + 32 )*1.0) / 1800., (( 2)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((s__SkillShop_EXP_BACKDROP ), (( s__SkillShop_EXP_GAUGE_WIDTH )*1.0) / 1800., (( 16 - 4)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetTexture(s__SkillShop_EXP_BACKDROP, "replaceabletextures\\teamcolor\\teamcolor26.blp", 0, true)
			call BlzFrameSetAlpha(s__SkillShop_EXP_BACKDROP, 200)
			set s__SkillShop_EXP_FILL=BlzCreateFrameByType("BACKDROP", "", s__SkillShop_BTN_DONATE, "", 0)
			call BlzFrameSetPoint(s__SkillShop_EXP_FILL, FRAMEPOINT_BOTTOMLEFT, s__SkillShop_EXP_BACKDROP, FRAMEPOINT_BOTTOMLEFT, 0., 0.)
			call BlzFrameSetTexture(s__SkillShop_EXP_FILL, "replaceabletextures\\teamcolor\\teamcolor23.blp", 0, true)
			call BlzFrameSetVisible(s__SkillShop_EXP_FILL, false)
			set s__SkillShop_EXP_TEXT=BlzCreateFrame("MyText", s__SkillShop_BTN_DONATE, 0, 0)
			call BlzFrameSetPoint(s__SkillShop_EXP_TEXT, FRAMEPOINT_CENTER, s__SkillShop_EXP_BACKDROP, FRAMEPOINT_CENTER, 0., 0.)
			call BlzFrameSetPoint((s__SkillShop_EXP_OUTLINE ), ( FRAMEPOINT_TOPLEFT ), ( s__SkillShop_EXP_BACKDROP ), ( FRAMEPOINT_TOPLEFT ), (( - 2 )*1.0) / 1800., (( 2)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetPoint((s__SkillShop_EXP_OUTLINE ), ( FRAMEPOINT_BOTTOMRIGHT ), ( s__SkillShop_EXP_BACKDROP ), ( FRAMEPOINT_BOTTOMRIGHT ), (( 2 )*1.0) / 1800., (( - 2)*1.0) / 1800.) // INLINED!!
			set s__SkillShop_LEVEL_BACKDROP=BlzCreateFrameByType("BACKDROP", "", s__SkillShop_BTN_DONATE, "", 0)
			call BlzFrameSetSize((s__SkillShop_LEVEL_BACKDROP ), (( 32 )*1.0) / 1800., (( 32)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetPoint(s__SkillShop_LEVEL_BACKDROP, FRAMEPOINT_BOTTOMRIGHT, s__SkillShop_EXP_OUTLINE, FRAMEPOINT_BOTTOMLEFT, 0., 0.)
			call BlzFrameSetTexture(s__SkillShop_LEVEL_BACKDROP, "ui\\console\\human\\human-transport-slot.blp", 0, true)
			set s__SkillShop_LEVEL_TEXT=BlzCreateFrame("MyText", s__SkillShop_BTN_DONATE, 0, 0)
			call BlzFrameSetPoint(s__SkillShop_LEVEL_TEXT, FRAMEPOINT_CENTER, s__SkillShop_LEVEL_BACKDROP, FRAMEPOINT_CENTER, 0., 0.)
			call BlzFrameSetTextAlignment(s__SkillShop_LEVEL_TEXT, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_CENTER)
			
			set s__SkillShop_GOLD_BACKDROP=BlzCreateFrameByType("BACKDROP", "", s__SkillShop_CONTAINER, "", 0)
			call BlzFrameSetTexture(s__SkillShop_GOLD_BACKDROP, "Textures\\black32.blp", 0, true)
			call BlzFrameSetAlpha(s__SkillShop_GOLD_BACKDROP, 128)
			set s__SkillShop_GOLD_TEXT=BlzCreateFrame("MyTextLarge", s__SkillShop_CONTAINER, 0, 0)
			call BlzFrameSetPoint(s__SkillShop_GOLD_TEXT, FRAMEPOINT_TOP, FRAME_SKILL_SHOP_BACKDROP, FRAMEPOINT_BOTTOM, 0.0025 + (((16)*1.0) / 1800.), - 0.005) // INLINED!!
			call BlzFrameSetTextAlignment(s__SkillShop_GOLD_TEXT, TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
			call BlzFrameSetText(s__SkillShop_GOLD_TEXT, "")
			set s__SkillShop_GOLD_ICON=BlzCreateFrameByType("BACKDROP", "", s__SkillShop_CONTAINER, "", 0)
			call BlzFrameSetTexture(s__SkillShop_GOLD_ICON, "ui\\widgets\\tooltips\\human\\tooltipgoldicon.blp", 0, true)
			call BlzFrameSetPoint(s__SkillShop_GOLD_ICON, FRAMEPOINT_RIGHT, s__SkillShop_GOLD_TEXT, FRAMEPOINT_LEFT, - 0.005, 0.)
			call BlzFrameSetSize(s__SkillShop_GOLD_ICON, (((32)*1.0) / 1800.), (((32)*1.0) / 1800.)) // INLINED!!
			
			call BlzFrameSetPoint(s__SkillShop_GOLD_BACKDROP, FRAMEPOINT_TOPRIGHT, s__SkillShop_GOLD_TEXT, FRAMEPOINT_TOPRIGHT, 0.005, 0.005)
			call BlzFrameSetPoint(s__SkillShop_GOLD_BACKDROP, FRAMEPOINT_BOTTOMLEFT, s__SkillShop_GOLD_TEXT, FRAMEPOINT_BOTTOMLEFT, - 0.005 - 0.005 - (((32)*1.0) / 1800.), - 0.005) // INLINED!!
			
			set s__SkillShop_CHANCE_BACKDROP=BlzCreateFrame("MyTextBox", s__SkillShop_BTN_DONATE, 0, 0)
			set s__SkillShop_CHANCE_TEXT=BlzCreateFrame("MyTextSmall", s__SkillShop_BTN_DONATE, 0, 0)
			call BlzFrameSetPoint(s__SkillShop_CHANCE_TEXT, FRAMEPOINT_LEFT, s__SkillShop_BTN_DONATE, FRAMEPOINT_RIGHT, 0.005 + (((16)*1.0) / 1800.), 0.) // INLINED!!
			call BlzFrameSetPoint(s__SkillShop_CHANCE_BACKDROP, FRAMEPOINT_TOPLEFT, s__SkillShop_CHANCE_TEXT, FRAMEPOINT_TOPLEFT, - 0.005, 0.005)
			call BlzFrameSetPoint(s__SkillShop_CHANCE_BACKDROP, FRAMEPOINT_BOTTOMRIGHT, s__SkillShop_CHANCE_TEXT, FRAMEPOINT_BOTTOMRIGHT, 0.005, - 0.005)
			
			set s__SkillShop_BTN_CLOSE=BlzCreateFrame("GenericCloseButton", s__SkillShop_CONTAINER, 0, 0)
			call BlzFrameSetPoint((s__SkillShop_BTN_CLOSE ), ( FRAMEPOINT_TOPLEFT ), ( FRAME_SKILL_SHOP_BACKDROP ), ( FRAMEPOINT_TOPRIGHT ), (( 0 )*1.0) / 1800., (( 0)*1.0) / 1800.) // INLINED!!
			
			set s__SkillShop_KEYPRESS=CreateTrigger()
			call BlzTriggerRegisterFrameEvent(s__SkillShop_KEYPRESS, s__SkillShop_BTN_REFRESH, FRAMEEVENT_CONTROL_CLICK)
			call BlzTriggerRegisterFrameEvent(s__SkillShop_KEYPRESS, s__SkillShop_BTN_REFRESH, FRAMEEVENT_MOUSE_LEAVE)
			call BlzTriggerRegisterFrameEvent(s__SkillShop_KEYPRESS, s__SkillShop_BTN_LUMBER_REFRESH, FRAMEEVENT_CONTROL_CLICK)
			call BlzTriggerRegisterFrameEvent(s__SkillShop_KEYPRESS, s__SkillShop_BTN_LUMBER_REFRESH, FRAMEEVENT_MOUSE_LEAVE)
			call BlzTriggerRegisterFrameEvent(s__SkillShop_KEYPRESS, s__SkillShop_BTN_DONATE, FRAMEEVENT_CONTROL_CLICK)
			call BlzTriggerRegisterFrameEvent(s__SkillShop_KEYPRESS, s__SkillShop_BTN_DONATE, FRAMEEVENT_MOUSE_LEAVE)
			call BlzTriggerRegisterFrameEvent(s__SkillShop_KEYPRESS, s__SkillShop_BTN_CLOSE, FRAMEEVENT_CONTROL_CLICK)
			call BlzTriggerRegisterFrameEvent(s__SkillShop_KEYPRESS, s__SkillShop_BTN_CLOSE, FRAMEEVENT_MOUSE_LEAVE)
			call TriggerRegisterTimerEvent(s__SkillShop_KEYPRESS, 1.0, true)
			call TriggerAddCondition(s__SkillShop_KEYPRESS, Condition(function s__SkillShop_press))
			call TriggerRegisterVariableEvent((s__SkillShop_KEYPRESS ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_KEYPRESS)*1.0)) // INLINED!!
			
  endfunction

  function s__SkillShop_create takes player p returns integer
   local integer this= GetPlayerId(p)
   local integer i= 0
			
			set s__SkillShop_level[this]=1
			set s__SkillShop_exp[this]=0
			set s__SkillShop_exp_max[this]=2
			set s__SkillShop_autorefresh[this]=true
			set s__SkillShop_lumber_add_time[this]=s__SkillShop_LUMBER_ADD_TIME
			set s__SkillShop_visible_flag[this]=false
			
			if not s__SkillShop_ACTIVATED then
				call s__SkillShop_initFrames()
				set s__SkillShop_ACTIVATED=true
			endif
			
			loop
				exitwhen i >= SkillShop___WIDGET_COUNT
				call s__SkillShopWidget_create(s__SkillShop_CONTAINER , Player(this) , i)
				set i=i + 1
			endloop
			
			call s__SkillShop_refreshLumberRefresh(this)
			call s__SkillShop_setLevel(this,1)
			call s__SkillShop_refresh(this)
			call s__SkillShop_refreshGold(this)
			return this
  endfunction

  function s__SkillShop_destroy takes integer this returns nothing

  endfunction

  function s__SkillShop_staticRefreshGold takes nothing returns nothing
   local integer this= GetPlayerId(GOLD_REFRESH_PLAYER)
			call s__SkillShop_refreshGold(this)
  endfunction

  function s__SkillShop_getTierChance takes integer level,integer tier returns integer
   local integer i= level
			if i > CHANCE_LEVEL_MAX then
				set i=CHANCE_LEVEL_MAX
			endif
			if tier == 1 then
				return CHANCE_TIER1[i]
			elseif tier == 2 then
				return CHANCE_TIER2[i]
			elseif tier == 3 then
				return CHANCE_TIER3[i]
			elseif tier == 4 then
				return CHANCE_TIER4[i]
			elseif tier == 5 then
				return CHANCE_TIER5[i]
			endif
			return 0
  endfunction

  function s__SkillShop_initTierChance takes integer level,integer t1,integer t2,integer t3,integer t4,integer t5 returns nothing
			if level < 0 then
				return
			endif
			
			set CHANCE_TIER1[level]=t1
			set CHANCE_TIER2[level]=t2
			set CHANCE_TIER3[level]=t3
			set CHANCE_TIER4[level]=t4
			set CHANCE_TIER5[level]=t5
  endfunction

  function s__SkillShop_onInit takes nothing returns nothing
   local integer i= 1
			call TriggerAddCondition(GOLD_REFRESH_TRIGGER, Condition(function s__SkillShop_staticRefreshGold))
			
			call s__SkillShop_initTierChance(1 , 80 , 20 , 0 , 0 , 0)
			call s__SkillShop_initTierChance(2 , 75 , 25 , 0 , 0 , 0)
			call s__SkillShop_initTierChance(3 , 70 , 25 , 5 , 0 , 0)
			call s__SkillShop_initTierChance(4 , 60 , 30 , 10 , 0 , 0)
			call s__SkillShop_initTierChance(5 , 55 , 30 , 10 , 5 , 0)
			call s__SkillShop_initTierChance(6 , 54 , 25 , 15 , 5 , 1)
			call s__SkillShop_initTierChance(7 , 43 , 25 , 20 , 7 , 5)
			call s__SkillShop_initTierChance(8 , 40 , 25 , 20 , 10 , 5)
			call s__SkillShop_initTierChance(9 , 40 , 25 , 20 , 10 , 5)
			call s__SkillShop_initTierChance(10 , 30 , 20 , 25 , 15 , 10)
			call s__SkillShop_initTierChance(11 , 20 , 20 , 25 , 20 , 15)
			
			loop
				
				exitwhen i > CHANCE_LEVEL_MAX
				set CHANCE_TOTAL[i]=CHANCE_TIER1[i] + CHANCE_TIER2[i] + CHANCE_TIER3[i] + CHANCE_TIER4[i] + CHANCE_TIER5[i]
				set i=i + 1
			endloop
			
			set SkillShop___MAX_EXP[1]=1
			set SkillShop___MAX_EXP[2]=3
			set SkillShop___MAX_EXP[3]=5
			set SkillShop___MAX_EXP[4]=10
			set SkillShop___MAX_EXP[5]=18
			set SkillShop___MAX_EXP[6]=28
			set SkillShop___MAX_EXP[7]=40
			set SkillShop___MAX_EXP[8]=56
			set SkillShop___MAX_EXP[9]=72
			set SkillShop___MAX_EXP[10]=88
			set SkillShop___MAX_EXP[11]=105
  endfunction



//library SkillShop ends
//library SlotChanger:


		




  function s__SlotChanger_getMap takes integer this,integer index returns integer
			return s__SlotChanger_MAP[this * 10 + index]
  endfunction

  function s__SlotChanger_setMap takes integer this,integer index,integer val returns nothing
			set s__SlotChanger_MAP[this * 10 + index]=val
  endfunction

  function s__SlotChanger__get_owner takes integer this returns player
			return Player(this)
  endfunction

  function s__SlotChanger_refresh takes integer this returns nothing
   local integer i= 0
   local framehandle f= null
   local framehandle bf= null
   local integer a= 0
			
			set i=0
			loop
				exitwhen i >= 10
				
				set a=s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[(s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))])],(s__SlotChanger_MAP[(this) * 10 + (i)])) // INLINED!!
				
				set f=BlzGetFrameByName("SlotChangerButtonIcon", i)
				if (s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))]) <= 0 or a <= 0 then // INLINED!!
					if GetLocalPlayer() == Player(this) then
						call BlzFrameSetTexture(f, "Icons\\BTNBlackIcon.blp", 0, true)
					endif
				else
					if GetLocalPlayer() == Player(this) then
						call BlzFrameSetTexture(f, s__Ability_getTypeIconPath(s__Ability_prototype_id[a]), 0, true)
					endif
				endif
				
				set f=s__s__SlotChanger_BUTTON[i]
				
				if s__SlotChanger_state[this] == 0 or s__SlotChanger_state[this] == 2 then
					
					if (s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))]) <= 0 or a <= 0 then // INLINED!!
						if GetLocalPlayer() == Player(this) then
							call BlzFrameSetEnable(f, false)
							call BlzFrameSetText(BlzGetFrameByName("SlotChangerButtonText", i), "|cff999999" + s__User_OSKEY_INDEX_TO_STRING[i] + "|r")
						endif
					
					else
						if GetLocalPlayer() == Player(this) then
							call BlzFrameSetEnable(f, true)
							if s__SlotChanger_state[this] == 0 then
								call BlzFrameSetText(BlzGetFrameByName("SlotChangerButtonText", i), "|cffffcc00" + s__User_OSKEY_INDEX_TO_STRING[i] + "|r")
							elseif s__SlotChanger_state[this] == 2 then
								call BlzFrameSetText(BlzGetFrameByName("SlotChangerButtonText", i), "|cff00ccff" + s__User_OSKEY_INDEX_TO_STRING[i] + "|r")
							endif
						endif
					endif
				
				else
					if (s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))]) <= 0 then // INLINED!!
						if GetLocalPlayer() == Player(this) then
							call BlzFrameSetEnable(f, false)
						endif
					
					else
						set bf=BlzGetFrameByName("SlotChangerButtonText", i)
						if GetLocalPlayer() == Player(this) then
							call BlzFrameSetEnable(f, true)
							if i == s__SlotChanger_first_index[this] then
								call BlzFrameSetText(bf, "|cffffff00" + s__User_OSKEY_INDEX_TO_STRING[i] + "|r")
							else
								call BlzFrameSetText(bf, "|cff00cc00" + s__User_OSKEY_INDEX_TO_STRING[i] + "|r")
							endif
						endif
					endif
				endif
				set i=i + 1
			endloop
			
			if s__SlotChanger_state[this] == 0 or s__SlotChanger_state[this] == 1 then
				set f=BlzGetFrameByName("SlotChangerConfirmButtonText", 0)
				if GetLocalPlayer() == Player(this) then
					call BlzFrameSetText(f, "|cff999999적용|r")
					call BlzFrameSetEnable(s__SlotChanger_CONFIRM_BUTTON, false)
				endif
			elseif s__SlotChanger_state[this] == 2 then
				set f=BlzGetFrameByName("SlotChangerConfirmButtonText", 0)
				if GetLocalPlayer() == Player(this) then
					call BlzFrameSetText(f, "|cff00ccff적용 (G)|r")
					call BlzFrameSetEnable(s__SlotChanger_CONFIRM_BUTTON, true)
				endif
			endif
			set f=null
			set bf=null
  endfunction

  function s__SlotChanger_stateEdited takes integer this,integer target_index returns nothing
   local integer i= (s__SlotChanger_MAP[(this) * 10 + (s__SlotChanger_first_index[this])]) // INLINED!!
			set s__SlotChanger_MAP[(this) * 10 + (s__SlotChanger_first_index[this] )]=( (s__SlotChanger_MAP[(this) * 10 + (target_index)])) // INLINED!!
			set s__SlotChanger_MAP[(this) * 10 + (target_index )]=( i) // INLINED!!
			set s__SlotChanger_state[this]=2
			call s__SlotChanger_refresh(this)
  endfunction

  function s__SlotChanger_stateSelectFirst takes integer this,integer first_index returns nothing
			set s__SlotChanger_first_index[this]=first_index
			set s__SlotChanger_state[this]=1
			call s__SlotChanger_refresh(this)
  endfunction

  function s__SlotChanger_stateDefault takes integer this returns nothing
   local integer i= 0
			set s__SlotChanger_state[this]=0
			set s__SlotChanger_first_index[this]=- 1
			loop
				exitwhen i >= 10
				set s__SlotChanger_MAP[(this) * 10 + (i )]=( i) // INLINED!!
				set i=i + 1
			endloop
			call s__SlotChanger_refresh(this)
  endfunction

  function s__SlotChanger_visibleForPlayer takes integer this,boolean flag returns nothing
			if s__SlotChanger_visible_flag[this] != flag then
				if flag then
					
					call s__SlotChanger_stateDefault(this)
					if (s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))]) > 0 then // INLINED!!
						call s__Unit_prototype_releaseAbilityAll((s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))])) // INLINED!!
					endif
					call EnableTrigger(s__Trigger_main_trigger[s__SlotChanger_keypress_trigger[this]])
					
					call s__Array_add(s__CloseUI_list[(this)],s__CloseUI_ORDER_SLOT_CHANGER)
				else
					
					call DisableTrigger(s__Trigger_main_trigger[s__SlotChanger_keypress_trigger[this]])
					
					call s__Array_eraseFor(s__CloseUI_list[(this)],s__CloseUI_ORDER_SLOT_CHANGER)
				endif
				call s__User_enableAbilityHotkey((Player((this))) , not flag) // INLINED!!
			endif
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(FRAME_SLOT_CHANGER, flag)
			endif
			set s__SlotChanger_visible_flag[this]=flag
  endfunction

  function s__SlotChanger_close takes integer this returns boolean
			if s__SlotChanger_visible_flag[this] then
				call s__SlotChanger_visibleForPlayer(this,false)
				return true
			else
				return false
			endif
  endfunction

  function s__SlotChanger_confirm takes integer this returns nothing
   local integer i= 0
   local integer u= (s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))]) // INLINED!!
			if s__SlotChanger_state[this] != 2 then
				return
			endif
			loop
				exitwhen i >= 10
				set s__s__SlotChanger_ABILITY_TEMP[i]= s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[u],(s__SlotChanger_MAP[(this) * 10 + (i)])) // INLINED!!
				set i=i + 1
			endloop
			set i=0
			loop
				exitwhen i >= 10
				call SaveInteger(Hash___D, (((s__Unit_prototype_ability_data[u]))), ((i ) ), ( ( s__s__SlotChanger_ABILITY_TEMP[i]))) // INLINED!!
				set i=i + 1
			endloop
			set CUSTOM_RESPOND_UI_REFRESH_PLAYER=(Player((this))) // INLINED!!
			call s__Event_activate(CONFIG_EVENT_ABILITY_UI_REFRESH)
			set CUSTOM_RESPOND_UI_REFRESH_PLAYER=null
			//call UI(GetPlayerId(.owner)).refreshAbilityIconsTarget()
			//call stateDefault()
  endfunction

  function s__SlotChanger_switch takes integer this returns nothing
			call s__SlotChanger_visibleForPlayer(this,not s__SlotChanger_visible_flag[this])
  endfunction

  function s__SlotChanger_widgetPress takes integer this,integer i returns nothing
			if s__SlotChanger_state[this] == 0 or s__SlotChanger_state[this] == 2 then
				if s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[(s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))])],(s__SlotChanger_MAP[(this) * 10 + (i)])) <= 0 then // INLINED!!
					return
				endif
				call s__SlotChanger_stateSelectFirst(this,i)
				return
			elseif s__SlotChanger_state[this] == 1 then
				
				
				call s__SlotChanger_stateEdited(this,i)
				return
			endif
  endfunction

  function s__SlotChanger_act takes nothing returns nothing
   local integer this= 0
   local player p= GetTriggerPlayer()
   local integer i= 0
			if (udg_EVENT_VALUE) == CONFIG_EVENT_KEYPRESS then // INLINED!!
				set this=GetPlayerId(CUSTOM_RESPOND_KEYPRESS_PLAYER)
				if CUSTOM_RESPOND_KEYPRESS_KEY == OSKEY_G and CUSTOM_RESPOND_KEYPRESS_PRESS then
					if s__SlotChanger_state[this] == 2 and s__SlotChanger_visible_flag[this] then
						call s__SlotChanger_confirm(this)
					endif
					call s__SlotChanger_switch(this)
					return
				endif
				return
			endif
			set this=GetPlayerId(p)
			if BlzGetTriggerFrame() != null then
				if GetLocalPlayer() == Player(this) then
					if BlzFrameGetEnable(BlzGetTriggerFrame()) then
						call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
						call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
					endif
				endif
				if BlzGetTriggerFrameEvent() != FRAMEEVENT_CONTROL_CLICK then
					return
				endif
				if BlzGetTriggerFrame() == s__SlotChanger_CLOSE_BUTTON then
					call s__SlotChanger_close(this)
					return
				endif
				if BlzGetTriggerFrame() == s__SlotChanger_CONFIRM_BUTTON then
					call s__SlotChanger_confirm(this)
					call s__SlotChanger_close(this)
					return
				endif
				loop
					exitwhen i >= 10
					if BlzGetTriggerFrame() == s__s__SlotChanger_BUTTON[i] then
						call s__SlotChanger_widgetPress(this,i)
						return
					endif
					set i=i + 1
				endloop
				return
			endif
  endfunction

  function s__SlotChanger_keypressCallback takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if CUSTOM_RESPOND_KEYPRESS_PLAYER != (Player((this))) then // INLINED!!
				return
			endif
			if s__User_oskey2Index(CUSTOM_RESPOND_KEYPRESS_KEY) <= CONFIG_ABILITY_SIZE and CUSTOM_RESPOND_KEYPRESS_PRESS then
				call s__SlotChanger_widgetPress(this,s__User_oskey2Index(CUSTOM_RESPOND_KEYPRESS_KEY))
				return
			endif
			return
  endfunction

  function s__SlotChanger_initFrames takes nothing returns nothing
   local integer i= 0
   local framehandle f= null
			set s__SlotChanger_CONTAINER=BlzCreateFrameByType("FRAME", "", FRAME_SLOT_CHANGER, "", 0)
			call BlzFrameSetPoint(s__SlotChanger_CONTAINER, FRAMEPOINT_TOPLEFT, FRAME_SLOT_CHANGER, FRAMEPOINT_TOPLEFT, 0., 0.)
			
			loop
				exitwhen i >= 10
				
				set f=BlzCreateFrame("SlotChangerButton", s__SlotChanger_CONTAINER, 0, i)
				call BlzFrameSetAllPoints(f, s__FRAME_ABILITY_ICON[i])
				//call BlzFrameSetPointPixel(f,FRAMEPOINT_BOTTOMLEFT,LoadFrameHandle(UI.HASH,this,UI.INDEX_SLOT_CHANGER_ICON+i),FRAMEPOINT_BOTTOMLEFT,-4,-4/*Math.px2Size(16)*/)
				//call BlzFrameSetSize(f,Math.px2Size(48),Math.px2Size(48))
				call BlzTriggerRegisterFrameEvent(s__SlotChanger_KEYPRESS, f, FRAMEEVENT_CONTROL_CLICK)
				call BlzTriggerRegisterFrameEvent(s__SlotChanger_KEYPRESS, f, FRAMEEVENT_MOUSE_LEAVE)
				set s__s__SlotChanger_BUTTON[i]= f
				
				set f=BlzGetFrameByName("SlotChangerButtonIcon", i)
				call BlzFrameSetSize((f ), (( 48 )*1.0) / 1800., (( 48)*1.0) / 1800.) // INLINED!!
				
				set f=BlzGetFrameByName("SlotChangerButtonTextBackdrop", i)
				call BlzFrameSetSize((f ), (( 20 )*1.0) / 1800., (( 20)*1.0) / 1800.) // INLINED!!
				//call BlzFrameSetAlpha(f,192)
				
				set f=BlzGetFrameByName("SlotChangerButtonText", i)
				call BlzFrameSetText(f, "|cffffcc00" + s__User_OSKEY_INDEX_TO_STRING[i] + "|r")
				call BlzFrameSetTextAlignment(f, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_CENTER)
				set i=i + 1
			endloop
			
			set s__SlotChanger_CONFIRM_BUTTON=BlzCreateFrame("SlotChangerConfirmButton", s__SlotChanger_CONTAINER, 0, 0)
			call BlzFrameSetPoint(s__SlotChanger_CONFIRM_BUTTON, FRAMEPOINT_TOP, FRAME_SLOT_CHANGER, FRAMEPOINT_TOP, 0, - (((12)*1.0) / 1800.)) // INLINED!!
			call BlzFrameSetSize(s__SlotChanger_CONFIRM_BUTTON, (((192)*1.0) / 1800.), (((48)*1.0) / 1800.)) // INLINED!!
			call BlzTriggerRegisterFrameEvent(s__SlotChanger_KEYPRESS, s__SlotChanger_CONFIRM_BUTTON, FRAMEEVENT_CONTROL_CLICK)
			call BlzTriggerRegisterFrameEvent(s__SlotChanger_KEYPRESS, s__SlotChanger_CONFIRM_BUTTON, FRAMEEVENT_MOUSE_LEAVE)
			set f=BlzGetFrameByName("SlotChangerConfirmButtonText", 0)
