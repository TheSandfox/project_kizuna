   function s__Ability20c0_actor_onComplete takes integer this returns nothing
    local integer b= 0
				set s__MeleeAttack_damage[this]=( ( s__Unit_prototype_getCalculatedStatValue((s__Actor_actor[((this))]),Ability20c0__DAMAGE_STAT1) * Ability20c0__DAMAGE_AMPLIFIER1 ) + ( s__Unit_prototype_getCalculatedStatValue((s__Actor_actor[((this))]),Ability20c0__DAMAGE_STAT2) * Ability20c0__DAMAGE_AMPLIFIER2 ) ) * ( 1 + Ability20c0__DAMAGE_PER_LEVEL * ( s__UnitActor_level[this] ) ) // INLINED!!
				call s__MeleeAttack_damageTarget(this,s__UnitActor_target[this])
				call s__Effect_kill(s__Effect_setScale(s__Effect_create(Ability20c0__EFFECT_PATH1 , sc__Object__get_x(s__UnitActor_target[this]) , sc__Object__get_y(s__UnitActor_target[this]) , sc__Object__get_z(s__UnitActor_target[this]) + s__Object_pivot_z[s__UnitActor_target[this]] , 270.),2.5))
				// call Effect.create(EFFECT_PATH2,.caster.x,.caster.y,.caster.z+.caster.pivot_z,Math.anglePoints(.caster.x,.caster.y,.target.x,.target.y)).setScale(2.5).kill()
				set b=s__Buff_add((s__Actor_actor[(this)]) , s__UnitActor_target[this] , Ability20c0__ID , s__UnitActor_level[this] , Ability20c0__DURATION) // INLINED!!
				call sc__Buff_intervalAction(b)
				call s__Backswing_create((s__Actor_actor[(this)])) // INLINED!!
   endfunction
	
   function s__Ability20c0_actor_create takes integer caster,integer target,integer level returns integer
    local integer this= s__Ability20c0_actor__allocate(caster , target)
    local real angle= s__Math_anglePoints(sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , sc__Object__get_x(s__UnitActor_target[this]) , sc__Object__get_y(s__UnitActor_target[this])) // INLINED!!
				set s__UnitActor_level[this]=level
				call s__MeleeAttack_setDamageFlagById(this,Ability20c0__ID)
				set s__MeleeAttack_weapon_type[this]=WEAPON_TYPE_METAL_MEDIUM_SLICE
				return this
   endfunction

	

//textmacro instance: abilityTooltip20c0()
function s__Ability20c0_main_relativeTooltip takes integer this,integer caster returns string
	return "대상에게 |cffff9900" + R2SW(1.05 * s__Unit_prototype_getCalculatedStatValue(caster,ENUM_STAT_ATTACK) * ( 1 + 0.07 * s__Ability_prototype_level[this] ), 2, 2) + "|r" + s__CustomString_shiftStatTooltip(ENUM_STAT_ATTACK) + "의 피해를 입히고 |cffffffff5.0초|r 동안 대상을 중독시켜 매 초 |cffff9900" + R2SW(0.2 * s__Unit_prototype_getCalculatedStatValue(caster,ENUM_STAT_ACCURACY) * ( 1 + 0.07 * s__Ability_prototype_level[this] ), 2, 2) + "|r" + s__CustomString_shiftStatTooltip(ENUM_STAT_ACCURACY) + " 에 해당하는 |r계열 피해를 입힙니다."
endfunction
//end of: abilityTooltip20c0()

