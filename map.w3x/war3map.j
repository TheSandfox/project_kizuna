			set s__CloseUI_list[this]=s__Array_create()
			return this
  endfunction

  function s__CloseUI_onInit takes nothing returns nothing
			set s__CloseUI_ESC_TRIGGER=CreateTrigger()
			call TriggerAddCondition(s__CloseUI_ESC_TRIGGER, Condition(function s__CloseUI_act))
  endfunction



