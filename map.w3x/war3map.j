function s__Ability10y0_main_relativeTooltip takes integer this,integer caster returns string
	return "대상에게 |cffff9900" + R2SW(( 0.75 * s__Unit_prototype_getCarculatedStatValue(caster,CONFIG_STAT_ATTACK) + 0.01 * s__Unit_prototype_getCarculatedStatValue(caster,CONFIG_STAT_MAXHP) ) * ( 1 + 0.06 * s__Ability_prototype_level[this] ), 2, 2) + "|r" + s__CustomString_shiftStatTooltip(CONFIG_STAT_ATTACK) + s__CustomString_shiftStatTooltip(CONFIG_STAT_MAXHP) + "의 피해를 입힙니다. 대상은 |cffffffff4.0초|r 동안 |cff00ff00최대체력|r|cff00ff00이 " + R2SW(0.025 * s__Unit_prototype_getCarculatedStatValue(caster,CONFIG_STAT_MAXHP) * ( 1 + 0.06 * s__Ability_prototype_level[this] ), 2, 2) + "|r 감소합니다.\n\n - 해당 약화효과는 중첩됩니다."
endfunction
