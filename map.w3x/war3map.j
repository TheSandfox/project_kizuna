		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( OSKEY_S )), ( false)) // INLINED!!
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( OSKEY_H )), ( false)) // INLINED!!
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( OSKEY_LCONTROL )), ( false)) // INLINED!!
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( OSKEY_LSHIFT )), ( false)) // INLINED!!
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( OSKEY_SPACE )), ( false)) // INLINED!!
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( OSKEY_Z )), ( false)) // INLINED!!
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( OSKEY_X )), ( false)) // INLINED!!
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( OSKEY_C )), ( false)) // INLINED!!
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( OSKEY_V )), ( false)) // INLINED!!
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( OSKEY_T )), ( false)) // INLINED!!
