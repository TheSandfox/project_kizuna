  endfunction
		
  function s__Buff10d0_main_init takes integer this returns boolean
   local real v1= ( (s__Unit_prototype_getCarculatedStatValue((s__Buff_caster[this]),CONFIG_STAT_HPREGEN)) * Buff10d0_DAMAGE_AMPLIFIER1 ) * ( 1 + Buff10d0_DAMAGE_PER_LEVEL * s__Buff_level[this] ) // INLINED!!
   local real v2= Buff10d0_DATA_REAL1 + Buff10d0_DATA_REAL2 * s__Buff_level[this]
			call s__Unit_prototype_plusStatValue(s__Buff_target[this],CONFIG_STAT_HPREGEN , v1)
			set s__Buff10d0_main_v1[this]=s__Buff10d0_main_v1[this] + v1
			call s__Unit_prototype_multiplyStatValue(s__Buff_target[this],CONFIG_STAT_ATTACK , v2)
			set s__Buff10d0_main_v2[this]=s__Buff10d0_main_v2[this] + v2
			call s__Buff_addEffect(this,s__Effect_createAttatched(Buff10d0_EFFECT_PATH1 , s__Unit_prototype_origin_unit[s__Buff_target[this]] , "chest"))
			return true
