//library AbilityManager:







  function s__AbilityManager__get_owner takes integer this returns player
			return Player(this)
  endfunction

  function s__AbilityManager_refreshSkillpoint takes integer this returns nothing
			if GetLocalPlayer() == Player(this) then
				
				call BlzFrameSetVisible(AbilityManager___SKILLPOINT_SMALL_TEXT, sc__Unit_getUpgradePoint(s__AbilityManager_target[this],s__AbilityManager_upgrade_mode[this]) > 0)
				call BlzFrameSetVisible(AbilityManager___SKILLPOINT_SMALL_BACKDROP, sc__Unit_getUpgradePoint(s__AbilityManager_target[this],s__AbilityManager_upgrade_mode[this]) > 0)
				call BlzFrameSetText(AbilityManager___SKILLPOINT_SMALL_TEXT, "|cffff9900+" + I2S(sc__Unit_getUpgradePoint(s__AbilityManager_target[this],s__AbilityManager_upgrade_mode[this])) + "|r")
				if s__AbilityManager_page[this] == s__AbilityManager_PAGE_UPGRADE then
					
					if s__AbilityManager_upgrade_mode[this] == CONFIG_UPGRADE_SKILL_POINT then
						call BlzFrameSetTexture(AbilityManager___SKILLPOINT_BACKDROP, "replaceabletextures\\commandbuttons\\BTNAbility_Gem_Orange.blp", 0, true)
					elseif s__AbilityManager_upgrade_mode[this] == CONFIG_UPGRADE_LUCK then
						call BlzFrameSetTexture(AbilityManager___SKILLPOINT_BACKDROP, "replaceabletextures\\commandbuttons\\BTNAbility_Gem_Green.blp", 0, true)
					elseif s__AbilityManager_upgrade_mode[this] == CONFIG_UPGRADE_EXP then
						call BlzFrameSetTexture(AbilityManager___SKILLPOINT_BACKDROP, "replaceabletextures\\commandbuttons\\BTNAbility_Gem_Blue.blp", 0, true)
					endif
					call BlzFrameSetText(AbilityManager___SKILLPOINT_TEXT, CUSTOM_STRING_UPGRADE_COLOR[s__AbilityManager_upgrade_mode[this]] + CUSTOM_STRING_UPGRADE_NAME[s__AbilityManager_upgrade_mode[this]] + ":\n\n" + I2S(sc__Unit_getUpgradePoint(s__AbilityManager_target[this],s__AbilityManager_upgrade_mode[this])) + "|r")
				elseif s__AbilityManager_page[this] == s__AbilityManager_PAGE_EXTRACT then
					
					call BlzFrameSetTexture(AbilityManager___SKILLPOINT_BACKDROP, "replaceabletextures\\commandbuttons\\BTNAbility_Gem_Purple.blp", 0, true)
					call BlzFrameSetText(AbilityManager___SKILLPOINT_TEXT, "|cffcc00cc망각의 파편:\n\n" + I2S(s__Unit_removepoint[s__AbilityManager_target[this]]) + "|r")
				endif
			endif
  endfunction

  function s__AbilityManager_refreshSkillpointCallback takes nothing returns nothing
   local integer this= GetPlayerId(s__AbilityManager_REFRESH_SKILLPOINT_PLAYER)
			call s__AbilityManager_refreshSkillpoint(this)
  endfunction

  function s__AbilityManager_refreshAbilityIcons takes integer this returns nothing
   local integer i= 0
   local integer a= 0
   local framehandle f= null
			
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				set a=s__SimpleList_get(s__AbilityManager_list[this],i)
				if a <= 0 then
					
					if GetLocalPlayer() == Player(this) then
						call BlzFrameSetTexture(AbilityManager___ABILITY_ICON[i], "Icons\\BTNBlackIcon.blp", 0, true)
						call BlzFrameSetVisible(AbilityManager___ABILITY_LEVEL_TEXT[i], false)
						call BlzFrameSetVisible(AbilityManager___ABILITY_LEVEL_BUTTON[i], false)
						call BlzFrameSetVisible(AbilityManager___ABILITY_TIER_BORDER[i], false)
						call BlzFrameSetVisible(AbilityManager___ABILITY_REMOVE_BUTTON[i], false)
					endif
				else
					
					if GetLocalPlayer() == Player(this) then
						call BlzFrameSetTexture(AbilityManager___ABILITY_ICON[i], sc__Ability_getTypeIconPath(s__Ability_prototype_id[a]), 0, true)
						call BlzFrameSetVisible(AbilityManager___ABILITY_LEVEL_TEXT[i], true)
						call BlzFrameSetVisible(AbilityManager___ABILITY_LEVEL_BUTTON[i], true)
						call BlzFrameSetVisible(AbilityManager___ABILITY_TIER_BORDER[i], true)
						call BlzFrameSetTexture(AbilityManager___ABILITY_TIER_BORDER[i], "Textures\\ability_border_tier" + I2S((LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER))) + ".blp", 0, true) // INLINED!!
					endif
					if s__AbilityManager_page[this] == s__AbilityManager_PAGE_UPGRADE then
						
						
						if s__Ability_prototype_level[a] >= s__Ability_level_max[a] then
							if GetLocalPlayer() == Player(this) then
								call BlzFrameSetText(AbilityManager___ABILITY_LEVEL_TEXT[i], "|cffffff00Lv. Max|r")
							endif
						else
							if GetLocalPlayer() == Player(this) then
								call BlzFrameSetText(AbilityManager___ABILITY_LEVEL_TEXT[i], "|cffffffffLv. " + I2S(s__Ability_prototype_level[a]) + "|r|cff999999/" + I2S(s__Ability_level_max[a]) + "|r")
							endif
						endif
					elseif s__AbilityManager_page[this] == s__AbilityManager_PAGE_EXTRACT then
						
						
						if GetLocalPlayer() == Player(this) then
							if s__Ability_signature[a] then
								call BlzFrameSetText(AbilityManager___ABILITY_LEVEL_TEXT[i], "|cffcc0000제거 불가|r")
							else
								call BlzFrameSetText(AbilityManager___ABILITY_LEVEL_TEXT[i], "Lv. " + I2S(s__Ability_prototype_level[a]))
							endif
						endif
					endif
					
					set f=BlzGetFrameByName("AbilityManagerLevelUpButtonText", i)
					if (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER)) <= 0 or s__Ability_prototype_level[a] >= s__Ability_level_max[a] or sc__Unit_getUpgradePoint(s__AbilityManager_target[this],s__AbilityManager_upgrade_mode[this]) < (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER)) then // INLINED!!
						
						if GetLocalPlayer() == Player(this) then
							call BlzFrameSetEnable(AbilityManager___ABILITY_LEVEL_BUTTON[i], false)
							call BlzFrameSetText(f, "|cff999999▲" + I2S((LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER))) + "|r") // INLINED!!
						endif
					else
						
						if GetLocalPlayer() == Player(this) then
							call BlzFrameSetEnable(AbilityManager___ABILITY_LEVEL_BUTTON[i], true)
							call BlzFrameSetText(f, CUSTOM_STRING_UPGRADE_COLOR[s__AbilityManager_upgrade_mode[this]] + "▲" + I2S((LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER))) + "|r") // INLINED!!
						endif
					endif
					
					set f=BlzGetFrameByName("AbilityManagerRemoveButtonText", i)
					if s__Ability_prototype_level[a] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER)) > 0 and not s__Ability_signature[a] then // INLINED!!
						
						if GetLocalPlayer() == Player(this) then
							call BlzFrameSetVisible(AbilityManager___ABILITY_REMOVE_BUTTON[i], true)
							if s__Unit_removepoint[s__AbilityManager_target[this]] >= s__Ability_prototype_level[a] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER)) then // INLINED!!
								call BlzFrameSetText(f, "|cffcc00cc▼" + I2S(s__Ability_prototype_level[a] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER))) + "|r") // INLINED!!
								call BlzFrameSetEnable(AbilityManager___ABILITY_REMOVE_BUTTON[i], true)
							else
								call BlzFrameSetText(f, "|cff999999▼" + I2S(s__Ability_prototype_level[a] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER))) + "|r") // INLINED!!
								call BlzFrameSetEnable(AbilityManager___ABILITY_REMOVE_BUTTON[i], false)
							endif
						endif
					else
						if GetLocalPlayer() == Player(this) then
							call BlzFrameSetVisible(AbilityManager___ABILITY_REMOVE_BUTTON[i], false)
						endif
					endif
				endif
				set i=i + 1
			endloop
			
			call s__AbilityManager_refreshSkillpoint(this)
			set f=null
  endfunction

  function s__AbilityManager_loadAbility takes integer this returns nothing
   local integer i= 0
			if s__AbilityManager_target[this] <= 0 then
				call s__SimpleList_clear(s__AbilityManager_list[this])
			else
				loop
					exitwhen i >= CONFIG_ABILITY_SIZE
					call s__SimpleList_setData(s__AbilityManager_list[this],i , s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[s__AbilityManager_target[this]],i))
					set i=i + 1
				endloop
			endif
			call s__AbilityManager_refreshAbilityIcons(this)
  endfunction

  function s__AbilityManager_setTarget takes integer this,integer u returns nothing
			set s__AbilityManager_target[this]=u
			call s__AbilityManager_loadAbility(this)
  endfunction

  function s__AbilityManager_levelButtonPress takes integer this,integer index,integer upgrade_type returns nothing
   local integer a= s__SimpleList_get(s__AbilityManager_list[this],index)
			if a <= 0 then
				
				return
			else
				
				if s__Ability_prototype_level[a] >= s__Ability_level_max[a] then
					
					return
				endif
				if sc__Unit_getUpgradePoint(s__AbilityManager_target[this],upgrade_type) < (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER)) then // INLINED!!
					
					return
				endif
				call sc__Unit_setUpgradePoint(s__AbilityManager_target[this],upgrade_type , sc__Unit_getUpgradePoint(s__AbilityManager_target[this],upgrade_type) - (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER))) // INLINED!!
				call SaveInteger(Ability__HASH2, (a), s__Ability_INDEX_UPGRADE_POINT + (upgrade_type ), ( (LoadInteger(Ability__HASH2, (a), s__Ability_INDEX_UPGRADE_POINT + (upgrade_type))) + (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER)))) // INLINED!!
				call sc__Ability_prototype_addLevel(a,1)
				
				call sc__Effect_setDuration(sc__AttatchedEffect_create("Abilities\\Spells\\Items\\AIem\\AIemTarget.mdl" , s__AbilityManager_target[this]),2.0)
				set CUSTOM_RESPOND_UI_REFRESH_PLAYER=(Player((this))) // INLINED!!
				call s__Event_activate(CONFIG_EVENT_ABILITY_UI_REFRESH)
				set CUSTOM_RESPOND_UI_REFRESH_PLAYER=null
				return
			endif
  endfunction

  function s__AbilityManager_removeButtonPress takes integer this,integer index returns nothing
   local integer a= s__SimpleList_get(s__AbilityManager_list[this],index)
   local boolean result
			if a <= 0 then
				
				return
			else
				if s__Ability_signature[a] then
					
					return
				endif
				if s__Unit_removepoint[s__AbilityManager_target[this]] < s__Ability_prototype_level[a] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER)) then // INLINED!!
					
					return
				endif
				set result=s__AbilityMix_extract(a)
				if result then
					set s__Unit_removepoint[s__AbilityManager_target[this]]=s__Unit_removepoint[s__AbilityManager_target[this]] - ( s__Ability_prototype_level[a] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER)) ) // INLINED!!
				endif
				return
			endif
  endfunction

  function s__AbilityManager_setAbilityMixResult takes integer this,integer aid returns nothing
   local integer i= 0
   local integer recipe= 0
			
			if aid == s__AbilityMix_LEVEL then
				
				set i=s__AbilityMixElement_getLevel(s__AbilityManager_ability_mix_element1[this]) + s__AbilityMixElement_getLevel(s__AbilityManager_ability_mix_element2[this])
				if i > (LoadInteger(Ability__HASH1, (s__AbilityMixElement_getId(s__AbilityManager_ability_mix_element1[this])), s__Ability_INDEX_MAX_LEVEL)) then // INLINED!!
					set i=(LoadInteger(Ability__HASH1, (s__AbilityMixElement_getId(s__AbilityManager_ability_mix_element1[this])), s__Ability_INDEX_MAX_LEVEL)) // INLINED!!
				endif
			elseif aid == s__AbilityMix_RANDOM then
				
				set i=s__AbilityMix_carculateMixLevel(s__AbilityManager_ability_mix_element1[this] , s__AbilityManager_ability_mix_element2[this])
			elseif aid > 0 then
				
				set i=s__AbilityMix_carculateMixLevel(s__AbilityManager_ability_mix_element1[this] , s__AbilityManager_ability_mix_element2[this])
				set recipe=s__AbilityMix_getRecipe(s__AbilityMixElement_getId(s__AbilityManager_ability_mix_element1[this]) , s__AbilityMixElement_getId(s__AbilityManager_ability_mix_element2[this]))
			endif
			
			if GetLocalPlayer() == Player(this) then
				if aid == s__AbilityMix_EMPTY then
					
					call BlzFrameSetTexture(AbilityManager___ABILITY_MIX_BACKDROP[2], "Icons\\BTNBlackIcon.blp", 0, true)
					call BlzFrameSetVisible(AbilityManager___ABILITY_MIX_TIER_BORDER[2], false)
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[0], "Lv. " + I2S(s__AbilityMixElement_getLevel(s__AbilityManager_ability_mix_element1[this])) + " " + s__AbilityMixElement_getName(s__AbilityManager_ability_mix_element1[this]))
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[1], "Lv. " + I2S(s__AbilityMixElement_getLevel(s__AbilityManager_ability_mix_element2[this])) + " " + s__AbilityMixElement_getName(s__AbilityManager_ability_mix_element2[this]))
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[2], "")
				elseif aid == s__AbilityMix_LEVEL then
					
					call BlzFrameSetTexture(AbilityManager___ABILITY_MIX_BACKDROP[2], sc__Ability_getTypeIconPath(s__AbilityMixElement_getId(s__AbilityManager_ability_mix_element1[this])), 0, true)
					call BlzFrameSetTexture(AbilityManager___ABILITY_MIX_TIER_BORDER[2], "Textures\\ability_border_tier" + I2S((LoadInteger(Ability__HASH1, (s__AbilityMixElement_getId(s__AbilityManager_ability_mix_element1[this])), s__Ability_INDEX_TIER))) + ".blp", 0, true) // INLINED!!
					call BlzFrameSetVisible(AbilityManager___ABILITY_MIX_TIER_BORDER[2], true)
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[0], "Lv. " + I2S(s__AbilityMixElement_getLevel(s__AbilityManager_ability_mix_element1[this])) + " " + s__AbilityMixElement_getName(s__AbilityManager_ability_mix_element1[this]))
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[1], "Lv. " + I2S(s__AbilityMixElement_getLevel(s__AbilityManager_ability_mix_element2[this])) + " " + s__AbilityMixElement_getName(s__AbilityManager_ability_mix_element2[this]))
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[2], "Lv. " + I2S(i) + " " + s__AbilityMixElement_getName(s__AbilityManager_ability_mix_element1[this]))
				elseif aid == s__AbilityMix_DISABLED then
					
					call BlzFrameSetTexture(AbilityManager___ABILITY_MIX_BACKDROP[2], "ReplaceableTextures\\CommandButtons\\BTNCancel.blp", 0, true)
					call BlzFrameSetVisible(AbilityManager___ABILITY_MIX_TIER_BORDER[2], false)
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[0], "Lv. " + I2S(s__AbilityMixElement_getLevel(s__AbilityManager_ability_mix_element1[this])) + " " + s__AbilityMixElement_getName(s__AbilityManager_ability_mix_element1[this]))
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[1], "Lv. " + I2S(s__AbilityMixElement_getLevel(s__AbilityManager_ability_mix_element2[this])) + " " + s__AbilityMixElement_getName(s__AbilityManager_ability_mix_element2[this]))
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[2], "|cffff0000합성 불가|r")
				elseif aid == s__AbilityMix_RANDOM then
					
					call BlzFrameSetTexture(AbilityManager___ABILITY_MIX_BACKDROP[2], "ReplaceableTextures\\CommandButtons\\BTNSelectHeroOn.blp", 0, true)
					call BlzFrameSetTexture(AbilityManager___ABILITY_MIX_TIER_BORDER[2], "Textures\\ability_border_tier" + I2S(s__AbilityMixElement_getTier(s__AbilityManager_ability_mix_element1[this]) + s__AbilityMixElement_getTier(s__AbilityManager_ability_mix_element2[this])) + ".blp", 0, true)
					call BlzFrameSetVisible(AbilityManager___ABILITY_MIX_TIER_BORDER[2], true)
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[0], "Lv. " + I2S(s__AbilityMixElement_getLevel(s__AbilityManager_ability_mix_element1[this])) + " " + s__AbilityMixElement_getName(s__AbilityManager_ability_mix_element1[this]) + "\n(필요 레벨 : " + I2S(s__AbilityMix_LEVEL_REQUIRE) + ")")
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[1], "Lv. " + I2S(s__AbilityMixElement_getLevel(s__AbilityManager_ability_mix_element2[this])) + " " + s__AbilityMixElement_getName(s__AbilityManager_ability_mix_element2[this]) + "\n(필요 레벨 : " + I2S(s__AbilityMix_LEVEL_REQUIRE) + ")")
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[2], "Lv. " + I2S(i) + " ???")
				else
					
					call BlzFrameSetTexture(AbilityManager___ABILITY_MIX_BACKDROP[2], sc__Ability_getTypeIconPath(aid), 0, true)
					call BlzFrameSetTexture(AbilityManager___ABILITY_MIX_TIER_BORDER[2], "Textures\\ability_border_tier" + I2S((LoadInteger(Ability__HASH1, (aid), s__Ability_INDEX_TIER))) + ".blp", 0, true) // INLINED!!
					call BlzFrameSetVisible(AbilityManager___ABILITY_MIX_TIER_BORDER[2], true)
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[0], "Lv. " + I2S(s__AbilityMixElement_getLevel(s__AbilityManager_ability_mix_element1[this])) + " " + s__AbilityMixElement_getName(s__AbilityManager_ability_mix_element1[this]) + "\n(필요 레벨 : " + I2S(s__AbilityMix_main_level[recipe]) + ")")
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[1], "Lv. " + I2S(s__AbilityMixElement_getLevel(s__AbilityManager_ability_mix_element2[this])) + " " + s__AbilityMixElement_getName(s__AbilityManager_ability_mix_element2[this]) + "\n(필요 레벨 : " + I2S(s__AbilityMix_sub_level[recipe]) + ")")
					call BlzFrameSetText(AbilityManager___ABILITY_MIX_SUB[2], "Lv. " + I2S(i) + " " + (LoadStr(Ability__HASH1, (aid), s__Ability_INDEX_NAME))) // INLINED!!
				endif
			endif
			set i=0
  endfunction

		
  function s__AbilityManager_refreshRecipe takes integer this returns nothing
   local integer i= 0
   local integer recipe= s__AbilityMix_getRecommendRecipe(s__AbilityMixElement_getId(s__AbilityManager_ability_mix_element1[this]) , 0)
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(AbilityManager___RECIPE_CONTAINER, s__AbilityManager_ability_mix_element1[this] > 0 and recipe >= 0)
			endif
			loop
				exitwhen i >= 4
				set recipe=s__AbilityMix_getRecommendRecipe(s__AbilityMixElement_getId(s__AbilityManager_ability_mix_element1[this]) , i)
				if GetLocalPlayer() == Player(this) then
					call BlzFrameSetVisible(s__AbilityManager___RECIPE_ROW[i], recipe >= 0)
					if recipe >= 0 then
						
						call BlzFrameSetTexture(s__AbilityManager___RECIPE_MAIN[i], sc__Ability_getTypeIconPath(s__AbilityMix_main[recipe]), 0, true)
						call BlzFrameSetTexture(s__AbilityManager___RECIPE_MAIN_BORDER[i], ("Textures\\ability_border_tier" + I2S(((LoadInteger(Ability__HASH1, (s__AbilityMix_main[recipe]), s__Ability_INDEX_TIER)))) + ".blp"), 0, true) // INLINED!!
						call BlzFrameSetTexture(s__AbilityManager___RECIPE_SUB[i], sc__Ability_getTypeIconPath(s__AbilityMix_sub[recipe]), 0, true)
						call BlzFrameSetTexture(s__AbilityManager___RECIPE_SUB_BORDER[i], ("Textures\\ability_border_tier" + I2S(((LoadInteger(Ability__HASH1, (s__AbilityMix_sub[recipe]), s__Ability_INDEX_TIER)))) + ".blp"), 0, true) // INLINED!!
						call BlzFrameSetTexture(s__AbilityManager___RECIPE_RESULT[i], sc__Ability_getTypeIconPath(s__AbilityMix_result[recipe]), 0, true)
						call BlzFrameSetTexture(s__AbilityManager___RECIPE_RESULT_BORDER[i], ("Textures\\ability_border_tier" + I2S(((LoadInteger(Ability__HASH1, (s__AbilityMix_result[recipe]), s__Ability_INDEX_TIER)))) + ".blp"), 0, true) // INLINED!!
					endif
				endif
				set i=i + 1
			endloop
  endfunction

		
  function s__AbilityManager_setAbilityMixTarget takes integer this,integer index,integer am returns nothing
   local integer aid1= 0
   local integer aid2= 0
			if index == 0 then
				if s__AbilityManager_ability_mix_element1[this] > 0 then
					call s__AbilityMixElement_deallocate(s__AbilityManager_ability_mix_element1[this])
				endif
				set s__AbilityManager_ability_mix_element1[this]=am
			elseif index == 1 then
				if s__AbilityManager_ability_mix_element2[this] > 0 then
					call s__AbilityMixElement_deallocate(s__AbilityManager_ability_mix_element2[this])
				endif
				set s__AbilityManager_ability_mix_element2[this]=am
			endif
			if GetLocalPlayer() == Player(this) then
				if am <= 0 then
					call BlzFrameSetTexture(AbilityManager___ABILITY_MIX_BACKDROP[index], "Icons\\BTNBlackIcon.blp", 0, true)
					call BlzFrameSetVisible(AbilityManager___ABILITY_MIX_TIER_BORDER[index], false)
					call BlzFrameSetVisible(AbilityManager___ABILITY_MIX_REMOVE[index], false)
				else
					call BlzFrameSetTexture(AbilityManager___ABILITY_MIX_BACKDROP[index], s__AbilityMixElement_getIconPath(am), 0, true)
					call BlzFrameSetTexture(AbilityManager___ABILITY_MIX_TIER_BORDER[index], "Textures\\ability_border_tier" + I2S(s__AbilityMixElement_getTier(am)) + ".blp", 0, true)
					call BlzFrameSetVisible(AbilityManager___ABILITY_MIX_TIER_BORDER[index], true)
					call BlzFrameSetVisible(AbilityManager___ABILITY_MIX_REMOVE[index], true)
				endif
			endif
			set aid1=s__AbilityMixElement_getId(s__AbilityManager_ability_mix_element1[this])
			set aid2=s__AbilityMixElement_getId(s__AbilityManager_ability_mix_element2[this])
			call s__AbilityManager_refreshRecipe(this)
			call s__AbilityManager_setAbilityMixResult(this,s__AbilityMix_getResult(aid1 , aid2))
  endfunction

  function s__AbilityManager_abilityMixConfirm takes integer this returns nothing
   local integer am1= s__AbilityManager_ability_mix_element1[this]
   local integer am2= s__AbilityManager_ability_mix_element2[this]
   local integer ar= s__AbilityMix_getResult(s__AbilityMixElement_getId(am1) , s__AbilityMixElement_getId(am2))
   local boolean result= false
			if s__AbilityMixElement_element_type[am2] == s__AbilityMixElement_TYPE_ABILITY then
				
				set CUSTOM_RESPOND_ERROR_PLAYER=(Player((this))) // INLINED!!
				set CUSTOM_RESPOND_ERROR_MESSAGE="보유중인 스킬은 부 재료로 등록할 수 없습니다."
				call s__Event_activate(CONFIG_EVENT_ERROR)
				return
			endif
			if ar == s__AbilityMix_EMPTY then
				
				
				return
			elseif ar == s__AbilityMix_DISABLED then
				
				
				return
			elseif ar == s__AbilityMix_LEVEL then
				
				set result=s__AbilityMix_mixLevel(((s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))])) , am1 , am2) // INLINED!!
			elseif ar == s__AbilityMix_RANDOM then
				
				set result=s__AbilityMix_mixRandom(((s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))])) , am1 , am2) // INLINED!!
			elseif ar > 0 then
				
				set result=s__AbilityMix_mix(((s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))])) , am1 , am2) // INLINED!!
			endif
			if result then
				
				if ar != s__AbilityMix_LEVEL then
					
					call s__AbilityManager_setAbilityMixTarget(this,0 , 0)
				endif
				call s__AbilityManager_setAbilityMixTarget(this,1 , 0)
				set CUSTOM_RESPOND_UI_REFRESH_PLAYER=(Player((this))) // INLINED!!
				call s__Event_activate(CONFIG_EVENT_ABILITY_UI_REFRESH)
				set CUSTOM_RESPOND_UI_REFRESH_PLAYER=null
			endif
  endfunction

  function s__AbilityManager_abilityMixRegisterRequest takes integer this,integer id,integer et returns nothing
   local integer am= 0
			if s__AbilityManager_ability_mix_element1[this] <= 0 then
				if et == s__AbilityMixElement_TYPE_ABILITY then
					set am=s__AbilityMixElement_createFromAbility(id)
				elseif et == s__AbilityMixElement_TYPE_ABILITY_SHARD then
					set am=s__AbilityMixElement_createFromAbilityShard(id)
				endif
				if s__AbilityManager_ability_mix_element2[this] > 0 and s__AbilityMixElement_element_type[am] == s__AbilityMixElement_element_type[s__AbilityManager_ability_mix_element2[this]] and s__AbilityMixElement_instance_id[am] == s__AbilityMixElement_instance_id[s__AbilityManager_ability_mix_element2[this]] then
					
					call s__AbilityMixElement_deallocate(am)
					
				else
					
					call s__AbilityManager_setAbilityMixTarget(this,0 , am)
				endif
			elseif s__AbilityManager_ability_mix_element2[this] <= 0 then
				if et == s__AbilityMixElement_TYPE_ABILITY then
					
					set CUSTOM_RESPOND_ERROR_PLAYER=(Player((this))) // INLINED!!
					set CUSTOM_RESPOND_ERROR_MESSAGE="보유중인 스킬은 부 재료로 등록할 수 없습니다."
					call s__Event_activate(CONFIG_EVENT_ERROR)
					return
				elseif et == s__AbilityMixElement_TYPE_ABILITY_SHARD then
					set am=s__AbilityMixElement_createFromAbilityShard(id)
				endif
				if s__AbilityMixElement_element_type[am] == s__AbilityMixElement_element_type[s__AbilityManager_ability_mix_element1[this]] and s__AbilityMixElement_instance_id[am] == s__AbilityMixElement_instance_id[s__AbilityManager_ability_mix_element1[this]] then
					
					call s__AbilityMixElement_deallocate(am)
					
				else
					
					call s__AbilityManager_setAbilityMixTarget(this,1 , am)
				endif
			endif
  endfunction

  function s__AbilityManager_show takes integer this,boolean flag returns nothing
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(AbilityManager___CONTAINER, flag)
			endif
			if s__AbilityManager_visible_flag[this] != flag then
				if flag then
					
					call s__AbilityManager_loadAbility(this)
					
					call s__AbilityManager_setAbilityMixTarget(this,0 , 0)
					call s__AbilityManager_setAbilityMixTarget(this,1 , 0)
					
					if s__AbilityManager_page[this] == s__AbilityManager_PAGE_MIX and not s__Inventory_visible_flag[(this)] then
						call sc__Inventory_visibleForPlayer((this),true)
					endif
					
					call sc__Array_add(s__CloseUI_list[(this)],s__CloseUI_ORDER_ABILITY_MANAGER)
					
					call sc__Inventory_disableDrop((this))
				else
					
					call sc__Array_eraseFor(s__CloseUI_list[(this)],s__CloseUI_ORDER_ABILITY_MANAGER)
					
					call sc__Inventory_enableDrop((this))
				endif
				
				call sc__User_enableAbilityHotkey((Player((this))) , not flag) // INLINED!!
				
				call sc__User_enableAbilityRightClick((Player((this))) , not flag) // INLINED!!
			endif
			set s__AbilityManager_visible_flag[this]=flag
  endfunction

  function s__AbilityManager_setPage takes integer this,integer index returns nothing
   local integer i= 0
			set s__AbilityManager_page[this]=index
			
			loop
				exitwhen i >= AbilityManager___PAGE_MAX
				if GetLocalPlayer() == (Player((this))) then // INLINED!!
					call BlzFrameSetVisible(AbilityManager___PAGE[i], false)
					call BlzFrameSetEnable(AbilityManager___PAGE_BUTTON[i], i != index)
					if index == i then
						call BlzFrameSetText(AbilityManager___PAGE_BUTTON_TEXT[i], "|cff00ff00" + AbilityManager___PAGE_BUTTON_STRING[i] + "|r")
					else
						call BlzFrameSetText(AbilityManager___PAGE_BUTTON_TEXT[i], "|cffffffff" + AbilityManager___PAGE_BUTTON_STRING[i] + "|r")
					endif
				endif
				set i=i + 1
			endloop
			if index == s__AbilityManager_PAGE_MIX then
				
				call s__AbilityManager_setAbilityMixTarget(this,0 , 0)
				call s__AbilityManager_setAbilityMixTarget(this,1 , 0)
				
				if not s__Inventory_visible_flag[(this)] then
					call sc__Inventory_visibleForPlayer((this),true)
				endif
			endif
			
			if GetLocalPlayer() == (Player((this))) then // INLINED!!
				call BlzFrameSetVisible(AbilityManager___ABILITY_LEVEL_BUTTON_CONTAINER, false)
				call BlzFrameSetVisible(AbilityManager___ABILITY_REMOVE_BUTTON_CONTAINER, false)
				if index == s__AbilityManager_PAGE_UPGRADE or index == s__AbilityManager_PAGE_EXTRACT then
					
					call BlzFrameSetVisible(AbilityManager___PAGE[s__AbilityManager_PAGE_UPGRADE], true)
					if index == s__AbilityManager_PAGE_UPGRADE then
						
						call BlzFrameSetVisible(AbilityManager___ABILITY_LEVEL_BUTTON_CONTAINER, true)
						
						call BlzFrameSetText(AbilityManager___HELP_TOOLTIP_TEXT, CUSTOM_STRING_UPGRADE_NAME[CONFIG_UPGRADE_SKILL_POINT] + ", " + CUSTOM_STRING_UPGRADE_NAME[CONFIG_UPGRADE_LUCK] + ", " + CUSTOM_STRING_UPGRADE_NAME[CONFIG_UPGRADE_EXP] + "를 사용해서 선택한 스킬의 레벨을 상승시킵니다.\n해당 스킬의 등급(티어)에 따라 소모되는 재화의 갯수가 결정됩니다.")
					elseif index == s__AbilityManager_PAGE_EXTRACT then
						
						call BlzFrameSetVisible(AbilityManager___ABILITY_REMOVE_BUTTON_CONTAINER, true)
						
						call BlzFrameSetText(AbilityManager___HELP_TOOLTIP_TEXT, "망각의 파편을 사용해서 선택한 스킬을 제거하여 스킬 파편을 만듭니다.\n고유 스킬은 제거할 수 없습니다.")
					endif
				elseif index == s__AbilityManager_PAGE_MIX then
					
					
					call BlzFrameSetVisible(AbilityManager___RECIPE_CONTAINER, false)
					
					call BlzFrameSetText(AbilityManager___HELP_TOOLTIP_TEXT, "보유한 스킬이나 소지하고 있는 스킬파편을 우클릭하여 재료로 등록한 뒤 합성을 진행합니다.\n\n - 같은 종류의 재료를 등록하면 주 재료의 레벨을 상승시킵니다.\n - 레시피에 맞는 재료를 등록하면 레시피 결과물을 생성합니다.\n - 레시피에 맞지 않는 재료를 등록하면 두 재료의 티어합계에 해당하는 무작위 결과물을 생성합니다.")
					call BlzFrameSetVisible(AbilityManager___PAGE[s__AbilityManager_PAGE_MIX], true)
				endif
			endif
			call s__AbilityManager_refreshAbilityIcons(this)
  endfunction

  function s__AbilityManager_switch takes integer this returns nothing
			call s__AbilityManager_show(this,not s__AbilityManager_visible_flag[this])
  endfunction

  function s__AbilityManager_close takes integer this returns nothing
			call s__AbilityManager_show(this,false)
  endfunction

  function s__AbilityManager_upgradeModeChange takes integer this returns nothing
			if s__AbilityManager_upgrade_mode[this] == CONFIG_UPGRADE_SKILL_POINT then
				set s__AbilityManager_upgrade_mode[this]=CONFIG_UPGRADE_LUCK
			elseif s__AbilityManager_upgrade_mode[this] == CONFIG_UPGRADE_LUCK then
				set s__AbilityManager_upgrade_mode[this]=CONFIG_UPGRADE_EXP
			elseif s__AbilityManager_upgrade_mode[this] == CONFIG_UPGRADE_EXP then
				set s__AbilityManager_upgrade_mode[this]=CONFIG_UPGRADE_SKILL_POINT
			endif
			call s__AbilityManager_refreshAbilityIcons(this)
  endfunction

  function s__AbilityManager_keypressCallback takes nothing returns nothing
   local integer this= 0
   local integer i= 0
   local boolean b= false
			
			if (udg_EVENT_VALUE) == CONFIG_EVENT_KEYPRESS then // INLINED!!
				set this=GetPlayerId(CUSTOM_RESPOND_KEYPRESS_PLAYER)
				if CUSTOM_RESPOND_KEYPRESS_KEY == OSKEY_V and CUSTOM_RESPOND_KEYPRESS_PRESS then
					call s__AbilityManager_switch(this)
					return
				endif
				return
			endif
			
			set this=GetPlayerId(GetTriggerPlayer())
			if BlzGetTriggerFrame() != null then
				
				if GetLocalPlayer() == Player(this) then
					if BlzFrameGetEnable(BlzGetTriggerFrame()) then
						call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
						call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
					endif
				endif
				
				if BlzGetTriggerFrameEvent() != FRAMEEVENT_CONTROL_CLICK then
					return
				endif
				
				if BlzGetTriggerFrame() == AbilityManager___CLOSE_BUTTON then
					call s__AbilityManager_show((this),false) // INLINED!!
					return
				elseif BlzGetTriggerFrame() == AbilityManager___UPGRADE_MODE_CHANGE then
					call s__AbilityManager_upgradeModeChange(this)
					return
				else
					
					loop
						exitwhen i >= AbilityManager___PAGE_MAX
						if BlzGetTriggerFrame() == AbilityManager___PAGE_BUTTON[i] then
							call s__AbilityManager_setPage(this,i)
							return
						endif
						set i=i + 1
					endloop
					set i=0
					
					if s__AbilityManager_page[this] == s__AbilityManager_PAGE_UPGRADE then
						
						loop
							exitwhen i >= CONFIG_ABILITY_SIZE
							if BlzGetTriggerFrame() == AbilityManager___ABILITY_LEVEL_BUTTON[i] then
								call s__AbilityManager_levelButtonPress(this,i , s__AbilityManager_upgrade_mode[this])
								return
							endif
							set i=i + 1
						endloop
						return
					elseif s__AbilityManager_page[this] == s__AbilityManager_PAGE_MIX then
						
						loop
							exitwhen i >= 2
							if BlzGetTriggerFrame() == AbilityManager___ABILITY_MIX_REMOVE[i] then
								call s__AbilityManager_setAbilityMixTarget(this,i , 0)
								return
							endif
							set i=i + 1
						endloop
						
						if BlzGetTriggerFrame() == AbilityManager___ABILITY_MIX_CONFIRM then
							call s__AbilityManager_abilityMixConfirm(this)
							return
						endif
						//
						return
					elseif s__AbilityManager_page[this] == s__AbilityManager_PAGE_EXTRACT then
						
						loop
							exitwhen i >= CONFIG_ABILITY_SIZE
							if BlzGetTriggerFrame() == AbilityManager___ABILITY_REMOVE_BUTTON[i] then
								call s__AbilityManager_removeButtonPress(this,i)
								return
							endif
							set i=i + 1
						endloop
						return
					endif
					return
				endif
			endif
  endfunction

  function s__AbilityManager_initFrames takes nothing returns nothing
   local integer i= 0
   local real width= 0
   local real icon_size= 0
   local real v1= 0
   local framehandle f= null
			set AbilityManager___CONTAINER=FRAME_ABILITY_MANAGER
			set width=( BlzFrameGetWidth(AbilityManager___CONTAINER) - (((64)*1.0) / 1800.) ) // INLINED!!
			set icon_size=(((48)*1.0) / 1800.) // INLINED!!
			set v1=( ( width - icon_size * 6 ) / 5 ) + icon_size
			
			set AbilityManager___CLOSE_BUTTON=BlzCreateFrame("GenericCloseButton", AbilityManager___CONTAINER, 0, 0)
			call BlzFrameSetPoint((AbilityManager___CLOSE_BUTTON ), ( FRAMEPOINT_TOPRIGHT ), ( AbilityManager___CONTAINER ), ( FRAMEPOINT_TOPRIGHT ), (( - 16 )*1.0) / 1800., (( - 16)*1.0) / 1800.) // INLINED!!
			call BlzTriggerRegisterFrameEvent(AbilityManager___KEYPRESS, AbilityManager___CLOSE_BUTTON, FRAMEEVENT_CONTROL_CLICK)
			call BlzTriggerRegisterFrameEvent(AbilityManager___KEYPRESS, AbilityManager___CLOSE_BUTTON, FRAMEEVENT_MOUSE_LEAVE)
			
			set AbilityManager___SUB_PANEL=BlzCreateFrame("MyTextBox", AbilityManager___CONTAINER, 0, 0)
			call BlzFrameSetPoint((AbilityManager___SUB_PANEL ), ( FRAMEPOINT_BOTTOMLEFT ), ( AbilityManager___CONTAINER ), ( FRAMEPOINT_BOTTOMLEFT ), (( 8 )*1.0) / 1800., (( 8)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetPoint((AbilityManager___SUB_PANEL ), ( FRAMEPOINT_TOPRIGHT ), ( AbilityManager___CONTAINER ), ( FRAMEPOINT_TOPRIGHT ), (( - 8 )*1.0) / 1800., (( - 8 - 112)*1.0) / 1800.) // INLINED!!
			
			loop
				exitwhen i >= AbilityManager___PAGE_MAX
				set AbilityManager___PAGE[i]=BlzCreateFrameByType("FRAME", "", AbilityManager___CONTAINER, "", i)
				set AbilityManager___PAGE_BUTTON[i]=BlzCreateFrame("AbilityManagerPageButton", AbilityManager___CONTAINER, 0, i)
				set AbilityManager___PAGE_BUTTON_TEXT[i]=BlzGetFrameByName("AbilityManagerPageButtonText", i)
				if i == 0 then
					call BlzFrameSetPoint(AbilityManager___PAGE_BUTTON[i], FRAMEPOINT_BOTTOMLEFT, AbilityManager___SUB_PANEL, FRAMEPOINT_TOPLEFT, 0, 0)
				else
					call BlzFrameSetPoint(AbilityManager___PAGE_BUTTON[i], FRAMEPOINT_BOTTOMLEFT, AbilityManager___PAGE_BUTTON[i - 1], FRAMEPOINT_BOTTOMRIGHT, 0, 0)
				endif
				call BlzTriggerRegisterFrameEvent(AbilityManager___KEYPRESS, AbilityManager___PAGE_BUTTON[i], FRAMEEVENT_CONTROL_CLICK)
				call BlzTriggerRegisterFrameEvent(AbilityManager___KEYPRESS, AbilityManager___PAGE_BUTTON[i], FRAMEEVENT_MOUSE_LEAVE)
				set i=i + 1
			endloop
			set AbilityManager___PAGE_BUTTON_STRING[0]="강화"
			set AbilityManager___PAGE_BUTTON_STRING[1]="합성"
			set AbilityManager___PAGE_BUTTON_STRING[2]="제거"
			call BlzFrameSetTexture(BlzGetFrameByName("AbilityManagerPageButtonIcon", 0), "replaceableTextures\\commandbuttons\\btnability_gem_orange.blp", 0, true)
			call BlzFrameSetTexture(BlzGetFrameByName("AbilityManagerPageButtonIcon", 1), "ReplaceableTextures\\CommandButtons\\BTN3M3.blp", 0, true)
			call BlzFrameSetTexture(BlzGetFrameByName("AbilityManagerPageButtonIcon", 2), "ReplaceableTextures\\CommandButtons\\btnability_gem_purple.blp", 0, true)
			set i=0
			
			set AbilityManager___ABILITY_LEVEL_BUTTON_CONTAINER=BlzCreateFrameByType("FRAME", "", AbilityManager___PAGE[s__AbilityManager_PAGE_UPGRADE], "", 0)
			set AbilityManager___ABILITY_REMOVE_BUTTON_CONTAINER=BlzCreateFrameByType("FRAME", "", AbilityManager___PAGE[s__AbilityManager_PAGE_UPGRADE], "", 0)
			call BlzFrameSetVisible(AbilityManager___ABILITY_REMOVE_BUTTON_CONTAINER, false)
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
