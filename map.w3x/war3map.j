			set EVT_WARP_OLD_X=sc__Object__get_x(this)
			set EVT_WARP_OLD_Y=sc__Object__get_y(this)
			call s__Unit_prototype_setPosition(this,nx , ny)
			set EVT_WARP_UNIT=this
			set EVT_WARP_X=sc__Object__get_x(this)
			set EVT_WARP_Y=sc__Object__get_y(this)
			call s__Event_activate(ENUM_EVENT_WARP)
  endfunction

