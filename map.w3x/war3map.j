  function s__UnitMovement_periodicAction takes integer this returns nothing
			call sc__Movement_moveAction(this)
			
			if s__Movement_friction[this] > 0. and s__Movement_velo[this] > 0. then
				set s__Movement_velo[this]=s__Movement_velo[this] - ( s__Movement_friction[this] * TIMER_TICK )
				if s__Movement_velo[this] <= 0. then
					set s__Movement_velo[this]=0.
					set s__Actor_want_destroy[this]=sc__UnitMovement_onFriction(this)
					if s__Actor_want_destroy[this] then
						return
					endif
				endif
			endif
			
			if s__UnitMovement_flag_collision[this] then
				call s__UnitMovement_collisionAction(this)
				if s__Actor_want_destroy[this] then
					return
				endif
			endif
			
			if s__UnitMovement_flag_wave[this] then
				call s__UnitMovement_waveAction(this)
				if s__Actor_want_destroy[this] then
					return
				endif
			endif
			
			if s__Movement_flag_target[this] then
				call s__UnitMovement_targetAction(this)
				if s__Actor_want_destroy[this] then
					return
				endif
			endif
			
			if s__Movement_gravity_impulse[this] > 0. then
				set s__Actor_want_destroy[this]=sc__UnitMovement_onBound(this)
				set s__Movement_gravity_impulse[this]=0.
				if s__Actor_want_destroy[this] then
					return
				endif
			endif
  endfunction

