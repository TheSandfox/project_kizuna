  function s__Scouter_create takes player p returns integer
   local integer this= GetPlayerId(p)
			if not s__Scouter_INIT then
				call s__Scouter_initFrames()
				set s__Scouter_INIT=true
			endif
			set s__Scouter_main_timer[this]=sc__Timer_new(this)
			set s__Scouter_timer_running[this]=false
			set s__Scouter_fix[this]=true
			call s__BuffIndicatorForScouter_create(p)
			return this
  endfunction

  function s__Scouter_destroy takes integer this returns nothing
			call sc__Timer_release(s__Scouter_main_timer[this])
			set s__Scouter_main_timer[this]=null
			set s__Scouter_timer_running[this]=false
  endfunction



