   function Buff10y0__cond takes nothing returns nothing
				if BUFF_CREATE_TARGET > 0 then
					set BUFF_LAST_CREATED=s__Buff10y0_main__allocate(BUFF_CREATE_ID , BUFF_CREATE_CASTER , BUFF_CREATE_TARGET , BUFF_CREATE_LEVEL , BUFF_CREATE_DURATION , Buff10y0_NAME)
				endif
			endfunction

