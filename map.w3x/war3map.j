  function s__AbilityManager_create takes player p returns integer
   local integer this= GetPlayerId(p)
			if s__AbilityManager_INIT then
				call s__AbilityManager_initFrames()
				set s__AbilityManager_INIT=false
			endif
			set s__AbilityManager_visible_flag[this]=false
			set s__AbilityManager_list[this]=s__SimpleList_create(CONFIG_ABILITY_SIZE)
			set s__AbilityManager_ability_mix_element1[this]=0
			set s__AbilityManager_ability_mix_element2[this]=0
			set s__AbilityManager_upgrade_mode[this]=CONFIG_UPGRADE_SKILL_POINT
			call s__AbilityManager_setTarget(this,(s__User_FOCUS_UNIT[GetPlayerId(((Player((this)))))])) // INLINED!!
			call s__AbilityManager_setPage(this,0)
			return this
  endfunction

  function s__AbilityManager_onInit takes nothing returns nothing
			set AbilityManager___KEYPRESS=CreateTrigger()
			call TriggerAddCondition(AbilityManager___KEYPRESS, Condition(function s__AbilityManager_keypressCallback))
			call TriggerRegisterVariableEvent((AbilityManager___KEYPRESS ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_KEYPRESS)*1.0)) // INLINED!!
			set s__AbilityManager_REFRESH_SKILLPOINT_TRIGGER=CreateTrigger()
			call TriggerAddCondition(s__AbilityManager_REFRESH_SKILLPOINT_TRIGGER, Condition(function s__AbilityManager_refreshSkillpointCallback))
  endfunction



//library AbilityManager ends
//library AbilityPrototype:





  function s__Ability_prototype__get_smart takes integer this returns integer
			return s__Ability_prototype_smart_true[this]
  endfunction
  function s__Ability_prototype__set_smart takes integer this,integer v returns nothing
			if v == 0 and s__Ability_prototype_force_smart[this] then
				set s__Ability_prototype_smart_true[this]=1
			else
				set s__Ability_prototype_smart_true[this]=v
			endif
  endfunction








  function s__Ability_prototype_addValue takes integer this,integer v returns nothing
			set s__Ability_prototype_value[this]=s__Ability_prototype_value[this] + v
  endfunction

  function s__Ability_prototype_addLevel takes integer this,integer v returns nothing
			set s__Ability_prototype_level[this]=s__Ability_prototype_level[this] + v
			call sc__Ability_prototype_update(this,v)
  endfunction

  function s__Ability_prototype_addCount takes integer this returns nothing
			set s__Ability_prototype_count[this]=s__Ability_prototype_count[this] + 1
  endfunction

  function s__Ability_prototype_useCount takes integer this returns nothing
			set s__Ability_prototype_count[this]=s__Ability_prototype_count[this] - 1
  endfunction

  function s__Ability_prototype_uIRefreshRequest takes player p returns nothing
			set CUSTOM_RESPOND_UI_REFRESH_PLAYER=p
			call s__Event_activate(CONFIG_EVENT_ABILITY_UI_REFRESH)
			set CUSTOM_RESPOND_UI_REFRESH_PLAYER=null
  endfunction

  function s__Ability_prototype_setIcon takes integer this,string newval returns nothing
			set s__Ability_prototype_icon[this]=newval
			call s__Ability_prototype_uIRefreshRequest((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])]))) // INLINED!!
  endfunction

  function s__Ability_prototype_getCarculatedCastDelayByAttackSpeed takes integer this returns real
			if s__Ability_prototype_cast_delay[this] / s__Unit_prototype_getCarculatedStatValue(s__Ability_prototype_owner[this],CONFIG_STAT_ATTACK_SPEED) > s__Ability_prototype_cast_delay[this] then
				return s__Ability_prototype_cast_delay[this]
			else
				return s__Ability_prototype_cast_delay[this] / s__Unit_prototype_getCarculatedStatValue(s__Ability_prototype_owner[this],CONFIG_STAT_ATTACK_SPEED)
			endif
  endfunction

  function s__Ability_prototype_getCarculatedManacost takes integer this returns real
			return I2R(s__Ability_prototype_manacost[this])
  endfunction

  function s__Ability_prototype_getMaxCooldownBySpellBoost takes integer this returns real
			
			return s__Ability_prototype_cooldown_max[this] / ( 1 + 0.01 * s__Unit_prototype_getCarculatedStatValue(s__Ability_prototype_owner[this],CONFIG_STAT_SPELL_BOOST) )
  endfunction

  function s__Ability_prototype_getMaxCooldownValueByAttackSpeed takes integer this returns real
			
   local real v= s__Unit_prototype_getCarculatedStatValue(s__Ability_prototype_owner[this],CONFIG_STAT_ATTACK_SPEED)
			if v < 1. then
				return 1.
			else
				return 1. / v
			endif
  endfunction

  function s__Ability_prototype_getMaxCooldown takes integer this returns real
			return s__Ability_prototype_getMaxCooldownBySpellBoost(this)
  endfunction

  function s__Ability_prototype_getCarculatedMaxCooldown takes integer this returns real
			
