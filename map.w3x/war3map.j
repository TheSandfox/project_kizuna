				call BlzFrameSetTexture(s__ChinghoFrame_icon1[this], s__Ability_getTypeIconPath(cid), 0, true)
				call BlzFrameSetTexture(s__ChinghoFrame_icon2[this], s__Ability_getTypeIconPath(cid), 0, true)
