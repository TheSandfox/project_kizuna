				call TimerStart((s__Undead_ai_timer[this] ), (( s__Undead_AI_TICK + GetRandomReal(- s__Undead_AI_TICK_RANDOM, s__Undead_AI_TICK_RANDOM) )*1.0), ( false ), ( function s__Undead_timerAction)) // INLINED!!
			endif
  endfunction

  function s__Undead_helpCall takes integer this returns nothing
   local integer i= 0
   local unit u= null
   local integer ud= 0
			
			loop
				set u=BlzGroupUnitAt(Undead_GROUP, i)
				exitwhen u == null
				if u != s__Unit_prototype_origin_unit[this] then
					
					if s__Math_distancePoints(GetUnitX(u) , GetUnitY(u) , sc__Object__get_x(this) , sc__Object__get_y(this)) <= 400. then
						set ud=s__Unit_prototype_get(u)
						call s__Undead_encount(ud)
					endif
				endif
				set i=i + 1
			endloop
			set u=null
  endfunction

  function s__Undead_cond takes nothing returns nothing
   local integer this= 0
			if s__Object_class[(CUSTOM_RESPOND_DAMAGE_ATTACKER)] == "Undead" then
				set this=CUSTOM_RESPOND_DAMAGE_ATTACKER
			elseif s__Object_class[(CUSTOM_RESPOND_DAMAGE_TARGET)] == "Undead" then
				set this=CUSTOM_RESPOND_DAMAGE_TARGET
			else
				return
			endif
			call s__Undead_encount(this)
			call s__Undead_helpCall(this)
			call sc__Undead_onDamaged(this)
  endfunction

