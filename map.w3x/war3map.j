   local integer this= s__Ability20h0__myride__allocate(caster , target , level , Ability20h0__ID)
			if this <= 0 then
				return 0
			endif
//end of: ridingAllocate("caster","target","level","ID")
				call s__Riding_setPosition(this,450. , 0 , - 90)
				set s__Ability20h0__myride_bf1[this]=s__Buff_add((s__Actor_actor[(this)]) , (s__Actor_actor[(this)]) , '20h0' , s__UnitActor_level[this] , 0.) // INLINED!!
