				endif
			else
				
				if s__Buff_node_prev[this] > 0 then
					
					set s__Buff_node_next[s__Buff_node_prev[this]]=s__Buff_node_next[this]
				endif
				if s__Buff_node_next[this] > 0 then
					
					set s__Buff_node_prev[s__Buff_node_next[this]]=s__Buff_node_prev[this]
				endif
			endif
  endfunction

