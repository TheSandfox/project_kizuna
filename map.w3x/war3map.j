  function s__Buff10z0_main_intervalAction takes integer this returns nothing
			call s__Unit_prototype_restoreMP(s__Buff_target[this],( s__Buff10z0_main_v[this] * s__Buff10z0_main_power[this] * s__Buff_interval[this] ) / s__Buff_duration_max[this])
  endfunction

  function s__Buff10z0_main_init takes integer this returns boolean
			set s__Buff10z0_main_poman[this]=CUSTOM_RESPOND_BUFF_VALUE //REMAINS
			if s__Buff10z0_main_poman[this] > Buff10z0_DATA_INTEGER1 then
				set s__Buff10z0_main_poman[this]=Buff10z0_DATA_INTEGER1
			endif
			set s__Buff_extra[this]=I2S(s__Buff10z0_main_poman[this])
			call s__UnitClass_addClass((s__Buff_target[this]),CONFIG_UNIT_CLASS_POMANGAM , s__Buff10z0_main_poman[this])
			set s__Buff10z0_main_power[this]=I2R(s__Buff10z0_main_poman[this]) / I2R(Buff10z0_DATA_INTEGER1)
			set s__Buff10z0_main_v[this]=Buff10z0_DAMAGE_BASE * ( 1 + Buff10z0_DAMAGE_PER_LEVEL * s__Buff_level[this] )
			set s__Buff_interval[this]=0.5
			call s__Buff_addEffect(this,s__Effect_createAttatched(Buff10z0_EFFECT_PATH1 , s__Unit_prototype_origin_unit[s__Buff_target[this]] , "origin"))
			return true
  endfunction

