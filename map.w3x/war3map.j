  function s__Buff10y0_main_relativeTooltip takes integer this returns string
			return "최대체력이 감소했습니다."
  endfunction

  function s__Buff10y0_main_update takes integer this returns boolean
			
   local real r= s__Unit_prototype_getCalculatedStatValue(s__Buff_caster[this],Buff10y0_DAMAGE_STAT1) * Buff10y0_DAMAGE_AMPLIFIER1 * ( 1 + Buff10y0_DAMAGE_PER_LEVEL * s__Buff_level[this] ) * s__Unit_prototype_damage_give[s__Buff_caster[this]]
			set s__Buff10y0_main_v[this]=s__Buff10y0_main_v[this] + r
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],ENUM_STAT_MAXHP , r)
			return true
  endfunction

  function s__Buff10y0_main_init takes integer this returns boolean
			set s__Buff10y0_main_v[this]=s__Unit_prototype_getCalculatedStatValue(s__Buff_caster[this],Buff10y0_DAMAGE_STAT1) * Buff10y0_DAMAGE_AMPLIFIER1 * ( 1 + Buff10y0_DAMAGE_PER_LEVEL * s__Buff_level[this] )
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],ENUM_STAT_MAXHP , s__Buff10y0_main_v[this])
			return true
  endfunction

  function s__Buff10y0_main_onDestroy takes integer this returns nothing
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],ENUM_STAT_MAXHP , - s__Buff10y0_main_v[this])
  endfunction


