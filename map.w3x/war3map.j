//textmacro instance: demonicAllocate("Actor_prototype")
 function Actor_prototype_demonicAllocate takes nothing returns integer
  local integer this=si__Actor_prototype_F
		   if ( this != 0 ) then
			   set si__Actor_prototype_F=si__Actor_prototype_V[this]
		   else
			   set si__Actor_prototype_I=si__Actor_prototype_I + 1
			   set this=si__Actor_prototype_I
		   endif
		   set si__Actor_prototype_type[this]=0
		   set si__Actor_prototype_V[this]=- 1
		return this
	endfunction
//end of: demonicAllocate("Actor_prototype")


  function s__Actor_prototype_create takes nothing returns integer
   local integer this= Actor_prototype_demonicAllocate()
			return this
  endfunction








		
  function s__Actor_getProgression takes integer this returns real
			if s__Actor_duration_max[this] <= 0. then
				return 0.
			else
				return ( s__Actor_duration_max[this] - s__Actor_duration[this] ) / s__Actor_duration_max[this]
			endif
  endfunction

  function s__Actor__get_x takes integer this returns real
			return s__Actor_x_true[this]
  endfunction

