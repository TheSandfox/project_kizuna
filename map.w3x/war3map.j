			call BlzSetSpecialEffectMatrixScale(s__Effect_origin_effect[s__BossPatternIndicator_outter[this]], ( s__BossPatternIndicator_length[this] + s__BossPatternIndicator_radius[this] * 2 ) / 100., s__BossPatternIndicator_radius[this] / 50., 1.)
