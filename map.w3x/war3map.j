			call s__Unit_prototype_divideStatValue(this,CONFIG_STAT_HEAL_AMP , 4.)
			
			call s__UnitClass_plusClass((this),CONFIG_UNIT_CLASS_BOSS)
			
			call s__Unit_prototype_plusStatus(this,CONFIG_STATUS_DISARM)
			
			call s__Unit_prototype_plusStatus(this,CONFIG_STATUS_UNSTOP)
			
			call s__Unit_prototype_plusStatus(this,CONFIG_STATUS_GHOST)
			
			call s__Unit_prototype_setScale(this,2.0)
			call BlzSetUnitRealField(s__Unit_prototype_origin_unit[(this)], UNIT_RF_SELECTION_SCALE, ((1.5 * 2.0)*1.0)) // INLINED!!
			return this
  endfunction

