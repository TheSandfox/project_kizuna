   function s__Ability1000_mv_executeExplosion takes integer this,integer target returns nothing
    local integer kn= s__Knockback_create(target , Ability1000__KNOCKBACK_DISTANCE / Ability1000__KNOCKBACK_DURATION , sc__Object__get_yaw((s__Actor_actor[(this)]))) // INLINED!!
				if kn > 0 then
					set s__Movement_z_velo[kn]=300.
					set s__Movement_gravity[kn]=( 300. * 2 ) / Ability1000__KNOCKBACK_DURATION
					set s__Actor_duration[kn]=Ability1000__KNOCKBACK_DURATION
				endif
				call s__UnitMovement_setDamageFlagById(this,Ability1000__ID)
				if target == sc__Movement__get_target(this) then
					call s__UnitMovement_customDamageTarget(this,target , s__UnitMovement_damage[this] * Ability1000__DAMAGE_PRIMARY)
				else
					call s__UnitMovement_customDamageTarget(this,target , s__UnitMovement_damage[this])
				endif
				call s__Effect_kill(s__Effect_setScale(s__Effect_create(EF_ROCK , sc__Object__get_x(target) , sc__Object__get_y(target) , sc__Object__get_z(target) + s__Object_pivot_z[target] , 0),2.5))
				call s__Buff_add(0 , target , 'Stun' , 0 , 0.5)
   endfunction
	
   function s__Ability1000_mv_executeTarget takes integer this,integer target returns nothing
				call s__Movement__set_target(this,target)
				call s__UnitMovement_explosionAction(this)
				set s__Actor_want_destroy[this]=true
				call s__UnitActor_create((s__Actor_actor[(this)]) , 0 , 0. , 0. , 0 , Ability1000__BACKSWING , true) // INLINED!!
				call IssueTargetOrder(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))], ("attack" ), ( s__Unit_prototype_origin_unit[target])) // INLINED!!
   endfunction
	
   function s__Ability1000_mv_create takes integer u,real yaw,integer level returns integer
//textmacro instance: chargeAllocate("u","CHARGE_SPEED","yaw")
   local integer this= s__Ability1000_mv__allocate(u , Ability1000__CHARGE_SPEED , yaw)
			if this <= 0 then
				return 0
			endif
//end of: chargeAllocate("u","CHARGE_SPEED","yaw")
				set s__Movement_use_collision[this]=true
				set s__Actor_duration[this]=Ability1000__CHARGE_DURATION
				set s__Movement_refresh_facing[this]=false
				set s__UnitMovement_level[this]=level
				set s__UnitMovement_flag_collision[this]=true
				set s__UnitMovement_radius_target[this]=Ability1000__RADIUS2
				set s__UnitMovement_radius_explosion[this]=125.
				call s__Unit_prototype_setAnimSpeed((s__Actor_actor[(this)]),1.0 * (s__Unit_prototype_getCalculatedStatValue(((s__Actor_actor[(this)])),ENUM_STAT_ATTACK_SPEED))) // INLINED!!
				call s__Unit_prototype_queueAnim((s__Actor_actor[(this)]),"stand") // INLINED!!
				call s__Effect_kill(s__Effect_setPitch(s__Effect_create(EF_ROCK , sc__Object__get_x(u) , sc__Object__get_y(u) , sc__Object__get_z(u) , 0),- 90))
				call s__UnitMovement_carculateDamage(this,( s__Unit_prototype_getCalculatedStatValue((s__Actor_actor[(this)]),Ability1000__DAMAGE_STAT1) * Ability1000__DAMAGE_AMPLIFIER1 ) * ( 1 + Ability1000__DAMAGE_PER_LEVEL * s__UnitMovement_level[this] )) // INLINED!!
				return this
   endfunction
	
   function s__Ability1000_mv_onDestroy takes integer this returns nothing
				call s__Unit_prototype_setAnimSpeed((s__Actor_actor[(this)]),1.0) // INLINED!!
   endfunction
	
	
	

   function s__Ability1000_actor_periodicAction takes integer this returns nothing
   endfunction
	
   function s__Ability1000_actor_onComplete takes integer this returns nothing
				call s__Ability1000_mv_create((s__Actor_actor[(this)]) , s__Ability1000_actor_angle[this] , s__UnitActor_level[this]) // INLINED!!
   endfunction
	
   function s__Ability1000_actor_create takes integer u,real x,real y,real delay,integer level returns integer
    local integer this= s__Ability1000_actor__allocate(u , 0 , x , y , level , delay , true)
				set s__Ability1000_actor_angle[this]=s__Math_anglePoints(sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , sc__Actor__get_x(this) , sc__Actor__get_y(this)) // INLINED!!
				call s__Unit_prototype_setAnim((s__Actor_actor[(this)]),"attack") // INLINED!!
				call s__Unit_prototype_setAnimSpeed((s__Actor_actor[(this)]),(s__Unit_prototype_getCalculatedStatValue(((s__Actor_actor[(this)])),ENUM_STAT_ATTACK_SPEED))) // INLINED!!
				call SetUnitFacing(s__Unit_prototype_origin_unit[(s__Actor_actor[(this)])], s__Ability1000_actor_angle[this]) // INLINED!!
				set s__UnitActor_suspend_ensnare[this]=true
				set s__Actor_progress_bar[this]=s__ProgressBar_create(Ability1000__NAME , (GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))]))) // INLINED!!
				return this
   endfunction
	


   function s__Ability1000__ind_beforeRefresh takes integer this returns nothing
				set s__LineIndicator_x[this]=sc__Object__get_x(s__Ability_prototype_owner[s__AbilityIndicator_abil[this]])
				set s__LineIndicator_y[this]=sc__Object__get_y(s__Ability_prototype_owner[s__AbilityIndicator_abil[this]])
				set s__LineIndicator_yaw[this]=s__Math_anglePoints(s__LineIndicator_x[this] , s__LineIndicator_y[this] , (s__s__Mouse_X[GetPlayerId((s__AbilityIndicator_owner[this]))]) , (s__s__Mouse_Y[GetPlayerId((s__AbilityIndicator_owner[this]))])) // INLINED!!
				set s__LineIndicator_range[this]=( Ability1000__CHARGE_SPEED * Ability1000__CHARGE_DURATION )
				set s__LineIndicator_width[this]=Ability1000__RADIUS2
   endfunction

   function s__Ability1000__ind_create takes integer abil,player owner returns integer
    local integer this= s__Ability1000__ind__allocate(abil , owner)
				call s__Effect_setColor(s__LineIndicator_ef[this],255 , R2I(0.65 * 255) , 0)
				return this
   endfunction

	
	
//textmacro instance: abilityTooltip1000()
function s__Ability1000_main_relativeTooltip takes integer this,integer caster returns string
	return "지정한 방향으로 약진하여 충돌하는 대상과 대상 주변의 적들에게 |cffff9900" + R2SW(1.5 * s__Unit_prototype_getCalculatedStatValue(caster,ENUM_STAT_DEFENSE) * ( 1 + 0.06 * s__Ability_prototype_level[this] ), 2, 2) + "|r" + s__CustomString_shiftStatTooltip(ENUM_STAT_DEFENSE) + "의 피해를 입히고 밀쳐냅니다. 가장 가까운 적에게는 |cffffffff133%|r의 피해를 입힙니다."
endfunction
//end of: abilityTooltip1000()
	
   function s__Ability1000_main_execute takes integer this returns nothing
				call s__Ability1000_actor_create(s__Ability_prototype_owner[this] , s__Ability_prototype_command_x[this] , s__Ability_prototype_command_y[this] , s__Ability_prototype_getCalculatedCastDelayByAttackSpeed(this) , s__Ability_prototype_level[this])
   endfunction
	
   function s__Ability1000_main_init takes integer this returns nothing
//textmacro instance: abilitySetup()







	set s__Ability_prototype_id[this]=Ability1000__ID
	set s__Ability_prototype_name[this]=Ability1000__NAME
	set s__Ability_prototype_icon[this]=Ability1000__ICON_PATH
	set s__Ability_level_max[this]=(LoadInteger(Ability__HASH1, (Ability1000__ID), s__Ability_INDEX_MAX_LEVEL)) // INLINED!!
	set s__Ability_prototype_drag_to_use[this]=Ability1000__CAST_TYPE == ENUM_CAST_TYPE_DRAG_TO_USE
	set s__Ability_prototype_cooldown_max[this]=Ability1000__COOLDOWN_MAX
	set s__Ability_prototype_cooldown_min[this]=Ability1000__COOLDOWN_MIN
	set s__Ability_prototype_manacost[this]=Ability1000__MANACOST
	// set .cast_range = RANGE
	call SaveInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_RED ), ( 0)) // INLINED!!
	call SaveInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_RED ), ( 0)) // INLINED!!
	call SaveInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_GREEN ), ( 0)) // INLINED!!
	call SaveInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_BLUE ), ( 0)) // INLINED!!
	call s__Ability_plusBaseStatValue(this,5)
//end of: abilitySetup()
				set s__Ability_prototype_is_active[this]=true
				set s__Ability_prototype_is_charge[this]=true
				set s__Ability_prototype_preserve_order[this]=false
				set s__Ability_prototype_cast_delay[this]=0.25
				set s__Ability_prototype_indicator[this]=s__Ability1000__ind_create(this , (GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])]))) // INLINED!!
				
   endfunction
	
   function s__Ability1000_main_onInit takes nothing returns nothing
				call SaveStr(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_TOOLTIP, ( "단거리 돌진,\n충돌 시 범위피해")) // INLINED!!
   endfunction

   function s__Ability1000_main_executeAI takes integer this returns boolean
				if s__Math_distancePoints(sc__Object__get_x(s__Ability_prototype_owner[this]) , sc__Object__get_y(s__Ability_prototype_owner[this]) , GetUnitX(s__Ability_prototype_command_target[this]) , GetUnitY(s__Ability_prototype_command_target[this])) <= 200. then
					return s__Ability_prototype_useRequest(this,GetUnitX(s__Ability_prototype_command_target[this]) , GetUnitY(s__Ability_prototype_command_target[this]) , s__Ability_prototype_command_target[this] , false)
				else
					return false
				endif
   endfunction
	
	
//textmacro instance: abilityDataEnd()
 function Ability1000__act takes nothing returns nothing
  local integer a= 0
		if EVT_ABILITY_CREATE_ID == Ability1000__ID then
			set a=s__Ability1000_main__allocate()
			set s__Ability_prototype_owner[a]=EVT_ABILITY_CREATE_UNIT
			call s__Ability_prototype_essentialInit(a)
			call s__Ability1000_main_init(a)
			set EVT_ABILITY_CREATE_RESULT=a
		endif
	endfunction

 function Ability1000__init takes nothing returns nothing
		
  local trigger t= CreateTrigger()
		call SaveTriggerHandle(ABILITY_CREATE_TRIGGER_TABLE, Ability1000__ID, 0, t)
		call TriggerAddCondition(t, Condition(function Ability1000__act))
		
		call SaveStr(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_ICON_PATH, ( Ability1000__ICON_PATH)) // INLINED!!
		call SaveStr(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_NAME, ( Ability1000__NAME)) // INLINED!!
		call SaveInteger(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_TIER, ( Ability1000__TIER)) // INLINED!!
		call SaveInteger(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_COST, ( Ability1000__COST)) // INLINED!!
		call s__Ability_setTypeBonusStatIndex(Ability1000__ID , 0 , Ability1000__STAT_BONUS1)
		call s__Ability_setTypeBonusStatIndex(Ability1000__ID , 1 , Ability1000__STAT_BONUS2)
		call SaveBoolean(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_IS_WEAPON, ( Ability1000__IS_WEAPON)) // INLINED!!
		call SaveInteger(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_MAX_LEVEL, ( 10 + Ability1000__TIER * 5)) // INLINED!!
		if Ability1000__TAG1 != - 1 then
			call s__DamageTag_add(Ability1000__ID , Ability1000__TAG1)
		endif
		if Ability1000__TAG2 != - 1 then
			call s__DamageTag_add(Ability1000__ID , Ability1000__TAG2)
		endif
		if Ability1000__TAG3 != - 1 then
			call s__DamageTag_add(Ability1000__ID , Ability1000__TAG3)
		endif
		if Ability1000__TAG4 != - 1 then
			call s__DamageTag_add(Ability1000__ID , Ability1000__TAG4)
		endif
		call SaveInteger(Ability__HASH1, (Ability1000__ID ), s__Ability_INDEX_CAST_TYPE, ( Ability1000__CAST_TYPE)) // INLINED!!

			call SaveInteger(Damage__HASH, (Ability1000__ID ), ( s__DamageFlag_INDEX_DAMAGE_TYPE ), ( Ability1000__DAMAGE_TYPE)) // INLINED!!
			call SaveInteger(Damage__HASH, (Ability1000__ID ), ( s__DamageFlag_INDEX_ATTACK_TYPE ), ( Ability1000__ATTACK_TYPE)) // INLINED!!
			call SaveInteger(Damage__HASH, (Ability1000__ID ), ( s__DamageFlag_INDEX_INTERVAL_TYPE ), ( Ability1000__INTERVAL_TYPE)) // INLINED!!
			call SaveInteger(Damage__HASH, (Ability1000__ID ), ( s__DamageFlag_INDEX_VECTOR_TYPE ), ( Ability1000__VECTOR_TYPE)) // INLINED!!
			call SaveInteger(Damage__HASH, (Ability1000__ID ), ( s__DamageFlag_INDEX_TARGET_TYPE ), ( Ability1000__TARGET_TYPE)) // INLINED!!
