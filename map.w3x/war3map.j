  function s__ArrayList_push takes integer this,integer index,integer val returns nothing
   local integer i= s__ArrayList_size[this]
			
			if index < 0 then
				set index=0
				return
			endif
			
			if index >= s__ArrayList_size[this] then
				call s__ArrayList_add(this,val)
				return
			endif
			loop
				
				exitwhen i <= index
				call s__ArrayList_setData(this,i , s__ArrayList_get(this,i - 1))
				set i=i - 1
			endloop
			call s__ArrayList_setData(this,index , val)
			set s__ArrayList_size[this]=s__ArrayList_size[this] + 1
			set s__ArrayList_CURRENT_INDEX=index
			call s__ArrayList_onAdd(this,val)
  endfunction

