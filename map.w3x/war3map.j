  function s__Block_getCol takes integer this returns integer
			return (LoadInteger(Hash___D, ((this)), (0))) // INLINED!!
  endfunction

  function s__Block_getRow takes integer this returns integer
			return (LoadInteger(Hash___D, ((this)), (1))) // INLINED!!
  endfunction

  function s__Block_setCol takes integer this,integer v returns integer
			call SaveInteger(Hash___D, ((this)), (0 ), ( v)) // INLINED!!
			return this
  endfunction

  function s__Block_setRow takes integer this,integer v returns integer
			call SaveInteger(Hash___D, ((this)), (1 ), ( v)) // INLINED!!
			return this
  endfunction

  function s__Block_getCalculatedCol takes real x returns integer
			return R2I(( s__Block_X_OFFSET + x ) / Block__BLOCK_SIZE)
  endfunction

  function s__Block_getCalculatedRow takes real y returns integer
			return R2I(( s__Block_Y_OFFSET + y ) / Block__BLOCK_SIZE)
  endfunction

  function s__Block_getCalculatedX takes integer c returns real
			return ( c * Block__BLOCK_SIZE ) - s__Block_X_OFFSET + ( Block__BLOCK_SIZE / 2. )
  endfunction

  function s__Block_getCalculatedY takes integer r returns real
			return ( r * Block__BLOCK_SIZE ) - s__Block_Y_OFFSET + ( Block__BLOCK_SIZE / 2. )
  endfunction

  function s__Block_getModX takes real x returns real
			return (( ((R2I(( s__Block_X_OFFSET + ((x)*1.0) ) / Block__BLOCK_SIZE))) * Block__BLOCK_SIZE ) - s__Block_X_OFFSET + ( Block__BLOCK_SIZE / 2. )) // INLINED!!
  endfunction

  function s__Block_getModY takes real y returns real
			return (( ((R2I(( s__Block_Y_OFFSET + ((y)*1.0) ) / Block__BLOCK_SIZE))) * Block__BLOCK_SIZE ) - s__Block_Y_OFFSET + ( Block__BLOCK_SIZE / 2. )) // INLINED!!
  endfunction

  function s__Block_get takes real x,real y returns integer
   local integer xi= (R2I(( s__Block_X_OFFSET + ((x)*1.0) ) / Block__BLOCK_SIZE)) // INLINED!!
   local integer yi= (R2I(( s__Block_Y_OFFSET + ((y)*1.0) ) / Block__BLOCK_SIZE)) // INLINED!!
			if HaveSavedInteger(Block__HASH, xi, yi) then
				return LoadInteger(Block__HASH, xi, yi)
			else
				return 0
			endif
  endfunction

  function s__Block__get_x takes integer this returns real
			return (( ((LoadInteger(Hash___D, (((this))), (0)))) * Block__BLOCK_SIZE ) - s__Block_X_OFFSET + ( Block__BLOCK_SIZE / 2. )) // INLINED!!
  endfunction

  function s__Block__get_y takes integer this returns real
			return (( ((LoadInteger(Hash___D, (((this))), (1)))) * Block__BLOCK_SIZE ) - s__Block_Y_OFFSET + ( Block__BLOCK_SIZE / 2. )) // INLINED!!
  endfunction

  function s__Block_register takes integer this returns nothing
			call SaveInteger(Block__HASH, (LoadInteger(Hash___D, (((this))), (0))), (LoadInteger(Hash___D, (((this))), (1))), this) // INLINED!!
  endfunction

  function s__Block_unregister takes integer this returns nothing
			call RemoveSavedInteger(Block__HASH, (LoadInteger(Hash___D, (((this))), (0))), (LoadInteger(Hash___D, (((this))), (1)))) // INLINED!!
  endfunction

  function s__Block_create takes real x,real y returns integer
   local integer this= sc__Hash_allocate()
			call s__Block_setCol(this,(R2I(( s__Block_X_OFFSET + ((x)*1.0) ) / Block__BLOCK_SIZE))) // INLINED!!
			call s__Block_setRow(this,(R2I(( s__Block_Y_OFFSET + ((y)*1.0) ) / Block__BLOCK_SIZE))) // INLINED!!
			call s__Block_register(this)
			return this
  endfunction

  function s__Block_destroy takes integer this returns nothing
			call s__Block_unregister(this)
			call sc__Hash_deallocate((this))
  endfunction



