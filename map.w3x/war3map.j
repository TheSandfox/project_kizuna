  function s__Unit_prototype__set_x takes integer this,real np returns nothing
   local real v= np
			if v > CONFIG_MAX_X then
				set v=CONFIG_MAX_X
			elseif v < CONFIG_MIN_X then
				set v=CONFIG_MIN_X
			endif
			call SetUnitX(s__Unit_prototype_origin_unit[this], v)
			call SetUnitX(s__Unit_prototype_mover_unit[this], v)
  endfunction

  function s__Unit_prototype__set_y takes integer this,real np returns nothing
   local real v= np
			if v > CONFIG_MAX_Y then
				set v=CONFIG_MAX_Y
			elseif v < CONFIG_MIN_Y then
				set v=CONFIG_MIN_Y
			endif
			call SetUnitY(s__Unit_prototype_origin_unit[this], v)
			call SetUnitY(s__Unit_prototype_mover_unit[this], v)
  endfunction

  function s__Unit_prototype_setPosition takes integer this,real nx,real ny returns nothing
			call SetUnitPosition(s__Unit_prototype_origin_unit[this], nx, ny)
			call sc__Object__set_x(this,sc__Object__get_x(this))
			call sc__Object__set_y(this,sc__Object__get_y(this))
			call sc__Effect_setPosition(s__Unit_prototype_facing_circle[this],sc__Object__get_x(this) , sc__Object__get_y(this) , 0.)
  endfunction

