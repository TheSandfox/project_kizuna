  function s__Buff2000_main_relativeTooltip takes integer this returns string
			return "공격력, 이동속도, 기본공격 적중 피해량이 증가했습니다."
  endfunction

  function s__Buff2000_main_damageCallback takes nothing returns nothing
   local integer this= 0
			if CUSTOM_RESPOND_DAMAGE_ONHIT_TYPE != s__Damage_ONHIT_TYPE_ONHIT then
				return
			endif
			if CUSTOM_RESPOND_DAMAGE_ATTACK_TYPE != s__Damage_ATTACK_TYPE_BASIC then
				return
			endif
			set this=(LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if CUSTOM_RESPOND_DAMAGE_ATTACKER != s__Buff_target[this] then
				return
			endif
			set CUSTOM_RESPOND_DAMAGE_PLUS=CUSTOM_RESPOND_DAMAGE_PLUS + s__Buff2000_main_v[this]
  endfunction

  function s__Buff2000_main_update takes integer this returns boolean
   local real new= s__Unit_prototype_getCarculatedStatValue(s__Buff_caster[this],CONFIG_STAT_ATTACK) * Buff2000_DAMAGE_AMPLIFIER1 * ( 1 + Buff2000_DAMAGE_PER_LEVEL * ( s__Buff_level[this] ) )
			if new > s__Buff2000_main_v[this] then
				set s__Buff2000_main_v[this]=new
			endif
			return true
  endfunction

  function s__Buff2000_main_init takes integer this returns boolean
			set s__Buff2000_main_trig[this]=s__Trigger_create(this)
			call s__Trigger_addCondition(s__Buff2000_main_trig[this],function s__Buff2000_main_damageCallback)
			call TriggerRegisterVariableEvent((s__Trigger_main_trigger[s__Buff2000_main_trig[this]] ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_DAMAGE_MODIFY)*1.0)) // INLINED!!
			set s__Buff2000_main_v[this]=s__Unit_prototype_getCarculatedStatValue(s__Buff_caster[this],CONFIG_STAT_ATTACK) * Buff2000_DAMAGE_AMPLIFIER1 * ( 1 + Buff2000_DAMAGE_PER_LEVEL * ( s__Buff_level[this] ) )
			call s__Unit_prototype_multiplyStatValue(s__Buff_target[this],CONFIG_STAT_ATTACK_SPEED , Buff2000_DATA_REAL1)
			call s__Unit_prototype_multiplyStatValue(s__Buff_target[this],CONFIG_STAT_MOVEMENT_SPEED , Buff2000_DATA_REAL2)
			
			set s__Buff2000_main_e1[this]=s__Effect_createAttatched(Buff2000__EFFECT_PATH1 , s__Unit_prototype_origin_unit[s__Buff_target[this]] , "hand left")
			set s__Buff2000_main_e2[this]=s__Effect_createAttatched(Buff2000__EFFECT_PATH1 , s__Unit_prototype_origin_unit[s__Buff_target[this]] , "hand right")
			return true
  endfunction

  function s__Buff2000_main_onDestroy takes integer this returns nothing
			call sc__Trigger_prototype_deallocate(s__Buff2000_main_trig[this])
			call s__Unit_prototype_multiplyStatValue(s__Buff_target[this],CONFIG_STAT_ATTACK_SPEED , - Buff2000_DATA_REAL1)
			call s__Unit_prototype_multiplyStatValue(s__Buff_target[this],CONFIG_STAT_MOVEMENT_SPEED , - Buff2000_DATA_REAL2)
			call s__Effect_kill(s__Buff2000_main_e1[this])
			call s__Effect_kill(s__Buff2000_main_e2[this])
			set s__Buff2000_main_e1[this]=0
			set s__Buff2000_main_e2[this]=0
  endfunction


//textmacro instance: buffEnd()

   function Buff2000__cond takes nothing returns nothing
				if BUFF_CREATE_TARGET > 0 then
					set BUFF_LAST_CREATED=s__Buff2000_main__allocate(BUFF_CREATE_ID , BUFF_CREATE_CASTER , BUFF_CREATE_TARGET , BUFF_CREATE_LEVEL , BUFF_CREATE_DURATION , Buff2000_NAME)
				endif
			endfunction

