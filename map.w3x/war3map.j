  function s__Riding_ridingCommandFilter takes integer this returns boolean
			return (GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))])) == (GetOwningPlayer(s__Unit_prototype_origin_unit[(s__UnitActor_target[this])])) or s__Riding_free_command[this] // INLINED!!
  endfunction

  function s__Riding_register takes integer this returns nothing
   local integer arrayid= s__Riding___rideflag_instance_target[(s__UnitActor_target[this])]
			set s__Riding___rideflag_instance_caster[((s__Actor_actor[(this)]))]=this // INLINED!!
			if arrayid < 1 then
				set s__Riding___rideflag_instance_target[(s__UnitActor_target[this])]=s__Array_create()
				set s__Riding___rideflag_actor_id[(s__UnitActor_target[this])]=s__Array_create()
			endif
			call s__Array_add(s__Riding___rideflag_instance_target[(s__UnitActor_target[this])],this)
			call s__Array_add(s__Riding___rideflag_actor_id[(s__UnitActor_target[this])],s__Actor_id[this])
  endfunction

  function s__Riding_unregister takes integer this returns nothing
   local integer index= (s__Array_seekFrom((s__Riding___rideflag_instance_target[(s__UnitActor_target[this])]),(this) , 0)) // INLINED!!
			set s__Riding___rideflag_instance_caster[((s__Actor_actor[(this)]))]=0 // INLINED!!
			call s__Array_remove(s__Riding___rideflag_instance_target[(s__UnitActor_target[this])],index)
			call s__Array_remove(s__Riding___rideflag_actor_id[(s__UnitActor_target[this])],index)
  endfunction

  function s__Riding_countInstanceById takes integer target,integer id returns integer
   local integer arrayid= s__Riding___rideflag_actor_id[(target)]
			if arrayid > 0 then
				return (s__Array_countFrom((s__Riding___rideflag_actor_id[(target)]),(id) , 0)) // INLINED!!
			else
				return 0
			endif
  endfunction

  function s__Riding_getByCaster takes integer caster returns integer
			return s__Riding___rideflag_instance_caster[(caster)]
  endfunction

		
  function s__Riding_getByTarget takes integer target returns integer
			return s__Riding___rideflag_instance_target[(target)]
  endfunction

  function s__Riding_isUnitRiding takes integer caster returns boolean
			return (s__Riding___rideflag_instance_caster[((caster))]) > 0 or (LoadInteger(Hash___D, ((((s__Riding___rideflag_instance_target[((caster))])))), (s__Array_P_SIZE))) > 0 // INLINED!!
  endfunction

  function s__Riding_onStop takes integer this returns nothing
			call IssueImmediateOrder(s__Unit_prototype_origin_unit[(s__UnitActor_target[this])], ("stop")) // INLINED!!
			call sc__User_customKeypress((GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))])) , s__UnitActor_target[this] , OSKEY_S , 0 , true) // INLINED!!
  endfunction

  function s__Riding_onRightClick takes integer this returns nothing
			if sc__Riding_ridingCommandFilter(this) then
				if CUSTOM_RESPOND_CLICK_TARGET != null then
					call IssueTargetOrder(s__Unit_prototype_origin_unit[(s__UnitActor_target[this])], ("smart" ), ( CUSTOM_RESPOND_CLICK_TARGET)) // INLINED!!
				else
					call IssuePointOrder(s__Unit_prototype_origin_unit[(s__UnitActor_target[this])], ("smart" ), (( CUSTOM_RESPOND_CLICK_X )*1.0), (( CUSTOM_RESPOND_CLICK_Y)*1.0)) // INLINED!!
				endif
				call sc__Mouse_customClick((GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))])) , s__UnitActor_target[this] , CUSTOM_RESPOND_CLICK_TARGET , MOUSE_BUTTON_TYPE_RIGHT , CUSTOM_RESPOND_CLICK_X , CUSTOM_RESPOND_CLICK_Y) // INLINED!!
			endif
  endfunction

  function s__Riding_refreshPosition takes integer this returns nothing
			if s__Riding_refresh_position[this] then
				if s__Riding_ride_angle_relative[this] then
					call s__Object_move3DFromOrigin((s__Actor_actor[(this)]),sc__Object__get_x(s__UnitActor_target[this]) , sc__Object__get_y(s__UnitActor_target[this]) , sc__Object__get_z(s__UnitActor_target[this]) , s__Riding_ride_distance[this] , s__Riding_ride_yaw[this] + sc__Object__get_yaw(s__UnitActor_target[this]) , s__Riding_ride_pitch[this]) // INLINED!!
				else
					call s__Object_move3DFromOrigin((s__Actor_actor[(this)]),sc__Object__get_x(s__UnitActor_target[this]) , sc__Object__get_y(s__UnitActor_target[this]) , sc__Object__get_z(s__UnitActor_target[this]) , s__Riding_ride_distance[this] , s__Riding_ride_yaw[this] , s__Riding_ride_pitch[this]) // INLINED!!
				endif
				call sc__Object__set_yaw((s__Actor_actor[(this)]),sc__Object__get_yaw(s__UnitActor_target[this])) // INLINED!!
			endif
  endfunction

  function s__Riding_periodicAction takes integer this returns nothing
			call s__Riding_refreshPosition(this)
  endfunction

  function s__Riding_zCallback takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if CUSTOM_RESPOND_KEYPRESS_CASTER != (s__Actor_actor[(this)]) then // INLINED!!
				return
			endif
			if CUSTOM_RESPOND_KEYPRESS_KEY != CONFIG_HOTKEY_UNRIDE then
				return
			endif
			if s__Riding_unride_z[this] then
				if GetTerrainCliffLevel(sc__Object__get_x((s__Actor_actor[(this)])), sc__Object__get_y((s__Actor_actor[(this)]))) == CONFIG_CLIFF_HEIGHT_DEFAULT then // INLINED!!
					
					call sc__Actor_prototype_deallocate(this)
				else
					
					set CUSTOM_RESPOND_ERROR_MESSAGE="현재 위치에 내릴 수 없습니다."
					set CUSTOM_RESPOND_ERROR_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))])) // INLINED!!
					set CUSTOM_RESPOND_ERROR_TIME=1.25
					call s__Event_activate(CONFIG_EVENT_ERROR)
				endif
			endif
  endfunction

  function s__Riding_failue takes integer caster,integer target returns nothing
			set s__InstantText_SIZE=8.
			set s__InstantText_VELO=0.08 + GetRandomReal(- 0.01, 0.01)
			set s__InstantText_LIFESPAN=1.25
			call sc__InstantText_setColor(0 , 255 , 255)
			call sc__InstantText_createForPlayer(sc__Object__get_x(target) , sc__Object__get_y(target) , sc__Object__get_z(target) + 75 , "(탑승할 수 없는 대상입니다)" , (GetOwningPlayer(s__Unit_prototype_origin_unit[(caster)]))) // INLINED!!
			call sc__InstantText_clearFlag()
			
			set CUSTOM_RESPOND_RIDING_CASTER=caster
			set CUSTOM_RESPOND_RIDING_TARGET=target
			set CUSTOM_RESPOND_RIDING_INSTANCE=- 1
			set CUSTOM_RESPOND_RIDING_FLAG=false
			call s__Event_activate(CONFIG_EVENT_RIDING)
  endfunction

  function s__Riding_setPosition takes integer this,real dist,real yaw,real pitch returns integer
			if this <= 0 then
				return 0
			endif
			set s__Riding_refresh_position[this]=true
			set s__Riding_ride_distance[this]=dist
			set s__Riding_ride_yaw[this]=yaw
			set s__Riding_ride_pitch[this]=pitch
			call s__Riding_refreshPosition(this)
			return this
  endfunction

  function s__Riding_create takes integer caster,integer target,integer level,integer id returns integer
   local integer this= 0
   local integer rins= 0
   local integer unitpointer= 0
			if caster == 0 or target == 0 then
				
				return 0
			endif
			
			set unitpointer=target
			loop
				
				set rins=(s__Riding___rideflag_instance_caster[((unitpointer))]) // INLINED!!
				exitwhen rins <= 0
				if s__UnitActor_target[rins] == caster then
					
					call s__Riding_failue(caster , target)
					return 0
				endif
				set unitpointer=s__UnitActor_target[rins]
			endloop
			if (s__Riding___rideflag_instance_caster[((caster))]) > 0 then // INLINED!!
				
				
				call sc__Actor_prototype_deallocate((s__Riding___rideflag_instance_caster[((caster))])) // INLINED!!
			endif
			set this=s__Riding__allocate(caster , target , 0. , 0. , level , 0. , false)
			set s__Actor_id[this]=id
			
			call s__Riding_register(this)
			
			call s__Unit_prototype_plusStatus((s__Actor_actor[(this)]),CONFIG_STATUS_GHOST) // INLINED!!
			call s__Unit_prototype_plusStatus((s__Actor_actor[(this)]),CONFIG_STATUS_RIDING) // INLINED!!
			
			set s__Unit_prototype_use_gravity[(s__Actor_actor[(this)])]=s__Unit_prototype_use_gravity[(s__Actor_actor[(this)])] - 1 // INLINED!!
			
			set s__Riding_zkey[this]=s__Trigger_create(this)
			call TriggerRegisterVariableEvent((s__Trigger_main_trigger[s__Riding_zkey[this]] ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_KEYPRESS)*1.0)) // INLINED!!
			call s__Trigger_addCondition(s__Riding_zkey[this],function s__Riding_zCallback)
			
			set CUSTOM_RESPOND_RIDING_CASTER=(s__Actor_actor[(this)]) // INLINED!!
			set CUSTOM_RESPOND_RIDING_TARGET=s__UnitActor_target[this]
			set CUSTOM_RESPOND_RIDING_INSTANCE=this
			set CUSTOM_RESPOND_RIDING_FLAG=true
			call s__Event_activate(CONFIG_EVENT_RIDING)
			return this
  endfunction

  function s__Riding_onDestroy takes integer this returns nothing
			
			set CUSTOM_RESPOND_RIDING_CASTER=(s__Actor_actor[(this)]) // INLINED!!
			set CUSTOM_RESPOND_RIDING_TARGET=s__UnitActor_target[this]
			set CUSTOM_RESPOND_RIDING_INSTANCE=this
			set CUSTOM_RESPOND_RIDING_FLAG=false
			call s__Event_activate(CONFIG_EVENT_RIDING)
			
			call s__Riding_unregister(this)
			
			call IssueImmediateOrder(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))], ("stop")) // INLINED!!
			
			call s__Unit_prototype_minusStatus((s__Actor_actor[(this)]),CONFIG_STATUS_GHOST) // INLINED!!
			call s__Unit_prototype_minusStatus((s__Actor_actor[(this)]),CONFIG_STATUS_RIDING) // INLINED!!
			
			call s__LocationEx_collisionProjection(sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)]))) // INLINED!!
			call sc__Object_move((s__Actor_actor[(this)]),(GetLocationX(LocationEx___LOC)) , (GetLocationY(LocationEx___LOC)) , sc__Object__get_z((s__Actor_actor[(this)]))) // INLINED!!
			
			set s__Unit_prototype_use_gravity[(s__Actor_actor[(this)])]=s__Unit_prototype_use_gravity[(s__Actor_actor[(this)])] + 1 // INLINED!!
			
			call sc__Trigger_prototype_deallocate(s__Riding_zkey[this])
  endfunction




