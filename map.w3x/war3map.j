  function s__Summon_durationTest takes integer this returns nothing
			if (s__Unit_prototype_mp_true[(this)]) <= 0 and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],ENUM_STATUS_DEAD) <= 0 then // INLINED!!
