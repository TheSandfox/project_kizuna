				if s__Actor_duration[this] <= s__Boss_BossB000__sanrengeki_DURATION_FAST - s__Boss_BossB000__sanrengeki_EXP_DELAY_FAST + 0.18 then
					set s__Boss_BossB000__sanrengeki_anim_play[this]=true
