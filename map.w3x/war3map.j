  function s__Missile_DamageFlag_initialize takes integer this returns nothing
			set s__Missile_damage_id[this]=0
			set s__Missile_damage_type[this]=s__Damage_DAMAGE_TYPE_PHYSICAL
			set s__Missile_attack_type[this]=s__Damage_ATTACK_TYPE_BASIC
			set s__Missile_interval_type[this]=s__Damage_INTERVAL_TYPE_SINGLE
			set s__Missile_vector_type[this]=s__Damage_VECTOR_TYPE_OUTTER
			set s__Missile_target_type[this]=s__Damage_TARGET_TYPE_NONTARGET
			set s__Missile_aoe_type[this]=s__Damage_AOE_TYPE_NONAOE
			set s__Missile_onhit_type[this]=s__Damage_ONHIT_TYPE_NONHIT
			set s__Missile_range_type[this]=s__Damage_RANGE_TYPE_MELEE
			set s__Missile_use_damage_position[this]=false
			set s__Missile_damage_x[this]=0.
			set s__Missile_damage_y[this]=0.
			set s__Missile_weapon_type[this]=WEAPON_TYPE_WHOKNOWS
  endfunction



