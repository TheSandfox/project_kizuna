  function s__LuckyBonus_create takes integer caster returns integer
			set s__InstantText_SIZE=10.
			call s__InstantText_create(sc__Object__get_x(caster) , sc__Object__get_y(caster) , sc__Object__get_z(caster) + 125. , (UDG_STAT_COLOR[(ENUM_STAT_LUCK )] + ( "행운 보너스!") + "|r")) // INLINED!!
			return 0
  endfunction



//library LuckyBonus ends
//library Monster:






		
  function s__Monster_targetCondition takes integer this,integer u returns boolean
			if not (IsUnitEnemy(s__Unit_prototype_origin_unit[(u)], ((GetOwningPlayer(s__Unit_prototype_origin_unit[(this)]))))) then // INLINED!!
				
				return false
			elseif not (IsUnitInRangeXY(s__Unit_prototype_origin_unit[(u)], ((sc__Object__get_x(this) )*1.0), (( sc__Object__get_y(this) )*1.0), (( s__Monster_acquire_range[this])*1.0))) then // INLINED!!
				
				return false
			// elseif not inRange(.camp_x,.camp_y,.camp_range) then
			// 	/*이 몬스터가 캠프 밖을 나갔으면 응답X*/
			// 	return false
			elseif s__Unit_prototype_isUnitType(u,UNIT_TYPE_DEAD) then
				
				return false
			endif
			return true
  endfunction

  function s__Monster_setTarget takes integer this,integer target returns nothing
			
			if target == 0 then
				set s__Monster_target[this]=0
				return
			endif
			
			if s__Monster_targetCondition(this,target) then
				set s__Monster_target[this]=target
				call IssueTargetOrder(s__Unit_prototype_origin_unit[(this)], ("attack" ), ( s__Unit_prototype_origin_unit[target])) // INLINED!!
			else
				set s__Monster_target[this]=0
			endif
  endfunction

  function s__Monster_findNewTarget takes integer this returns integer
   local group g= s__Group_new()
   local unit unitHandle= null
   local integer u= 0
   local integer i= 0
			// if .camp_rect == null then
			// 	call setTarget(0)
			// 	return
			// endif
			call GroupEnumUnitsInRange(g, sc__Object__get_x(this), sc__Object__get_y(this), s__Monster_acquire_range[this] * 2., null)
			loop
				set unitHandle=BlzGroupUnitAt(g, i)
				exitwhen unitHandle == null
				set u=s__Unit_prototype_get(unitHandle)
				if u <= 0 or not s__Monster_targetCondition(this,u) then
					call GroupRemoveUnit(g, unitHandle)
				else
					set i=i + 1
				endif
			endloop
			if BlzGroupGetSize(g) <= 0 then
				set u=0
			else
				set u=s__Unit_prototype_get(s__Group_getNearest(g , sc__Object__get_x(this) , sc__Object__get_y(this) , null))
			endif
			call ReleaseGroup((g)) // INLINED!!
			set unitHandle=null
			set g=null
			return u
  endfunction

  function s__Monster_refreshRandomIdlePosition takes integer this returns nothing
   local real rMin= I2R(Monster__P_MONSTER_CAMP_RADIUS_MIN)
   local real rMax= I2R(Monster__P_MONSTER_CAMP_RADIUS_MAX)
   local real u= GetRandomReal(0., 1.)
   local real radius= SquareRoot(rMin * rMin + u * ( rMax * rMax - rMin * rMin ))
   local real angle= GetRandomReal(0., 2. * bj_PI)
			set s__Monster_S_RANDOM_X=GetRectCenterX(s__Monster_camp_rect[this]) + radius * Cos(angle)
			set s__Monster_S_RANDOM_Y=GetRectCenterY(s__Monster_camp_rect[this]) + radius * Sin(angle)
  endfunction

  function s__Monster_periodicAction takes integer this returns nothing
   local real rx= 0.
   local real ry= 0.
   local integer idleDiceNum= 0
   local integer newTarget= 0
			if s__Monster_timer_state[this] == Monster__P_TIMERSTATE_COMBAT then
				
				if s__Monster_target[this] <= 0 or not s__Monster_targetCondition(this,s__Monster_target[this]) then
					
					set newTarget=s__Monster_findNewTarget(this)
					if newTarget > 0 then
						
						call s__Monster_setTarget(this,newTarget)
					else
						
						
						set Monster__P_TIMERSTATE_CHANGE_UNIT=this
						set Monster__P_TIMERSTATE_CHANGE_STATE=Monster__P_TIMERSTATE_BREAK
						call TriggerEvaluate(Monster__P_TIMERSTATE_CHANGE_CALLBACK)
					endif
				endif
			elseif s__Monster_timer_state[this] == Monster__P_TIMERSTATE_BREAK then
				
				call s__Unit_prototype_healUnit(this,this , (s__Unit_prototype_maxhp_true[(this)]) * Monster__P_BREAK_HEAL_PER_SEC * Monster__P_AI_BREAK_TICK) // INLINED!!
				call s__Unit_prototype__set_mp(this,(s__Unit_prototype_mp_true[(this)]) + (s__Unit_prototype_maxmp_true[(this)]) * Monster__P_BREAK_HEAL_PER_SEC * Monster__P_AI_BREAK_TICK) // INLINED!!
				
				if GetUnitCurrentOrder(s__Unit_prototype_origin_unit[this]) != OrderId(CONFIG_ORDER_STRING_CUSTOM_MOVE) then
					call IssuePointOrder(s__Unit_prototype_origin_unit[(this)], (CONFIG_ORDER_STRING_CUSTOM_MOVE ), (( s__Monster_camp_x[this] )*1.0), (( s__Monster_camp_y[this])*1.0)) // INLINED!!
				endif
				
				if ( (s__Unit_prototype_hp_true[(this)]) >= ( (s__Unit_prototype_maxhp_true[(this)]) * 0.99 ) ) and s__Math_distancePoints(sc__Object__get_x(this) , sc__Object__get_y(this) , s__Monster_camp_x[this] , s__Monster_camp_y[this]) <= 32. then // INLINED!!
					
					set Monster__P_TIMERSTATE_CHANGE_UNIT=this
					set Monster__P_TIMERSTATE_CHANGE_STATE=Monster__P_TIMERSTATE_IDLE
					call TriggerEvaluate(Monster__P_TIMERSTATE_CHANGE_CALLBACK)
				endif
			elseif s__Monster_timer_state[this] == Monster__P_TIMERSTATE_IDLE then
				set idleDiceNum=GetRandomInt(0, 3)
				
				if idleDiceNum <= 1 then
					// call BJDebugMsg("배회중")
					call s__Monster_refreshRandomIdlePosition(this)
					set rx=s__Monster_S_RANDOM_X
					set ry=s__Monster_S_RANDOM_Y
					set s__Monster_camp_x[this]=rx
					set s__Monster_camp_y[this]=ry
					call IssuePointOrder(s__Unit_prototype_origin_unit[(this)], (CONFIG_ORDER_STRING_CUSTOM_MOVE ), (( rx )*1.0), (( ry)*1.0)) // INLINED!!
				else
					// call BJDebugMsg("멈춰섬")
					set s__Monster_camp_x[this]=sc__Object__get_x(this)
					set s__Monster_camp_y[this]=sc__Object__get_y(this)
					call IssueImmediateOrder(s__Unit_prototype_origin_unit[(this)], (CONFIG_ORDER_STRING_CUSTOM_STOP)) // INLINED!!
				endif
				set Monster__P_TIMERSTATE_CHANGE_UNIT=this
				set Monster__P_TIMERSTATE_CHANGE_STATE=Monster__P_TIMERSTATE_IDLE
				call TriggerEvaluate(Monster__P_TIMERSTATE_CHANGE_CALLBACK)
			endif
  endfunction

  function s__Monster_aiTimerAction takes nothing returns nothing
   local integer this= (sg__TimerUtils___DATA_get(GetHandleId(((GetExpiredTimer()))) * HASH_UP / HASH_DOWN + HASH_BIAS)) // INLINED!!
			call s__Monster_periodicAction(this)
  endfunction

		
  function s__Monster_stateChange takes integer this,integer newState returns nothing
   local integer oldState= s__Monster_timer_state[this]
			
			if oldState == newState then
				return
			endif
			
			if oldState == Monster__P_TIMERSTATE_DEFAULT then
				
			elseif oldState == Monster__P_TIMERSTATE_DEFAULT then
				
				call s__Unit_prototype_minusStatus(this,ENUM_STATUS_DISARM)
				call s__Unit_prototype_minusStatValue(this,ENUM_STAT_MOVEMENT_SPEED , - Monster__P_IDLE_SLOW)
			elseif oldState == Monster__P_TIMERSTATE_DEFAULT then
				
			elseif oldState == Monster__P_TIMERSTATE_DEFAULT then
				
				call s__Unit_prototype_minusStatus(this,ENUM_STATUS_DISARM)
			endif
			
			if newState == Monster__P_TIMERSTATE_DEFAULT then
				
			elseif newState == Monster__P_TIMERSTATE_DEFAULT then
				
				call s__Monster_setTarget(this,0)
				call s__Unit_prototype_plusStatus(this,ENUM_STATUS_DISARM)
				call s__Unit_prototype_minusStatValue(this,ENUM_STAT_MOVEMENT_SPEED , Monster__P_IDLE_SLOW)
			elseif newState == Monster__P_TIMERSTATE_DEFAULT then
				
			elseif newState == Monster__P_TIMERSTATE_DEFAULT then
				
				call s__Unit_prototype_plusStatus(this,ENUM_STATUS_DISARM)
				call IssuePointOrder(s__Unit_prototype_origin_unit[(this)], (CONFIG_ORDER_STRING_CUSTOM_MOVE ), (( s__Monster_camp_x[this] )*1.0), (( s__Monster_camp_y[this])*1.0)) // INLINED!!
			endif
			set s__Monster_timer_state[this]=newState
  endfunction

		
  function s__Monster_aiTimerIdle takes integer this returns nothing
			// call BJDebugMsg("배회 시작: "+.name)
			call s__Monster_stateChange(this,Monster__P_TIMERSTATE_IDLE)
			call TimerStart((s__Monster_ai_timer[this] ), (( Monster__P_AI_IDLE_TICK + GetRandomReal(- Monster__P_AI_IDLE_TICK_RANDOM, Monster__P_AI_IDLE_TICK_RANDOM) )*1.0), ( false ), ( function s__Monster_aiTimerAction)) // INLINED!!
  endfunction

  function s__Monster_aiTimerBreak takes integer this returns nothing
			// call BJDebugMsg("휴식 시작: "+.name)
			call s__Monster_stateChange(this,Monster__P_TIMERSTATE_BREAK)
			call TimerStart((s__Monster_ai_timer[this] ), (( Monster__P_AI_BREAK_TICK )*1.0), ( true ), ( function s__Monster_aiTimerAction)) // INLINED!!
  endfunction
		
  function s__Monster_aiTimerCombat takes integer this,integer target returns nothing
			// call BJDebugMsg("전투 시작: "+.name+"("+target.name+"을(를) 공격)")
			call s__Monster_stateChange(this,Monster__P_TIMERSTATE_COMBAT)
			call s__Monster_setTarget(this,target)
			call TimerStart((s__Monster_ai_timer[this] ), (( Monster__P_AI_TICK )*1.0), ( true ), ( function s__Monster_aiTimerAction)) // INLINED!!
  endfunction

  function s__Monster_encount takes integer this,integer target returns nothing
			
			if s__Monster_timer_state[this] == Monster__P_TIMERSTATE_IDLE then
				if target > 0 and s__Monster_targetCondition(this,target) then
					
					call s__Monster_aiTimerCombat(this,target)
				else
					
					call s__Monster_aiTimerBreak(this)
				endif
			endif
  endfunction

  function s__Monster_damagedCallback takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if this != EVT_DAMAGE_TARGET then
				return
			endif
			call s__Monster_encount(this,EVT_DAMAGE_ATTACKER)
  endfunction

  function s__Monster_create takes integer campId,integer uid,real x,real y,real yaw returns integer
   local integer this= s__Monster__allocate(CONFIG_PLAYER_MONSTER , uid , x , y , yaw)
   local integer i= 0
			
			set s__Monster_camp_id[this]=campId
			set s__Monster_camp_x[this]=x
			set s__Monster_camp_y[this]=y
			set s__Monster_camp_angle[this]=yaw
			set s__Monster_ai_timer[this]=s__Timer_new(this)
			set s__Object_class[this]=UDG_UNIT_CLASS_NAME[ENUM_UNIT_CLASS_MONSTER]
			
			call s__UnitClass_plusClass((this),ENUM_UNIT_CLASS_MONSTER)
			
			set s__Monster_damaged_trigger[this]=s__Trigger_new(this)
			call TriggerRegisterVariableEvent((s__Monster_damaged_trigger[this] ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_DAMAGE_BEFORE_HPREDUCE)*1.0)) // INLINED!!
			call TriggerAddCondition(s__Monster_damaged_trigger[this], Condition(function s__Monster_damagedCallback))
			
			call IssueImmediateOrder(s__Unit_prototype_origin_unit[(this)], (CONFIG_ORDER_STRING_CUSTOM_STOP)) // INLINED!!
			call s__Monster_aiTimerIdle(this)
			
			call BlzSetUnitBooleanField(s__Unit_prototype_origin_unit[this], UNIT_BF_HERO_HIDE_HERO_MINIMAP_DISPLAY, true)
			return this
  endfunction

  function s__Monster_timerStateChangeCallback takes nothing returns nothing
   local integer this= Monster__P_TIMERSTATE_CHANGE_UNIT
			if Monster__P_TIMERSTATE_CHANGE_STATE == Monster__P_TIMERSTATE_IDLE then
				call s__Monster_aiTimerIdle(this)
			elseif Monster__P_TIMERSTATE_CHANGE_STATE == Monster__P_TIMERSTATE_COMBAT then
				call s__Monster_aiTimerCombat(this,Monster__P_TIMERSTATE_CHANGE_COMBAT_TARGET)
			elseif Monster__P_TIMERSTATE_CHANGE_STATE == Monster__P_TIMERSTATE_BREAK then
				call s__Monster_aiTimerBreak(this)
			endif
  endfunction

  function s__Monster_onDestroy takes integer this returns nothing
			
			call ReleaseTimer((s__Monster_ai_timer[this])) // INLINED!!
			set s__Monster_ai_timer[this]=null
			
			call s__Trigger_remove(s__Monster_damaged_trigger[this])
			set s__Monster_damaged_trigger[this]=null
			
			call s__UnitClass_minusClass((this),ENUM_UNIT_CLASS_MONSTER)
			
			set s__Monster_camp_rect[this]=null
  endfunction

  function s__Monster_onInit takes nothing returns nothing
			set Monster__P_TIMERSTATE_CHANGE_CALLBACK=CreateTrigger()
			call TriggerAddCondition(Monster__P_TIMERSTATE_CHANGE_CALLBACK, Condition(function s__Monster_timerStateChangeCallback))
  endfunction



