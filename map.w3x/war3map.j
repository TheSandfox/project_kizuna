//textmacro instance: buffIndicatorSetIconTarget()
  function s__BuffIndicatorForScouter_setIconTarget takes integer this,integer index,integer b returns nothing
			if b <= 0 then
				if GetLocalPlayer() == Player(this) then
					call BlzFrameSetVisible(Scouter___MY_ICON_OUTLINE[index], false)
				endif
				return
			endif
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(Scouter___MY_ICON_OUTLINE[index], true)
				if s__Buff_positive[b] == 1 then
					
					call BlzFrameSetTexture(Scouter___MY_ICON_OUTLINE[index], "replaceabletextures\\teamcolor\\teamcolor22.blp", 0, true)
					call BlzFrameSetTexture(Scouter___MY_ICON_COOLDOWN[index], "replaceabletextures\\teamcolor\\teamcolor06.blp", 0, true)
					
					call BlzFrameSetText(Scouter___MY_TOOLTIP_TEXT[index], "|cff00ff00" + s__Buff_name[b] + "|r\n\n" + sc__Buff_relativeTooltip(b))
				elseif s__Buff_positive[b] == 0 then
					
					call BlzFrameSetTexture(Scouter___MY_ICON_OUTLINE[index], "replaceabletextures\\teamcolor\\teamcolor12.blp", 0, true)
					call BlzFrameSetTexture(Scouter___MY_ICON_COOLDOWN[index], "replaceabletextures\\teamcolor\\teamcolor00.blp", 0, true)
					
					call BlzFrameSetText(Scouter___MY_TOOLTIP_TEXT[index], "|cffff0000" + s__Buff_name[b] + "|r\n\n" + sc__Buff_relativeTooltip(b))
				else
					
					call BlzFrameSetTexture(Scouter___MY_ICON_OUTLINE[index], "replaceabletextures\\teamcolor\\teamcolor08.blp", 0, true)
					call BlzFrameSetTexture(Scouter___MY_ICON_COOLDOWN[index], "replaceabletextures\\teamcolor\\teamcolor21.blp", 0, true)
					
					call BlzFrameSetText(Scouter___MY_TOOLTIP_TEXT[index], s__Buff_name[b] + "\n\n" + sc__Buff_relativeTooltip(b))
				endif
				
				call BlzFrameSetVisible(Scouter___MY_ICON_EX_BACKDROP[index], s__Buff_extra[b] != "")
				call BlzFrameSetText(Scouter___MY_ICON_EX_TEXT[index], s__Buff_extra[b])
				
				call BlzFrameSetTexture(Scouter___MY_ICON_BACKDROP[index], (LoadStr(BUFF_CREATE_HASH, (s__Buff_id[b]), BUFF_HASH_INDEX_ICON_PATH)), 0, true) // INLINED!!
				
				if s__Buff_duration_max[b] > 0. then
					call BlzFrameSetPoint((Scouter___MY_ICON_COOLDOWN[index] ), ( FRAMEPOINT_TOPRIGHT ), ( Scouter___MY_ICON_OUTLINE[index] ), ( FRAMEPOINT_BOTTOMRIGHT ), (( 0. )*1.0) / 1800., (( Scouter___SIZE * s__Buff_duration[b] / s__Buff_duration_max[b])*1.0) / 1800.) // INLINED!!
				else
					call BlzFrameSetPoint((Scouter___MY_ICON_COOLDOWN[index] ), ( FRAMEPOINT_TOPRIGHT ), ( Scouter___MY_ICON_OUTLINE[index] ), ( FRAMEPOINT_BOTTOMRIGHT ), (( 0. )*1.0) / 1800., (( Scouter___SIZE)*1.0) / 1800.) // INLINED!!
				endif
			endif
  endfunction
//end of: buffIndicatorSetIconTarget()

  function s__BuffIndicatorForScouter_refreshIconsTarget takes integer this returns nothing
   local integer j= 0
   local integer b= s__Buff_getUnitRootBuff(s__BuffIndicatorForScouter_target[this])
			
			loop
				exitwhen j >= Scouter___BUFF_ICONS_MAX or b <= 0
				if s__Buff_icon_display[b] then
					call s__BuffIndicatorForScouter_setIconTarget(this,j , b)
					set j=j + 1
				endif
				set b=s__Buff_node_next[b]
			endloop
			
			loop
				exitwhen j >= Scouter___BUFF_ICONS_MAX
				call s__BuffIndicatorForScouter_setIconTarget(this,j , 0)
				set j=j + 1
			endloop
  endfunction

  function s__BuffIndicatorForScouter_setTarget takes integer this,integer u returns nothing
			set s__BuffIndicatorForScouter_target[this]=u
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(Scouter___MY_BUFF_CONTAINER, u > 0)
			endif
			if u > 0 then
				call s__BuffIndicatorForScouter_refreshIconsTarget(this)
			endif
  endfunction

  function s__BuffIndicatorForScouter_initFrames takes nothing returns nothing
   local integer i= 0
			set Scouter___MY_BUFF_CONTAINER=BlzCreateFrame("NonFocusFrame", Scouter___MY_CONTAINER, 0, 0)
			call BlzFrameSetPoint((Scouter___MY_BUFF_CONTAINER ), ( FRAMEPOINT_TOPLEFT ), ( Scouter___MY_CONTAINER ), ( FRAMEPOINT_BOTTOMLEFT ), (( 0. )*1.0) / 1800., (( 0)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((Scouter___MY_BUFF_CONTAINER ), (( 16 )*1.0) / 1800., (( 16)*1.0) / 1800.) // INLINED!!
			loop
				exitwhen i >= Scouter___BUFF_ICONS_MAX
				set Scouter___MY_ICON_OUTLINE[i]=BlzCreateFrameByType("BACKDROP", "", Scouter___MY_BUFF_CONTAINER, "", 0)
				call BlzFrameSetPoint((Scouter___MY_ICON_OUTLINE[i] ), ( FRAMEPOINT_TOPLEFT ), ( Scouter___MY_BUFF_CONTAINER ), ( FRAMEPOINT_TOPLEFT ), (( ( Scouter___SIZE + Scouter___PADDING ) * ModuloInteger(i, Scouter___PER_ROW) + Scouter___PADDING )*1.0) / 1800., (( - ( Scouter___SIZE + Scouter___PADDING ) * R2I(i / Scouter___PER_ROW))*1.0) / 1800.) // INLINED!!
				call BlzFrameSetSize((Scouter___MY_ICON_OUTLINE[i] ), (( Scouter___SIZE )*1.0) / 1800., (( Scouter___SIZE)*1.0) / 1800.) // INLINED!!
				set Scouter___MY_ICON_COOLDOWN[i]=BlzCreateFrameByType("BACKDROP", "", Scouter___MY_ICON_OUTLINE[i], "", 0)
				call BlzFrameSetPoint((Scouter___MY_ICON_COOLDOWN[i] ), ( FRAMEPOINT_BOTTOMLEFT ), ( Scouter___MY_ICON_OUTLINE[i] ), ( FRAMEPOINT_BOTTOMLEFT ), (( 0 )*1.0) / 1800., (( 0)*1.0) / 1800.) // INLINED!!
				call BlzFrameSetTexture(Scouter___MY_ICON_COOLDOWN[i], "textures\\white.blp", 0, true)
				set Scouter___MY_ICON_BACKDROP[i]=BlzCreateFrameByType("BACKDROP", "", Scouter___MY_ICON_OUTLINE[i], "", 0)
				call BlzFrameSetPoint((Scouter___MY_ICON_BACKDROP[i] ), ( FRAMEPOINT_TOPLEFT ), ( Scouter___MY_ICON_OUTLINE[i] ), ( FRAMEPOINT_TOPLEFT ), (( Scouter___INSET )*1.0) / 1800., (( - Scouter___INSET)*1.0) / 1800.) // INLINED!!
				call BlzFrameSetPoint((Scouter___MY_ICON_BACKDROP[i] ), ( FRAMEPOINT_BOTTOMRIGHT ), ( Scouter___MY_ICON_OUTLINE[i] ), ( FRAMEPOINT_BOTTOMRIGHT ), (( - Scouter___INSET )*1.0) / 1800., (( Scouter___INSET)*1.0) / 1800.) // INLINED!!
				set Scouter___MY_ICON_EX_BACKDROP[i]=BlzCreateFrameByType("BACKDROP", "", Scouter___MY_ICON_OUTLINE[i], "", 0)
				call BlzFrameSetTexture(Scouter___MY_ICON_EX_BACKDROP[i], "textures\\black32.blp", 0, true)
				call BlzFrameSetAlpha(Scouter___MY_ICON_EX_BACKDROP[i], 128)
				set Scouter___MY_ICON_EX_TEXT[i]=BlzCreateFrame("MyTextSmall", Scouter___MY_ICON_OUTLINE[i], 0, 0)
				call BlzFrameSetPoint(Scouter___MY_ICON_EX_TEXT[i], FRAMEPOINT_BOTTOMRIGHT, Scouter___MY_ICON_BACKDROP[i], FRAMEPOINT_BOTTOMRIGHT, - 0.002, 0.002)
				call BlzFrameSetTextAlignment(Scouter___MY_ICON_EX_TEXT[i], TEXT_JUSTIFY_BOTTOM, TEXT_JUSTIFY_RIGHT)
				call BlzFrameSetPoint(Scouter___MY_ICON_EX_BACKDROP[i], FRAMEPOINT_BOTTOMRIGHT, Scouter___MY_ICON_EX_TEXT[i], FRAMEPOINT_BOTTOMRIGHT, 0.002, - 0.002)
				call BlzFrameSetPoint(Scouter___MY_ICON_EX_BACKDROP[i], FRAMEPOINT_TOPLEFT, Scouter___MY_ICON_EX_TEXT[i], FRAMEPOINT_TOPLEFT, - 0.002, 0.002)
				call BlzFrameSetVisible(Scouter___MY_ICON_EX_BACKDROP[i], false)
				set Scouter___MY_ICON_MOUSEOVER[i]=BlzCreateFrameByType("FRAME", "", Scouter___MY_ICON_OUTLINE[i], "", 0)
				call BlzFrameSetAllPoints(Scouter___MY_ICON_MOUSEOVER[i], Scouter___MY_ICON_OUTLINE[i])
				set Scouter___MY_TOOLTIP_CONTAINER[i]=BlzCreateFrameByType("FRAME", "", Scouter___MY_ICON_OUTLINE[i], "", 0)
				call BlzFrameSetTooltip(Scouter___MY_ICON_MOUSEOVER[i], Scouter___MY_TOOLTIP_CONTAINER[i])
				set Scouter___MY_TOOLTIP_BACKDROP[i]=BlzCreateFrameByType("BACKDROP", "", Scouter___MY_TOOLTIP_CONTAINER[i], "", 0)
				call BlzFrameSetTexture(Scouter___MY_TOOLTIP_BACKDROP[i], "textures\\black32.blp", 0, true)
				call BlzFrameSetAlpha(Scouter___MY_TOOLTIP_BACKDROP[i], 128)
				set Scouter___MY_TOOLTIP_TEXT[i]=BlzCreateFrame("MyText", Scouter___MY_TOOLTIP_CONTAINER[i], 0, 0)
				call BlzFrameSetPoint(Scouter___MY_TOOLTIP_TEXT[i], FRAMEPOINT_TOPRIGHT, Scouter___MY_ICON_OUTLINE[i], FRAMEPOINT_BOTTOMRIGHT, - 0.004, - 0.004)
				call BlzFrameSetTextAlignment(Scouter___MY_TOOLTIP_TEXT[i], TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_LEFT)
				call BlzFrameSetPoint(Scouter___MY_TOOLTIP_BACKDROP[i], FRAMEPOINT_BOTTOMLEFT, Scouter___MY_TOOLTIP_TEXT[i], FRAMEPOINT_BOTTOMLEFT, - 0.004, - 0.004)
				call BlzFrameSetPoint(Scouter___MY_TOOLTIP_BACKDROP[i], FRAMEPOINT_TOPRIGHT, Scouter___MY_TOOLTIP_TEXT[i], FRAMEPOINT_TOPRIGHT, 0.004, 0.004)
				set i=i + 1
			endloop
  endfunction

  function s__BuffIndicatorForScouter_create takes player p returns integer
   local integer this= GetPlayerId(p)
			if not s__BuffIndicatorForScouter_INIT then
				call s__BuffIndicatorForScouter_initFrames()
				set s__BuffIndicatorForScouter_INIT=true
			endif
			set s__BuffIndicatorForScouter_target[this]=0
			return this
  endfunction






  function s__Scouter_refreshPeriodic takes integer this returns nothing
   local real max= 0.
   local real pos= 0.
			
			set max=(s__Unit_prototype_maxhp_true[(s__Scouter_target[this])]) + s__Shield_shield_amount[(s__Scouter_target[this])] // INLINED!!
			set pos=(s__Unit_prototype_hp_true[(s__Scouter_target[this])]) / max // INLINED!!
			if GetLocalPlayer() == Player(this) then
				
				call BlzFrameSetVisible(Scouter___MY_SP_FILL, s__Shield_shield_amount[(s__Scouter_target[this])] > 0.)
				call BlzFrameClearAllPoints(Scouter___MY_SP_FILL)
				call BlzFrameSetPoint((Scouter___MY_SP_FILL ), ( FRAMEPOINT_LEFT ), ( Scouter___MY_HP_BACKDROP ), ( FRAMEPOINT_LEFT ), (( s__Scouter_BAR_WIDTH * pos )*1.0) / 1800., (( 0.)*1.0) / 1800.) // INLINED!!
				call BlzFrameSetSize((Scouter___MY_SP_FILL ), (( s__Scouter_BAR_WIDTH * ( s__Shield_shield_amount[(s__Scouter_target[this])] / max ) )*1.0) / 1800., (( s__Scouter_BAR_HEIGHT)*1.0) / 1800.) // INLINED!!
				
				call BlzFrameSetVisible(Scouter___MY_HP_FILL, pos > 0.005)
				call BlzFrameSetSize((Scouter___MY_HP_FILL ), (( s__Scouter_BAR_WIDTH * pos )*1.0) / 1800., (( s__Scouter_BAR_HEIGHT)*1.0) / 1800.) // INLINED!!
				call BlzFrameSetText(Scouter___MY_HP_TEXT, I2S(MathRound((s__Unit_prototype_hp_true[(s__Scouter_target[this])]))) + " / " + I2S(MathRound((s__Unit_prototype_maxhp_true[(s__Scouter_target[this])])))) // INLINED!!
			endif
			
			set max=(s__Unit_prototype_maxmp_true[(s__Scouter_target[this])]) // INLINED!!
			set pos=(s__Unit_prototype_mp_true[(s__Scouter_target[this])]) / max // INLINED!!
			if GetLocalPlayer() == Player(this) then
				if max > 0. then
					call BlzFrameSetVisible(Scouter___MY_MP_FILL, pos > 0.005)
					call BlzFrameSetSize((Scouter___MY_MP_FILL ), (( s__Scouter_BAR_WIDTH * pos )*1.0) / 1800., (( s__Scouter_BAR_HEIGHT)*1.0) / 1800.) // INLINED!!
				else
					call BlzFrameSetVisible(Scouter___MY_MP_FILL, false)
				endif
				call BlzFrameSetText(Scouter___MY_MP_TEXT, I2S(MathRound((s__Unit_prototype_mp_true[(s__Scouter_target[this])]))) + " / " + I2S(MathRound((s__Unit_prototype_maxmp_true[(s__Scouter_target[this])])))) // INLINED!!
			endif
			
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(Scouter___MY_DEATH_OVERLAY, sc__Unit_prototype_isUnitType(s__Scouter_target[this],UNIT_TYPE_DEAD))
			endif
			
			call s__BuffIndicatorForScouter_refreshIconsTarget((this))
  endfunction

  function s__Scouter_refresh takes integer this returns nothing
			
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetTexture(Scouter___MY_ICON, sc__UnitData_getIconPath((GetUnitTypeId(s__Unit_prototype_origin_unit[(s__Scouter_target[this])]))), 0, true) // INLINED!!
				call BlzFrameSetText(Scouter___MY_NAME, s__Unit_prototype_origin_name[s__Scouter_target[this]])
				call BlzFrameSetTexture(Scouter___MY_TEAMCOLOR, (s__User_TEAMCOLOR_PATH[GetPlayerId(((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Scouter_target[this])]))))]), 0, true) // INLINED!!
			endif
			call s__Scouter_refreshPeriodic(this)
  endfunction

  function s__Scouter_show takes integer this,boolean flag returns nothing
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(Scouter___MY_CONTAINER, flag)
			endif
  endfunction

  function s__Scouter_cancleFilter takes integer this returns boolean
			if s__Scouter_target[this] <= 0 then
				return true
			endif
			if not s__Unit_prototype_is_revive[s__Scouter_target[this]] and sc__Unit_prototype_isUnitType(s__Scouter_target[this],UNIT_TYPE_DEAD) then
				return true
			endif
			if not (IsUnitVisible(s__Unit_prototype_origin_unit[(s__Scouter_target[this])], (Player(this)))) then // INLINED!!
				return true
			endif
			return false
  endfunction

  function s__Scouter_timerCallback takes nothing returns nothing
   local integer this= sc__Timer_getData(GetExpiredTimer())
			if s__Scouter_cancleFilter(this) then
				call sc__Scouter_setTarget(this,0)
				return
			endif
			call s__Scouter_refreshPeriodic(this)
  endfunction

  function s__Scouter_runTimer takes integer this,boolean b returns nothing
			if b then
				if not s__Scouter_timer_running[this] then
					call TimerStart((s__Scouter_main_timer[this] ), (( 0.1 )*1.0), ( true ), ( function s__Scouter_timerCallback)) // INLINED!!
				endif
				set s__Scouter_timer_running[this]=true
			else
				call PauseTimer((s__Scouter_main_timer[this])) // INLINED!!
				set s__Scouter_timer_running[this]=false
			endif
  endfunction

  function s__Scouter_setTarget takes integer this,integer u returns nothing
			set s__Scouter_target[this]=u
			if u <= 0 then
				
				call s__Scouter_show(this,false)
				call s__Scouter_runTimer(this,false)
			else
				
				call s__Scouter_show(this,true)
				call s__Scouter_runTimer(this,true)
				call s__Scouter_refresh(this)
			endif
			call s__BuffIndicatorForScouter_setTarget((this),u)
  endfunction

  function s__Scouter_clickCallback takes nothing returns nothing
   local integer this= GetPlayerId(CUSTOM_RESPOND_CLICK_PLAYER)
   local integer u= 0
			if GetUnitAbilityLevel(CUSTOM_RESPOND_CLICK_TARGET, CONFIG_ABILITY_ID_CLASS_NONUNIT) != 0 then
				
				return
			endif
			if CUSTOM_RESPOND_CLICK_BUTTON_TYPE == MOUSE_BUTTON_TYPE_LEFT then
				set u=sc__Unit_prototype_get(CUSTOM_RESPOND_CLICK_TARGET)
				if u > 0 then
					call s__Scouter_setTarget(this,u)
				endif
			endif
  endfunction

  function s__Scouter_initFrames takes nothing returns nothing
			
			set s__Scouter_CLICK_TRIGGER=CreateTrigger()
			call TriggerRegisterVariableEvent((s__Scouter_CLICK_TRIGGER ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_CLICK)*1.0)) // INLINED!!
			call TriggerAddCondition(s__Scouter_CLICK_TRIGGER, Condition(function s__Scouter_clickCallback))
			
			set Scouter___MY_CONTAINER=BlzCreateFrame("MBEdge", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_BASIC], 0, 0)
			call BlzFrameSetSize((Scouter___MY_CONTAINER ), (( s__Scouter_WIDTH )*1.0) / 1800., (( s__Scouter_HEIGHT)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetPoint(Scouter___MY_CONTAINER, FRAMEPOINT_TOPRIGHT, FRAME_ORIGIN, FRAMEPOINT_TOPRIGHT, 0., 0.)
			set Scouter___MY_TEAMCOLOR=BlzCreateFrameByType("BACKDROP", "", Scouter___MY_CONTAINER, "", 0)
			call BlzFrameSetPoint((Scouter___MY_TEAMCOLOR ), ( FRAMEPOINT_TOPLEFT ), ( Scouter___MY_CONTAINER ), ( FRAMEPOINT_TOPLEFT ), (( s__Scouter_Scouter___INSET )*1.0) / 1800., (( - s__Scouter_Scouter___INSET)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetPoint((Scouter___MY_TEAMCOLOR ), ( FRAMEPOINT_BOTTOMRIGHT ), ( Scouter___MY_CONTAINER ), ( FRAMEPOINT_BOTTOMRIGHT ), (( - s__Scouter_Scouter___INSET )*1.0) / 1800., (( s__Scouter_Scouter___INSET)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetAlpha(Scouter___MY_TEAMCOLOR, 128)
			set Scouter___MY_ICON=BlzCreateFrameByType("BACKDROP", "", Scouter___MY_CONTAINER, "", 0)
