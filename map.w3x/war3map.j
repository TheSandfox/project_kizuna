			return this
  endfunction

  function s__ExtraAbilityIcon_onDestroy takes integer this returns nothing
			
//textmacro instance: destroyFrame(".nem_backdrop")
	call BlzDestroyFrame(s__ExtraAbilityIcon_nem_backdrop[this])
	set s__ExtraAbilityIcon_nem_backdrop[this]=null
//end of: destroyFrame(".nem_backdrop")
//textmacro instance: destroyFrame(".cooldown_backdrop")
