			set CUSTOM_RESPOND_ERROR_MESSAGE=msg
			call sc__Event_activate(CONFIG_EVENT_ERROR)
			set CUSTOM_RESPOND_ERROR_PLAYER=null
			set CUSTOM_RESPOND_ERROR_MESSAGE=""
			// if GetLocalPlayer() == p then
			// 	call PlaySoundBJ(gg_snd_Error)
			// endif
  endfunction



