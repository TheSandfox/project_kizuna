  endfunction

  function s__Unit_prototype__set_maxmp takes integer this,real np returns nothing
   local real v= 0.
			if s__Unit_prototype_maxmp_true[this] > 0. then
				set v=(s__Unit_prototype_mp_true[(this)]) / (s__Unit_prototype_maxmp_true[(this)]) // INLINED!!
			endif
			set s__Unit_prototype_maxmp_true[this]=np
			call BlzSetUnitMaxMana(s__Unit_prototype_origin_unit[this], R2I(s__Unit_prototype_maxmp_true[this]))
			call s__Unit_prototype__set_mp(this,(s__Unit_prototype_maxmp_true[(this)]) * v) // INLINED!!
