//library Movement ends
//library NPCUI:




  function s__NPCUI_registerChild takes framehandle container returns nothing
			set s__NPCUI_CHILD[s__NPCUI_CHILD_COUNT]=container
			set s__NPCUI_CHILD_COUNT=s__NPCUI_CHILD_COUNT + 1
  endfunction

  function s__NPCUI_break takes integer this returns nothing
   local integer i= 0
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(s__NPCUI_CONTAINER, false)
			endif
			loop
				exitwhen i >= s__NPCUI_CHILD_COUNT
				if GetLocalPlayer() == Player(this) then
					call BlzFrameSetVisible(s__NPCUI_CHILD[i], false)
				endif
				set i=i + 1
			endloop
			call PauseTimer((s__NPCUI_main_timer[this])) // INLINED!!
			set s__NPCUI_caster[this]=0
			set s__NPCUI_npc[this]=0
  endfunction

  function s__NPCUI_timerAction takes nothing returns nothing
   local integer this= (sg__TimerUtils___DATA_get(GetHandleId(((GetExpiredTimer()))) * HASH_UP / HASH_DOWN + HASH_BIAS)) // INLINED!!
			if s__NPCUI_caster[this] <= 0 or s__NPCUI_npc[this] <= 0 then
				
				call s__NPCUI_break(this)
				return
			endif
			if s__Math_distancePoints(sc__Object__get_x(s__NPCUI_caster[this]) , sc__Object__get_y(s__NPCUI_caster[this]) , sc__Object__get_x(s__NPCUI_npc[this]) , sc__Object__get_y(s__NPCUI_npc[this])) > 512. then
				call s__NPCUI_break(this)
				return
			endif
  endfunction

  function s__NPCUI_runTimer takes integer this returns nothing
			if s__NPCUI_main_timer[this] == null then
				set s__NPCUI_main_timer[this]=s__Timer_new(this)
			endif
			call TimerStart((s__NPCUI_main_timer[this] ), (( 0.5 )*1.0), ( true ), ( function s__NPCUI_timerAction)) // INLINED!!
  endfunction

  function s__NPCUI_show takes integer this,boolean flag,integer caster,integer npc returns nothing
			call s__NPCUI_break(this)
			set s__NPCUI_caster[this]=caster
			set s__NPCUI_npc[this]=npc
			if flag then
				if GetLocalPlayer() == Player(this) then
					call BlzFrameSetVisible(s__NPCUI_CONTAINER, true)
				endif
				call s__NPCUI_runTimer(this)
			endif
  endfunction

  function s__NPCUI_init takes framehandle parent returns nothing
   local integer i= 0
			set s__NPCUI_CONTAINER=BlzCreateFrameByType("FRAME", "NPCUI", parent, "", 0)
			loop
				exitwhen i >= bj_MAX_PLAYER_SLOTS
				set s__NPCUI_main_timer[(i)]=null
				set s__NPCUI_caster[(i)]=0
				set s__NPCUI_npc[(i)]=0
				set i=i + 1
			endloop
  endfunction



