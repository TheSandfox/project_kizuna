					call sc__Event_activate(CONFIG_EVENT_ERROR)
				endif
				set result=false
			
			else
				
				set nlv=s__AbilityMix_carculateMixLevel(am1 , am2)
				call s__AbilityMix_carculateUpgradePoint(am1 , am2)
				set nsignature=s__AbilityMixElement_isSignature(am1)
				call s__AbilityMixElement_kill(am1)
				call s__AbilityMixElement_kill(am2)
				if s__AbilityMixElement_element_type[am1] == s__AbilityMixElement_TYPE_ABILITY then
					
					set na=sc__Unit_prototype_addAbility(target,rabil)
					
					call sc__Ability_prototype_addLevel((na),nlv - 1)
					
					set s__Ability_signature[(na)]=nsignature
					
					set i=0
					loop
						exitwhen i >= CONFIG_UPGRADE_MAX
						call SaveInteger(Ability__HASH2, ((na)), s__Ability_INDEX_UPGRADE_POINT + (i ), ( s__AbilityMix_UPGRADE[i])) // INLINED!!
						call sc__Unit_addUpgradePoint(target,i , s__AbilityMix_REFUND[i])
						set i=i + 1
					endloop
					
					call sc__User_addGold((GetOwningPlayer(s__Unit_prototype_origin_unit[(target)])) , sc__Unit_getUpgradePoint(target,CONFIG_UPGRADE_GOLD)) // INLINED!!
					call sc__Unit_setUpgradePoint(target,CONFIG_UPGRADE_GOLD , 0)
				else
					
					set na=s__AbilityShard_create(rabil)
					call sc__Item_prototype_pick((na),target)
					
					call s__AbilityShard_addLevel((na),nlv - 1)
					
					set i=0
					loop
						exitwhen i >= CONFIG_UPGRADE_MAX
						call s__AbilityShard_setUpgradePoint((na),i , s__AbilityMix_UPGRADE[i])
						call sc__Unit_addUpgradePoint(target,i , s__AbilityMix_REFUND[i])
						set i=i + 1
					endloop
					
					call sc__User_addGold((GetOwningPlayer(s__Unit_prototype_origin_unit[(target)])) , sc__Unit_getUpgradePoint(target,CONFIG_UPGRADE_GOLD)) // INLINED!!
					call sc__Unit_setUpgradePoint(target,CONFIG_UPGRADE_GOLD , 0)
				endif
				
				call sc__Effect_setDuration(sc__AttatchedEffect_create(AbilityMix___EFFECT_PATH2 , target),2.0)
				set result=true
			endif
			
			if table > 0 then
				call sc__Array_destroy(table)
			endif
			return result
  endfunction

		
  function s__AbilityMix_mixLevel takes integer target,integer am1,integer am2 returns boolean
   local integer maxlv= (LoadInteger(Ability__HASH1, (s__AbilityMixElement_getId(am1)), s__Ability_INDEX_MAX_LEVEL)) // INLINED!!
   local integer i= 0
   local integer currentlv= s__AbilityMixElement_getLevel(am1)
			
			if s__AbilityMixElement_getLevel(am1) >= maxlv then
				set CUSTOM_RESPOND_ERROR_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[(target)])) // INLINED!!
				set CUSTOM_RESPOND_ERROR_MESSAGE="최대레벨에 도달한 스킬은 레벨업 합성이 불가능합니다."
				call sc__Event_activate(CONFIG_EVENT_ERROR)
				return false
			
			else
				
				if s__AbilityMixElement_getLevel(am1) + s__AbilityMixElement_getLevel(am2) > maxlv then
					
					loop
						exitwhen currentlv >= maxlv
						set i=0
						
						loop
							exitwhen s__AbilityMixElement_getUpgradePoint(am2,i) >= s__AbilityMixElement_getTier(am2) or i >= CONFIG_UPGRADE_MAX
							set i=i + 1
						endloop
						if i < CONFIG_UPGRADE_MAX then
							
							call s__AbilityMixElement_addUpgradePoint(am1,i , s__AbilityMixElement_getTier(am2))
							call s__AbilityMixElement_addUpgradePoint(am2,i , - s__AbilityMixElement_getTier(am2))
							set currentlv=currentlv + 1
						else
							
							exitwhen true
						endif
					endloop
					
					set i=0
					loop
						exitwhen i >= CONFIG_UPGRADE_MAX
						call sc__Unit_addUpgradePoint(target,i , s__AbilityMixElement_getUpgradePoint(am2,i))
						set i=i + 1
					endloop
					
					call s__AbilityMixElement_addLevel(am1,currentlv - s__AbilityMixElement_getLevel(am1))
				else
					
					set i=0
					loop
						exitwhen i >= CONFIG_UPGRADE_MAX
						call s__AbilityMixElement_addUpgradePoint(am1,i , s__AbilityMixElement_getUpgradePoint(am2,i))
						set i=i + 1
					endloop
					
					call s__AbilityMixElement_addLevel(am1,s__AbilityMixElement_getLevel(am2))
				endif
				
				call s__AbilityMixElement_kill(am2)
				
				call sc__Effect_setDuration(sc__AttatchedEffect_create(AbilityMix___EFFECT_PATH1 , target),2.0)
				return true
			endif
  endfunction

		
  function s__AbilityMix_extract takes integer a returns boolean
			if s__Ability_signature[a] then
				
				return false
			endif
			call s__AbilityShard_createFromAbility(a)
			call sc__Ability_prototype_kill(a)
			
			call sc__Effect_setDuration(sc__AttatchedEffect_create("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl" , s__Ability_prototype_owner[a]),2.0)
			call sc__Effect_setDuration(sc__AttatchedEffect_create("Abilities\\Spells\\Items\\AIil\\AIilTarget.mdl" , s__Ability_prototype_owner[a]),2.0)
			set CUSTOM_RESPOND_UI_REFRESH_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[a])])) // INLINED!!
			call sc__Event_activate(CONFIG_EVENT_ABILITY_UI_REFRESH)
			set CUSTOM_RESPOND_UI_REFRESH_PLAYER=null
			return true
  endfunction

  function s__AbilityMix_create takes integer base,integer material,integer result returns integer
   local integer this= s__AbilityMix_COUNTER
			set s__AbilityMix_main[this]=base
			set s__AbilityMix_main_level[this]=s__AbilityMix_LEVEL_REQUIRE
			set s__AbilityMix_sub[this]=material
			set s__AbilityMix_sub_level[this]=s__AbilityMix_LEVEL_REQUIRE
			set s__AbilityMix_result[this]=result
			call s__AbilityMix_registerRecipe(this)
			call s__AbilityMix_addRecommendRecipe(this)
			set s__AbilityMix_COUNTER=s__AbilityMix_COUNTER + 1
			return this
  endfunction

