   function s__Ability2030__exp_executeExplosion takes integer this,integer target returns nothing
    local integer ef= 0
				if IsUnitInGroup(s__Unit_prototype_origin_unit[target], s__Explosion_group_wave[this]) then
					set s__Explosion_damage[this]=( s__Unit_prototype_getCarculatedStatValue(s__Explosion_owner[this],Ability2030__DAMAGE_STAT1) * Ability2030__DAMAGE_AMPLIFIER1 ) * ( 1 + Ability2030__DAMAGE_PER_LEVEL * ( s__Ability2030__exp_level[this] ) )
				else
					set s__Explosion_damage[this]=( s__Unit_prototype_getCarculatedStatValue(s__Explosion_owner[this],Ability2030__DAMAGE_STAT1) * Ability2030__DAMAGE_AMPLIFIER1 ) * ( 1 + Ability2030__DAMAGE_PER_LEVEL * ( s__Ability2030__exp_level[this] ) )
				endif
				call s__Explosion_damageTarget(this,target)
				call s__Effect_setDuration(s__Effect_createAttatched(Ability2030__EFFECT_PATH2 , s__Unit_prototype_origin_unit[target] , "chest"),1.5)
				set ef=s__Effect_create(Ability2030__EFFECT_PATH3 , sc__Object__get_x(target) + GetRandomReal(- 25, 25) , sc__Object__get_y(target) , sc__Object__get_z(target) + s__Object_pivot_z[target] + GetRandomReal(- 25, 25) , 270.)
				call s__Effect_setRoll(ef,GetRandomReal(0., 360.))
				call s__Effect_setMatrixScale(ef,1.25 , 1.25 , 2.)
				call s__Effect_setAlpha(ef,192)
				call s__Effect_setDuration(ef,1.0)
   endfunction

   function s__Ability2030__exp_beforeExplosion takes integer this returns nothing
				set s__Explosion_x[this]=sc__Object__get_x(s__Explosion_owner[this])
				set s__Explosion_y[this]=sc__Object__get_y(s__Explosion_owner[this])
   endfunction

   function s__Ability2030__exp_create takes integer caster,real x,real y,real rad,integer level returns integer
    local integer this= s__Ability2030__exp__allocate(caster , x , y , rad)
				set s__Ability2030__exp_level[this]=level
				call s__Explosion_setDamageFlagById(this,Ability2030__ID)
				set s__Explosion_weapon_type[this]=WEAPON_TYPE_METAL_HEAVY_BASH
				set s__Explosion_damage[this]=( s__Unit_prototype_getCarculatedStatValue(s__Explosion_owner[this],Ability2030__DAMAGE_STAT1) * Ability2030__DAMAGE_AMPLIFIER1 ) * ( 1 + Ability2030__DAMAGE_PER_LEVEL * ( s__Ability2030__exp_level[this] ) )
				return this
   endfunction


	

   function s__Ability2030_actor_periodicAction takes integer this returns nothing
				set s__Ability2030_actor_anim_progress[this]=s__Ability2030_actor_anim_progress[this] + TIMER_TICK
				call s__Effect_setPosition(s__Ability2030_actor_c[this],sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , 5.) // INLINED!!
				call sc__Object__set_yaw((s__Actor_actor[(this)]),sc__Object__get_yaw((s__Actor_actor[(this)])) + 360 * TIMER_TICK * Ability2030__ROTSPEED) // INLINED!!
				if s__Ability2030_actor_anim_progress[this] >= Ability2030__INTERVAL then
					call s__Unit_prototype_setAnimSpeed((s__Actor_actor[(this)]),6.) // INLINED!!
					call s__Unit_prototype_setAnim((s__Actor_actor[(this)]),"stand") // INLINED!!
					call s__Unit_prototype_setAnim((s__Actor_actor[(this)]),"attack") // INLINED!!
					set s__Ability2030_actor_anim_progress[this]=s__Ability2030_actor_anim_progress[this] - Ability2030__INTERVAL
				endif
   endfunction
	
   function s__Ability2030_actor_create takes integer u,real x,real y,integer level returns integer
    local integer this= s__Ability2030_actor__allocate(u , 0 , x , y , level , Ability2030__INTERVAL * Ability2030__COUNT , true)
				call s__Unit_prototype_setAnim((s__Actor_actor[(this)]),"attack") // INLINED!!
				call s__Unit_prototype_setAnimSpeed((s__Actor_actor[(this)]),2.) // INLINED!!
				set s__Actor_progress_bar[this]=s__ProgressBar_create(Ability2030__NAME , (GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))]))) // INLINED!!
				set s__ProgressBar_reverse[s__Actor_progress_bar[this]]=true
				set s__Ability2030_actor_mover[this]=s__Mover_create((s__Actor_actor[(this)])) // INLINED!!
				set s__Mover_refresh_facing[s__Ability2030_actor_mover[this]]=false
				set s__Ability2030_actor_ex[this]=s__Ability2030__exp_create((s__Actor_actor[(this)]) , sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , Ability2030__RADIUS1 , level) // INLINED!!
				set s__Explosion_count[s__Ability2030_actor_ex[this]]=- 1
				set s__Explosion_interval[s__Ability2030_actor_ex[this]]=Ability2030__INTERVAL
				call s__Explosion_activate(s__Ability2030_actor_ex[this])
				set s__Ability2030_actor_c[this]=s__Circle_create(sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , 5. , Ability2030__RADIUS1) // INLINED!!
				set s__Circle_alpha_max[s__Ability2030_actor_c[this]]=0.45
