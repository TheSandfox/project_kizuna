//library UnitActor:



//Implemented from module SuspendFlag:




		
  function s__UnitActor_suspendFree takes integer this returns nothing
			set s__UnitActor_suspend_stun[this]=false
			set s__UnitActor_suspend_ensnare[this]=false
			set s__UnitActor_suspend_silence[this]=false
			set s__UnitActor_suspend_dead[this]=false
			set s__UnitActor_suspend_rclick[this]=false
			set s__UnitActor_suspend_ability[this]=false
			set s__UnitActor_suspend_stop[this]=false
			set s__UnitActor_suspend_target_decay[this]=false
			set s__UnitActor_suspend_grabbed[this]=false
			set s__UnitActor_suspend_target_dead[this]=false
  endfunction

		
  function s__UnitActor_suspendFilterAdditional takes integer this returns boolean
			return false
  endfunction

  function s__UnitActor_setSuspendEventFlag takes integer this,integer tp,integer status returns nothing
			set s__UnitActor_activate_suspend_event[this]=true
			set s__UnitActor_suspend_event_type[this]=tp
			set s__UnitActor_suspend_event_status[this]=status
  endfunction

		
  function s__UnitActor_suspendFilter takes integer this returns boolean
			if s__UnitActor_suspend_stun[this] and sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[(s__Actor_actor[(this)])],CONFIG_STATUS_STUN) > 0 then // INLINED!!
				call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_STATUS , CONFIG_STATUS_STUN)
				return true
			elseif s__UnitActor_suspend_grabbed[this] and sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[(s__Actor_actor[(this)])],CONFIG_STATUS_GRABBED) > 0 then // INLINED!!
				call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_STATUS , CONFIG_STATUS_GRABBED)
				return true
			elseif s__UnitActor_suspend_ensnare[this] and sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[(s__Actor_actor[(this)])],CONFIG_STATUS_ENSNARE) > 0 then // INLINED!!
				call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_STATUS , CONFIG_STATUS_ENSNARE)
				return true
			elseif s__UnitActor_suspend_silence[this] and sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[(s__Actor_actor[(this)])],CONFIG_STATUS_SILENCE) > 0 then // INLINED!!
				call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_STATUS , CONFIG_STATUS_SILENCE)
				return true
			elseif s__UnitActor_suspend_dead[this] and sc__Unit_prototype_isUnitType((s__Actor_actor[(this)]),UNIT_TYPE_DEAD) then // INLINED!!
				call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_STATUS , CONFIG_STATUS_DEAD)
				return true
			elseif s__UnitActor_suspend_target_dead[this] and s__UnitActor_target[this] > 0 and sc__Unit_prototype_isUnitType((s__UnitActor_target[this]),UNIT_TYPE_DEAD) then
				call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_TARGET_LOSS , CONFIG_STATUS_WHOKNOWS)
				return true
			endif
			return sc__UnitActor_suspendFilterAdditional(this)
  endfunction

		
  function s__UnitActor_suspendAction takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if (udg_EVENT_VALUE) == CONFIG_EVENT_KEYPRESS and CUSTOM_RESPOND_KEYPRESS_PRESS then // INLINED!!
				if CUSTOM_RESPOND_KEYPRESS_CASTER != (s__Actor_actor[(this)]) or CUSTOM_RESPOND_KEYPRESS_CASTER <= 0 then // INLINED!!
					return
				endif
				if CUSTOM_RESPOND_KEYPRESS_KEY != OSKEY_S and CUSTOM_RESPOND_KEYPRESS_KEY != OSKEY_H then
					return
				endif
				if s__UnitActor_suspend_stop[this] then
					
					call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_KEYPRESS , CONFIG_STATUS_WHOKNOWS)
					call sc__Actor_onSuspend(this)
					call sc__Actor_prototype_deallocate(this)
				else
					call sc__UnitActor_onStop(this)
				endif
				return
			endif
			if (udg_EVENT_VALUE) == CONFIG_EVENT_CLICK and CUSTOM_RESPOND_CLICK_BUTTON_TYPE == MOUSE_BUTTON_TYPE_RIGHT then // INLINED!!
				if CUSTOM_RESPOND_CLICK_CASTER == (s__Actor_actor[(this)]) then // INLINED!!
					if s__UnitActor_suspend_rclick[this] and sc__Unit_prototype_isMoveable((s__Actor_actor[(this)])) then // INLINED!!
						
						if s__UnitActor_target[this] > 0 then
							
							if s__Unit_prototype_origin_unit[(s__UnitActor_target[this])] != CUSTOM_RESPOND_CLICK_TARGET then
								
								call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_CLICK , CONFIG_STATUS_WHOKNOWS)
								call sc__Actor_onSuspend(this)
								call sc__Actor_prototype_deallocate(this)
								return
							endif
						else
							
							call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_CLICK , CONFIG_STATUS_WHOKNOWS)
							call sc__Actor_onSuspend(this)
							call sc__Actor_prototype_deallocate(this)
							return
						endif
					else
						
						call sc__UnitActor_onRightClick(this)
						return
					endif
				endif
			endif
			if (udg_EVENT_VALUE) == CONFIG_EVENT_ABILITY_FOLLOW then // INLINED!!
				if CUSTOM_RESPOND_ABILITY_CASTER == (s__Actor_actor[(this)]) and s__UnitActor_suspend_ability[this] then // INLINED!!
					if not s__Ability_prototype_useable_cast[(CUSTOM_RESPOND_ABILITY_INSTANCE)] then
						call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_CLICK , CONFIG_STATUS_WHOKNOWS)
						call sc__Actor_onSuspend(this)
						call sc__Actor_prototype_deallocate(this)
						return
					endif
				endif
				return
			endif
			if (udg_EVENT_VALUE) == CONFIG_EVENT_DECAY then // INLINED!!
				if (s__Actor_actor[(this)]) > 0 and (s__Actor_actor[(this)]) == CUSTOM_RESPOND_DECAY_UNIT then // INLINED!!
					call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_STATUS , CONFIG_STATUS_DEAD)
					call sc__Actor_onSuspend(this)
					call sc__Actor_prototype_deallocate(this)
					return
				endif
				if s__UnitActor_target[this] > 0 and s__UnitActor_target[this] == CUSTOM_RESPOND_DECAY_UNIT then
					if s__UnitActor_suspend_target_decay[this] then
						call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_TARGET_LOSS , CONFIG_STATUS_WHOKNOWS)
						call sc__Actor_onSuspend(this)
						call sc__Actor_prototype_deallocate(this)
						return
					else
						call sc__UnitActor_targetDecay(this)
					endif
				endif
				return
			endif
  endfunction

  function s__UnitActor_registerSuspendTrigger takes integer this returns nothing
			set s__UnitActor_suspend_trigger[this]=s__Trigger_create(this)
			call s__Trigger_addCondition(s__UnitActor_suspend_trigger[this],function s__UnitActor_suspendAction)
			call TriggerRegisterVariableEvent((s__Trigger_main_trigger[s__UnitActor_suspend_trigger[this]] ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_KEYPRESS)*1.0)) // INLINED!!
			call TriggerRegisterVariableEvent((s__Trigger_main_trigger[s__UnitActor_suspend_trigger[this]] ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_CLICK)*1.0)) // INLINED!!
			call TriggerRegisterVariableEvent((s__Trigger_main_trigger[s__UnitActor_suspend_trigger[this]] ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_ABILITY_FOLLOW)*1.0)) // INLINED!!
			call TriggerRegisterVariableEvent((s__Trigger_main_trigger[s__UnitActor_suspend_trigger[this]] ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_DECAY)*1.0)) // INLINED!!
  endfunction

  function s__UnitActor_unregisterSuspendTrigger takes integer this returns nothing
			call sc__Trigger_prototype_deallocate(s__UnitActor_suspend_trigger[this])
			set s__UnitActor_suspend_trigger[this]=0
  endfunction


  function s__UnitActor_setAnimSpeed takes integer this,real v returns nothing
			set s__Actor_anim_speed[this]=v
