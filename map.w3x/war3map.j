 function s__StatItem_setTarget takes integer this,integer nt returns nothing
		set s__StatItem_target[this]=nt
 endfunction

	
 function s__StatItem_initFrames takes integer index,integer stat_index returns nothing
  local framehandle f= null
		set s__s__StatItem_STAT_ITEM[index]= BlzCreateSimpleFrame("CStatIndicatorItem", FRAME_STAT_INDICATOR, index)
		call BlzFrameSetPoint((s__s__StatItem_STAT_ITEM[index] ), ( FRAMEPOINT_TOPLEFT ), ( FRAME_STAT_INDICATOR ), ( FRAMEPOINT_TOPLEFT ), (( s__StatItem_STAT_ITEM_INSET_HORIZONTAL )*1.0) / 1800., (( - s__StatItem_STAT_ITEM_OFFSET_Y - ( s__StatItem_STAT_ITEM_HEIGHT * index ) - ( s__StatItem_STAT_ITEM_GAP * index ))*1.0) / 1800.) // INLINED!!
		call BlzFrameSetPoint((s__s__StatItem_STAT_ITEM[index] ), ( FRAMEPOINT_BOTTOMRIGHT ), ( FRAME_STAT_INDICATOR ), ( FRAMEPOINT_TOPRIGHT ), (( - s__StatItem_STAT_ITEM_INSET_HORIZONTAL )*1.0) / 1800., (( - s__StatItem_STAT_ITEM_OFFSET_Y - ( s__StatItem_STAT_ITEM_HEIGHT * index ) - ( s__StatItem_STAT_ITEM_GAP * index ) - s__StatItem_STAT_ITEM_HEIGHT)*1.0) / 1800.) // INLINED!!
		
		set s__s__StatItem_STAT_ICON[index]= BlzGetFrameByName("CStatIndicatorItemIcon", index)
		call BlzFrameSetTexture(s__s__StatItem_STAT_ICON[index], UDG_STAT_ICON[stat_index], 0, true)
		
		set s__s__StatItem_STAT_NAME[index]= BlzGetFrameByName("CStatIndicatorItemName", index)
		call BlzFrameSetText(s__s__StatItem_STAT_NAME[index], UDG_STAT_NAME[stat_index])
		
		set s__s__StatItem_STAT_VALUE[index]= BlzGetFrameByName("CStatIndicatorItemValue", index)
		
		set f=BlzGetFrameByName("CStatIndicatorItemUnderline", index)
		call BlzFrameSetVertexColor(f, BlzConvertColor(R2I(255 * 0.25), R2I(255 * 1.0), R2I(255 * 0.8), 0))
		//
		set s__s__StatItem_FLAG_FRAME[index]= true
		set f=null
 endfunction

 function s__StatItem_create takes integer stat_index,player owner returns integer
  local integer this= GetPlayerId(owner) * s__StatItem_COUNTS + s__s__StatItem_COUNTER[GetPlayerId(owner)]
		set s__StatItem_owner[this]=owner
		set s__StatItem_stat_index[this]=stat_index
		set s__StatItem_index[this]=s__s__StatItem_COUNTER[GetPlayerId(owner)]
		
		if s__StatItem_stat_index[this] == ENUM_STAT_ATTACK_SPEED then
			set s__StatItem_format[this]=2
		elseif s__StatItem_stat_index[this] == ENUM_STAT_HPREGEN or s__StatItem_stat_index[this] == ENUM_STAT_MPREGEN or s__StatItem_stat_index[this] == ENUM_STAT_ARMOR_PENET or s__StatItem_stat_index[this] == ENUM_STAT_MAGIC_PENET then
			set s__StatItem_format[this]=1
		endif
		
		if not s__s__StatItem_FLAG_FRAME[s__StatItem_index[this]] then
			call s__StatItem_initFrames(s__StatItem_index[this] , s__StatItem_stat_index[this])
		endif
		set s__s__StatItem_COUNTER[GetPlayerId(owner)]= s__s__StatItem_COUNTER[GetPlayerId(owner)] + 1
		return this
 endfunction

 function s__StatItem_get takes integer pid,integer index returns integer
		return pid * s__StatItem_COUNTS + index
 endfunction

 function s__StatItem_onInit takes nothing returns nothing
  local integer i= 0
		loop
			exitwhen i >= 32
			set s__s__StatItem_FLAG_FRAME[i]= false
			set s__s__StatItem_COUNTER[i]= 0
			set i=i + 1
		endloop
 endfunction



	
	

 function s__StatIndicator_refreshTarget takes integer this,integer target returns nothing
  local integer i= 0
		
		loop
			exitwhen i >= s__StatItem_COUNTS
			set s__StatItem_target[(((this ) * s__StatItem_COUNTS + ( i)))]=(target) // INLINED!!
			set i=i + 1
		endloop
 endfunction

 function s__StatIndicator_refresh takes integer this returns nothing
  local integer i= 0
		if ( not s__StatIndicator_visible[this] ) then
			return
		endif
		
		loop
			exitwhen i >= s__StatItem_COUNTS
			call s__StatItem_refresh(((this ) * s__StatItem_COUNTS + ( i))) // INLINED!!
			set i=i + 1
		endloop
 endfunction

 function s__StatIndicator_show takes integer this,boolean flag returns nothing
		if GetLocalPlayer() == Player(this) then
			call BlzFrameSetVisible(FRAME_STAT_INDICATOR, flag)
			call PlaySoundBJ(gg_snd_BigButtonClick)
		endif
		if s__StatIndicator_visible[this] != flag then
			if flag then
				
				call s__Array_add(s__CloseUI_list[(this)],s__CloseUI_ORDER_STAT_INDICATOR)
			else
				
				call s__Array_eraseFor(s__CloseUI_list[(this)],s__CloseUI_ORDER_STAT_INDICATOR)
			endif
		endif
		set s__StatIndicator_visible[this]=flag
		
		call s__StatIndicator_refresh(this)
 endfunction

 function s__StatIndicator_switch takes integer this returns nothing
		call s__StatIndicator_show(this,not s__StatIndicator_visible[this])
 endfunction

 function s__StatIndicator_close takes integer this returns boolean
		if s__StatIndicator_visible[this] then
			call s__StatIndicator_show(this,false)
			return true
		endif
		return false
 endfunction

 function s__StatIndicator_keypress takes nothing returns nothing
  local integer this= 0
  local player p= GetTriggerPlayer()
		if (udg_EVENT_VALUE) == ENUM_EVENT_KEYPRESS then // INLINED!!
			set this=GetPlayerId(EVT_KEYPRESS_PLAYER)
			if EVT_KEYPRESS_KEY == OSKEY_C and EVT_KEYPRESS_PRESS then
				call s__StatIndicator_switch(this)
				return
			endif
			return
		endif
		set this=GetPlayerId(p)
		if BlzGetTriggerFrameEvent() == FRAMEEVENT_CONTROL_CLICK then
			
			
			if GetLocalPlayer() == p then
				call PlaySoundBJ(gg_snd_BigButtonClick)
			endif
			call s__StatIndicator_close(this)
		else
			
			call s__StatIndicator_switch(this)
		endif
 endfunction

 function s__StatIndicator_menuButtonCallback takes nothing returns nothing
   local integer this= GetPlayerId(GetTriggerPlayer())
			if this >= CONFIG_PLAYER_MAX then
				return
			endif
			call s__StatIndicator_switch(this)
  endfunction

 function s__StatIndicator_initFrame takes nothing returns nothing
  local trigger t= null
		// 닫기버튼
		set s__StatIndicator_CLOSE=BlzGetFrameByName("CStatIndicatorCloseButton", 0)
		
		set t=CreateTrigger()
		call BlzTriggerRegisterFrameEvent(t, BlzGetFrameByName("CStatIndicatorMenuButton", 0), FRAMEEVENT_CONTROL_CLICK)
		call TriggerAddCondition(t, Condition(function s__StatIndicator_menuButtonCallback))
		set t=null
 endfunction

 function s__StatIndicator_create takes player p returns integer
  local integer this= GetPlayerId(p)
		if not s__StatIndicator_INIT_FRAME then
			call s__StatIndicator_initFrame()
			set s__StatIndicator_INIT_FRAME=true
		endif
		//
		
		call s__StatItem_create(ENUM_STAT_MAXHP , p)
		call s__StatItem_create(ENUM_STAT_HPREGEN , p)
		call s__StatItem_create(ENUM_STAT_MAXMP , p)
		call s__StatItem_create(ENUM_STAT_MPREGEN , p)
		call s__StatItem_create(ENUM_STAT_ATTACK , p)
		call s__StatItem_create(ENUM_STAT_DEFENSE , p)
		call s__StatItem_create(ENUM_STAT_ARMOR_PENET , p)
		call s__StatItem_create(ENUM_STAT_MAGICPOWER , p)
		call s__StatItem_create(ENUM_STAT_RESISTANCE , p)
		call s__StatItem_create(ENUM_STAT_MAGIC_PENET , p)
		call s__StatItem_create(ENUM_STAT_ACCURACY , p)
		call s__StatItem_create(ENUM_STAT_EVASION , p)
		call s__StatItem_create(ENUM_STAT_SPELL_BOOST , p)
		call s__StatItem_create(ENUM_STAT_LUCK , p)
		// call StatItem.create(ENUM_STAT_RODONG,p)
		call s__StatItem_create(ENUM_STAT_INSIGHT , p)
		// call StatItem.create(ENUM_STAT_LOVE,p)
		// call StatItem.create(ENUM_STAT_GREED,p)
		call s__StatItem_create(ENUM_STAT_MOVEMENT_SPEED , p)
		call s__StatItem_create(ENUM_STAT_ATTACK_SPEED , p)
		call s__StatItem_create(ENUM_STAT_ATTACK_RANGE , p)
		//
		call BlzTriggerRegisterFrameEvent(s__StatIndicator_KEYPRESS, s__StatIndicator_CLOSE, FRAMEEVENT_CONTROL_CLICK)
		set s__StatIndicator_visible[this]=false
		return this
 endfunction

 function s__StatIndicator_onInit takes nothing returns nothing
  local trigger t
		set s__StatIndicator_KEYPRESS=CreateTrigger()
		call TriggerAddCondition(s__StatIndicator_KEYPRESS, Condition(function s__StatIndicator_keypress))
		call TriggerRegisterVariableEvent((s__StatIndicator_KEYPRESS ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_KEYPRESS)*1.0)) // INLINED!!
 endfunction

