  function s__Effect_create takes string path,real x,real y,real z,real ya returns integer
   local integer this= s__Effect__allocate()
			set s__Effect_origin_effect[this]=AddSpecialEffect(path, x, y)
			set s__Effect_decay_timer[this]=null
			call s__Effect_initializeOffset(this)
			call sc__Object__set_x(this,x)
			call sc__Object__set_y(this,y)
			call sc__Object__set_z(this,z)
			call s__Effect_setYaw(this,ya)
			call s__Effect_setPitch(this,0)
			call s__Effect_setRoll(this,0)
			call s__Effect_setAnim(this,ANIM_TYPE_BIRTH)
			call s__Effect_setAnim(this,ANIM_TYPE_STAND)
			return this
  endfunction
	
  function s__Effect_createAttatched takes string path,widget target,string attatch returns integer
   local integer this= s__Effect__allocate()
			set s__Effect_origin_effect[this]=AddSpecialEffectTarget(path, target, attatch)
			set s__Effect_decay_timer[this]=null
			return this
  endfunction
	
  function s__Effect_onDestroy takes integer this returns nothing
			if s__Effect_decay_timer[this] != null then
				call ReleaseTimer(s__Effect_decay_timer[this])
			endif
			if s__Effect_origin_effect[this] != null then
				if s__Effect_want_remove[this] then
					call DestroyEffect(s__Effect_origin_effect[this])
				else
					call s__EffectDecay_create(s__Effect_origin_effect[this])
				endif
			endif
			set s__Effect_decay_timer[this]=null
			set s__Effect_origin_effect[this]=null
  endfunction
	



  function s__AttatchedEffect_timerAction takes nothing returns nothing
   local integer this= (sg__TimerUtils___DATA_get(GetHandleId(((GetExpiredTimer()))) * HASH_UP / HASH_DOWN + HASH_BIAS)) // INLINED!!
			call s__Effect_setPosition(this,sc__Object__get_x(s__AttatchedEffect_target[this]) , sc__Object__get_y(s__AttatchedEffect_target[this]) , sc__Object__get_z(s__AttatchedEffect_target[this]))
  endfunction

  function s__AttatchedEffect_create takes string path,integer target returns integer
   local integer this= s__AttatchedEffect__allocate(path , sc__Object__get_x(target) , sc__Object__get_y(target) , sc__Object__get_z(target) , 270.)
			set s__AttatchedEffect_target[this]=target
			set s__AttatchedEffect_attatch_timer[this]=s__Timer_new(this)
			call TimerStart((s__AttatchedEffect_attatch_timer[this] ), (( TIMER_TICK )*1.0), ( true ), ( function s__AttatchedEffect_timerAction)) // INLINED!!
			return this
  endfunction

