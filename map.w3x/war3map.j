   function s__Ability20i0__mytower_deathCallback takes nothing returns nothing
    local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
				if EVT_DEATH_UNIT != this then
