  function s__Unit_prototype_plusAeth takes integer this returns nothing
			set s__Unit_prototype_aeth[this]=s__Unit_prototype_aeth[this] + 1
			if s__Unit_prototype_aeth[this] == 1 then
				call UnitAddAbility(s__Unit_prototype_origin_unit[this], 'Aeth')
				call SetUnitPathing(s__Unit_prototype_origin_unit[this], false)
			endif
  endfunction

  function s__Unit_prototype_minusAeth takes integer this returns nothing
			set s__Unit_prototype_aeth[this]=s__Unit_prototype_aeth[this] - 1
			if s__Unit_prototype_aeth[this] == 0 then
				call UnitRemoveAbility(s__Unit_prototype_origin_unit[this], 'Aeth')
				call SetUnitPathing(s__Unit_prototype_origin_unit[this], true)
			endif
  endfunction

