  function s__Buff10v0_main_addValue takes integer this returns nothing
   local real r= s__Unit_prototype_getCarculatedStatValue(s__Buff_caster[this],Buff10v0_DAMAGE_STAT1) * Buff10v0_DAMAGE_AMPLIFIER1 * ( 1 + Buff10v0_DAMAGE_PER_LEVEL * s__Buff_level[this] )
			set s__Buff10v0_main_val[this]=s__Buff10v0_main_val[this] + Buff10v0_DATA_REAL1
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],CONFIG_STAT_MOVEMENT_SPEED , Buff10v0_DATA_REAL1)
			set s__Buff10v0_main_v[this]=s__Buff10v0_main_v[this] + r
			call s__Unit_prototype_minusStatValue(s__Buff_target[this],CONFIG_STAT_ATTACK , r)
  endfunction

  function s__Buff10v0_main_update takes integer this returns boolean
			call s__Buff10v0_main_addValue(this)
			return true
  endfunction

  function s__Buff10v0_main_init takes integer this returns boolean
			call s__Buff10v0_main_addValue(this)
			call s__Buff_addEffect(this,s__Effect_createAttatched(s__Buff10v0_main_EFFECT_PATH1 , s__Unit_prototype_origin_unit[s__Buff_target[this]] , "chest"))
			return true
  endfunction

