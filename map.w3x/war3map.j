				call s__Missile__set_velo(this,Ability1080__VELO)
				set s__Missile_damage[this]=( s__Unit_prototype_getCarculatedStatValue(s__Missile_owner[this],Ability1080__DAMAGE_STAT1) * Ability1080__DAMAGE_AMPLIFIER1 ) * ( 1 + Ability1080__DAMAGE_PER_LEVEL * ( level ) )
