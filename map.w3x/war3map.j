//textmacro instance: demonicAllocate("EffectDecay_prototype")
 function EffectDecay_prototype_demonicAllocate takes nothing returns integer
  local integer this=si__EffectDecay_prototype_F
		   if ( this != 0 ) then
			   set si__EffectDecay_prototype_F=si__EffectDecay_prototype_V[this]
		   else
			   set si__EffectDecay_prototype_I=si__EffectDecay_prototype_I + 1
			   set this=si__EffectDecay_prototype_I
		   endif
		   set si__EffectDecay_prototype_type[this]=0
		   set si__EffectDecay_prototype_V[this]=- 1
		return this
	endfunction
//end of: demonicAllocate("EffectDecay_prototype")


  function s__EffectDecay_prototype_create takes nothing returns integer
   local integer this= EffectDecay_prototype_demonicAllocate()
			return this
  endfunction


	
	
  function s__EffectDecay_decay takes nothing returns nothing
   local integer this= sc__Timer_getData(GetExpiredTimer())
			call sc__EffectDecay_prototype_deallocate(this)
  endfunction
	
  function s__EffectDecay_create takes effect ef returns integer
   local integer this= s__EffectDecay__allocate()
			set s__EffectDecay_origin_effect[this]=ef
			set s__EffectDecay_t[this]=sc__Timer_new(this)
			call BlzPlaySpecialEffect(s__EffectDecay_origin_effect[this], ANIM_TYPE_DEATH)
			call TimerStart((s__EffectDecay_t[this] ), (( 1.5 )*1.0), ( false ), ( function s__EffectDecay_decay)) // INLINED!!
			return this
  endfunction

  function s__EffectDecay_onDestroy takes integer this returns nothing
			call DestroyEffect(s__EffectDecay_origin_effect[this])
			call sc__Timer_release(s__EffectDecay_t[this])
			set s__EffectDecay_origin_effect[this]=null
			set s__EffectDecay_t[this]=null
  endfunction
	


