  function s__UI_refreshAbilityIconsTarget takes integer this returns nothing
   local integer i= 0
			loop
				exitwhen i >= 10
				call s__AbilityIcon_setTarget((GetPlayerId((Player(this) )) * CONFIG_ABILITY_SIZE + ( i)),s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[s__UI_target[this]],i)) // INLINED!!
				set i=i + 1
			endloop
  endfunction

  function s__UI_refreshAbilityIcons takes integer this returns nothing
   local integer i= 0
   local integer ai= 0
			loop
				exitwhen i >= 10
				set ai=(GetPlayerId((Player(this) )) * CONFIG_ABILITY_SIZE + ( i)) // INLINED!!
				call s__AbilityIcon_refresh(ai)
				if s__AbilityIcon_mouse_in[ai] then
					call s__AbilityIcon_refreshTooltip(ai)
				endif
				set i=i + 1
			endloop
  endfunction

  function s__UI_refreshPeriodic takes integer this returns nothing
			if GetLocalPlayer() == Player(this) then
				
				call BlzFrameSetVisible(s__UI_HP_FILL, (s__Unit_prototype_maxhp_true[(s__UI_target[this])]) > 0.) // INLINED!!
				call BlzFrameSetPoint(s__UI_HP_FILL, FRAMEPOINT_TOPRIGHT, FRAME_HP_BAR, FRAMEPOINT_TOPLEFT, (((UI___BAR_WIDTH)*1.0) / 1800.) * ( (s__Unit_prototype_hp_true[(s__UI_target[this])]) / (s__Unit_prototype_maxhp_true[(s__UI_target[this])]) ), 0.) // INLINED!!
				call BlzFrameSetVisible(s__UI_MP_FILL, (s__Unit_prototype_maxmp_true[(s__UI_target[this])]) > 0.) // INLINED!!
				if (s__Unit_prototype_maxmp_true[(s__UI_target[this])]) > 0. then // INLINED!!
					call BlzFrameSetPoint(s__UI_MP_FILL, FRAMEPOINT_TOPRIGHT, FRAME_MP_BAR, FRAMEPOINT_TOPLEFT, (((UI___BAR_WIDTH)*1.0) / 1800.) * ( (s__Unit_prototype_mp_true[(s__UI_target[this])]) / (s__Unit_prototype_maxmp_true[(s__UI_target[this])]) ), 0.) // INLINED!!
				endif
				call BlzFrameSetText(s__UI_HP_TEXT, I2S(MathRound((s__Unit_prototype_hp_true[(s__UI_target[this])]))) + " / " + I2S(MathRound((s__Unit_prototype_maxhp_true[(s__UI_target[this])]))) + " (+" + R2SW((s__Unit_prototype_getCarculatedStatValue((s__UI_target[this]),CONFIG_STAT_HPREGEN)), 1, 1) + ")") // INLINED!!
				call BlzFrameSetVisible(s__UI_MP_TEXT, (s__Unit_prototype_maxmp_true[(s__UI_target[this])]) > 0.) // INLINED!!
				call BlzFrameSetText(s__UI_MP_TEXT, I2S(MathRound((s__Unit_prototype_mp_true[(s__UI_target[this])]))) + " / " + I2S(MathRound((s__Unit_prototype_maxmp_true[(s__UI_target[this])]))) + " (+" + R2SW((s__Unit_prototype_getCarculatedStatValue((s__UI_target[this]),CONFIG_STAT_MPREGEN)), 1, 1) + ")") // INLINED!!
				
				call BlzFrameSetVisible(FRAME_SP_BAR, s__Shield__get_count((s__UI_target[this])) > 0)
				call BlzFrameSetVisible(s__UI_SP_FILL, s__Shield_shield_max[(s__UI_target[this])] > 0.)
				if s__Shield_shield_max[(s__UI_target[this])] > 0. then
					call BlzFrameSetPoint(s__UI_SP_FILL, FRAMEPOINT_TOPRIGHT, FRAME_SP_BAR, FRAMEPOINT_TOPLEFT, (((UI___BAR_WIDTH)*1.0) / 1800.) * ( s__Shield_shield_amount[(s__UI_target[this])] / s__Shield_shield_max[(s__UI_target[this])] ), 0.) // INLINED!!
				endif
				call BlzFrameSetVisible(s__UI_SP_TEXT, s__Shield__get_count((s__UI_target[this])) > 0)
				call BlzFrameSetText(s__UI_SP_TEXT, I2S(MathRound(s__Shield_shield_amount[(s__UI_target[this])])) + " / " + I2S(MathRound(s__Shield_shield_max[(s__UI_target[this])])))
				
				call BlzFrameSetText(s__UI_LEVEL_TEXT, " Lv." + I2S((s__Unit_prototype_level_true[(s__UI_target[this])])) + " ") // INLINED!!
				
				call BlzFrameSetVisible(s__UI_EXP_FILL, s__Unit_prototype_exp[s__UI_target[this]] > 0.)
				call BlzFrameSetPoint(s__UI_EXP_FILL, FRAMEPOINT_TOPRIGHT, FRAME_EXP_BAR, FRAMEPOINT_TOPLEFT, (((UI___STAT1_WIDTH)*1.0) / 1800.) * ( I2R(s__Unit_prototype_exp[s__UI_target[this]]) / I2R(s__Unit_prototype_exp_max[s__UI_target[this]]) ), 0.) // INLINED!!
				call BlzFrameSetText(s__UI_EXP_TEXT, "|cff000000" + R2SW(I2R(s__Unit_prototype_exp[s__UI_target[this]]) / I2R(s__Unit_prototype_exp_max[s__UI_target[this]]), 1, 1) + "%|r")
			endif
			
			call s__UI_refreshAbilityIcons(this)
			
			call s__StatIndicator_refresh(((this))) // INLINED!!
			
			if s__UI_ability_error_lifespan[this] > 0. then
				set s__UI_ability_error_lifespan[this]=s__UI_ability_error_lifespan[this] - 0.1
				if s__UI_ability_error_lifespan[this] < 0. then
					set s__UI_ability_error_lifespan[this]=0.
					if GetLocalPlayer() == Player(this) then
						call BlzFrameSetText(s__UI_ABILITY_ERROR, "")
					endif
				endif
			endif
  endfunction

  function s__UI_setTarget takes integer this,integer nt returns nothing
			set s__UI_target[this]=nt
			call s__BuffIndicator_setTarget((this),nt)
			call s__UI_refreshAbilityIconsTarget(this)
			call s__UI_refreshStatIconsTarget(this)
			call s__UI_refreshName(this)
			call s__ChinghoFrame_setTarget(s__UI_chingho[this],s__Ability_prototype_id[s__Unit_chingho[s__UI_target[this]]])
			call s__UI_refreshPeriodic(this)
  endfunction

  function s__UI_timerAction takes nothing returns nothing
   local integer this= (sg__TimerUtils___DATA_get(GetHandleId(((GetExpiredTimer()))) * HASH_UP / HASH_DOWN + HASH_BIAS)) // INLINED!!
			call s__UI_refreshPeriodic(this)
  endfunction

  function s__UI_onLevel takes nothing returns nothing
   local integer u= CUSTOM_RESPOND_LEVEL_UNIT
   local integer this= 0
			if CUSTOM_RESPOND_LEVEL_UNIT <= 0 then
				return
			endif
			set this=GetPlayerId((GetOwningPlayer(s__Unit_prototype_origin_unit[(u)]))) // INLINED!!
			call s__UI_setTarget(this,s__UI_target[this])
  endfunction

  function s__UI_create takes player p returns integer
   local integer this= GetPlayerId(p)
   local integer i= 0
   local integer ia= 0
   local integer sa= 0
			set s__UI_main_timer[this]=s__Timer_new(this)
			
			set s__UI_chingho[this]=s__ChinghoFrame_create(s__UI_CONTAINER , FRAME_STAT1)
			
			loop
				exitwhen i >= 10
				set ia=s__AbilityIcon_create(i , s__UI_CONTAINER , p)
				//call ia.setTarget(target.getAbility(i))
				set i=i + 1
			endloop
			
			call sc__SkillShop_create(p)
			call sc__SlotChanger_create(p)
			call sc__CloseUI_create(p)
			call sc__Inventory_create(p)
			call s__Numberpad_create(p)
			call s__StatIndicator_create(p , FRAME_STAT2)
			call s__Scouter_create(p)
			call s__CameraSetup_create(p)
			call s__BuffIndicator_create(p)
			call s__AbilityManager_create(p)
			
			call s__UI_setTarget(this,(s__User_FOCUS_UNIT[GetPlayerId((p))])) // INLINED!!
			
			call TimerStart((s__UI_main_timer[this] ), (( 0.1 )*1.0), ( true ), ( function s__UI_timerAction)) // INLINED!!
			return this
  endfunction

  function s__UI_destroy takes integer this returns nothing
   local integer i= 0
   local integer ii= 0
			if s__UI_chingho[this] > 0 then
				call s__ChinghoFrame_deallocate(s__UI_chingho[this])
			endif
			call ReleaseTimer((s__UI_main_timer[this])) // INLINED!!
			set s__UI_main_timer[this]=null
  endfunction

  function s__UI_genericButtonAction takes nothing returns nothing
			if GetLocalPlayer() == GetTriggerPlayer() then
				call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
				call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
			endif
			if BlzGetTriggerFrameEvent() != FRAMEEVENT_CONTROL_CLICK then
				return
			endif
			if BlzGetTriggerFrame() == FRAME_SKILL_SHOP_BUTTON then
				call sc__SkillShop_switch((GetPlayerId(GetTriggerPlayer())))
				return
			elseif BlzGetTriggerFrame() == FRAME_SLOT_CHANGER_BUTTON then
				call sc__SlotChanger_switch((GetPlayerId(GetTriggerPlayer())))
				return
			elseif BlzGetTriggerFrame() == FRAME_INVENTORY_BUTTON then
				call sc__Inventory_switch((GetPlayerId(GetTriggerPlayer())))
				return
			elseif BlzGetTriggerFrame() == FRAME_STAT_INDICATOR_BUTTON then
				call s__StatIndicator_switch((GetPlayerId(GetTriggerPlayer())))
				return
			elseif BlzGetTriggerFrame() == FRAME_ABILITY_MANAGER_BUTTON then
				call s__AbilityManager_switch((GetPlayerId(GetTriggerPlayer())))
				return
			// elseif BlzGetTriggerFrame() == FRAME_INVENTORY_CATEGORY_BUTTON[0] then
			// 	call Inventory(GetPlayerId(GetTriggerPlayer())).changeCategory(0)
			// 	return
			// elseif BlzGetTriggerFrame() == FRAME_INVENTORY_CATEGORY_BUTTON[ITEMTYPE_FOOD] then
			// 	call Inventory(GetPlayerId(GetTriggerPlayer())).changeCategory(ITEMTYPE_FOOD)
			// 	return
			// elseif BlzGetTriggerFrame() == FRAME_INVENTORY_CATEGORY_BUTTON[ITEMTYPE_GACHA] then
			// 	call Inventory(GetPlayerId(GetTriggerPlayer())).changeCategory(ITEMTYPE_GACHA)
			// 	return
			endif
  endfunction

