 function s__BossPatternIndicator_create takes real x,real y,real radius,real duration,string tstring returns integer
  local integer this= s__BossPatternIndicator__allocate()
		if duration <= 0. then
			set s__BossPatternIndicator_duration_max[this]=1.0
			set s__BossPatternIndicator_duration[this]=1.0
		else
			set s__BossPatternIndicator_duration_max[this]=duration
			set s__BossPatternIndicator_duration[this]=duration
		endif
		set s__BossPatternIndicator_x[this]=x
		set s__BossPatternIndicator_y[this]=y
		if tstring == "circle" then
			set s__BossPatternIndicator_type[this]=0
		elseif tstring == "line" then
			set s__BossPatternIndicator_type[this]=1
		else
			set s__BossPatternIndicator_type[this]=0
		endif
		if s__BossPatternIndicator_type[this] == 0 then
			set s__BossPatternIndicator_outter[this]=sc__Effect_create("Effects\\CastRangeCircle.mdl" , x , y , 1.0 , 0.)
			set s__BossPatternIndicator_inner[this]=sc__Effect_create("Effects\\CastRangeCircle.mdl" , x , y , 4.0 , 0.)
			call sc__Effect_setScale(s__BossPatternIndicator_outter[this],radius / 100.)
		elseif s__BossPatternIndicator_type[this] == 1 then
			set s__BossPatternIndicator_outter[this]=sc__Effect_create("Effects\\RLine.mdl" , x , y , 1.0 , 0.)
			set s__BossPatternIndicator_inner[this]=sc__Effect_create("Effects\\RLine.mdl" , x , y , 4.0 , 0.)
		endif
		call sc__Effect_setColor(s__BossPatternIndicator_outter[this],192 , 192 , 192)
		call sc__Effect_setAlpha(s__BossPatternIndicator_outter[this],R2I(0.75 * 255))
		call sc__Effect_setColor(s__BossPatternIndicator_inner[this],255 , 16 , 16)
		call sc__Effect_setAlpha(s__BossPatternIndicator_inner[this],R2I(0.25 * 255))
		set s__BossPatternIndicator_radius[this]=radius
		set s__BossPatternIndicator_main_timer[this]=sc__Timer_new(this)
		call TimerStart((s__BossPatternIndicator_main_timer[this] ), (( TIMER_TICK )*1.0), ( true ), ( function s__BossPatternIndicator_timerCallback)) // INLINED!!
		call s__BossPatternIndicator_setProgress(this,0.)
		return this
 endfunction

 function s__BossPatternIndicator_onDestroy takes integer this returns nothing
		call sc__Timer_release(s__BossPatternIndicator_main_timer[this])
		set s__BossPatternIndicator_main_timer[this]=null
		call sc__Object_prototype_deallocate(s__BossPatternIndicator_outter[this])
		call sc__Object_prototype_deallocate(s__BossPatternIndicator_inner[this])
 endfunction



