				elseif v < CONFIG_MIN_Y then
					set v=CONFIG_MIN_Y
				endif
				call SetUnitY(s__Item_prototype__get_origin_item(this), v)
				call BlzSetSpecialEffectPosition(s__Item_prototype_origin_effect[this], s__Item_prototype__get_x(this), s__Item_prototype__get_y(this), s__Item_prototype__get_z(this))
			endif
  endfunction

  function s__Item_prototype__set_z takes integer this,real v returns nothing
			if s__Item_prototype__get_origin_item(this) != null then
				if v < 0. then
					set v=0.
				endif
				call SetUnitFlyHeight(s__Item_prototype__get_origin_item(this), v, 0.)
				call BlzSetSpecialEffectPosition(s__Item_prototype_origin_effect[this], s__Item_prototype__get_x(this), s__Item_prototype__get_y(this), s__Item_prototype__get_z(this))
			endif
  endfunction

