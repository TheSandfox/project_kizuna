  function s__Ability3010_explosion_beforeExplosion takes integer this returns nothing
   local integer e= s__Effect_create(Ability3010__EFFECT_PATH3 , s__Explosion_x[this] , s__Explosion_y[this] , GetRandomReal(2, 55) , 270)
			call s__Effect_setDuration(e,1.25)
			call s__Effect_setScale(e,GetRandomReal(1.5, 3))
  endfunction

  function s__Ability3010_explosion_executeExplosion takes integer this,integer target returns nothing
   local integer e= s__Effect_create(Ability3010__EFFECT_PATH2 , sc__Object__get_x(target) , sc__Object__get_y(target) , sc__Object__get_z(target) + s__Object_pivot_z[target] , 270)
   local integer bf= 0
			call s__Effect_setDuration(e,1.5)
			if IsUnitInGroup(s__Unit_prototype_origin_unit[target], s__Explosion_group_wave[this]) then
				set s__Explosion_onhit_type[this]=s__Damage_ONHIT_TYPE_NONHIT
			else
				set s__Explosion_onhit_type[this]=s__Damage_ONHIT_TYPE_ONHIT
			endif
			set bf=s__Buff_add(s__Explosion_owner[this] , target , Ability3010__ID , s__Ability3010_explosion_level[this] , Ability3010__DURATION)
			call sc__Buff_addValue(bf,s__Ability3010_explosion_level[this])
			call s__Explosion_damageTarget(this,target)
  endfunction

  function s__Ability3010_explosion_create takes integer caster,real x,real y,real rad,integer level returns integer
   local integer this= s__Ability3010_explosion__allocate(caster , x , y , rad)
			set s__Ability3010_explosion_level[this]=level
			set s__Explosion_interval[this]=Ability3010__INTERVAL
			call s__Explosion_setDamageFlagById(this,Ability3010__ID)
			set s__Explosion_count[this]=Ability3010__COUNT
			set s__Ability3010_explosion_c[this]=s__Circle_create(s__Explosion_x[this] , s__Explosion_y[this] , 2. , Ability3010__RADIUS3)
			call s__Effect_setColor(s__Ability3010_explosion_c[this],255 , R2I(255 * 0.9) , 0)
			call s__Effect_setAlpha(s__Ability3010_explosion_c[this],0)
			call s__Circle_fadeIn(s__Ability3010_explosion_c[this],0.45)
			set s__Ability3010_explosion_ef[this]=s__Effect_create(Ability3010__EFFECT_PATH1 , s__Explosion_x[this] , s__Explosion_y[this] , 2. , 270)
			call s__Effect_setScale(s__Ability3010_explosion_ef[this],2.5)
			return this
  endfunction

  function s__Ability3010_explosion_onDestroy takes integer this returns nothing
			call s__Circle_setFadeOutPoint(s__Ability3010_explosion_c[this],0.01 , 0.75)
			set s__Ability3010_explosion_c[this]=0
			call s__Effect_kill(s__Ability3010_explosion_ef[this])
  endfunction



  function s__Ability3010_actor_onComplete takes integer this returns nothing
   local integer ex= s__Ability3010_explosion_create((s__Actor_actor[(this)]) , sc__Actor__get_x(this) , sc__Actor__get_y(this) , Ability3010__RADIUS3 , s__UnitActor_level[this]) // INLINED!!
			set s__Explosion_damage[ex]=( s__Unit_prototype_getCarculatedStatValue((s__Actor_actor[(this)]),Ability3010__DAMAGE_STAT1) * Ability3010__DAMAGE_AMPLIFIER1 ) * ( 1 + Ability3010__DAMAGE_PER_LEVEL * ( s__UnitActor_level[this] ) ) // INLINED!!
			call s__Explosion_activate(ex)
  endfunction

