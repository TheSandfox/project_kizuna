   function s__Ability3030_additional_create takes integer caster,integer target,real x,real y,integer level returns integer
    local real a= s__Math_anglePoints(x , y , sc__Object__get_x(target) , sc__Object__get_y(target))
    local real a2= s__Math_anglePoints(sc__Object__get_x(caster) , sc__Object__get_y(caster) , sc__Object__get_x(target) , sc__Object__get_y(target))
    local integer this= s__Ability3030_additional__allocate(caster , Ability3030__EFFECT_PATH1 , x , y , 55 , a)
    local real dist= s__Math_distancePoints(sc__Object__get_x(caster) , sc__Object__get_y(caster) , x , y)
    local real val= 0.
				if dist > Ability3030__DATA_REAL1 then
					set dist=Ability3030__DATA_REAL1
				endif
				call s__Missile_setDamageFlagById(this,Ability3030__ID)
				call s__Missile__set_velo(this,Ability3030__VELO)
				call s__Missile__set_target((this),(target)) // INLINED!!
				set val=( Ability3030__DAMAGE_SECONDARY - Ability3030__DAMAGE_PRIMARY ) * ( dist / Ability3030__DATA_REAL1 ) + Ability3030__DAMAGE_PRIMARY
				set s__Missile_damage[this]=( s__Unit_prototype_getCarculatedStatValue(s__Missile_owner[this],Ability3030__DAMAGE_STAT1) * Ability3030__DAMAGE_AMPLIFIER1 ) * ( 1 + Ability3030__DAMAGE_PER_LEVEL * ( level ) ) * val
				set s__Ability3030_additional_l[this]=s__Lightning_create("CLSB" , sc__Object__get_x(s__Missile_owner[this]) , sc__Object__get_y(s__Missile_owner[this]) , 55. , 0 , 0 , 0)
				call s__Lightning_setTarget2(s__Ability3030_additional_l[this],this)
				call s__Lightning_refreshPosition(s__Ability3030_additional_l[this])
				set s__Missile_weapon_type[this]=WEAPON_TYPE_METAL_MEDIUM_BASH
