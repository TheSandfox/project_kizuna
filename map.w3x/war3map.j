  function s__Mover_timerAction takes nothing returns nothing
   local integer this= sc__Timer_getData(GetExpiredTimer())
   local real nx= 0.
   local real ny= 0.
			call SetUnitMoveSpeed(s__Mover_dummy[this], sc__Unit_prototype__get_movement_speed(s__Mover_owner[this]) * s__Mover_velo[this])
			if sc__Unit_prototype_isMoveable(s__Mover_owner[this]) then
				if s__Mover_refresh_facing[this] then
					call SetUnitFacing(s__Unit_prototype_origin_unit[s__Mover_owner[this]], GetUnitFacing(s__Mover_dummy[this]))
				endif
				set nx=GetUnitX(s__Mover_dummy[this])
				set ny=GetUnitY(s__Mover_dummy[this])
				call SetUnitX(s__Unit_prototype_origin_unit[s__Mover_owner[this]], nx)
				call SetUnitY(s__Unit_prototype_origin_unit[s__Mover_owner[this]], ny)
				call SetUnitX(s__Mover_dummy[this], nx)
				call SetUnitY(s__Mover_dummy[this], ny)
			else
				call SetUnitX(s__Mover_dummy[this], sc__Object__get_x(s__Mover_owner[this]))
				call SetUnitY(s__Mover_dummy[this], sc__Object__get_y(s__Mover_owner[this]))
			endif
  endfunction

  function s__Mover_triggerAction takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if (udg_EVENT_VALUE) == CONFIG_EVENT_CLICK then // INLINED!!
				if CUSTOM_RESPOND_CLICK_BUTTON_TYPE == MOUSE_BUTTON_TYPE_RIGHT and CUSTOM_RESPOND_CLICK_ENABLE and CUSTOM_RESPOND_CLICK_PLAYER == (GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Mover_owner[this])])) then // INLINED!!
					if CUSTOM_RESPOND_CLICK_CASTER == s__Mover_owner[this] then
						call IssuePointOrder(s__Mover_dummy[(this)], "move", ((CUSTOM_RESPOND_CLICK_X )*1.0), (( CUSTOM_RESPOND_CLICK_Y)*1.0)) // INLINED!!
					endif
				endif
				return
			endif
			if (udg_EVENT_VALUE) == CONFIG_EVENT_KEYPRESS then // INLINED!!
				if not CUSTOM_RESPOND_KEYPRESS_PRESS then
					return
				endif
				if CUSTOM_RESPOND_KEYPRESS_KEY == OSKEY_S or CUSTOM_RESPOND_KEYPRESS_KEY == OSKEY_H then
					call IssueImmediateOrder(s__Mover_dummy[(this)], "stop") // INLINED!!
				endif
				return
			endif
  endfunction

  function s__Mover_create takes integer owner returns integer
   local integer this= 0
			if s__Mover__moverflag_instance[(owner)] > 0 then
				call sc__Mover_deallocate((s__Mover__moverflag_instance[(owner)]))
			endif
			set this=s__Mover__allocate()
			set s__Mover_owner[this]=owner
			set s__Mover_dummy[this]=s__Unit_prototype_mover_unit[s__Mover_owner[this]]
			set s__Mover_main_timer[this]=sc__Timer_new(this)
			set s__Mover_main_trigger[this]=sc__Trigger_new(this)
			set s__Mover_main_cond[this]=TriggerAddCondition(s__Mover_main_trigger[this], Condition(function s__Mover_triggerAction))
			call TriggerRegisterVariableEvent((s__Mover_main_trigger[this] ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_CLICK)*1.0)) // INLINED!!
			call TriggerRegisterVariableEvent((s__Mover_main_trigger[this] ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_KEYPRESS)*1.0)) // INLINED!!
			call TimerStart((s__Mover_main_timer[this] ), (( TIMER_TICK )*1.0), ( true ), ( function s__Mover_timerAction)) // INLINED!!
			call BlzPauseUnitEx(s__Unit_prototype_origin_unit[s__Mover_owner[this]], true)
			call SetUnitMoveSpeed(s__Mover_dummy[this], sc__Unit_prototype__get_movement_speed(s__Mover_owner[this]) * s__Mover_velo[this])
			
			set s__Mover__moverflag_instance[(owner)]=this
			
			call sc__Unit_prototype_plusStatus(s__Mover_owner[this],CONFIG_STATUS_GHOST)
			call SetUnitX(s__Mover_dummy[this], sc__Object__get_x(s__Mover_owner[this]))
			call SetUnitY(s__Mover_dummy[this], sc__Object__get_y(s__Mover_owner[this]))
			if s__Unit_prototype_mover_moving[s__Mover_owner[this]] then
				
				call IssuePointOrder(s__Mover_dummy[this], "move", s__Unit_prototype_mover_target_x[s__Mover_owner[this]], s__Unit_prototype_mover_target_y[s__Mover_owner[this]])
			endif
			return this
  endfunction

  function s__Mover_onDestroy takes integer this returns nothing
			call s__LocationEx_collisionProjection(sc__Object__get_x(s__Mover_owner[this]) , sc__Object__get_y(s__Mover_owner[this]))
			call SetUnitX(s__Unit_prototype_origin_unit[s__Mover_owner[this]], (GetLocationX(LocationEx___LOC))) // INLINED!!
			call SetUnitY(s__Unit_prototype_origin_unit[s__Mover_owner[this]], (GetLocationY(LocationEx___LOC))) // INLINED!!
			call BlzPauseUnitEx(s__Unit_prototype_origin_unit[s__Mover_owner[this]], false)
			call sc__Timer_release(s__Mover_main_timer[this])
			call TriggerRemoveCondition(s__Mover_main_trigger[this], s__Mover_main_cond[this])
			call sc__Trigger_remove(s__Mover_main_trigger[this])
			set s__Mover_main_trigger[this]=null
			set s__Mover_main_cond[this]=null
			set s__Mover_main_timer[this]=null
			call SetUnitMoveSpeed(s__Mover_dummy[this], 10.)
			//call ShowUnit(.dummy,false)
			
			set s__Mover__moverflag_instance[(s__Mover_owner[this])]=0
			
			call sc__Unit_prototype_minusStatus(s__Mover_owner[this],CONFIG_STATUS_GHOST)
			call SetUnitX(s__Mover_dummy[this], sc__Object__get_x(s__Mover_owner[this]))
			call SetUnitY(s__Mover_dummy[this], sc__Object__get_y(s__Mover_owner[this]))
			set s__Mover_dummy[this]=null
  endfunction

