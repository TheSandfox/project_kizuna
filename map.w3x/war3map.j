			endloop
			return sum
  endfunction

  function s__ArrayList_pull takes integer this,integer index returns nothing
   local integer i= index
   local integer val= 0
			if index < 0 or index >= s__ArrayList_size[this] then
				
				return
			endif
			set val=s__ArrayList_get(this,index)
			loop
				exitwhen i >= s__ArrayList_size[this] - 1
				call s__ArrayList_setData(this,i , s__ArrayList_get(this,i + 1))
				set i=i + 1
			endloop
			call RemoveSavedInteger(ArrayList___HASH, this, s__ArrayList_size[this] - 1)
			set s__ArrayList_size[this]=s__ArrayList_size[this] - 1
			set s__ArrayList_CURRENT_INDEX=index
			call s__ArrayList_onRemove(this,val)
  endfunction

  function s__ArrayList_pop takes integer this,integer findfor returns nothing
