  function s__Unit_prototype_syncHide takes integer this,boolean b returns nothing
			if b then
				
				
				call ShowUnit(s__Unit_prototype_origin_unit[this], false)
				call sc__Unit_prototype_displayFacingCircle(this,false)
			else
				
				
				call ShowUnit(s__Unit_prototype_origin_unit[this], true)
				call sc__Unit_prototype_displayFacingCircle(this,true)
				if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_LOCUST) > 0 then
					
					call UnitRemoveAbility(s__Unit_prototype_origin_unit[this], 'Aloc')
					call UnitAddAbility(s__Unit_prototype_origin_unit[this], 'Aloc')
				else
					call sc__User_reselectUnit((GetOwningPlayer(s__Unit_prototype_origin_unit[(this)])) , this) // INLINED!!
				endif
			endif
  endfunction

  function s__Unit_prototype_syncAloc takes integer this,boolean b returns nothing
			if b then
				
				call UnitAddAbility(s__Unit_prototype_origin_unit[this], 'Aloc')
			else
				
				if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_HIDE) <= 0 then
					
					call ShowUnit(s__Unit_prototype_origin_unit[this], false)
					call ShowUnit(s__Unit_prototype_origin_unit[this], true)
					call UnitRemoveAbility(s__Unit_prototype_origin_unit[this], 'Aloc')
					call sc__User_reselectUnit((GetOwningPlayer(s__Unit_prototype_origin_unit[(this)])) , this) // INLINED!!
				else
					call UnitRemoveAbility(s__Unit_prototype_origin_unit[this], 'Aloc')
				endif
			endif
  endfunction

  function s__Unit_prototype_dummyCallback takes nothing returns nothing
   local integer this= sc__Timer_getData(GetExpiredTimer())
			call SetUnitPosition(s__Unit_prototype_dummy_unit[this], sc__Object__get_x(this), sc__Object__get_y(this))
			call BlzSetUnitFacingEx(s__Unit_prototype_dummy_unit[this], sc__Object__get_yaw(this))
			call SetUnitFlyHeight(s__Unit_prototype_dummy_unit[this], sc__Object__get_z(this) + sc__Object__get_offset_z(this), 0.)
  endfunction

  function s__Unit_prototype_syncDummy takes integer this,boolean b returns nothing
			if b then
				
				if s__Unit_prototype_dummy_unit[this] == null then
					
					set s__Unit_prototype_dummy_unit[this]=CreateUnit((GetOwningPlayer(s__Unit_prototype_origin_unit[(this)])), 'dumm', sc__Object__get_x(this), sc__Object__get_y(this), sc__Object__get_yaw(this)) // INLINED!!
					call UnitAddAbility(s__Unit_prototype_dummy_unit[this], 'Aeth')
					call UnitAddAbility(s__Unit_prototype_dummy_unit[this], 'Aloc')
					call UnitAddAbility(s__Unit_prototype_dummy_unit[this], 'Arav')
					call UnitRemoveAbility(s__Unit_prototype_dummy_unit[this], 'Arav')
					call SetUnitPathing(s__Unit_prototype_dummy_unit[this], false)
					
					set s__Unit_prototype_dummy_timer[this]=sc__Timer_new(this)
				else
					
					call ShowUnit(s__Unit_prototype_dummy_unit[this], true)
					
					call UnitRemoveAbility(s__Unit_prototype_dummy_unit[this], 'Aloc')
					call UnitAddAbility(s__Unit_prototype_dummy_unit[this], 'Aloc')
				endif
				
				call SetUnitPosition(s__Unit_prototype_dummy_unit[this], sc__Object__get_x(this), sc__Object__get_y(this))
				call BlzSetUnitFacingEx(s__Unit_prototype_dummy_unit[this], sc__Object__get_yaw(this))
				call SetUnitFlyHeight(s__Unit_prototype_dummy_unit[this], sc__Object__get_z(this) + sc__Object__get_offset_z(this), 0.)
				
				call BlzSetUnitSkin(s__Unit_prototype_dummy_unit[this], BlzGetUnitSkin(s__Unit_prototype_origin_unit[this]))
				
				call TimerStart((s__Unit_prototype_dummy_timer[this] ), (( TIMER_TICK )*1.0), ( true ), ( function s__Unit_prototype_dummyCallback)) // INLINED!!
			else
				
				if s__Unit_prototype_dummy_unit[this] != null then
					call ShowUnit(s__Unit_prototype_dummy_unit[this], false)
					
					call PauseTimer((s__Unit_prototype_dummy_timer[this])) // INLINED!!
				endif
			endif
  endfunction
		
		// method setStatus takes integer index, integer nv returns nothing
		// 	call SaveInteger(.HASH,this,INDEX_STATUS+index,nv)
		// endmethod
		
  function s__Unit_prototype_plusStatus takes integer this,integer index returns nothing
			call SaveInteger(Hash___D, (((s__Unit_prototype_status_data[this]))), ((index ) ), ( ( s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],index) + 1))) // INLINED!!
			if index == CONFIG_STATUS_DISABLED then
				call BlzPauseUnitEx(s__Unit_prototype_origin_unit[this], true)
				call s__Unit_prototype_releaseAbilityAll(this)
			elseif index == CONFIG_STATUS_STUN then
				call BlzPauseUnitEx(s__Unit_prototype_origin_unit[this], true)
			elseif index == CONFIG_STATUS_CAST then
				call BlzPauseUnitEx(s__Unit_prototype_origin_unit[this], true)
			elseif index == CONFIG_STATUS_CHARGE then
				call BlzPauseUnitEx(s__Unit_prototype_origin_unit[this], true)
			elseif index == CONFIG_STATUS_GRABBED then
				call BlzPauseUnitEx(s__Unit_prototype_origin_unit[this], true)
			elseif index == CONFIG_STATUS_RIDING then
				call BlzPauseUnitEx(s__Unit_prototype_origin_unit[this], true)
			elseif index == CONFIG_STATUS_INVINCIBLE then
				call s__Unit_prototype_plusAvul(this)
			elseif index == CONFIG_STATUS_DEAD then
				call BlzPauseUnitEx(s__Unit_prototype_origin_unit[this], true)
				if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],index) == 1 then
					set CUSTOM_RESPOND_DEATH_UNIT=this
					call s__Event_activate(CONFIG_EVENT_BEFORE_DEATH)
					call SetUnitState(s__Unit_prototype_origin_unit[this], UNIT_STATE_LIFE, 1.)
					call sc__Unit_prototype_displayFacingCircle(this,false)
					if s__Unit_prototype_is_revive[this] then
						call s__Unit_prototype_plusAvul(this)
						call s__Unit_prototype_plusAeth(this)
						call SetUnitVertexColor(s__Unit_prototype_origin_unit[this], 0, 0, 0, 255)
					else
						//call KillUnit(.origin_unit)
						call UnitAddAbility(s__Unit_prototype_origin_unit[this], 'Aloc')
						if s__Unit_prototype_decay_timer[this] == null then
							set s__Unit_prototype_decay_timer[this]=sc__Timer_new(this)
						endif
						call TimerStart((s__Unit_prototype_decay_timer[this] ), (( 10. )*1.0), ( false ), ( function s__Unit_prototype_decay)) // INLINED!!
					endif
					
					call s__Event_activate(CONFIG_EVENT_DEATH)
					set CUSTOM_RESPOND_DEATH_UNIT=0
					set CUSTOM_RESPOND_DEATH_KILLER=0
				endif
				call sc__Unit_prototype_resetAnim(this)
				call sc__Unit_prototype_setAnim(this,"death")
			elseif index == CONFIG_STATUS_ENSNARE then
				call s__Unit_prototype_refreshStatValue(this,CONFIG_STAT_MOVEMENT_SPEED)
			elseif index == CONFIG_STATUS_GHOST then
				call s__Unit_prototype_plusAeth(this)
			elseif index == CONFIG_STATUS_RIDING then
				call sc__Unit_prototype_displayFacingCircle(this,false)
			elseif index == CONFIG_STATUS_DISARM then
				if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],index) == 1 then
					call BlzUnitDisableAbility(s__Unit_prototype_origin_unit[this], 'Aatk', true, true)
				endif
			elseif index == CONFIG_STATUS_HIDE then
				if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],index) == 1 then
					call s__Unit_prototype_syncHide(this,true)
				endif
			elseif index == CONFIG_STATUS_LOCUST then
				if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],index) == 1 then
					call s__Unit_prototype_syncAloc(this,true)
				endif
			elseif index == CONFIG_STATUS_DUMMY then
				if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],index) == 1 then
					call s__Unit_prototype_syncDummy(this,true)
				endif
			endif
  endfunction
		
  function s__Unit_prototype_minusStatus takes integer this,integer index returns nothing
			if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],index) > 0 then
				call SaveInteger(Hash___D, (((s__Unit_prototype_status_data[this]))), ((index ) ), ( ( s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],index) - 1))) // INLINED!!
				if index == CONFIG_STATUS_DISABLED then
					call BlzPauseUnitEx(s__Unit_prototype_origin_unit[this], false)
				elseif index == CONFIG_STATUS_STUN then
					call BlzPauseUnitEx(s__Unit_prototype_origin_unit[this], false)
				elseif index == CONFIG_STATUS_CAST then
					call BlzPauseUnitEx(s__Unit_prototype_origin_unit[this], false)
				elseif index == CONFIG_STATUS_CHARGE then
					call BlzPauseUnitEx(s__Unit_prototype_origin_unit[this], false)
				elseif index == CONFIG_STATUS_GRABBED then
					call BlzPauseUnitEx(s__Unit_prototype_origin_unit[this], false)
