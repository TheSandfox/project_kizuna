    function s__AbilityIcon_refresh takes integer this returns nothing
        if s__AbilityIcon_target[this] > 0 and GetLocalPlayer() == s__AbilityIcon_owner[this] then
			
			call BlzFrameSetVisible(s__s__AbilityIcon_COOLDOWN_TEXT[s__AbilityIcon_index[this]], s__Ability_prototype_getUICooldown(s__AbilityIcon_target[this]) > 0.)
			call BlzFrameSetVisible(s__s__AbilityIcon_COOLDOWN_TEXT_BACKDROP[s__AbilityIcon_index[this]], s__Ability_prototype_getUICooldown(s__AbilityIcon_target[this]) > 0.)
			call BlzFrameSetVisible(s__s__AbilityIcon_COOLDOWN_BACKDROP[s__AbilityIcon_index[this]], s__Ability_prototype_getUICooldown(s__AbilityIcon_target[this]) > 0. and s__Ability_prototype_getCarculatedMaxCooldown(s__AbilityIcon_target[this]) > 0.)
			call BlzFrameSetText(s__s__AbilityIcon_COOLDOWN_TEXT[s__AbilityIcon_index[this]], R2SW(s__Ability_prototype_getUICooldown(s__AbilityIcon_target[this]), 1, 1))
			if sc__Ability_prototype_getCount(s__AbilityIcon_target[this]) == 0 then
				call BlzFrameSetAlpha(s__s__AbilityIcon_COOLDOWN_BACKDROP[s__AbilityIcon_index[this]], 128)
			else
				call BlzFrameSetAlpha(s__s__AbilityIcon_COOLDOWN_BACKDROP[s__AbilityIcon_index[this]], 32)
			endif
			if s__Ability_prototype_getCarculatedMaxCooldown(s__AbilityIcon_target[this]) > 0. then
				call BlzFrameSetPoint(s__s__AbilityIcon_COOLDOWN_BACKDROP[s__AbilityIcon_index[this]], FRAMEPOINT_TOPRIGHT, s__s__AbilityIcon_ICON_BACKDROP[s__AbilityIcon_index[this]], FRAMEPOINT_BOTTOMRIGHT, 0., (((UI___ABILITY_ICON_SIZE)*1.0) / 1800.) * ( s__Ability_prototype_getUICooldown(s__AbilityIcon_target[this]) / s__Ability_prototype_getCarculatedMaxCooldown(s__AbilityIcon_target[this]) )) // INLINED!!
			endif
			
			call BlzFrameSetVisible(s__s__AbilityIcon_DISABLED_BACKDROP[s__AbilityIcon_index[this]], not ( s__Ability_prototype_enableFilter(s__AbilityIcon_target[this]) and sc__Ability_prototype_useFilterAdditional(s__AbilityIcon_target[this]) ))
			
			call BlzFrameSetVisible(s__s__AbilityIcon_NEM_BACKDROP[s__AbilityIcon_index[this]], (s__Unit_prototype_mp_true[(s__Ability_prototype_owner[s__AbilityIcon_target[this]])]) < sc__Ability_prototype_getCarculatedManacost(s__AbilityIcon_target[this])) // INLINED!!
			
