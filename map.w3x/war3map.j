			call BlzFrameClearAllPoints(s__ItemTooltip_text[this])
			call BlzFrameSetPoint(s__ItemTooltip_text[this], FRAMEPOINT_BOTTOMRIGHT, pivot, pfpt, (((x)*1.0) / 1800.) - 0.005, (((y)*1.0) / 1800.) + 0.005) // INLINED!!
  endfunction

