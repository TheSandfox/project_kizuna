		call s__StatIcon_create(parent , CONFIG_STAT_DEFENSE , p)
		call s__StatIcon_create(parent , CONFIG_STAT_RESISTANCE , p)
		call s__StatIcon_create(parent , CONFIG_STAT_EVASION , p)
