  function s__ExtraAbilityIcon_create takes player p,integer target returns integer
   local integer this= 0
			if GetPlayerId(p) >= CONFIG_PLAYER_MAX then
				return 0
			endif
			set this=s__ExtraAbilityIcon__allocate()
			set s__ExtraAbilityIcon_pid[this]=GetPlayerId(p)
			set s__ExtraAbilityIcon_target[this]=target
			
			set s__ExtraAbilityIcon_container[this]=BlzCreateFrameByType("FRAME", "", FRAME_STAT1, "", this)
			set s__ExtraAbilityIcon_icon_backdrop[this]=BlzCreateFrameByType("BACKDROP", "", s__ExtraAbilityIcon_container[this], "", this)
			call BlzFrameSetTexture(s__ExtraAbilityIcon_icon_backdrop[this], s__Ability_getTypeIconPath(s__Ability_prototype_id[s__ExtraAbilityIcon_target[this]]), 0, true)
			call BlzFrameSetSize((s__ExtraAbilityIcon_icon_backdrop[this] ), (( ExtraAbilityIcon___SIZE )*1.0) / 1800., (( ExtraAbilityIcon___SIZE)*1.0) / 1800.) // INLINED!!
			set s__ExtraAbilityIcon_cooldown_backdrop[this]=BlzCreateFrameByType("BACKDROP", "", s__ExtraAbilityIcon_container[this], "", this)
			call BlzFrameSetAllPoints(s__ExtraAbilityIcon_cooldown_backdrop[this], s__ExtraAbilityIcon_icon_backdrop[this])
			call BlzFrameSetTexture(s__ExtraAbilityIcon_cooldown_backdrop[this], "Textures\\Black32.blp", 0, true)
			set s__ExtraAbilityIcon_cooldown_backdrop2[this]=BlzCreateFrameByType("BACKDROP", "", s__ExtraAbilityIcon_container[this], "", this)
			call BlzFrameSetAllPoints(s__ExtraAbilityIcon_cooldown_backdrop2[this], s__ExtraAbilityIcon_icon_backdrop[this])
			call BlzFrameSetTexture(s__ExtraAbilityIcon_cooldown_backdrop2[this], "Textures\\Black32.blp", 0, true)
			call BlzFrameSetAlpha(s__ExtraAbilityIcon_cooldown_backdrop2[this], 200)
			set s__ExtraAbilityIcon_nem_backdrop[this]=BlzCreateFrameByType("BACKDROP", "", s__ExtraAbilityIcon_container[this], "", this)
			call BlzFrameSetAllPoints(s__ExtraAbilityIcon_nem_backdrop[this], s__ExtraAbilityIcon_icon_backdrop[this])
			call BlzFrameSetTexture(s__ExtraAbilityIcon_nem_backdrop[this], "ReplaceableTextures\\teamcolor\\teamcolor14.blp", 0, true)
        	call BlzFrameSetAlpha(s__ExtraAbilityIcon_nem_backdrop[this], 168)
			call BlzFrameSetVisible(s__ExtraAbilityIcon_container[this], false)
			set s__ExtraAbilityIcon_icon_backdrop2[this]=BlzCreateFrameByType("BACKDROP", "", s__ExtraAbilityIcon_container[this], "", this)
			call BlzFrameSetTexture(s__ExtraAbilityIcon_icon_backdrop2[this], s__UnitData_getIconPath((GetUnitTypeId(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[s__ExtraAbilityIcon_target[this]])]))), 0, true) // INLINED!!
			call BlzFrameSetSize((s__ExtraAbilityIcon_icon_backdrop2[this] ), (( ExtraAbilityIcon___SIZE * 0.5 )*1.0) / 1800., (( ExtraAbilityIcon___SIZE * 0.5)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetPoint((s__ExtraAbilityIcon_icon_backdrop2[this] ), ( FRAMEPOINT_BOTTOMRIGHT ), ( s__ExtraAbilityIcon_icon_backdrop[this] ), ( FRAMEPOINT_BOTTOMRIGHT ), (( 0 )*1.0) / 1800., (( 0)*1.0) / 1800.) // INLINED!!
			
			call s__ArrayList_add(s__s__ExtraAbilityIcon_ICONS[s__ExtraAbilityIcon_pid[this]],this)
			
			set s__s__ExtraAbilityIcon_COUNTER[s__ExtraAbilityIcon_pid[this]]= s__s__ExtraAbilityIcon_COUNTER[s__ExtraAbilityIcon_pid[this]] + 1
			if s__s__ExtraAbilityIcon_COUNTER[s__ExtraAbilityIcon_pid[this]] == 1 then
				call TimerStart((s__s__ExtraAbilityIcon_TIMERS[s__ExtraAbilityIcon_pid[this]] ), (( 0.1 )*1.0), ( true ), ( function s__ExtraAbilityIcon_refreshIcons)) // INLINED!!
