 endfunction

 function s__Mouse_move takes nothing returns nothing
  local integer i= GetPlayerId(GetTriggerPlayer())
		set s__s__Mouse_X[i]= BlzGetTriggerPlayerMouseX()
		set s__s__Mouse_Y[i]= BlzGetTriggerPlayerMouseY()
 endfunction

 function s__Mouse_receiveClick takes nothing returns nothing
  local string source= ""
  local integer l= 0
		set udg_EVENT_VALUE=0.
		set source=BlzGetTriggerSyncData()
		set l=StringLength(source)
		set bj_forLoopAIndex=0
		
		loop
			exitwhen SubString(source, bj_forLoopAIndex, bj_forLoopAIndex + 1) == "!"
			set bj_forLoopAIndex=bj_forLoopAIndex + 1
		endloop
		set CUSTOM_RESPOND_CLICK_PLAYER=Player(S2I(SubString(source, 0, bj_forLoopAIndex)))
		set CUSTOM_RESPOND_CLICK_X=S2I(SubString(source, bj_forLoopAIndex + 1, l))
		loop
			exitwhen SubString(source, bj_forLoopAIndex, bj_forLoopAIndex + 1) == "@"
			set bj_forLoopAIndex=bj_forLoopAIndex + 1
		endloop
		set CUSTOM_RESPOND_CLICK_Y=S2I(SubString(source, bj_forLoopAIndex + 1, l))
		loop
			exitwhen SubString(source, bj_forLoopAIndex, bj_forLoopAIndex + 1) == "#"
			set bj_forLoopAIndex=bj_forLoopAIndex + 1
		endloop
		set CUSTOM_RESPOND_CLICK_TARGET=H2U(S2I(SubString(source, bj_forLoopAIndex + 1, l)))
		loop
			exitwhen SubString(source, bj_forLoopAIndex, bj_forLoopAIndex + 1) == "$"
			set bj_forLoopAIndex=bj_forLoopAIndex + 1
		endloop
		set CUSTOM_RESPOND_CLICK_CASTER=S2I(SubString(source, bj_forLoopAIndex + 1, l))

		if BlzGetTriggerSyncPrefix() == "GRM" then
			set CUSTOM_RESPOND_CLICK_BUTTON_TYPE=MOUSE_BUTTON_TYPE_RIGHT
		elseif BlzGetTriggerSyncPrefix() == "GLM" then
			set CUSTOM_RESPOND_CLICK_BUTTON_TYPE=MOUSE_BUTTON_TYPE_LEFT
		endif



		set CUSTOM_RESPOND_CLICK_ENABLE=true
		
		call s__Event_activate(CONFIG_EVENT_CLICK)
		set CUSTOM_RESPOND_CLICK_PLAYER=null
		set CUSTOM_RESPOND_CLICK_TARGET=null
		set CUSTOM_RESPOND_CLICK_ENABLE=false
		set CUSTOM_RESPOND_CLICK_BUTTON_TYPE=null
 endfunction

	
 function s__Mouse_clickRequest takes player p,integer caster,unit target,mousebuttontype mbt,real x,real y returns nothing
		if mbt == MOUSE_BUTTON_TYPE_RIGHT then
			call BlzSendSyncData("GRM", I2S(GetPlayerId(p)) + "!" + I2S(R2I(x)) + "@" + I2S(R2I(y)) + "#" + I2S(GetHandleId(target)) + "$" + I2S(caster))
		elseif mbt == MOUSE_BUTTON_TYPE_LEFT then
			call BlzSendSyncData("GLM", I2S(GetPlayerId(p)) + "!" + I2S(R2I(x)) + "@" + I2S(R2I(y)) + "#" + I2S(GetHandleId(target)) + "$" + I2S(caster))
		endif
 endfunction

 function s__Mouse_clickCallback takes nothing returns nothing
		if GetLocalPlayer() == GetTriggerPlayer() then
			call s__Mouse_clickRequest(GetTriggerPlayer() , (s__User_FOCUS_UNIT[GetPlayerId((GetTriggerPlayer()))]) , BlzGetMouseFocusUnit() , BlzGetTriggerPlayerMouseButton() , BlzGetTriggerPlayerMouseX() , BlzGetTriggerPlayerMouseY()) // INLINED!!
		endif
 endfunction

 function s__Mouse_activateRefresher takes player p returns nothing
  local integer i= GetPlayerId(p)
		set s__s__Mouse_MOVE[i]= null
		set s__s__Mouse_MOVE[i]= CreateTrigger()
		call TriggerRegisterPlayerEvent(s__s__Mouse_MOVE[i], p, EVENT_PLAYER_MOUSE_MOVE)
		call TriggerAddCondition(s__s__Mouse_MOVE[i], Condition(function s__Mouse_move))
		set s__s__Mouse_X[i]= 0.
		set s__s__Mouse_Y[i]= 0.
		
		call TriggerRegisterPlayerEvent(Mouse___TRIGGER, p, EVENT_PLAYER_MOUSE_DOWN)
		call BlzTriggerRegisterPlayerSyncEvent(Mouse___RECEIVE, p, "GRM", false)
		call BlzTriggerRegisterPlayerSyncEvent(Mouse___RECEIVE, p, "GLM", false)
 endfunction

 function s__Mouse_onInit takes nothing returns nothing
		call TriggerAddCondition(Mouse___TRIGGER, Condition(function s__Mouse_clickCallback))
		call TriggerAddCondition(Mouse___RECEIVE, Condition(function s__Mouse_receiveClick))
 endfunction


