   function s__Ability10o0_missile_create takes integer caster,integer target,integer level returns integer
    local real a= s__Math_anglePoints(sc__Object__get_x(caster) , sc__Object__get_y(caster) , sc__Object__get_x(target) , sc__Object__get_y(target))
