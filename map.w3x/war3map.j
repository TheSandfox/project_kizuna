		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( CONFIG_HOTKEY_ABILITY_6 )), ( false)) // INLINED!!
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( CONFIG_HOTKEY_ABILITY_7 )), ( false)) // INLINED!!
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( CONFIG_HOTKEY_ABILITY_8 )), ( false)) // INLINED!!
