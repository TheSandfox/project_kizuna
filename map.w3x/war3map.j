			call sc__ChainLightning_explosionFillUnits(this,g)
			loop
				set u=BlzGroupUnitAt(g, i)
				exitwhen u == null
				if not IsUnitType(u, UNIT_TYPE_DEAD) then
					if sc__Unit_prototype_get(u) > 0 then
						if s__ChainLightning_explosionFilter(this,sc__Unit_prototype_get(u)) then
							call sc__ChainLightning_executeExplosion(this,sc__Unit_prototype_get(u))
							call GroupAddUnit(s__ChainLightning_group_wave[this], u)
						endif
					endif
				endif
				set i=i + 1
			endloop
			call sc__Group_release(g)
			set g=null
			set u=null
  endfunction

//Implemented from module ChainGlave:

  function s__ChainLightning_explosionFilterAdditional takes integer this,integer target returns boolean
			// if IsUnitInGroup(target.origin_unit,.group_already) then
			// 	call BJDebugMsg(target.name+" : |cffff0000불합격|r")
			// else
			// 	call BJDebugMsg(target.name+" : |cff00ff00합격|r")
			// endif
			return not IsUnitInGroup(s__Unit_prototype_origin_unit[target], s__ChainLightning_group_already[this])
  endfunction

  function s__ChainLightning_executeExplosion takes integer this,integer target returns nothing
			call DoNothing()
  endfunction

  function s__ChainLightning_executeTarget takes integer this,integer target returns nothing
			call sc__ChainLightning_executeChain(this,target)
			
			set s__ChainLightning_count[this]=s__ChainLightning_count[this] - 1
			
			
			
			call GroupAddUnit(s__ChainLightning_group_already[this], s__Unit_prototype_origin_unit[s__UnitActor_target[this]])
			
			call GroupClear(s__ChainLightning_group_wave[this])
			call s__ChainLightning_explosionAction(this)
  endfunction

  function s__ChainLightning_findNextTarget takes integer this returns boolean
			
			set s__ChainLightning_target_previous[this]=s__UnitActor_target[this]
			set s__UnitActor_target[this]=sc__Unit_prototype_get(sc__Group_getNearest(s__ChainLightning_group_wave[this] , sc__Actor__get_x(this) , sc__Actor__get_y(this) , null))
			return s__UnitActor_target[this] != 0
  endfunction


		// stub method explosionFilterAdditional takes Unit_prototype target returns boolean
		// 	return not IsUnitInGroup(target.origin_unit,.group_already)
		// endmethod

		// method executeExplosion takes Unit_prototype target returns nothing
		// 	call DoNothing()
		// endmethod

		// stub method executeTarget takes Unit_prototype target returns nothing
		// 	/*데미지주기*/
		// 	
		// endmethod

  function s__ChainLightning_executeChain takes integer this,integer target returns nothing
			call s__ChainLightning_damageTarget(this,target)
  endfunction

  function s__ChainLightning_killFilter takes integer this returns boolean
			if s__ChainLightning_count[this] <= 0 then
				return true
			else
				if s__ChainLightning_findNextTarget(this) then
					set s__Actor_timeout[this]=0.
					set s__Actor_duration[this]=s__ChainLightning_interval[this]
					call sc__Actor__set_x(this,sc__Object__get_x(s__UnitActor_target[this]))
					call sc__Actor__set_y(this,sc__Object__get_y(s__UnitActor_target[this]))
					return false
				else
					return true
				endif
			endif
  endfunction

  function s__ChainLightning_onComplete takes integer this returns nothing
			
   local integer l= sc__Lightning_createOO(s__ChainLightning_lightning_id[this] , s__ChainLightning_target_previous[this] , s__UnitActor_target[this])
			set s__Lightning_oz1[l]=s__Object_pivot_z[s__ChainLightning_target_previous[this]]
			set s__Lightning_oz2[l]=s__Object_pivot_z[s__UnitActor_target[this]]
			set s__Lightning_duration[l]=0.45
			set s__Lightning_alpha[l]=1.5
			set s__Lightning_fade[l]=1.
			call sc__Lightning_refreshPosition(l)
			//OBJECT.j ChainGlave모듈 참고
			call s__ChainLightning_executeTarget(this,s__UnitActor_target[this])
  endfunction

  function s__ChainLightning_create takes integer caster,integer target,integer level,integer count,real interval,string lightning_id returns integer
   local integer this= s__ChainLightning__allocate(caster , target , sc__Object__get_x(target) , sc__Object__get_y(target) , level , 0.01 , false)
			set s__ChainLightning_lightning_id[this]=lightning_id
			set s__ChainLightning_target_previous[this]=(s__Actor_actor[(this)]) // INLINED!!
			set s__ChainLightning_group_wave[this]=sc__Group_new()
			set s__ChainLightning_group_already[this]=sc__Group_new()
			set s__ChainLightning_count[this]=count
			set s__ChainLightning_interval[this]=interval
			call sc__UnitActor_suspendFree(this)
			return this
  endfunction

  function s__ChainLightning_onDestroy takes integer this returns nothing
			call sc__Group_release(s__ChainLightning_group_wave[this])
			call sc__Group_release(s__ChainLightning_group_already[this])
			set s__ChainLightning_group_wave[this]=null
			set s__ChainLightning_group_already[this]=null
  endfunction



