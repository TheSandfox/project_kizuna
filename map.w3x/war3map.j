  function s__Unit_prototype_getItemById takes integer this,integer iid returns integer
   local integer i= 0
   local integer it= 0
			loop
				exitwhen i >= CONFIG_UNIT_INVENTORY_SIZE
				set it=s__UnitPrototype__ItemData_getItem(s__Unit_prototype_item_data[this],i)
				if it > 0 then
					if s__Item_prototype_id[it] == iid then
						return it
					endif
				endif
				set i=i + 1
			endloop
			return - 1
  endfunction
		
