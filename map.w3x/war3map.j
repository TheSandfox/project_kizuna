//===========================================================================
// Trigger: DeleteUnitRef
//===========================================================================
function Trig_DeleteUnitRef_Func001A takes nothing returns nothing
    call RemoveUnit(GetEnumUnit())
endfunction

function Trig_DeleteUnitRef_Actions takes nothing returns nothing
    call ForGroupBJ(GetUnitsInRectAll(gg_rct_UnitRef), function Trig_DeleteUnitRef_Func001A)
endfunction

//===========================================================================
function InitTrig_DeleteUnitRef takes nothing returns nothing
    set gg_trg_DeleteUnitRef=CreateTrigger()
    call TriggerAddAction(gg_trg_DeleteUnitRef, function Trig_DeleteUnitRef_Actions)
endfunction

//===========================================================================
function InitCustomTriggers takes nothing returns nothing
    call InitTrig_DeleteUnitRef()
endfunction

//===========================================================================
function RunInitializationTriggers takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_DeleteUnitRef)
endfunction

