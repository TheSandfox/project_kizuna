  function s__Buff20o0_main_getAdditionalDamage takes integer this returns real
			return s__Unit_prototype_getCarculatedStatValue(s__Buff_target[this],Buff20o0_DAMAGE_STAT1) * Buff20o0_DAMAGE_AMPLIFIER1 * ( 1 + Buff20o0_DAMAGE_PER_LEVEL * ( s__Buff_level[this] ) )
  endfunction

  function s__Buff20o0_main_reduceHP takes integer this,real val returns nothing
   local real th= s__Unit_prototype_getCarculatedStatValue(s__Buff_target[this],Buff20o0_DAMAGE_STAT1) * Buff20o0_DATA_REAL3
			if (s__Unit_prototype_hp_true[(s__Buff_target[this])]) <= th then // INLINED!!
				return
			endif
			if (s__Unit_prototype_hp_true[(s__Buff_target[this])]) - val <= th then // INLINED!!
				call s__Unit_prototype__set_hp(s__Buff_target[this],th)
			else
				call s__Unit_prototype__set_hp(s__Buff_target[this],(s__Unit_prototype_hp_true[(s__Buff_target[this])]) - val) // INLINED!!
			endif
  endfunction

  function s__Buff20o0_main_cond takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if (udg_EVENT_VALUE) == CONFIG_EVENT_DAMAGE_MODIFY then // INLINED!!
				if CUSTOM_RESPOND_DAMAGE_ATTACKER != s__Buff_target[this] then
					return
				endif
				if CUSTOM_RESPOND_DAMAGE_ATTACK_TYPE == s__Damage_ATTACK_TYPE_BASIC then
					set CUSTOM_RESPOND_DAMAGE_PLUS=CUSTOM_RESPOND_DAMAGE_PLUS + s__Buff20o0_main_getAdditionalDamage(this)
					call s__Buff20o0_main_reduceHP(this,s__Unit_prototype_getCarculatedStatValue(s__Buff_target[this],Buff20o0_DAMAGE_STAT1) * Buff20o0_DATA_REAL2)
				endif
			elseif (udg_EVENT_VALUE) == CONFIG_EVENT_WEAPON_CHANGE then // INLINED!!
				if CUSTOM_RESPOND_WEAPON_CHANGE_UNIT != s__Buff_target[this] then
					return
				endif
				if CUSTOM_RESPOND_WEAPON_CHANGE_OLD != CUSTOM_RESPOND_WEAPON_CHANGE_NEW then
					call sc__Buff_deallocate(this)
				endif
			endif
  endfunction

