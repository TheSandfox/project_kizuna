			set s__Missile_attack_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_ATTACK_TYPE))) // INLINED!!
			set s__Missile_interval_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_INTERVAL_TYPE))) // INLINED!!
			set s__Missile_vector_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_VECTOR_TYPE))) // INLINED!!
			set s__Missile_target_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_TARGET_TYPE))) // INLINED!!
			set s__Missile_aoe_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_AOE_TYPE))) // INLINED!!
			set s__Missile_onhit_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_ONHIT_TYPE))) // INLINED!!
			set s__Missile_range_type[this]=(LoadInteger(Damage__HASH, (id ), ( s__DamageFlag_INDEX_RANGE_TYPE))) // INLINED!!
  endfunction

  function s__Missile_DamageFlag_initialize takes integer this returns nothing
			set s__Missile_damage_id[this]=0
			set s__Missile_damage_type[this]=s__Damage_DAMAGE_TYPE_PHYSICAL
			set s__Missile_attack_type[this]=s__Damage_ATTACK_TYPE_BASIC
			set s__Missile_interval_type[this]=s__Damage_INTERVAL_TYPE_SINGLE
			set s__Missile_vector_type[this]=s__Damage_VECTOR_TYPE_OUTTER
			set s__Missile_target_type[this]=s__Damage_TARGET_TYPE_NONTARGET
			set s__Missile_aoe_type[this]=s__Damage_AOE_TYPE_NONAOE
			set s__Missile_onhit_type[this]=s__Damage_ONHIT_TYPE_NONHIT
			set s__Missile_range_type[this]=s__Damage_RANGE_TYPE_MELEE
			set s__Missile_use_damage_position[this]=false
			set s__Missile_damage_x[this]=0.
			set s__Missile_damage_y[this]=0.
			set s__Missile_weapon_type[this]=WEAPON_TYPE_WHOKNOWS
  endfunction



  function s__Missile_affectFilter takes integer this,integer target returns boolean
			if ( not s__Missile_affect_enemy[this] and (IsUnitEnemy(s__Unit_prototype_origin_unit[(target)], ((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Missile_owner[this])]))))) ) then // INLINED!!
				call BJDebugMsg((GetHeroProperName(s__Unit_prototype_origin_unit[(target)]))) // INLINED!!
				return false
			elseif ( not s__Missile_affect_ally[this] and (IsUnitAlly(s__Unit_prototype_origin_unit[(target)], ((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Missile_owner[this])]))))) ) then // INLINED!!
				return false
			elseif ( not s__Missile_affect_invincible[this] and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[target],ENUM_STATUS_INVINCIBLE) > 0 ) then
				return false
			elseif ( not s__Missile_affect_evasion[this] and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[target],ENUM_STATUS_EVASION) > 0 ) then
				return false
			elseif ( not s__Missile_affect_self[this] and target == s__Missile_owner[this] ) then
				return false
			elseif ( not s__Missile_affect_dead[this] and s__Unit_prototype_isUnitType(target,UNIT_TYPE_DEAD) ) then
				return false
			else
				return true
			endif
  endfunction

  function s__Missile_AffectFlag_initialize takes integer this returns nothing
			set s__Missile_affect_enemy[this]=true
			set s__Missile_affect_ally[this]=false
			set s__Missile_affect_invincible[this]=false
			set s__Missile_affect_evasion[this]=false
			set s__Missile_affect_self[this]=false
			set s__Missile_affect_dead[this]=false
  endfunction


		

  function s__Missile_rangeFilter takes integer this,integer target returns boolean
			return (IsUnitInRangeXY(s__Unit_prototype_origin_unit[(target)], ((sc__Object__get_x(this) )*1.0), (( sc__Object__get_y(this) )*1.0), (( (s__Missile_radius_explosion_true[(this)]))*1.0))) // INLINED!!
  endfunction


		

  function s__Missile_explosionFillUnits takes integer this,group g returns nothing
			call s__Group_fillUnitsInRange(g , sc__Object__get_x(this) , sc__Object__get_y(this) , (s__Missile_radius_explosion_true[(this)])) // INLINED!!
  endfunction

  function s__Missile_explosionFilter takes integer this,integer target returns boolean
			if not s__Missile_affectFilter(this,target) then
				return false
			elseif not sc__Missile_rangeFilter(this,target) then
				return false
			elseif not sc__Missile_explosionFilterAdditional(this,target) then
				return false
			else
				return true
			endif
  endfunction

  function s__Missile_explosionAction takes integer this returns nothing
   local integer i= 0
   local unit u= null
   local group g= s__Group_new()
			call sc__Missile_explosionFillUnits(this,g)
			loop
				set u=BlzGroupUnitAt(g, i)
				exitwhen u == null
				if not IsUnitType(u, UNIT_TYPE_DEAD) then
					if s__Unit_prototype_get(u) > 0 then
						if s__Missile_explosionFilter(this,s__Unit_prototype_get(u)) then
							call sc__Missile_executeExplosion(this,s__Unit_prototype_get(u))
							call GroupAddUnit(s__Missile_group_wave[this], u)
						endif
					endif
				endif
				set i=i + 1
			endloop
			call ReleaseGroup((g)) // INLINED!!
			set g=null
			set u=null
  endfunction

