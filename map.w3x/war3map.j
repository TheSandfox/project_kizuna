				call s__Event_activate(ENUM_EVENT_ABILITY_UI_REFRESH)
				set EVT_UI_REFRESH_ABILITY=0
   endfunction

//textmacro instance: abilityTooltip20h0()
function s__Ability20h0_main_relativeTooltip takes integer this,integer caster returns string
	return "선택한 아군 유닛과 결속하여(|cff00ffff탑승|r 상태로 간주) 매 초 대상의 |cff00ff00체력을 " + R2SW(0.027 * s__Unit_prototype_getCalculatedStatValue(caster,ENUM_STAT_MAXHP) * ( 1 + 0.07 * s__Ability_prototype_level[this] ), 2, 2) + "|r" + s__CustomString_shiftStatTooltip(ENUM_STAT_MAXHP) + ", |cff0099ff마나를 " + R2SW(0.022 * s__Unit_prototype_getCalculatedStatValue(caster,ENUM_STAT_MAXMP) * ( 1 + 0.07 * s__Ability_prototype_level[this] ), 2, 2) + "|r" + s__CustomString_shiftStatTooltip(ENUM_STAT_MAXMP) + " 회복시킵니다. 대상이 플레이어 소유일 경우 우클릭으로 조종할 수 있습니다."
endfunction
//end of: abilityTooltip20h0()

