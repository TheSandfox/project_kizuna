						set CUSTOM_RESPOND_REVIVE_UNIT=this
						call s__Event_activate(CONFIG_EVENT_REVIVE)
						set CUSTOM_RESPOND_REVIVE_UNIT=0
					endif
				elseif index == CONFIG_STATUS_ENSNARE then
					call s__Unit_prototype_refreshStatValue(this,CONFIG_STAT_MOVEMENT_SPEED)
				elseif index == CONFIG_STATUS_GHOST then
					call s__Unit_prototype_minusAeth(this)
				elseif index == CONFIG_STATUS_RIDING then
					call sc__Unit_prototype_displayFacingCircle(this,true)
				elseif index == CONFIG_STATUS_DISARM then
					if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],index) == 0 then
						call BlzUnitDisableAbility(s__Unit_prototype_origin_unit[this], 'Aatk', false, false)
					endif
				elseif index == CONFIG_STATUS_HIDE then
					if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],index) == 0 then
						call s__Unit_prototype_syncHide(this,false)
					endif
				elseif index == CONFIG_STATUS_LOCUST then
					if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],index) == 0 then
						call s__Unit_prototype_syncAloc(this,false)
					endif
				elseif index == CONFIG_STATUS_DUMMY then
					if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],index) == 0 then
						call s__Unit_prototype_syncDummy(this,false)
					endif
				endif
			endif
  endfunction
		
  function s__Unit_prototype_clearStatus takes integer this returns nothing
   local integer i= 0
			loop
				exitwhen i >= CONFIG_STATUS_SIZE
				if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],i) > 0 then
					call SaveInteger(Hash___D, (((s__Unit_prototype_status_data[this]))), ((i ) ), ( ( 1))) // INLINED!!
					call s__Unit_prototype_minusStatus(this,i)
				endif
				
				//call RemoveSavedInteger(.HASH,this,INDEX_STATUS+i)
				set i=i + 1
			endloop
  endfunction

  function s__Unit_prototype_kill takes integer this returns nothing
			if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_DEAD) <= 0 then
				call s__Unit_prototype_plusStatus(this,CONFIG_STATUS_DEAD)
			endif
  endfunction

  function s__Unit_prototype_unSummon takes integer this returns nothing
			call s__Unit_prototype_revive(this)
			set s__Unit_prototype_is_revive[this]=false
			call s__Unit_prototype_kill(this)
  endfunction

  function s__Unit_prototype_syncMoverImmediate takes nothing returns nothing
   local integer this= sc__Unit_prototype_get(GetTriggerUnit())
			if this > 0 then
				call SetUnitX(s__Unit_prototype_mover_unit[this], sc__Object__get_x(this))
				call SetUnitY(s__Unit_prototype_mover_unit[this], sc__Object__get_y(this))
				
				if GetIssuedOrderId() == OrderId("stop") then
					call DisableTrigger(GetTriggeringTrigger())
					call IssueImmediateOrder(s__Unit_prototype_origin_unit[this], CONFIG_ORDER_STRING_CUSTOM_STOP)
					call EnableTrigger(GetTriggeringTrigger())
				endif
				call DisableTrigger(GetTriggeringTrigger())
				call IssueImmediateOrder(s__Unit_prototype_mover_unit[this], "stop")
				call EnableTrigger(GetTriggeringTrigger())
				set s__Unit_prototype_mover_moving[this]=false
			endif
  endfunction

  function s__Unit_prototype_syncMoverPoint takes nothing returns nothing
   local integer this= sc__Unit_prototype_get(GetTriggerUnit())
			if this > 0 and ( GetIssuedOrderId() == OrderId("smart") or GetIssuedOrderId() == OrderId("attack") or GetIssuedOrderId() == OrderId("move") or GetIssuedOrderId() == OrderId(CONFIG_ORDER_STRING_CUSTOM_MOVE) ) then
				call SetUnitX(s__Unit_prototype_mover_unit[this], sc__Object__get_x(this))
				call SetUnitY(s__Unit_prototype_mover_unit[this], sc__Object__get_y(this))
				set s__Unit_prototype_mover_target_x[this]=GetOrderPointX()
				set s__Unit_prototype_mover_target_y[this]=GetOrderPointY()
				call DisableTrigger(GetTriggeringTrigger())
				call IssuePointOrder(s__Unit_prototype_mover_unit[this], "move", GetOrderPointX(), GetOrderPointY())
				call EnableTrigger(GetTriggeringTrigger())
				set s__Unit_prototype_mover_moving[this]=true
			endif
  endfunction

  function s__Unit_prototype_syncMoverTarget takes nothing returns nothing
   local integer this= sc__Unit_prototype_get(GetTriggerUnit())
			if this > 0 then
				call SetUnitX(s__Unit_prototype_mover_unit[this], sc__Object__get_x(this))
				call SetUnitY(s__Unit_prototype_mover_unit[this], sc__Object__get_y(this))
				call DisableTrigger(GetTriggeringTrigger())
				call IssueImmediateOrder(s__Unit_prototype_mover_unit[this], "stop")
				call EnableTrigger(GetTriggeringTrigger())
				//call IssueTargetOrder(.mover_unit,"smart",GetOrderTarget())
				set s__Unit_prototype_mover_moving[this]=false
			endif
  endfunction

  function s__Unit_prototype_basicAttack takes nothing returns nothing
   local integer attacker= 0
   local integer target= 0
			//local integer i = CONFIG_ABILITY_SIZE - 1
   local integer a= 0
			if BlzGetEventIsAttack() then
				call BlzSetEventDamage(0.)
				set attacker=sc__Unit_prototype_get(GetEventDamageSource())
				set target=sc__Unit_prototype_get(GetTriggerUnit())
				set CUSTOM_RESPOND_ATTACK_WEAPON=0
				if attacker > 0 and target > 0 then
					if s__Unit_prototype_weapon_ability[attacker] > 0 then
						set CUSTOM_RESPOND_ATTACK_WEAPON=s__Unit_prototype_weapon_ability[attacker]
						call sc__Ability_prototype_basicAttack(s__Unit_prototype_weapon_ability[attacker],target)
					else
						call s__MeleeAttack_create(attacker , target)
					endif
				endif
				set CUSTOM_RESPOND_ATTACK_ATTACKER=attacker
				set CUSTOM_RESPOND_ATTACK_TARGET=target
				call s__Event_activate(CONFIG_EVENT_ATTACK)
			endif
  endfunction

  function s__Unit_prototype_gravityAction takes integer this returns nothing
			if (sc__Movement_get((this))) == 0 then // INLINED!!
				if sc__Object__get_z(this) <= 0. and s__Unit_prototype_z_velo[this] <= 0. then
					call sc__Object__set_z(this,0.)
					set s__Unit_prototype_z_velo[this]=0.
				else
					call sc__Object__set_z(this,sc__Object__get_z(this) + s__Unit_prototype_z_velo[this] * TIMER_TICK)
					if s__Unit_prototype_use_gravity[this] > 0 then
						set s__Unit_prototype_z_velo[this]=s__Unit_prototype_z_velo[this] - s__Unit_prototype_gravity[this] * TIMER_TICK
					endif
				endif
			else
				set s__Unit_prototype_z_velo[this]=0.
			endif
  endfunction

  function s__Unit_prototype_timerAction takes nothing returns nothing
   local integer this= sc__Timer_getData(GetExpiredTimer())
			call sc__Effect_setPosition(s__Unit_prototype_facing_circle[this],sc__Object__get_x(this) , sc__Object__get_y(this) , 0.)
			call sc__Object__set_yaw(s__Unit_prototype_facing_circle[this],sc__Object__get_yaw(this))
			call s__Unit_prototype_gravityAction(this)
			call s__Unit_prototype_healUnit(this,this , s__Unit_prototype_getCarculatedStatValue(this,CONFIG_STAT_HPREGEN) * TIMER_TICK)
			call s__Unit_prototype_restoreMP(this,s__Unit_prototype_getCarculatedStatValue(this,CONFIG_STAT_MPREGEN) * TIMER_TICK)
  endfunction

  function s__Unit_prototype_addSkin takes integer this,integer skin returns nothing
			if skin <= 0 then
				return
			endif
			call sc__Array_join(s__Unit_prototype_skin_modifier[this],0 , skin)
			call BlzSetUnitSkin(s__Unit_prototype_origin_unit[this], sc__Array_getValue(s__Unit_prototype_skin_modifier[this],0))
			
			if s__Unit_prototype_dummy_unit[this] != null then
				call BlzSetUnitSkin(s__Unit_prototype_dummy_unit[this], BlzGetUnitSkin(s__Unit_prototype_origin_unit[this]))
			endif
			
			call sc__Unit_prototype_setScale(this,s__Unit_prototype_scale[this])
			if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_DEAD) > 0 then
				call sc__Unit_prototype_setAnim(this,"death")
				call SetUnitVertexColor(s__Unit_prototype_origin_unit[this], 0, 0, 0, 255)
			endif
  endfunction

  function s__Unit_prototype_removeSkin takes integer this,integer findfor returns nothing
			call sc__Array_removeFor(s__Unit_prototype_skin_modifier[this],findfor)
			if sc__Array__get_size(s__Unit_prototype_skin_modifier[this]) > 0 then
				call BlzSetUnitSkin(s__Unit_prototype_origin_unit[this], sc__Array_getValue(s__Unit_prototype_skin_modifier[this],0))
			else
				call BlzSetUnitSkin(s__Unit_prototype_origin_unit[this], (GetUnitTypeId(s__Unit_prototype_origin_unit[(this)]))) // INLINED!!
			endif
			
			if s__Unit_prototype_dummy_unit[this] != null then
				call BlzSetUnitSkin(s__Unit_prototype_dummy_unit[this], BlzGetUnitSkin(s__Unit_prototype_origin_unit[this]))
			endif
			call sc__Unit_prototype_setScale(this,s__Unit_prototype_scale[this])
			if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_DEAD) > 0 then
				call sc__Unit_prototype_setAnim(this,"death")
				call sc__Unit_prototype_setColor(this,0 , 0 , 0 , 255)
			endif
  endfunction

  function s__Unit_prototype_resetAnim takes integer this returns nothing
			call ResetUnitAnimation(s__Unit_prototype_origin_unit[this])
			
			if s__Unit_prototype_dummy_unit[this] != null then
				call ResetUnitAnimation(s__Unit_prototype_dummy_unit[this])
			endif
  endfunction

  function s__Unit_prototype_setAnim takes integer this,string anim returns nothing
			if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_DEAD) <= 0 or anim == "death" then
				call SetUnitAnimation(s__Unit_prototype_origin_unit[this], anim)
				
				if s__Unit_prototype_dummy_unit[this] != null then
					call SetUnitAnimation(s__Unit_prototype_dummy_unit[this], anim)
				endif
			endif
  endfunction

  function s__Unit_prototype_queueAnim takes integer this,string anim returns nothing
			if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_DEAD) <= 0 or anim == "death" then
				call QueueUnitAnimation(s__Unit_prototype_origin_unit[this], anim)
				
				if s__Unit_prototype_dummy_unit[this] != null then
					call QueueUnitAnimation(s__Unit_prototype_dummy_unit[this], anim)
				endif
			endif
  endfunction

  function s__Unit_prototype_setAnimSpeed takes integer this,real nv returns nothing
			call SetUnitTimeScale(s__Unit_prototype_origin_unit[this], nv)
			
			if s__Unit_prototype_dummy_unit[this] != null then
				call SetUnitTimeScale(s__Unit_prototype_dummy_unit[this], nv)
			endif
  endfunction

  function s__Unit_prototype_setColor takes integer this,integer r,integer g,integer b,integer a returns nothing
			call SetUnitVertexColor(s__Unit_prototype_origin_unit[this], r, g, b, a)
			
			if s__Unit_prototype_dummy_unit[this] != null then
				call SetUnitVertexColor(s__Unit_prototype_dummy_unit[this], r, g, b, a)
			endif
  endfunction

  function s__Unit_prototype_getScale takes integer this returns real
			return s__Unit_prototype_scale[this]
  endfunction

  function s__Unit_prototype_setScale takes integer this,real s returns nothing
			set s__Unit_prototype_scale[this]=s
			call SetUnitScale(s__Unit_prototype_origin_unit[this], s__Unit_prototype_scale[this] * s__Unit_prototype_origin_scale[this], s__Unit_prototype_scale[this] * s__Unit_prototype_origin_scale[this], s__Unit_prototype_scale[this] * s__Unit_prototype_origin_scale[this])
			
			if s__Unit_prototype_dummy_unit[this] != null then
				call SetUnitScale(s__Unit_prototype_dummy_unit[this], s__Unit_prototype_scale[this] * s__Unit_prototype_origin_scale[this], s__Unit_prototype_scale[this] * s__Unit_prototype_origin_scale[this], s__Unit_prototype_scale[this] * s__Unit_prototype_origin_scale[this])
			endif
			call BlzSetUnitRealField(s__Unit_prototype_origin_unit[this], UNIT_RF_SELECTION_SCALE, s * CONFIG_UNIT_SELECTION_CIRCLE_DEFAULT)
			call sc__Effect_setScale(s__Unit_prototype_facing_circle[this],s * BlzGetUnitCollisionSize(s__Unit_prototype_origin_unit[this]) / 66.)
  endfunction
		
  function s__Unit_prototype_getCarculatedScale takes integer this returns real
			return s__Unit_prototype_scale[this] * s__Unit_prototype_origin_scale[this]
  endfunction

  function s__Unit_prototype_setBarScale takes integer this,real v returns nothing
			call BlzSetUnitRealField(s__Unit_prototype_origin_unit[this], UNIT_RF_SELECTION_SCALE, v)
  endfunction

  function s__Unit_prototype_isMoveable takes integer this returns boolean
			return s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_STUN) <= 0 and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_ENSNARE) <= 0 and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_GRABBED) <= 0 and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_DISABLED) <= 0 and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_RIDING) <= 0
  endfunction

  function s__Unit_prototype_canCharge takes integer this returns boolean
			if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_RIDING) > 0 then
				
				return false
			endif
			if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_DISABLED) > 0 then
				
				return false
			elseif s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_UNSTOP) > 0 then
				
				return true
			endif
			
			return s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_ENSNARE) <= 0 and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_GRABBED) <= 0 and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_ROOT) <= 0
  endfunction

  function s__Unit_prototype_canPush takes integer this returns boolean
			
			return s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_UNSTOP) <= 0 and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_HIDE) <= 0 and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_HEAVY) <= 0
  endfunction

  function s__Unit_prototype_canGrab takes integer this returns boolean
			
			return s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_GRABBED) <= 0 and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_UNSTOP) <= 0 and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_HIDE) <= 0 and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_HEAVY) <= 0
  endfunction

  function s__Unit_prototype_canStun takes integer this returns boolean
			
			return s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_UNSTOP) <= 0
  endfunction

  function s__Unit_prototype_inRange takes integer this,real x,real y,real radius returns boolean
			return IsUnitInRangeXY(s__Unit_prototype_origin_unit[this], x, y, radius)
  endfunction

  function s__Unit_prototype_inLine takes integer this,real x1,real y1,real x2,real y2,real radius returns boolean
			return IsUnitInLine(s__Unit_prototype_origin_unit[this] , x1 , y1 , x2 , y2 , radius)
  endfunction

  function s__Unit_prototype_inSector takes integer this,real x,real y,real radius,real angle,real width returns boolean
			return IsUnitInSector(s__Unit_prototype_origin_unit[this] , x , y , radius , angle , width)
  endfunction

  function s__Unit_prototype_isVisible takes integer this,player p returns boolean
			return IsUnitVisible(s__Unit_prototype_origin_unit[this], p)
  endfunction

  function s__Unit_prototype_isEnemy takes integer this,player p returns boolean
			return IsUnitEnemy(s__Unit_prototype_origin_unit[this], p)
  endfunction

  function s__Unit_prototype_isAlly takes integer this,player p returns boolean
			return IsUnitAlly(s__Unit_prototype_origin_unit[this], p)
  endfunction

  function s__Unit_prototype_isUnitType takes integer this,unittype ut returns boolean
			if ut == UNIT_TYPE_DEAD then
				return s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_DEAD) > 0 or IsUnitType(s__Unit_prototype_origin_unit[this], UNIT_TYPE_DEAD)
			else
				return IsUnitType(s__Unit_prototype_origin_unit[this], ut)
			endif
  endfunction

  function s__Unit_prototype_refreshFacingCircleColor takes integer this,boolean show returns nothing
			if not show then
				call sc__Effect_setAlpha(s__Unit_prototype_facing_circle[this],0)
				return
			endif
			call sc__Effect_setAlpha(s__Unit_prototype_facing_circle[this],255)
			if GetLocalPlayer() == (GetOwningPlayer(s__Unit_prototype_origin_unit[(this)])) then // INLINED!!
				call sc__Effect_setColor(s__Unit_prototype_facing_circle[this],0 , 255 , 0)
			elseif (GetOwningPlayer(s__Unit_prototype_origin_unit[(this)])) == CONFIG_PLAYER_NPC then // INLINED!!
				call sc__Effect_setColor(s__Unit_prototype_facing_circle[this],255 , 255 , 0)
			elseif (IsUnitEnemy(s__Unit_prototype_origin_unit[(this)], (GetLocalPlayer()))) then // INLINED!!
				call sc__Effect_setColor(s__Unit_prototype_facing_circle[this],255 , 0 , 0)
			elseif (IsUnitAlly(s__Unit_prototype_origin_unit[(this)], (GetLocalPlayer()))) then // INLINED!!
				call sc__Effect_setColor(s__Unit_prototype_facing_circle[this],0 , 192 , 255)
			else
				call sc__Effect_setColor(s__Unit_prototype_facing_circle[this],255 , 255 , 0)
			endif
  endfunction

  function s__Unit_prototype_displayFacingCircle takes integer this,boolean flag returns nothing
			if flag then
				set s__Unit_prototype_display_facing_circle[this]=s__Unit_prototype_display_facing_circle[this] + 1
				if s__Unit_prototype_display_facing_circle[this] == 1 then
					call s__Unit_prototype_refreshFacingCircleColor(this,true)
				endif
			else
				set s__Unit_prototype_display_facing_circle[this]=s__Unit_prototype_display_facing_circle[this] - 1
				if s__Unit_prototype_display_facing_circle[this] == 0 then
					call s__Unit_prototype_refreshFacingCircleColor(this,false)
				endif
			endif
  endfunction

  function s__Unit_prototype_issueTargetOrder takes integer this,string order,widget t returns nothing
			call IssueTargetOrder(s__Unit_prototype_origin_unit[this], order, t)
  endfunction

  function s__Unit_prototype_issuePointOrder takes integer this,string order,real x,real y returns nothing
			call IssuePointOrder(s__Unit_prototype_origin_unit[this], order, x, y)
  endfunction

  function s__Unit_prototype_issueImmediateOrder takes integer this,string order returns nothing
			call IssueImmediateOrder(s__Unit_prototype_origin_unit[this], order)
  endfunction

  function s__Unit_prototype_get takes unit u returns integer
			if u == null then
				return 0
			endif
			return GetUnitUserData(u)
			
  endfunction

  function s__Unit_prototype_disableInteract takes integer this returns nothing
			call UnitRemoveAbility(s__Unit_prototype_origin_unit[this], CONFIG_ABILITY_ID_INTERACT)
  endfunction

  function s__Unit_prototype_essentialInit takes integer this returns nothing
			set s__Unit_prototype_origin_name[this]=(GetHeroProperName(s__Unit_prototype_origin_unit[(this)])) // INLINED!!
			set s__Unit_prototype_origin_scale[this]=BlzGetUnitRealField(s__Unit_prototype_origin_unit[this], UNIT_RF_SCALING_VALUE)
			call UnitAddAbility(s__Unit_prototype_origin_unit[this], 'Arav')
			call UnitRemoveAbility(s__Unit_prototype_origin_unit[this], 'Arav')
			if UnitAddAbility(s__Unit_prototype_origin_unit[this], CONFIG_ABILITY_ID_ATTACK_SPEED) then
				call SetUnitAbilityLevel(s__Unit_prototype_origin_unit[this], CONFIG_ABILITY_ID_ATTACK_SPEED, 20)
			endif
			if not UnitAddAbility(s__Unit_prototype_origin_unit[this], CONFIG_ABILITY_ID_FOLLOW) then
			endif
			if not UnitAddAbility(s__Unit_prototype_origin_unit[this], CONFIG_ABILITY_ID_MOVE) then
			endif
			if not UnitAddAbility(s__Unit_prototype_origin_unit[this], CONFIG_ABILITY_ID_INTERACT) then
			endif
			if not UnitAddAbility(s__Unit_prototype_origin_unit[this], CONFIG_ABILITY_ID_STOP) then
			endif
			call BlzUnitDisableAbility(s__Unit_prototype_origin_unit[this], 'Apat', true, true)
			call BlzSetUnitWeaponRealFieldBJ(s__Unit_prototype_origin_unit[this], UNIT_WEAPON_RF_ATTACK_DAMAGE_POINT, 0, 0.0)
    		call BlzSetUnitWeaponRealFieldBJ(s__Unit_prototype_origin_unit[this], UNIT_WEAPON_RF_ATTACK_BACKSWING_POINT, 0, 0.0)
			call BlzSetUnitWeaponIntegerFieldBJ(s__Unit_prototype_origin_unit[this], UNIT_WEAPON_IF_ATTACK_WEAPON_SOUND, 0, 0)
			call BlzSetUnitAttackCooldown(s__Unit_prototype_origin_unit[(this)], ((1.5)*1.0), 0) // INLINED!!
			call sc__Object__set_offset_z(this,GetUnitFlyHeight(s__Unit_prototype_origin_unit[this]))
  endfunction

  function s__Unit_prototype_create takes player p,integer uid,real x,real y,real facing returns integer
   local integer this= s__Unit_prototype__allocate()
			set s__Unit_prototype_origin_unit[this]=CreateUnit(p, uid, x, y, facing)
			set s__Object_pivot_z[this]=55.
			set s__Object_class[this]="Unit"
			set s__Object_type[this]=CONFIG_OBJECT_TYPE_UNIT
			set s__Unit_prototype_origin_player[this]=p
			
			set s__Unit_prototype_stat_data[this]=s__UnitPrototype__StatData_allocate()
			set s__Unit_prototype_status_data[this]=s__UnitPrototype__StatusData_allocate()
			set s__Unit_prototype_item_data[this]=s__UnitPrototype__ItemData_allocate(this)
			set s__Unit_prototype_ability_data[this]=s__UnitPrototype__AbilityData_allocate()
			
			call GroupAddUnit(UnitPrototype_GROUP, s__Unit_prototype_origin_unit[this])
			call s__Unit_prototype_essentialInit(this)
			call s__Unit_prototype_initStatValue(this)
			
			set s__Unit_prototype_mover_unit[this]=CreateUnit(p, 'dumm', x, y, facing)
			call UnitAddAbility(s__Unit_prototype_mover_unit[this], 'Aeth')
			call ShowUnit(s__Unit_prototype_mover_unit[this], false)
			call SetUnitMoveSpeed(s__Unit_prototype_mover_unit[this], 10.)
			
			set s__Unit_prototype_facing_circle[this]=sc__Effect_create("Effects\\FacingCircle.mdl" , x , y , 0. , facing)
			call s__Unit_prototype_refreshFacingCircleColor(this,true)
			set s__Effect_want_remove[s__Unit_prototype_facing_circle[this]]=true
			call sc__Effect_setScale(s__Unit_prototype_facing_circle[this],BlzGetUnitCollisionSize(s__Unit_prototype_origin_unit[this]) / 66.)
			
			call BlzSetUnitRealField(s__Unit_prototype_origin_unit[(this)], UNIT_RF_SELECTION_SCALE, ((1.5)*1.0)) // INLINED!!
			
			call sc__Shield_register((this))
			
			set s__Unit_prototype_skin_modifier[this]=sc__Array_create()
			
			call sc__Unit_prototype_register(this)
			return this
  endfunction

  function s__Unit_prototype_onDestroy takes integer this returns nothing
			set CUSTOM_RESPOND_DECAY_UNIT=this
			call s__Event_activate(CONFIG_EVENT_DECAY)
			set CUSTOM_RESPOND_DECAY_UNIT=0
			//if .is_revive then
				set CUSTOM_RESPOND_UNREGISTER_GROUP_UNIT=s__Unit_prototype_origin_unit[this]
				call s__Event_activate(CONFIG_EVENT_UNREGISTER_GROUP)
				set CUSTOM_RESPOND_UNREGISTER_GROUP_UNIT=null
			//endif
			
			call s__Unit_prototype_clearAbility(this)
			call s__Unit_prototype_clearItem(this)
			call s__Buff_unitDestroyBuffs(this)
			call s__Unit_prototype_clearStatus(this)
			call s__Hash_deallocate(((s__Unit_prototype_stat_data[this]))) // INLINED!!
			call s__Hash_deallocate(((s__Unit_prototype_status_data[this]))) // INLINED!!
			call s__Hash_deallocate(((s__Unit_prototype_item_data[this]))) // INLINED!!
			call s__Hash_deallocate(((s__Unit_prototype_ability_data[this]))) // INLINED!!
			
			call sc__Object_prototype_deallocate(s__Unit_prototype_facing_circle[this])
			if (s__Mover__moverflag_instance[((this))]) > 0 then // INLINED!!
				call s__Mover_deallocate((s__Mover__moverflag_instance[((this))])) // INLINED!!
			endif
			if s__Unit_prototype_main_timer[this] != null then
				call sc__Timer_release(s__Unit_prototype_main_timer[this])
			endif
			if s__Unit_prototype_decay_timer[this] != null then
				call sc__Timer_release(s__Unit_prototype_decay_timer[this])
			endif
			set s__Unit_prototype_main_timer[this]=null
			set s__Unit_prototype_decay_timer[this]=null
			set s__Unit_prototype_origin_player[this]=null
			
			call RemoveUnit(s__Unit_prototype_mover_unit[this])
			set s__Unit_prototype_mover_unit[this]=null
			
			if s__Unit_prototype_dummy_unit[this] != null then
				
				call RemoveUnit(s__Unit_prototype_dummy_unit[this])
				set s__Unit_prototype_dummy_unit[this]=null
				
				call sc__Timer_release(s__Unit_prototype_dummy_timer[this])
				set s__Unit_prototype_dummy_timer[this]=null
			endif
			
			call sc__Shield_unregister((this))
			
			call sc__Array_destroy(s__Unit_prototype_skin_modifier[this])
			
			call sc__Unit_prototype_unregister(this)
			call RemoveUnit(s__Unit_prototype_origin_unit[this])
			set s__Unit_prototype_origin_unit[this]=null
  endfunction

  function s__Unit_prototype_unregisterGroup takes nothing returns nothing
			if CUSTOM_RESPOND_UNREGISTER_GROUP_UNIT == null then
				return
			else
				call GroupRemoveUnit(UnitPrototype_GROUP, CUSTOM_RESPOND_UNREGISTER_GROUP_UNIT)
			endif
  endfunction

		// private static method initLabel takes nothing returns nothing
		// 	set INDEX_STAT 	 	= 0
		// 	set INDEX_ABILITY 	= INDEX_STAT + CONFIG_STAT_SIZE * CONFIG_STAT_INDEX_SIZE
		// 	set INDEX_ITEM		= INDEX_ABILITY + CONFIG_ABILITY_SIZE
		// 	set INDEX_STATUS	= INDEX_ITEM + CONFIG_UNIT_INVENTORY_SIZE
		// 	set INDEX_LAST		= INDEX_STATUS + CONFIG_STATUS_SIZE
		// endmethod

  function s__Unit_prototype_itemDestroyRespond takes nothing returns nothing
   local integer this= 0
			if CUSTOM_RESPOND_ITEM_DESTROY_ADDRESS1 != s__ItemAddress_UNIT then
				return
			endif
			set this=CUSTOM_RESPOND_ITEM_DESTROY_ADDRESS2
			call s__UnitPrototype__ItemData_setItem(s__Unit_prototype_item_data[this],CUSTOM_RESPOND_ITEM_DESTROY_INDEX , 0)
  endfunction

  function s__Unit_prototype_removeAbilityCallback takes nothing returns nothing
   local integer this= CUSTOM_RESPOND_REMOVE_ABILITY_UNIT
   local integer i= 0
			if this <= 0 or CUSTOM_RESPOND_REMOVE_ABILITY_INSTANCE <= 0 then
				return
			endif
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				if s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[this],i) == CUSTOM_RESPOND_REMOVE_ABILITY_INSTANCE then
					call SaveInteger(Hash___D, (((s__Unit_prototype_ability_data[this]))), ((i ) ), ( ( 0))) // INLINED!!
				endif
				set i=i + 1
			endloop
  endfunction

  function s__Unit_prototype_initTrigger takes nothing returns nothing
   local trigger t= null
			call TriggerRegisterAnyUnitEventBJ(s__Unit_prototype_TRIGGER_DAMAGE, EVENT_PLAYER_UNIT_DAMAGING)
			call TriggerAddCondition(s__Unit_prototype_TRIGGER_DAMAGE, Condition(function s__Unit_prototype_basicAttack))
			//
			call TriggerRegisterAnyUnitEventBJ(s__Unit_prototype_TRIGGER_ORDER_IMMEDIATE, EVENT_PLAYER_UNIT_ISSUED_ORDER)
			call TriggerAddCondition(s__Unit_prototype_TRIGGER_ORDER_IMMEDIATE, Condition(function s__Unit_prototype_syncMoverImmediate))
			//
			call TriggerRegisterAnyUnitEventBJ(s__Unit_prototype_TRIGGER_ORDER_POINT, EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER)
			call TriggerAddCondition(s__Unit_prototype_TRIGGER_ORDER_POINT, Condition(function s__Unit_prototype_syncMoverPoint))
			//
			call TriggerRegisterAnyUnitEventBJ(s__Unit_prototype_TRIGGER_ORDER_TARGET, EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER)
			call TriggerAddCondition(s__Unit_prototype_TRIGGER_ORDER_TARGET, Condition(function s__Unit_prototype_syncMoverTarget))
			//
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_UNREGISTER_GROUP)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Unit_prototype_unregisterGroup))
			//
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_ITEM_DESTROY)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Unit_prototype_itemDestroyRespond))
			//
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_REMOVE_ABILITY)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Unit_prototype_removeAbilityCallback))
			set t=null
  endfunction

  function s__Unit_prototype_register takes integer this returns nothing
			call SetUnitUserData(s__Unit_prototype_origin_unit[this], this)
			//call SaveInteger(.HASH,GetHandleId(.origin_unit),0,this)
			call sc__Array_add(s__Unit_prototype_UNIT_LIST,this)
  endfunction

  function s__Unit_prototype_unregister takes integer this returns nothing
			call SetUnitUserData(s__Unit_prototype_origin_unit[this], 0)
			//call RemoveSavedInteger(.HASH,GetHandleId(.origin_unit),0)
			call sc__Array_removeFor(s__Unit_prototype_UNIT_LIST,this)
  endfunction

  function s__Unit_prototype_genericTimerCallback takes nothing returns nothing
   local integer this= 0
   local integer i= 0
   local boolean regen= false
			set s__Unit_prototype_UNIT_GENERIC_TIMER_COUNTER=s__Unit_prototype_UNIT_GENERIC_TIMER_COUNTER + 1
			if s__Unit_prototype_UNIT_GENERIC_TIMER_COUNTER >= 5 then
				set s__Unit_prototype_UNIT_GENERIC_TIMER_COUNTER=s__Unit_prototype_UNIT_GENERIC_TIMER_COUNTER - 5
				set regen=true
			endif
			loop
				set this=sc__Array_getValue(s__Unit_prototype_UNIT_LIST,i)
				exitwhen this <= 0
				call sc__Effect_setPosition(s__Unit_prototype_facing_circle[this],sc__Object__get_x(this) , sc__Object__get_y(this) , 0.)
				call sc__Object__set_yaw(s__Unit_prototype_facing_circle[this],sc__Object__get_yaw(this))
				call s__Unit_prototype_gravityAction(this)
				if regen then
					call s__Unit_prototype_healUnit(this,this , s__Unit_prototype_getCarculatedStatValue(this,CONFIG_STAT_HPREGEN) * TIMER_TICK * 5)
					call s__Unit_prototype_restoreMP(this,s__Unit_prototype_getCarculatedStatValue(this,CONFIG_STAT_MPREGEN) * TIMER_TICK * 5)
				endif
				set i=i + 1
			endloop
  endfunction

  function s__Unit_prototype_onInit takes nothing returns nothing
   local integer i= 0
			set UnitPrototype_GROUP=sc__Group_new()
			loop
				exitwhen i >= CONFIG_STAT_SIZE
				set s__STAT_CLAMP[i]= false
				set s__STAT_NORMAL_VALUE[i]= 1.
				set i=i + 1
			endloop
			set s__STAT_CLAMP[CONFIG_STAT_MAXHP]= true
			set s__STAT_CLAMP[CONFIG_STAT_MAXMP]= true
			set s__STAT_CLAMP[CONFIG_STAT_ATTACK]= true
			set s__STAT_CLAMP[CONFIG_STAT_MAGICPOWER]= true
			set s__STAT_CLAMP[CONFIG_STAT_ACCURACY]= true
			set s__STAT_CLAMP[CONFIG_STAT_EVASION]= true
			set s__STAT_CLAMP[CONFIG_STAT_MOVEMENT_SPEED]= true
			set s__STAT_CLAMP[CONFIG_STAT_ATTACK_RANGE]= true
			set s__STAT_CLAMP[CONFIG_STAT_ARMOR_PENET]= true
			set s__STAT_CLAMP[CONFIG_STAT_MAGIC_PENET]= true
			set s__STAT_CLAMP[CONFIG_STAT_HPREGEN]= true
			
			set s__STAT_NORMAL_VALUE[CONFIG_STAT_MAXHP]= 20.
			set s__STAT_NORMAL_VALUE[CONFIG_STAT_MAXMP]= 10.
			set s__STAT_NORMAL_VALUE[CONFIG_STAT_ARMOR_PENET]= 0.5
			set s__STAT_NORMAL_VALUE[CONFIG_STAT_MAGIC_PENET]= 0.5
			set s__STAT_NORMAL_VALUE[CONFIG_STAT_HPREGEN]= 0.2
			set s__STAT_NORMAL_VALUE[CONFIG_STAT_MPREGEN]= 0.1
			
			// call initLabel()
			
			call s__Unit_prototype_initTrigger()
			
			set s__Unit_prototype_UNIT_GENERIC_TIMER=sc__Timer_new(0)
			set s__Unit_prototype_UNIT_LIST=sc__Array_create()
			call TimerStart((s__Unit_prototype_UNIT_GENERIC_TIMER ), (( TIMER_TICK )*1.0), ( true ), ( function s__Unit_prototype_genericTimerCallback)) // INLINED!!
  endfunction



