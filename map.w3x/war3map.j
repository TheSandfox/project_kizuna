		set s__StatIndicator_parent[this]=parent
		return this
 endfunction

 function s__StatIndicator_onInit takes nothing returns nothing
		set s__StatIndicator_KEYPRESS=CreateTrigger()
		call TriggerAddCondition(s__StatIndicator_KEYPRESS, Condition(function s__StatIndicator_keypress))
