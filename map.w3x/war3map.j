  function s__Unit_prototype_refreshStatValue takes integer this,integer stattype returns nothing
			
			if stattype == CONFIG_STAT_ATTACK_RANGE then
				call sc__Unit_prototype__set_attack_range(this,s__Unit_prototype_getCarculatedStatValue(this,stattype))
			elseif stattype == CONFIG_STAT_MAXHP then
				call sc__Unit_prototype__set_maxhp(this,s__Unit_prototype_getCarculatedStatValue(this,CONFIG_STAT_MAXHP))
			elseif stattype == CONFIG_STAT_MAXMP then
				call sc__Unit_prototype__set_maxmp(this,s__Unit_prototype_getCarculatedStatValue(this,CONFIG_STAT_MAXMP))
			elseif stattype == CONFIG_STAT_MOVEMENT_SPEED then
				if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_ENSNARE) > 0 then
					call sc__Unit_prototype__set_movement_speed(this,1.)
				else
					call sc__Unit_prototype__set_movement_speed(this,s__Unit_prototype_getCarculatedStatValue(this,CONFIG_STAT_MOVEMENT_SPEED))
				endif
			elseif stattype == CONFIG_STAT_ATTACK_SPEED then
				call s__Unit_prototype_refreshAttackSpeedRequest(this,s__Unit_prototype_getCarculatedStatValue(this,CONFIG_STAT_ATTACK_SPEED))
			endif
  endfunction

