    local real ny= (((sc__Object__get_y(caster) )*1.0) + (( Ability10o0__STARTAT )*1.0) * Sin((( a)*1.0) * bj_DEGTORAD)) // INLINED!!
    local integer this= s__Ability10o0_missile__allocate(caster , Ability10o0__EFFECT_PATH1 , nx , ny , sc__Object__get_z(caster) + s__Object_pivot_z[caster] - 40.0 , a)
