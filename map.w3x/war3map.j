  function s__Missile_carculateDamage takes integer this,real v returns nothing
			set CUSTOM_RESPOND_CARCULATE_DAMAGE_AMOUNT=v
			call s__Event_activate(CONFIG_EVENT_CARCULATE_DAMAGE)
			set s__Missile_damage[this]=( ( ( CUSTOM_RESPOND_CARCULATE_DAMAGE_AMOUNT + CUSTOM_RESPOND_CARCULATE_DAMAGE_PLUS ) * CUSTOM_RESPOND_CARCULATE_DAMAGE_MULTIPLY ) / CUSTOM_RESPOND_CARCULATE_DAMAGE_DIVIDE ) - CUSTOM_RESPOND_CARCULATE_DAMAGE_MINUS
			set CUSTOM_RESPOND_CARCULATE_DAMAGE_AMOUNT=0.
  endfunction

