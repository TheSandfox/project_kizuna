  function s__MeleeAttack_setDamagePoint takes integer this,real v returns nothing
			if v <= 0. then
				set s__Actor_duration[this]=0.001
			else
				set s__Actor_duration[this]=v / sc__Unit_prototype__get_attack_speed((s__Actor_actor[(this)])) // INLINED!!
				call sc__Unit_prototype_setAnimSpeed((s__Actor_actor[(this)]),1.0 * sc__Unit_prototype__get_attack_speed((s__Actor_actor[(this)])) * ( s__MeleeAttack_DAMAGE_POINT_DEFAULT / v )) // INLINED!!
			endif
  endfunction

  function s__MeleeAttack_onSuspend takes integer this returns nothing
			call sc__Unit_prototype_queueAnim((s__Actor_actor[(this)]),"stand ready") // INLINED!!
			call sc__Unit_prototype_setAnimSpeed((s__Actor_actor[(this)]),1.0) // INLINED!!
			call sc__Unit_prototype_recoverAttackDelay((s__Actor_actor[(this)]),true) // INLINED!!
  endfunction

  function s__MeleeAttack_onComplete takes integer this returns nothing
			if s__MeleeAttack_code_trigger[this] != null then
				
				set s__MeleeAttack_CODE_ACTOR=this
				call TriggerEvaluate(s__MeleeAttack_code_trigger[this])
			else
				
				call s__MeleeAttack_damageTarget(this,s__UnitActor_target[this])
				call s__Backswing_create((s__Actor_actor[(this)])) // INLINED!!
			endif
  endfunction

  function s__MeleeAttack_addCode takes integer this,code func returns nothing
			
			if s__MeleeAttack_code_trigger[this] == null then
				set s__MeleeAttack_code_trigger[this]=CreateTrigger()
				set s__MeleeAttack_code_condition[this]=TriggerAddCondition(s__MeleeAttack_code_trigger[this], Condition(func))
			endif
  endfunction
		
  function s__MeleeAttack_create takes integer caster,integer target returns integer
   local integer this= s__MeleeAttack__allocate(caster , target , 0 , 0 , 0 , s__MeleeAttack_DAMAGE_POINT_DEFAULT / sc__Unit_prototype__get_attack_speed(caster) , true)
			set s__UnitActor_suspend_rclick[this]=true
			set s__UnitActor_suspend_stop[this]=true
			set s__UnitActor_suspend_target_decay[this]=true
			call sc__Unit_prototype_setAnim((s__Actor_actor[(this)]),"stand") // INLINED!!
			call sc__Unit_prototype_setAnim((s__Actor_actor[(this)]),"attack") // INLINED!!
			call sc__Unit_prototype_setAnimSpeed((s__Actor_actor[(this)]),1.0 * sc__Unit_prototype__get_attack_speed((s__Actor_actor[(this)]))) // INLINED!!
			call IssueTargetOrder(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))], ("attack" ), ( s__Unit_prototype_origin_unit[s__UnitActor_target[this]])) // INLINED!!
			call sc__Unit_prototype_recoverAttackDelay((s__Actor_actor[(this)]),false) // INLINED!!
			
			set s__MeleeAttack_damage_id[this]='Aatk'
			set s__MeleeAttack_damage[this]=sc__Unit_prototype__get_attack((s__Actor_actor[(this)])) // INLINED!!
			set s__MeleeAttack_damage_type[this]=s__Damage_DAMAGE_TYPE_PHYSICAL
			set s__MeleeAttack_attack_type[this]=s__Damage_ATTACK_TYPE_BASIC
			set s__MeleeAttack_interval_type[this]=s__Damage_INTERVAL_TYPE_SINGLE
			set s__MeleeAttack_vector_type[this]=s__Damage_VECTOR_TYPE_OUTTER
			set s__MeleeAttack_target_type[this]=s__Damage_TARGET_TYPE_TARGET
			set s__MeleeAttack_onhit_type[this]=s__Damage_ONHIT_TYPE_ONHIT
			set s__MeleeAttack_range_type[this]=s__Damage_RANGE_TYPE_MELEE
			set s__MeleeAttack_weapon_type[this]=WEAPON_TYPE_METAL_MEDIUM_BASH
			return this
  endfunction

  function s__MeleeAttack_onDestroy takes integer this returns nothing
			call sc__Unit_prototype_queueAnim((s__Actor_actor[(this)]),"stand ready") // INLINED!!
			call sc__Unit_prototype_setAnimSpeed((s__Actor_actor[(this)]),1.0) // INLINED!!
			if s__MeleeAttack_code_trigger[this] != null then
				call TriggerRemoveCondition(s__MeleeAttack_code_trigger[this], s__MeleeAttack_code_condition[this])
				call DestroyTrigger(s__MeleeAttack_code_trigger[this])
				set s__MeleeAttack_code_trigger[this]=null
				set s__MeleeAttack_code_condition[this]=null
			endif
  endfunction



