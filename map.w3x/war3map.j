  function s__UnitClass_clearClass takes integer this returns nothing
   local integer i= 0
			loop
				exitwhen i >= CONFIG_UNIT_CLASS_SIZE
				call SaveInteger(s__UnitClass_HASH, this, i, 0)
				set i=i + 1
			endloop
  endfunction

  function s__UnitClass_getClass takes integer this,integer ctype returns integer
			if HaveSavedInteger(s__UnitClass_HASH, this, ctype) then
				return LoadInteger(s__UnitClass_HASH, this, ctype)
			else
				return 0
			endif
  endfunction

  function s__UnitClass_addClass takes integer this,integer ctype,integer val returns nothing
			call SaveInteger(s__UnitClass_HASH, this, ctype, s__UnitClass_getClass(this,ctype) + val)
  endfunction

  function s__UnitClass_plusClass takes integer this,integer ctype returns nothing
			call SaveInteger(s__UnitClass_HASH, this, ctype, s__UnitClass_getClass(this,ctype) + 1)
  endfunction

  function s__UnitClass_minusClass takes integer this,integer ctype returns nothing
			call SaveInteger(s__UnitClass_HASH, this, ctype, s__UnitClass_getClass(this,ctype) - 1)
  endfunction

  function s__UnitClass_isClass takes integer this,integer ctype returns boolean
			return s__UnitClass_getClass(this,ctype) > 0
  endfunction



