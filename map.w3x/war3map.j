  endfunction

  function s__Waygate_select_destination_create takes integer caster returns integer
   local integer this= s__Waygate_select_destination__allocate(caster , 0 , 0. , 0. , 0 , - 1 , true)
			//set .suspend_rclick = true
			set s__UnitActor_suspend_stop[this]=true
			call s__WarpWidget_show((GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))])) , true) // INLINED!!
			call s__WarpWidget_setCaster((GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))])) , (s__Actor_actor[(this)]) , this) // INLINED!!
			return this
  endfunction

  function s__Waygate_select_destination_onDestroy takes integer this returns nothing
			if not s__UnitActor_suspend_rclick[this] then
				call DisableTrigger(Waygate___REMOVE_ACTOR)
				call s__WarpWidget_show((GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))])) , false) // INLINED!!
				call EnableTrigger(Waygate___REMOVE_ACTOR)
				call s__WarpWidget_setCaster((GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))])) , 0 , 0) // INLINED!!
				call IssueImmediateOrder(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))], ("stop")) // INLINED!!
			endif
  endfunction

  function s__Waygate_select_destination_onInit takes nothing returns nothing
			set Waygate___REMOVE_ACTOR=CreateTrigger()
			call TriggerAddCondition(Waygate___REMOVE_ACTOR, Condition(function s__Waygate_select_destination_respond))
  endfunction



