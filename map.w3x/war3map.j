  function s__Inventory_rightClickRequest takes nothing returns nothing
   local integer this= (GetPlayerId(INVENTORY_CLICK_PLAYER))
			call s__Inventory_useRequest(this,s__Inventory_category[this] , INVENTORY_CLICK_INDEX , INVENTORY_CLICK_BUTTON)
  endfunction

		
  function s__Inventory_itemPick takes nothing returns nothing
   local integer picker= (CUSTOM_RESPOND_ITEM_PICK_UNIT)
   local integer this= GetPlayerId((GetOwningPlayer(s__Unit_prototype_origin_unit[(picker)]))) // INLINED!!
   local integer it= CUSTOM_RESPOND_ITEM_PICK_ITEM
			
			if it <= 0 or (s__User_FOCUS_UNIT[GetPlayerId(((GetOwningPlayer(s__Unit_prototype_origin_unit[(picker)]))))]) != picker then // INLINED!!
				set CUSTOM_RESPOND_ITEM_PICK_RESULT=false
				return
			endif
			
			call s__Inventory_addItem(this,it)
			set CUSTOM_RESPOND_ITEM_PICK_RESULT=true
  endfunction

  function s__Inventory_numberpadSummit takes nothing returns nothing
			if NUMBERPAD_REFINED_PREFIX == "INV_DIV" then
				set NUMBERPAD_SUMMIT_RESULT=s__Inventory_divide((GetPlayerId(NUMBERPAD_SUMMIT_PLAYER)),(S2I(NUMBERPAD_REFINED_SUBFIX)) , S2I(NUMBERPAD_SUMMIT_VALUE))
				return
			endif
			if NUMBERPAD_SUMMIT_PREFIX == "INV_DROP" then
				call s__Inventory_drop((GetPlayerId(NUMBERPAD_SUMMIT_PLAYER)),S2I(NUMBERPAD_SUMMIT_VALUE))
				return
			endif
			if NUMBERPAD_REFINED_PREFIX == "INV_DIVDROP" then
				call s__Inventory_divide((GetPlayerId(NUMBERPAD_SUMMIT_PLAYER)),(S2I(NUMBERPAD_REFINED_SUBFIX)) , 1)
				return
			endif
  endfunction

  function s__Inventory_genericFrameCallback takes nothing returns nothing
   local integer this= GetPlayerId(GetTriggerPlayer())
			if BlzGetTriggerFrame() == Inventory___INVENTORY_CLOSE_BUTTON then
				call s__Inventory_close(this)
				return
			endif
  endfunction

  function s__Inventory_onInit takes nothing returns nothing
			call TriggerAddCondition(INVENTORY_CLICK_TRIGGER, Condition(function s__Inventory_rightClickRequest))
			call TriggerAddCondition(NUMBERPAD_SUMMIT_TRIGGER, Condition(function s__Inventory_numberpadSummit))
  endfunction

  function s__Inventory_init takes nothing returns nothing
   local integer i= 0
   local trigger t= null
			set Inventory___INVENTORY_CLOSE_BUTTON=BlzCreateFrame("GenericCloseButton", FRAME_INVENTORY, 0, 0)
			call BlzFrameSetPoint((Inventory___INVENTORY_CLOSE_BUTTON ), ( FRAMEPOINT_TOPRIGHT ), ( FRAME_INVENTORY ), ( FRAMEPOINT_TOPRIGHT ), (( - 16 )*1.0) / 1800., (( - 16)*1.0) / 1800.) // INLINED!!
//textmacro instance: triggerRegisterFrameEventSimple("INVENTORY_ICON_RESET_FOCUS","INVENTORY_CLOSE_BUTTON")
	call BlzTriggerRegisterFrameEvent(Inventory___INVENTORY_ICON_RESET_FOCUS, Inventory___INVENTORY_CLOSE_BUTTON, FRAMEEVENT_CONTROL_CLICK)
	call BlzTriggerRegisterFrameEvent(Inventory___INVENTORY_ICON_RESET_FOCUS, Inventory___INVENTORY_CLOSE_BUTTON, FRAMEEVENT_MOUSE_ENTER)
	call BlzTriggerRegisterFrameEvent(Inventory___INVENTORY_ICON_RESET_FOCUS, Inventory___INVENTORY_CLOSE_BUTTON, FRAMEEVENT_MOUSE_LEAVE)
//end of: triggerRegisterFrameEventSimple("INVENTORY_ICON_RESET_FOCUS","INVENTORY_CLOSE_BUTTON")
			call BlzTriggerRegisterFrameEvent(Inventory___INVENTORY_GENERIC_FRAME_TRIGGER, Inventory___INVENTORY_CLOSE_BUTTON, FRAMEEVENT_CONTROL_CLICK)
			loop
				exitwhen i >= Inventory_SLOT
				set Inventory___INVENTORY_ICON_ICON[i]=BlzCreateFrameByType("BACKDROP", "", FRAME_INVENTORY, "", 0)
				call BlzFrameSetPoint((Inventory___INVENTORY_ICON_ICON[i] ), ( FRAMEPOINT_TOPLEFT ), ( FRAME_INVENTORY ), ( FRAMEPOINT_TOPLEFT ), (( 32 + ModuloInteger(i, Inventory___PER_ROW) * Inventory___SIZE )*1.0) / 1800., (( - 32 - Inventory___INSET_Y - R2I(i / Inventory___PER_ROW) * Inventory___SIZE)*1.0) / 1800.) // INLINED!!
				call BlzFrameSetSize((Inventory___INVENTORY_ICON_ICON[i] ), (( Inventory___SIZE )*1.0) / 1800., (( Inventory___SIZE)*1.0) / 1800.) // INLINED!!
				set Inventory___INVENTORY_ICON_TIER_BORDER[i]=BlzCreateFrameByType("BACKDROP", "", Inventory___INVENTORY_ICON_ICON[i], "", 0)
				call BlzFrameSetAllPoints(Inventory___INVENTORY_ICON_TIER_BORDER[i], Inventory___INVENTORY_ICON_ICON[i])
				set Inventory___INVENTORY_ICON_EXTRA_BACKDROP[i]=BlzCreateFrameByType("BACKDROP", "", Inventory___INVENTORY_ICON_ICON[i], "", 0)
				call BlzFrameSetAlpha(Inventory___INVENTORY_ICON_EXTRA_BACKDROP[i], 128)
				call BlzFrameSetTexture(Inventory___INVENTORY_ICON_EXTRA_BACKDROP[i], "textures\\black32.blp", 0, true)
				set Inventory___INVENTORY_ICON_EXTRA_TEXT[i]=BlzCreateFrame("MyTextSmall", Inventory___INVENTORY_ICON_ICON[i], 0, 0)
				call BlzFrameSetPoint((Inventory___INVENTORY_ICON_EXTRA_TEXT[i] ), ( FRAMEPOINT_BOTTOMRIGHT ), ( Inventory___INVENTORY_ICON_ICON[i] ), ( FRAMEPOINT_BOTTOMRIGHT ), (( - 2 )*1.0) / 1800., (( 2)*1.0) / 1800.) // INLINED!!
				call BlzFrameSetPoint((Inventory___INVENTORY_ICON_EXTRA_BACKDROP[i] ), ( FRAMEPOINT_BOTTOMRIGHT ), ( Inventory___INVENTORY_ICON_EXTRA_TEXT[i] ), ( FRAMEPOINT_BOTTOMRIGHT ), (( 2 )*1.0) / 1800., (( - 2)*1.0) / 1800.) // INLINED!!
				call BlzFrameSetPoint((Inventory___INVENTORY_ICON_EXTRA_BACKDROP[i] ), ( FRAMEPOINT_TOPLEFT ), ( Inventory___INVENTORY_ICON_EXTRA_TEXT[i] ), ( FRAMEPOINT_TOPLEFT ), (( - 2 )*1.0) / 1800., (( 2)*1.0) / 1800.) // INLINED!!
				call BlzFrameSetVisible(Inventory___INVENTORY_ICON_EXTRA_BACKDROP[i], false)
				call BlzFrameSetVisible(Inventory___INVENTORY_ICON_EXTRA_TEXT[i], false)
				set Inventory___INVENTORY_ICON_BTN[i]=BlzCreateFrameByType("BUTTON", "", FRAME_INVENTORY, "", 0)
				call BlzFrameSetAllPoints(Inventory___INVENTORY_ICON_BTN[i], Inventory___INVENTORY_ICON_ICON[i])
				call BlzTriggerRegisterFrameEvent(Inventory___INVENTORY_ICON_RESET_FOCUS, Inventory___INVENTORY_ICON_BTN[i], FRAMEEVENT_MOUSE_ENTER)
				call BlzTriggerRegisterFrameEvent(Inventory___INVENTORY_ICON_RESET_FOCUS, Inventory___INVENTORY_ICON_BTN[i], FRAMEEVENT_MOUSE_LEAVE)
				call BlzTriggerRegisterFrameEvent(Inventory___INVENTORY_ICON_RESET_FOCUS, Inventory___INVENTORY_ICON_BTN[i], FRAMEEVENT_CONTROL_CLICK)
				set i=i + 1
			endloop
			call TriggerAddCondition(Inventory___INVENTORY_ICON_RESET_FOCUS, Condition(function s__Frame_resetFocus))
			call TriggerAddCondition(Inventory___INVENTORY_GENERIC_FRAME_TRIGGER, Condition(function s__Inventory_genericFrameCallback))
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_ITEM_DESTROY)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Inventory_consumeRespond))
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_ITEM_PICK)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Inventory_itemPick))
			set t=null
  endfunction	



