  function s__Unit_prototype_healUnit takes integer this,integer target,real nv returns nothing
   local real val= 0.
			
			
			set CUSTOM_RESPOND_HEAL_CASTER=this
			set CUSTOM_RESPOND_HEAL_TARGET=target
			set CUSTOM_RESPOND_HEAL_AMOUNT=nv
			set CUSTOM_RESPOND_HEAL_PLUS=0.
			set CUSTOM_RESPOND_HEAL_MULTIPLY=1.0
			set CUSTOM_RESPOND_HEAL_DIVIDE=1.0
			set CUSTOM_RESPOND_HEAL_MINUS=0.
			//
			
			call s__Event_activate(CONFIG_EVENT_HEAL_MODIFY_STAT)
			call s__Event_activate(CONFIG_EVENT_HEAL_MODIFY)
			//
			
			set CUSTOM_RESPOND_HEAL_AMOUNT=( ( ( CUSTOM_RESPOND_HEAL_AMOUNT + CUSTOM_RESPOND_HEAL_PLUS ) * CUSTOM_RESPOND_HEAL_MULTIPLY ) / CUSTOM_RESPOND_HEAL_DIVIDE ) - CUSTOM_RESPOND_HEAL_MINUS
			
			set CUSTOM_RESPOND_HEAL_AMOUNT=CUSTOM_RESPOND_HEAL_AMOUNT * s__Unit_prototype_getCarculatedStatValue(target,CONFIG_STAT_HEAL_AMP)
			
			call s__Event_activate(CONFIG_EVENT_HEAL_LAST)
			
			call s__Unit_prototype__set_hp(target,(s__Unit_prototype_hp_true[(target)]) + CUSTOM_RESPOND_HEAL_AMOUNT) // INLINED!!
  endfunction

