  function s__Buff10d0_main_init takes integer this returns boolean
   local real v1= ( (s__Unit_prototype_getCalculatedStatValue((s__Buff_caster[this]),ENUM_STAT_HPREGEN)) * Buff10d0_DAMAGE_AMPLIFIER1 ) * ( 1 + Buff10d0_DAMAGE_PER_LEVEL * s__Buff_level[this] ) // INLINED!!
   local real v2= Buff10d0_DATA_REAL1 + Buff10d0_DATA_REAL2 * s__Buff_level[this]
