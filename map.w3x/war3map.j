				call sc__Actor__set_x(this,tx)
				call sc__Actor__set_y(this,ty)
			
			else
				call sc__Actor__set_x(this,GetRandomReal(GetRectMinX(s__Boss_zone[caster]) + 128, GetRectMaxX(s__Boss_zone[caster]) - 128))
				call sc__Actor__set_y(this,GetRandomReal(GetRectMinY(s__Boss_zone[caster]) + 128, GetRectMaxY(s__Boss_zone[caster]) - 128))
			endif
			set ps=sc__ProgressiveCircle_create(sc__Actor__get_x(this) , sc__Actor__get_y(this) , 0. , s__Boss_BossB000__rollingstone_fall_RAD , s__Boss_BossB000__rollingstone_DELAY1 + s__Boss_BossB000__rollingstone_fall_DELAY)
