   function s__Ability1000_actor_create takes integer u,real x,real y,real delay,integer level returns integer
    local integer this= s__Ability1000_actor__allocate(u , 0 , x , y , level , delay , true)
				set s__Ability1000_actor_angle[this]=s__Math_anglePoints(sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , sc__Actor__get_x(this) , sc__Actor__get_y(this)) // INLINED!!
				call s__Unit_prototype_setAnim((s__Actor_actor[(this)]),"attack") // INLINED!!
				call s__Unit_prototype_setAnimSpeed((s__Actor_actor[(this)]),(s__Unit_prototype_getCarculatedStatValue(((s__Actor_actor[(this)])),CONFIG_STAT_ATTACK_SPEED))) // INLINED!!
				call SetUnitFacing(s__Unit_prototype_origin_unit[(s__Actor_actor[(this)])], s__Ability1000_actor_angle[this]) // INLINED!!
				set s__UnitActor_suspend_ensnare[this]=true
				set s__Actor_progress_bar[this]=s__ProgressBar_create(Ability1000__NAME , (GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))]))) // INLINED!!
				return this
   endfunction
	


   function s__Ability1000__ind_beforeRefresh takes integer this returns nothing
