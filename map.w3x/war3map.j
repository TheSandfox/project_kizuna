  function s__Buff20g0_main_update takes integer this returns boolean
   local real new= s__Unit_prototype_getCarculatedStatValue(s__Buff_caster[this],Buff20g0_DAMAGE_STAT1) * Buff20g0_DAMAGE_AMPLIFIER1 * ( 1 + Buff20g0_DAMAGE_PER_LEVEL * ( s__Buff_level[this] ) )
			if new > s__Buff20g0_main_v[this] then
				set s__Buff20g0_main_v[this]=new
			endif
			return true
  endfunction

  function s__Buff20g0_main_init takes integer this returns boolean
			set s__Buff20g0_main_trig[this]=s__Trigger_create(this)
			call s__Trigger_addCondition(s__Buff20g0_main_trig[this],function s__Buff20g0_main_damageCallback)
			call TriggerRegisterVariableEvent((s__Trigger_main_trigger[s__Buff20g0_main_trig[this]] ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_DAMAGE_MODIFY)*1.0)) // INLINED!!
			set s__Buff20g0_main_v[this]=s__Unit_prototype_getCarculatedStatValue(s__Buff_caster[this],Buff20g0_DAMAGE_STAT1) * Buff20g0_DAMAGE_AMPLIFIER1 * ( 1 + Buff20g0_DAMAGE_PER_LEVEL * ( s__Buff_level[this] ) )
			call s__Unit_prototype_multiplyStatValue(s__Buff_target[this],CONFIG_STAT_ATTACK_SPEED , Buff20g0_DATA_REAL1)
			
			set s__Buff20g0_main_e1[this]=s__Effect_createAttatched(Buff20g0__EFFECT_PATH1 , s__Unit_prototype_origin_unit[s__Buff_target[this]] , "hand left")
			set s__Buff20g0_main_e2[this]=s__Effect_createAttatched(Buff20g0__EFFECT_PATH1 , s__Unit_prototype_origin_unit[s__Buff_target[this]] , "hand right")
			return true
  endfunction

