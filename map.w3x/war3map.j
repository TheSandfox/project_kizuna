  function s__Effect_getScale takes integer this returns real
			return s__Effect_scale_true[this]
  endfunction
	
  function s__Effect_getR takes integer this returns real
			return s__Effect_r_true[this]
  endfunction
	
  function s__Effect_getG takes integer this returns real
			return s__Effect_g_true[this]
  endfunction
	
  function s__Effect_getB takes integer this returns real
			return s__Effect_b_true[this]
  endfunction
	
