   function s__Ability1070__exp_executeExplosion takes integer this,integer target returns nothing
    local integer ef= s__Effect_create(Ability1070__EFFECT_PATH2 , sc__Object__get_x(target) , sc__Object__get_y(target) , sc__Object__get_z(target) + s__Object_pivot_z[target] , 270.)
				call s__Effect_setScale(ef,2.)
				call s__Effect_setRoll(ef,45.)
				call s__Effect_setColor(ef,255 , 0 , 255)
				call s__Effect_setDuration(ef,1.0)
				set ef=s__Effect_setDuration(s__Effect_createAttatched(Ability1070__EFFECT_PATH3 , s__Unit_prototype_origin_unit[target] , "chest"),1.5)
				call s__Explosion_damageTarget(this,target)
				if not s__Ability1070__exp_b[this] then
					call s__Unit_prototype_restoreMP(s__Explosion_owner[this],Ability1070__DATA_REAL1)
					set s__Ability1070__exp_b[this]=true
				endif
   endfunction

   function s__Ability1070__exp_create takes integer caster,real x1,real y1,real x2,real y2,integer level returns integer
    local integer this= s__Ability1070__exp__allocate(caster , x1 , y1 , x2 , y2 , Ability1070__RADIUS3)
    local integer ef= 0
				set s__Explosion_count[this]=1
				set s__Explosion_damage[this]=( s__Unit_prototype_getCarculatedStatValue(s__Explosion_owner[this],Ability1070__DAMAGE_STAT1) * Ability1070__DAMAGE_AMPLIFIER1 ) * ( 1 + Ability1070__DAMAGE_PER_LEVEL * ( level ) ) + ( s__Unit_prototype_getCarculatedStatValue(s__Explosion_owner[this],Ability1070__DAMAGE_STAT2) * Ability1070__DAMAGE_AMPLIFIER2 ) * ( 1 + Ability1070__DAMAGE_PER_LEVEL * ( level ) )
				call s__Explosion_setDamageFlagById(this,Ability1070__ID)
				set s__Explosion_weapon_type[this]=WEAPON_TYPE_METAL_MEDIUM_SLICE
				
				set ef=s__Effect_create(Ability1070__EFFECT_PATH1 , x1 , y1 , 55 , sc__Object__get_yaw(s__Explosion_owner[this]))
				call sc__Object__set_pitch(ef,- 90)
				call s__Effect_setMatrixScale(ef,1 , 1 , 0.5)
				call s__Effect_setAnimSpeed(ef,2.)
				call s__Effect_setDuration(ef,1.5)
				set ef=s__Effect_create(Ability1070__EFFECT_PATH1 , x2 , y2 , 55 , sc__Object__get_yaw(s__Explosion_owner[this]))
				call sc__Object__set_pitch(ef,- 90)
				call s__Effect_setMatrixScale(ef,1 , 1 , 2.5)
				call s__Effect_setAnimSpeed(ef,2.)
				call s__Effect_setDuration(ef,1.5)
				return this
   endfunction



