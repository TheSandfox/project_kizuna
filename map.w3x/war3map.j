  function s__ExtraAbilityIcon_refresh takes integer this returns nothing
			
			call BlzFrameSetVisible(s__ExtraAbilityIcon_container[this], GetLocalPlayer() == Player(s__ExtraAbilityIcon_pid[this]))
			
			call BlzFrameSetVisible(s__ExtraAbilityIcon_cooldown_backdrop[this], s__Ability_prototype_getUICooldown(s__ExtraAbilityIcon_target[this]) > 0. and s__Ability_prototype_getCarculatedMaxCooldown(s__ExtraAbilityIcon_target[this]) > 0.)
			call BlzFrameSetVisible(s__ExtraAbilityIcon_cooldown_backdrop2[this], s__Ability_prototype_getUICooldown(s__ExtraAbilityIcon_target[this]) > 0. and s__Ability_prototype_getCarculatedMaxCooldown(s__ExtraAbilityIcon_target[this]) > 0.)
			if sc__Ability_prototype_getCount(s__ExtraAbilityIcon_target[this]) == 0 then
				call BlzFrameSetAlpha(s__ExtraAbilityIcon_cooldown_backdrop[this], 64)
