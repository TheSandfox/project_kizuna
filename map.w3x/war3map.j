  function s__AbilityTable_addAbility takes integer tablenum,integer id returns nothing
			if tablenum < s__AbilityTable_TABLE_INDEX_LIMIT and tablenum >= 0 then
				call SaveInteger(AbilityTable___HASH, tablenum, s__AbilityTable_TABLE_SIZE[tablenum], id)
				set s__AbilityTable_TABLE_SIZE[tablenum]=s__AbilityTable_TABLE_SIZE[tablenum] + 1
			endif
  endfunction

  function s__AbilityTable_getAbility takes integer tablenum,integer index returns integer
			if HaveSavedInteger(AbilityTable___HASH, tablenum, index) then
				return LoadInteger(AbilityTable___HASH, tablenum, index)
			else
				return 0
			endif
  endfunction

  function s__AbilityTable_getRandomAbility takes integer pid,integer tablenum returns integer
   local integer this= pid
   local integer size= s__AbilityTable_TABLE_SIZE[tablenum]
   local integer i= GetRandomInt(0, size + sc__Array__get_size((sc__Array_getValue(s__AbilityTable_extra[this],tablenum))) - 1)
			if i < size then
				return LoadInteger(AbilityTable___HASH, tablenum, i)
			else
				return s__AbilityTable_getExtraAbility(this,tablenum , i - size)
			endif
  endfunction

  function s__AbilityTable_copyTable takes integer tablenum returns integer
