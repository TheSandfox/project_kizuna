			if s__Unit_prototype_maxhp_true[this] > 0. then
				set v=s__Unit_prototype_hp_true[this] / s__Unit_prototype_maxhp_true[this]
			endif
			set s__Unit_prototype_maxhp_true[this]=np
			if np <= 1. then
				call BlzSetUnitMaxHP(s__Unit_prototype_origin_unit[this], R2I(1.))
			else
				call BlzSetUnitMaxHP(s__Unit_prototype_origin_unit[this], R2I(np))
			endif
			call s__Unit_prototype__set_hp(this,(s__Unit_prototype_maxhp_true[(this)]) * v) // INLINED!!
  endfunction

