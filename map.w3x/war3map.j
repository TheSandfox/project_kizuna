  function s__UnitData_getIconPath takes integer uid returns string
			if HaveSavedString(s__UnitData_HASH, uid, s__UnitData_INDEX_EXTERNAL + 0) then
				return LoadStr(s__UnitData_HASH, uid, s__UnitData_INDEX_EXTERNAL + 0)
			else
				return "BTNBlackIcon"
			endif
  endfunction

  function s__UnitData_setIconPath takes string nval returns nothing
			call SaveStr(s__UnitData_HASH, s__UnitData_ID, s__UnitData_INDEX_EXTERNAL + 0, nval)
  endfunction

  function s__UnitData_getInitialAbility takes integer uid,integer index returns integer
			if HaveSavedInteger(s__UnitData_HASH, uid, s__UnitData_INDEX_INITIAL_ABILITY + index) then
				return LoadInteger(s__UnitData_HASH, uid, s__UnitData_INDEX_INITIAL_ABILITY + index)
			else
				return 0
			endif
  endfunction

  function s__UnitData_setInitialAbility takes integer index,integer aid returns nothing
			call SaveInteger(s__UnitData_HASH, s__UnitData_ID, s__UnitData_INDEX_INITIAL_ABILITY + index, aid)
  endfunction

  function s__UnitData_getExtraAbility takes integer uid,integer index returns integer
			if HaveSavedInteger(s__UnitData_HASH, uid, s__UnitData_INDEX_EXTRA_ABILITY + index) then
				return LoadInteger(s__UnitData_HASH, uid, s__UnitData_INDEX_EXTRA_ABILITY + index)
			else
				return 0
			endif
  endfunction

  function s__UnitData_setExtraAbility takes integer index,integer aid returns nothing
			call SaveInteger(s__UnitData_HASH, s__UnitData_ID, s__UnitData_INDEX_EXTRA_ABILITY + index, aid)
  endfunction

  function s__UnitData_setStatValue takes integer stattype,real base,real level returns nothing
			call SaveReal(s__UnitData_HASH, s__UnitData_ID, s__UnitData_INDEX_STAT + ( stattype * CONFIG_STAT_INDEX_SIZE ) + CONFIG_STAT_INDEX_BASE, base)
			call SaveReal(s__UnitData_HASH, s__UnitData_ID, s__UnitData_INDEX_STAT + ( stattype * CONFIG_STAT_INDEX_SIZE ) + CONFIG_STAT_INDEX_LEVEL, level)
  endfunction

  function s__UnitData_setDefaults takes nothing returns nothing
			set s__UnitData_ID=0
			call s__UnitData_setStatValue(CONFIG_STAT_MAXHP , 400. , 40.)
			call s__UnitData_setStatValue(CONFIG_STAT_MAXMP , 100. , 10.)
			call s__UnitData_setStatValue(CONFIG_STAT_ATTACK , 20. , 2.)
			call s__UnitData_setStatValue(CONFIG_STAT_DEFENSE , 20. , 2.)
			call s__UnitData_setStatValue(CONFIG_STAT_MAGICPOWER , 20. , 2.)
			call s__UnitData_setStatValue(CONFIG_STAT_RESISTANCE , 20. , 2.)
			call s__UnitData_setStatValue(CONFIG_STAT_ACCURACY , 20. , 2.)
			call s__UnitData_setStatValue(CONFIG_STAT_EVASION , 20. , 2.)
			call s__UnitData_setStatValue(CONFIG_STAT_HPREGEN , 4. , 0.4)
			call s__UnitData_setStatValue(CONFIG_STAT_MPREGEN , 1. , 0.1)
  endfunction

  function s__UnitData_onInit takes nothing returns nothing
			set s__UnitData_INDEX_STAT=0
			set s__UnitData_INDEX_INITIAL_ABILITY=s__UnitData_INDEX_STAT + CONFIG_STAT_SIZE * CONFIG_STAT_INDEX_SIZE
			set s__UnitData_INDEX_EXTRA_ABILITY=s__UnitData_INDEX_INITIAL_ABILITY + 8
			set s__UnitData_INDEX_ITEM=s__UnitData_INDEX_EXTRA_ABILITY + CONFIG_ABILITY_SIZE
			set s__UnitData_INDEX_STATUS=s__UnitData_INDEX_ITEM + CONFIG_UNIT_INVENTORY_SIZE
			set s__UnitData_INDEX_LAST=s__UnitData_INDEX_STATUS + CONFIG_STATUS_SIZE
			set s__UnitData_INDEX_EXTERNAL=s__UnitData_INDEX_LAST
			call s__UnitData_setDefaults()
  endfunction



