  function s__Waygate___p_warp_onComplete takes integer this returns nothing
			call s__Unit_prototype_warp((s__Actor_actor[(this)]),sc__Actor__get_x(this) , sc__Actor__get_y(this)) // INLINED!!
			
			call s__Effect_setDuration(s__Effect_create(s__Waygate___p_warp_EFFECT_PATH2 , sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , 0. , 270.),2.) // INLINED!!
			call IssueImmediateOrder(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))], ("stop")) // INLINED!!
			
			if s__Waygate___p_warp_move[this] then
				if GetLocalPlayer() == (GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))])) then // INLINED!!
					call PanCameraToTimed(sc__Object__get_x((s__Actor_actor[(this)])), sc__Object__get_y((s__Actor_actor[(this)])), 0.) // INLINED!!
				endif
			endif
			
			if GetLocalPlayer() == (GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))])) then // INLINED!!
				call PingMinimapEx(sc__Object__get_x((s__Actor_actor[(this)])), sc__Object__get_y((s__Actor_actor[(this)])), 1.5, 0, 128, 255, false) // INLINED!!
			endif
  endfunction

  function s__Waygate___p_warp_create takes integer caster,real x,real y,boolean move returns integer
   local integer this= s__Waygate___p_warp__allocate(caster , 0 , x , y , 0 , 3. , true)
			set s__Waygate___p_warp_move[this]=move
			set s__UnitActor_suspend_rclick[this]=true
			set s__UnitActor_suspend_stop[this]=true
			set s__Waygate___p_warp_ef[this]=s__Effect_create(s__Waygate___p_warp_EFFECT_PATH1 , sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , .0 , 270.) // INLINED!!
			set s__Actor_progress_bar[this]=s__ProgressBar_create("차원문 이동" , (GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))]))) // INLINED!!
			return this
  endfunction

  function s__Waygate___p_warp_onDestroy takes integer this returns nothing
			call s__Effect_kill(s__Waygate___p_warp_ef[this])
  endfunction





  function s__WarpWidget_show takes player p,boolean flag returns nothing
   local integer i= 0
   local integer this= 0
			if p == null or GetLocalPlayer() == p then
				call BlzFrameSetVisible(s__WarpWidget_CONTAINER, flag)
			endif
			loop
				exitwhen i >= s__WarpWidget_COUNTER
				set this=i
				if p == null or GetLocalPlayer() == p then
					call BlzFrameSetVisible(s__WarpWidget_btn[this], flag)
				endif
				set i=i + 1
			endloop
			set i=0
			if s__WarpWidget_VISIBLE[GetPlayerId(p)] != flag then
				if flag then
					
					call s__Array_add(s__CloseUI_list[(GetPlayerId(p))],s__CloseUI_ORDER_WARP)
					call s__User_enableAbilityHotkey(p , false)
				else
					
					call s__Array_eraseFor(s__CloseUI_list[(GetPlayerId(p))],s__CloseUI_ORDER_WARP)
					call s__User_enableAbilityHotkey(p , true)
				endif
			endif
			set s__WarpWidget_VISIBLE[GetPlayerId(p)]=flag
			if not flag and IsTriggerEnabled(Waygate___REMOVE_ACTOR) then
				
				set Waygate___REMOVE_ACTOR_ID=s__WarpWidget_ACTOR_ID[GetPlayerId(p)]
				
				call TriggerEvaluate(Waygate___REMOVE_ACTOR)
			endif
  endfunction

  function s__WarpWidget_setMoveCameraButtonState takes player p,boolean flag returns nothing
			set s__WarpWidget_MOVE_CAMERA[GetPlayerId(p)]=flag
			if flag then
				if GetLocalPlayer() == p then
					call BlzFrameSetText(BlzGetFrameByName("WarpMoveCameraToggleButtonText", 0), "카메라 이동 : |cff00ff00활성화|r")
				endif
			else
				if GetLocalPlayer() == p then
					call BlzFrameSetText(BlzGetFrameByName("WarpMoveCameraToggleButtonText", 0), "카메라 이동 : |cff999999비활성화|r")
				endif
			endif
  endfunction

  function s__WarpWidget_setCaster takes player p,integer caster,integer actorinstance returns nothing
			if s__WarpWidget_ACTOR_ID[GetPlayerId(p)] > 0 and actorinstance > 0 then
				set s__UnitActor_suspend_rclick[(s__WarpWidget_ACTOR_ID[GetPlayerId(p)])]=true
			endif
			set s__WarpWidget_CASTER[GetPlayerId(p)]=caster
			set s__WarpWidget_ACTOR_ID[GetPlayerId(p)]=actorinstance
			call s__Unit_prototype_releaseAbilityAll(caster)
  endfunction

  function s__WarpWidget_press takes nothing returns nothing
   local integer this= - 1
   local integer i= 0
			
			if BlzGetTriggerFrameEvent() == FRAMEEVENT_CONTROL_CLICK then
				call DisableTrigger(GetTriggeringTrigger())
				if GetLocalPlayer() == GetTriggerPlayer() then
					call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
					call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
				endif
				call EnableTrigger(GetTriggeringTrigger())
			elseif BlzGetTriggerFrameEvent() == FRAMEEVENT_MOUSE_LEAVE then
				if GetLocalPlayer() == GetTriggerPlayer() then
					call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
					call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
				endif
			endif
			
			if BlzGetTriggerFrameEvent() != FRAMEEVENT_CONTROL_CLICK then
				return
			endif
			
			if BlzGetTriggerFrame() == s__WarpWidget_CLOSE_BUTTON then
				call s__WarpWidget_show(GetTriggerPlayer() , false)
				return
			endif
			
			if BlzGetTriggerFrame() == s__WarpWidget_CHECKBOX then
				call s__WarpWidget_setMoveCameraButtonState(GetTriggerPlayer() , not s__WarpWidget_MOVE_CAMERA[GetPlayerId(GetTriggerPlayer())])
				return
			endif
			
			loop
				exitwhen i >= s__WarpWidget_COUNTER
				if s__WarpWidget_btn[(i)] == BlzGetTriggerFrame() then
					set this=i
					exitwhen true
				endif
				set i=i + 1
			endloop
			
			if this < 0 then
				return
			endif
			
			if s__WarpWidget_CASTER[GetPlayerId(GetTriggerPlayer())] < 1 then
				return
			endif
			
			call s__Waygate___p_warp_create(s__WarpWidget_CASTER[GetPlayerId(GetTriggerPlayer())] , s__WarpWidget_x[this] , s__WarpWidget_y[this] , s__WarpWidget_MOVE_CAMERA[GetPlayerId(GetTriggerPlayer())])
			
			set Waygate___REMOVE_ACTOR_ID=s__WarpWidget_ACTOR_ID[GetPlayerId(GetTriggerPlayer())]
			
			call TriggerEvaluate(Waygate___REMOVE_ACTOR)
			set s__WarpWidget_CASTER[GetPlayerId(GetTriggerPlayer())]=- 1
			set s__WarpWidget_ACTOR_ID[GetPlayerId(GetTriggerPlayer())]=- 1
			set Waygate___REMOVE_ACTOR_ID=- 1
  endfunction

  function s__WarpWidget_init takes nothing returns nothing
   local integer i= 0
			set s__WarpWidget_CONTAINER=BlzCreateFrame("MBEdge", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_WINDOW], 0, 0)
			call BlzFrameSetPoint((s__WarpWidget_CONTAINER ), ( FRAMEPOINT_CENTER ), ( FRAME_ORIGIN ), ( FRAMEPOINT_CENTER ), (( 0. )*1.0) / 1800., (( Waygate___OFFSET_Y)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((s__WarpWidget_CONTAINER ), (( Waygate___SIZE + Waygate___INSET * 2 )*1.0) / 1800., (( Waygate___SIZE + Waygate___INSET * 2)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetVisible(s__WarpWidget_CONTAINER, false)
			set s__WarpWidget_BACKDROP=BlzCreateFrameByType("BACKDROP", "", s__WarpWidget_CONTAINER, "", 0)
			call BlzFrameSetPoint((s__WarpWidget_BACKDROP ), ( FRAMEPOINT_TOP ), ( s__WarpWidget_CONTAINER ), ( FRAMEPOINT_TOP ), (( 0 )*1.0) / 1800., (( - Waygate___INSET)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((s__WarpWidget_BACKDROP ), (( Waygate___SIZE )*1.0) / 1800., (( Waygate___SIZE)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetTexture(s__WarpWidget_BACKDROP, "war3mapMap.blp", 0, true)
			set s__WarpWidget_CHECKBOX=BlzCreateFrame("WarpMoveCameraToggleButton", s__WarpWidget_CONTAINER, 0, 0)
			call BlzFrameSetPoint((s__WarpWidget_CHECKBOX ), ( FRAMEPOINT_BOTTOMLEFT ), ( s__WarpWidget_CONTAINER ), ( FRAMEPOINT_BOTTOMLEFT ), (( 16 )*1.0) / 1800., (( 16)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((s__WarpWidget_CHECKBOX ), (( 240 )*1.0) / 1800., (( 56)*1.0) / 1800.) // INLINED!!
			set s__WarpWidget_CLOSE_BUTTON=BlzCreateFrame("GenericCloseButton", s__WarpWidget_CONTAINER, 0, 0)
			call BlzFrameSetPoint((s__WarpWidget_CLOSE_BUTTON ), ( FRAMEPOINT_TOPRIGHT ), ( s__WarpWidget_CONTAINER ), ( FRAMEPOINT_TOPRIGHT ), (( - 16 )*1.0) / 1800., (( - 16)*1.0) / 1800.) // INLINED!!
			loop
				exitwhen i >= CONFIG_PLAYER_MAX
				call s__WarpWidget_setMoveCameraButtonState(Player(i) , true)
				set i=i + 1
			endloop
			set s__WarpWidget_BTN_PRESS=CreateTrigger()
			call BlzTriggerRegisterFrameEvent(s__WarpWidget_BTN_PRESS, s__WarpWidget_CHECKBOX, FRAMEEVENT_CONTROL_CLICK)
			call BlzTriggerRegisterFrameEvent(s__WarpWidget_BTN_PRESS, s__WarpWidget_CHECKBOX, FRAMEEVENT_MOUSE_LEAVE)
			call BlzTriggerRegisterFrameEvent(s__WarpWidget_BTN_PRESS, s__WarpWidget_CLOSE_BUTTON, FRAMEEVENT_CONTROL_CLICK)
			call BlzTriggerRegisterFrameEvent(s__WarpWidget_BTN_PRESS, s__WarpWidget_CLOSE_BUTTON, FRAMEEVENT_MOUSE_LEAVE)
			call TriggerAddCondition(s__WarpWidget_BTN_PRESS, Condition(function s__WarpWidget_press))
			call TriggerAddCondition(s__WarpWidget_BTN_PRESS, Condition(function s__Frame_resetFocus))
  endfunction

  function s__WarpWidget_create takes real x,real y returns integer
   local integer this= s__WarpWidget_COUNTER
			if s__WarpWidget_COUNTER == 0 then
				call s__WarpWidget_init()
			endif
			set s__WarpWidget_x[this]=x
			set s__WarpWidget_y[this]=y
			
			set s__WarpWidget_btn[this]=BlzCreateFrame("WarpButton", s__WarpWidget_BACKDROP, 0, this)
			call BlzFrameSetPoint((s__WarpWidget_btn[this] ), ( FRAMEPOINT_CENTER ), ( s__WarpWidget_BACKDROP ), ( FRAMEPOINT_BOTTOMLEFT ), (( Waygate___SIZE * ( ( s__WarpWidget_x[this] - CONFIG_MIN_X ) / ( CONFIG_MAX_X - CONFIG_MIN_X ) ) )*1.0) / 1800., (( Waygate___SIZE * ( ( s__WarpWidget_y[this] - CONFIG_MIN_Y ) / ( CONFIG_MAX_Y - CONFIG_MIN_Y ) ))*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((s__WarpWidget_btn[this] ), (( 64 )*1.0) / 1800., (( 64)*1.0) / 1800.) // INLINED!!
			
			call BlzFrameSetTexture(BlzGetFrameByName("WarpButtonIcon", this), "ReplaceableTextures\\CommandButtons\\BTNWaygate.blp", 0, true)
			
			set s__WarpWidget_VISIBLE[this]=false
			call s__WarpWidget_show(Player(this) , false)
			
//textmacro instance: triggerRegisterFrameEventSimple("BTN_PRESS",".btn")
	call BlzTriggerRegisterFrameEvent(s__WarpWidget_BTN_PRESS, s__WarpWidget_btn[this], FRAMEEVENT_CONTROL_CLICK)
	call BlzTriggerRegisterFrameEvent(s__WarpWidget_BTN_PRESS, s__WarpWidget_btn[this], FRAMEEVENT_MOUSE_ENTER)
	call BlzTriggerRegisterFrameEvent(s__WarpWidget_BTN_PRESS, s__WarpWidget_btn[this], FRAMEEVENT_MOUSE_LEAVE)
//end of: triggerRegisterFrameEventSimple("BTN_PRESS",".btn")
			set s__WarpWidget_COUNTER=s__WarpWidget_COUNTER + 1
			return this
  endfunction



  function s__Waygate_select_destination_respond takes nothing returns nothing
   local integer this= Waygate___REMOVE_ACTOR_ID
			if Waygate___REMOVE_ACTOR_ID < 1 then
				return
			endif
