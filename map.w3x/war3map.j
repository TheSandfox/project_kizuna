  function s__Summon_summonDeath takes integer this returns nothing

  endfunction

  function s__Summon_manaTimerCallback takes nothing returns nothing
   local integer i= 0
   local integer this= 0
			loop
				set this=s__Array_getValue(s__Summon_MAIN_ARRAY,i)
				exitwhen this <= 0
				call s__Unit_prototype__set_mp(this,(s__Unit_prototype_mp_true[(this)]) - 1.0 * s__Summon_MANA_TICK) // INLINED!!
				call s__Summon_durationTest(this)
				set i=i + 1
			endloop
  endfunction

  function s__Summon_activate takes boolean flag returns nothing
			if flag then
				
				call TimerStart((s__Summon_MAIN_TIMER ), (( s__Summon_MANA_TICK )*1.0), ( true ), ( function s__Summon_manaTimerCallback)) // INLINED!!
				call EnableTrigger(s__Summon_DEATH_TRIGGER)
			else
				
				call PauseTimer((s__Summon_MAIN_TIMER)) // INLINED!!
				call DisableTrigger(s__Summon_DEATH_TRIGGER)
			endif
  endfunction

  function s__Summon_plusCounter takes nothing returns nothing
			set s__Summon_COUNTER=s__Summon_COUNTER + 1
			if s__Summon_COUNTER == 1 then
				call s__Summon_activate(true)
			endif
  endfunction

  function s__Summon_minusCounter takes nothing returns nothing
			set s__Summon_COUNTER=s__Summon_COUNTER - 1
			if s__Summon_COUNTER == 0 then
				call s__Summon_activate(false)
			endif
  endfunction

  function s__Summon_summonRegister takes integer this returns nothing
			if not s__Summon__summonflag_flag[(this)] then
				
				call s__Array_add(s__Summon_MAIN_ARRAY,this)
				
				set s__Summon__summonflag_flag[(this)]=true
				
				call s__Summon_plusCounter()
			endif
  endfunction

  function s__Summon_summonUnregister takes integer this returns nothing
			if s__Summon__summonflag_flag[(this)] then
				
				call s__Array_eraseFor(s__Summon_MAIN_ARRAY,this)
				
				set s__Summon__summonflag_flag[(this)]=false
				
				call s__Summon_minusCounter()
			endif
  endfunction

  function s__Summon_create takes integer caster,integer uid,real x,real y,real yaw,integer level,real duration returns integer
   local integer this= s__Summon__allocate((GetOwningPlayer(s__Unit_prototype_origin_unit[(caster)])) , uid , x , y , yaw) // INLINED!!
			set s__Summon_caster[this]=caster
			call s__Summon_summonRegister(this)
			
			call s__UnitClass_plusClass((this),ENUM_UNIT_CLASS_SUMMON)
			
			call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((ENUM_STAT_MPREGEN ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_BASE ) ), (( (( 0.)*1.0))*1.0)) // INLINED!!
			call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((ENUM_STAT_MPREGEN ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_LEVEL ) ), (( (( 0.)*1.0))*1.0)) // INLINED!!
			call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((ENUM_STAT_MAXMP ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_BASE ) ), (( (( s__Summon_MANA_MAX)*1.0))*1.0)) // INLINED!!
			call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((ENUM_STAT_MAXMP ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_LEVEL ) ), (( (( 0.)*1.0))*1.0)) // INLINED!!
			call s__Unit_prototype_refreshStatValue(this,ENUM_STAT_MPREGEN)
			call s__Unit_prototype_refreshStatValue(this,ENUM_STAT_MAXMP)
			
			call s__Unit_prototype_setLevel(this,level)
			call s__Summon_setDuration(this,duration)
			
			set s__Unit_prototype_restore_mp[this]=false
			
			call BlzSetUnitRealField(s__Unit_prototype_origin_unit[(this)], UNIT_RF_SELECTION_SCALE, ((1.5)*1.0)) // INLINED!!
			return this
  endfunction

  function s__Summon_onDestroy takes integer this returns nothing
			if s__Summon__summonflag_flag[(this)] then
				call s__Summon_summonUnregister(this)
			endif
			call s__UnitClass_minusClass((this),ENUM_UNIT_CLASS_SUMMON)
  endfunction

  function s__Summon_deathCallback takes nothing returns nothing
   local integer this= 0
