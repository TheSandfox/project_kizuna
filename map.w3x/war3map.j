//library Game:



  function s__Game_playerLeave takes nothing returns nothing
			if (GetPlayerId(GetTriggerPlayer())) > 0 then
				call sc__SkillShop_destroy((GetPlayerId(GetTriggerPlayer())))
			endif
			if (GetPlayerId(GetTriggerPlayer())) > 0 then
				call s__UI_destroy((GetPlayerId(GetTriggerPlayer())))
			endif
			if (GetPlayerId(GetTriggerPlayer())) > 0 then
				call sc__SlotChanger_destroy((GetPlayerId(GetTriggerPlayer())))
			endif
			if (GetPlayerId(GetTriggerPlayer())) > 0 then
				call sc__Inventory_destroy((GetPlayerId(GetTriggerPlayer())))
			endif
			if (s__User_FOCUS_UNIT[GetPlayerId((GetTriggerPlayer()))]) > 0 then // INLINED!!
				set s__Unit_prototype_is_revive[(s__User_FOCUS_UNIT[GetPlayerId((GetTriggerPlayer()))])]=false // INLINED!!
				call s__User_setFocusUnit(GetTriggerPlayer() , 0)
			endif
  endfunction

  function s__Game_defeat takes nothing returns nothing
   local integer i= 0
   local integer u= 0
			set s__Tombstone_GAME_OVER=true
			call s__Guardians_kill()
			loop
				exitwhen i >= 4
				set u=(s__User_FOCUS_UNIT[GetPlayerId((Player(i)))]) // INLINED!!
				call s__Unit_prototype_kill(u)
				call s__Unit_prototype_clearAbility(u)
				set i=i + 1
			endloop
			call PauseTimer((s__Round_TIMER)) // INLINED!!
			set s__SkillShop_DEFEAT=true
  endfunction

  function s__Game_systemMessage takes string msg returns nothing
			call BlzDisplayChatMessage(CONFIG_PLAYER_SYSTEM, 0, msg)
  endfunction

  function s__Game_addLevel takes nothing returns nothing
   local integer i= 0
   local integer u= 0
			loop
				exitwhen i >= 4
				call s__User_addGold(Player(i) , 5)
				set u=(s__User_FOCUS_UNIT[GetPlayerId((Player(i)))]) // INLINED!!
				if u > 0 then
					call s__Effect_setDuration(s__Effect_createAttatched("Abilities\\Spells\\Other\\Levelup\\LevelupCaster.mdl" , s__Unit_prototype_origin_unit[u] , "origin"),1.5)
					call s__Unit_prototype__set_level(u,(s__Unit_prototype_level_true[(u)]) + 1) // INLINED!!
				endif
				set i=i + 1
			endloop
  endfunction

  function s__Game_initForPlayer takes player p,integer uid,integer chingho returns nothing
   local integer u= s__Unit_create(p , uid , (((GetRectCenterX(gg_rct_Spawn) )*1.0) + (( 128 )*1.0) * Cos((( GetRandomReal(0., 360.))*1.0) * bj_DEGTORAD)) , (((GetRectCenterY(gg_rct_Spawn) )*1.0) + (( 128 )*1.0) * Sin((( GetRandomReal(0., 360.))*1.0) * bj_DEGTORAD)) , 270.) // INLINED!!
			set s__Unit_prototype_is_revive[u]=true
			
			call FixCamSetup(p , gg_cam_Cam00 , true)
			call FixCamSetField(p , CAMERA_FIELD_TARGET_DISTANCE , Game___CAMERA_DISTANCE)
			call FixCamResetPosition(p)
			if GetLocalPlayer() == p then
				call PanCameraToTimed(sc__Object__get_x(u), sc__Object__get_y(u), 0.)
			endif
			
			call sc__Mouse_activateRefresher(p)
			
			call s__User_new(p)
			call s__User_setFocusUnit(p , u)
			call s__User_selectFocusUnit(p)
			
			call s__AbilityTable_createExtra(GetPlayerId(p) , uid)
			
			call s__Unit_setChingho(u,chingho)
			
			call s__UI_create(p)
			
			if Game___GAME_DEBUG then
				call s__User_addGold(p , 5000)
			else
				call s__User_addGold(p , 5)
			endif
			call s__Unit_prototype__set_level(u,5)
			
			//call u.addAbility(chingho)
			//call u.swapAbility(2,9)
  endfunction

  function s__Game_endSelect takes nothing returns nothing
   local integer i= 0
			
			call s__Tip_init()
			
			call s__UI_init()
			call TriggerEvaluate(st__Inventory_init) // INLINED!!
			call s__Numberpad_init()
			
			loop
				exitwhen i >= CONFIG_PLAYER_MAX
				if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_USER then
					call s__Game_initForPlayer(Player(i) , CharacterSelect_ID[i] , CharacterSelect_CHINGHO_ID[i])
					call TriggerRegisterPlayerEventLeave(Game___LEAVE_TRIGGER, Player(i))
				endif
				set i=i + 1
			endloop
			
			call s__TreeOfLife_init()
			
			call s__Guardians_init()
			
			call s__Round_init()
			
			call s__Interactive_init()
			
			call s__Field_init()
			
			call s__Field_openWithWaygate(s__Field_getRandomWaygateField()) // INLINED!!
			
			call TriggerAddCondition(Game___LEAVE_TRIGGER, Condition(function s__Game_playerLeave))
  endfunction

  function s__Game_start takes nothing returns nothing
   local integer u= 0
   local trigger t= null
   local integer i= 0
			if Game___GAME_DEBUG then
				
				//call Tip.init()
				
				call s__UI_init()
				call TriggerEvaluate(st__Inventory_init) // INLINED!!
				call s__Numberpad_init()
				
				loop
					exitwhen i >= CONFIG_PLAYER_MAX
					if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING then
						call s__Game_initForPlayer(Player(i) , Game___TEST_UNIT_ID , 'C000')
					endif
					//call initForPlayer(Player(1),'HR09','C000')
					set i=i + 1
				endloop
				
				call s__TreeOfLife_init()
				
				//call Guardians.init()
				
				//call Round.init()
				
				// call Interactive.init()
				
				// call Field.init()
				
				// call Navigator.init()
				
				// call SkillShop(0).setLevel(10)
				// call SkillShop(0).refresh()
				
			else
				
				call s__CharacterSelect_init()
			endif
			call DestroyTrigger(GetTriggeringTrigger())
			set t=null
  endfunction

  function s__Game_initAlly takes nothing returns nothing
   local integer i= 0
			loop
				exitwhen i >= CONFIG_PLAYER_MAX
				call SetPlayerAllianceStateBJ(Player(i), CONFIG_PLAYER_GUARDIANS, bj_ALLIANCE_ALLIED_VISION)
				call SetPlayerAllianceStateBJ(CONFIG_PLAYER_GUARDIANS, Player(i), bj_ALLIANCE_ALLIED_VISION)
				call SetPlayerAllianceStateBJ(Player(i), CONFIG_PLAYER_ITEM, bj_ALLIANCE_ALLIED_VISION)
				call SetPlayerAllianceStateBJ(CONFIG_PLAYER_ITEM, Player(i), bj_ALLIANCE_ALLIED_VISION)
				set i=i + 1
			endloop
			call SetPlayerAllianceStateBJ(CONFIG_PLAYER_MONSTER, CONFIG_PLAYER_UNDEAD, bj_ALLIANCE_ALLIED_VISION)
			call SetPlayerAllianceStateBJ(CONFIG_PLAYER_UNDEAD, CONFIG_PLAYER_MONSTER, bj_ALLIANCE_ALLIED_VISION)
			call SetPlayerAllianceStateBJ(CONFIG_PLAYER_ITEM, CONFIG_PLAYER_UNDEAD, bj_ALLIANCE_ALLIED_VISION)
			call SetPlayerAllianceStateBJ(CONFIG_PLAYER_UNDEAD, CONFIG_PLAYER_ITEM, bj_ALLIANCE_ALLIED_VISION)
			call SetPlayerAllianceStateBJ(CONFIG_PLAYER_ITEM, CONFIG_PLAYER_MONSTER, bj_ALLIANCE_ALLIED_VISION)
			call SetPlayerAllianceStateBJ(CONFIG_PLAYER_MONSTER, CONFIG_PLAYER_ITEM, bj_ALLIANCE_ALLIED_VISION)
  endfunction

  function s__Game_onInit takes nothing returns nothing
			
   local trigger t= CreateTrigger()
			call TriggerRegisterTimerEvent(t, 0.5, false)
			call TriggerAddAction(t, function s__Game_start)
			
			call BlzLoadTOCFile("ui\\framedef\\myframes\\MyFrames.toc")
			
			call BlzHideOriginFrames(true)
			call BlzFrameClearAllPoints(BlzGetFrameByName("ConsoleUIBackdrop", 0))
			
			// call BlzFrameClearAllPoints(BlzGetFrameByName("ConsoleTopBar",0))
			call BlzFrameSetVisible(BlzGetFrameByName("ConsoleTopBar", 0), false)
			
			call BlzFrameClearAllPoints(BlzGetFrameByName("CommandBarFrame", 0))
			call BlzFrameClearAllPoints(BlzFrameGetParent(BlzGetFrameByName("CommandBarFrame", 0)))
			
			call BlzFrameSetAbsPoint(BlzGetOriginFrame(ORIGIN_FRAME_UNIT_MSG, 0), FRAMEPOINT_BOTTOMLEFT, 0., 0.205)
			call BlzFrameSetSize(BlzGetOriginFrame(ORIGIN_FRAME_UNIT_MSG, 0), 1, 1)
			
			call BlzFrameSetAbsPoint(BlzGetOriginFrame(ORIGIN_FRAME_CHAT_MSG, 0), FRAMEPOINT_BOTTOMLEFT, 0., 0.165)
			call BlzFrameSetSize(BlzGetOriginFrame(ORIGIN_FRAME_CHAT_MSG, 0), 1, 1)
			
			call BlzEnableSelections(false, false)
			
			call FogMaskEnable(false)
			call FogEnable(false)
			
			call SetTimeOfDay(12.)
   			call SetTimeOfDayScalePercentBJ(0.)
			
			call s__Camera_init()
			
			call SetPlayerName(CONFIG_PLAYER_GUARDIANS, "수호자")
			call SetPlayerName(CONFIG_PLAYER_MONSTER, "숲의 괴물들")
			call SetPlayerName(CONFIG_PLAYER_UNDEAD, "언데드 침략자")
			call SetPlayerName(CONFIG_PLAYER_SYSTEM, "|cffffcc00시스템|r")
			
			call s__Game_initAlly()
			
			if not Game___GAME_DEBUG then
				
				set CharacterSelect_BACKGROUND=BlzCreateFrameByType("SPRITE", "", BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "", 0)
				call BlzFrameSetModel(CharacterSelect_BACKGROUND, "ui\\characterselectbackground.mdl", 0)
				call BlzFrameSetAbsPoint(CharacterSelect_BACKGROUND, FRAMEPOINT_BOTTOMLEFT, 0., 0.)
				call BlzFrameSetSize(CharacterSelect_BACKGROUND, 1, 1)
			endif
			
			set t=null
  endfunction




  function s__Cheat_cheatCallback takes nothing returns nothing
   local integer i= 0
   local integer u= 0
			if BlzGetTriggerPlayerKey() == OSKEY_O then
				
				loop
					exitwhen i >= 1
					set u=s__Unit_create(CONFIG_PLAYER_UNDEAD , Game___DUMMY_UNIT_ID1 , (s__s__Mouse_X[GetPlayerId((Player(0)))]) , (s__s__Mouse_Y[GetPlayerId((Player(0)))]) , 0) // INLINED!!
					call s__Unit_prototype_plusStatValue(u,CONFIG_STAT_HPREGEN , 100.)
					call s__Unit_prototype_plusStatus(u,CONFIG_STATUS_CAST)
					set i=i + 1
				endloop
				call s__BossB000_create(15 , GetRectCenterX(gg_rct_Warp006) , GetRectCenterY(gg_rct_Warp006))
			elseif BlzGetTriggerPlayerKey() == OSKEY_P then
				
				call BJDebugMsg("================디버그절취선================")
			elseif BlzGetTriggerPlayerKey() == OSKEY_7 then
				
				call s__Unit_prototype__set_level((s__User_FOCUS_UNIT[GetPlayerId((Player(0)))]),(s__Unit_prototype_level_true[((s__User_FOCUS_UNIT[GetPlayerId((Player(0)))]))]) + 1) // INLINED!!
			elseif BlzGetTriggerPlayerKey() == OSKEY_8 then
				
				set i=s__AbilityShard_addUpgradePoint(s__AbilityShard_addLevel(s__AbilityShard_create(s__AbilityTable_getRandomAbility(0 , s__AbilityTable_TIER_1)),4),s__AbilityShard_getRandomUpgradeType() , 4 * 1)
				call s__Item_prototype_drop((i),(s__s__Mouse_X[GetPlayerId((Player(0)))]) , (s__s__Mouse_Y[GetPlayerId((Player(0)))])) // INLINED!!
			endif
  endfunction

  function s__Cheat_onInit takes nothing returns nothing

				set s__Cheat_CHEAT=CreateTrigger()
				call BlzTriggerRegisterPlayerKeyEvent(s__Cheat_CHEAT, Player(0), OSKEY_7, 0, true)
				call BlzTriggerRegisterPlayerKeyEvent(s__Cheat_CHEAT, Player(0), OSKEY_8, 0, true)
				call BlzTriggerRegisterPlayerKeyEvent(s__Cheat_CHEAT, Player(0), OSKEY_9, 0, true)
				call BlzTriggerRegisterPlayerKeyEvent(s__Cheat_CHEAT, Player(0), OSKEY_0, 0, true)
				call BlzTriggerRegisterPlayerKeyEvent(s__Cheat_CHEAT, Player(0), OSKEY_O, 0, true)
				call BlzTriggerRegisterPlayerKeyEvent(s__Cheat_CHEAT, Player(0), OSKEY_P, 0, true)
				call TriggerAddCondition(s__Cheat_CHEAT, Condition(function s__Cheat_cheatCallback))

  endfunction



