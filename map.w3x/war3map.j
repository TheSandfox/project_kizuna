				call BlzSetSpecialEffectPitch(s__Effect_origin_effect[this], Deg2Rad(nv + s__Object_offset_pitch_true[this]))
				call BlzSetSpecialEffectPitch(s__Effect_origin_effect[this], Deg2Rad(nv + s__Object_offset_pitch_true[this]))
			else
				call BlzSetSpecialEffectPitch(s__Effect_origin_effect[this], Deg2Rad(nv + s__Object_offset_pitch_true[this]))
			endif
