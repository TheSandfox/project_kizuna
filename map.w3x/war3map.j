//textmacro instance: demonicAllocate("CustomClick_prototype")
 function CustomClick_prototype_demonicAllocate takes nothing returns integer
  local integer this=si__CustomClick_prototype_F
		   if ( this != 0 ) then
			   set si__CustomClick_prototype_F=si__CustomClick_prototype_V[this]
		   else
			   set si__CustomClick_prototype_I=si__CustomClick_prototype_I + 1
			   set this=si__CustomClick_prototype_I
		   endif
		   set si__CustomClick_prototype_type[this]=0
		   set si__CustomClick_prototype_V[this]=- 1
		return this
	endfunction
//end of: demonicAllocate("CustomClick_prototype")


 function s__CustomClick_prototype_create takes nothing returns integer
  local integer this= CustomClick_prototype_demonicAllocate()
		return this
 endfunction





 function s__CustomClick_timerCallback takes nothing returns nothing
  local integer this= (sg__TimerUtils___DATA_get(GetHandleId(((GetExpiredTimer()))) * HASH_UP / HASH_DOWN + HASH_BIAS)) // INLINED!!
		set EVT_CLICK_BUTTON_TYPE=s__CustomClick_mbt[this]
		set EVT_CLICK_PLAYER=s__CustomClick_p[this]
		set EVT_CLICK_CASTER=s__CustomClick_caster[this]
		set EVT_CLICK_TARGET=s__CustomClick_target[this]
		set EVT_CLICK_X=s__CustomClick_x[this]
		set EVT_CLICK_Y=s__CustomClick_y[this]
		set EVT_CLICK_ENABLE=true
		call s__Event_activate(ENUM_EVENT_CLICK)
		set EVT_CLICK_ENABLE=false
		call sc__CustomClick_prototype_deallocate(this)
 endfunction

 function s__CustomClick_create takes player p,integer caster,unit target,mousebuttontype mbt,real x,real y returns integer
  local integer this= s__CustomClick__allocate()
		set s__CustomClick_p[this]=p
		set s__CustomClick_caster[this]=caster
		set s__CustomClick_target[this]=target
		set s__CustomClick_mbt[this]=mbt
		set s__CustomClick_x[this]=x
		set s__CustomClick_y[this]=y
		set s__CustomClick_t[this]=s__Timer_new(this)
		call TimerStart((s__CustomClick_t[this] ), (( 0. )*1.0), ( false ), ( function s__CustomClick_timerCallback)) // INLINED!!
		return this
 endfunction

 function s__CustomClick_onDestroy takes integer this returns nothing
		call ReleaseTimer((s__CustomClick_t[this])) // INLINED!!
		set s__CustomClick_t[this]=null
 endfunction
		



 function s__Mouse_customClick takes player p,integer caster,unit target,mousebuttontype mbt,real x,real y returns nothing
		call s__CustomClick_create(p , caster , target , mbt , x , y)
 endfunction

 function s__Mouse_getX takes player p returns real
		return s__s__Mouse_X[GetPlayerId(p)]
 endfunction

 function s__Mouse_getVX takes player p returns real
		return s__s__Mouse_X[GetPlayerId(p)]
 endfunction

 function s__Mouse_getY takes player p returns real
		return s__s__Mouse_Y[GetPlayerId(p)]
 endfunction

 function s__Mouse_getVY takes player p returns real
		return s__s__Mouse_Y[GetPlayerId(p)]
 endfunction

 function s__Mouse_move takes nothing returns nothing
  local integer i= GetPlayerId(GetTriggerPlayer())
		set s__s__Mouse_X[i]= BlzGetTriggerPlayerMouseX()
		set s__s__Mouse_Y[i]= BlzGetTriggerPlayerMouseY()
 endfunction

 function s__Mouse_receiveClick takes nothing returns nothing
  local string source= ""
  local integer l= 0
		set udg_EVENT_VALUE=0.
		set source=BlzGetTriggerSyncData()
		set l=StringLength(source)
		set bj_forLoopAIndex=0
		
		loop
			exitwhen SubString(source, bj_forLoopAIndex, bj_forLoopAIndex + 1) == "!"
			set bj_forLoopAIndex=bj_forLoopAIndex + 1
		endloop
		set EVT_CLICK_PLAYER=Player(S2I(SubString(source, 0, bj_forLoopAIndex)))
		set EVT_CLICK_X=S2I(SubString(source, bj_forLoopAIndex + 1, l))
		loop
			exitwhen SubString(source, bj_forLoopAIndex, bj_forLoopAIndex + 1) == "@"
			set bj_forLoopAIndex=bj_forLoopAIndex + 1
		endloop
		set EVT_CLICK_Y=S2I(SubString(source, bj_forLoopAIndex + 1, l))
		loop
			exitwhen SubString(source, bj_forLoopAIndex, bj_forLoopAIndex + 1) == "#"
			set bj_forLoopAIndex=bj_forLoopAIndex + 1
		endloop
		set EVT_CLICK_TARGET=H2U(S2I(SubString(source, bj_forLoopAIndex + 1, l)))
		loop
			exitwhen SubString(source, bj_forLoopAIndex, bj_forLoopAIndex + 1) == "$"
			set bj_forLoopAIndex=bj_forLoopAIndex + 1
		endloop
		set EVT_CLICK_CASTER=S2I(SubString(source, bj_forLoopAIndex + 1, l))

		if BlzGetTriggerSyncPrefix() == "GRM" then
			set EVT_CLICK_BUTTON_TYPE=MOUSE_BUTTON_TYPE_RIGHT
		elseif BlzGetTriggerSyncPrefix() == "GLM" then
			set EVT_CLICK_BUTTON_TYPE=MOUSE_BUTTON_TYPE_LEFT
		endif



		set EVT_CLICK_ENABLE=true
		
		call s__Event_activate(ENUM_EVENT_CLICK)
		set EVT_CLICK_PLAYER=null
		set EVT_CLICK_TARGET=null
		set EVT_CLICK_ENABLE=false
		set EVT_CLICK_BUTTON_TYPE=null
 endfunction

	
 function s__Mouse_clickRequest takes player p,integer caster,unit target,mousebuttontype mbt,real x,real y returns nothing
		if mbt == MOUSE_BUTTON_TYPE_RIGHT then
			call BlzSendSyncData("GRM", I2S(GetPlayerId(p)) + "!" + I2S(R2I(x)) + "@" + I2S(R2I(y)) + "#" + I2S(GetHandleId(target)) + "$" + I2S(caster))
		elseif mbt == MOUSE_BUTTON_TYPE_LEFT then
			call BlzSendSyncData("GLM", I2S(GetPlayerId(p)) + "!" + I2S(R2I(x)) + "@" + I2S(R2I(y)) + "#" + I2S(GetHandleId(target)) + "$" + I2S(caster))
		endif
 endfunction

 function s__Mouse_clickCallback takes nothing returns nothing
		if GetLocalPlayer() == GetTriggerPlayer() then
			call s__Mouse_clickRequest(GetTriggerPlayer() , (s__User_FOCUS_UNIT[GetPlayerId((GetTriggerPlayer()))]) , BlzGetMouseFocusUnit() , BlzGetTriggerPlayerMouseButton() , BlzGetTriggerPlayerMouseX() , BlzGetTriggerPlayerMouseY()) // INLINED!!
		endif
 endfunction

 function s__Mouse_activateRefresher takes player p returns nothing
  local integer i= GetPlayerId(p)
		set s__s__Mouse_MOVE[i]= null
		set s__s__Mouse_MOVE[i]= CreateTrigger()
		call TriggerRegisterPlayerEvent(s__s__Mouse_MOVE[i], p, EVENT_PLAYER_MOUSE_MOVE)
		call TriggerAddCondition(s__s__Mouse_MOVE[i], Condition(function s__Mouse_move))
		set s__s__Mouse_X[i]= 0.
		set s__s__Mouse_Y[i]= 0.
		
		call TriggerRegisterPlayerEvent(Mouse___TRIGGER, p, EVENT_PLAYER_MOUSE_DOWN)
		call BlzTriggerRegisterPlayerSyncEvent(Mouse___RECEIVE, p, "GRM", false)
		call BlzTriggerRegisterPlayerSyncEvent(Mouse___RECEIVE, p, "GLM", false)
 endfunction

 function s__Mouse_onInit takes nothing returns nothing
		call TriggerAddCondition(Mouse___TRIGGER, Condition(function s__Mouse_clickCallback))
		call TriggerAddCondition(Mouse___RECEIVE, Condition(function s__Mouse_receiveClick))
 endfunction


