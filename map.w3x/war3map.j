  function s__CloseUI_close takes integer this,integer order returns nothing
			if order == s__CloseUI_ORDER_INVENTORY_DIALOG then
				call sc__Inventory_close((this))
				return
			endif
			if order == s__CloseUI_ORDER_NUMBERPAD then
				call s__Numberpad_close((this))
				return
			endif
			if order == s__CloseUI_ORDER_INVENTORY then
				call sc__Inventory_close((this))
				return
			endif
			if order == s__CloseUI_ORDER_STAT_INDICATOR then
				call s__StatIndicator_close((this))
				return
			endif
			if order == s__CloseUI_ORDER_SLOT_CHANGER then
				call sc__SlotChanger_close((this))
				return
			endif
			if order == s__CloseUI_ORDER_SKILL_SHOP then
				call sc__SkillShop_close((this))
				return
			endif
			if order == s__CloseUI_ORDER_WARP then
				call s__WarpWidget_show(Player(this) , false)
			endif
			if order == s__CloseUI_ORDER_ABILITY_MANAGER then
				call s__AbilityManager_show(((this)),false) // INLINED!!
				return
			endif
  endfunction

  function s__CloseUI_act takes nothing returns nothing
   local integer this= GetPlayerId(GetTriggerPlayer())
			call s__CloseUI_close(this,s__Array_getValue(s__CloseUI_list[this],(LoadInteger(Hash___D, (((s__CloseUI_list[this]))), (s__Array_P_SIZE))) - 1)) // INLINED!!
  endfunction

