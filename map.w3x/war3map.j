			set s__MeleeAttack_damage_type[this]=s__Damage_DAMAGE_TYPE_PHYSICAL
			set s__MeleeAttack_attack_type[this]=s__Damage_ATTACK_TYPE_BASIC
			set s__MeleeAttack_interval_type[this]=s__Damage_INTERVAL_TYPE_SINGLE
