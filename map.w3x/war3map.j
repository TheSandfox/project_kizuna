			call s__Effect_setPosition(this,sc__Object__get_x(s__AttatchedEffect_target[this]) , sc__Object__get_y(s__AttatchedEffect_target[this]) , sc__Object__get_z(s__AttatchedEffect_target[this]))
  endfunction

  function s__AttatchedEffect_create takes string path,integer target returns integer
   local integer this= s__AttatchedEffect__allocate(path , sc__Object__get_x(target) , sc__Object__get_y(target) , sc__Object__get_z(target) , 270.)
			set s__AttatchedEffect_target[this]=target
			set s__AttatchedEffect_attatch_timer[this]=s__Timer_new(this)
			call TimerStart((s__AttatchedEffect_attatch_timer[this] ), (( TIMER_TICK )*1.0), ( true ), ( function s__AttatchedEffect_timerAction)) // INLINED!!
			return this
  endfunction

