			endif
			set diff=(s__Unit_prototype_maxmp_true[(this)]) - (s__Unit_prototype_mp_true[(this)]) // INLINED!!
			call s__Summon_setDuration(this,(LoadReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((ENUM_STAT_MAXMP ) * ENUM_STAT_INDEX_SIZE + ( ENUM_STAT_INDEX_BASE)))) + r) // INLINED!!
