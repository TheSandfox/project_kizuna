  function s__Missile_carculateDamage takes integer this,real v returns nothing
			set EVT_CARCULATE_DAMAGE_AMOUNT=v
			call s__Event_activate(ENUM_EVENT_CARCULATE_DAMAGE)
			set s__Missile_damage[this]=( ( ( EVT_CARCULATE_DAMAGE_AMOUNT + EVT_CARCULATE_DAMAGE_PLUS ) * EVT_CARCULATE_DAMAGE_MULTIPLY ) / EVT_CARCULATE_DAMAGE_DIVIDE ) - EVT_CARCULATE_DAMAGE_MINUS
			set EVT_CARCULATE_DAMAGE_AMOUNT=0.
  endfunction

