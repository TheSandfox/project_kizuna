  function s__Hellgate___actor_onComplete takes integer this returns nothing
			call sc__Unit_prototype__set_hp((s__Actor_actor[(this)]),1.) // INLINED!!
			call sc__Unit_prototype_plusStatus((s__Actor_actor[(this)]),CONFIG_STATUS_DEAD) // INLINED!!
			call IssueImmediateOrder(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))], ("stop")) // INLINED!!
			call sc__Effect_setScale(sc__Effect_setDuration(sc__Effect_create(s__Hellgate___actor_EFFECT_PATH1 , sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , 0. , 270.),1.5),2.) // INLINED!!
			call sc__Effect_setScale(sc__Effect_setDuration(sc__Effect_create(s__Hellgate___actor_EFFECT_PATH2 , sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , 0. , 270.),1.5),2.) // INLINED!!
  endfunction

  function s__Hellgate___actor_create takes integer caster,real x,real y returns integer
   local integer this= s__Hellgate___actor__allocate(caster , 0 , x , y , 0 , 4. , true)
			set s__UnitActor_suspend_rclick[this]=true
			set s__UnitActor_suspend_stop[this]=true
			set s__Actor_progress_bar[this]=sc__ProgressBar_create("지옥문을 들여다보기" , (GetOwningPlayer(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))]))) // INLINED!!
			call SetUnitFacing(s__Unit_prototype_origin_unit[(s__Actor_actor[(this)])], sc__Math_anglePoints(sc__Object__get_x((s__Actor_actor[(this)])) , sc__Object__get_y((s__Actor_actor[(this)])) , sc__Actor__get_x(this) , sc__Actor__get_y(this))) // INLINED!!
			return this
  endfunction



  function s__Hellgate_onInteract takes integer this,integer caster returns nothing
			call s__Hellgate___actor_create(caster , sc__Object__get_x(this) , sc__Object__get_y(this))
  endfunction

  function s__Hellgate_create takes real x,real y,real yaw,integer index returns integer
   local integer this= s__Hellgate__allocate('D000' + index , x , y , yaw)
			return this
  endfunction

  function s__Hellgate_init takes nothing returns nothing
			call s__Hellgate_create(GetRectMinX(gg_rct_GateWest) - 128 , GetRectCenterY(gg_rct_GateWest) , 0. , 0)
			call s__Hellgate_create(GetRectMaxX(gg_rct_GateEast) + 128 , GetRectCenterY(gg_rct_GateEast) , 180. , 2)
			call s__Hellgate_create(GetRectCenterX(gg_rct_GateNorth) , GetRectMaxY(gg_rct_GateNorth) + 128 , 270. , 3)
			call s__Hellgate_create(GetRectCenterX(gg_rct_GateSouth) , GetRectMinY(gg_rct_GateSouth) - 128 , 90. , 1)
  endfunction



