  function s__Buff20o0_main_relativeTooltip takes integer this returns string
			return "공격속도와 기본공격 피해량이 증가한 대신 적 공격 시 체력을 잃습니다."
  endfunction

  function s__Buff20o0_main_getAdditionalDamage takes integer this returns real
			return s__Unit_prototype_getCalculatedStatValue(s__Buff_target[this],Buff20o0_DAMAGE_STAT1) * Buff20o0_DAMAGE_AMPLIFIER1 * ( 1 + Buff20o0_DAMAGE_PER_LEVEL * ( s__Buff_level[this] ) )
  endfunction

  function s__Buff20o0_main_reduceHP takes integer this,real val returns nothing
   local real th= s__Unit_prototype_getCalculatedStatValue(s__Buff_target[this],Buff20o0_DAMAGE_STAT1) * Buff20o0_DATA_REAL3
			if (s__Unit_prototype_hp_true[(s__Buff_target[this])]) <= th then // INLINED!!
				return
			endif
			if (s__Unit_prototype_hp_true[(s__Buff_target[this])]) - val <= th then // INLINED!!
				call s__Unit_prototype__set_hp(s__Buff_target[this],th)
			else
				call s__Unit_prototype__set_hp(s__Buff_target[this],(s__Unit_prototype_hp_true[(s__Buff_target[this])]) - val) // INLINED!!
			endif
  endfunction

  function s__Buff20o0_main_cond takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if (udg_EVENT_VALUE) == ENUM_EVENT_DAMAGE_MODIFY then // INLINED!!
				if EVT_DAMAGE_ATTACKER != s__Buff_target[this] then
					return
				endif
				if EVT_DAMAGE_ATTACK_TYPE == s__Damage_ATTACK_TYPE_BASIC then
					set EVT_DAMAGE_PLUS=EVT_DAMAGE_PLUS + s__Buff20o0_main_getAdditionalDamage(this)
					call s__Buff20o0_main_reduceHP(this,s__Unit_prototype_getCalculatedStatValue(s__Buff_target[this],Buff20o0_DAMAGE_STAT1) * Buff20o0_DATA_REAL2)
				endif
			elseif (udg_EVENT_VALUE) == ENUM_EVENT_WEAPON_CHANGE then // INLINED!!
				if EVT_WEAPON_CHANGE_UNIT != s__Buff_target[this] then
					return
				endif
				if EVT_WEAPON_CHANGE_OLD != EVT_WEAPON_CHANGE_NEW then
					call sc__Buff_deallocate(this)
				endif
			endif
  endfunction

  function s__Buff20o0_main_update takes integer this returns boolean
			return true
  endfunction

  function s__Buff20o0_main_init takes integer this returns boolean
			call s__Buff_addEffect(this,s__Effect_createAttatched(s__Buff20o0_main_EFFECT_PATH1 , s__Unit_prototype_origin_unit[s__Buff_target[this]] , "overhead"))
			call s__Unit_prototype_plusStatValue(s__Buff_target[this],ENUM_STAT_ATTACK_SPEED , Buff20o0_DATA_REAL1)
			set s__Buff20o0_main_main_trigger[this]=s__Trigger_new(this)
			set s__Buff20o0_main_main_cond[this]=TriggerAddCondition(s__Buff20o0_main_main_trigger[this], Condition(function s__Buff20o0_main_cond))
			call TriggerRegisterVariableEvent((s__Buff20o0_main_main_trigger[this] ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_DAMAGE_MODIFY)*1.0)) // INLINED!!
			call TriggerRegisterVariableEvent((s__Buff20o0_main_main_trigger[this] ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_WEAPON_CHANGE)*1.0)) // INLINED!!
			return true
  endfunction

  function s__Buff20o0_main_onDestroy takes integer this returns nothing
			call s__Unit_prototype_plusStatValue(s__Buff_target[this],ENUM_STAT_ATTACK_SPEED , - Buff20o0_DATA_REAL1)
//textmacro instance: destroyTriggerAndCondition(".main_trigger",".main_cond")
		call TriggerRemoveCondition(s__Buff20o0_main_main_trigger[this], s__Buff20o0_main_main_cond[this])
