   function Buff3010__cond takes nothing returns nothing
				if BUFF_CREATE_TARGET > 0 then
					set BUFF_LAST_CREATED=s__Buff3010_main__allocate(BUFF_CREATE_ID , BUFF_CREATE_CASTER , BUFF_CREATE_TARGET , BUFF_CREATE_LEVEL , BUFF_CREATE_DURATION , Buff3010_NAME)
				endif
			endfunction

   function Buff3010__setFlag takes nothing returns nothing
				set BUFF_CREATE_ID=Buff3010_ID
				set BUFF_CREATE_INDIVISUAL=Buff3010_INDIVISUAL
				set BUFF_CREATE_POSITIVE=Buff3010_POSITIVE
				set BUFF_CREATE_ICON_PATH=Buff3010_ICON_PATH
				set BUFF_CREATE_DISPLAY=Buff3010_DISPLAY
			endfunction

   function Buff3010__init takes nothing returns nothing
				
    local trigger t= CreateTrigger()
				call TriggerAddCondition(t, Condition(function Buff3010__cond))
				call SaveTriggerHandle(BUFF_CREATE_HASH, Buff3010_ID, BUFF_HASH_INDEX_TRIGGER, t)
				
				set t=CreateTrigger()
				call TriggerAddCondition(t, Condition(function Buff3010__setFlag))
				call SaveTriggerHandle(BUFF_CREATE_HASH, Buff3010_ID, BUFF_HASH_INDEX_TRIGGER + 1, t)
				
				call SaveStr(BUFF_CREATE_HASH, Buff3010_ID, BUFF_HASH_INDEX_ICON_PATH, Buff3010_ICON_PATH)
				














				










				set t=null
			endfunction

