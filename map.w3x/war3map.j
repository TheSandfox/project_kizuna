				set BUFF_CREATE_POSITIVE=Buff2000_POSITIVE
				set BUFF_CREATE_ICON_PATH=Buff2000_ICON_PATH
				set BUFF_CREATE_DISPLAY=Buff2000_DISPLAY
			endfunction

   function Buff2000__init takes nothing returns nothing
				
    local trigger t= CreateTrigger()
				call TriggerAddCondition(t, Condition(function Buff2000__cond))
				call SaveTriggerHandle(BUFF_CREATE_HASH, Buff2000_ID, BUFF_HASH_INDEX_TRIGGER, t)
				
				set t=CreateTrigger()
				call TriggerAddCondition(t, Condition(function Buff2000__setFlag))
				call SaveTriggerHandle(BUFF_CREATE_HASH, Buff2000_ID, BUFF_HASH_INDEX_TRIGGER + 1, t)
				
				call SaveStr(BUFF_CREATE_HASH, Buff2000_ID, BUFF_HASH_INDEX_ICON_PATH, Buff2000_ICON_PATH)
				














				










				set t=null
			endfunction

