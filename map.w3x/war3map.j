  function s__CloseUI_close takes integer this,integer order returns nothing
			if order == s__CloseUI_ORDER_NUMBERPAD then
				call s__Numberpad_close((this))
				return
			endif
			if order == s__CloseUI_ORDER_STAT_INDICATOR then
				call s__StatIndicator_close((this))
				return
			endif
			if order == s__CloseUI_ORDER_SLOT_CHANGER then
				call sc__SlotChanger_close((this))
				return
			endif
			if order == s__CloseUI_ORDER_POWERUP_UI then
				call sc__PowerupUI_close((this))
				return
			endif
			if order == s__CloseUI_ORDER_WARP then
				call s__WarpUI_close((this))
			endif
  endfunction

  function s__CloseUI_act takes nothing returns nothing
   local integer this= GetPlayerId(GetTriggerPlayer())
			call s__CloseUI_close(this,s__Array_getValue(s__CloseUI_list[this],(LoadInteger(Hash___D, (((s__CloseUI_list[this]))), (s__Array_P_SIZE))) - 1)) // INLINED!!
  endfunction

  function s__CloseUI_create takes player p returns integer
   local integer this= GetPlayerId(p)
			call BlzTriggerRegisterPlayerKeyEvent(s__CloseUI_ESC_TRIGGER, p, OSKEY_ESCAPE, 0, true)
			set s__CloseUI_list[this]=s__Array_create()
			return this
  endfunction

  function s__CloseUI_onInit takes nothing returns nothing
			set s__CloseUI_ESC_TRIGGER=CreateTrigger()
			call TriggerAddCondition(s__CloseUI_ESC_TRIGGER, Condition(function s__CloseUI_act))
  endfunction



