		call BlzTriggerRegisterFrameEvent(s__StatIndicator_KEYPRESS, s__StatIndicator_CLOSE, FRAMEEVENT_CONTROL_CLICK)
		call BlzTriggerRegisterFrameEvent(s__StatIndicator_KEYPRESS, s__StatIndicator_CLOSE, FRAMEEVENT_MOUSE_LEAVE)
