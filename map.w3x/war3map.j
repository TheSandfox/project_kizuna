  function s__Buff10v0_main_addValue takes integer this returns nothing
   local real r= s__Unit_prototype_getCalculatedStatValue(s__Buff_caster[this],Buff10v0_DAMAGE_STAT1) * Buff10v0_DAMAGE_AMPLIFIER1 * ( 1 + Buff10v0_DAMAGE_PER_LEVEL * s__Buff_level[this] )
