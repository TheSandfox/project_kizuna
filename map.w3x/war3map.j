 endfunction

 function s__Boss_BossB000__rockexplosion_executeExplosion takes integer this,integer target returns nothing
		call s__Buff_addWithValue(s__Explosion_owner[this] , target , 'Slow' , 0 , 0.5 , 90)
		
		if s__Boss_BossB000__rockexplosion_strong[this] then
			set s__Explosion_damage[this]=s__Unit_prototype_getCarculatedStatValue(s__Explosion_owner[this],CONFIG_STAT_ATTACK) * 1.0 + (s__Unit_prototype_maxhp_true[(target)]) * 0.5 // INLINED!!
			
			if s__Math_distancePoints(s__Explosion_x[this] , s__Explosion_y[this] , sc__Object__get_x(target) , sc__Object__get_y(target)) <= 50. then
				call s__SpinningKnockback_create(target , 0 , 0 , 550. , 3. , 0.5)
			
			else
				call s__SpinningKnockback_create(target , 300. , s__Math_anglePoints(s__Explosion_x[this] , s__Explosion_y[this] , sc__Object__get_x(target) , sc__Object__get_y(target)) , 550. , 3. , 0.5)
			endif
			
			call s__Buff_add(0 , target , 'Stun' , 0 , 0.5)
		
		else
			set s__Explosion_damage[this]=s__Unit_prototype_getCarculatedStatValue(s__Explosion_owner[this],CONFIG_STAT_ATTACK) * 1.0 + (s__Unit_prototype_maxhp_true[(target)]) * 0.33 // INLINED!!
		endif
		call s__Explosion_damageTarget(this,target)
 endfunction

