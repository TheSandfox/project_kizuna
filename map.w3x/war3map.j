   function s__Ability20h0_main_setState takes integer this,boolean flag returns nothing
				if flag then
					
					
					set s__Ability_prototype_useable_cast[this]=true
					set s__Ability_prototype_manacost[this]=0
					set s__Ability_prototype_is_target[this]=false
					set s__Ability_prototype_cast_range[this]=- 1
					set s__Ability_prototype_activate_event[this]=false
					set s__Ability_prototype_is_immediate[this]=true
					set s__Ability_prototype_icon[this]=Ability20h0__ICON_PATH2
					set s__Ability_prototype_is_charge[this]=false
					set s__Ability_prototype_is_ride[this]=false
				else
					
					
					set s__Ability_prototype_manacost[this]=Ability20h0__MANACOST
					set s__Ability_prototype_useable_cast[this]=false
					set s__Ability_prototype_is_target[this]=true
					set s__Ability_prototype_cast_range[this]=600.
					set s__Ability_prototype_activate_event[this]=true
					set s__Ability_prototype_is_immediate[this]=false
					set s__Ability_prototype_icon[this]=s__Ability_getTypeIconPath(s__Ability_prototype_id[this])
					set s__Ability_prototype_is_charge[this]=true
					set s__Ability_prototype_is_ride[this]=true
					//
					set s__Ability20h0_main_ride[this]=0
				endif
				set s__Ability20h0_main_state[this]=flag
				set EVT_UI_REFRESH_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])])) // INLINED!!
				set EVT_UI_REFRESH_SLOT=- 1
