  local integer this= s__Boss_BossB000__rollingstone__allocate(caster , 0 , 0. , 0. , 0 , s__Boss_BossB000__rollingstone_DELAY1 , true)
  local integer ps= 0
  local real tx= 0.
  local real ty= 0.
  local real ta= s__Math_anglePoints(sc__Object__get_x(caster) , sc__Object__get_y(caster) , sc__Object__get_x(target) , sc__Object__get_y(target))
		
