					set CUSTOM_RESPOND_DAMAGE_MULTIPLY=CUSTOM_RESPOND_DAMAGE_MULTIPLY + Ability10r0__DAMAGE_BASE + Ability10r0__DAMAGE_PER_LEVEL * s__Ability_prototype_level[this]
					return
