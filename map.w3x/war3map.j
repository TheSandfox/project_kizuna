			set s__MeleeAttack_aoe_type[this]=s__Damage_AOE_TYPE_NONAOE
			set s__MeleeAttack_onhit_type[this]=s__Damage_ONHIT_TYPE_NONHIT
			set s__MeleeAttack_range_type[this]=s__Damage_RANGE_TYPE_MELEE
