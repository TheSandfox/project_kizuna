 function s__StatIcon_refresh takes integer this returns nothing
  local real r= 0.
  local real r2= 0.
  local string col= ""
  local string tooltip= ""
		// call BJDebugMsg("옹")
		set r=s__Unit_prototype_getCarculatedStatValue(s__StatIcon_target[this],s__StatIcon_stat_index[this]) - s__Unit_prototype_getPureStatValue(s__StatIcon_target[this],s__StatIcon_stat_index[this])
		if r <= - 0.01 then
			
			set col="|cffff0000"
		elseif r >= 0.01 then
			
			set col="|cff00ff00"
		else
			
			set col="|cffffcc00"
		endif
		
		if GetLocalPlayer() == s__StatIcon_owner[this] then
			if s__StatIcon_format[this] == 0 then
				
				call BlzFrameSetText(s__s__StatIcon_TEXT[s__StatIcon_index[this]], col + I2S(MathRound(s__Unit_prototype_getCarculatedStatValue(s__StatIcon_target[this],s__StatIcon_stat_index[this]))) + "|r")
			elseif s__StatIcon_format[this] == 1 then
				
				call BlzFrameSetText(s__s__StatIcon_TEXT[s__StatIcon_index[this]], col + R2SW(s__Unit_prototype_getCarculatedStatValue(s__StatIcon_target[this],s__StatIcon_stat_index[this]), 1, 1) + "|r")
			elseif s__StatIcon_format[this] == 2 then
				
				call BlzFrameSetText(s__s__StatIcon_TEXT[s__StatIcon_index[this]], col + I2S(MathRound(s__Unit_prototype_getCarculatedStatValue(s__StatIcon_target[this],s__StatIcon_stat_index[this]) * 100.)) + "%|r")
			endif
		endif
		
		if GetLocalPlayer() == s__StatIcon_owner[this] then
			
			if s__StatIcon_stat_index[this] == CONFIG_STAT_ATTACK then
				
				set tooltip=" - 일부 공격의 피해량이 증가합니다."
			elseif s__StatIcon_stat_index[this] == CONFIG_STAT_MAGICPOWER then
				
				set tooltip=" - 일부 공격의 피해량이 증가합니다."
			elseif s__StatIcon_stat_index[this] == CONFIG_STAT_ACCURACY then
				
				set tooltip=" - 대상에게 입힐 수 있는 최소피해가 증가합니다.\n대상의 " + CUSTOM_STRING_STAT_COLOR[CONFIG_STAT_EVASION] + CUSTOM_STRING_STAT_NAME[CONFIG_STAT_EVASION] + "|r에 따라 감소할 수 있습니다."
			elseif s__StatIcon_stat_index[this] == CONFIG_STAT_EVASION then
				
				set tooltip=" - 다른 대상에게 받을 수 있는 최소피해가 감소합니다.\n대상의 " + CUSTOM_STRING_STAT_COLOR[CONFIG_STAT_ACCURACY] + CUSTOM_STRING_STAT_NAME[CONFIG_STAT_ACCURACY] + "|r에 따라 증가할 수 있습니다."
			elseif s__StatIcon_stat_index[this] == CONFIG_STAT_LOVE then
				
				set r2=s__Unit_prototype_getCarculatedStatValue(s__StatIcon_target[this],CONFIG_STAT_LOVE)
				if r2 >= 0. then
					
					set r=( ( 100.0 + r2 ) / 100.0 ) - 1.0
					set r2=1.0 - ( 100.0 / ( 100.0 + r2 ) )
				else
					
					set r=( 100.0 / ( 100.0 + r2 ) ) - 1.0
					set r2=0.0
				endif
				set tooltip=" - 다른 대상과 주고받는 회복 및 보호막 양이 " + CUSTOM_STRING_STAT_COLOR[CONFIG_STAT_LOVE] + R2SW(r * 100, 2, 2) + "%|r 증가합니다.(곱적용)\n - 다른 대상에게 주는 피해가 " + CUSTOM_STRING_STAT_COLOR[CONFIG_STAT_LOVE] + R2SW(r2 * 100, 2, 2) + "%|r 감소합니다.(곱적용)"
			else

			endif
			
			call BlzFrameSetText(s__s__StatIcon_TOOLTIP_TEXT[s__StatIcon_index[this]], CUSTOM_STRING_STAT_COLOR[s__StatIcon_stat_index[this]] + CUSTOM_STRING_STAT_NAME[s__StatIcon_stat_index[this]] + "|r\n\n" + tooltip)
		endif
 endfunction

 function s__StatIcon_setTarget takes integer this,integer nt returns nothing
		set s__StatIcon_target[this]=nt
 endfunction

 function s__StatIcon_initFrames takes integer index,integer stat_index,framehandle parent returns nothing
		set s__s__StatIcon_BACKDROP[index]= BlzCreateFrameByType("BACKDROP", "", parent, "", 0)
		call BlzFrameSetPoint(s__s__StatIcon_BACKDROP[index], FRAMEPOINT_TOPLEFT, parent, FRAMEPOINT_TOPLEFT, (((s__StatIcon_WIDTH)*1.0) / 1800.) * ( index / s__StatIcon_PER_COL ) + (((s__StatIcon_INSET_X)*1.0) / 1800.), - (((s__StatIcon_HEIGHT)*1.0) / 1800.) * ModuloInteger(index, s__StatIcon_PER_COL) + (((s__StatIcon_INSET_Y)*1.0) / 1800.)) // INLINED!!
		call BlzFrameSetTexture(s__s__StatIcon_BACKDROP[index], CUSTOM_STRING_STAT_ICON[stat_index], 0, true)
		call BlzFrameSetSize(s__s__StatIcon_BACKDROP[index], (((s__StatIcon_HEIGHT - 8)*1.0) / 1800.), (((s__StatIcon_HEIGHT - 8)*1.0) / 1800.)) // INLINED!!
		set s__s__StatIcon_TEXT[index]= BlzCreateFrame("MyText", parent, 0, 0)
		call BlzFrameSetPoint(s__s__StatIcon_TEXT[index], FRAMEPOINT_BOTTOMLEFT, s__s__StatIcon_BACKDROP[index], FRAMEPOINT_BOTTOMRIGHT, 0.005, 0.)
		call BlzFrameSetTextAlignment(s__s__StatIcon_TEXT[index], TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_LEFT)
		set s__s__StatIcon_MOUSEOVER[index]= BlzCreateFrameByType("FRAME", "", s__s__StatIcon_BACKDROP[index], "", 0)
		call BlzFrameSetPoint(s__s__StatIcon_MOUSEOVER[index], FRAMEPOINT_BOTTOMRIGHT, s__s__StatIcon_BACKDROP[index], FRAMEPOINT_BOTTOMRIGHT, 0., 0.)
		call BlzFrameSetSize(s__s__StatIcon_MOUSEOVER[index], (((20)*1.0) / 1800.), (((20)*1.0) / 1800.)) // INLINED!!
		set s__s__StatIcon_TOOLTIP_CONTAINER[index]= BlzCreateFrameByType("BACKDROP", "", s__s__StatIcon_MOUSEOVER[index], "", 0)
		call BlzFrameSetPoint(s__s__StatIcon_TOOLTIP_CONTAINER[index], FRAMEPOINT_BOTTOMLEFT, FRAME_ORIGIN, FRAMEPOINT_BOTTOMLEFT, 0.0, 0.0)
		call BlzFrameSetTooltip(s__s__StatIcon_MOUSEOVER[index], s__s__StatIcon_TOOLTIP_CONTAINER[index])
		set s__s__StatIcon_TOOLTIP_BACKDROP[index]= BlzCreateFrameByType("BACKDROP", "", s__s__StatIcon_TOOLTIP_CONTAINER[index], "", 0)
		call BlzFrameSetTexture(s__s__StatIcon_TOOLTIP_BACKDROP[index], "replaceabletextures\\teamcolor\\teamcolor27.blp", 0, true)
		call BlzFrameSetAlpha(s__s__StatIcon_TOOLTIP_BACKDROP[index], 200)
		set s__s__StatIcon_TOOLTIP_TEXT[index]= BlzCreateFrame("MyText", s__s__StatIcon_TOOLTIP_CONTAINER[index], 0, 0)
		call BlzFrameSetText(s__s__StatIcon_TOOLTIP_TEXT[index], "")
		call BlzFrameSetTextAlignment(s__s__StatIcon_TOOLTIP_TEXT[index], TEXT_JUSTIFY_BOTTOM, TEXT_JUSTIFY_LEFT)
		call BlzFrameSetPoint(s__s__StatIcon_TOOLTIP_TEXT[index], FRAMEPOINT_BOTTOMLEFT, s__s__StatIcon_MOUSEOVER[index], FRAMEPOINT_BOTTOMRIGHT, 0.005, 0.005)
		call BlzFrameSetPoint(s__s__StatIcon_TOOLTIP_BACKDROP[index], FRAMEPOINT_BOTTOMLEFT, s__s__StatIcon_TOOLTIP_TEXT[index], FRAMEPOINT_BOTTOMLEFT, - 0.005, - 0.005)
		call BlzFrameSetPoint(s__s__StatIcon_TOOLTIP_BACKDROP[index], FRAMEPOINT_TOPRIGHT, s__s__StatIcon_TOOLTIP_TEXT[index], FRAMEPOINT_TOPRIGHT, 0.005, 0.005)
		set s__s__StatIcon_FLAG_FRAME[index]= true
 endfunction

 function s__StatIcon_create takes framehandle parent,integer stat_index,player owner returns integer
  local integer this= GetPlayerId(owner) * s__StatIcon_COUNTS + s__s__StatIcon_COUNTER[GetPlayerId(owner)]
		set s__StatIcon_owner[this]=owner
		set s__StatIcon_stat_index[this]=stat_index
		set s__StatIcon_index[this]=s__s__StatIcon_COUNTER[GetPlayerId(owner)]
		
		if s__StatIcon_stat_index[this] == CONFIG_STAT_ATTACK_SPEED then
			set s__StatIcon_format[this]=2
		elseif s__StatIcon_stat_index[this] == CONFIG_STAT_HPREGEN or s__StatIcon_stat_index[this] == CONFIG_STAT_MPREGEN or s__StatIcon_stat_index[this] == CONFIG_STAT_ARMOR_PENET or s__StatIcon_stat_index[this] == CONFIG_STAT_MAGIC_PENET then
			set s__StatIcon_format[this]=1
		endif
		
		if not s__s__StatIcon_FLAG_FRAME[s__StatIcon_index[this]] then
			call s__StatIcon_initFrames(s__StatIcon_index[this] , s__StatIcon_stat_index[this] , parent)
		endif
		set s__s__StatIcon_COUNTER[GetPlayerId(owner)]= s__s__StatIcon_COUNTER[GetPlayerId(owner)] + 1
		return this
 endfunction

 function s__StatIcon_get takes integer pid,integer index returns integer
		return pid * s__StatIcon_COUNTS + index
 endfunction

 function s__StatIcon_onInit takes nothing returns nothing
  local integer i= 0
		loop
			exitwhen i >= 32
			set s__s__StatIcon_FLAG_FRAME[i]= false
			set s__s__StatIcon_COUNTER[i]= 0
			set i=i + 1
		endloop
 endfunction



	
	

 function s__StatIndicator_refreshTarget takes integer this,integer target returns nothing
  local integer i= 0
		loop
			exitwhen i >= s__StatIcon_COUNTS
			set s__StatIcon_target[(((this ) * s__StatIcon_COUNTS + ( i)))]=(target) // INLINED!!
			set i=i + 1
		endloop
 endfunction

 function s__StatIndicator_refresh takes integer this returns nothing
  local integer i= 0
		if ( not s__StatIndicator_visible[this] ) then
			return
		endif
		loop
			exitwhen i >= s__StatIcon_COUNTS
			call s__StatIcon_refresh(((this ) * s__StatIcon_COUNTS + ( i))) // INLINED!!
			set i=i + 1
		endloop
 endfunction

 function s__StatIndicator_show takes integer this,boolean flag returns nothing
		if GetLocalPlayer() == Player(this) then
			call BlzFrameSetVisible(s__StatIndicator_parent[this], flag)
		endif
		if s__StatIndicator_visible[this] != flag then
			if flag then
				
				call s__Array_add(s__CloseUI_list[(this)],s__CloseUI_ORDER_STAT_INDICATOR)
			else
				
				call s__Array_eraseFor(s__CloseUI_list[(this)],s__CloseUI_ORDER_STAT_INDICATOR)
			endif
		endif
		set s__StatIndicator_visible[this]=flag
		
		call s__StatIndicator_refresh(this)
 endfunction

 function s__StatIndicator_switch takes integer this returns nothing
		call s__StatIndicator_show(this,not s__StatIndicator_visible[this])
 endfunction

 function s__StatIndicator_close takes integer this returns boolean
		if s__StatIndicator_visible[this] then
			call s__StatIndicator_show(this,false)
			return true
		endif
		return false
 endfunction

 function s__StatIndicator_keypress takes nothing returns nothing
  local integer this= 0
  local player p= GetTriggerPlayer()
		if (udg_EVENT_VALUE) == CONFIG_EVENT_KEYPRESS then // INLINED!!
			set this=GetPlayerId(CUSTOM_RESPOND_KEYPRESS_PLAYER)
			if CUSTOM_RESPOND_KEYPRESS_KEY == OSKEY_C and CUSTOM_RESPOND_KEYPRESS_PRESS then
				call s__StatIndicator_switch(this)
				return
			endif
			return
		endif
		set this=GetPlayerId(p)
		if BlzGetTriggerFrameEvent() == FRAMEEVENT_CONTROL_CLICK then
			
			call DisableTrigger(GetTriggeringTrigger())
			if GetLocalPlayer() == GetTriggerPlayer() then
				call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
				call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
			endif
			call EnableTrigger(GetTriggeringTrigger())
			call s__StatIndicator_close(this)
		elseif BlzGetTriggerFrameEvent() == FRAMEEVENT_MOUSE_LEAVE then
			
			if GetLocalPlayer() == GetTriggerPlayer() then
				call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
				call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
			endif
		else
			
			call s__StatIndicator_switch(this)
		endif
 endfunction

 function s__StatIndicator_initFrame takes framehandle parent returns nothing
		set s__StatIndicator_CLOSE=BlzCreateFrame("GenericCloseButton", parent, 0, 0)
		call BlzFrameSetPoint((s__StatIndicator_CLOSE ), ( FRAMEPOINT_TOPRIGHT ), ( parent ), ( FRAMEPOINT_TOPRIGHT ), (( - 16 )*1.0) / 1800., (( - 16)*1.0) / 1800.) // INLINED!!
 endfunction

 function s__StatIndicator_create takes player p,framehandle parent returns integer
  local integer this= GetPlayerId(p)
		if not s__StatIndicator_INIT_FRAME then
			call s__StatIndicator_initFrame(parent)
			set s__StatIndicator_INIT_FRAME=true
		endif
		//
		
		//1열
		call s__StatIcon_create(parent , CONFIG_STAT_MAXHP , p)
		call s__StatIcon_create(parent , CONFIG_STAT_MAXMP , p)
		call s__StatIcon_create(parent , CONFIG_STAT_ATTACK , p)
