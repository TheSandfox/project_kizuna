  function s__String_refineShop takes string s,boolean flag returns string
			
   local integer i= 0
   local integer l= StringLength(s)
			loop
				exitwhen i >= l
				if SubString(s, i, i + 1) == "#" then
					if flag then
						
						return SubString(s, 0, i)
					else
						
						return SubString(s, i + 1, l)
					endif
				endif
				set i=i + 1
			endloop
			return s
  endfunction

