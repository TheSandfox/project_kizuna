 endfunction

 function s__AbilityIcon_refreshTooltip takes integer this returns nothing
		if s__AbilityIcon_target[this] > 0 and GetLocalPlayer() == s__AbilityIcon_owner[this] then
			
			if (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]]), s__Ability_INDEX_TIER)) > 0 then // INLINED!!
				call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_TEXT[s__AbilityIcon_index[this]], sc__Ability_prototype_relativeTooltip(s__AbilityIcon_target[this],s__Ability_prototype_owner[s__AbilityIcon_target[this]]) + "\n\n|cff00ffff스탯 보너스 : |r")
				
				call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_STAT_BONUS_TEXT1[s__AbilityIcon_index[this]], UDG_STAT_NAME[(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]] ), s__Ability_INDEX_BONUS_STAT + ( 0)))] + " +" + s__CustomString_statStringReal((LoadInteger(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]] ), s__Ability_INDEX_BONUS_STAT + ( 0))) , s__Ability_stat_bonus1[s__AbilityIcon_target[this]] , 1)) // INLINED!!
				call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_STAT_BONUS_TEXT2[s__AbilityIcon_index[this]], UDG_STAT_NAME[(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]] ), s__Ability_INDEX_BONUS_STAT + ( 1)))] + " +" + s__CustomString_statStringReal((LoadInteger(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]] ), s__Ability_INDEX_BONUS_STAT + ( 1))) , s__Ability_stat_bonus2[s__AbilityIcon_target[this]] , 1)) // INLINED!!
				call BlzFrameSetVisible(s__s__AbilityIcon_TOOLTIP_STAT_BONUS_TEXT1[s__AbilityIcon_index[this]], true)
				call BlzFrameSetVisible(s__s__AbilityIcon_TOOLTIP_STAT_BONUS_TEXT2[s__AbilityIcon_index[this]], true)
			else
				call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_TEXT[s__AbilityIcon_index[this]], sc__Ability_prototype_relativeTooltip(s__AbilityIcon_target[this],s__Ability_prototype_owner[s__AbilityIcon_target[this]]))
				call BlzFrameSetVisible(s__s__AbilityIcon_TOOLTIP_STAT_BONUS_TEXT1[s__AbilityIcon_index[this]], false)
				call BlzFrameSetVisible(s__s__AbilityIcon_TOOLTIP_STAT_BONUS_TEXT2[s__AbilityIcon_index[this]], false)
			endif
			
			if (LoadBoolean(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]]), s__Ability_INDEX_IS_WEAPON)) then // INLINED!!
				call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_MANACOST_TEXT[s__AbilityIcon_index[this]], "|cff00ffff" + I2S(R2I(s__Ability_prototype_weapon_range[s__AbilityIcon_target[this]])) + "|r")
				call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_COOLDOWN_TEXT[s__AbilityIcon_index[this]], "|cffffff99" + R2SW(s__Ability_prototype_weapon_delay[s__AbilityIcon_target[this]] / sc__Ability_prototype_getAttackSpeedValue(s__AbilityIcon_target[this],s__Unit_prototype_getCalculatedStatValue(s__Ability_prototype_owner[s__AbilityIcon_target[this]],ENUM_STAT_ATTACK_SPEED)), 2, 2) + "|r")
        
			else
				call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_MANACOST_TEXT[s__AbilityIcon_index[this]], "|cff0099ff" + I2S(R2I(sc__Ability_prototype_getCalculatedManacost(s__AbilityIcon_target[this]))) + "|r")
				call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_COOLDOWN_TEXT[s__AbilityIcon_index[this]], "|cffffff99" + R2SW(s__Ability_prototype_getCalculatedMaxCooldown(s__AbilityIcon_target[this]), 2, 2) + "|r\n|cff999999/" + R2SW(s__Ability_prototype_cooldown_min[s__AbilityIcon_target[this]], 2, 2) + "|r")
			endif
			
			call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_CUSTOM_COST_TEXT[s__AbilityIcon_index[this]], sc__Ability_prototype_customCostTooltip(s__AbilityIcon_target[this]))
		endif
 endfunction

  function s__AbilityIcon_refresh takes integer this returns nothing
    if s__AbilityIcon_target[this] > 0 and GetLocalPlayer() == s__AbilityIcon_owner[this] then
			
			call BlzFrameSetVisible(s__s__AbilityIcon_COOLDOWN_TEXT[s__AbilityIcon_index[this]], s__Ability_prototype_getUICooldown(s__AbilityIcon_target[this]) > 0.)
			call BlzFrameSetVisible(s__s__AbilityIcon_COOLDOWN_TEXT_BACKDROP[s__AbilityIcon_index[this]], s__Ability_prototype_getUICooldown(s__AbilityIcon_target[this]) > 0.)
			call BlzFrameSetVisible(s__s__AbilityIcon_COOLDOWN_BACKDROP[s__AbilityIcon_index[this]], s__Ability_prototype_getUICooldown(s__AbilityIcon_target[this]) > 0. and s__Ability_prototype_getCalculatedMaxCooldown(s__AbilityIcon_target[this]) > 0.)
			call BlzFrameSetText(s__s__AbilityIcon_COOLDOWN_TEXT[s__AbilityIcon_index[this]], R2SW(s__Ability_prototype_getUICooldown(s__AbilityIcon_target[this]), 1, 1))
			if sc__Ability_prototype_getCount(s__AbilityIcon_target[this]) == 0 then
				call BlzFrameSetAlpha(s__s__AbilityIcon_COOLDOWN_BACKDROP[s__AbilityIcon_index[this]], 128)
			else
				call BlzFrameSetAlpha(s__s__AbilityIcon_COOLDOWN_BACKDROP[s__AbilityIcon_index[this]], 32)
			endif
			if s__Ability_prototype_getCalculatedMaxCooldown(s__AbilityIcon_target[this]) > 0. then
				call BlzFrameSetPoint(s__s__AbilityIcon_COOLDOWN_BACKDROP[s__AbilityIcon_index[this]], FRAMEPOINT_TOPRIGHT, s__s__AbilityIcon_ICON_BACKDROP[s__AbilityIcon_index[this]], FRAMEPOINT_BOTTOMRIGHT, 0., (((UI__ABILITY_ICON_SIZE)*1.0) / 1800.) * ( s__Ability_prototype_getUICooldown(s__AbilityIcon_target[this]) / s__Ability_prototype_getCalculatedMaxCooldown(s__AbilityIcon_target[this]) )) // INLINED!!
			endif
			
			call BlzFrameSetVisible(s__s__AbilityIcon_DISABLED_BACKDROP[s__AbilityIcon_index[this]], not ( s__Ability_prototype_enableFilter(s__AbilityIcon_target[this]) and sc__Ability_prototype_useFilterAdditional(s__AbilityIcon_target[this]) ))
			
			call BlzFrameSetVisible(s__s__AbilityIcon_NEM_BACKDROP[s__AbilityIcon_index[this]], (s__Unit_prototype_mp_true[(s__Ability_prototype_owner[s__AbilityIcon_target[this]])]) < sc__Ability_prototype_getCalculatedManacost(s__AbilityIcon_target[this])) // INLINED!!
			
			call BlzFrameSetVisible(s__s__AbilityIcon_EXTRA_BACKDROP[s__AbilityIcon_index[this]], s__Ability_prototype_count_max[s__AbilityIcon_target[this]] > 1)
			call BlzFrameSetVisible(s__s__AbilityIcon_EXTRA_TEXT[s__AbilityIcon_index[this]], s__Ability_prototype_count_max[s__AbilityIcon_target[this]] > 1)
			call BlzFrameSetText(s__s__AbilityIcon_EXTRA_TEXT[s__AbilityIcon_index[this]], I2S(s__Ability_prototype_count[s__AbilityIcon_target[this]]))
			
			call BlzFrameSetVisible(s__s__AbilityIcon_GAUGE_BACKDROP[s__AbilityIcon_index[this]], s__Ability_prototype_gauge[s__AbilityIcon_target[this]] > 0.)
			call BlzFrameSetPoint(s__s__AbilityIcon_GAUGE_FILL[s__AbilityIcon_index[this]], FRAMEPOINT_BOTTOMRIGHT, s__s__AbilityIcon_GAUGE_BACKDROP[s__AbilityIcon_index[this]], FRAMEPOINT_BOTTOMLEFT, (((UI__ABILITY_ICON_SIZE)*1.0) / 1800.) * s__Ability_prototype_gauge[s__AbilityIcon_target[this]], 0) // INLINED!!
    endif
  endfunction

 function s__AbilityIcon_showTooltip takes integer this,boolean flag returns nothing
		if GetLocalPlayer() == s__AbilityIcon_owner[this] then
			call BlzFrameSetVisible(s__s__AbilityIcon_TOOLTIP_CONTAINER[s__AbilityIcon_index[this]], flag)
      if flag then
        call s__AbilityIcon_refreshTooltip(this)
      endif
		endif
 endfunction

  function s__AbilityIcon_setTarget takes integer this,integer na returns nothing
    local integer i= 0
    local integer j= 0
    local string s= "|cffffff00"
    set s__AbilityIcon_target[this]=na
    if GetLocalPlayer() == s__AbilityIcon_owner[this] then
      
      call BlzFrameSetVisible(s__s__AbilityIcon_ICON_CONTAINER[s__AbilityIcon_index[this]], s__AbilityIcon_target[this] > 0)
    endif
    if s__AbilityIcon_target[this] > 0 then
      if GetLocalPlayer() == s__AbilityIcon_owner[this] then
        
        call BlzFrameSetTexture(s__s__AbilityIcon_ICON_BACKDROP[s__AbilityIcon_index[this]], s__Ability_prototype_icon[s__AbilityIcon_target[this]], 0, true)
        if s__Ability_prototype_is_active[s__AbilityIcon_target[this]] then
          call BlzFrameSetVisible(s__s__AbilityIcon_ICON_BORDER[s__AbilityIcon_index[this]], true)
					call BlzFrameSetTexture(s__s__AbilityIcon_ICON_BORDER[s__AbilityIcon_index[this]], "ReplaceableTextures\\CommandButtons\\bm_btn.blp", 0, true)
        else
          call BlzFrameSetVisible(s__s__AbilityIcon_ICON_BORDER[s__AbilityIcon_index[this]], true)
          call BlzFrameSetTexture(s__s__AbilityIcon_ICON_BORDER[s__AbilityIcon_index[this]], "ReplaceableTextures\\CommandButtons\\bm_pasbtn.blp", 0, true)
        endif
        call BlzFrameSetTexture(s__s__AbilityIcon_TOOLTIP_ICON[s__AbilityIcon_index[this]], s__Ability_prototype_icon[s__AbilityIcon_target[this]], 0, true)
        call BlzFrameSetTexture(s__s__AbilityIcon_TOOLTIP_ICON_BORDER[s__AbilityIcon_index[this]], "Textures\\ability_border_tier" + I2S((LoadInteger(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]]), s__Ability_INDEX_TIER))) + ".blp", 0, true) // INLINED!!
				
				if (LoadBoolean(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]]), s__Ability_INDEX_IS_WEAPON)) then // INLINED!!
					call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_DETAIL[s__AbilityIcon_index[this]], "|cff999999Shift : 자세히 보기\nCtrl + 단축키 : 장착 해제|r")
				else
					call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_DETAIL[s__AbilityIcon_index[this]], "|cff999999Shift : 자세히 보기\nCtrl + 단축키 : 빠른 시전(스마트캐스트) 설정 변경|r")
				endif
        
				if (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]]), s__Ability_INDEX_TIER)) > 0 then // INLINED!!
          call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_NAME[s__AbilityIcon_index[this]], UDG_TIER_COLOR[(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]]), s__Ability_INDEX_TIER))] + s__Ability_prototype_name[s__AbilityIcon_target[this]] + "|r |cffffff00Lv. " + I2S(s__Ability_prototype_level[s__AbilityIcon_target[this]]) + "|r|cff999999/" + I2S(s__Ability_level_max[s__AbilityIcon_target[this]]) + "|r") // INLINED!!
				else
					call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_NAME[s__AbilityIcon_index[this]], UDG_TIER_COLOR[0] + s__Ability_prototype_name[s__AbilityIcon_target[this]] + "|r")
				endif
        
        if (LoadBoolean(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]]), s__Ability_INDEX_IS_WEAPON)) then // INLINED!!
					
          call BlzFrameSetText(s__s__AbilityIcon_HOTKEY_TEXT[s__AbilityIcon_index[this]], "|cffcc0000" + UDG_ABILITY_SLOT_NAME[s__AbilityIcon_index[this]] + "|r")
        else
          if (s__Ability_prototype_smart_true[(s__AbilityIcon_target[this])]) == 0 then // INLINED!!
            call BlzFrameSetText(s__s__AbilityIcon_HOTKEY_TEXT[s__AbilityIcon_index[this]], "|cff999999" + UDG_ABILITY_SLOT_NAME[s__AbilityIcon_index[this]] + "|r")
          elseif (s__Ability_prototype_smart_true[(s__AbilityIcon_target[this])]) == 1 then // INLINED!!
            call BlzFrameSetText(s__s__AbilityIcon_HOTKEY_TEXT[s__AbilityIcon_index[this]], "|cffffcc00" + UDG_ABILITY_SLOT_NAME[s__AbilityIcon_index[this]] + "|r")
          elseif (s__Ability_prototype_smart_true[(s__AbilityIcon_target[this])]) == 2 then // INLINED!!
            call BlzFrameSetText(s__s__AbilityIcon_HOTKEY_TEXT[s__AbilityIcon_index[this]], "|cff00ffff" + UDG_ABILITY_SLOT_NAME[s__AbilityIcon_index[this]] + "|r")
          endif
        endif
        
        call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_CASTTYPE[s__AbilityIcon_index[this]], "|cff00ffff" + UDG_CAST_TYPE_NAME[(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]]), s__Ability_INDEX_CAST_TYPE))] + "|r") // INLINED!!
        
        call BlzFrameSetVisible(s__s__AbilityIcon_WEAPON_PARTICLE[s__AbilityIcon_index[this]], s__AbilityIcon_target[this] == s__UnitPrototype__AbilityData_getWeaponAbility(s__Unit_prototype_ability_data[s__Ability_prototype_owner[s__AbilityIcon_target[this]]]))
        
        if (LoadBoolean(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]]), s__Ability_INDEX_IS_WEAPON)) then // INLINED!!
          call BlzFrameSetVisible(s__s__AbilityIcon_TOOLTIP_ICON_WEAPON[s__AbilityIcon_index[this]], true)
          call BlzFrameSetTexture(s__s__AbilityIcon_TOOLTIP_MANACOST_BACKDROP[s__AbilityIcon_index[this]], UDG_STAT_ICON[ENUM_STAT_ATTACK_RANGE], 0, true)
        else
          call BlzFrameSetVisible(s__s__AbilityIcon_TOOLTIP_ICON_WEAPON[s__AbilityIcon_index[this]], false)
          call BlzFrameSetTexture(s__s__AbilityIcon_TOOLTIP_MANACOST_BACKDROP[s__AbilityIcon_index[this]], UDG_STAT_ICON[ENUM_STAT_MAXMP], 0, true)
        endif
      endif
      
      loop
        set j=s__DamageTag_get(s__Ability_prototype_id[s__AbilityIcon_target[this]] , i)
        exitwhen j < 0
        if i > 0 then
          set s=s + ", " + UDG_ABILITY_TAG_NAME[j]
        else
          set s=s + UDG_ABILITY_TAG_NAME[j]
        endif
        set i=i + 1
      endloop
      set s=s + "|r"
      if GetLocalPlayer() == s__AbilityIcon_owner[this] then
        call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_TAG[s__AbilityIcon_index[this]], s)
        
				call BlzFrameSetVisible(s__s__AbilityIcon_TOOLTIP_STAT_BONUS_ICON1[s__AbilityIcon_index[this]], (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]]), s__Ability_INDEX_TIER)) > 0) // INLINED!!
				call BlzFrameSetVisible(s__s__AbilityIcon_TOOLTIP_STAT_BONUS_ICON2[s__AbilityIcon_index[this]], (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]]), s__Ability_INDEX_TIER)) > 0) // INLINED!!
        call BlzFrameSetTexture(s__s__AbilityIcon_TOOLTIP_STAT_BONUS_ICON1[s__AbilityIcon_index[this]], UDG_STAT_ICON[(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]] ), s__Ability_INDEX_BONUS_STAT + ( 0)))], 0, true) // INLINED!!
        call BlzFrameSetTexture(s__s__AbilityIcon_TOOLTIP_STAT_BONUS_ICON2[s__AbilityIcon_index[this]], UDG_STAT_ICON[(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[s__AbilityIcon_target[this]] ), s__Ability_INDEX_BONUS_STAT + ( 1)))], 0, true) // INLINED!!
        
        call BlzFrameSetVisible(s__s__AbilityIcon_UNIQUE[s__AbilityIcon_index[this]], s__Ability_signature[s__AbilityIcon_target[this]])
				call BlzFrameSetVisible(s__s__AbilityIcon_UNIQUE_BACKDROP[s__AbilityIcon_index[this]], s__Ability_signature[s__AbilityIcon_target[this]])
				
				if (LoadInteger(Ability__HASH2, (s__AbilityIcon_target[this]), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_RED))) <= 0 then // INLINED!!
					call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_COST_SPEND_TEXT1[s__AbilityIcon_index[this]], "|cff9999990|r")
				else
					call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_COST_SPEND_TEXT1[s__AbilityIcon_index[this]], "|cffffcc00" + I2S((LoadInteger(Ability__HASH2, (s__AbilityIcon_target[this]), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_RED)))) + "|r") // INLINED!!
				endif
				
				if (LoadInteger(Ability__HASH2, (s__AbilityIcon_target[this]), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_RED))) <= 0 then // INLINED!!
					call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_COST_SPEND_TEXT2[s__AbilityIcon_index[this]], "|cff9999990|r")
				else
					call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_COST_SPEND_TEXT2[s__AbilityIcon_index[this]], "|cffff9900" + I2S((LoadInteger(Ability__HASH2, (s__AbilityIcon_target[this]), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_RED)))) + "|r") // INLINED!!
				endif
				
				if (LoadInteger(Ability__HASH2, (s__AbilityIcon_target[this]), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_GREEN))) <= 0 then // INLINED!!
					call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_COST_SPEND_TEXT3[s__AbilityIcon_index[this]], "|cff9999990|r")
				else
					call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_COST_SPEND_TEXT3[s__AbilityIcon_index[this]], "|cff00cc00" + I2S((LoadInteger(Ability__HASH2, (s__AbilityIcon_target[this]), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_GREEN)))) + "|r") // INLINED!!
				endif
				
				if (LoadInteger(Ability__HASH2, (s__AbilityIcon_target[this]), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_BLUE))) <= 0 then // INLINED!!
					call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_COST_SPEND_TEXT4[s__AbilityIcon_index[this]], "|cff9999990|r")
				else
					call BlzFrameSetText(s__s__AbilityIcon_TOOLTIP_COST_SPEND_TEXT4[s__AbilityIcon_index[this]], "|cff0099cc" + I2S((LoadInteger(Ability__HASH2, (s__AbilityIcon_target[this]), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_BLUE)))) + "|r") // INLINED!!
				endif
      endif
      
      call s__AbilityIcon_refresh(this)
			call s__AbilityIcon_refreshTooltip(this)
      
      if GetLocalPlayer() == s__AbilityIcon_owner[this] then
				call BlzFrameSetVisible(s__s__AbilityIcon_TOOLTIP_MOUSEOVER[s__AbilityIcon_index[this]], true)
			endif
    else
      
      set s__AbilityIcon_mouse_in[this]=false
      
      if GetLocalPlayer() == s__AbilityIcon_owner[this] then
				call BlzFrameSetVisible(s__s__AbilityIcon_TOOLTIP_MOUSEOVER[s__AbilityIcon_index[this]], false)
			endif
    endif
  endfunction

  function s__AbilityIcon_click takes nothing returns nothing
    local integer this= GetPlayerId(GetTriggerPlayer()) * CONFIG_ABILITY_SIZE + (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
    
    if GetTriggerPlayer() != s__AbilityIcon_owner[this] then
      return
    endif
    if BlzGetTriggerFrame() != null and GetLocalPlayer() == s__AbilityIcon_owner[this] then
			if BlzGetTriggerFrameEvent() != FRAMEEVENT_MOUSE_ENTER then
				call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
				call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
			endif
    endif
    if BlzGetTriggerFrameEvent() == FRAMEEVENT_CONTROL_CLICK then
      if s__AbilityIcon_target[this] > 0 then
        call sc__Ability_prototype_iconClick(s__AbilityIcon_target[this])
        call s__AbilityIcon_setTarget(this,s__AbilityIcon_target[this])
        
        set EVT_ABILITY_ICON_CLICK_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[s__AbilityIcon_target[this]])])) // INLINED!!
        set EVT_ABILITY_ICON_CLICK_UNIT=s__Ability_prototype_owner[s__AbilityIcon_target[this]]
        set EVT_ABILITY_ICON_CLICK_ABILITY=s__AbilityIcon_target[this]
        set EVT_ABILITY_ICON_CLICK_SLOT=s__AbilityIcon_index[this]
        call s__Event_activate(ENUM_EVENT_ABILITY_ICON_CLICK)
      endif
      return
    elseif BlzGetTriggerPlayerMouseButton() == MOUSE_BUTTON_TYPE_RIGHT then
      if s__AbilityIcon_mouse_in[this] and s__AbilityIcon_target[this] > 0 then
				call sc__Ability_prototype_iconRightClick(s__AbilityIcon_target[this])
        call s__AbilityIcon_setTarget(this,s__AbilityIcon_target[this])
      endif
    elseif BlzGetTriggerFrameEvent() == FRAMEEVENT_MOUSE_ENTER then
      set s__AbilityIcon_mouse_in[this]=true
			call s__AbilityIcon_showTooltip(this,true)
    elseif BlzGetTriggerFrameEvent() == FRAMEEVENT_MOUSE_LEAVE then
      set s__AbilityIcon_mouse_in[this]=false
			call s__AbilityIcon_showTooltip(this,false)
    endif
  endfunction

  function s__AbilityIcon_initFrames takes integer index,framehandle parent returns nothing
    local framehandle pivot= s__FRAME_ABILITY_ICON[index]
    
    set s__s__AbilityIcon_ICON_CONTAINER[index]= BlzCreateFrameByType("BACKDROP", "", parent, "", 0)
    call BlzFrameSetPoint(s__s__AbilityIcon_ICON_CONTAINER[index], FRAMEPOINT_BOTTOMLEFT, pivot, FRAMEPOINT_BOTTOMLEFT, 0., 0.)
    set s__s__AbilityIcon_ICON_BACKDROP[index]= BlzCreateFrameByType("BACKDROP", "", s__s__AbilityIcon_ICON_CONTAINER[index], "", 0)
    call BlzFrameSetAllPoints(s__s__AbilityIcon_ICON_BACKDROP[index], pivot)
    call BlzFrameSetTexture(s__s__AbilityIcon_ICON_BACKDROP[index], "ReplaceableTextures\\CommandButtons\\BTNBlackIcon.blp", 0, true)
    set s__s__AbilityIcon_ICON_BORDER[index]= BlzCreateFrameByType("BACKDROP", "", s__s__AbilityIcon_ICON_CONTAINER[index], "", 0)
    call BlzFrameSetAllPoints(s__s__AbilityIcon_ICON_BORDER[index], s__s__AbilityIcon_ICON_BACKDROP[index])
    call BlzFrameSetTexture(s__s__AbilityIcon_ICON_BACKDROP[index], "ReplaceableTextures\\CommandButtons\\bm_btn.blp", 0, true)
    call BlzFrameSetVisible(s__s__AbilityIcon_ICON_BORDER[index], false)
		
		set s__s__AbilityIcon_DISABLED_BACKDROP[index]= BlzCreateFrameByType("BACKDROP", "", s__s__AbilityIcon_ICON_CONTAINER[index], "", 0)
		call BlzFrameSetAllPoints(s__s__AbilityIcon_DISABLED_BACKDROP[index], pivot)
		call BlzFrameSetTexture(s__s__AbilityIcon_DISABLED_BACKDROP[index], "ReplaceableTextures\\CommandButtons\\bm_disbtn2.blp", 0, true)
		call BlzFrameSetVisible(s__s__AbilityIcon_DISABLED_BACKDROP[index], false)
		
    set s__s__AbilityIcon_NEM_BACKDROP[index]= BlzCreateFrameByType("BACKDROP", "", s__s__AbilityIcon_ICON_CONTAINER[index], "", 0)
