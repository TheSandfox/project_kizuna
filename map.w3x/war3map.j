//textmacro instance: demonicAllocate("FrameContext_prototype")
 function FrameContext_prototype_demonicAllocate takes nothing returns integer
  local integer this=si__FrameContext_prototype_F
		   if ( this != 0 ) then
			   set si__FrameContext_prototype_F=si__FrameContext_prototype_V[this]
		   else
			   set si__FrameContext_prototype_I=si__FrameContext_prototype_I + 1
			   set this=si__FrameContext_prototype_I
		   endif
		   set si__FrameContext_prototype_type[this]=0
		   set si__FrameContext_prototype_V[this]=- 1
		return this
	endfunction
//end of: demonicAllocate("FrameContext_prototype")






  function s__Frame_resetFocus takes nothing returns nothing
			if GetLocalPlayer() == GetTriggerPlayer() then
				if BlzFrameGetEnable(BlzGetTriggerFrame()) then
					call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
					call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
				endif
			endif
  endfunction

  function s__Frame_addTooltipSimple takes framepointtype pivot,framehandle target,framepointtype relative,string str,real offset_x,real offset_y returns nothing
   local framehandle container= BlzCreateFrameByType("FRAME", "", target, "", 0)
   local framehandle backdrop= BlzCreateFrame("MyTextBox", container, 0, 0)
   local framehandle text= BlzCreateFrame("MyText", container, 0, 0)
   local real x= 0.
   local real y= 0.
			if pivot == FRAMEPOINT_TOPLEFT then
				set x=0.005
				set y=- 0.005
			elseif pivot == FRAMEPOINT_TOP then
				set y=- 0.005
			elseif pivot == FRAMEPOINT_TOPRIGHT then
				set x=- 0.005
				set y=- 0.005
			elseif pivot == FRAMEPOINT_LEFT then
				set x=0.005
			elseif pivot == FRAMEPOINT_RIGHT then
				set x=- 0.005
			elseif pivot == FRAMEPOINT_BOTTOMLEFT then
				set x=0.005
				set y=0.005
			elseif pivot == FRAMEPOINT_BOTTOM then
				set y=0.005
			elseif pivot == FRAMEPOINT_BOTTOMRIGHT then
				set x=- 0.005
				set y=0.005
			endif
			call BlzFrameSetPoint(text, pivot, target, relative, (((offset_x)*1.0) / 1800.) + x, (((offset_y)*1.0) / 1800.) + y) // INLINED!!
			call BlzFrameSetPoint(backdrop, FRAMEPOINT_TOPLEFT, text, FRAMEPOINT_TOPLEFT, - 0.005, 0.005)
			call BlzFrameSetPoint(backdrop, FRAMEPOINT_BOTTOMRIGHT, text, FRAMEPOINT_BOTTOMRIGHT, 0.005, - 0.005)
			call BlzFrameSetText(text, str)
			call BlzFrameSetTooltip(target, container)
			set container=null
			set backdrop=null
			set text=null
  endfunction


 function BlzFrameSetPointPixel takes framehandle frame,framepointtype point,framehandle relative,framepointtype pointrelative,real x,real y returns nothing
		call BlzFrameSetPoint(frame, point, relative, pointrelative, x / 1800., y / 1800.)
	endfunction

 function BlzFrameSetSizePixel takes framehandle frame,real x,real y returns nothing
		call BlzFrameSetSize(frame, x / 1800., y / 1800.)
	endfunction

 function BlzFrameSetAbsPointPixel takes framehandle frame,framepointtype point,real x,real y returns nothing
		call BlzFrameSetAbsPoint(frame, point, x / 1800., y / 1800.)
	endfunction

 function BlzFrameResetFocus takes framehandle frame,player p returns nothing
		if GetLocalPlayer() == p then
			if BlzFrameGetEnable(frame) then
				call BlzFrameSetEnable(frame, false)
				call BlzFrameSetEnable(frame, true)
			endif
		endif
	endfunction

 function Frame__delayedInit takes nothing returns nothing
		call TriggerEvaluate(Frame_TRIGGER_INIT)
		call DestroyTrigger(Frame_TRIGGER_INIT)
		set Frame_TRIGGER_INIT=null
	endfunction

 function Frame__init takes nothing returns nothing
  local integer i= 0
  local trigger t= CreateTrigger()
		set Frame_TRIGGER_INIT=CreateTrigger()
		
		set FRAME_ORIGIN=BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0)
		loop
			exitwhen i >= CONFIG_FRAME_MAX_LEVEL
			set s__FRAME_GAME_UI[i]= BlzCreateFrameByType("FRAME", "GameUI" + I2S(i), FRAME_ORIGIN, "", i)
			set i=i + 1
		endloop
		
		call TriggerRegisterTimerEvent(t, 0., false)
		call TriggerAddCondition(t, Condition(function Frame__delayedInit))
	endfunction


