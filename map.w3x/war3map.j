			set s__Item_prototype_count[this]=s__Item_prototype_count[this] - i
			call s__Item_onUseCount(this,i)
			if s__Item_prototype_count[this] <= 0 then
				call sc__Item_prototype_prototype_deallocate(this)
			endif
  endfunction

