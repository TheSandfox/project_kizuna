    function s__Biome_createLandmark takes integer this returns integer
      if s__Biome_camp_rect[this] == null then
        return 0
      endif
      set s__Biome_landmark[this]=s__Landmark_create('NS00' , GetRectCenterX(s__Biome_camp_rect[this]) , GetRectCenterY(s__Biome_camp_rect[this]))
      return s__Biome_landmark[this]
    endfunction

    function s__Biome_createMonsterCamp takes integer this returns integer
      if s__Biome_camp_rect[this] == null then
        return 0
      endif
      set s__Biome_camp[this]=s__MonsterCamp_create(s__Biome_biome_id[this] , s__Biome_camp_rect[this])
      return s__Biome_camp[this]
    endfunction

    function s__Biome_createWaygate takes integer this,real x,real y returns integer
      local integer newGate= s__Waygate_create(x , y)
      return newGate
    endfunction

    function s__Biome_createWarpDestination takes integer this,real x,real y returns integer
      local integer newDest= s__WarpDestination_create(x , y)
      return newDest
    endfunction

    
    
    function s__Biome_awake takes integer this returns nothing
      set s__Biome_is_awake[this]=true
      
      if s__Biome_camp_rect[this] != null then
        
        call s__Biome_createWarpDestination(this,GetRectCenterX(s__Biome_camp_rect[this]) , GetRectMinY(s__Biome_camp_rect[this]) + 1024)
        
        call s__Biome_createMonsterCamp(this)
      endif
      
      if s__Biome_boss_rect[this] != null then
        
        call s__Biome_createWarpDestination(this,GetRectCenterX(s__Biome_boss_rect[this]) , GetRectMinY(s__Biome_boss_rect[this]) + 1024)
        
      endif
    endfunction

    function s__Biome_initDefault takes integer this returns nothing
      
      if s__Biome_camp_rect[this] != null then
        call s__Biome_createWaygate(this,GetRectMaxX(s__Biome_camp_rect[this]) - 1024 , GetRectMinY(s__Biome_camp_rect[this]) + 1024)
      endif
      if s__Biome_boss_rect[this] != null then
        call s__Biome_createWaygate(this,GetRectMaxX(s__Biome_boss_rect[this]) - 1024 , GetRectMinY(s__Biome_boss_rect[this]) + 1024)
      endif
    endfunction

    function s__Biome_create takes integer biomeId,rect campRect,rect bossRect returns integer
      local integer this= s__Biome__allocate()
      set s__Biome_biome_id[this]=biomeId
      set s__Biome_camp_rect[this]=campRect
      set s__Biome_boss_rect[this]=bossRect
      
      call s__Biome_initDefault(this)
      
      return this
    endfunction

    function s__Biome_init takes nothing returns nothing
      local integer newBiome= 0
      
      call s__Waygate_init()
      call s__MonsterCamp_init()
      call s__MonsterReward_init()
      call s__Landmark_init()
      
      set newBiome=s__Biome_create(ENUM_BIOME_FOREST , UDG_RECT_RECT[ENUM_RECT_12] , UDG_RECT_RECT[ENUM_RECT_7])
			call s__Biome_awake(newBiome)
      set newBiome=s__Biome_create(ENUM_BIOME_STARTER , UDG_RECT_RECT[ENUM_RECT_11] , null)
			call s__Biome_awake(newBiome)
    endfunction



