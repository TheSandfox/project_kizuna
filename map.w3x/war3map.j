  function s__Item_prototype__set_x takes integer this,real v returns nothing
			if s__Item_prototype__get_origin_item(this) != null then
				if v > CONFIG_MAX_X then
					set v=CONFIG_MAX_X
				elseif v < CONFIG_MIN_X then
					set v=CONFIG_MIN_X
				endif
				call SetUnitX(s__Item_prototype__get_origin_item(this), v)
				call BlzSetSpecialEffectPosition(s__Item_prototype_origin_effect[this], s__Item_prototype__get_x(this), s__Item_prototype__get_y(this), s__Item_prototype__get_z(this))
			endif
  endfunction

  function s__Item_prototype__set_y takes integer this,real v returns nothing
			if s__Item_prototype__get_origin_item(this) != null then
				if v > CONFIG_MAX_Y then
