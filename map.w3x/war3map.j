  function s__SkillShopWidget_setTarget takes integer this,integer id returns nothing
   local integer i= 0
   local integer j= 0
   local string s= ""
			set s__SkillShopWidget_id[this]=id
			set s__SkillShopWidget_lucky[this]=false
			if GetLocalPlayer() == s__SkillShopWidget_owner[this] then
				
				call BlzFrameSetEnable(s__SkillShopWidget_BTN[s__SkillShopWidget_index[this]], id > 0)
				call BlzFrameSetVisible(BlzGetFrameByName("SkillShopBuyButtonIcon", s__SkillShopWidget_index[this]), id > 0)
				
				call BlzFrameSetVisible(s__SkillShopWidget_BONUS_STAT1[s__SkillShopWidget_index[this]], id > 0)
				call BlzFrameSetVisible(s__SkillShopWidget_BONUS_STAT2[s__SkillShopWidget_index[this]], id > 0)
			endif
			if id <= 0 then
				if GetLocalPlayer() == s__SkillShopWidget_owner[this] then
					call BlzFrameSetTexture(s__SkillShopWidget_ICON[s__SkillShopWidget_index[this]], "Icons\\BTNBlackIcon.blp", 0, true)
					call BlzFrameSetVisible(s__SkillShopWidget_TIER_BORDER[s__SkillShopWidget_index[this]], false)
					call BlzFrameSetVisible(s__SkillShopWidget_INFO_WEAPON_BACKDROP[s__SkillShopWidget_index[this]], false)
					call BlzFrameSetVisible(s__SkillShopWidget_INFO_LUCKY_BACKDROP[s__SkillShopWidget_index[this]], false)
					call BlzFrameSetVisible(s__SkillShopWidget_INFO_LUCKY_MODEL[s__SkillShopWidget_index[this]], false)
					call BlzFrameSetText(s__SkillShopWidget_NAME[s__SkillShopWidget_index[this]], "")
					call BlzFrameSetText(s__SkillShopWidget_TAG[s__SkillShopWidget_index[this]], "")
					call BlzFrameSetPoint((BlzGetFrameByName("SkillShopBuyButtonText", s__SkillShopWidget_index[this]) ), ( FRAMEPOINT_BOTTOM ), ( s__SkillShopWidget_BTN[s__SkillShopWidget_index[this]] ), ( FRAMEPOINT_BOTTOM ), (( 0 )*1.0) / 1800., (( 24)*1.0) / 1800.) // INLINED!!
					call BlzFrameSetPoint((BlzGetFrameByName("SkillShopBuyButtonText", s__SkillShopWidget_index[this]) ), ( FRAMEPOINT_TOP ), ( s__SkillShopWidget_BTN[s__SkillShopWidget_index[this]] ), ( FRAMEPOINT_BOTTOM ), (( 0 )*1.0) / 1800., (( 40)*1.0) / 1800.) // INLINED!!
					call BlzFrameSetText(BlzGetFrameByName("SkillShopBuyButtonText", s__SkillShopWidget_index[this]), "|c99999999판매됨|r")
				endif
			else
				
				set s__SkillShopWidget_lucky[this]=GetRandomReal(0., 100.) < ( SkillShop___LUCKY_INITIAL + s__Unit_prototype_getCarculatedStatValue((s__User_FOCUS_UNIT[GetPlayerId((s__SkillShopWidget_owner[this]))]),CONFIG_STAT_LUCK) * SkillShop___LUCKY_BONUS ) / (LoadInteger(Ability__HASH1, (id), s__Ability_INDEX_TIER)) // INLINED!!
				if GetLocalPlayer() == s__SkillShopWidget_owner[this] then
					call BlzFrameSetVisible(s__SkillShopWidget_INFO_LUCKY_BACKDROP[s__SkillShopWidget_index[this]], s__SkillShopWidget_lucky[this])
					call BlzFrameSetVisible(s__SkillShopWidget_INFO_LUCKY_MODEL[s__SkillShopWidget_index[this]], s__SkillShopWidget_lucky[this])
					
					call BlzFrameSetTexture(s__SkillShopWidget_ICON[s__SkillShopWidget_index[this]], s__Ability_getTypeIconPath(id), 0, true)
					call BlzFrameSetTexture(s__SkillShopWidget_TIER_BORDER[s__SkillShopWidget_index[this]], "Textures\\ability_border_tier" + I2S((LoadInteger(Ability__HASH1, (id), s__Ability_INDEX_TIER))) + ".blp", 0, true) // INLINED!!
					call BlzFrameSetVisible(s__SkillShopWidget_TIER_BORDER[s__SkillShopWidget_index[this]], true)
					
					call BlzFrameSetVisible(s__SkillShopWidget_INFO_WEAPON_BACKDROP[s__SkillShopWidget_index[this]], (LoadBoolean(Ability__HASH1, (id), s__Ability_INDEX_IS_WEAPON))) // INLINED!!
				endif
				
				if s__SkillShopWidget_lucky[this] then
					if GetLocalPlayer() == s__SkillShopWidget_owner[this] then
						call BlzFrameSetText(s__SkillShopWidget_NAME[s__SkillShopWidget_index[this]], CUSTOM_STRING_TIER_COLOR[(LoadInteger(Ability__HASH1, (id), s__Ability_INDEX_TIER))] + (LoadStr(Ability__HASH1, (id), s__Ability_INDEX_NAME)) + "|r" + CUSTOM_STRING_STAT_COLOR[CONFIG_STAT_LUCK] + " x2|r") // INLINED!!
					endif
				else
					if GetLocalPlayer() == s__SkillShopWidget_owner[this] then
						call BlzFrameSetText(s__SkillShopWidget_NAME[s__SkillShopWidget_index[this]], CUSTOM_STRING_TIER_COLOR[(LoadInteger(Ability__HASH1, (id), s__Ability_INDEX_TIER))] + (LoadStr(Ability__HASH1, (id), s__Ability_INDEX_NAME)) + "|r") // INLINED!!
					endif
				endif
				
				
				
				set s=s + s__Ability_getTypeTooltip(id)
				if GetLocalPlayer() == s__SkillShopWidget_owner[this] then
					
					call BlzFrameSetText(s__SkillShopWidget_TAG[s__SkillShopWidget_index[this]], s)
					call BlzFrameSetTexture(s__SkillShopWidget_BONUS_STAT1[s__SkillShopWidget_index[this]], CUSTOM_STRING_STAT_ICON[(LoadInteger(Ability__HASH1, (id ), s__Ability_INDEX_BONUS_STAT + ( 0)))], 0, true) // INLINED!!
					call BlzFrameSetTexture(s__SkillShopWidget_BONUS_STAT2[s__SkillShopWidget_index[this]], CUSTOM_STRING_STAT_ICON[(LoadInteger(Ability__HASH1, (id ), s__Ability_INDEX_BONUS_STAT + ( 1)))], 0, true) // INLINED!!
					
					call BlzFrameSetPoint((BlzGetFrameByName("SkillShopBuyButtonText", s__SkillShopWidget_index[this]) ), ( FRAMEPOINT_BOTTOM ), ( s__SkillShopWidget_BTN[s__SkillShopWidget_index[this]] ), ( FRAMEPOINT_BOTTOM ), (( 12 )*1.0) / 1800., (( 24)*1.0) / 1800.) // INLINED!!
					call BlzFrameSetPoint((BlzGetFrameByName("SkillShopBuyButtonText", s__SkillShopWidget_index[this]) ), ( FRAMEPOINT_TOP ), ( s__SkillShopWidget_BTN[s__SkillShopWidget_index[this]] ), ( FRAMEPOINT_BOTTOM ), (( 12 )*1.0) / 1800., (( 40)*1.0) / 1800.) // INLINED!!
					call BlzFrameSetText(BlzGetFrameByName("SkillShopBuyButtonText", s__SkillShopWidget_index[this]), "|cffffcc00" + I2S((LoadInteger(Ability__HASH1, (id), s__Ability_INDEX_COST))) + "|r") // INLINED!!
				endif
			endif
  endfunction

  function s__SkillShopWidget_press takes nothing returns nothing
   local integer this= 0
   local integer j= 0
   local integer i= 0
			
			loop
				exitwhen j >= SkillShop___WIDGET_COUNT
				exitwhen BlzGetTriggerFrame() == s__SkillShopWidget_BTN[j]
				set j=j + 1
			endloop
			set this=GetPlayerId(GetTriggerPlayer()) * SkillShop___WIDGET_COUNT + j
			if GetLocalPlayer() == s__SkillShopWidget_owner[this] then
				call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
				call BlzFrameSetEnable(BlzGetTriggerFrame(), s__SkillShopWidget_id[this] > 0)
			endif
			
			if BlzGetTriggerFrameEvent() == FRAMEEVENT_CONTROL_CLICK then
				
				if (GetPlayerState((s__SkillShopWidget_owner[this]), PLAYER_STATE_RESOURCE_GOLD)) >= (LoadInteger(Ability__HASH1, (s__SkillShopWidget_id[this]), s__Ability_INDEX_COST)) then // INLINED!!
					set i=s__Unit_prototype_getAbilityById((s__User_FOCUS_UNIT[GetPlayerId((s__SkillShopWidget_owner[this]))]),s__SkillShopWidget_id[this]) // INLINED!!
					
					if i > 0 then
						
						if s__Ability_prototype_level[i] >= s__Ability_level_max[i] then
							set CUSTOM_RESPOND_ERROR_MESSAGE="이미 최대 레벨에 도달한 능력입니다."
							set CUSTOM_RESPOND_ERROR_PLAYER=s__SkillShopWidget_owner[this]
							call s__Event_activate(CONFIG_EVENT_ERROR)
							if GetLocalPlayer() == s__SkillShopWidget_owner[this] then
								call PlaySoundBJ(gg_snd_Error)
							endif
							return
						
						else
							
							call sc__Ability_prototype_addLevel(i,1)
							call SaveInteger(Ability__HASH2, (i), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_GOLD ), ( (LoadInteger(Ability__HASH2, (i), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_GOLD))) + (LoadInteger(Ability__HASH1, (s__SkillShopWidget_id[this]), s__Ability_INDEX_COST)))) // INLINED!!
							
						endif
					
					elseif i == 0 then
						
						set i=s__Unit_prototype_addAbility((s__User_FOCUS_UNIT[GetPlayerId((s__SkillShopWidget_owner[this]))]),s__SkillShopWidget_id[this]) // INLINED!!
						call SaveInteger(Ability__HASH2, (i), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_GOLD ), ( (LoadInteger(Ability__HASH2, (i), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_GOLD))) + (LoadInteger(Ability__HASH1, (s__SkillShopWidget_id[this]), s__Ability_INDEX_COST)))) // INLINED!!
						
					
					else
						set CUSTOM_RESPOND_ERROR_MESSAGE="더이상 능력을 배울 수 없습니다."
						set CUSTOM_RESPOND_ERROR_PLAYER=s__SkillShopWidget_owner[this]
						call s__Event_activate(CONFIG_EVENT_ERROR)
						if GetLocalPlayer() == s__SkillShopWidget_owner[this] then
							call PlaySoundBJ(gg_snd_Error)
						endif
						return
					endif
					
					
					if s__SkillShopWidget_lucky[this] then
						
						if s__Ability_prototype_level[i] >= s__Ability_level_max[i] then
							call s__Unit_addUpgradePoint(((s__User_FOCUS_UNIT[GetPlayerId((s__SkillShopWidget_owner[this]))])),CONFIG_UPGRADE_LUCK , (LoadInteger(Ability__HASH1, (s__SkillShopWidget_id[this]), s__Ability_INDEX_COST))) // INLINED!!
						
						else
							call sc__Ability_prototype_addLevel(i,1)
							call SaveInteger(Ability__HASH2, (i), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_LUCK ), ( (LoadInteger(Ability__HASH2, (i), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_LUCK))) + (LoadInteger(Ability__HASH1, (s__SkillShopWidget_id[this]), s__Ability_INDEX_COST)))) // INLINED!!
							
							//set i.upgrade_gold = i.upgrade_gold + Ability.getTypeCost(.id)
						endif
					endif
					
					if (LoadBoolean(Ability__HASH1, (s__Ability_prototype_id[i]), s__Ability_INDEX_IS_WEAPON)) then // INLINED!!
						if s__Ability_prototype_level[i] == 1 and s__Unit_prototype_weapon_ability[s__Ability_prototype_owner[i]] == 0 then
							call s__Unit_prototype_setWeaponAbility(s__Ability_prototype_owner[i],i)
						endif
					endif
					
					call s__User_addGold(s__SkillShopWidget_owner[this] , - 1 * (LoadInteger(Ability__HASH1, (s__SkillShopWidget_id[this]), s__Ability_INDEX_COST))) // INLINED!!
					
					call s__SkillShopWidget_setTarget(this,0)
					set CUSTOM_RESPOND_UI_REFRESH_PLAYER=s__SkillShopWidget_owner[this]
					call s__Event_activate(CONFIG_EVENT_ABILITY_UI_REFRESH)
					set CUSTOM_RESPOND_UI_REFRESH_PLAYER=null
					
				
				else
					set CUSTOM_RESPOND_ERROR_MESSAGE="금화가 부족합니다."
					set CUSTOM_RESPOND_ERROR_PLAYER=s__SkillShopWidget_owner[this]
					call s__Event_activate(CONFIG_EVENT_ERROR)
					if GetLocalPlayer() == s__SkillShopWidget_owner[this] then
						call PlaySoundBJ(gg_snd_Error)
					endif
					return
				endif
			endif
  endfunction

  function s__SkillShopWidget_initFrames takes framehandle parent,integer index returns nothing
			set s__SkillShopWidget_CONTAINER[index]=BlzCreateFrameByType("BACKDROP", "", parent, "", 0)
			call BlzFrameSetPoint(s__SkillShopWidget_CONTAINER[index], FRAMEPOINT_TOPLEFT, FRAME_SKILL_SHOP, FRAMEPOINT_TOPLEFT, index * BlzFrameGetWidth(FRAME_SKILL_SHOP) / 5, 0.)
			call BlzFrameSetSize(s__SkillShopWidget_CONTAINER[index], BlzFrameGetWidth(FRAME_SKILL_SHOP) / 5, BlzFrameGetHeight(FRAME_SKILL_SHOP))
			call BlzFrameSetTexture(s__SkillShopWidget_CONTAINER[index], "Textures\\black32.blp", 0, true)
			
			set s__SkillShopWidget_BTN[index]=BlzCreateFrame("SkillShopBuyButton", s__SkillShopWidget_CONTAINER[index], 0, index)
			call BlzFrameSetPoint((s__SkillShopWidget_BTN[index] ), ( FRAMEPOINT_BOTTOM ), ( s__SkillShopWidget_CONTAINER[index] ), ( FRAMEPOINT_BOTTOM ), (( 0. )*1.0) / 1800., (( 0.)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((s__SkillShopWidget_BTN[index] ), (( 1280 / 5 - 16 )*1.0) / 1800., (( 396 - 64)*1.0) / 1800.) // INLINED!!
			call BlzFrameClearAllPoints(BlzGetFrameByName("SkillShopBuyButtonText", index))
			call BlzFrameSetPoint((BlzGetFrameByName("SkillShopBuyButtonText", index) ), ( FRAMEPOINT_BOTTOM ), ( s__SkillShopWidget_BTN[index] ), ( FRAMEPOINT_BOTTOM ), (( 12 )*1.0) / 1800., (( 24)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetPoint((BlzGetFrameByName("SkillShopBuyButtonText", index) ), ( FRAMEPOINT_TOP ), ( s__SkillShopWidget_BTN[index] ), ( FRAMEPOINT_BOTTOM ), (( 12 )*1.0) / 1800., (( 40)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetTextAlignment(BlzGetFrameByName("SkillShopBuyButtonText", index), TEXT_JUSTIFY_BOTTOM, TEXT_JUSTIFY_CENTER)
			call BlzFrameSetTexture(BlzGetFrameByName("SkillShopBuyButtonIcon", index), "ui\\widgets\\tooltips\\human\\tooltipgoldicon.blp", 0, true)
			call BlzFrameSetPoint(BlzGetFrameByName("SkillShopBuyButtonIcon", index), FRAMEPOINT_RIGHT, BlzGetFrameByName("SkillShopBuyButtonText", index), FRAMEPOINT_LEFT, - 0.005, 0.)
			call BlzFrameSetSize(BlzGetFrameByName("SkillShopBuyButtonIcon", index), (((24)*1.0) / 1800.), (((24)*1.0) / 1800.)) // INLINED!!
			
			set s__SkillShopWidget_ICON[index]=BlzCreateFrameByType("BACKDROP", "", s__SkillShopWidget_CONTAINER[index], "", 0)
			call BlzFrameSetPoint((s__SkillShopWidget_ICON[index] ), ( FRAMEPOINT_TOP ), ( s__SkillShopWidget_CONTAINER[index] ), ( FRAMEPOINT_TOP ), (( 0. )*1.0) / 1800., (( - 32)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize((s__SkillShopWidget_ICON[index] ), (( s__SkillShopWidget_ICON_SIZE )*1.0) / 1800., (( s__SkillShopWidget_ICON_SIZE)*1.0) / 1800.) // INLINED!!
			set s__SkillShopWidget_TIER_BORDER[index]=BlzCreateFrameByType("BACKDROP", "", s__SkillShopWidget_CONTAINER[index], "", 0)
			call BlzFrameSetAllPoints(s__SkillShopWidget_TIER_BORDER[index], s__SkillShopWidget_ICON[index])
			call BlzFrameSetTexture(s__SkillShopWidget_TIER_BORDER[index], "Textures\\ability_border_tier1.blp", 0, true)
			call BlzFrameSetVisible(s__SkillShopWidget_TIER_BORDER[index], false)
			
			set s__SkillShopWidget_INFO_WEAPON_BACKDROP[index]=BlzCreateFrameByType("BACKDROP", "", s__SkillShopWidget_CONTAINER[index], "", 0)
			call BlzFrameSetPoint(s__SkillShopWidget_INFO_WEAPON_BACKDROP[index], FRAMEPOINT_BOTTOMLEFT, s__SkillShopWidget_ICON[index], FRAMEPOINT_BOTTOMRIGHT, 0., 0.)
			call BlzFrameSetSize((s__SkillShopWidget_INFO_WEAPON_BACKDROP[index] ), (( 32 )*1.0) / 1800., (( 32)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetTexture(s__SkillShopWidget_INFO_WEAPON_BACKDROP[index], "ui\\widgets\\tooltips\\human\\tooltipweaponicon.blp", 0, true)
			
			set s__SkillShopWidget_INFO_LUCKY_BACKDROP[index]=BlzCreateFrameByType("BACKDROP", "", s__SkillShopWidget_CONTAINER[index], "", 0)
			call BlzFrameSetPoint(s__SkillShopWidget_INFO_LUCKY_BACKDROP[index], FRAMEPOINT_BOTTOMRIGHT, s__SkillShopWidget_ICON[index], FRAMEPOINT_BOTTOMRIGHT, 0., 0.)
			call BlzFrameSetSize((s__SkillShopWidget_INFO_LUCKY_BACKDROP[index] ), (( 32 )*1.0) / 1800., (( 32)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetTexture(s__SkillShopWidget_INFO_LUCKY_BACKDROP[index], CUSTOM_STRING_STAT_ICON[CONFIG_STAT_LUCK], 0, true)
			set s__SkillShopWidget_INFO_LUCKY_MODEL[index]=BlzCreateFrameByType("SPRITE", "", s__SkillShopWidget_CONTAINER[index], "", 0)
			call BlzFrameSetPoint(s__SkillShopWidget_INFO_LUCKY_MODEL[index], FRAMEPOINT_BOTTOMLEFT, s__SkillShopWidget_ICON[index], FRAMEPOINT_BOTTOMLEFT, 0., 0.)
			call BlzFrameSetSize(s__SkillShopWidget_INFO_LUCKY_MODEL[index], 0.0001, 0.0001)
			call BlzFrameSetModel(s__SkillShopWidget_INFO_LUCKY_MODEL[index], "ui\\ui_skillshop_lucky_emitter.mdl", 0)
			
			set s__SkillShopWidget_NAME[index]=BlzCreateFrame("MyTextLarge", s__SkillShopWidget_CONTAINER[index], 0, 0)
			call BlzFrameSetPoint(s__SkillShopWidget_NAME[index], FRAMEPOINT_TOP, s__SkillShopWidget_ICON[index], FRAMEPOINT_BOTTOM, 0., - 0.005)
			call BlzFrameSetTextAlignment(s__SkillShopWidget_NAME[index], TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
			call BlzFrameSetText(s__SkillShopWidget_NAME[index], "어빌리티 이름")
			set s__SkillShopWidget_TAG[index]=BlzCreateFrame("MyText", s__SkillShopWidget_CONTAINER[index], 0, 0)
			call BlzFrameSetPoint(s__SkillShopWidget_TAG[index], FRAMEPOINT_TOP, s__SkillShopWidget_NAME[index], FRAMEPOINT_BOTTOM, 0., - 0.005)
			call BlzFrameSetTextAlignment(s__SkillShopWidget_TAG[index], TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
			call BlzFrameSetText(s__SkillShopWidget_TAG[index], "")
			
			set s__SkillShopWidget_BONUS_STAT1[index]=BlzCreateFrameByType("BACKDROP", "", s__SkillShopWidget_CONTAINER[index], "", 0)
			call BlzFrameSetPoint((s__SkillShopWidget_BONUS_STAT1[index] ), ( FRAMEPOINT_BOTTOMRIGHT ), ( s__SkillShopWidget_BTN[index] ), ( FRAMEPOINT_BOTTOM ), (( - 8 )*1.0) / 1800., (( 64)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize(s__SkillShopWidget_BONUS_STAT1[index], (((32)*1.0) / 1800.), (((32)*1.0) / 1800.)) // INLINED!!
			set s__SkillShopWidget_BONUS_STAT2[index]=BlzCreateFrameByType("BACKDROP", "", s__SkillShopWidget_CONTAINER[index], "", 0)
			call BlzFrameSetPoint((s__SkillShopWidget_BONUS_STAT2[index] ), ( FRAMEPOINT_BOTTOMLEFT ), ( s__SkillShopWidget_BTN[index] ), ( FRAMEPOINT_BOTTOM ), (( 8 )*1.0) / 1800., (( 64)*1.0) / 1800.) // INLINED!!
			call BlzFrameSetSize(s__SkillShopWidget_BONUS_STAT2[index], (((32)*1.0) / 1800.), (((32)*1.0) / 1800.)) // INLINED!!
			
			call BlzTriggerRegisterFrameEvent(s__SkillShopWidget_BTN_TRIGGER, s__SkillShopWidget_BTN[index], FRAMEEVENT_CONTROL_CLICK)
			call BlzTriggerRegisterFrameEvent(s__SkillShopWidget_BTN_TRIGGER, s__SkillShopWidget_BTN[index], FRAMEEVENT_MOUSE_LEAVE)
  endfunction

  function s__SkillShopWidget_create takes framehandle parent,player owner,integer index returns integer
   local integer this= GetPlayerId(owner) * SkillShop___WIDGET_COUNT + index
			set s__SkillShopWidget_id[this]=0
			set s__SkillShopWidget_owner[this]=owner
			set s__SkillShopWidget_index[this]=index
			set s__SkillShopWidget_lucky[this]=false
			
			if not s__SkillShopWidget_ACTIVATED[s__SkillShopWidget_index[this]] then
				call s__SkillShopWidget_initFrames(parent , s__SkillShopWidget_index[this])
				set s__SkillShopWidget_ACTIVATED[s__SkillShopWidget_index[this]]=true
			endif
			
			call s__SkillShopWidget_setTarget(this,0)
			return this
  endfunction

  function s__SkillShopWidget_destroy takes integer this returns nothing
			
  endfunction

  function s__SkillShopWidget_onInit takes nothing returns nothing
			set s__SkillShopWidget_BTN_TRIGGER=CreateTrigger()
			call TriggerAddCondition(s__SkillShopWidget_BTN_TRIGGER, Condition(function s__SkillShopWidget_press))
  endfunction

  function s__SkillShopWidget_get takes player p,integer index returns integer
			return GetPlayerId(p) * SkillShop___WIDGET_COUNT + index
  endfunction





		


  function s__SkillShop__get_owner takes integer this returns player
			return Player(this)
  endfunction

  function s__SkillShop_carculatedTier takes integer this returns integer
   local integer r= 0
   local integer i= 0
   local integer current_chance= 0
			if s__SkillShop_level[this] >= 1 and s__SkillShop_level[this] <= CHANCE_LEVEL_MAX then
				set r=GetRandomInt(1, CHANCE_TOTAL[s__SkillShop_level[this]])
				
				set current_chance=current_chance + CHANCE_TIER1[s__SkillShop_level[this]]
				if r <= current_chance then
					return 1
				endif
				set current_chance=current_chance + CHANCE_TIER2[s__SkillShop_level[this]]
				if r <= current_chance then
					return 2
				endif
				set current_chance=current_chance + CHANCE_TIER3[s__SkillShop_level[this]]
				if r <= current_chance then
					return 3
				endif
				set current_chance=current_chance + CHANCE_TIER4[s__SkillShop_level[this]]
				if r <= current_chance then
					return 4
				endif
				set current_chance=current_chance + CHANCE_TIER5[s__SkillShop_level[this]]
				if r <= current_chance then
					return 5
				endif
			endif
			return 0
  endfunction

  function s__SkillShop_refreshChanceText takes integer this returns nothing
			if GetLocalPlayer() == Player(this) then
				
				call BlzFrameSetText(s__SkillShop_CHANCE_TEXT, CUSTOM_STRING_TIER_COLOR[1] + I2S(R2I(sc__SkillShop_getTierChance(s__SkillShop_level[this] , 1) * 100 / CHANCE_TOTAL[s__SkillShop_level[this]])) + "%|r    " + CUSTOM_STRING_TIER_COLOR[2] + I2S(R2I(sc__SkillShop_getTierChance(s__SkillShop_level[this] , 2) * 100 / CHANCE_TOTAL[s__SkillShop_level[this]])) + "%|r    " + CUSTOM_STRING_TIER_COLOR[3] + I2S(R2I(sc__SkillShop_getTierChance(s__SkillShop_level[this] , 3) * 100 / CHANCE_TOTAL[s__SkillShop_level[this]])) + "%|r    " + CUSTOM_STRING_TIER_COLOR[4] + I2S(R2I(sc__SkillShop_getTierChance(s__SkillShop_level[this] , 4) * 100 / CHANCE_TOTAL[s__SkillShop_level[this]])) + "%|r    " + CUSTOM_STRING_TIER_COLOR[5] + I2S(R2I(sc__SkillShop_getTierChance(s__SkillShop_level[this] , 5) * 100 / CHANCE_TOTAL[s__SkillShop_level[this]])) + "%|r")
			endif
  endfunction

  function s__SkillShop_refreshLevelState takes integer this returns nothing
			if s__SkillShop_level[this] >= LEVEL_MAX then
				if GetLocalPlayer() == Player(this) then
					call BlzFrameSetVisible(s__SkillShop_EXP_FILL, true)
					call BlzFrameSetText(s__SkillShop_LEVEL_TEXT, I2S(LEVEL_MAX))
					call BlzFrameSetText(s__SkillShop_EXP_TEXT, "MAX")
					call BlzFrameSetPoint((s__SkillShop_EXP_FILL ), ( FRAMEPOINT_TOPRIGHT ), ( s__SkillShop_EXP_BACKDROP ), ( FRAMEPOINT_TOPRIGHT ), (( 0. )*1.0) / 1800., (( 0.)*1.0) / 1800.) // INLINED!!
				endif
			else
				if GetLocalPlayer() == Player(this) then
					call BlzFrameSetVisible(s__SkillShop_EXP_FILL, s__SkillShop_exp[this] > 0)
					call BlzFrameSetText(s__SkillShop_LEVEL_TEXT, I2S(s__SkillShop_level[this]))
					call BlzFrameSetText(s__SkillShop_EXP_TEXT, I2S(s__SkillShop_exp[this]) + " / " + I2S(s__SkillShop_exp_max[this]))
					call BlzFrameSetPoint((s__SkillShop_EXP_FILL ), ( FRAMEPOINT_TOPRIGHT ), ( s__SkillShop_EXP_BACKDROP ), ( FRAMEPOINT_TOPLEFT ), (( s__SkillShop_EXP_GAUGE_WIDTH * ( I2R(s__SkillShop_exp[this]) / I2R(s__SkillShop_exp_max[this]) ) )*1.0) / 1800., (( 0.)*1.0) / 1800.) // INLINED!!
				endif
			endif
  endfunction

  function s__SkillShop_setLevel takes integer this,integer nv returns nothing
			set s__SkillShop_level[this]=nv
			set s__SkillShop_exp_max[this]=SkillShop___MAX_EXP[s__SkillShop_level[this]]
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(s__SkillShop_BTN_DONATE, s__SkillShop_level[this] > 1)
				call BlzFrameSetVisible(s__SkillShop_BTN_REFRESH, s__SkillShop_level[this] > 1)
			endif
			call s__SkillShop_refreshChanceText(this)
  endfunction

  function s__SkillShop_addExp takes integer this,integer v returns nothing
			set s__SkillShop_exp[this]=s__SkillShop_exp[this] + v
			loop
				exitwhen s__SkillShop_exp[this] < s__SkillShop_exp_max[this] or s__SkillShop_level[this] == LEVEL_MAX
				if s__SkillShop_exp[this] >= s__SkillShop_exp_max[this] then
					set s__SkillShop_exp[this]=s__SkillShop_exp[this] - s__SkillShop_exp_max[this]
					call s__SkillShop_setLevel(this,s__SkillShop_level[this] + 1)
				endif
			endloop
			call s__SkillShop_refreshLevelState(this)
  endfunction

  function s__SkillShop_addLevel takes nothing returns nothing
   local integer i= 0
			loop
				exitwhen i >= CONFIG_PLAYER_MAX
				call s__SkillShop_addExp((i),2)
				set i=i + 1
			endloop
  endfunction

  function s__SkillShop_refreshGold takes integer this returns nothing
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetText(s__SkillShop_GOLD_TEXT, "|cffffcc00" + I2S((GetPlayerState(((Player((this)))), PLAYER_STATE_RESOURCE_GOLD))) + "|r") // INLINED!!
			endif
  endfunction

  function s__SkillShop_visibleForPlayer takes integer this,boolean flag returns nothing
			if s__SkillShop_visible_flag[this] != flag then
				if flag then
					
					call s__Array_add(s__CloseUI_list[(this)],s__CloseUI_ORDER_SKILL_SHOP)
				else
					
					call s__Array_eraseFor(s__CloseUI_list[(this)],s__CloseUI_ORDER_SKILL_SHOP)
				endif
			endif
			set s__SkillShop_visible_flag[this]=flag
			if GetLocalPlayer() == (Player((this))) then // INLINED!!
				call BlzFrameSetVisible(FRAME_SKILL_SHOP_BACKDROP, flag)
			endif
			if s__SkillShop_visible_flag[this] then
				call s__SkillShop_refreshChanceText(this)
			endif
  endfunction

  function s__SkillShop_close takes integer this returns boolean
			if s__SkillShop_visible_flag[this] then
				call s__SkillShop_visibleForPlayer(this,false)
				return true
			else
				return false
			endif
  endfunction

  function s__SkillShop_isWidgetEmpty takes integer this returns boolean
   local integer i= 0
			loop
				exitwhen i >= 5
				if s__SkillShopWidget_id[(GetPlayerId(((Player((this))) )) * SkillShop___WIDGET_COUNT + ( i))] > 0 then // INLINED!!
					return false
				endif
				set i=i + 1
			endloop
			return true
  endfunction

  function s__SkillShop_refreshLumberRefresh takes integer this returns nothing
   local integer minitue= s__SkillShop_lumber_add_time[this] / 60
   local string second= ""
			if s__SkillShop_lumber_add_time[this] - 60 * minitue >= 10 then
				set second=I2S(s__SkillShop_lumber_add_time[this] - 60 * minitue)
			else
				set second="0" + I2S(s__SkillShop_lumber_add_time[this] - 60 * minitue)
			endif
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetText(BlzGetFrameByName("SkillShopLumberRefreshButtonText", 0), "|cff00cc001|r |cffffffff: 새로고침|r |cff00cc00(" + I2S((GetPlayerState((Player(this)), PLAYER_STATE_RESOURCE_LUMBER))) + "/" + I2S(SkillShop___LUMBER_MAX) + ")|r") // INLINED!!
				call BlzFrameSetText(s__SkillShop_LUMBER_SMALL_TIMER_TEXT, "|cff00cc00(" + I2S((GetPlayerState((Player(this)), PLAYER_STATE_RESOURCE_LUMBER))) + "/" + I2S(SkillShop___LUMBER_MAX) + ")|r") // INLINED!!
				if (GetPlayerState((Player(this)), PLAYER_STATE_RESOURCE_LUMBER)) >= SkillShop___LUMBER_MAX then // INLINED!!
					call BlzFrameSetVisible(s__SkillShop_LUMBER_REFRESH_TEXT, false)
					call BlzFrameSetVisible(s__SkillShop_LUMBER_REFRESH_TEXT_BACKDROP, false)
				else
					call BlzFrameSetText(s__SkillShop_LUMBER_REFRESH_TEXT, "|cff00cc00목재 지급 " + I2S(minitue) + ":" + second + "|r")
					call BlzFrameSetVisible(s__SkillShop_LUMBER_REFRESH_TEXT, true)
					call BlzFrameSetVisible(s__SkillShop_LUMBER_REFRESH_TEXT_BACKDROP, true)
				endif
			endif
  endfunction

  function s__SkillShop_refresh takes integer this returns nothing
   local integer sw= 0
   local integer i= 0
			loop
				exitwhen i >= SkillShop___WIDGET_COUNT
				set sw=( this * SkillShop___WIDGET_COUNT ) + i
				call s__SkillShopWidget_setTarget(sw,s__AbilityTable_getRandomAbility(this , CONFIG_TIER_0 + s__SkillShop_carculatedTier(this)))
				set i=i + 1
			endloop
			call s__SkillShop_refreshChanceText(this)
			call s__SkillShop_refreshLevelState(this)
  endfunction

  function s__SkillShop_switch takes integer this returns nothing
			call s__SkillShop_visibleForPlayer(this,not s__SkillShop_visible_flag[this])
  endfunction

  function s__SkillShop_press takes nothing returns nothing
   local integer this= 0
   local player p= GetTriggerPlayer()
   local integer i= 0
			if (udg_EVENT_VALUE) == CONFIG_EVENT_KEYPRESS then // INLINED!!
				set this=GetPlayerId(CUSTOM_RESPOND_KEYPRESS_PLAYER)
				if CUSTOM_RESPOND_KEYPRESS_KEY == OSKEY_T and CUSTOM_RESPOND_KEYPRESS_PRESS then
					call s__SkillShop_switch(this)
					return
				endif
				return
			endif
			set this=GetPlayerId(p)
			if BlzGetTriggerFrame() != null then
				if GetLocalPlayer() == Player(this) then
					call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
					call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
				endif
				if BlzGetTriggerFrameEvent() == FRAMEEVENT_CONTROL_CLICK then
					if BlzGetTriggerFrame() == s__SkillShop_BTN_CLOSE then
						
						call s__SkillShop_close(this)
						return
					elseif BlzGetTriggerFrame() == s__SkillShop_BTN_REFRESH then
						
						if (GetPlayerState(((Player((this)))), PLAYER_STATE_RESOURCE_GOLD)) >= 2 then // INLINED!!
							call s__User_addGold((Player((this))) , - 2) // INLINED!!
							call s__SkillShop_refresh(this)
							call s__SkillShop_refreshLumberRefresh(this)
						
						else
							set CUSTOM_RESPOND_ERROR_MESSAGE="금화가 부족합니다."
							set CUSTOM_RESPOND_ERROR_PLAYER=(Player((this))) // INLINED!!
							call s__Event_activate(CONFIG_EVENT_ERROR)
							if GetLocalPlayer() == Player(this) then
								call PlaySoundBJ(gg_snd_Error)
							endif
						endif
						return
					elseif BlzGetTriggerFrame() == s__SkillShop_BTN_LUMBER_REFRESH then
						
						if (GetPlayerState(((Player((this)))), PLAYER_STATE_RESOURCE_LUMBER)) >= 1 then // INLINED!!
							call s__User_addLumber((Player((this))) , - 1) // INLINED!!
							call s__SkillShop_refresh(this)
							call s__SkillShop_refreshLumberRefresh(this)
						
						else
							set CUSTOM_RESPOND_ERROR_MESSAGE="목재가 부족합니다."
							set CUSTOM_RESPOND_ERROR_PLAYER=(Player((this))) // INLINED!!
							call s__Event_activate(CONFIG_EVENT_ERROR)
							if GetLocalPlayer() == Player(this) then
								call PlaySoundBJ(gg_snd_Error)
							endif
						endif
						return
					elseif BlzGetTriggerFrame() == s__SkillShop_BTN_DONATE then
						
						if (GetPlayerState(((Player((this)))), PLAYER_STATE_RESOURCE_GOLD)) >= SkillShop___DONATE_COST and s__SkillShop_level[this] < LEVEL_MAX then // INLINED!!
							call s__SkillShop_addExp(this,SkillShop___DONATE_EXP)
							call s__User_addGold((Player((this))) , - SkillShop___DONATE_COST) // INLINED!!
						
						elseif (GetPlayerState(((Player((this)))), PLAYER_STATE_RESOURCE_GOLD)) < SkillShop___DONATE_COST then // INLINED!!
							set CUSTOM_RESPOND_ERROR_MESSAGE="금화가 부족합니다."
							set CUSTOM_RESPOND_ERROR_PLAYER=(Player((this))) // INLINED!!
							call s__Event_activate(CONFIG_EVENT_ERROR)
							if GetLocalPlayer() == Player(this) then
								call PlaySoundBJ(gg_snd_Error)
							endif
						
						elseif s__SkillShop_level[this] >= LEVEL_MAX then
							set CUSTOM_RESPOND_ERROR_MESSAGE="더 이상 기부할 수 없습니다."
							set CUSTOM_RESPOND_ERROR_PLAYER=(Player((this))) // INLINED!!
							call s__Event_activate(CONFIG_EVENT_ERROR)
							if GetLocalPlayer() == Player(this) then
								call PlaySoundBJ(gg_snd_Error)
							endif
						endif
						return
					endif
				endif
			elseif not s__SkillShop_DEFEAT then
				
				set i=0
				loop
					exitwhen i >= CONFIG_PLAYER_MAX
					set this=i
					if (GetPlayerState((Player(this)), PLAYER_STATE_RESOURCE_LUMBER)) < SkillShop___LUMBER_MAX then // INLINED!!
						
						set s__SkillShop_lumber_add_time[this]=s__SkillShop_lumber_add_time[this] - 1
						if s__SkillShop_lumber_add_time[this] <= 0 then
							call s__User_addLumber(Player(this) , 1)
							set s__SkillShop_lumber_add_time[this]=s__SkillShop_LUMBER_ADD_TIME
						endif
					else
						
						set s__SkillShop_lumber_add_time[this]=s__SkillShop_LUMBER_ADD_TIME
					endif
					call s__SkillShop_refreshLumberRefresh(this)
					set i=i + 1
				endloop
			endif
  endfunction

  function s__SkillShop_initFrames takes nothing returns nothing
			set s__SkillShop_CONTAINER=BlzCreateFrameByType("FRAME", "", FRAME_SKILL_SHOP_BACKDROP, "", 0)
			call BlzFrameSetPoint(s__SkillShop_CONTAINER, FRAMEPOINT_TOPLEFT, FRAME_SKILL_SHOP, FRAMEPOINT_TOPLEFT, 0., 0.)
			
			set s__SkillShop_BTN_LUMBER_REFRESH=BlzCreateFrame("SkillShopLumberRefreshButton", s__SkillShop_CONTAINER, 0, 0)
			call BlzFrameSetPoint(s__SkillShop_BTN_LUMBER_REFRESH, FRAMEPOINT_TOPRIGHT, FRAME_SKILL_SHOP_BACKDROP, FRAMEPOINT_BOTTOMRIGHT, 0., 0.)
			call BlzFrameSetSize((s__SkillShop_BTN_LUMBER_REFRESH ), (( 240 )*1.0) / 1800., (( 56)*1.0) / 1800.) // INLINED!!
			call BlzFrameClearAllPoints(BlzGetFrameByName("SkillShopLumberRefreshButtonText", 0))
			call BlzFrameSetPoint(BlzGetFrameByName("SkillShopLumberRefreshButtonText", 0), FRAMEPOINT_CENTER, s__SkillShop_BTN_LUMBER_REFRESH, FRAMEPOINT_CENTER, (((12)*1.0) / 1800.), 0.) // INLINED!!
			call BlzFrameSetTextAlignment(BlzGetFrameByName("SkillShopLumberRefreshButtonText", 0), TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_CENTER)
			call BlzFrameSetTexture(BlzGetFrameByName("SkillShopLumberRefreshButtonIcon", 0), "ui\\widgets\\tooltips\\human\\tooltiplumbericon.blp", 0, true)
			call BlzFrameSetPoint(BlzGetFrameByName("SkillShopLumberRefreshButtonIcon", 0), FRAMEPOINT_RIGHT, BlzGetFrameByName("SkillShopLumberRefreshButtonText", 0), FRAMEPOINT_LEFT, - 0.005, 0.)
			call BlzFrameSetSize(BlzGetFrameByName("SkillShopLumberRefreshButtonIcon", 0), (((24)*1.0) / 1800.), (((24)*1.0) / 1800.)) // INLINED!!
			
			set s__SkillShop_LUMBER_REFRESH_TEXT_BACKDROP=BlzCreateFrame("MyTextBox", s__SkillShop_BTN_LUMBER_REFRESH, 0, 0)
			call BlzFrameSetPoint(s__SkillShop_LUMBER_REFRESH_TEXT_BACKDROP, FRAMEPOINT_BOTTOM, s__SkillShop_BTN_LUMBER_REFRESH, FRAMEPOINT_TOP, 0., - 0.0025)
			call BlzFrameSetSize(s__SkillShop_LUMBER_REFRESH_TEXT_BACKDROP, 0.09, 0.015)
			set s__SkillShop_LUMBER_REFRESH_TEXT=BlzCreateFrame("MyText", s__SkillShop_LUMBER_REFRESH_TEXT_BACKDROP, 0, 0)
			call BlzFrameSetPoint(s__SkillShop_LUMBER_REFRESH_TEXT, FRAMEPOINT_CENTER, s__SkillShop_LUMBER_REFRESH_TEXT_BACKDROP, FRAMEPOINT_CENTER, 0, 0)
			call BlzFrameSetTextAlignment(s__SkillShop_LUMBER_REFRESH_TEXT, TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_CENTER)
			set s__SkillShop_LUMBER_SMALL_TIMER_BACKDROP=BlzCreateFrameByType("BACKDROP", "", FRAME_SKILL_SHOP_BUTTON, "", 0)
			call BlzFrameSetTexture(s__SkillShop_LUMBER_SMALL_TIMER_BACKDROP, "textures\\black32.blp", 0, true)
			call BlzFrameSetAlpha(s__SkillShop_LUMBER_SMALL_TIMER_BACKDROP, 192)
			set s__SkillShop_LUMBER_SMALL_TIMER_TEXT=BlzCreateFrame("MyTextSmall", FRAME_SKILL_SHOP_BUTTON, 0, 0)
			call BlzFrameSetPoint(s__SkillShop_LUMBER_SMALL_TIMER_TEXT, FRAMEPOINT_TOP, FRAME_SKILL_SHOP_BUTTON, FRAMEPOINT_BOTTOM, 0, 0.)
			call BlzFrameSetTextAlignment(s__SkillShop_LUMBER_SMALL_TIMER_TEXT, TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_CENTER)
			call BlzFrameSetPoint(s__SkillShop_LUMBER_SMALL_TIMER_BACKDROP, FRAMEPOINT_TOPLEFT, s__SkillShop_LUMBER_SMALL_TIMER_TEXT, FRAMEPOINT_TOPLEFT, - 0.002, 0.002)
			call BlzFrameSetPoint(s__SkillShop_LUMBER_SMALL_TIMER_BACKDROP, FRAMEPOINT_BOTTOMRIGHT, s__SkillShop_LUMBER_SMALL_TIMER_TEXT, FRAMEPOINT_BOTTOMRIGHT, 0.002, - 0.002)
			
			set s__SkillShop_BTN_REFRESH=BlzCreateFrame("SkillShopRefreshButton", s__SkillShop_CONTAINER, 0, 0)
			call BlzFrameSetPoint(s__SkillShop_BTN_REFRESH, FRAMEPOINT_TOPRIGHT, s__SkillShop_BTN_LUMBER_REFRESH, FRAMEPOINT_TOPLEFT, 0., 0.)
			call BlzFrameSetSize((s__SkillShop_BTN_REFRESH ), (( 240 )*1.0) / 1800., (( 56)*1.0) / 1800.) // INLINED!!
			call BlzFrameClearAllPoints(BlzGetFrameByName("SkillShopRefreshButtonText", 0))
			call BlzFrameSetPoint(BlzGetFrameByName("SkillShopRefreshButtonText", 0), FRAMEPOINT_CENTER, s__SkillShop_BTN_REFRESH, FRAMEPOINT_CENTER, (((12)*1.0) / 1800.), 0.) // INLINED!!
			call BlzFrameSetTextAlignment(BlzGetFrameByName("SkillShopRefreshButtonText", 0), TEXT_JUSTIFY_CENTER, TEXT_JUSTIFY_CENTER)
			call BlzFrameSetText(BlzGetFrameByName("SkillShopRefreshButtonText", 0), "|cffffcc002|r |cffffffff: 새로고침|r")
			call BlzFrameSetTexture(BlzGetFrameByName("SkillShopRefreshButtonIcon", 0), "ui\\widgets\\tooltips\\human\\tooltipgoldicon.blp", 0, true)
			call BlzFrameSetPoint(BlzGetFrameByName("SkillShopRefreshButtonIcon", 0), FRAMEPOINT_RIGHT, BlzGetFrameByName("SkillShopRefreshButtonText", 0), FRAMEPOINT_LEFT, - 0.005, 0.)
			call BlzFrameSetSize(BlzGetFrameByName("SkillShopRefreshButtonIcon", 0), (((24)*1.0) / 1800.), (((24)*1.0) / 1800.)) // INLINED!!
			
			set s__SkillShop_BTN_DONATE=BlzCreateFrame("SkillShopDonateButton", s__SkillShop_CONTAINER, 0, 0)
