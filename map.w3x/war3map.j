  function s__UnitMovement_suspendAction takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if (udg_EVENT_VALUE) == CONFIG_EVENT_KEYPRESS and CUSTOM_RESPOND_KEYPRESS_PRESS then // INLINED!!
				if CUSTOM_RESPOND_KEYPRESS_CASTER != (s__Actor_actor[(this)]) or CUSTOM_RESPOND_KEYPRESS_CASTER <= 0 then // INLINED!!
					return
				endif
				if CUSTOM_RESPOND_KEYPRESS_KEY != OSKEY_S and CUSTOM_RESPOND_KEYPRESS_KEY != OSKEY_H then
					return
				endif
				if s__UnitMovement_suspend_stop[this] then
					
					call s__UnitMovement_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_KEYPRESS , CONFIG_STATUS_WHOKNOWS)
					call sc__Actor_onSuspend(this)
					call sc__Actor_prototype_deallocate(this)
				else
					call sc__UnitMovement_onStop(this)
				endif
				return
			endif
			if (udg_EVENT_VALUE) == CONFIG_EVENT_CLICK and CUSTOM_RESPOND_CLICK_BUTTON_TYPE == MOUSE_BUTTON_TYPE_RIGHT then // INLINED!!
				if CUSTOM_RESPOND_CLICK_CASTER == (s__Actor_actor[(this)]) then // INLINED!!
					if s__UnitMovement_suspend_rclick[this] and sc__Unit_prototype_isMoveable((s__Actor_actor[(this)])) then // INLINED!!
						
						if sc__Movement__get_target(this) > 0 then
							
							if s__Unit_prototype_origin_unit[(sc__Movement__get_target(this))] != CUSTOM_RESPOND_CLICK_TARGET then
								
								call s__UnitMovement_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_CLICK , CONFIG_STATUS_WHOKNOWS)
								call sc__Actor_onSuspend(this)
								call sc__Actor_prototype_deallocate(this)
								return
							endif
						else
							
							call s__UnitMovement_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_CLICK , CONFIG_STATUS_WHOKNOWS)
							call sc__Actor_onSuspend(this)
							call sc__Actor_prototype_deallocate(this)
							return
						endif
					else
						
						call sc__UnitMovement_onRightClick(this)
						return
					endif
				endif
			endif
			if (udg_EVENT_VALUE) == CONFIG_EVENT_ABILITY_FOLLOW then // INLINED!!
				if CUSTOM_RESPOND_ABILITY_CASTER == (s__Actor_actor[(this)]) and s__UnitMovement_suspend_ability[this] then // INLINED!!
					if not s__Ability_prototype_useable_cast[(CUSTOM_RESPOND_ABILITY_INSTANCE)] then
						call s__UnitMovement_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_CLICK , CONFIG_STATUS_WHOKNOWS)
						call sc__Actor_onSuspend(this)
						call sc__Actor_prototype_deallocate(this)
						return
					endif
				endif
				return
			endif
			if (udg_EVENT_VALUE) == CONFIG_EVENT_DECAY then // INLINED!!
				if (s__Actor_actor[(this)]) > 0 and (s__Actor_actor[(this)]) == CUSTOM_RESPOND_DECAY_UNIT then // INLINED!!
					call s__UnitMovement_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_STATUS , CONFIG_STATUS_DEAD)
					call sc__Actor_onSuspend(this)
					call sc__Actor_prototype_deallocate(this)
					return
				endif
				if sc__Movement__get_target(this) > 0 and sc__Movement__get_target(this) == CUSTOM_RESPOND_DECAY_UNIT then
					if s__UnitMovement_suspend_target_decay[this] then
						call s__UnitMovement_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_TARGET_LOSS , CONFIG_STATUS_WHOKNOWS)
						call sc__Actor_onSuspend(this)
						call sc__Actor_prototype_deallocate(this)
						return
					else
						call sc__UnitMovement_targetDecay(this)
					endif
				endif
				return
			endif
  endfunction

