				call BlzFrameSetPoint((s__ExtraAbilityIcon_cooldown_backdrop2[this] ), ( FRAMEPOINT_TOPLEFT ), ( s__ExtraAbilityIcon_icon_backdrop[this] ), ( FRAMEPOINT_BOTTOMRIGHT ), (( - ExtraAbilityIcon___SIZE )*1.0) / 1800., (( ExtraAbilityIcon___SIZE * ( s__Ability_prototype_getUICooldown(s__ExtraAbilityIcon_target[this]) / s__Ability_prototype_getCarculatedMaxCooldown(s__ExtraAbilityIcon_target[this]) ))*1.0) / 1800.) // INLINED!!
			endif
			
			call BlzFrameSetVisible(s__ExtraAbilityIcon_nem_backdrop[this], (s__Unit_prototype_mp_true[(s__Ability_prototype_owner[s__ExtraAbilityIcon_target[this]])]) < sc__Ability_prototype_getCarculatedManacost(s__ExtraAbilityIcon_target[this])) // INLINED!!
			
