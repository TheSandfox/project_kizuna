  function s__Curve_setProjectedControlPoint takes integer this,integer index,real dist,real radius,real ta returns nothing
   local real angle= ta - 90
   local real yaw= bj_RADTODEG * Atan2(s__Curve_getY(this,s__Curve_POINT_LAST) - s__Curve_getY(this,s__Curve_POINT_ORIGIN), s__Curve_getX(this,s__Curve_POINT_LAST) - s__Curve_getX(this,s__Curve_POINT_ORIGIN))
   local real pitch= bj_RADTODEG * Atan2(s__Curve_getZ(this,s__Curve_POINT_LAST) - s__Curve_getZ(this,s__Curve_POINT_ORIGIN), SquareRoot(( s__Curve_getX(this,s__Curve_POINT_LAST) - s__Curve_getX(this,s__Curve_POINT_ORIGIN) ) * ( s__Curve_getX(this,s__Curve_POINT_LAST) - s__Curve_getX(this,s__Curve_POINT_ORIGIN) ) + ( s__Curve_getY(this,s__Curve_POINT_LAST) - s__Curve_getY(this,s__Curve_POINT_ORIGIN) ) * ( s__Curve_getY(this,s__Curve_POINT_LAST) - s__Curve_getY(this,s__Curve_POINT_ORIGIN) )))
			call s__Curve_setX(this,s__Curve_POINT_MIDDLE + index , s__Curve_getX(this,s__Curve_POINT_ORIGIN) + dist * Cos(Deg2Rad(yaw)) * Cos(Deg2Rad(pitch)) + radius * Cos(Deg2Rad(angle)) * Cos(Deg2Rad(pitch + 90)) * Cos(Deg2Rad(yaw)) - radius * Sin(Deg2Rad(angle)) * Sin(Deg2Rad(yaw)))
			call s__Curve_setY(this,s__Curve_POINT_MIDDLE + index , s__Curve_getY(this,s__Curve_POINT_ORIGIN) + dist * Sin(Deg2Rad(yaw)) * Cos(Deg2Rad(pitch)) + radius * Cos(Deg2Rad(angle)) * Cos(Deg2Rad(pitch + 90)) * Sin(Deg2Rad(yaw)) + radius * Sin(Deg2Rad(angle)) * Cos(Deg2Rad(yaw)))
			call s__Curve_setZ(this,s__Curve_POINT_MIDDLE + index , s__Curve_getZ(this,s__Curve_POINT_ORIGIN) + dist * Sin(Deg2Rad(pitch)) + radius * Cos(Deg2Rad(pitch)) * Cos(Deg2Rad(- angle)))
  endfunction

  function s__Curve_create takes real x,real y,real z returns integer
