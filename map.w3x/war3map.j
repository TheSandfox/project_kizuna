   function s__Ability1010_a2_onComplete takes integer this returns nothing
    local integer lh= s__Lightning_create("CLSB" , sc__Object__get_x(s__Ability1010_a2_effect_1[this]) , sc__Object__get_y(s__Ability1010_a2_effect_1[this]) , sc__Object__get_z(s__Ability1010_a2_effect_1[this]) , sc__Object__get_x(s__Ability1010_a2_effect_2[this]) , sc__Object__get_y(s__Ability1010_a2_effect_2[this]) , sc__Object__get_z(s__Ability1010_a2_effect_2[this]))
    local integer lex= s__Ability1010_explosion__allocate((s__Actor_actor[((this))]) , sc__Object__get_x(s__Ability1010_a2_effect_1[this]) , sc__Object__get_y(s__Ability1010_a2_effect_1[this]) , sc__Object__get_x(s__Ability1010_a2_effect_2[this]) , sc__Object__get_y(s__Ability1010_a2_effect_2[this]) , Ability1010__BALL_RADIUS) // INLINED!!
				call s__Lightning_setDuration(lh,0.25)
				set s__Lightning_fade[lh]=3.
				set s__Explosion_damage[lex]=( s__Unit_prototype_getCarculatedStatValue((s__Actor_actor[(this)]),Ability1010__DAMAGE_STAT1) * Ability1010__DAMAGE_AMPLIFIER1 ) * ( 1 + Ability1010__DAMAGE_PER_LEVEL * s__UnitActor_level[this] ) // INLINED!!
				call s__Explosion_setDamageFlagById(lex,Ability1010__ID)
				call s__Explosion_activate(lex)
   endfunction

   function s__Ability1010_a2_periodicAction takes integer this returns nothing
				if s__Actor_stage[this] == 0 then
					if (IsUnitAlly(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))], (GetLocalPlayer()))) then // INLINED!!
						call s__Square_setLocalColor(s__Ability1010_a2_sq[this],0. , 1. , 0. , s__Line___Line_a[s__Ability1010_a2_sq[this]])
					else
						call s__Square_setLocalColor(s__Ability1010_a2_sq[this],1. , 0. , 0. , s__Line___Line_a[s__Ability1010_a2_sq[this]])
					endif
					call sc__Object__set_z(s__Ability1010_a2_effect_1[this],sc__Object__get_z(s__Ability1010_a2_effect_1[this]) + ( Ability1010__BALL_HEIGHT / Ability1010__BALL_UP ) * TIMER_TICK)
					call sc__Object__set_z(s__Ability1010_a2_effect_2[this],sc__Object__get_z(s__Ability1010_a2_effect_1[this]))
					call s__Effect_setAlpha(s__Ability1010_a2_effect_1[this],R2I(( s__Actor_timeout[this] / Ability1010__BALL_UP ) * 255))
					call s__Effect_setAlpha(s__Ability1010_a2_effect_2[this],R2I(( s__Actor_timeout[this] / Ability1010__BALL_UP ) * 255))
					if s__Actor_timeout[this] >= Ability1010__BALL_UP then
						call s__Effect_setAlpha(s__Ability1010_a2_effect_1[this],255)
						call s__Effect_setAlpha(s__Ability1010_a2_effect_2[this],255)
						call sc__Object__set_z(s__Ability1010_a2_effect_1[this],Ability1010__BALL_HEIGHT)
						call sc__Object__set_z(s__Ability1010_a2_effect_2[this],sc__Object__get_z(s__Ability1010_a2_effect_1[this]))
						call s__Actor_stageNext(this)
					endif
				endif
   endfunction

   function s__Ability1010_a2_create takes integer caster,real x,real y,real angle,integer level returns integer
    local integer this= s__Ability1010_a2__allocate(caster , 0 , x , y , level , Ability1010__DELAY , false)
				set s__Ability1010_a2_sq[this]=s__Square_create((((x )*1.0) + (( - Ability1010__BALL_RADIUS )*1.0) * Cos((( angle)*1.0) * bj_DEGTORAD)) , (((y )*1.0) + (( - Ability1010__BALL_RADIUS )*1.0) * Sin((( angle)*1.0) * bj_DEGTORAD)) , 0. , Ability1010__BALL_DISTANCE + Ability1010__BALL_RADIUS * 2 , angle , Ability1010__BALL_RADIUS , null) // INLINED!!
				set s__Ability1010_a2_effect_1[this]=s__Effect_create(Ability1010__EFFECT_PATH1 , x , y , 0. , 270.)
				set s__Ability1010_a2_effect_2[this]=s__Effect_create(Ability1010__EFFECT_PATH1 , (((x )*1.0) + (( Ability1010__BALL_DISTANCE )*1.0) * Cos((( angle)*1.0) * bj_DEGTORAD)) , (((y )*1.0) + (( Ability1010__BALL_DISTANCE )*1.0) * Sin((( angle)*1.0) * bj_DEGTORAD)) , 0. , 270.) // INLINED!!
				call s__Effect_setAlpha(s__Ability1010_a2_effect_1[this],0)
				call s__Effect_setAlpha(s__Ability1010_a2_effect_2[this],0)
				set s__Ability1010_a2_angle[this]=angle
				set s__Line___Line_alpha_max[s__Ability1010_a2_sq[this]]=0.5
				set s__Line___Line_refresh_color[s__Ability1010_a2_sq[this]]=false
				set s__Line___Line_permanent[s__Ability1010_a2_sq[this]]=true
				call s__Square_setColor(s__Ability1010_a2_sq[this],0 , 0.3 , 1. , 0.)
				set s__Line___Line_alphaaxis[(s__Ability1010_a2_sq[this])]=1 / ((Ability1010__BALL_UP)*1.0) // INLINED!!
				call s__Line___Line_setFadeOutPoint(s__Ability1010_a2_sq[this],Ability1010__DELAY , 0.25)
				// 
				call s__UnitActor_suspendFree(this)
				return this
   endfunction

   function s__Ability1010_a2_onDestroy takes integer this returns nothing
				call s__Effect_kill(s__Ability1010_a2_effect_1[this])
				call s__Effect_kill(s__Ability1010_a2_effect_2[this])
				call sc__Line___Line_deallocate(s__Ability1010_a2_sq[this])
