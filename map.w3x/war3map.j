  function s__Unit_prototype_getLuckyPercent takes integer this,real min,real const returns real
			return 1. - ( 1. - min ) * ( const / ( const + s__Unit_prototype_getCarculatedStatValue(this,CONFIG_STAT_LUCK) ) )
  endfunction

  function s__Unit_prototype_luckyTest takes integer this,real min,real const returns boolean
