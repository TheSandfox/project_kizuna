			endif
  endfunction

  function s__Item_prototype__set_origin_item takes integer this,unit it returns nothing
			if s__Item_prototype__get_origin_item(this) != null then
				call RemoveSavedInteger(ItemPrototype__HASH, GetHandleId(s__Item_prototype__get_origin_item(this)), ItemPrototype__INDEX_INSTANCE_ID)
				call RemoveUnit(s__Item_prototype__get_origin_item(this))
			endif
			if it == null then
				call RemoveSavedHandle(ItemPrototype__HASH, this, ItemPrototype__INDEX_ORIGIN_HANDLE)
			else
				call SaveUnitHandle(ItemPrototype__HASH, this, ItemPrototype__INDEX_ORIGIN_HANDLE, it)
				call SaveInteger(ItemPrototype__HASH, GetHandleId(it), ItemPrototype__INDEX_INSTANCE_ID, this)
			endif
  endfunction

