  function s__CurveBezier2_getCarculatedX takes integer this,real v returns real
   local real x1= s__Curve_getX(this,s__Curve_POINT_ORIGIN) + ( s__Curve_getX(this,s__Curve_POINT_MIDDLE + 0) - s__Curve_getX(this,s__Curve_POINT_ORIGIN) ) * v
   local real x2= s__Curve_getX(this,s__Curve_POINT_MIDDLE + 0) + ( s__Curve_getX(this,s__Curve_POINT_LAST) - s__Curve_getX(this,s__Curve_POINT_MIDDLE + 0) ) * v
			return x1 + ( x2 - x1 ) * v + sc__Object__get_offset_x(this)
  endfunction
	
  function s__CurveBezier2_getCarculatedY takes integer this,real v returns real
   local real y1= s__Curve_getY(this,s__Curve_POINT_ORIGIN) + ( s__Curve_getY(this,s__Curve_POINT_MIDDLE + 0) - s__Curve_getY(this,s__Curve_POINT_ORIGIN) ) * v
   local real y2= s__Curve_getY(this,s__Curve_POINT_MIDDLE + 0) + ( s__Curve_getY(this,s__Curve_POINT_LAST) - s__Curve_getY(this,s__Curve_POINT_MIDDLE + 0) ) * v
			return y1 + ( y2 - y1 ) * v + sc__Object__get_offset_y(this)
  endfunction
	
  function s__CurveBezier2_getCarculatedZ takes integer this,real v returns real
   local real z1= s__Curve_getZ(this,s__Curve_POINT_ORIGIN) + ( s__Curve_getZ(this,s__Curve_POINT_MIDDLE + 0) - s__Curve_getZ(this,s__Curve_POINT_ORIGIN) ) * v
   local real z2= s__Curve_getZ(this,s__Curve_POINT_MIDDLE + 0) + ( s__Curve_getZ(this,s__Curve_POINT_LAST) - s__Curve_getZ(this,s__Curve_POINT_MIDDLE + 0) ) * v
			return z1 + ( z2 - z1 ) * v + sc__Object__get_offset_z(this)
  endfunction
	

	
  function s__CurveBezier3_getCarculatedX takes integer this,real v returns real
   local real hx1= s__Curve_getX(this,s__Curve_POINT_ORIGIN) + ( s__Curve_getX(this,s__Curve_POINT_MIDDLE + 0) - s__Curve_getX(this,s__Curve_POINT_ORIGIN) ) * v
   local real hx2= s__Curve_getX(this,s__Curve_POINT_MIDDLE + 0) + ( s__Curve_getX(this,s__Curve_POINT_MIDDLE + 1) - s__Curve_getX(this,s__Curve_POINT_MIDDLE + 0) ) * v
   local real hx3= s__Curve_getX(this,s__Curve_POINT_MIDDLE + 1) + ( s__Curve_getX(this,s__Curve_POINT_LAST) - s__Curve_getX(this,s__Curve_POINT_MIDDLE + 1) ) * v
   local real x1= hx1 + ( hx2 - hx1 ) * v
   local real x2= hx2 + ( hx3 - hx2 ) * v
			return x1 + ( x2 - x1 ) * v + sc__Object__get_offset_x(this)
  endfunction
	
  function s__CurveBezier3_getCarculatedY takes integer this,real v returns real
   local real hy1= s__Curve_getY(this,s__Curve_POINT_ORIGIN) + ( s__Curve_getY(this,s__Curve_POINT_MIDDLE + 0) - s__Curve_getY(this,s__Curve_POINT_ORIGIN) ) * v
   local real hy2= s__Curve_getY(this,s__Curve_POINT_MIDDLE + 0) + ( s__Curve_getY(this,s__Curve_POINT_MIDDLE + 1) - s__Curve_getY(this,s__Curve_POINT_MIDDLE + 0) ) * v
   local real hy3= s__Curve_getY(this,s__Curve_POINT_MIDDLE + 1) + ( s__Curve_getY(this,s__Curve_POINT_LAST) - s__Curve_getY(this,s__Curve_POINT_MIDDLE + 1) ) * v
   local real y1= hy1 + ( hy2 - hy1 ) * v
   local real y2= hy2 + ( hy3 - hy2 ) * v
			return y1 + ( y2 - y1 ) * v + sc__Object__get_offset_y(this)
  endfunction
	
  function s__CurveBezier3_getCarculatedZ takes integer this,real v returns real
   local real hz1= s__Curve_getZ(this,s__Curve_POINT_ORIGIN) + ( s__Curve_getZ(this,s__Curve_POINT_MIDDLE + 0) - s__Curve_getZ(this,s__Curve_POINT_ORIGIN) ) * v
   local real hz2= s__Curve_getZ(this,s__Curve_POINT_MIDDLE + 0) + ( s__Curve_getZ(this,s__Curve_POINT_MIDDLE + 1) - s__Curve_getZ(this,s__Curve_POINT_MIDDLE + 0) ) * v
   local real hz3= s__Curve_getZ(this,s__Curve_POINT_MIDDLE + 1) + ( s__Curve_getZ(this,s__Curve_POINT_LAST) - s__Curve_getZ(this,s__Curve_POINT_MIDDLE + 1) ) * v
   local real z1= hz1 + ( hz2 - hz1 ) * v
   local real z2= hz2 + ( hz3 - hz2 ) * v
			return z1 + ( z2 - z1 ) * v + sc__Object__get_offset_z(this)
  endfunction
	


