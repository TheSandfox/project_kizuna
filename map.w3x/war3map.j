  function s__Unit_getUpgradePoint takes integer this,integer index returns integer
			return s__SimpleList_get(s__Unit_upgrade_point[this],index)
  endfunction

  function s__Unit_setUpgradePoint takes integer this,integer index,integer val returns nothing
			call s__SimpleList_setData(s__Unit_upgrade_point[this],index , val)
			set s__AbilityManager_REFRESH_SKILLPOINT_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[(this)])) // INLINED!!
			call TriggerEvaluate(s__AbilityManager_REFRESH_SKILLPOINT_TRIGGER)
  endfunction

  function s__Unit_addUpgradePoint takes integer this,integer index,integer val returns nothing
			call s__Unit_setUpgradePoint(this,index , (s__SimpleList_get(s__Unit_upgrade_point[(this)],(index))) + val) // INLINED!!
  endfunction

		
		
  function s__Unit_copyAbility takes integer this,integer target returns nothing
   local integer i= 0
   local integer a= 0
   local integer ta= 0
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				set ta=s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[target],i)
				if ta > 0 then
					
					set a=s__Unit_prototype_addAbility(this,s__Ability_prototype_id[ta])
					if a > 0 then
						
						call sc__Ability_prototype_addLevel(a,s__Ability_prototype_level[ta] - 1)
						
						if s__Unit_prototype_weapon_ability[target] == ta then
							call s__Unit_prototype_setWeaponAbility(this,a)
						endif
					endif
				endif
				set i=i + 1
			endloop
  endfunction

  function s__Unit_onLevel takes nothing returns nothing
   local integer i= 0
   local integer a= 0
   local integer this= CUSTOM_RESPOND_LEVEL_UNIT
			if CUSTOM_RESPOND_LEVEL_UNIT <= 0 or CUSTOM_RESPOND_LEVEL_LEVEL <= 0 then
				return
			endif
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				set a=s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[this],i)
				if a > 0 and s__Ability_signature[a] then
					if s__Ability_prototype_level[a] + CUSTOM_RESPOND_LEVEL_LEVEL > s__Ability_level_max[a] then
						
						call s__User_addGold((GetOwningPlayer(s__Unit_prototype_origin_unit[(this)])) , (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_COST)) * ( CUSTOM_RESPOND_LEVEL_LEVEL - s__Ability_level_max[a] + s__Ability_prototype_level[a] )) // INLINED!!
						call sc__Ability_prototype_addLevel(a,s__Ability_level_max[a] - s__Ability_prototype_level[a])
						
						call SaveInteger(Ability__HASH2, (a), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_EXP ), ( (LoadInteger(Ability__HASH2, (a), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_EXP))) + (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER)) * ( s__Ability_level_max[a] - s__Ability_prototype_level[a] ))) // INLINED!!
					else
						
						call sc__Ability_prototype_addLevel(a,CUSTOM_RESPOND_LEVEL_LEVEL)
						
						call SaveInteger(Ability__HASH2, (a), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_EXP ), ( (LoadInteger(Ability__HASH2, (a), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_EXP))) + (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[a]), s__Ability_INDEX_TIER)) * CUSTOM_RESPOND_LEVEL_LEVEL)) // INLINED!!
					endif
				endif
				set i=i + 1
			endloop
			call s__Unit_setUpgradePoint(this,CONFIG_UPGRADE_SKILL_POINT , (s__SimpleList_get(s__Unit_upgrade_point[(this)],(CONFIG_UPGRADE_SKILL_POINT))) + CUSTOM_RESPOND_LEVEL_LEVEL * s__Unit_SKILLPOINT_PER_LEVEL) // INLINED!!
			set s__Unit_removepoint[this]=s__Unit_removepoint[this] + CUSTOM_RESPOND_LEVEL_LEVEL * s__Unit_REMOVEPOINT_PER_LEVEL
			set CUSTOM_RESPOND_UI_REFRESH_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[(this)])) // INLINED!!
			call s__Event_activate(CONFIG_EVENT_ABILITY_UI_REFRESH)
			set CUSTOM_RESPOND_UI_REFRESH_PLAYER=null
  endfunction

  function s__Unit_loveDamageCallback takes nothing returns nothing
   local integer attacker= CUSTOM_RESPOND_DAMAGE_ATTACKER
   local real love= s__Unit_prototype_getCarculatedStatValue(attacker,CONFIG_STAT_LOVE)
			
			if love <= 0. then
				return
			endif
			
			set CUSTOM_RESPOND_DAMAGE_AMOUNT=CUSTOM_RESPOND_DAMAGE_AMOUNT * ( 100.0 / ( 100.0 + love ) )
  endfunction

  function s__Unit_loveShieldCallback takes nothing returns nothing
   local integer caster= 0
   local integer target= 0
   local real val= 0.
			
			if CUSTOM_RESPOND_SHIELD_CASTER == CUSTOM_RESPOND_SHIELD_TARGET then
				return
			endif
			set caster=CUSTOM_RESPOND_SHIELD_CASTER
			set target=CUSTOM_RESPOND_SHIELD_TARGET
			call BJDebugMsg("러브보너스!!")
			call BJDebugMsg("적용전:" + I2S(R2I(CUSTOM_RESPOND_SHIELD_AMOUNT)))
			
			set val=s__Unit_prototype_getCarculatedStatValue(caster,CONFIG_STAT_LOVE)
			if val >= 0. then
				set CUSTOM_RESPOND_SHIELD_AMOUNT=CUSTOM_RESPOND_SHIELD_AMOUNT * ( ( 100.0 + val ) / 100.0 )
			else
				set CUSTOM_RESPOND_SHIELD_AMOUNT=CUSTOM_RESPOND_SHIELD_AMOUNT * ( 100.0 / ( 100.0 + val ) )
			endif
			
			set val=s__Unit_prototype_getCarculatedStatValue(target,CONFIG_STAT_LOVE)
			if val >= 0. then
				set CUSTOM_RESPOND_SHIELD_AMOUNT=CUSTOM_RESPOND_SHIELD_AMOUNT * ( ( 100.0 + val ) / 100.0 )
			else
				set CUSTOM_RESPOND_SHIELD_AMOUNT=CUSTOM_RESPOND_SHIELD_AMOUNT * ( 100.0 / ( 100.0 + val ) )
			endif
			call BJDebugMsg("적용후:" + I2S(R2I(CUSTOM_RESPOND_SHIELD_AMOUNT)))
			call BJDebugMsg("//===================")
  endfunction

  function s__Unit_loveHealCallback takes nothing returns nothing
   local integer caster= 0
   local integer target= 0
   local real val= 0.
			
			if CUSTOM_RESPOND_HEAL_CASTER == CUSTOM_RESPOND_HEAL_TARGET then
				return
			endif
			set caster=CUSTOM_RESPOND_HEAL_CASTER
			set target=CUSTOM_RESPOND_HEAL_TARGET
			call BJDebugMsg("러브보너스!!")
			call BJDebugMsg("적용전:" + I2S(R2I(CUSTOM_RESPOND_HEAL_AMOUNT)))
			
			set val=s__Unit_prototype_getCarculatedStatValue(caster,CONFIG_STAT_LOVE)
			if val >= 0. then
				set CUSTOM_RESPOND_HEAL_AMOUNT=CUSTOM_RESPOND_HEAL_AMOUNT * ( ( 100.0 + val ) / 100.0 )
			else
				set CUSTOM_RESPOND_HEAL_AMOUNT=CUSTOM_RESPOND_HEAL_AMOUNT * ( 100.0 / ( 100.0 + val ) )
			endif
			
			set val=s__Unit_prototype_getCarculatedStatValue(target,CONFIG_STAT_LOVE)
			if val >= 0. then
				set CUSTOM_RESPOND_HEAL_AMOUNT=CUSTOM_RESPOND_HEAL_AMOUNT * ( ( 100.0 + val ) / 100.0 )
			else
				set CUSTOM_RESPOND_HEAL_AMOUNT=CUSTOM_RESPOND_HEAL_AMOUNT * ( 100.0 / ( 100.0 + val ) )
			endif
			call BJDebugMsg("적용후:" + I2S(R2I(CUSTOM_RESPOND_HEAL_AMOUNT)))
			call BJDebugMsg("//===================")
  endfunction

  function s__Unit_setChingho takes integer this,integer id returns nothing
			if s__Unit_chingho[this] > 0 then
				call sc__Ability_prototype_deallocate(s__Unit_chingho[this])
			endif
			call s__Ability_prototype_new(id)
			set s__Unit_chingho[this]=ABILITY_LAST_CREATED
			if s__Unit_chingho[this] > 0 then
				
				set s__Ability_prototype_owner[s__Unit_chingho[this]]=this
				call sc__Ability_prototype_init(s__Unit_chingho[this])
				call BlzSetHeroProperName(s__Unit_prototype_origin_unit[this], "|cffffcc00[" + s__Ability_prototype_name[s__Unit_chingho[this]] + "]|r\n" + s__Unit_prototype_origin_name[this])
			endif
  endfunction

  function s__Unit_copyStat takes integer this,integer stattype returns nothing
			if HaveSavedReal(s__UnitData_HASH, (GetUnitTypeId(s__Unit_prototype_origin_unit[(this)])), s__UnitData_INDEX_STAT + ( stattype * CONFIG_STAT_INDEX_SIZE ) + CONFIG_STAT_INDEX_BASE) then // INLINED!!
				call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * CONFIG_STAT_INDEX_SIZE + ( CONFIG_STAT_INDEX_BASE ) ), (( (( LoadReal(s__UnitData_HASH, (GetUnitTypeId(s__Unit_prototype_origin_unit[(this)])), s__UnitData_INDEX_STAT + ( stattype * CONFIG_STAT_INDEX_SIZE ) + CONFIG_STAT_INDEX_BASE))*1.0))*1.0)) // INLINED!!
			else
				call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * CONFIG_STAT_INDEX_SIZE + ( CONFIG_STAT_INDEX_BASE ) ), (( (( LoadReal(s__UnitData_HASH, 0, s__UnitData_INDEX_STAT + ( stattype * CONFIG_STAT_INDEX_SIZE ) + CONFIG_STAT_INDEX_BASE))*1.0))*1.0)) // INLINED!!
			endif
			if HaveSavedReal(s__UnitData_HASH, (GetUnitTypeId(s__Unit_prototype_origin_unit[(this)])), s__UnitData_INDEX_STAT + ( stattype * CONFIG_STAT_INDEX_SIZE ) + CONFIG_STAT_INDEX_LEVEL) then // INLINED!!
				call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * CONFIG_STAT_INDEX_SIZE + ( CONFIG_STAT_INDEX_LEVEL ) ), (( (( LoadReal(s__UnitData_HASH, (GetUnitTypeId(s__Unit_prototype_origin_unit[(this)])), s__UnitData_INDEX_STAT + ( stattype * CONFIG_STAT_INDEX_SIZE ) + CONFIG_STAT_INDEX_LEVEL))*1.0))*1.0)) // INLINED!!
			else
				call SaveReal(Hash___D, (((s__Unit_prototype_stat_data[this]))), ((stattype ) * CONFIG_STAT_INDEX_SIZE + ( CONFIG_STAT_INDEX_LEVEL ) ), (( (( LoadReal(s__UnitData_HASH, 0, s__UnitData_INDEX_STAT + ( stattype * CONFIG_STAT_INDEX_SIZE ) + CONFIG_STAT_INDEX_LEVEL))*1.0))*1.0)) // INLINED!!
			endif
			call s__Unit_prototype_refreshStatValue(this,stattype)
  endfunction

  function s__Unit_copyStats takes integer this returns nothing
			call s__Unit_copyStat(this,CONFIG_STAT_MAXHP)
			call s__Unit_copyStat(this,CONFIG_STAT_MAXMP)
			call s__Unit_copyStat(this,CONFIG_STAT_ATTACK)
			call s__Unit_copyStat(this,CONFIG_STAT_DEFENSE)
			call s__Unit_copyStat(this,CONFIG_STAT_MAGICPOWER)
			call s__Unit_copyStat(this,CONFIG_STAT_RESISTANCE)
			call s__Unit_copyStat(this,CONFIG_STAT_ACCURACY)
			call s__Unit_copyStat(this,CONFIG_STAT_EVASION)
			call s__Unit_copyStat(this,CONFIG_STAT_HPREGEN)
			call s__Unit_copyStat(this,CONFIG_STAT_MPREGEN)
			call s__Unit_prototype__set_mp(this,(s__Unit_prototype_maxmp_true[(this)])) // INLINED!!
  endfunction

  function s__Unit_loadAbility takes integer this returns nothing
   local integer i= 0
   local integer lc= 0
			if not s__Unit_LOAD_ABILITY then
				return
			endif
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE or s__UnitData_getInitialAbility((GetUnitTypeId(s__Unit_prototype_origin_unit[(this)])) , i) <= 0 // INLINED!!
				set lc=s__Unit_prototype_addAbility(this,s__UnitData_getInitialAbility((GetUnitTypeId(s__Unit_prototype_origin_unit[(this)])) , i)) // INLINED!!
				
				call SaveInteger(Ability__HASH2, (lc), s__Ability_INDEX_UPGRADE_POINT + (CONFIG_UPGRADE_EXP ), ( (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[lc]), s__Ability_INDEX_TIER)))) // INLINED!!
				set s__Ability_signature[lc]=true
				if (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[lc]), s__Ability_INDEX_CAST_TYPE)) == CONFIG_CAST_TYPE_WEAPON then // INLINED!!
					call s__Unit_prototype_setWeaponAbility(this,lc)
				endif
				set i=i + 1
			endloop
  endfunction

  function s__Unit_initClass takes integer this returns nothing
			call s__UnitClass_addClass((this),CONFIG_UNIT_CLASS_POMANGAM_MAX , CONFIG_UNIT_CLASS_MAX_VALUE)
			call s__UnitClass_addClass((this),CONFIG_UNIT_CLASS_ADDICT_MAX , CONFIG_UNIT_CLASS_MAX_VALUE)
  endfunction

  function s__Unit_create takes player p,integer uid,real x,real y,real yaw returns integer
   local integer this= s__Unit__allocate(p , uid , x , y , yaw)
   local integer i= 0
			call s__Unit_copyStats(this)
			call s__Unit_loadAbility(this)
			call s__Unit_initClass(this)
			set s__Unit_upgrade_point[this]=s__SimpleList_create(CONFIG_UPGRADE_MAX)
			set s__Object_class[this]="Unit"
			loop
				exitwhen i >= CONFIG_UPGRADE_MAX
				call s__Unit_setUpgradePoint(this,i , 0)
				set i=i + 1
			endloop
			return this
  endfunction

  function s__Unit_onDestroy takes integer this returns nothing
			if s__Unit_chingho[this] > 0 then
				call sc__Ability_prototype_deallocate(s__Unit_chingho[this])
			endif
			call sc__ArrayList_prototype_deallocate(s__Unit_upgrade_point[this])
			call s__UnitClass_clearClass((this))
  endfunction

		

  function s__Unit_onInit takes nothing returns nothing
   local trigger t= null
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_LEVEL)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Unit_onLevel))
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_DAMAGE_LAST)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Unit_loveDamageCallback))
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_HEAL_LAST)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Unit_loveHealCallback))
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_SHIELD_LAST)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Unit_loveShieldCallback))
			
			
			set t=null
  endfunction



