   local integer i= s__ArrayList_size[this]
			
			if index < 0 then
				set index=0
				return
			endif
			
			if index >= s__ArrayList_size[this] then
				call s__ArrayList_add(this,val)
				return
			endif
			loop
				
				exitwhen i <= index
				call s__ArrayList_setData(this,i , s__ArrayList_get(this,i - 1))
				set i=i - 1
			endloop
			call s__ArrayList_setData(this,index , val)
			set s__ArrayList_size[this]=s__ArrayList_size[this] + 1
			set s__ArrayList_CURRENT_INDEX=index
			call s__ArrayList_onAdd(this,val)
  endfunction

  function s__ArrayList_remove takes integer this,integer index returns nothing
			call s__ArrayList_pull(this,index)
  endfunction

  function s__ArrayList_clear takes integer this returns nothing
   local integer i= 0
			loop
				exitwhen i >= s__ArrayList_size[this]
				set s__ArrayList_CURRENT_INDEX=i
				call s__ArrayList_onRemove(this,s__ArrayList_get(this,i))
				set i=i + 1
			endloop
			call FlushChildHashtable(ArrayList___HASH, this)
			set s__ArrayList_size[this]=0
  endfunction

  function s__ArrayList_create takes nothing returns integer
   local integer this= s__ArrayList__allocate()
			return this
  endfunction

  function s__ArrayList_onDestroy takes integer this returns nothing
			call s__ArrayList_clear(this)
  endfunction


