			call s__Trigger_addCondition(s__Buff20k0_main_main_trigger[this],function s__Buff20k0_main_damageCallback)
			
			call s__Effect_kill(s__Effect_create(Buff20k0__EFFECT_PATH1 , sc__Object__get_x(s__Buff_target[this]) , sc__Object__get_y(s__Buff_target[this]) , sc__Object__get_z(s__Buff_target[this]) + s__Object_pivot_z[s__Buff_target[this]] , 0))
			
			call s__Transform_register((this))
			return true
  endfunction

  function s__Buff20k0_main_onDestroy takes integer this returns nothing
			call s__Unit_prototype_multiplyStatValue(s__Buff_target[this],ENUM_STAT_MAXHP , - Buff20k0_DATA_REAL1)
			call s__Unit_prototype_plusStatValue(s__Buff_target[this],ENUM_STAT_MOVEMENT_SPEED , - Buff20k0_DATA_INTEGER1)
			call s__Unit_prototype_removeSkin(s__Buff_target[this],Buff20k0__SKIN_ID)
			set Buff20k0_MY_RESPOND_ABILITY=s__Ability_prototype_getUnitAbilityById(s__Buff_caster[this] , Buff20k0_ID)
			if Buff20k0_MY_RESPOND_ABILITY > 0 then
				set Buff20k0_MY_RESPOND_EVENT_ID=1
				call TriggerEvaluate(Buff20k0_MY_RESPOND)
			endif
			
			call sc__Trigger_prototype_deallocate(s__Buff20k0_main_main_trigger[this])
			
			call s__Effect_kill(s__Effect_create(Buff20k0__EFFECT_PATH1 , sc__Object__get_x(s__Buff_target[this]) , sc__Object__get_y(s__Buff_target[this]) , sc__Object__get_z(s__Buff_target[this]) + s__Object_pivot_z[s__Buff_target[this]] , 0))
			
