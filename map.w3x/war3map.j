			set s__UnitActor_suspend_event_status[this]=status
  endfunction

		
  function s__UnitActor_suspendFilter takes integer this returns boolean
			if s__UnitActor_suspend_stun[this] and sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[(s__Actor_actor[(this)])],ENUM_STATUS_STUN) > 0 then // INLINED!!
				call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_STATUS , ENUM_STATUS_STUN)
				return true
			elseif s__UnitActor_suspend_grabbed[this] and sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[(s__Actor_actor[(this)])],ENUM_STATUS_GRABBED) > 0 then // INLINED!!
				call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_STATUS , ENUM_STATUS_GRABBED)
				return true
			elseif s__UnitActor_suspend_ensnare[this] and sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[(s__Actor_actor[(this)])],ENUM_STATUS_ENSNARE) > 0 then // INLINED!!
				call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_STATUS , ENUM_STATUS_ENSNARE)
				return true
			elseif s__UnitActor_suspend_silence[this] and sc__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[(s__Actor_actor[(this)])],ENUM_STATUS_SILENCE) > 0 then // INLINED!!
				call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_STATUS , ENUM_STATUS_SILENCE)
				return true
			elseif s__UnitActor_suspend_dead[this] and sc__Unit_prototype_isUnitType((s__Actor_actor[(this)]),UNIT_TYPE_DEAD) then // INLINED!!
				call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_STATUS , ENUM_STATUS_DEAD)
				return true
			elseif s__UnitActor_suspend_target_dead[this] and s__UnitActor_target[this] > 0 and sc__Unit_prototype_isUnitType((s__UnitActor_target[this]),UNIT_TYPE_DEAD) then
				call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_TARGET_LOSS , ENUM_STATUS_WHOKNOWS)
				return true
			endif
			return sc__UnitActor_suspendFilterAdditional(this)
  endfunction

		
  function s__UnitActor_suspendAction takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if (udg_EVENT_VALUE) == ENUM_EVENT_KEYPRESS and EVT_KEYPRESS_PRESS then // INLINED!!
				if EVT_KEYPRESS_CASTER != (s__Actor_actor[(this)]) or EVT_KEYPRESS_CASTER <= 0 then // INLINED!!
					return
				endif
				if EVT_KEYPRESS_KEY != OSKEY_S and EVT_KEYPRESS_KEY != OSKEY_H then
					return
				endif
				if s__UnitActor_suspend_stop[this] then
					
					call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_KEYPRESS , ENUM_STATUS_WHOKNOWS)
					call sc__Actor_onSuspend(this)
					call sc__Actor_prototype_deallocate(this)
				else
					call sc__UnitActor_onStop(this)
				endif
				return
			endif
			if (udg_EVENT_VALUE) == ENUM_EVENT_CLICK and EVT_CLICK_BUTTON_TYPE == MOUSE_BUTTON_TYPE_RIGHT then // INLINED!!
				if EVT_CLICK_CASTER == (s__Actor_actor[(this)]) then // INLINED!!
					if s__UnitActor_suspend_rclick[this] and sc__Unit_prototype_isMoveable((s__Actor_actor[(this)])) then // INLINED!!
						
						if s__UnitActor_target[this] > 0 then
							
							if s__Unit_prototype_origin_unit[(s__UnitActor_target[this])] != EVT_CLICK_TARGET then
								
								call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_CLICK , ENUM_STATUS_WHOKNOWS)
								call sc__Actor_onSuspend(this)
								call sc__Actor_prototype_deallocate(this)
								return
							endif
						else
							
							call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_CLICK , ENUM_STATUS_WHOKNOWS)
							call sc__Actor_onSuspend(this)
							call sc__Actor_prototype_deallocate(this)
							return
						endif
					else
						
						call sc__UnitActor_onRightClick(this)
						return
					endif
				endif
			endif
			if (udg_EVENT_VALUE) == ENUM_EVENT_ABILITY_FOLLOW then // INLINED!!
				if EVT_ABILITY_CASTER == (s__Actor_actor[(this)]) and s__UnitActor_suspend_ability[this] then // INLINED!!
					if not s__Ability_prototype_useable_cast[(EVT_ABILITY_INSTANCE)] then
						call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_CLICK , ENUM_STATUS_WHOKNOWS)
						call sc__Actor_onSuspend(this)
						call sc__Actor_prototype_deallocate(this)
						return
					endif
				endif
				return
			endif
			if (udg_EVENT_VALUE) == ENUM_EVENT_DECAY then // INLINED!!
				if (s__Actor_actor[(this)]) > 0 and (s__Actor_actor[(this)]) == EVT_DECAY_UNIT then // INLINED!!
					call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_STATUS , ENUM_STATUS_DEAD)
					call sc__Actor_onSuspend(this)
					call sc__Actor_prototype_deallocate(this)
					return
				endif
				if s__UnitActor_target[this] > 0 and s__UnitActor_target[this] == EVT_DECAY_UNIT then
					if s__UnitActor_suspend_target_decay[this] then
						call s__UnitActor_setSuspendEventFlag(this,s__Actor_SUSPEND_TYPE_TARGET_LOSS , ENUM_STATUS_WHOKNOWS)
						call sc__Actor_onSuspend(this)
						call sc__Actor_prototype_deallocate(this)
						return
					else
						call sc__UnitActor_targetDecay(this)
					endif
				endif
				return
			endif
  endfunction

  function s__UnitActor_registerSuspendTrigger takes integer this returns nothing
			set s__UnitActor_suspend_trigger[this]=s__Trigger_create(this)
			call s__Trigger_addCondition(s__UnitActor_suspend_trigger[this],function s__UnitActor_suspendAction)
