  endfunction

  function s__Unit_prototype__get_hp takes integer this returns real
			return s__Unit_prototype_hp_true[this]
  endfunction

  function s__Unit_prototype_revive takes integer this returns nothing
			if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],ENUM_STATUS_DEAD) > 0 and s__Unit_prototype_is_revive[this] then
				call sc__Unit_prototype_minusStatus(this,ENUM_STATUS_DEAD)
			endif
  endfunction

  function s__Unit_prototype__set_hp takes integer this,real np returns nothing
			if np > 0. then
				if np >= 1. then
					call SetUnitState(s__Unit_prototype_origin_unit[this], UNIT_STATE_LIFE, np)
				else
					call SetUnitState(s__Unit_prototype_origin_unit[this], UNIT_STATE_LIFE, 1.)
				endif
				set s__Unit_prototype_hp_true[this]=np
				if s__Unit_prototype_hp_true[this] >= s__Unit_prototype_maxhp_true[this] then
					if s__Unit_prototype_maxhp_true[this] > 0. then
						
						set s__Unit_prototype_hp_true[this]=s__Unit_prototype_maxhp_true[this]
						call s__Unit_prototype_revive(this)
					else
						
						set s__Unit_prototype_hp_true[this]=0.
						call sc__Unit_prototype_kill(this)
					endif
				endif
			else
				set s__Unit_prototype_hp_true[this]=0.
				call sc__Unit_prototype_kill(this)
			endif
  endfunction

  function s__Unit_prototype__get_hpregen takes integer this returns real
			return s__Unit_prototype_getCalculatedStatValue(this,ENUM_STAT_HPREGEN)
  endfunction

  function s__Unit_prototype_healUnit takes integer this,integer target,real nv returns nothing
   local real val= 0.
			
			
			set EVT_HEAL_CASTER=this
			set EVT_HEAL_TARGET=target
			set EVT_HEAL_AMOUNT=nv
			set EVT_HEAL_PLUS=0.
			set EVT_HEAL_MULTIPLY=1.0
			set EVT_HEAL_DIVIDE=1.0
			set EVT_HEAL_MINUS=0.
			//
			
			call s__Event_activate(ENUM_EVENT_HEAL_MODIFY_STAT)
			call s__Event_activate(ENUM_EVENT_HEAL_MODIFY)
			//
			
			set EVT_HEAL_AMOUNT=( ( ( EVT_HEAL_AMOUNT + EVT_HEAL_PLUS ) * EVT_HEAL_MULTIPLY ) / EVT_HEAL_DIVIDE ) - EVT_HEAL_MINUS
			
			set EVT_HEAL_AMOUNT=EVT_HEAL_AMOUNT * s__Unit_prototype_getCalculatedStatValue(target,ENUM_STAT_HEAL_AMP)
			
			call s__Event_activate(ENUM_EVENT_HEAL_LAST)
			
			call s__Unit_prototype__set_hp(target,(s__Unit_prototype_hp_true[(target)]) + EVT_HEAL_AMOUNT) // INLINED!!
  endfunction

  function s__Unit_prototype__get_maxhp takes integer this returns real
			return s__Unit_prototype_maxhp_true[this]
  endfunction

  function s__Unit_prototype__set_maxhp takes integer this,real np returns nothing
   local real v= 0.
			if s__Unit_prototype_maxhp_true[this] > 0. then
				set v=s__Unit_prototype_hp_true[this] / s__Unit_prototype_maxhp_true[this]
			endif
			set s__Unit_prototype_maxhp_true[this]=np
			if np <= 1. then
				call BlzSetUnitMaxHP(s__Unit_prototype_origin_unit[this], R2I(1.))
			else
				call BlzSetUnitMaxHP(s__Unit_prototype_origin_unit[this], R2I(np))
			endif
			call s__Unit_prototype__set_hp(this,(s__Unit_prototype_maxhp_true[(this)]) * v) // INLINED!!
  endfunction

  function s__Unit_prototype__get_mp takes integer this returns real
			return s__Unit_prototype_mp_true[this]
  endfunction

  function s__Unit_prototype__set_mp takes integer this,real np returns nothing
			set s__Unit_prototype_mp_true[this]=np
			if s__Unit_prototype_mp_true[this] >= s__Unit_prototype_maxmp_true[this] then
				set s__Unit_prototype_mp_true[this]=s__Unit_prototype_maxmp_true[this]
			endif
			if s__Unit_prototype_mp_true[this] < 0. then
				set s__Unit_prototype_mp_true[this]=0.
			endif
			call SetUnitState(s__Unit_prototype_origin_unit[this], UNIT_STATE_MANA, s__Unit_prototype_mp_true[this])
  endfunction

