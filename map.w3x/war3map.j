   function s__Ability10t0_main_refresh takes integer this,boolean b returns nothing
				if s__Ability10t0_main_v[this] > 0. then
					call s__Unit_prototype_multiplyStatValue(s__Ability_prototype_owner[this],Ability10t0__STAT_BONUS1 , - s__Ability10t0_main_v[this])
				endif
				set s__Ability10t0_main_v[this]=0.
				if b then
					set s__Ability10t0_main_v[this]=Ability10t0__DAMAGE_BASE + ( Ability10t0__DAMAGE_PER_LEVEL * s__Ability_prototype_level[this] )
					call s__Unit_prototype_multiplyStatValue(s__Ability_prototype_owner[this],Ability10t0__STAT_BONUS1 , s__Ability10t0_main_v[this])
				endif
   endfunction

   function s__Ability10t0_main_update takes integer this,integer val returns nothing
				call s__Ability10t0_main_refresh(this,true)
   endfunction

