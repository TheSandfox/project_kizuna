				call sc__Unit_prototype_minusStatus(this,CONFIG_STATUS_DEAD)
			endif
  endfunction

  function s__Unit_prototype__set_hp takes integer this,real np returns nothing
			if np > 0. then
				if np >= 1. then
					call SetUnitState(s__Unit_prototype_origin_unit[this], UNIT_STATE_LIFE, np)
				else
					call SetUnitState(s__Unit_prototype_origin_unit[this], UNIT_STATE_LIFE, 1.)
				endif
				set s__Unit_prototype_hp_true[this]=np
				if s__Unit_prototype_hp_true[this] >= s__Unit_prototype_maxhp_true[this] then
					if s__Unit_prototype_maxhp_true[this] > 0. then
						
						set s__Unit_prototype_hp_true[this]=s__Unit_prototype_maxhp_true[this]
						call s__Unit_prototype_revive(this)
					else
						
						set s__Unit_prototype_hp_true[this]=0.
						call sc__Unit_prototype_kill(this)
					endif
				endif
			else
				set s__Unit_prototype_hp_true[this]=0.
				call sc__Unit_prototype_kill(this)
			endif
  endfunction

