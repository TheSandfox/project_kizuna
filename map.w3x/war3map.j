   function s__Ability1000_mv_executeExplosion takes integer this,integer target returns nothing
    local integer kn= s__Knockback_create(target , Ability1000__KNOCKBACK_DISTANCE / Ability1000__KNOCKBACK_DURATION , sc__Object__get_yaw((s__Actor_actor[(this)]))) // INLINED!!
				if kn > 0 then
					set s__Movement_z_velo[kn]=300.
					set s__Movement_gravity[kn]=( 300. * 2 ) / Ability1000__KNOCKBACK_DURATION
					set s__Actor_duration[kn]=Ability1000__KNOCKBACK_DURATION
				endif
				call s__UnitMovement_setDamageFlagById(this,Ability1000__ID)
				if target == sc__Movement__get_target(this) then
					call s__UnitMovement_customDamageTarget(this,target , s__UnitMovement_damage[this] * Ability1000__DAMAGE_PRIMARY)
				else
					call s__UnitMovement_customDamageTarget(this,target , s__UnitMovement_damage[this])
				endif
				call s__Effect_kill(s__Effect_setScale(s__Effect_create(EF_ROCK , sc__Object__get_x(target) , sc__Object__get_y(target) , sc__Object__get_z(target) + s__Object_pivot_z[target] , 0),2.5))
				call s__Buff_add(0 , target , 'Stun' , 0 , 0.5)
   endfunction
	
   function s__Ability1000_mv_executeTarget takes integer this,integer target returns nothing
				call s__Movement__set_target(this,target)
				call s__UnitMovement_explosionAction(this)
				set s__Actor_want_destroy[this]=true
				call s__UnitActor_create((s__Actor_actor[(this)]) , 0 , 0. , 0. , 0 , Ability1000__BACKSWING , true) // INLINED!!
				call IssueTargetOrder(s__Unit_prototype_origin_unit[((s__Actor_actor[(this)]))], ("attack" ), ( s__Unit_prototype_origin_unit[target])) // INLINED!!
   endfunction
	
   function s__Ability1000_mv_create takes integer u,real yaw,integer level returns integer
//textmacro instance: chargeAllocate("u","CHARGE_SPEED","yaw")
   local integer this= s__Ability1000_mv__allocate(u , Ability1000__CHARGE_SPEED , yaw)
			if this <= 0 then
				return 0
			endif
//end of: chargeAllocate("u","CHARGE_SPEED","yaw")
				set s__Movement_use_collision[this]=true
				set s__Actor_duration[this]=Ability1000__CHARGE_DURATION
				set s__Movement_refresh_facing[this]=false
				set s__UnitMovement_level[this]=level
				set s__UnitMovement_flag_collision[this]=true
				set s__UnitMovement_radius_target[this]=Ability1000__RADIUS2
				set s__UnitMovement_radius_explosion[this]=125.
				call s__Unit_prototype_setAnimSpeed((s__Actor_actor[(this)]),1.0 * (s__Unit_prototype_getCarculatedStatValue(((s__Actor_actor[(this)])),CONFIG_STAT_ATTACK_SPEED))) // INLINED!!
				call s__Unit_prototype_queueAnim((s__Actor_actor[(this)]),"stand") // INLINED!!
				call s__Effect_kill(s__Effect_setPitch(s__Effect_create(EF_ROCK , sc__Object__get_x(u) , sc__Object__get_y(u) , sc__Object__get_z(u) , 0),- 90))
				call s__UnitMovement_carculateDamage(this,( s__Unit_prototype_getCarculatedStatValue((s__Actor_actor[(this)]),Ability1000__DAMAGE_STAT1) * Ability1000__DAMAGE_AMPLIFIER1 ) * ( 1 + Ability1000__DAMAGE_PER_LEVEL * s__UnitMovement_level[this] )) // INLINED!!
				return this
   endfunction
	
   function s__Ability1000_mv_onDestroy takes integer this returns nothing
				call s__Unit_prototype_setAnimSpeed((s__Actor_actor[(this)]),1.0) // INLINED!!
   endfunction
	
	
	

