			call sc__Trigger_prototype_deallocate(s__Buff20g0_main_trig[this])
			call s__Unit_prototype_multiplyStatValue(s__Buff_target[this],CONFIG_STAT_ATTACK_SPEED , - Buff20g0_DATA_REAL1)
			call s__Effect_kill(s__Buff20g0_main_e1[this])
			call s__Effect_kill(s__Buff20g0_main_e2[this])
			set s__Buff20g0_main_e1[this]=0
			set s__Buff20g0_main_e2[this]=0
  endfunction


