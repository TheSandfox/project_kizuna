    endfunction

 function s__AbilityIcon_forceRefresh takes nothing returns nothing
  local integer this= 0
  local integer i= 0
		if CUSTOM_RESPOND_UI_REFRESH_PLAYER == null then
			return
		endif
		if CUSTOM_RESPOND_UI_REFRESH_SLOT < 0 then
			
			if CUSTOM_RESPOND_UI_REFRESH_ABILITY <= 0 then
				return
			endif
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				set this=GetPlayerId(CUSTOM_RESPOND_UI_REFRESH_PLAYER) * CONFIG_ABILITY_SIZE + i
				if s__AbilityIcon_target[this] == CUSTOM_RESPOND_UI_REFRESH_ABILITY then
					call s__AbilityIcon_setTarget(this,s__AbilityIcon_target[this])
					return
				endif
				set i=i + 1
			endloop
		else
			
			set this=GetPlayerId(CUSTOM_RESPOND_UI_REFRESH_PLAYER) * CONFIG_ABILITY_SIZE + CUSTOM_RESPOND_UI_REFRESH_SLOT
			call s__AbilityIcon_setTarget(this,s__AbilityIcon_target[this])
		endif
 endfunction

    function s__AbilityIcon_create takes integer index,framehandle parent,player owner returns integer
        local integer this= GetPlayerId(owner) * CONFIG_ABILITY_SIZE + index
        set s__AbilityIcon_owner[this]=owner
        set s__AbilityIcon_index[this]=index
		set s__AbilityIcon_mouse_in[this]=false
		set s__AbilityIcon_target[this]=0
        if not s__s__AbilityIcon_FLAG_FRAME[s__AbilityIcon_index[this]] then
            
            call s__AbilityIcon_initFrames(s__AbilityIcon_index[this] , parent)
        endif
        
        call TriggerRegisterPlayerEvent(s__s__AbilityIcon_BTN_TRIGGER[index], s__AbilityIcon_owner[this], EVENT_PLAYER_MOUSE_DOWN)
        
        return this
    endfunction

    function s__AbilityIcon_destroy takes integer this returns nothing

    endfunction

    function s__AbilityIcon_onInit takes nothing returns nothing
  local integer i= 0
		loop
			exitwhen i >= CONFIG_ABILITY_SIZE
			set s__s__AbilityIcon_FLAG_FRAME[i]= false
			set i=i + 1
		endloop
		set s__AbilityIcon_REFRESH=CreateTrigger()
		call TriggerRegisterVariableEvent((s__AbilityIcon_REFRESH ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_ABILITY_UI_REFRESH)*1.0)) // INLINED!!
		call TriggerAddCondition(s__AbilityIcon_REFRESH, Condition(function s__AbilityIcon_forceRefresh))
    endfunction

