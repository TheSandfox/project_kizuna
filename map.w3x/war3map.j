				call BlzFrameSetTexture(s__ChinghoFrame_icon2[this], "ReplaceableTextures\\CommandButtons\\BTNSelectHeroOn.blp", 0, true)
				call BlzFrameSetText(s__ChinghoFrame_name[this], "???")
			else
