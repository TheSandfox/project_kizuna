//library Buff:











  function s__Buff_suspendFree takes integer this returns nothing
			set s__Buff_suspend_caster_dead[this]=false
			set s__Buff_suspend_target_dead[this]=false
			set s__Buff_suspend_caster_alive[this]=false
			set s__Buff_suspend_target_alive[this]=false
  endfunction

  function s__Buff_setPermanent takes integer this returns nothing
			set s__Buff_permanent[this]=true
			call s__Buff_suspendFree(this)
  endfunction

  function s__Buff_getTypeIconPath takes integer bid returns string
			return LoadStr(BUFF_CREATE_HASH, bid, BUFF_HASH_INDEX_ICON_PATH)
  endfunction

  function s__Buff_suspendFilter takes integer this returns boolean
			if s__Buff_suspend_target_dead[this] and sc__Unit_prototype_isUnitType(s__Buff_target[this],UNIT_TYPE_DEAD) then
				return true
			elseif s__Buff_suspend_caster_dead[this] and sc__Unit_prototype_isUnitType(s__Buff_caster[this],UNIT_TYPE_DEAD) then
				return true
			elseif s__Buff_suspend_target_alive[this] and not sc__Unit_prototype_isUnitType(s__Buff_target[this],UNIT_TYPE_DEAD) then
				return true
			elseif s__Buff_suspend_caster_alive[this] and not sc__Unit_prototype_isUnitType(s__Buff_caster[this],UNIT_TYPE_DEAD) then
				return true
			endif
			return false
  endfunction

  function s__Buff_suspendFilterAdditional takes integer this returns boolean
			return false
  endfunction

  function s__Buff__get_owner takes integer this returns integer
			return s__Buff_caster[this]
  endfunction

  function s__Buff_genericConfiguration takes integer this returns nothing
			set s__Buff_icon[this]=BUFF_CREATE_ICON_PATH
			set s__Buff_positive[this]=BUFF_CREATE_POSITIVE
			set s__Buff_icon_display[this]=BUFF_CREATE_DISPLAY
  endfunction

  function s__Buff_new takes nothing returns integer
   local integer this= 0
   local boolean result= true
			if BUFF_CREATE_INDIVISUAL == 2 then
				call TriggerEvaluate(LoadTriggerHandle(BUFF_CREATE_HASH, BUFF_CREATE_ID, BUFF_HASH_INDEX_TRIGGER))
				set this=BUFF_LAST_CREATED
				call s__Buff_genericConfiguration(this)
				set result=sc__Buff_init(this)
			elseif BUFF_CREATE_INDIVISUAL == 1 then
				set this=sc__Buff_getMatchingCasterAndTarget(BUFF_CREATE_CASTER , BUFF_CREATE_TARGET , BUFF_CREATE_ID)
				if this <= 0 then
					call TriggerEvaluate(LoadTriggerHandle(BUFF_CREATE_HASH, BUFF_CREATE_ID, BUFF_HASH_INDEX_TRIGGER))
					set this=BUFF_LAST_CREATED
					call s__Buff_genericConfiguration(this)
					set result=sc__Buff_init(this)
				else
					if BUFF_CREATE_DURATION > s__Buff_duration[this] then
						set s__Buff_duration[this]=BUFF_CREATE_DURATION
						if s__Buff_duration_max[this] < BUFF_CREATE_DURATION then
							set s__Buff_duration_max[this]=BUFF_CREATE_DURATION
						endif
					endif
					if BUFF_CREATE_LEVEL > s__Buff_level[this] then
						set s__Buff_level[this]=BUFF_CREATE_LEVEL
					endif
					set s__Buff_caster[this]=BUFF_CREATE_CASTER
					set result=sc__Buff_update(this)
				endif
			elseif BUFF_CREATE_INDIVISUAL == 0 then
				set this=sc__Buff_getUnitBuffById(BUFF_CREATE_TARGET , BUFF_CREATE_ID)
				if this <= 0 then
					call TriggerEvaluate(LoadTriggerHandle(BUFF_CREATE_HASH, BUFF_CREATE_ID, BUFF_HASH_INDEX_TRIGGER))
					set this=BUFF_LAST_CREATED
					call s__Buff_genericConfiguration(this)
					set result=sc__Buff_init(this)
				else
					if BUFF_CREATE_DURATION > s__Buff_duration[this] then
						set s__Buff_duration[this]=BUFF_CREATE_DURATION
						if s__Buff_duration_max[this] < BUFF_CREATE_DURATION then
							set s__Buff_duration_max[this]=BUFF_CREATE_DURATION
						endif
					endif
					if BUFF_CREATE_LEVEL > s__Buff_level[this] then
						set s__Buff_level[this]=BUFF_CREATE_LEVEL
					endif
					set s__Buff_caster[this]=BUFF_CREATE_CASTER
					set result=sc__Buff_update(this)
				endif
			endif
			if result then
				return this
			else
				return 0
			endif
  endfunction

  function s__Buff_add takes integer caster,integer target,integer id,integer level,real duration returns integer
			set BUFF_LAST_CREATED=0
			set BUFF_CREATE_CASTER=caster
			set BUFF_CREATE_TARGET=target
			set BUFF_CREATE_DURATION=duration
			set BUFF_CREATE_LEVEL=level
			
			call TriggerEvaluate(LoadTriggerHandle(BUFF_CREATE_HASH, id, BUFF_HASH_INDEX_TRIGGER + 1))
			
			call s__Buff_new()
			
			set BUFF_CREATE_CASTER=- 1
			set BUFF_CREATE_TARGET=- 1
			set BUFF_CREATE_DURATION=0.
			set BUFF_CREATE_LEVEL=- 1
			return BUFF_LAST_CREATED
  endfunction

  function s__Buff_addWithValue takes integer caster,integer target,integer id,integer level,real duration,integer value returns integer
			set EVT_BUFF_VALUE=value
			return s__Buff_add(caster , target , id , level , duration)
  endfunction
		
  function s__Buff_getUnitRootBuff takes integer target returns integer
			if HaveSavedInteger(s__Buff_HASH, target, 0) then
				return LoadInteger(s__Buff_HASH, target, 0)
			else
				return 0
			endif
  endfunction

  function s__Buff_getMatchingCasterAndTarget takes integer caster,integer target,integer id returns integer
   local integer b= s__Buff_getUnitRootBuff(target)
			if b > 0 then
				loop
					if s__Buff_id[b] == id and s__Buff_caster[b] == caster then
						return b
					else
						if s__Buff_node_next[b] > 0 then
							set b=s__Buff_node_next[b]
						else
							return 0
						endif
					endif
				endloop
			else
				return 0
			endif
			return 0
  endfunction

  function s__Buff_getUnitBuffById takes integer target,integer id returns integer
   local integer b= s__Buff_getUnitRootBuff(target)
			if b > 0 then
				loop
					if s__Buff_id[b] == id then
						return b
					else
						if s__Buff_node_next[b] > 0 then
							set b=s__Buff_node_next[b]
						else
							return 0
						endif
					endif
				endloop
			else
				return 0
			endif
			return 0
  endfunction

  function s__Buff_unitHasBuff takes integer target,integer id returns boolean
			return s__Buff_getUnitBuffById(target , id) > 0
  endfunction

  function s__Buff_unitDestroyBuffs takes integer target returns nothing
   local integer b= 0
			loop
				set b=s__Buff_getUnitRootBuff(target)
				exitwhen b <= 0
				call sc__Buff_deallocate(b)
			endloop
  endfunction

  function s__Buff_addEffect takes integer this,integer ef returns nothing
			if s__Buff_buff_effect[this] > 0 then
				call sc__Effect_kill(s__Buff_buff_effect[this])
				set s__Buff_buff_effect[this]=0
			endif
			set s__Buff_buff_effect[this]=ef
  endfunction

  function s__Buff_addValue takes integer this,integer level returns nothing

  endfunction

  function s__Buff_init takes integer this returns boolean
			return true
  endfunction

  function s__Buff_update takes integer this returns boolean
			return true
  endfunction

  function s__Buff_intervalAction takes integer this returns nothing

  endfunction

  function s__Buff_periodicAction takes integer this returns nothing

  endfunction

  function s__Buff_timerAction takes nothing returns nothing
   local integer this= sc__Timer_getData(GetExpiredTimer())
			
			if s__Buff_suspendFilter(this) or sc__Buff_suspendFilterAdditional(this) then
				call sc__Buff_deallocate(this)
				return
			endif
			
			set s__Buff_timeout[this]=s__Buff_timeout[this] + TIMER_TICK
			if s__Buff_duration[this] > 0. then
				set s__Buff_duration[this]=s__Buff_duration[this] - TIMER_TICK
				if s__Buff_duration[this] <= 0. then
					set s__Buff_want_kill[this]=true
					call sc__Buff_deallocate(this)
					return
				endif
			endif
			
			call sc__Buff_periodicAction(this)
			
			if s__Buff_interval[this] > 0. and s__Buff_timeout[this] >= s__Buff_interval[this] then
				loop
					exitwhen s__Buff_timeout[this] < s__Buff_interval[this]
					call sc__Buff_intervalAction(this)
					set s__Buff_timeout[this]=s__Buff_timeout[this] - s__Buff_interval[this]
				endloop
			endif
			
			if s__Buff_want_kill[this] then
				call sc__Buff_deallocate(this)
			endif
  endfunction

  function s__Buff_linkNode takes integer this returns nothing
   local integer b= s__Buff_getUnitRootBuff(s__Buff_target[this])
			if b > 0 then
				loop
					if s__Buff_node_next[b] == - 1 then
						set s__Buff_node_next[b]=this
						set s__Buff_node_prev[this]=b
						exitwhen true
					else
						set b=s__Buff_node_next[b]
					endif
				endloop
			else
				call SaveInteger(s__Buff_HASH, s__Buff_target[this], 0, this)
			endif
  endfunction

  function s__Buff_unlinkNode takes integer this returns nothing
			if this == s__Buff_getUnitRootBuff(s__Buff_target[this]) then
				
				if s__Buff_node_next[this] > 0 then
					
					call SaveInteger(s__Buff_HASH, s__Buff_target[this], 0, s__Buff_node_next[this])
					
					set s__Buff_node_prev[s__Buff_node_next[this]]=- 1
				else
					
					call RemoveSavedInteger(s__Buff_HASH, s__Buff_target[this], 0)
				endif
			else
				
				if s__Buff_node_prev[this] > 0 then
					
					set s__Buff_node_next[s__Buff_node_prev[this]]=s__Buff_node_next[this]
				endif
				if s__Buff_node_next[this] > 0 then
					
					set s__Buff_node_prev[s__Buff_node_next[this]]=s__Buff_node_prev[this]
				endif
			endif
  endfunction

  function s__Buff_relativeTooltip takes integer this returns string
			return "TooltipMissing"
  endfunction

		
  function s__Buff_create takes integer id,integer caster,integer target,integer level,real duration,string name returns integer
   local integer this= s__Buff__allocate()
			set s__Buff_id[this]=id
			set s__Buff_caster[this]=caster
			set s__Buff_target[this]=target
			set s__Buff_duration[this]=duration
			set s__Buff_duration_max[this]=duration
			set s__Buff_level[this]=level
			set s__Buff_name[this]=name
			set s__Buff_main_timer[this]=sc__Timer_new(this)
			call s__Buff_linkNode(this)
			call TimerStart((s__Buff_main_timer[this] ), (( TIMER_TICK )*1.0), ( true ), ( function s__Buff_timerAction)) // INLINED!!
			return this
  endfunction

  function s__Buff_onDestroy takes integer this returns nothing
			set EVT_BUFF_DESTROY_BUFF=this
			call sc__Event_activate(ENUM_EVENT_BUFF_DESTROY)
			if s__Buff_buff_effect[this] > 0 then
				call sc__Effect_kill(s__Buff_buff_effect[this])
				set s__Buff_buff_effect[this]=0
			endif
			call s__Buff_unlinkNode(this)
			if s__Buff_main_timer[this] != null then
				call sc__Timer_release(s__Buff_main_timer[this])
			endif
			set s__Buff_main_timer[this]=null
  endfunction



