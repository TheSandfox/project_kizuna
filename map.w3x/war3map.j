  endfunction

  function s__ProgressiveCircle_onProgress takes integer this returns nothing
			call s__Effect_setAlpha(s__ProgressiveEffect_getEffect(this,0),R2I(92 + 255 * ( 1.0 - s__ProgressiveEffect_duration[this] / s__ProgressiveEffect_duration_max[this] ) * 2.0))
			call s__Effect_setAlpha(s__ProgressiveEffect_getEffect(this,1),R2I(64 + 255 * ( 1.0 - s__ProgressiveEffect_duration[this] / s__ProgressiveEffect_duration_max[this] ) * 2.0))
			call s__Effect_setScale(s__ProgressiveEffect_getEffect(this,1),( s__ProgressiveEffect_progress[this] * s__ProgressiveCircle_radius[this] ) / 100.)
  endfunction
	
  function s__ProgressiveCircle_create takes real x,real y,real z,real radius,real duration returns integer
   local integer this= 0
   local integer outter= s__Effect_create("Effects\\CastRangeCircle.mdl" , x , y , z + 1 , 0.)
   local integer inner= s__Effect_create("Effects\\CastRangeCircle.mdl" , x , y , z + 4 , 0.)
			set this=s__ProgressiveCircle__allocate(outter , inner , x , y , z , duration)
			set s__ProgressiveCircle_radius[this]=radius
			call s__Effect_setScale(outter,s__ProgressiveCircle_radius[this] / 100.)
			call s__ProgressiveEffect_setProgress(this,0.)
			return this
  endfunction
	

	

  function s__ProgressiveLine_onDecay takes integer this returns nothing
			call s__Effect_setAlpha(s__ProgressiveEffect_getEffect(this,0),R2I(128 * ( s__ProgressiveEffect_duration[this] / s__ProgressiveEffect_duration_max[this] )))
			call s__Effect_setAlpha(s__ProgressiveEffect_getEffect(this,1),R2I(128 * ( s__ProgressiveEffect_duration[this] / s__ProgressiveEffect_duration_max[this] )))
  endfunction

  function s__ProgressiveLine_onProgress takes integer this returns nothing
   local integer outter= s__ProgressiveEffect_getEffect(this,0)
   local integer inner= s__ProgressiveEffect_getEffect(this,1)
			call sc__Object__set_yaw(outter,s__ProgressiveLine_yaw[this])
			call sc__Object__set_yaw(inner,s__ProgressiveLine_yaw[this])
			call s__Effect_setAlpha(outter,R2I(92 + 255 * ( 1.0 - s__ProgressiveEffect_duration[this] / s__ProgressiveEffect_duration_max[this] ) * 2.0))
			call s__Effect_setAlpha(inner,R2I(64 + 255 * ( 1.0 - s__ProgressiveEffect_duration[this] / s__ProgressiveEffect_duration_max[this] ) * 2.0))
			call s__Effect_setPosition(outter,(((s__ProgressiveEffect_x[this] )*1.0) + (( - s__ProgressiveLine_radius[this] )*1.0) * Cos((( s__ProgressiveLine_yaw[this])*1.0) * bj_DEGTORAD)) , (((s__ProgressiveEffect_y[this] )*1.0) + (( - s__ProgressiveLine_radius[this] )*1.0) * Sin((( s__ProgressiveLine_yaw[this])*1.0) * bj_DEGTORAD)) , 1. + s__ProgressiveEffect_z[this]) // INLINED!!
			call s__Effect_setPosition(inner,(((s__ProgressiveEffect_x[this] )*1.0) + (( - s__ProgressiveLine_radius[this] )*1.0) * Cos((( s__ProgressiveLine_yaw[this])*1.0) * bj_DEGTORAD)) , (((s__ProgressiveEffect_y[this] )*1.0) + (( - s__ProgressiveLine_radius[this] )*1.0) * Sin((( s__ProgressiveLine_yaw[this])*1.0) * bj_DEGTORAD)) , 4. + s__ProgressiveEffect_z[this]) // INLINED!!
			call BlzSetSpecialEffectMatrixScale(s__Effect_origin_effect[outter], ( s__ProgressiveLine_length[this] + s__ProgressiveLine_radius[this] * 2 ) / 100., s__ProgressiveLine_radius[this] / 50., 1.)
			call BlzSetSpecialEffectMatrixScale(s__Effect_origin_effect[inner], ( s__ProgressiveLine_length[this] + s__ProgressiveLine_radius[this] * 2 ) / 100., s__ProgressiveEffect_progress[this] * ( s__ProgressiveLine_radius[this] / 50. ), 1.)
  endfunction

  function s__ProgressiveLine_create takes real x,real y,real z,real radius,real length,real yaw,real duration returns integer
   local integer this= 0
   local integer outter= s__Effect_create("Effects\\RLine.mdl" , x , y , z + 1 , yaw)
   local integer inner= s__Effect_create("Effects\\RLine.mdl" , x , y , z + 4 , yaw)
			set this=s__ProgressiveLine__allocate(outter , inner , x , y , z , duration)
			set s__ProgressiveLine_radius[this]=radius
			set s__ProgressiveLine_length[this]=length
			set s__ProgressiveLine_yaw[this]=yaw
			call s__ProgressiveEffect_setProgress(this,0.)
			return this
  endfunction



