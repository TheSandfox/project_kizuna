  function s__Item_divide takes integer this,integer i returns integer
   local integer nit= 0
			if s__Item_prototype_count[this] <= 1 or i <= 0 then
				return 0
			endif
			set nit=sc__Item_new(s__Item_prototype_id[this])
			if i >= s__Item_prototype_count[this] then
				set s__Item_prototype_count[nit]=s__Item_prototype_count[this] - 1
				set s__Item_prototype_count[this]=1
			else
				set s__Item_prototype_count[nit]=i
				set s__Item_prototype_count[this]=s__Item_prototype_count[this] - i
			endif
			return nit
  endfunction
		
