				exitwhen i >= s__ArrayList_size[this]
				set s__ArrayList_CURRENT_INDEX=i
				call s__ArrayList_onRemove(this,s__ArrayList_get(this,i))
				set i=i + 1
			endloop
			call FlushChildHashtable(ArrayList___HASH, this)
			set s__ArrayList_size[this]=0
  endfunction

  function s__ArrayList_create takes nothing returns integer
   local integer this= s__ArrayList__allocate()
			return this
  endfunction

  function s__ArrayList_onDestroy takes integer this returns nothing
			call s__ArrayList_clear(this)
  endfunction


