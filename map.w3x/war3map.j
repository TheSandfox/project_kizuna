			set s__Boss_damage_trigger[this]=s__Trigger_create(this)
			call TriggerRegisterVariableEvent((s__Trigger_main_trigger[s__Boss_damage_trigger[this]] ), "udg_EVENT_VALUE", EQUAL, (( CONFIG_EVENT_DAMAGE_MODIFY_STAT)*1.0)) // INLINED!!
			call s__Trigger_addCondition(s__Boss_damage_trigger[this],function s__Boss_damageCallback)
			
