  function s__BuffIndicator_setIconTarget takes integer this,integer index,integer b returns nothing
			if b <= 0 then
				if GetLocalPlayer() == Player(this) then
					call BlzFrameSetVisible(BuffIndicator___MY_ICON_OUTLINE[index], false)
				endif
				return
			endif
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(BuffIndicator___MY_ICON_OUTLINE[index], true)
				if s__Buff_positive[b] == 1 then
					
					call BlzFrameSetTexture(BuffIndicator___MY_ICON_OUTLINE[index], "replaceabletextures\\teamcolor\\teamcolor22.blp", 0, true)
					call BlzFrameSetTexture(BuffIndicator___MY_ICON_COOLDOWN[index], "replaceabletextures\\teamcolor\\teamcolor06.blp", 0, true)
					
					call BlzFrameSetText(BuffIndicator___MY_TOOLTIP_TEXT[index], "|cff00ff00" + s__Buff_name[b] + "|r\n\n" + sc__Buff_relativeTooltip(b))
				elseif s__Buff_positive[b] == 0 then
					
					call BlzFrameSetTexture(BuffIndicator___MY_ICON_OUTLINE[index], "replaceabletextures\\teamcolor\\teamcolor12.blp", 0, true)
					call BlzFrameSetTexture(BuffIndicator___MY_ICON_COOLDOWN[index], "replaceabletextures\\teamcolor\\teamcolor00.blp", 0, true)
					
					call BlzFrameSetText(BuffIndicator___MY_TOOLTIP_TEXT[index], "|cffff0000" + s__Buff_name[b] + "|r\n\n" + sc__Buff_relativeTooltip(b))
				else
					
					call BlzFrameSetTexture(BuffIndicator___MY_ICON_OUTLINE[index], "replaceabletextures\\teamcolor\\teamcolor08.blp", 0, true)
					call BlzFrameSetTexture(BuffIndicator___MY_ICON_COOLDOWN[index], "replaceabletextures\\teamcolor\\teamcolor21.blp", 0, true)
					
					call BlzFrameSetText(BuffIndicator___MY_TOOLTIP_TEXT[index], s__Buff_name[b] + "\n\n" + sc__Buff_relativeTooltip(b))
				endif
				
				call BlzFrameSetVisible(BuffIndicator___MY_ICON_EX_BACKDROP[index], s__Buff_extra[b] != "")
				call BlzFrameSetText(BuffIndicator___MY_ICON_EX_TEXT[index], s__Buff_extra[b])
				
				call BlzFrameSetTexture(BuffIndicator___MY_ICON_BACKDROP[index], (LoadStr(BUFF_CREATE_HASH, (s__Buff_id[b]), BUFF_HASH_INDEX_ICON_PATH)), 0, true) // INLINED!!
				
				if s__Buff_duration_max[b] > 0. then
					call BlzFrameSetPoint((BuffIndicator___MY_ICON_COOLDOWN[index] ), ( FRAMEPOINT_TOPRIGHT ), ( BuffIndicator___MY_ICON_OUTLINE[index] ), ( FRAMEPOINT_BOTTOMRIGHT ), (( 0. )*1.0) / 1800., (( BuffIndicator___SIZE * s__Buff_duration[b] / s__Buff_duration_max[b])*1.0) / 1800.) // INLINED!!
				else
					call BlzFrameSetPoint((BuffIndicator___MY_ICON_COOLDOWN[index] ), ( FRAMEPOINT_TOPRIGHT ), ( BuffIndicator___MY_ICON_OUTLINE[index] ), ( FRAMEPOINT_BOTTOMRIGHT ), (( 0. )*1.0) / 1800., (( BuffIndicator___SIZE)*1.0) / 1800.) // INLINED!!
				endif
			endif
  endfunction
