		elseif s__Boss_BossB000__sanrengeki_count[this] == 1 then
			set s__Actor_duration[this]=s__Boss_BossB000__sanrengeki_DURATION_SLOW
			call s__Boss_BossB000__sanrengeki_play(this,false)
			set s__Boss_BossB000__sanrengeki_anim_play[this]=false
			set s__Boss_BossB000__sanrengeki_anim_reset[this]=false
			return false
		endif
		return true
 endfunction

 function s__Boss_BossB000__sanrengeki_periodicAction takes integer this returns nothing
