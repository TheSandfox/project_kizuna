				set i=i + 1
			endloop
  endfunction




  function s__CurveCircle2D_getCarculatedX takes integer this,real v returns real
			return (((s__Curve_getX(this,s__Curve_POINT_ORIGIN) )*1.0) + (( s__CurveCircle2D_distance[this] )*1.0) * Cos((( s__CurveCircle2D_angle[this] + v * 360. * s__CurveCircle2D_scale[this])*1.0) * bj_DEGTORAD)) + sc__Object__get_offset_x(this) // INLINED!!
  endfunction

  function s__CurveCircle2D_getCarculatedY takes integer this,real v returns real
