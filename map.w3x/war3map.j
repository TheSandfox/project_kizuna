  function s__BossB000_onSleep takes integer this returns nothing
			call s__Unit_prototype__set_mp(this,(s__Unit_prototype_maxmp_true[(this)])) // INLINED!!
			set s__BossB000_divide[this]=false
			set s__BossB000_phase[this]=0
  endfunction

  function s__BossB000_doPattern takes integer this returns nothing
   local integer u= 0
   local integer rand= 0
			
			if s__BossB000_phase[this] < 2 and not s__BossB000_divide[this] and ( (s__Unit_prototype_hp_true[(this)]) / (s__Unit_prototype_maxhp_true[(this)]) ) <= 0.33 * ( 2 - s__BossB000_phase[this] ) then // INLINED!!
				//createdivide
				set s__BossB000_divide[this]=true
				return
			endif
			set u=s__Boss_getNearest(this)
			
			if (s__Unit_prototype_mp_true[(this)]) <= 80. then // INLINED!!
				//createidle
				call s__BossActorIdle_create(this , u , GetRandomReal(1.5, 3.0))
				return
			endif
			
			if u > 0 then
				if (s__Unit_prototype_mp_true[(this)]) >= (s__Unit_prototype_maxmp_true[(this)]) * 0.99 then // INLINED!!
					call s__Boss_BossB000__rollingstone_create(this , u)
				else
					call s__Boss_BossB000__sanrengeki_create(this , u)
				endif
				call s__Unit_prototype__set_mp(this,(s__Unit_prototype_mp_true[(this)]) - 75.) // INLINED!!
			endif
  endfunction

  function s__BossB000_create takes integer level,real x,real y returns integer
   local integer this= s__BossB000__allocate('B000' , level , x , y)
			
			set s__Boss_ui[this]=s__Boss_BossB000__mybar_create(this)
			return this
  endfunction

  function s__BossB000_myCallback takes nothing returns nothing
   local integer this= Boss_BossB000__MY_RESPOND_VAL
			if Boss_BossB000__MY_RESPOND_TYPE == "divide_end" then
				set s__BossB000_divide[this]=false
				set s__BossB000_phase[this]=s__BossB000_phase[this] + 1
			endif
  endfunction

  function s__BossB000_onInit takes nothing returns nothing
			call TriggerAddCondition(Boss_BossB000__MY_RESPOND, Condition(function s__BossB000_myCallback))
  endfunction


