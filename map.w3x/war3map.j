  endfunction

  function s__Ability_prototype_addUnitAbility takes integer u,integer aid returns integer
   local integer i= 0
   local integer na= (s__Ability_prototype_getUnitAbilityById(u , aid))
			if na == 0 then
				
				set EVT_ABILITY_CREATE_RESULT=0
				set EVT_ABILITY_CREATE_ID=aid
				set EVT_ABILITY_CREATE_UNIT=u
				call TriggerEvaluate(LoadTriggerHandle(ABILITY_CREATE_TRIGGER_TABLE, aid, 0))
				set na=EVT_ABILITY_CREATE_RESULT
				call s__Event_activate(ENUM_EVENT_ABILITY_CREATE)
				if na > 0 then
					
					loop
						exitwhen i >= CONFIG_ABILITY_SIZE
						if s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[u],i) == 0 then
							call SaveInteger(Hash___D, (((s__Unit_prototype_ability_data[u]))), ((i ) ), ( ( na))) // INLINED!!
							if (s__User_FOCUS_UNIT[GetPlayerId(((GetOwningPlayer(s__Unit_prototype_origin_unit[(u)]))))]) == u then // INLINED!!
								set EVT_UI_REFRESH_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[(u)])) // INLINED!!
								set EVT_UI_REFRESH_SLOT=i
								call s__Event_activate(ENUM_EVENT_ABILITY_UI_REFRESH)
								set EVT_UI_REFRESH_SLOT=- 1
							endif
							return na
						endif
						set i=i + 1
					endloop
				endif
			elseif na == - 1 then
				
			else
				
				call sc__Ability_prototype_addLevel(na,1)
				set EVT_UI_REFRESH_PLAYER=(GetOwningPlayer(s__Unit_prototype_origin_unit[(u)])) // INLINED!!
				set EVT_UI_REFRESH_SLOT=- 1
				call s__Event_activate(ENUM_EVENT_ABILITY_UI_REFRESH)
			endif
			return na
  endfunction

  function s__Ability_prototype_cancleUnitAbilityAll takes integer u returns nothing
   local integer i= 0
   local integer a= 0
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				set a=(s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[u],i))
				if a != 0 then
					// call a.cancleReservation()
					// call a.cancleFollow()
					call s__Ability_prototype_setPressState(a,false)
				endif
				set i=i + 1
			endloop
  endfunction

  function s__Ability_prototype_releaseUnitAbilityAll takes integer u returns nothing
   local integer i= 0
   local integer a= 0
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				set a=(s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[u],i))
				if a != 0 then
					call s__Ability_prototype_release(a)
				endif
				set i=i + 1
			endloop
  endfunction

  function s__Ability_prototype_clearUnitAbility takes integer u returns nothing
   local integer i= 0
   local integer a= 0
			if u <= 0 then
				return
			endif
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				set a=(s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[u],i))
				if a != 0 then
					call s__Ability_prototype_kill(a)
				endif
				set i=i + 1
			endloop
  endfunction

  function s__Ability_prototype_clearUnitAbilityCallback takes nothing returns nothing
   local integer u= EVT_UNIT_CLEAR_ABILITY_UNIT
			call s__Ability_prototype_clearUnitAbility(u)
  endfunction

		
  function s__Ability_prototype_inputLayerChangeCallback takes nothing returns nothing
   local integer u= EVT_INPUT_LAYER_CHANGE_UNIT
			if u <= 0 or EVT_INPUT_LAYER_CHANGE_PREV_LAYER == EVT_INPUT_LAYER_CHANGE_LAYER then
				return
			endif
			if EVT_INPUT_LAYER_CHANGE_PREV_LAYER == CONFIG_INPUT_LAYER_DEFAULT then
				call s__Ability_prototype_releaseUnitAbilityAll(u)
			endif
  endfunction

  function s__Ability_prototype_onInit takes nothing returns nothing
   local integer i= 0
   local trigger t= null
			
			loop
				exitwhen i >= CONFIG_PLAYER_MAX
				call BlzTriggerRegisterPlayerSyncEvent(ABILITY_SYNC_TARGET_TRIGGER, Player(i), "SA", false)
				set i=i + 1
			endloop
			call TriggerAddAction(ABILITY_SYNC_TARGET_TRIGGER, function s__Ability_prototype_syncTarget)
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_WEAPON_ATTACK_SPEED_REFRESH)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Ability_prototype_weaponAttackSpeedRefreshCallback))
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_ATTACK)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Ability_prototype_executeWeaponAttackCallback))
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_UNIT_CLEAR_ABILITY)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Ability_prototype_clearUnitAbilityCallback))
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_INPUT_LAYER_CHANGE)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Ability_prototype_inputLayerChangeCallback))
			
			set t=null
  endfunction



