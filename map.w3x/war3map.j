//library Unit:





  function s__Unit_getUpgradePoint takes integer this,integer index returns integer
			return s__SimpleList_get(s__Unit_upgrade_point[this],index)
  endfunction

  function s__Unit_setUpgradePoint takes integer this,integer index,integer val returns nothing
			call s__SimpleList_setData(s__Unit_upgrade_point[this],index , val)
			// set AbilityManager.REFRESH_SKILLPOINT_PLAYER = .owner
			// call TriggerEvaluate(AbilityManager.REFRESH_SKILLPOINT_TRIGGER)
  endfunction

  function s__Unit_addUpgradePoint takes integer this,integer index,integer val returns nothing
			call s__SimpleList_setData(s__Unit_upgrade_point[(this)],(index ) , ( (s__SimpleList_get(s__Unit_upgrade_point[(this)],(index))) + val)) // INLINED!!
  endfunction

		
		
  function s__Unit_copyAbility takes integer this,integer target returns nothing
   local integer i= 0
   local integer a= 0
   local integer ta= 0
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE
				set ta=(s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[target],i))
				if ta > 0 then
					
					set a=s__Ability_prototype_addUnitAbility(this , s__Ability_prototype_id[a])
					if a > 0 then
						
						call sc__Ability_prototype_addLevel(a,s__Ability_prototype_level[ta] - 1)
						
						if s__UnitPrototype__AbilityData_getWeaponAbility(s__Unit_prototype_ability_data[target]) == ta then
							call s__Ability_prototype_setUnitWeaponAbility(this , a)
						endif
					endif
				endif
				set i=i + 1
			endloop
  endfunction

  function s__Unit_onLevel takes nothing returns nothing

  endfunction

  function s__Unit_refreshMaxExp takes integer this returns nothing
			set s__Unit_prototype_maxexp[this]=50 + (s__Unit_prototype_level_true[(this)]) * 100 // INLINED!!
  endfunction

  function s__Unit_addExp takes integer this,real v returns nothing
			call s__Unit_prototype_addExp(this,v * ( ( 100. + s__Unit_prototype_getCalculatedStatValue(this,ENUM_STAT_INSIGHT) ) / 100. ))
  endfunction

  function s__Unit_loveShieldCallback takes nothing returns nothing
   local integer caster= 0
   local integer target= 0
   local real val= 0.
			
			if EVT_SHIELD_CASTER == EVT_SHIELD_TARGET then
				return
			endif
			set caster=EVT_SHIELD_CASTER
			set target=EVT_SHIELD_TARGET
			// call BJDebugMsg("러브보너스!!")
			// call BJDebugMsg("적용전:"+I2S(R2I(EVT_SHIELD_AMOUNT)))
			
			set val=s__Unit_prototype_getCalculatedStatValue(caster,ENUM_STAT_LOVE)
			if val >= 0. then
				set EVT_SHIELD_AMOUNT=EVT_SHIELD_AMOUNT * ( ( 100.0 + val ) / 100.0 )
			else
				set EVT_SHIELD_AMOUNT=EVT_SHIELD_AMOUNT * ( 100.0 / ( 100.0 + val ) )
			endif
			
			set val=s__Unit_prototype_getCalculatedStatValue(target,ENUM_STAT_LOVE)
			if val >= 0. then
				set EVT_SHIELD_AMOUNT=EVT_SHIELD_AMOUNT * ( ( 100.0 + val ) / 100.0 )
			else
				set EVT_SHIELD_AMOUNT=EVT_SHIELD_AMOUNT * ( 100.0 / ( 100.0 + val ) )
			endif
			// call BJDebugMsg("적용후:"+I2S(R2I(EVT_SHIELD_AMOUNT)))
			// call BJDebugMsg("//===================")
  endfunction

  function s__Unit_loveHealCallback takes nothing returns nothing
   local integer caster= 0
   local integer target= 0
   local real val= 0.
			
			if EVT_HEAL_CASTER == EVT_HEAL_TARGET then
				return
			endif
			set caster=EVT_HEAL_CASTER
			set target=EVT_HEAL_TARGET
			// call BJDebugMsg("러브보너스!!")
			// call BJDebugMsg("적용전:"+I2S(R2I(EVT_HEAL_AMOUNT)))
			
			set val=s__Unit_prototype_getCalculatedStatValue(caster,ENUM_STAT_LOVE)
			if val >= 0. then
				set EVT_HEAL_AMOUNT=EVT_HEAL_AMOUNT * ( ( 100.0 + val ) / 100.0 )
			else
				set EVT_HEAL_AMOUNT=EVT_HEAL_AMOUNT * ( 100.0 / ( 100.0 + val ) )
			endif
			
			set val=s__Unit_prototype_getCalculatedStatValue(target,ENUM_STAT_LOVE)
			if val >= 0. then
				set EVT_HEAL_AMOUNT=EVT_HEAL_AMOUNT * ( ( 100.0 + val ) / 100.0 )
			else
				set EVT_HEAL_AMOUNT=EVT_HEAL_AMOUNT * ( 100.0 / ( 100.0 + val ) )
			endif
			// call BJDebugMsg("적용후:"+I2S(R2I(EVT_HEAL_AMOUNT)))
			// call BJDebugMsg("//===================")
  endfunction

  function s__Unit_loadAbility takes integer this returns nothing
   local integer i= 0
   local integer lc= 0
			if not s__Unit_LOAD_ABILITY then
				return
			endif
			loop
				exitwhen i >= CONFIG_ABILITY_SIZE or (LoadInteger(s__UnitData_P_HASH, ((GetUnitTypeId(s__Unit_prototype_origin_unit[(this)])) ), ( ENUM_UNIT_PARAM_INITIAL_ABILITY))) <= 0 // INLINED!!
				set lc=s__Ability_prototype_addUnitAbility(this , (LoadInteger(s__UnitData_P_HASH, ((GetUnitTypeId(s__Unit_prototype_origin_unit[(this)])) ), ( ENUM_UNIT_PARAM_INITIAL_ABILITY)))) // INLINED!!
				
				call SaveInteger(Ability__HASH2, (lc), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_BLUE ), ( (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[lc]), s__Ability_INDEX_TIER)))) // INLINED!!
				set s__Ability_signature[lc]=true
				if (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[lc]), s__Ability_INDEX_CAST_TYPE)) == ENUM_CAST_TYPE_WEAPON then // INLINED!!
					call s__Ability_prototype_setUnitWeaponAbility(this , lc)
				endif
				set i=i + 1
			endloop
  endfunction

  function s__Unit_initClass takes integer this returns nothing
			call s__UnitClass_addClass((this),ENUM_UNIT_CLASS_POMANGAM_MAX , ENUM_UNIT_CLASS_MAX_VALUE)
			call s__UnitClass_addClass((this),ENUM_UNIT_CLASS_ADDICT_MAX , ENUM_UNIT_CLASS_MAX_VALUE)
  endfunction

  function s__Unit_create takes player p,integer uid,real x,real y,real yaw returns integer
   local integer this= s__Unit__allocate(p , uid , x , y , yaw)
   local integer i= 0
			call s__Unit_loadAbility(this)
			call s__Unit_initClass(this)
			call sc__Unit_prototype_refreshMaxExp(this)
			set s__Unit_upgrade_point[this]=s__SimpleList_create(ENUM_ABILITY_UPGRADE_TYPE_MAX)
			set s__Object_class[this]="Unit"
			call s__Unit_prototype__set_mp(this,s__Unit_prototype_getCalculatedStatValue(this,ENUM_STAT_MAXMP))
			loop
				exitwhen i >= ENUM_ABILITY_UPGRADE_TYPE_MAX
				call s__SimpleList_setData(s__Unit_upgrade_point[(this)],(i ) , ( 0)) // INLINED!!
				set i=i + 1
			endloop
			return this
  endfunction

  function s__Unit_onDestroy takes integer this returns nothing
			call sc__ArrayList_prototype_deallocate(s__Unit_upgrade_point[this])
			call s__UnitClass_clearClass((this))
  endfunction

		

  function s__Unit_onInit takes nothing returns nothing
   local trigger t= null
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_LEVEL)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Unit_onLevel))
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_HEAL_LAST)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Unit_loveHealCallback))
			
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_SHIELD_LAST)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__Unit_loveShieldCallback))
			
			
			set t=null
  endfunction



//library Unit ends
//library Ability:

	

		//HASH1:By Ability ID ('어빌id',인덱스)
		//HASH2:By Instance ID (인스턴스id, 인덱스)


  function s__Ability_getUpgradePoint takes integer this,integer index returns integer
			return LoadInteger(Ability__HASH2, this, s__Ability_INDEX_UPGRADE_POINT + index)
  endfunction

  function s__Ability_setUpgradePoint takes integer this,integer index,integer val returns nothing
			call SaveInteger(Ability__HASH2, this, s__Ability_INDEX_UPGRADE_POINT + index, val)
  endfunction

  function s__Ability_addUpgradePoint takes integer this,integer index,integer val returns nothing
			call SaveInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (index ), ( (LoadInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (index))) + val)) // INLINED!!
  endfunction

  function s__Ability_getTypeIsWeapon takes integer id returns boolean
			return LoadBoolean(Ability__HASH1, id, s__Ability_INDEX_IS_WEAPON)
  endfunction

  function s__Ability_setTypeIsWeapon takes integer id,boolean b returns nothing
			call SaveBoolean(Ability__HASH1, id, s__Ability_INDEX_IS_WEAPON, b)
  endfunction

  function s__Ability_getTypeTier takes integer id returns integer
			return LoadInteger(Ability__HASH1, id, s__Ability_INDEX_TIER)
  endfunction

  function s__Ability_setTypeTier takes integer id,integer val returns nothing
			call SaveInteger(Ability__HASH1, id, s__Ability_INDEX_TIER, val)
  endfunction

  function s__Ability_getTypeMaxLevel takes integer id returns integer
			return LoadInteger(Ability__HASH1, id, s__Ability_INDEX_MAX_LEVEL)
  endfunction

  function s__Ability_setTypeMaxLevel takes integer id,integer val returns nothing
			call SaveInteger(Ability__HASH1, id, s__Ability_INDEX_MAX_LEVEL, val)
  endfunction

  function s__Ability_getTypeCastType takes integer id returns integer
			return LoadInteger(Ability__HASH1, id, s__Ability_INDEX_CAST_TYPE)
  endfunction

  function s__Ability_setTypeCastType takes integer id,integer val returns nothing
			call SaveInteger(Ability__HASH1, id, s__Ability_INDEX_CAST_TYPE, val)
  endfunction

  function s__Ability_getTypeTooltip takes integer id returns string
			if HaveSavedString(Ability__HASH1, id, s__Ability_INDEX_TOOLTIP) then
				return LoadStr(Ability__HASH1, id, s__Ability_INDEX_TOOLTIP)
			else
				return "ToolTip Missing"
			endif
  endfunction

  function s__Ability_setTypeTooltip takes integer id,string val returns nothing
			call SaveStr(Ability__HASH1, id, s__Ability_INDEX_TOOLTIP, val)
  endfunction

  function s__Ability_getTypeCost takes integer id returns integer
			return LoadInteger(Ability__HASH1, id, s__Ability_INDEX_COST)
  endfunction

  function s__Ability_setTypeCost takes integer id,integer val returns nothing
			call SaveInteger(Ability__HASH1, id, s__Ability_INDEX_COST, val)
  endfunction

  function s__Ability_getTypeName takes integer id returns string
			return LoadStr(Ability__HASH1, id, s__Ability_INDEX_NAME)
  endfunction

  function s__Ability_setTypeName takes integer id,string val returns nothing
			call SaveStr(Ability__HASH1, id, s__Ability_INDEX_NAME, val)
  endfunction

  function s__Ability_getTypeIconPath takes integer id returns string
			if HaveSavedString(Ability__HASH1, id, s__Ability_INDEX_ICON_PATH) then
				return LoadStr(Ability__HASH1, id, s__Ability_INDEX_ICON_PATH)
			else
				return "Icons\\BTNBlackIcon.blp"
			endif
  endfunction

  function s__Ability_setTypeIconPath takes integer id,string val returns nothing
			call SaveStr(Ability__HASH1, id, s__Ability_INDEX_ICON_PATH, val)
  endfunction

  function s__Ability_getTypeBonusStatIndex takes integer id,integer slot returns integer
			return LoadInteger(Ability__HASH1, id, s__Ability_INDEX_BONUS_STAT + slot)
  endfunction

  function s__Ability_setTypeBonusStatIndex takes integer id,integer slot,integer index returns nothing
			if slot == 0 or slot == 1 then
				call SaveInteger(Ability__HASH1, id, s__Ability_INDEX_BONUS_STAT + slot, index)
			endif
  endfunction

  function s__Ability_getTierBorder takes integer v returns string
			return "Textures\\ability_border_tier" + I2S(v) + ".blp"
  endfunction

  function s__Ability_onIconClick takes integer this returns nothing

  endfunction

  function s__Ability_iconClick takes integer this returns nothing
   local integer s= (s__Ability_prototype_smart_true[(this)]) // INLINED!!
			if sc__User_getCurrentInputLayer((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])]))) == CONFIG_INPUT_LAYER_DEFAULT then // INLINED!!
				if (LoadBoolean(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_IS_WEAPON)) then // INLINED!!
					call s__Ability_prototype_setUnitWeaponAbility(s__Ability_prototype_owner[this] , this)
					call sc__UI_refreshAbilityIconsTarget((GetPlayerId((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])]))))) // INLINED!!
					if GetLocalPlayer() == GetTriggerPlayer() then
						call PlaySoundBJ(gg_snd_AutoCastButtonClick1)
					endif
				else
					call s__Ability_prototype__set_smart(this,0)
					call s__Ability_prototype_press(this)
					call s__Ability_prototype__set_smart(this,s)
					if GetLocalPlayer() == GetTriggerPlayer() then
						call PlaySoundBJ(gg_snd_BigButtonClick)
					endif
				endif
				call sc__Ability_onIconClick(this)
			endif
  endfunction

  function s__Ability_iconRightClick takes integer this returns nothing
			if sc__User_getCurrentInputLayer((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])]))) == CONFIG_INPUT_LAYER_DEFAULT then // INLINED!!
				
				if (LoadBoolean(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_IS_WEAPON)) then // INLINED!!
					
					if s__UnitPrototype__AbilityData_getWeaponAbility(s__Unit_prototype_ability_data[s__Ability_prototype_owner[this]]) == this then
						call s__Ability_prototype_setUnitWeaponAbility(s__Ability_prototype_owner[this] , 0)
					endif
				else
					
					call s__Ability_prototype_changeSmart(this,(s__Ability_prototype_smart_true[(this)]) + 1) // INLINED!!
				endif
				call sc__UI_refreshAbilityIconsTarget((GetPlayerId((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])]))))) // INLINED!!
			// elseif User.getCurrentInputLayer(.owner.owner) == CONFIG_INPUT_LAYER_ABILITY_MANAGER then
				
				// call AbilityManager(GetPlayerId(.owner.owner)).abilityMixRegisterRequest(this,AbilityMixElement.TYPE_ABILITY)
			endif
  endfunction

  function s__Ability_servantTest takes integer this returns boolean
			return s__UnitClass_getClass((s__Ability_prototype_owner[this]),ENUM_UNIT_CLASS_SUMMON) <= 0 and s__UnitClass_getClass((s__Ability_prototype_owner[this]),ENUM_UNIT_CLASS_SERVANT) <= 0
  endfunction

  function s__Ability_plusBaseStatValue takes integer this,integer v returns nothing
   local integer ind1= 0
   local integer ind2= 0
			if (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_TIER)) <= 0 then // INLINED!!
				return
			endif
			set ind1=(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this] ), s__Ability_INDEX_BONUS_STAT + ( 0))) // INLINED!!
			set ind2=(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this] ), s__Ability_INDEX_BONUS_STAT + ( 1))) // INLINED!!
			call s__Unit_prototype_plusBaseStatValue(s__Ability_prototype_owner[this],ind1 , v * UDG_STAT_NORMAL_VALUE[ind1] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_TIER)) * 0.5) // INLINED!!
			call s__Unit_prototype_plusBaseStatValue(s__Ability_prototype_owner[this],ind2 , v * UDG_STAT_NORMAL_VALUE[ind2] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_TIER)) * 0.5) // INLINED!!
			set s__Ability_stat_bonus1[this]=s__Ability_stat_bonus1[this] + v * UDG_STAT_NORMAL_VALUE[ind1] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_TIER)) * 0.5 // INLINED!!
			set s__Ability_stat_bonus2[this]=s__Ability_stat_bonus2[this] + v * UDG_STAT_NORMAL_VALUE[ind2] * (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_TIER)) * 0.5 // INLINED!!
  endfunction

  function s__Ability_addLevel takes integer this,integer v returns nothing
			if s__Ability_prototype_level[this] + v > s__Ability_level_max[this] then
				set v=s__Ability_level_max[this] - s__Ability_prototype_level[this]
			endif
			set s__Ability_prototype_level[this]=s__Ability_prototype_level[this] + v
			call s__Ability_plusBaseStatValue(this,v)
			call sc__Ability_prototype_update(this,v)
  endfunction

  function s__Ability_deactivate takes integer this returns nothing

  endfunction

  function s__Ability_onDeath takes integer this returns nothing
			if (LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this]), s__Ability_INDEX_TIER)) > 0 then // INLINED!!
				call s__Unit_prototype_plusBaseStatValue(s__Ability_prototype_owner[this],(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this] ), s__Ability_INDEX_BONUS_STAT + ( 0))) , - s__Ability_stat_bonus1[this]) // INLINED!!
				call s__Unit_prototype_plusBaseStatValue(s__Ability_prototype_owner[this],(LoadInteger(Ability__HASH1, (s__Ability_prototype_id[this] ), s__Ability_INDEX_BONUS_STAT + ( 1))) , - s__Ability_stat_bonus2[this]) // INLINED!!
			endif
			call sc__Ability_deactivate(this)
			call sc__UI_refreshAbilityIconsTarget((GetPlayerId((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])]))))) // INLINED!!
  endfunction

  function s__Ability_sell takes integer this returns nothing
			call s__SimpleList_setData(s__Unit_upgrade_point[((s__Ability_prototype_owner[this]))],(ENUM_ABILITY_UPGRADE_TYPE_RED ) , ( (s__SimpleList_get(s__Unit_upgrade_point[((s__Ability_prototype_owner[this]))],(ENUM_ABILITY_UPGRADE_TYPE_RED))) + (LoadInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_RED))))) // INLINED!!
			call s__SimpleList_setData(s__Unit_upgrade_point[((s__Ability_prototype_owner[this]))],(ENUM_ABILITY_UPGRADE_TYPE_GREEN ) , ( (s__SimpleList_get(s__Unit_upgrade_point[((s__Ability_prototype_owner[this]))],(ENUM_ABILITY_UPGRADE_TYPE_GREEN))) + (LoadInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_GREEN))))) // INLINED!!
			call s__SimpleList_setData(s__Unit_upgrade_point[((s__Ability_prototype_owner[this]))],(ENUM_ABILITY_UPGRADE_TYPE_BLUE ) , ( (s__SimpleList_get(s__Unit_upgrade_point[((s__Ability_prototype_owner[this]))],(ENUM_ABILITY_UPGRADE_TYPE_BLUE))) + (LoadInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_BLUE))))) // INLINED!!
			call sc__User_addGold((GetOwningPlayer(s__Unit_prototype_origin_unit[(s__Ability_prototype_owner[this])])) , (LoadInteger(Ability__HASH2, (this), s__Ability_INDEX_UPGRADE_POINT + (ENUM_ABILITY_UPGRADE_TYPE_RED)))) // INLINED!!
			call s__Ability_prototype_kill(this)
  endfunction

  function s__Ability_executeAI takes integer this returns boolean
			return false
  endfunction



//library Ability ends
//library Effect:

	
	
		


		
	
  function s__Effect_initializeOffset takes integer this returns nothing
			call sc__Object__set_offset_x(this,0)
			call sc__Object__set_offset_y(this,0)
			call sc__Object__set_offset_z(this,0)
			call sc__Object__set_offset_yaw(this,0)
			call sc__Object__set_offset_pitch(this,0)
			call sc__Object__set_offset_roll(this,0)
  endfunction
		
  function s__Effect_refreshZ takes integer this returns nothing
			if s__Effect_refresh_position[this] then
				call BlzSetSpecialEffectZ(s__Effect_origin_effect[this], s__Object_z_true[this] + s__Object_offset_z_true[this])
			endif
  endfunction
	
  function s__Effect_refreshX takes integer this returns nothing
			if s__Effect_refresh_position[this] then
				call BlzSetSpecialEffectX(s__Effect_origin_effect[this], s__Object_x_true[this] + s__Object_offset_x_true[this])
				call s__Effect_refreshZ(this)
			endif
  endfunction
	
  function s__Effect_refreshY takes integer this returns nothing
			if s__Effect_refresh_position[this] then
				call BlzSetSpecialEffectY(s__Effect_origin_effect[this], s__Object_y_true[this] + s__Object_offset_y_true[this])
				call s__Effect_refreshZ(this)
			endif
  endfunction
	
  function s__Effect_refreshYaw takes integer this returns nothing
			if s__Effect_refresh_orientation[this] then
				call BlzSetSpecialEffectYaw(s__Effect_origin_effect[this], Deg2Rad(s__Object_yaw_true[this] + s__Object_offset_yaw_true[this]))
			endif
  endfunction	
	
  function s__Effect_refreshRoll takes integer this returns nothing
			if s__Effect_refresh_orientation[this] then
				call BlzSetSpecialEffectRoll(s__Effect_origin_effect[this], Deg2Rad(s__Object_roll_true[this] + s__Object_offset_roll_true[this]))
			endif
  endfunction	
	
  function s__Effect_refreshPitch takes integer this returns nothing
			if Cos(Deg2Rad(s__Object_pitch_true[this] + s__Object_offset_pitch_true[this])) < 0. then
				call BlzSetSpecialEffectPitch(s__Effect_origin_effect[this], Deg2Rad(s__Object_pitch_true[this] + s__Object_offset_pitch_true[this]))
				call BlzSetSpecialEffectPitch(s__Effect_origin_effect[this], Deg2Rad(s__Object_pitch_true[this] + s__Object_offset_pitch_true[this]))
			else
				call BlzSetSpecialEffectPitch(s__Effect_origin_effect[this], Deg2Rad(s__Object_pitch_true[this] + s__Object_offset_pitch_true[this]))
			endif
  endfunction

//textmacro instance: effectGetter("X","x")
	
  function s__Effect__get_x takes integer this returns real
			return s__Object_x_true[this]
  endfunction
	
  function s__Effect__get_offset_x takes integer this returns real
			return s__Object_offset_x_true[this]
  endfunction
	
  function s__Effect_getCalculatedX takes integer this returns real
			return s__Object_x_true[this] + s__Object_offset_x_true[this]
  endfunction

  function s__Effect_getX takes integer this returns real
			return sc__Object__get_x(this)
  endfunction

  function s__Effect_getOffsetX takes integer this returns real
			return sc__Object__get_offset_x(this)
  endfunction
	
//end of: effectGetter("X","x")
//textmacro instance: effectGetter("Y","y")
	
  function s__Effect__get_y takes integer this returns real
			return s__Object_y_true[this]
  endfunction
	
  function s__Effect__get_offset_y takes integer this returns real
			return s__Object_offset_y_true[this]
  endfunction
	
  function s__Effect_getCalculatedY takes integer this returns real
			return s__Object_y_true[this] + s__Object_offset_y_true[this]
  endfunction

  function s__Effect_getY takes integer this returns real
			return sc__Object__get_y(this)
  endfunction

  function s__Effect_getOffsetY takes integer this returns real
			return sc__Object__get_offset_y(this)
  endfunction
	
//end of: effectGetter("Y","y")
//textmacro instance: effectGetter("Z","z")
	
  function s__Effect__get_z takes integer this returns real
			return s__Object_z_true[this]
  endfunction
	
  function s__Effect__get_offset_z takes integer this returns real
			return s__Object_offset_z_true[this]
  endfunction
	
  function s__Effect_getCalculatedZ takes integer this returns real
