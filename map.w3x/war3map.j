 function Ability20h0__act takes nothing returns nothing
  local integer a= 0
		if EVT_ABILITY_CREATE_ID == Ability20h0__ID then
			set a=s__Ability20h0_main__allocate()
			set s__Ability_prototype_owner[a]=EVT_ABILITY_CREATE_UNIT
			call s__Ability_prototype_essentialInit(a)
			call s__Ability20h0_main_init(a)
			set EVT_ABILITY_CREATE_RESULT=a
		endif
	endfunction

 function Ability20h0__init takes nothing returns nothing
		
  local trigger t= CreateTrigger()
		call SaveTriggerHandle(ABILITY_CREATE_TRIGGER_TABLE, Ability20h0__ID, 0, t)
		call TriggerAddCondition(t, Condition(function Ability20h0__act))
		
		call SaveStr(Ability__HASH1, (Ability20h0__ID ), s__Ability_INDEX_ICON_PATH, ( Ability20h0__ICON_PATH)) // INLINED!!
		call SaveStr(Ability__HASH1, (Ability20h0__ID ), s__Ability_INDEX_NAME, ( Ability20h0__NAME)) // INLINED!!
		call SaveInteger(Ability__HASH1, (Ability20h0__ID ), s__Ability_INDEX_TIER, ( Ability20h0__TIER)) // INLINED!!
		call SaveInteger(Ability__HASH1, (Ability20h0__ID ), s__Ability_INDEX_COST, ( Ability20h0__COST)) // INLINED!!
		call s__Ability_setTypeBonusStatIndex(Ability20h0__ID , 0 , Ability20h0__STAT_BONUS1)
		call s__Ability_setTypeBonusStatIndex(Ability20h0__ID , 1 , Ability20h0__STAT_BONUS2)
		call SaveBoolean(Ability__HASH1, (Ability20h0__ID ), s__Ability_INDEX_IS_WEAPON, ( Ability20h0__IS_WEAPON)) // INLINED!!
		call SaveInteger(Ability__HASH1, (Ability20h0__ID ), s__Ability_INDEX_MAX_LEVEL, ( 10 + Ability20h0__TIER * 5)) // INLINED!!
		if Ability20h0__TAG1 != - 1 then
			call s__DamageTag_add(Ability20h0__ID , Ability20h0__TAG1)
		endif
		if Ability20h0__TAG2 != - 1 then
			call s__DamageTag_add(Ability20h0__ID , Ability20h0__TAG2)
		endif
		if Ability20h0__TAG3 != - 1 then
			call s__DamageTag_add(Ability20h0__ID , Ability20h0__TAG3)
		endif
		if Ability20h0__TAG4 != - 1 then
			call s__DamageTag_add(Ability20h0__ID , Ability20h0__TAG4)
		endif
		call SaveInteger(Ability__HASH1, (Ability20h0__ID ), s__Ability_INDEX_CAST_TYPE, ( Ability20h0__CAST_TYPE)) // INLINED!!










		
		set t=null
	endfunction
