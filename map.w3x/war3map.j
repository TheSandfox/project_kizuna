    function s__MonsterRewardMissile_onBound takes integer this returns nothing
      local real dist= 0.
      call s__Missile__set_target((this),(s__MonsterRewardMissile_buffredTarget[this])) // INLINED!!
      set dist=s__Math_distancePoints(sc__Object__get_x(this) , sc__Object__get_y(this) , sc__Object__get_x((s__Missile_target_true[(this)])) , sc__Object__get_y((s__Missile_target_true[(this)]))) // INLINED!!
      
      call s__Missile__set_z_velo(this,0.)
      call s__Missile__set_gravity(this,0.)
      
			call s__Missile__set_curve(this,s__CurveBezier2__allocate(sc__Object__get_x(this) , sc__Object__get_y(this) , 0. , sc__Object__get_x((s__Missile_target_true[(this)])) , sc__Object__get_y((s__Missile_target_true[(this)])) , 0.)) // INLINED!!
			set s__Curve_overtime[s__Object__get_curve(this)]=GetRandomReal(0.5, 0.75)
			call s__Curve_setX((s__Object__get_curve(this)),0 , sc__Object__get_x(this))
			call s__Curve_setY((s__Object__get_curve(this)),0 , sc__Object__get_y(this))
			call s__Curve_setZ((s__Object__get_curve(this)),0 , 0.)
			call s__Curve_setX((s__Object__get_curve(this)),1 , sc__Object__get_x((s__Missile_target_true[(this)]))) // INLINED!!
			call s__Curve_setY((s__Object__get_curve(this)),1 , sc__Object__get_y((s__Missile_target_true[(this)]))) // INLINED!!
			call s__Curve_setZ((s__Object__get_curve(this)),1 , 0.)
			call s__Curve_setProjectedControlPoint((s__Object__get_curve(this)),0 , 0.5 * dist , 300 + GetRandomReal(0.25, 0.5) * dist , GetRandomReal(30, 150))
    endfunction

  function s__MonsterRewardMissile_create takes integer owner,string fxPath,real x,real y,real z,integer target returns integer
   local integer this= s__MonsterRewardMissile__allocate(owner , fxPath , x , y , z , GetRandomReal(0.0, 360.0))
      
      call s__Missile__set_velo(this,GetRandomReal(50, 150))
      call s__Missile__set_z_velo(this,1500. + GetRandomReal(- 100.0, 100.0))
      call s__Missile__set_gravity(this,(s__Movement_z_velo[(sc__Movement_get(((this))))]) * ( 3.5 + GetRandomReal(- 0.25, 0.25) )) // INLINED!!
      
      set s__MonsterRewardMissile_buffredTarget[this]=target
			return this
  endfunction

  function s__MonsterRewardMissile_onDestroy takes integer this returns nothing
      if s__MonsterRewardMissile_afx[this] > 0 then
        call s__Effect_kill(s__MonsterRewardMissile_afx[this])
      endif
      set s__MonsterRewardMissile_afx[this]=0
  endfunction


  


    function s__MonsterRewardExpMissile_executeTarget takes integer this,integer target returns nothing
      local real expValue= 5. + I2R((s__Unit_prototype_level_true[(s__Missile_owner[this])])) // INLINED!!
      if s__MonsterRewardExpMissile_isLucky[this] then
        set s__InstantText_SIZE=8
        call s__InstantText_createForPlayer(sc__Object__get_x(target) + GetRandomReal(- 32, 32) , sc__Object__get_y(target) + GetRandomReal(- 32, 32) , sc__Object__get_z(target) , UDG_STAT_COLOR[ENUM_STAT_LUCK] + "x2|r" , (GetOwningPlayer(s__Unit_prototype_origin_unit[(target)]))) // INLINED!!
        call sc__Unit_prototype_addExp(target,expValue * 2)
      else
        call sc__Unit_prototype_addExp(target,expValue)
      endif
    endfunction

    function s__MonsterRewardExpMissile_create takes integer owner,real x,real y,real z,integer target returns integer
      local integer this= s__MonsterRewardExpMissile__allocate(owner , MonsterReward__P_FX_PATH_EXP , x , y , z , target)
      set s__MonsterRewardExpMissile_isLucky[this]=s__Unit_prototype_luckyTest(target,s__Unit_prototype_getCalculatedStatValue(target,ENUM_STAT_LUCK) , 0.10 , 100)
      if s__MonsterRewardExpMissile_isLucky[this] then
        set s__MonsterRewardMissile_afx[this]=s__AttatchedEffect_create(MonsterReward__P_FX_PATH_EXP_LUCKY , this)
      endif
      return this
    endfunction



    
    function s__MonsterReward_deathCallback takes nothing returns nothing
      local integer deadUnit= EVT_DEATH_UNIT
      local integer killer= EVT_DEATH_KILLER
      if ( killer <= 0 ) or ( deadUnit <= 0 ) or ( s__Object_class[deadUnit] != UDG_UNIT_CLASS_NAME[ENUM_UNIT_CLASS_MONSTER] ) then
        return
      endif
      call s__MonsterRewardExpMissile_create(deadUnit , sc__Object__get_x(deadUnit) , sc__Object__get_y(deadUnit) , sc__Object__get_z(deadUnit) , killer)
      call s__MonsterRewardExpMissile_create(deadUnit , sc__Object__get_x(deadUnit) , sc__Object__get_y(deadUnit) , sc__Object__get_z(deadUnit) , killer)
      call s__MonsterRewardExpMissile_create(deadUnit , sc__Object__get_x(deadUnit) , sc__Object__get_y(deadUnit) , sc__Object__get_z(deadUnit) , killer)
      call s__MonsterRewardExpMissile_create(deadUnit , sc__Object__get_x(deadUnit) , sc__Object__get_y(deadUnit) , sc__Object__get_z(deadUnit) , killer)
      call s__MonsterRewardExpMissile_create(deadUnit , sc__Object__get_x(deadUnit) , sc__Object__get_y(deadUnit) , sc__Object__get_z(deadUnit) , killer)
    endfunction

    function s__MonsterReward_init takes nothing returns nothing
      local trigger t= null
      
      set t=CreateTrigger()
      call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_DEATH)*1.0)) // INLINED!!
      call TriggerAddCondition(t, Condition(function s__MonsterReward_deathCallback))
      
      set t=null
    endfunction



