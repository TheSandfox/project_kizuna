					endif
				else
					call BlzFrameSetTexture(FRAME_UNGRAB_ICON_BACKDROP, "ReplaceableTextures\\CommandButtonsDisabled\\DISBTNPickUpItem.blp", 0, true)
				endif
			endif
  endfunction

  function s__UI_onInit takes nothing returns nothing
   local trigger t= null
			set t=CreateTrigger()
			call TriggerRegisterVariableEvent((t ), "udg_EVENT_VALUE", EQUAL, (( ENUM_EVENT_ERROR)*1.0)) // INLINED!!
			call TriggerAddCondition(t, Condition(function s__UI_errorCallback))
			set t=CreateTrigger()
