			loop
				exitwhen s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[this],i) <= 0
				set a=s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[this],i)
				set s__Ability_prototype_is_ai[a]=true
				set i=i + 1
			endloop
			call s__Undead_adjustCounter(true)
			call s__UnitClass_plusClass((this),CONFIG_UNIT_CLASS_UNDEAD)
			return this
  endfunction

