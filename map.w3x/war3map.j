  function s__CustomString_className takes integer ctype returns string
			return CUSTOM_STRING_STAT_COLOR[CONFIG_STAT_CONSTANT] + CUSTOM_STRING_UNIT_CLASS_NAME[ctype] + "|r"
  endfunction

  function s__CustomString_statName takes integer index returns string
			return CUSTOM_STRING_STAT_COLOR[index] + CUSTOM_STRING_STAT_NAME[index] + "|r"
  endfunction

  function s__CustomString_statString takes integer index,string s returns string
			return CUSTOM_STRING_STAT_COLOR[index] + s + "|r"
  endfunction

  function s__CustomString_statStringReal takes integer index,real v,integer jom returns string
			return CUSTOM_STRING_STAT_COLOR[index] + R2SW(v, jom, jom) + "|r"
  endfunction

  function s__CustomString_statStringPercent takes integer index,real v returns string
			return CUSTOM_STRING_STAT_COLOR[index] + I2S(MathRound(v * 100.)) + "%|r"
  endfunction

  function s__CustomString_statStringInteger takes integer index,integer v returns string
			return CUSTOM_STRING_STAT_COLOR[index] + I2S(v) + "|r"
  endfunction

  function s__CustomString_statTooltip takes integer index,string s returns string
			return CUSTOM_STRING_STAT_COLOR[index] + s + "|r"
  endfunction

  function s__CustomString_statTooltipReal takes integer index,real v,integer jom returns string
			return CUSTOM_STRING_STAT_COLOR[index] + R2SW(v, jom, jom) + "|r"
  endfunction

  function s__CustomString_statTooltipSecond takes integer index,real v returns string
			return CUSTOM_STRING_STAT_COLOR[index] + R2SW(v, 1, 1) + "초|r"
  endfunction

  function s__CustomString_statTooltipPercent takes integer index,real v returns string
			return CUSTOM_STRING_STAT_COLOR[index] + R2SW(v * 100., 1, 1) + "%|r"
  endfunction

  function s__CustomString_statTooltipInteger takes integer index,integer v returns string
			return CUSTOM_STRING_STAT_COLOR[index] + I2S(v) + "|r"
  endfunction

  function s__CustomString_statusName takes integer index returns string
			return "|cff00ffff" + CUSTOM_STRING_STATUS_NAME[index] + "|r"
  endfunction

  function s__CustomString_coloredString takes string cs,string s returns string
			return cs + s + "|r"
  endfunction

  function s__CustomString_shiftTooltip takes string s returns string
			if (LoadBoolean(s__User_HASH, GetPlayerId((GetLocalPlayer() )), GetHandleId(( OSKEY_LSHIFT)))) then // INLINED!!
				return s
			else
				return ""
			endif
  endfunction

  function s__CustomString_shiftStatTooltip takes integer index returns string
			return s__CustomString_shiftTooltip(CUSTOM_STRING_STAT_COLOR[index] + "(▲" + CUSTOM_STRING_STAT_NAME[index] + ")|r")
  endfunction

