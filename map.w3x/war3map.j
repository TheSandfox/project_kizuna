//textmacro instance: demonicAllocate("CustomKeypress_prototype")
 function CustomKeypress_prototype_demonicAllocate takes nothing returns integer
  local integer this=si__CustomKeypress_prototype_F
		   if ( this != 0 ) then
			   set si__CustomKeypress_prototype_F=si__CustomKeypress_prototype_V[this]
		   else
			   set si__CustomKeypress_prototype_I=si__CustomKeypress_prototype_I + 1
			   set this=si__CustomKeypress_prototype_I
		   endif
		   set si__CustomKeypress_prototype_type[this]=0
		   set si__CustomKeypress_prototype_V[this]=- 1
		return this
	endfunction
//end of: demonicAllocate("CustomKeypress_prototype")


 function s__CustomKeypress_prototype_create takes nothing returns integer
  local integer this= CustomKeypress_prototype_demonicAllocate()
		return this
 endfunction





 function s__CustomKeypress_timerCallback takes nothing returns nothing
  local integer this= (sg__TimerUtils___DATA_get(GetHandleId(((GetExpiredTimer()))) * HASH_UP / HASH_DOWN + HASH_BIAS)) // INLINED!!
		set CUSTOM_RESPOND_KEYPRESS_PLAYER=s__CustomKeypress_p[this]
		set CUSTOM_RESPOND_KEYPRESS_CASTER=s__CustomKeypress_caster[this]
		set CUSTOM_RESPOND_KEYPRESS_KEY=s__CustomKeypress_key[this]
		set CUSTOM_RESPOND_KEYPRESS_METAKEY=s__CustomKeypress_meta[this]
		set CUSTOM_RESPOND_KEYPRESS_PRESS=s__CustomKeypress_press[this]
		call s__Event_activate(CONFIG_EVENT_KEYPRESS)
		call sc__CustomKeypress_prototype_deallocate(this)
 endfunction

 function s__CustomKeypress_create takes player p,integer caster,oskeytype key,integer meta,boolean press returns integer
  local integer this= s__CustomKeypress__allocate()
		set s__CustomKeypress_p[this]=p
		set s__CustomKeypress_caster[this]=caster
		set s__CustomKeypress_key[this]=key
		set s__CustomKeypress_meta[this]=meta
		set s__CustomKeypress_press[this]=press
		set s__CustomKeypress_t[this]=s__Timer_new(this)
		call TimerStart((s__CustomKeypress_t[this] ), (( 0. )*1.0), ( false ), ( function s__CustomKeypress_timerCallback)) // INLINED!!
		return this
 endfunction

 function s__CustomKeypress_onDestroy takes integer this returns nothing
		call ReleaseTimer((s__CustomKeypress_t[this])) // INLINED!!
		set s__CustomKeypress_t[this]=null
 endfunction
		




 function s__User_oskey2Index takes oskeytype os returns integer
		if os == CONFIG_HOTKEY_ABILITY_0 then
			return 0
		elseif os == CONFIG_HOTKEY_ABILITY_1 then
			return 1
		elseif os == CONFIG_HOTKEY_ABILITY_2 then
			return 2
		elseif os == CONFIG_HOTKEY_ABILITY_3 then
			return 3
		elseif os == CONFIG_HOTKEY_ABILITY_4 then
			return 4
		elseif os == CONFIG_HOTKEY_ABILITY_5 then
			return 5
		elseif os == CONFIG_HOTKEY_ABILITY_6 then
			return 6
		elseif os == CONFIG_HOTKEY_ABILITY_7 then
			return 7
		elseif os == CONFIG_HOTKEY_ABILITY_8 then
			return 8
		elseif os == CONFIG_HOTKEY_ABILITY_9 then
			return 9
		elseif os == OSKEY_LCONTROL then
			return 10
		elseif os == OSKEY_LSHIFT then
			return 11
		elseif os == OSKEY_LALT then
			return 12
		else
			return 13
		endif
 endfunction

 function s__User_oskeyIndex2String takes integer index returns string
		return s__User_OSKEY_INDEX_TO_STRING[index]
 endfunction

 function s__User_setKeyState takes player p,oskeytype ok,boolean val returns nothing
		call SaveBoolean(s__User_HASH, GetPlayerId(p), GetHandleId(ok), val)
 endfunction

 function s__User_getKeyState takes player p,oskeytype ok returns boolean
		return LoadBoolean(s__User_HASH, GetPlayerId(p), GetHandleId(ok))
 endfunction

 function s__User_getGold takes player p returns integer
		return GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD)
 endfunction

 function s__User_addGold takes player p,integer nv returns nothing
		call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) + nv)
		set GOLD_REFRESH_PLAYER=null
		set GOLD_REFRESH_PLAYER=p
		call TriggerEvaluate(GOLD_REFRESH_TRIGGER)
 endfunction

 function s__User_getLumber takes player p returns integer
		return GetPlayerState(p, PLAYER_STATE_RESOURCE_LUMBER)
 endfunction

 function s__User_addLumber takes player p,integer nv returns nothing
		call SetPlayerState(p, PLAYER_STATE_RESOURCE_LUMBER, GetPlayerState(p, PLAYER_STATE_RESOURCE_LUMBER) + nv)
 endfunction

 function s__User_teamColorString takes player p,string val returns string
		return s__User_TEAMCOLOR_TO_STRING[GetPlayerId(p)] + val + "|r"
 endfunction

 function s__User_teamColorTexture takes player p returns string
		return s__User_TEAMCOLOR_PATH[GetPlayerId(p)]
 endfunction

 function s__User_refinePlayerName takes player p returns nothing
  local string origin= GetPlayerName(p)
  local integer i= StringLength(origin)
		set s__User_ORIGIN_NAME[GetPlayerId(p)]=origin
		loop
			exitwhen i == 0
			if SubString(origin, i - 1, i) == "#" then
				set s__User_BATTLE_TAG[GetPlayerId(p)]=SubString(origin, i, StringLength(origin))
				set i=i - 1
				exitwhen true
			endif
			set i=i - 1
		endloop
		if i >= 0 then
			call SetPlayerName(p, SubString(origin, 0, i))
		endif
 endfunction

 function s__User_getFocusUnit takes player p returns integer
		return s__User_FOCUS_UNIT[GetPlayerId(p)]
 endfunction

 function s__User_selectFocusUnit takes player p returns nothing
		call ClearSelectionForPlayer(p)
		if GetLocalPlayer() == p then
			call SelectUnit(s__Unit_prototype_origin_unit[(s__User_FOCUS_UNIT[GetPlayerId((p))])], true) // INLINED!!
		endif
 endfunction

 function s__User_reselectUnit takes player p,integer u returns nothing
		if (s__User_FOCUS_UNIT[GetPlayerId((p))]) == u then // INLINED!!
			call s__User_selectFocusUnit(p)
		endif
 endfunction

 function s__User_enableAbilityHotkey takes player p,boolean flag returns nothing
		if flag then
			set s__User_ENABLE_ABILITY_HOTKEY[GetPlayerId(p)]=s__User_ENABLE_ABILITY_HOTKEY[GetPlayerId(p)] + 1
		else
			set s__User_ENABLE_ABILITY_HOTKEY[GetPlayerId(p)]=s__User_ENABLE_ABILITY_HOTKEY[GetPlayerId(p)] - 1
			if s__User_ENABLE_ABILITY_HOTKEY[GetPlayerId(p)] <= 0 then
				call s__Unit_prototype_releaseAbilityAll(s__User_FOCUS_UNIT[GetPlayerId(p)])
			endif
		endif
 endfunction

 function s__User_enableAbilityRightClick takes player p,boolean flag returns nothing
		if flag then
			set s__User_ENABLE_ABILITY_RIGHT_CLICK[GetPlayerId(p)]=s__User_ENABLE_ABILITY_RIGHT_CLICK[GetPlayerId(p)] + 1
		else
			set s__User_ENABLE_ABILITY_RIGHT_CLICK[GetPlayerId(p)]=s__User_ENABLE_ABILITY_RIGHT_CLICK[GetPlayerId(p)] - 1
		endif
 endfunction

 function s__User_enableChat takes player p,boolean flag returns nothing
		if flag then
			set s__User_ENABLE_CHAT[GetPlayerId(p)]=s__User_ENABLE_CHAT[GetPlayerId(p)] + 1
		else
			set s__User_ENABLE_CHAT[GetPlayerId(p)]=s__User_ENABLE_CHAT[GetPlayerId(p)] - 1
		endif
		if GetLocalPlayer() == p then
			call BlzFrameSetEnable(BlzGetOriginFrame(ORIGIN_FRAME_CHAT_MSG, 0), s__User_ENABLE_CHAT[GetPlayerId(p)] > 0)
		endif
 endfunction

 function s__User_setFocusUnit takes player p,integer u returns nothing
		if s__User_FOCUS_UNIT[GetPlayerId(p)] > 0 and s__User_FOCUS_UNIT[GetPlayerId(p)] != u then
			call s__Unit_prototype_releaseAbilityAll(s__User_FOCUS_UNIT[GetPlayerId(p)])
		endif
		set s__User_FOCUS_UNIT[GetPlayerId(p)]=u
		set CUSTOM_RESPOND_UNIT_SELECT_TARGET=u
		set CUSTOM_RESPOND_UNIT_SELECT_PLAYER=p
		call s__Event_activate(CONFIG_EVENT_UNIT_SELECT)
		if s__Unit_prototype_origin_unit[u] != null then
			call s__User_selectFocusUnit(p)
		endif
 endfunction

 function s__User_customKeypress takes player p,integer caster,oskeytype key,integer meta,boolean press returns nothing
		call s__CustomKeypress_create(p , caster , key , meta , press)
 endfunction

 function s__User_keyPress takes nothing returns nothing
  local integer a= 0
  local integer u= (s__User_FOCUS_UNIT[GetPlayerId((GetTriggerPlayer()))]) // INLINED!!
  local integer okidx= s__User_oskey2Index(BlzGetTriggerPlayerKey())
		if s__User_ENABLE_ABILITY_HOTKEY[GetPlayerId(GetTriggerPlayer())] > 0 and u > 0 and okidx >= 0 and okidx < CONFIG_ABILITY_SIZE then
			set a=s__UnitPrototype__AbilityData_getAbility(s__Unit_prototype_ability_data[u],okidx)
			if a > 0 then
				if (LoadBoolean(s__User_HASH, GetPlayerId((GetTriggerPlayer() )), GetHandleId(( BlzGetTriggerPlayerKey())))) != BlzGetTriggerPlayerIsKeyDown() then // INLINED!!
					if BlzGetTriggerPlayerIsKeyDown() then
						if BlzGetTriggerPlayerMetaKey() == 1 then
							call sc__Ability_prototype_iconClick(a)
						elseif BlzGetTriggerPlayerMetaKey() == 2 then
							call sc__Ability_prototype_iconRightClick(a)
						else
							if s__Ability_prototype_is_active[a] then
								call s__Ability_prototype_press(a)
							else
								call sc__Ability_prototype_iconClick(a)
							endif
						endif
					elseif (s__Ability_prototype_smart_true[(a)]) > 0 then // INLINED!!
						call s__Ability_prototype_release(a)
					endif
				elseif BlzGetTriggerPlayerIsKeyDown() then

				endif
			endif
		endif
		if BlzGetTriggerPlayerIsKeyDown() != (LoadBoolean(s__User_HASH, GetPlayerId((GetTriggerPlayer() )), GetHandleId(( BlzGetTriggerPlayerKey())))) then // INLINED!!
			call s__CustomKeypress_create((GetTriggerPlayer() ) , ( u ) , ( BlzGetTriggerPlayerKey() ) , ( BlzGetTriggerPlayerMetaKey() ) , ( BlzGetTriggerPlayerIsKeyDown())) // INLINED!!
			call SaveBoolean(s__User_HASH, GetPlayerId((GetTriggerPlayer() )), GetHandleId(( BlzGetTriggerPlayerKey() )), ( BlzGetTriggerPlayerIsKeyDown())) // INLINED!!
		endif
 endfunction

 function s__User_new takes player p returns nothing
  local integer i= GetPlayerId(p)
  local integer j= 0
		call s__User_refinePlayerName(p)
		set s__User_KEYPRESS[i]=CreateTrigger()
		loop
			exitwhen j >= 16
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_0, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_1, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_2, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_3, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_4, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_5, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_6, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_7, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_8, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_9, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_S, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_H, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_0, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_1, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_2, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_3, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_4, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_5, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_6, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_7, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_8, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_ABILITY_9, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_S, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_H, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_LCONTROL, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_LCONTROL, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_LSHIFT, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_LSHIFT, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_SPACE, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_SPACE, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_UNRIDE, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_X, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_C, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_V, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_T, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_G, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_B, j, true)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, CONFIG_HOTKEY_UNRIDE, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_X, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_C, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_V, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_T, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_G, j, false)
			call BlzTriggerRegisterPlayerKeyEvent(s__User_KEYPRESS[i], p, OSKEY_B, j, false)
			set j=j + 1
		endloop
		//
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( CONFIG_HOTKEY_ABILITY_0 )), ( false)) // INLINED!!
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( CONFIG_HOTKEY_ABILITY_1 )), ( false)) // INLINED!!
		call SaveBoolean(s__User_HASH, GetPlayerId((p )), GetHandleId(( CONFIG_HOTKEY_ABILITY_2 )), ( false)) // INLINED!!
