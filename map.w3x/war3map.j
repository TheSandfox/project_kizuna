   function s__Ability20f0_illusion_create takes integer caster,integer target,integer level returns integer
    local real ta= GetRandomReal(0., 360.)
    local real tx= (((sc__Object__get_x(target) )*1.0) + (( 75. )*1.0) * Cos((( ta)*1.0) * bj_DEGTORAD)) // INLINED!!
