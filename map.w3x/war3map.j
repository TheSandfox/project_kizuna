//library Line ends
//library Numberpad:





  function s__Numberpad__get_owner takes integer this returns player
			return Player(this)
  endfunction

  function s__Numberpad_getPrefix takes nothing returns string
			return NUMBERPAD_SUMMIT_PREFIX
  endfunction

  function s__Numberpad_getRefinedPrefix takes nothing returns string
			return NUMBERPAD_REFINED_PREFIX
  endfunction

  function s__Numberpad_getRefinedSubfix takes nothing returns string
			return NUMBERPAD_REFINED_SUBFIX
  endfunction

  function s__Numberpad_refinePrefix takes nothing returns nothing
   local integer i= 0
			set NUMBERPAD_REFINED_PREFIX=""
			set NUMBERPAD_REFINED_SUBFIX=""
			loop
				if i >= StringLength(NUMBERPAD_SUMMIT_PREFIX) - 1 then
					set NUMBERPAD_REFINED_PREFIX=NUMBERPAD_SUMMIT_PREFIX
					exitwhen true
				elseif SubString(NUMBERPAD_SUMMIT_PREFIX, i, i + 1) == "#" then
					set NUMBERPAD_REFINED_PREFIX=SubString(NUMBERPAD_SUMMIT_PREFIX, 0, i)
					set NUMBERPAD_REFINED_SUBFIX=SubString(NUMBERPAD_SUMMIT_PREFIX, i + 1, StringLength(NUMBERPAD_SUMMIT_PREFIX))
					exitwhen true
				else
					set i=i + 1
				endif
			endloop
			if Numberpad___DEBUG then
				call BJDebugMsg(NUMBERPAD_SUMMIT_PREFIX + ", " + NUMBERPAD_REFINED_PREFIX + ", " + NUMBERPAD_REFINED_SUBFIX)
			endif
  endfunction

  function s__Numberpad_customSummit takes player p,string prefix,string value returns nothing
			set NUMBERPAD_SUMMIT_RESULT=false
			set NUMBERPAD_SUMMIT_PLAYER=null
			set NUMBERPAD_SUMMIT_PLAYER=p
			set NUMBERPAD_SUMMIT_PREFIX=prefix
			set NUMBERPAD_SUMMIT_VALUE=value
			call s__Numberpad_refinePrefix()
			call TriggerEvaluate(NUMBERPAD_SUMMIT_TRIGGER)
  endfunction

  function s__Numberpad_refreshDisplay takes integer this returns nothing
			if GetLocalPlayer() == (Player((this))) then // INLINED!!
				if s__Numberpad_initial[this] then
					call BlzFrameSetText(NUMBERPAD_TEXT, "|cffffff00" + s__Numberpad_value[this] + "|r")
				else
					call BlzFrameSetText(NUMBERPAD_TEXT, s__Numberpad_value[this])
				endif
			endif
  endfunction

  function s__Numberpad_setPrefix takes integer this,string s returns nothing
			set s__Numberpad_prefix[this]=s
			if GetLocalPlayer() == (Player((this))) then // INLINED!!
				call BlzFrameSetText(NUMBERPAD_PREFIX_INDICATOR, "#" + s__Numberpad_prefix[this])
			endif
  endfunction

  function s__Numberpad_setInitialValue takes integer this,string s returns nothing
			set s__Numberpad_initial[this]=true
			set s__Numberpad_value[this]=s
			call s__Numberpad_refreshDisplay(this)
  endfunction

  function s__Numberpad_add takes integer this,string s returns nothing
			call BJDebugMsg(s)
			if S2I(s) == 0 then
				if s__Numberpad_allow_zero_input[this] then
					if s__Numberpad_initial[this] then
						set s__Numberpad_value[this]=s
					else
						set s__Numberpad_value[this]=s__Numberpad_value[this] + s
					endif
				else
					if S2I(s) > 0 then
						set s__Numberpad_value[this]=s__Numberpad_value[this] + s
					endif
				endif
			else
				if s__Numberpad_initial[this] or ( S2I(s__Numberpad_value[this]) == 0 and not s__Numberpad_allow_zero_input[this] ) then
					set s__Numberpad_value[this]=s
				else
					set s__Numberpad_value[this]=s__Numberpad_value[this] + s
				endif
			endif
			set s__Numberpad_value[this]=SubString(s__Numberpad_value[this], 0, NUMBERPAD_INPUT_LIMIT)
			set s__Numberpad_initial[this]=false
			call s__Numberpad_refreshDisplay(this)
  endfunction

  function s__Numberpad_delete takes integer this returns nothing
			if s__Numberpad_value[this] == "" then
				return
			endif
			if StringLength(s__Numberpad_value[this]) <= 1 and not s__Numberpad_allow_zero_input[this] then
				set s__Numberpad_value[this]=NUMBERPAD_INPUT_DEFAULT
			else
				set s__Numberpad_value[this]=SubString(s__Numberpad_value[this], 0, StringLength(s__Numberpad_value[this]) - 1)
			endif
			call s__Numberpad_refreshDisplay(this)
  endfunction

  function s__Numberpad_clear takes integer this returns nothing
			if s__Numberpad_allow_zero_input[this] then
				set s__Numberpad_value[this]=""
			else
				set s__Numberpad_value[this]=NUMBERPAD_INPUT_DEFAULT
			endif
			call s__Numberpad_refreshDisplay(this)
  endfunction

  function s__Numberpad_allowZeroInput takes integer this,boolean b returns nothing
			set s__Numberpad_allow_zero_input[this]=b
			call s__Numberpad_clear(this)
  endfunction

  function s__Numberpad_visibleForPlayer takes integer this,boolean flag returns nothing
			if GetLocalPlayer() == (Player((this))) then // INLINED!!
				call BlzFrameSetVisible(NUMBERPAD_CONTAINER, flag)
			endif
			if s__Numberpad_visible_flag[this] != flag then
				if flag then
					
					call s__Array_add(s__CloseUI_list[(this)],s__CloseUI_ORDER_NUMBERPAD)
				else
					
					call s__Array_eraseFor(s__CloseUI_list[(this)],s__CloseUI_ORDER_NUMBERPAD)
				endif
			endif
			set s__Numberpad_visible_flag[this]=flag
  endfunction

  function s__Numberpad_setAbsPoint takes integer this,framepointtype pivot,real offset_x,real offset_y returns nothing
			if GetLocalPlayer() == (Player((this))) then // INLINED!!
				call BlzFrameClearAllPoints(NUMBERPAD_CONTAINER)
				call BlzFrameSetAbsPoint((NUMBERPAD_CONTAINER ), ( pivot ), (( offset_x )*1.0) / 1800., (( offset_y)*1.0) / 1800.) // INLINED!!
			endif
  endfunction

  function s__Numberpad_setPoint takes integer this,framepointtype pivot,framehandle target,framepointtype relative,real offset_x,real offset_y returns nothing
			if GetLocalPlayer() == (Player((this))) then // INLINED!!
				call BlzFrameClearAllPoints(NUMBERPAD_CONTAINER)
				call BlzFrameSetPoint((NUMBERPAD_CONTAINER ), ( pivot ), ( target ), ( relative ), (( offset_x )*1.0) / 1800., (( offset_y)*1.0) / 1800.) // INLINED!!
			endif
  endfunction

  function s__Numberpad_setProperty takes integer this,string prefix returns nothing
			set s__Numberpad_prefix[this]=prefix
  endfunction

  function s__Numberpad_close takes integer this returns boolean
			if s__Numberpad_visible_flag[this] then
				set s__Numberpad_prefix[(this)]=("") // INLINED!!
				call s__Numberpad_visibleForPlayer(this,false)
				return true
			endif
			return false
  endfunction

  function s__Numberpad_open takes integer this,string prefix returns nothing
			call s__Numberpad_setInitialValue(this,NUMBERPAD_INPUT_DEFAULT)
			call s__Numberpad_setPrefix(this,prefix)
			call s__Numberpad_visibleForPlayer(this,true)
  endfunction

  function s__Numberpad_openSimple takes integer this,string prefix returns nothing
			call s__Numberpad_open(this,prefix)
			call s__Numberpad_setPoint(this,FRAMEPOINT_CENTER , BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0) , FRAMEPOINT_CENTER , 0 , 0)
  endfunction

  function s__Numberpad_summit takes integer this returns nothing
			call s__Numberpad_customSummit((Player((this))) , s__Numberpad_prefix[this] , s__Numberpad_value[this]) // INLINED!!
			if NUMBERPAD_SUMMIT_RESULT then
				call s__Numberpad_close(this)
			endif
  endfunction

  function s__Numberpad_create takes player p returns integer
   local integer this= GetPlayerId(p)
			set s__Numberpad_visible_flag[this]=false
			set s__Numberpad_allow_zero_input[this]=false
			set s__Numberpad_initial[this]=false
			set s__Numberpad_prefix[this]=""
			set s__Numberpad_value[this]=NUMBERPAD_INPUT_DEFAULT
			call s__Numberpad_close(this)
			call s__Numberpad_clear(this)
			return this
  endfunction

  function s__Numberpad_genericInput takes nothing returns nothing
   local integer this= 0
   local integer i= 0
			if GetLocalPlayer() == GetTriggerPlayer() then
				call BlzFrameSetEnable(BlzGetTriggerFrame(), false)
				call BlzFrameSetEnable(BlzGetTriggerFrame(), true)
			endif
			if BlzGetTriggerFrameEvent() != FRAMEEVENT_CONTROL_CLICK then
				return
			endif
			set this=GetPlayerId(GetTriggerPlayer())
			loop
				exitwhen i >= 10
				if BlzGetTriggerFrame() == s__NUMBERPAD_BTN[i] then
					call s__Numberpad_add(this,I2S(i))
					return
				endif
				set i=i + 1
			endloop
			if BlzGetTriggerFrame() == s__NUMBERPAD_BTN[10] then
				if s__Numberpad_value[this] != NUMBERPAD_INPUT_DEFAULT then
					call s__Numberpad_add(this,"00")
				endif
				return
			elseif BlzGetTriggerFrame() == NUMBERPAD_BTN_CLEAR then
				call s__Numberpad_clear(this)
				return
			elseif BlzGetTriggerFrame() == NUMBERPAD_BTN_SUMMIT then
				call s__Numberpad_summit(this)
				return
			elseif BlzGetTriggerFrame() == NUMBERPAD_BTN_DELETE then
				call s__Numberpad_delete(this)
				return
			endif
  endfunction

  function s__Numberpad_init2 takes nothing returns nothing
   local integer i= 0
			set NUMBERPAD_CONTAINER=BlzCreateFrame("Numberpad", s__FRAME_GAME_UI[CONFIG_FRAME_LEVEL_POPUP], 0, 0)
			set NUMBERPAD_TEXT=BlzGetFrameByName("NumberpadDisplayText", 0)
			set s__NUMBERPAD_BTN[0]= BlzGetFrameByName("NumberpadButton0", 0)
			set s__NUMBERPAD_BTN[1]= BlzGetFrameByName("NumberpadButton1", 0)
			set s__NUMBERPAD_BTN[2]= BlzGetFrameByName("NumberpadButton2", 0)
			set s__NUMBERPAD_BTN[3]= BlzGetFrameByName("NumberpadButton3", 0)
			set s__NUMBERPAD_BTN[4]= BlzGetFrameByName("NumberpadButton4", 0)
			set s__NUMBERPAD_BTN[5]= BlzGetFrameByName("NumberpadButton5", 0)
			set s__NUMBERPAD_BTN[6]= BlzGetFrameByName("NumberpadButton6", 0)
			set s__NUMBERPAD_BTN[7]= BlzGetFrameByName("NumberpadButton7", 0)
			set s__NUMBERPAD_BTN[8]= BlzGetFrameByName("NumberpadButton8", 0)
			set s__NUMBERPAD_BTN[9]= BlzGetFrameByName("NumberpadButton9", 0)
			set s__NUMBERPAD_BTN[10]= BlzGetFrameByName("NumberpadButton00", 0)
			set NUMBERPAD_BTN_SUMMIT=BlzGetFrameByName("NumberpadSummitButton", 0)
			set NUMBERPAD_BTN_CLEAR=BlzGetFrameByName("NumberpadClearButton", 0)
			set NUMBERPAD_BTN_DELETE=BlzGetFrameByName("NumberpadDeleteButton", 0)
			set NUMBERPAD_PREFIX_INDICATOR=BlzCreateFrame("MyTextSmall", NUMBERPAD_CONTAINER, 0, 0)
			call BlzFrameSetPoint((NUMBERPAD_PREFIX_INDICATOR ), ( FRAMEPOINT_TOPLEFT ), ( NUMBERPAD_CONTAINER ), ( FRAMEPOINT_TOPLEFT ), (( 16 )*1.0) / 1800., (( - 16)*1.0) / 1800.) // INLINED!!
			loop
				exitwhen i >= 11
//textmacro instance: triggerRegisterFrameEventSimple("NUMBERPAD_INPUT_TRIGGER","NUMBERPAD_BTN[i]")
	call BlzTriggerRegisterFrameEvent(NUMBERPAD_INPUT_TRIGGER, s__NUMBERPAD_BTN[i], FRAMEEVENT_CONTROL_CLICK)
	call BlzTriggerRegisterFrameEvent(NUMBERPAD_INPUT_TRIGGER, s__NUMBERPAD_BTN[i], FRAMEEVENT_MOUSE_ENTER)
	call BlzTriggerRegisterFrameEvent(NUMBERPAD_INPUT_TRIGGER, s__NUMBERPAD_BTN[i], FRAMEEVENT_MOUSE_LEAVE)
//end of: triggerRegisterFrameEventSimple("NUMBERPAD_INPUT_TRIGGER","NUMBERPAD_BTN[i]")
				set i=i + 1
			endloop
//textmacro instance: triggerRegisterFrameEventSimple("NUMBERPAD_INPUT_TRIGGER","NUMBERPAD_BTN_SUMMIT")
	call BlzTriggerRegisterFrameEvent(NUMBERPAD_INPUT_TRIGGER, NUMBERPAD_BTN_SUMMIT, FRAMEEVENT_CONTROL_CLICK)
	call BlzTriggerRegisterFrameEvent(NUMBERPAD_INPUT_TRIGGER, NUMBERPAD_BTN_SUMMIT, FRAMEEVENT_MOUSE_ENTER)
	call BlzTriggerRegisterFrameEvent(NUMBERPAD_INPUT_TRIGGER, NUMBERPAD_BTN_SUMMIT, FRAMEEVENT_MOUSE_LEAVE)
//end of: triggerRegisterFrameEventSimple("NUMBERPAD_INPUT_TRIGGER","NUMBERPAD_BTN_SUMMIT")
//textmacro instance: triggerRegisterFrameEventSimple("NUMBERPAD_INPUT_TRIGGER","NUMBERPAD_BTN_DELETE")
	call BlzTriggerRegisterFrameEvent(NUMBERPAD_INPUT_TRIGGER, NUMBERPAD_BTN_DELETE, FRAMEEVENT_CONTROL_CLICK)
	call BlzTriggerRegisterFrameEvent(NUMBERPAD_INPUT_TRIGGER, NUMBERPAD_BTN_DELETE, FRAMEEVENT_MOUSE_ENTER)
	call BlzTriggerRegisterFrameEvent(NUMBERPAD_INPUT_TRIGGER, NUMBERPAD_BTN_DELETE, FRAMEEVENT_MOUSE_LEAVE)
//end of: triggerRegisterFrameEventSimple("NUMBERPAD_INPUT_TRIGGER","NUMBERPAD_BTN_DELETE")
//textmacro instance: triggerRegisterFrameEventSimple("NUMBERPAD_INPUT_TRIGGER","NUMBERPAD_BTN_CLEAR")
	call BlzTriggerRegisterFrameEvent(NUMBERPAD_INPUT_TRIGGER, NUMBERPAD_BTN_CLEAR, FRAMEEVENT_CONTROL_CLICK)
	call BlzTriggerRegisterFrameEvent(NUMBERPAD_INPUT_TRIGGER, NUMBERPAD_BTN_CLEAR, FRAMEEVENT_MOUSE_ENTER)
	call BlzTriggerRegisterFrameEvent(NUMBERPAD_INPUT_TRIGGER, NUMBERPAD_BTN_CLEAR, FRAMEEVENT_MOUSE_LEAVE)
//end of: triggerRegisterFrameEventSimple("NUMBERPAD_INPUT_TRIGGER","NUMBERPAD_BTN_CLEAR")
			call TriggerAddCondition(NUMBERPAD_INPUT_TRIGGER, Condition(function s__Numberpad_genericInput))
			call BlzFrameSetVisible(NUMBERPAD_CONTAINER, false)
  endfunction

  function s__Numberpad_init takes nothing returns nothing
   local trigger t= CreateTrigger()
			call TriggerAddCondition(t, Condition(function s__Numberpad_init2))
			call TriggerEvaluate(t)
			call DestroyTrigger(t)
			set t=null
  endfunction



