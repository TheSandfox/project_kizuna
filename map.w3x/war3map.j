  endfunction

		
  function s__Boss_bossTimerCallback takes nothing returns nothing
   local integer this= sc__Timer_getData(GetExpiredTimer())
			
			if s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_DEAD) > 0 then
				call PauseTimer((s__Boss_boss_timer[this])) // INLINED!!
				call s__BossUI_clearVisibleFlag(s__Boss_ui[this])
				call s__BossUI_adjustVisibility(s__Boss_ui[this])
				call PauseTimer((s__BossUI_main_timer[(s__Boss_ui[this])])) // INLINED!!
				return
			endif
			
			if s__Boss_timer_state[this] == s__Boss_TIMER_STATE_COMBAT then
				
				if s__Boss_pattern_running[this] <= 0 and s__UnitPrototype__StatusData_getStatus(s__Unit_prototype_status_data[this],CONFIG_STATUS_UNSTOP) > 0 then
					
					if s__Boss_countUnits(this) <= 0 then
						set s__Boss_retreat_timeout[this]=s__Boss_retreat_timeout[this] - 0.5
						
						if s__Boss_retreat_timeout[this] <= 0. then
							set s__Boss_retreat_timeout[this]=s__Boss_RETREAT_TIMEOUT
							set s__Boss_timer_state[this]=s__Boss_TIMER_STATE_RETREAT
							// call BJDebugMsg("니게룽다요")
						endif
					
					else
						set s__Boss_retreat_timeout[this]=s__Boss_RETREAT_TIMEOUT
						call sc__Boss_doPattern(this)
					endif
				
				else

				endif
			
			elseif s__Boss_timer_state[this] == s__Boss_TIMER_STATE_RETREAT then
				
				if s__Math_distancePoints(sc__Object__get_x(this) , sc__Object__get_y(this) , GetRectCenterX(s__Boss_zone[this]) , GetRectCenterY(s__Boss_zone[this])) <= 16.0 and (s__Unit_prototype_hp_true[(this)]) >= (s__Unit_prototype_maxhp_true[(this)]) then // INLINED!!
					call SetUnitFacing(s__Unit_prototype_origin_unit[this], 270.0)
					set s__Boss_timer_state[this]=s__Boss_TIMER_STATE_SLEEP
					call PauseTimer((s__Boss_boss_timer[this])) // INLINED!!
					call EnableTrigger(s__Trigger_main_trigger[(s__Boss_damage_trigger[this])]) // INLINED!!
					call s__Boss_countUnits(this)
					call sc__Boss_onSleep(this)
					call PauseTimer((s__BossUI_main_timer[(s__Boss_ui[this])])) // INLINED!!
					// call BJDebugMsg("쿨쿨")
				
				else
					if s__Math_distancePoints(sc__Object__get_x(this) , sc__Object__get_y(this) , GetRectCenterX(s__Boss_zone[this]) , GetRectCenterY(s__Boss_zone[this])) > 16.0 then
						call IssuePointOrder(s__Unit_prototype_origin_unit[(this)], ("smart" ), (( GetRectCenterX(s__Boss_zone[this]) )*1.0), (( GetRectCenterY(s__Boss_zone[this]))*1.0)) // INLINED!!
					endif
					call s__Unit_prototype_healUnit(this,this , (s__Unit_prototype_maxhp_true[(this)]) * 0.25 * 0.5) // INLINED!!
				endif
			endif
  endfunction

		
  function s__Boss_damageCallback takes nothing returns nothing
   local integer this= (LoadInteger(s__Trigger_HASH, GetHandleId((GetTriggeringTrigger())), 0)) // INLINED!!
			if CUSTOM_RESPOND_DAMAGE_TARGET != this then
				return
			endif
			// call BJDebugMsg("데미지콜백")
			if s__Boss_countUnits(this) > 0 then
				set s__Boss_timer_state[this]=s__Boss_TIMER_STATE_COMBAT
				call TimerStart((s__Boss_boss_timer[this] ), (( 0.5 )*1.0), ( true ), ( function s__Boss_bossTimerCallback)) // INLINED!!
				call DisableTrigger(s__Trigger_main_trigger[(s__Boss_damage_trigger[this])]) // INLINED!!
				call s__BossUI_awake(s__Boss_ui[this])
				// call BJDebugMsg("전투시작")
			else
				call s__Unit_prototype__set_hp(this,(s__Unit_prototype_maxhp_true[(this)])) // INLINED!!
			endif
  endfunction

  function s__Boss_create takes integer id,integer level,real x,real y returns integer
   local integer this= s__Boss__allocate(id , x , y)
			call IssueImmediateOrder(s__Unit_prototype_origin_unit[(this)], ("stop")) // INLINED!!
			
			set s__Boss_zone[this]=Rect(x - ( s__Boss_ZONE_SIZE / 2. ), y - ( s__Boss_ZONE_SIZE / 2. ), x + ( s__Boss_ZONE_SIZE / 2. ), y + ( s__Boss_ZONE_SIZE / 2. ))
			
