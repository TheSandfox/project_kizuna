				if s__Actor_duration[this] <= s__Boss_BossB000__sanrengeki_DURATION_SLOW - s__Boss_BossB000__sanrengeki_EXP_DELAY_SLOW then
					set s__Boss_BossB000__sanrengeki_anim_reset[this]=true
