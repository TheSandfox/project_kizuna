  function s__WarpUI_visibleForPlayer takes integer this,boolean flag returns nothing
			if s__WarpUI_visible_flag[this] != flag then
				if flag then
					if (s__Array_getLastValue(s__User_INPUT_LAYER[GetPlayerId(((Player((this)))))])) <= CONFIG_INPUT_LAYER_WARP_UI then // INLINED!!
						
						call s__Array_add(s__CloseUI_list[(this)],s__CloseUI_ORDER_WARP)
						call s__User_addInputLayer((Player((this))) , CONFIG_INPUT_LAYER_WARP_UI) // INLINED!!
					else
						return
					endif
				else
					
					call s__Array_eraseFor(s__CloseUI_list[(this)],s__CloseUI_ORDER_WARP)
					call s__User_removeInputLayer((Player((this))) , CONFIG_INPUT_LAYER_WARP_UI) // INLINED!!
					if (Waygate__P_FREEZE_ACTOR[(this)]) > 0 then // INLINED!!
						call DisableTrigger(Waygate__P_END_FREEZE_CALLBACK)
						call sc__Actor_prototype_deallocate((Waygate__P_FREEZE_ACTOR[(this)])) // INLINED!!
						set Waygate__P_FREEZE_ACTOR[(this)]=(0) // INLINED!!
						call EnableTrigger(Waygate__P_END_FREEZE_CALLBACK)
					endif
				endif
			endif
			set s__WarpUI_visible_flag[this]=flag
			if GetLocalPlayer() == Player(this) then
				call BlzFrameSetVisible(FRAME_WARP_UI, flag)
				call PlaySoundBJ(gg_snd_BigButtonClick)
			endif
  endfunction

  function s__WarpUI_open takes integer this,integer caster returns nothing
			
			if (Waygate__P_FREEZE_ACTOR[(this)]) > 0 then // INLINED!!
				return
			endif
			
			if not s__Unit_prototype_is_revive[caster] then
				return
			endif
			call s__WarpUI_visibleForPlayer(this,true)
			set Waygate__P_FREEZE_ACTOR[(this)]=(s__WarpFreeze_create(caster)) // INLINED!!
  endfunction

  function s__WarpUI_close takes integer this returns boolean
			if s__WarpUI_visible_flag[this] then
				call s__WarpUI_visibleForPlayer(this,false)
				return true
			else
				return false
			endif
  endfunction

