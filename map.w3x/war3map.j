  function s__Wall_fill takes integer this returns nothing
   local integer i= 0
   local integer j= 0
   local destructable d= null
   local real px= s__Wall_x[this] - 512
   local real py= s__Wall_y[this] + 512
			loop
				exitwhen i >= s__Wall_COLS
				set j=0
				loop
					exitwhen j >= s__Wall_ROWS
					set d=CreateDestructable(s__Wall_DID, px + i * 128 + 64, py - j * 128 - 64, GetRandomInt(1, 360), 1.0, GetRandomInt(0, 10))
					call SaveDestructableHandle(Hash___D, (s__Wall_destructables[this]), (s__Wall_counter[this] ), ( d)) // INLINED!!
					set s__Wall_counter[this]=s__Wall_counter[this] + 1
					set j=j + 1
				endloop
				set i=i + 1
			endloop
			set s__Wall_state[this]=0
			set d=null
  endfunction

  function s__Wall_clear takes integer this returns nothing
   local integer i= 0
   local destructable d= null
			if s__Wall_state[this] == 1 then
				return
			endif
			set s__Wall_state[this]=1
			loop
				exitwhen i >= s__Wall_counter[this]
				set d=(LoadDestructableHandle(Hash___D, (s__Wall_destructables[this]), (i))) // INLINED!!
				call KillDestructable(d)
				set i=i + 1
			endloop
			call s__Hash_deallocate(s__Wall_destructables[this])
			set s__Wall_destructables[this]=0
			call BlzDestroyFrame(s__Wall_icon[this])
			set s__Wall_icon[this]=null
			set d=null
